package token;

#[derive(PartialEq, Eq, ToString)]
pub enum Kind {
    Illegal,
    Eof,
    Comment,
    Ident,
    Int,
    Float,
    Imag,
    Char,
    String,
    Add,
    Sub,
    Mul,
    Quo,
    Rem,
    And,
    Or,
    Xor,
    Shl,
    Shr,
    AndNot,
    AddAssign,
    SubAssign,
    MulAssign,
    QuoAssign,
    RemAssign,
    AndAssign,
    OrAssign,
    XorAssign,
    ShlAssign,
    ShrAssign,
    AndNotAssign,
    Land,
    Lor,
    Arrow,
    Inc,
    Dec,
    Eql,
    Lss,
    Gtr,
    Assign,
    Not,
    Neq,
    Leq,
    Geq,
    Define,
    Ellipsis,
    Lparen,
    Lbrack,
    Lbrace,
    Comma,
    Period,
    Semicolon,
    Colon,
    Rparen,
    Rbrack,
    Rbrace,
    Break,
    Default,
    Func,
    Interface,
    Select,
    Case,
    Defer,
    Go,
    Map,
    Struct,
    Chan,
    Else,
    Goto,
    Package,
    Switch,
    Const,
    Fallthrough,
    If,
    Range,
    Type,
    Continue,
    For,
    Import,
    Return,
    Var,
    Tilde,
}

pub struct Token {
    pub kind: Kind,
    pub literal: string,
    pub start: int,
    pub end: int,
    pub synthetic: bool,
}

pub fn make(kind: Kind, literal: string, start: int, end: int, synthetic: bool) -> Token {
    Token { kind, literal, start, end, synthetic }
}

pub fn equal(left: Kind, right: Kind) -> bool {
    left == right
}

pub fn name(kind: Kind) -> string {
    match kind {
        Illegal => "ILLEGAL",
        Eof => "EOF",
        Comment => "COMMENT",
        Ident => "IDENT",
        Int => "INT",
        Float => "FLOAT",
        Imag => "IMAG",
        Char => "CHAR",
        String => "STRING",
        Add => "+",
        Sub => "-",
        Mul => "*",
        Quo => "/",
        Rem => "%",
        And => "&",
        Or => "|",
        Xor => "^",
        Shl => "<<",
        Shr => ">>",
        AndNot => "&^",
        AddAssign => "+=",
        SubAssign => "-=",
        MulAssign => "*=",
        QuoAssign => "/=",
        RemAssign => "%=",
        AndAssign => "&=",
        OrAssign => "|=",
        XorAssign => "^=",
        ShlAssign => "<<=",
        ShrAssign => ">>=",
        AndNotAssign => "&^=",
        Land => "&&",
        Lor => "||",
        Arrow => "<-",
        Inc => "++",
        Dec => "--",
        Eql => "==",
        Lss => "<",
        Gtr => ">",
        Assign => "=",
        Not => "!",
        Neq => "!=",
        Leq => "<=",
        Geq => ">=",
        Define => ":=",
        Ellipsis => "...",
        Lparen => "(",
        Lbrack => "[",
        Lbrace => "{",
        Comma => ",",
        Period => ".",
        Semicolon => ";",
        Colon => ":",
        Rparen => ")",
        Rbrack => "]",
        Rbrace => "}",
        Break => "break",
        Default => "default",
        Func => "func",
        Interface => "interface",
        Select => "select",
        Case => "case",
        Defer => "defer",
        Go => "go",
        Map => "map",
        Struct => "struct",
        Chan => "chan",
        Else => "else",
        Goto => "goto",
        Package => "package",
        Switch => "switch",
        Const => "const",
        Fallthrough => "fallthrough",
        If => "if",
        Range => "range",
        Type => "type",
        Continue => "continue",
        For => "for",
        Import => "import",
        Return => "return",
        Var => "var",
        Tilde => "~",
    }
}

pub fn lookup(identifier: string) -> Kind {
    match identifier {
        "break" => Kind::Break,
        "default" => Kind::Default,
        "func" => Kind::Func,
        "interface" => Kind::Interface,
        "select" => Kind::Select,
        "case" => Kind::Case,
        "defer" => Kind::Defer,
        "go" => Kind::Go,
        "map" => Kind::Map,
        "struct" => Kind::Struct,
        "chan" => Kind::Chan,
        "else" => Kind::Else,
        "goto" => Kind::Goto,
        "package" => Kind::Package,
        "switch" => Kind::Switch,
        "const" => Kind::Const,
        "fallthrough" => Kind::Fallthrough,
        "if" => Kind::If,
        "range" => Kind::Range,
        "type" => Kind::Type,
        "continue" => Kind::Continue,
        "for" => Kind::For,
        "import" => Kind::Import,
        "return" => Kind::Return,
        "var" => Kind::Var,
        _ => Kind::Ident,
    }
}

pub fn inserts_semicolon(kind: Kind) -> bool {
    equal(kind, Kind::Ident) || equal(kind, Kind::Int) || equal(kind, Kind::Float)
        || equal(kind, Kind::Imag)
        || equal(kind, Kind::Char)
        || equal(kind, Kind::String)
        || equal(kind, Kind::Break)
        || equal(kind, Kind::Continue)
        || equal(kind, Kind::Fallthrough)
        || equal(kind, Kind::Return)
        || equal(kind, Kind::Inc)
        || equal(kind, Kind::Dec)
        || equal(kind, Kind::Rparen)
        || equal(kind, Kind::Rbrack)
        || equal(kind, Kind::Rbrace)
}
