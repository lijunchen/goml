package parser;

use gomlgo::ast;
use gomlgo::differential;
use std::bytes;
use std::json;
use std::testing;

fn assert_valid_file(source: string) -> ast::Node {
    let actual = parse_file(source);
    let expected = match differential::run_oracle("parse-file", bytes::Bytes::from_string(source)) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return ast::node(ast::Kind::File, 0, 0, Vec::new())
        },
    };
    testing::assert(expected.ok);
    if !actual.diagnostics.is_empty() {
        testing::fail(
            f"unexpected parser diagnostic at {actual.diagnostics[0].offset}: {actual.diagnostics[0].message}",
        )
    }
    match actual.root {
        Some(value) => value,
        None => {
            testing::fail("missing AST");
            ast::node(ast::Kind::File, 0, 0, Vec::new())
        },
    }
}

fn assert_acceptance_matches(source: string) -> () {
    let actual = parse_file(source);
    let expected = match differential::run_oracle("parse-file", bytes::Bytes::from_string(source)) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return
        },
    };
    testing::assert_eq(actual.diagnostics.is_empty(), expected.ok);
    if !expected.ok {
        testing::assert(!actual.diagnostics.is_empty());
        testing::assert_eq(actual.diagnostics[0].offset, expected.diagnostics[0].offset)
    }
}

fn assert_expression_matches(source: string) -> () {
    let actual = parse_expr(source);
    let expected = match differential::run_oracle("parse-expr", bytes::Bytes::from_string(source)) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return
        },
    };
    testing::assert_eq(actual.diagnostics.is_empty(), expected.ok);
    if expected.ok {
        let expected_kind = match json::field(expected.ast, "kind") {
            Some(value) => json::as_string(value).unwrap_or(""),
            None => "",
        };
        match actual.root {
            Some(value) => testing::assert_eq(ast::kind_name(value.kind), expected_kind),
            None => testing::fail("missing expression AST"),
        }
    }
}

#[test]
fn parses_expression_precedence_and_generics() -> () {
    let result = parse_expr("f[A, B](x + y*2)");
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.root {
        Some(value) => testing::assert(ast::kind_equal(value.kind, ast::Kind::CallExpr)),
        None => testing::fail("missing expression AST"),
    }
}

#[test]
fn parses_declarations_types_and_functions() -> () {
    let file = assert_valid_file(
        "package sample\nimport \"fmt\"\ntype Pair[A, B any] struct { First A; Second B }\nvar value = Pair[int, string]{First: 1, Second: \"x\"}\nfunc Print[A any](pair Pair[A, string]) { fmt.Println(pair.First); }\n",
    );
    testing::assert(ast::kind_equal(file.kind, ast::Kind::File));
    testing::assert_eq(ast::get_nodes(file, "decls").len(), 4)
}

#[test]
fn parses_control_flow_statements() -> () {
    let file = assert_valid_file(
        "package sample\nfunc run(values []int, ch chan int) int { total := 0; for index, value := range values { if index%2 == 0 { total += value } else { continue } }; switch total { case 0: return 1; default: go println(total); }; select { case ch <- total: defer println(total); default: }; return total }\n",
    );
    testing::assert_eq(ast::get_nodes(file, "decls").len(), 1)
}

#[test]
fn skips_function_bodies_for_package_api_parsing() -> () {
    let result = parse_file_bytes_without_bodies(
        bytes::Bytes::from_string(
            "package sample\nfunc Exported() int { if true { value := func() int { return 1 }; return value() }; return 0 }\nvar Next int\n",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let file = testing::expect_some(result.root, "missing AST");
    let declarations = ast::get_nodes(file, "decls");
    testing::assert_eq(declarations.len(), 2);
    let body = testing::expect_some(ast::get_node(declarations[0], "body"), "missing function body");
    testing::assert_eq(ast::get_nodes(body, "list").len(), 0);
    testing::assert(body.span.end > body.span.start)
}

#[test]
fn invalid_file_returns_partial_ast() -> () {
    let result = parse_file("package sample\nfunc broken( { if {\n");
    testing::assert(result.diagnostics.len() > 0);
    match result.root {
        Some(value) => testing::assert(ast::kind_equal(value.kind, ast::Kind::File)),
        None => testing::fail("missing partial file AST"),
    }
}

#[test]
fn parses_ambiguous_types_and_grouped_parameters() -> () {
    assert_acceptance_matches(
        "package p\nimport \"crypto/sha256\"\ntype Sum [sha256.Size224]byte\ntype Generic[P *struct{}] struct{}\ntype F[T any] func(T, func(T, F[T]) T) T\nfunc use(name, key string, ch <-chan struct{}) {}\n",
    )
}

#[test]
fn rejects_mutated_declarations_at_oracle_offset() -> () {
    assert_acceptance_matches("package p\n;func f() {}\n");
    assert_acceptance_matches("package p\nfunc f(t *testing\n.T) {}\n");
    assert_acceptance_matches("package p\ntype Value[] struct{}\n")
}

#[test]
fn attaches_comments_and_go_version() -> () {
    let file = assert_valid_file(
        "//go:build (linux && go1.22) || (windows && go1.20)\n\npackage p\n\n// D\nvar x int // C\n",
    );
    match ast::get_string(file, "go_version") {
        Some(value) => testing::assert_eq(value, "go1.20"),
        None => testing::fail("missing Go version"),
    }
    testing::assert_eq(ast::get_nodes(file, "comments").len(), 3);
    let declaration = ast::get_nodes(file, "decls")[0];
    testing::assert(ast::get_node(declaration, "doc").is_some());
    let specification = ast::get_nodes(declaration, "specs")[0];
    testing::assert(ast::get_node(specification, "comment").is_some())
}

#[test]
fn parses_without_attaching_comments() -> () {
    let result = parse_file_bytes_without_comments(
        bytes::Bytes::from_string("//go:build go1.22\n\npackage p\n\n// D\nvar x int // C\n"),
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let file = testing::expect_some(result.root, "missing AST");
    testing::assert_eq(ast::get_string(file, "go_version").unwrap_or(""), "go1.22");
    testing::assert_eq(ast::get_nodes(file, "comments").len(), 0);
    let declaration = ast::get_nodes(file, "decls")[0];
    testing::assert(ast::get_node(declaration, "doc").is_none())
}

#[test]
fn parse_expr_matches_oracle_ambiguities() -> () {
    assert_expression_matches("F[A, B](x)[i:j:k]");
    assert_expression_matches("(<-chan struct{})(ready)");
    assert_expression_matches("map[string][]int{\"x\": {1, 2}}")
}
