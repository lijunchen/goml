package mutation;

use gomlgo::checker;
use gomlgo::loader;
use gomlgo::scanner;
use gomlgo::token;
use gomlgo::typecheck_diff;
use std::bytes;
use std::collections;
use std::fs;
use std::json;
use std::path;

pub struct TypecheckSummary {
    pub seeds: isize,
    pub cases: isize,
    pub failures: isize,
}

fn replace_range(value: bytes::Bytes, start: isize, end: isize, replacement: string) -> bytes::Bytes {
    insert_bytes(delete_range(value, start, end), start, bytes::Bytes::from_string(replacement))
}

fn semantic_mutations(source: bytes::Bytes) -> Vec[bytes::Bytes] {
    let result: Vec[bytes::Bytes] = Vec::from_array([]);
    let tokens = scanner::scan_bytes(source).tokens;
    let mut changed_operator = false;
    let mut changed_definition = false;
    let mut changed_assignment = false;
    let mut changed_type = false;
    let mut changed_literal = false;
    let mut changed_arity = false;
    let mut changed_range = false;
    let mut changed_goto = false;
    for index in 0..tokens.len() {
        let value = tokens[index];
        if !changed_operator
            && (token::equal(value.kind, token::Kind::Add)
                || token::equal(value.kind, token::Kind::Sub)
                || token::equal(value.kind, token::Kind::Eql)
                || token::equal(value.kind, token::Kind::Lss)) {
            let replacement = if token::equal(value.kind, token::Kind::Add) {
                "-"
            } else if token::equal(value.kind, token::Kind::Sub) {
                "+"
            } else if token::equal(value.kind, token::Kind::Eql) {
                "!="
            } else {
                ">"
            };
            result.push(replace_range(source, value.start, value.end, replacement));
            changed_operator = true;
        } else {};
        if !changed_definition && token::equal(value.kind, token::Kind::Define) {
            result.push(replace_range(source, value.start, value.end, "="));
            changed_definition = true;
        } else {};
        if !changed_assignment && token::equal(value.kind, token::Kind::Assign) {
            result.push(replace_range(source, value.start, value.end, ":="));
            changed_assignment = true;
        } else {};
        if !changed_type && token::equal(value.kind, token::Kind::Ident) && value.literal == "int" {
            result.push(replace_range(source, value.start, value.end, "string"));
            changed_type = true;
        } else {};
        if !changed_literal && token::equal(value.kind, token::Kind::Int) {
            result.push(replace_range(source, value.start, value.end, "true"));
            changed_literal = true;
        } else {};
        if !changed_arity && token::equal(value.kind, token::Kind::Rparen) && index > 0
            && !token::equal(tokens[index - 1].kind, token::Kind::Lparen) {
            result.push(insert_bytes(source, value.start, bytes::Bytes::from_string(", 0")));
            changed_arity = true;
        } else {};
        if !changed_range && token::equal(value.kind, token::Kind::Range)
            && index + 1 < tokens.len() {
            let target = tokens[index + 1];
            result.push(replace_range(source, target.start, target.end, "0"));
            changed_range = true;
        } else {};
        if !changed_goto && token::equal(value.kind, token::Kind::Goto) && index + 1 < tokens.len() {
            let target = tokens[index + 1];
            result.push(replace_range(source, target.start, target.end, "MissingMutationLabel"));
            changed_goto = true;
        } else {}
    }
    result
}

fn checker_response_json(value: checker::CheckResult) -> string {
    let diagnostics: Vec[json::Value] = Vec::from_array([]);
    for item in value.diagnostics {
        diagnostics.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("file", json::Value::String(item.file)),
                        ("start", json::Value::Number(item.start.to_string())),
                        ("end", json::Value::Number(item.end.to_string())),
                        ("message", json::Value::String(item.message)),
                        ("soft", json::Value::Bool(item.soft)),
                        ("secondary", json::Value::Bool(item.secondary)),
                    ],
                ),
            ),
        )
    }
    json::encode(
        json::Value::Object(
            Vec::from_array(
                [
                    ("ok", json::Value::Bool(value.diagnostics.is_empty())),
                    ("diagnostics", json::Value::Array(diagnostics)),
                ],
            ),
        ),
    )
}

fn oracle_response_json(value: typecheck_diff::CheckResponse) -> string {
    let diagnostics: Vec[json::Value] = Vec::from_array([]);
    for item in value.diagnostics {
        diagnostics.push(
            json::Value::Object(
                Vec::from_array(
                    [
                        ("file", json::Value::String(item.file)),
                        ("start", json::Value::Number(item.start.to_string())),
                        ("end", json::Value::Number(item.end.to_string())),
                        ("message", json::Value::String(item.message)),
                        ("soft", json::Value::Bool(item.soft)),
                        ("secondary", json::Value::Bool(item.secondary)),
                    ],
                ),
            ),
        )
    }
    json::encode(
        json::Value::Object(
            Vec::from_array(
                [
                    ("ok", json::Value::Bool(value.ok)),
                    ("diagnostics", json::Value::Array(diagnostics)),
                ],
            ),
        ),
    )
}

fn save_typecheck_failure(
    output: string,
    request: typecheck_diff::CheckRequest,
    input: bytes::Bytes,
    actual: checker::CheckResult,
    expected: typecheck_diff::CheckResponse,
    message: string,
) -> Result[unit, string] {
    let directory = path::join(output, input_hash(input));
    let sources = path::join(directory, "sources");
    fs::create_dir_all(sources)?;
    fs::write_file(
        path::join(directory, "request.json"),
        typecheck_diff::encode_check_request(request),
    )?;
    fs::write_bytes(path::join(sources, "input.go"), input)?;
    fs::write_file(path::join(directory, "gomlgo.json"), checker_response_json(actual))?;
    fs::write_file(path::join(directory, "oracle.json"), oracle_response_json(expected))?;
    fs::write_file(path::join(directory, "diff.txt"), message)
}

pub fn run_typecheck(root: string, output: string, seed_limit: isize) -> Result[
    TypecheckSummary,
    string,
] {
    let files: Vec[string] = Vec::from_array([]);
    if fs::is_file(root) {
        files.push(root)
    } else {
        collect_go_files(root, files)?
    };
    collections::sort(files);
    let mut seeds = 0;
    let mut cases = 0;
    let mut failures = 0;
    for file in files {
        if seeds < seed_limit {
            let source = fs::read_bytes(file)?;
            let source_text = source.to_string()?;
            let seed_request = typecheck_diff::request(
                "mutation/fixture",
                Vec::from_array([typecheck_diff::SourceFile { name: file, source: source_text }]),
            );
            let seed = typecheck_diff::run_check(seed_request)?;
            if seed.ok {
                seeds += 1;
                for input in semantic_mutations(source) {
                    cases += 1;
                    let input_text = input.to_string()?;
                    let request = typecheck_diff::request(
                        "mutation/fixture",
                        Vec::from_array(
                            [typecheck_diff::SourceFile { name: file, source: input_text }],
                        ),
                    );
                    let expected = typecheck_diff::run_check(request)?;
                    let actual = loader::check_sources_with_diagnostics(
                        loader::default_config(),
                        "mutation/fixture",
                        Vec::from_array([checker::SourceFile { name: file, source: input }]),
                    )?;
                    let actual_ok = actual.diagnostics.is_empty();
                    if actual_ok != expected.ok {
                        failures += 1;
                        let message = "seed=" + file + "\nactual_ok=" + actual_ok.to_string()
                            + "\nexpected_ok="
                            + expected.ok.to_string();
                        save_typecheck_failure(output, request, input, actual, expected, message)?
                    } else {}
                }
            } else {}
        } else {}
    }
    Result::Ok(TypecheckSummary { seeds, cases, failures })
}
