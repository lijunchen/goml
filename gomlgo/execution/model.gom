package execution;

use gomlgo::checker;
use gomlgo::syntax;
use gomlgo::types as go_types;

#[derive(PartialEq, Eq, ToString)]
pub enum ExecutionMode {
    Interpreted,
    Native,
}

pub struct ExecutionConfig {
    pub go_binary: string,
    pub goos: string,
    pub goarch: string,
    pub cgo: bool,
    pub tags: Vec[string],
    pub interpret_dependencies: bool,
}

pub struct GoToolchain {
    pub binary: string,
    pub goroot: string,
    pub version: string,
    pub host_goos: string,
    pub host_goarch: string,
    pub host_cgo: bool,
}

pub struct GoListPackage {
    pub directory: string,
    pub import_path: string,
    pub name: string,
    pub standard: bool,
    pub dependency_only: bool,
    pub module_path: string,
    pub module_main: bool,
    pub module_go_version: string,
    pub go_files: Vec[string],
    pub imports: Vec[string],
}

pub struct GoListResult {
    pub toolchain: GoToolchain,
    pub packages: Vec[GoListPackage],
    pub root_path: string,
}

pub struct ExecutionPackage {
    pub package_id: go_types::PackageId,
    pub path: string,
    pub name: string,
    pub mode: ExecutionMode,
    pub dependencies: Vec[go_types::PackageId],
    pub syntax: Option[syntax::PackageSyntax],
    pub info: checker::TypeInfo,
    pub index: TypeInfoIndex,
}

pub struct TypeInfoIndex {
    pub package_id: go_types::PackageId,
    pub node_count: int,
    pub file_count: int,
    pub types: Vec[Option[checker::TypeFact]],
    pub keyed_types: HashMap[string, checker::TypeFact],
    pub definitions: Vec[Option[checker::ObjectFact]],
    pub uses: Vec[Option[checker::ObjectFact]],
    pub implicits: Vec[Option[checker::ObjectFact]],
    pub selections: Vec[Option[checker::SelectionFact]],
    pub instances: Vec[Option[checker::InstanceFact]],
    pub scopes: Vec[Option[checker::ScopeFact]],
    pub file_versions: Vec[Option[checker::FileVersionFact]],
    pub initialization_order: Vec[checker::InitializerFact],
}

pub struct TypeInfoIndexResult {
    pub index: TypeInfoIndex,
    pub diagnostics: Vec[ExecutionDiagnostic],
}

pub struct ExecutionProgram {
    pub world: go_types::World,
    pub packages: Vec[ExecutionPackage],
    pub package_indices: Vec[Option[int]],
    pub initialization_order: Vec[go_types::PackageId],
    pub main_package: go_types::PackageId,
    pub main_function: go_types::ObjectId,
    pub toolchain: GoToolchain,
}

pub struct ExecutionDiagnostic {
    pub package_path: string,
    pub file: string,
    pub start: int,
    pub end: int,
    pub message: string,
    pub soft: bool,
    pub secondary: bool,
}

pub struct ExecutionLoadResult {
    pub program: Option[ExecutionProgram],
    pub diagnostics: Vec[ExecutionDiagnostic],
}
