package execution;

use gomlgo::ast;
use gomlgo::checker;
use gomlgo::constant;
use gomlgo::parser;
use std::bytes;

fn native_api_text(package_path: string) -> Option[string] {
    match package_path {
        "bytes" => Option::Some(
            "package bytes\n" + "type Buffer struct{}\n" + "func (buffer *Buffer) Bytes() []byte\n"
                + "func (buffer *Buffer) Write(data []byte) (int, error)\n"
                + "type Reader struct{}\n"
                + "func NewReader(data []byte) *Reader\n"
                + "func (reader *Reader) Read(data []byte) (int, error)\n",
        ),
        "context" => Option::Some(
            "package context\n" + "import \"time\"\n"
                + "type Context interface { Deadline() (time.Time, bool); Done() <-chan struct{}; Err() error; Value(key any) any }\n"
                + "type CancelFunc func()\n"
                + "var DeadlineExceeded error\n"
                + "func Background() Context\n"
                + "func WithCancel(parent Context) (Context, CancelFunc)\n"
                + "func WithTimeout(parent Context, timeout time.Duration) (Context, CancelFunc)\n",
        ),
        "crypto/sha256" => Option::Some(
            "package sha256\n" + "import \"hash\"\n" + "func New() hash.Hash\n",
        ),
        "errors" => Option::Some("package errors\n" + "func Is(err error, target error) bool\n"),
        "fmt" => Option::Some(
            "package fmt\n" + "import \"io\"\n"
                + "func Fprint(w io.Writer, a ...any) (int, error)\n"
                + "func Print(a ...any) (int, error)\n"
                + "func Println(a ...any) (int, error)\n"
                + "func Sprintf(format string, a ...any) string\n",
        ),
        "io" => Option::Some(
            "package io\n" + "type Reader interface { Read(p []byte) (int, error) }\n"
                + "type Writer interface { Write(p []byte) (int, error) }\n"
                + "var EOF error\n"
                + "var ErrShortWrite error\n"
                + "var ErrUnexpectedEOF error\n"
                + "func Copy(destination Writer, source Reader) (int64, error)\n",
        ),
        "hash" => Option::Some(
            "package hash\n"
                + "type Hash interface { Write(p []byte) (int, error); Sum(b []byte) []byte; Reset(); Size() int; BlockSize() int }\n",
        ),
        "io/fs" => Option::Some(
            "package fs\n" + "import \"time\"\n" + "type FileMode uint32\n"
                + "type DirEntry interface { Name() string; IsDir() bool; Type() FileMode; Info() (FileInfo, error) }\n"
                + "type FileInfo interface { Name() string; Size() int64; Mode() FileMode; ModTime() time.Time; IsDir() bool; Sys() any }\n",
        ),
        "os" => Option::Some(
            "package os\n" + "import \"io/fs\"\n" + "type File struct{}\n"
                + "type FileMode = fs.FileMode\n"
                + "type DirEntry = fs.DirEntry\n"
                + "type FileInfo = fs.FileInfo\n"
                + "type LinkError struct { Op string; Old string; New string; Err error }\n"
                + "func (error_value *LinkError) Error() string\n"
                + "type PathError struct { Op string; Path string; Err error }\n"
                + "func (error_value *PathError) Error() string\n"
                + "type SyscallError struct { Syscall string; Err error }\n"
                + "func (error_value *SyscallError) Error() string\n"
                + "type Process struct { Pid int }\n"
                + "type ProcessState struct{}\n"
                + "func (state *ProcessState) ExitCode() int\n"
                + "func (file *File) Read(data []byte) (int, error)\n"
                + "func (file *File) Write(data []byte) (int, error)\n"
                + "func (file *File) Close() error\n"
                + "var Args []string\n"
                + "var Stderr *File\n"
                + "var Stdin *File\n"
                + "var Stdout *File\n"
                + "func Environ() []string\n"
                + "func Executable() (string, error)\n"
                + "func Exit(code int)\n"
                + "func Getwd() (string, error)\n"
                + "func IsExist(err error) bool\n"
                + "func IsNotExist(err error) bool\n"
                + "func IsPermission(err error) bool\n"
                + "func IsTimeout(err error) bool\n"
                + "func Link(oldname string, newname string) error\n"
                + "func LookupEnv(key string) (string, bool)\n"
                + "func Mkdir(name string, perm FileMode) error\n"
                + "func MkdirAll(path string, perm FileMode) error\n"
                + "func Open(name string) (*File, error)\n"
                + "func ReadDir(name string) ([]DirEntry, error)\n"
                + "func ReadFile(name string) ([]byte, error)\n"
                + "func Remove(name string) error\n"
                + "func RemoveAll(path string) error\n"
                + "func Rename(oldpath string, newpath string) error\n"
                + "func Stat(name string) (FileInfo, error)\n"
                + "func Symlink(oldname string, newname string) error\n"
                + "func WriteFile(name string, data []byte, perm FileMode) error\n",
        ),
        "os/exec" => Option::Some(
            "package exec\n" + "import \"context\"\n" + "import \"io\"\n" + "import \"os\"\n"
                + "import \"syscall\"\n"
                + "import \"time\"\n"
                + "type Cmd struct { Path string; Args []string; Env []string; Dir string; Stdin io.Reader; Stdout io.Writer; Stderr io.Writer; ExtraFiles []*os.File; SysProcAttr *syscall.SysProcAttr; Process *os.Process; ProcessState *os.ProcessState; Err error; Cancel func() error; WaitDelay time.Duration }\n"
                + "func Command(name string, arguments ...string) *Cmd\n"
                + "func CommandContext(context_value context.Context, name string, arguments ...string) *Cmd\n"
                + "func LookPath(file string) (string, error)\n"
                + "func (command *Cmd) Run() error\n",
        ),
        "path/filepath" => Option::Some(
            "package filepath\n" + "func Abs(path string) (string, error)\n"
                + "func Base(path string) string\n"
                + "func Clean(path string) string\n"
                + "func Dir(path string) string\n"
                + "func EvalSymlinks(path string) (string, error)\n"
                + "func Ext(path string) string\n"
                + "func IsAbs(path string) bool\n"
                + "func Join(elements ...string) string\n",
        ),
        "reflect" => Option::Some(
            "package reflect\n" + "type Value struct{}\n" + "func ValueOf(value any) Value\n"
                + "func (value Value) Pointer() uintptr\n",
        ),
        "runtime" => Option::Some(
            "package runtime\n" + "func Gosched()\n" + "func Stack(buffer []byte, all bool) int\n",
        ),
        "slices" => Option::Some(
            "package slices\n" + "func Grow[S ~[]E, E any](slice S, count int) S { return slice }\n",
        ),
        "strconv" => Option::Some(
            "package strconv\n"
                + "func FormatFloat(value float64, format byte, precision int, bits int) string\n"
                + "func ParseFloat(value string, bits int) (float64, error)\n",
        ),
        "strings" => Option::Some(
            "package strings\n"
                + "func Cut(value string, separator string) (string, string, bool)\n"
                + "func Join(values []string, separator string) string\n"
                + "func TrimPrefix(value string, prefix string) string\n"
                + "func TrimSuffix(value string, suffix string) string\n"
                + "func ToUpper(value string) string\n",
        ),
        "sync" => Option::Some(
            "package sync\n" + "type Locker interface { Lock(); Unlock() }\n"
                + "type Mutex struct{}\n"
                + "func (mutex *Mutex) Lock()\n"
                + "func (mutex *Mutex) Unlock()\n"
                + "type Cond struct { L Locker }\n"
                + "func NewCond(locker Locker) *Cond\n"
                + "func (condition *Cond) Broadcast()\n"
                + "func (condition *Cond) Wait()\n"
                + "type WaitGroup struct{}\n"
                + "func (group *WaitGroup) Add(delta int)\n"
                + "func (group *WaitGroup) Done()\n"
                + "func (group *WaitGroup) Wait()\n",
        ),
        "syscall" => Option::Some(
            "package syscall\n" + "type Errno uintptr\n"
                + "func (error_value Errno) Error() string\n"
                + "type Signal int\n"
                + "type SysProcAttr struct { Setpgid bool }\n"
                + "const EAGAIN Errno = 11\n"
                + "const EINTR Errno = 4\n"
                + "const EINVAL Errno = 22\n"
                + "const ENAMETOOLONG Errno = 36\n"
                + "const EPIPE Errno = 32\n"
                + "const SIGKILL Signal = 9\n"
                + "func Kill(pid int, signal Signal) error\n",
        ),
        "time" => Option::Some(
            "package time\n" + "type Duration int64\n" + "const Millisecond Duration = 1000000\n"
                + "type Time struct{}\n"
                + "func Now() Time\n"
                + "func (value Time) UnixNano() int64\n",
        ),
        _ => Option::None,
    }
}

fn native_api_dependencies(package_path: string) -> Vec[string] {
    match package_path {
        "context" => Vec::from_array(["time"]),
        "crypto/sha256" => Vec::from_array(["hash"]),
        "fmt" => Vec::from_array(["io"]),
        "hash" => Vec::from_array([]),
        "io/fs" => Vec::from_array(["time"]),
        "os" => Vec::from_array(["io/fs"]),
        "os/exec" => Vec::from_array(["context", "io", "os", "syscall", "time"]),
        _ => Vec::from_array([]),
    }
}

fn native_api_file(name: string) -> bool {
    name.ends_with(".gom.go") || name == "goml_generated.go"
}

fn native_api_source(package_path: string) -> Option[checker::SourceFile] {
    match native_api_text(package_path) {
        Some(source) => Option::Some(
            checker::SourceFile {
                name: "<native-api>/" + package_path + ".go",
                source: bytes::Bytes::from_string(source),
            },
        ),
        None => Option::None,
    }
}

fn visit_native_api(package_path: string, states: HashMap[string, int], output: Vec[string]) -> bool {
    match states[package_path] {
        Some(1) => return false,
        Some(2) => return true,
        _ => {},
    };
    if native_api_text(package_path).is_none() {
        return false
    } else {};
    states[package_path] = 1;
    for dependency in native_api_dependencies(package_path) {
        if !visit_native_api(dependency, states, output) {
            return false
        } else {}
    }
    states[package_path] = 2;
    output.push(package_path);
    true
}

fn native_api_order(imports: Vec[string]) -> Option[Vec[string]] {
    let result: Vec[string] = Vec::from_array([]);
    let states: HashMap[string, int] = HashMap::from_array([]);
    for import_path in imports {
        if import_path == "unsafe" || !visit_native_api(import_path, states, result) {
            return Option::None
        } else {}
    }
    Option::Some(result)
}

fn native_api_package_name(package_path: string) -> string {
    match package_path {
        "crypto/sha256" => "sha256",
        "io/fs" => "fs",
        "os/exec" => "exec",
        "path/filepath" => "filepath",
        _ => package_path,
    }
}

fn native_api_file_header(source: bytes::Bytes) -> Option[(string, Vec[string])] {
    let parsed = parser::parse_file_bytes_without_bodies(source);
    if !parsed.diagnostics.is_empty() {
        return Option::None
    } else {};
    let root = parsed.root?;
    let name = ast::get_string(ast::get_node(root, "name")?, "name")?;
    let imports: Vec[string] = Vec::from_array([]);
    for import_spec in ast::get_nodes(root, "imports") {
        let path = ast::get_node(import_spec, "path")?;
        let literal = ast::get_string(path, "value")?;
        match constant::parse_string_literal(literal) {
            Ok(constant::ConstValue::String(value)) => imports.push(value),
            _ => return Option::None,
        }
    }
    Option::Some((name, imports))
}

fn native_api_listed(toolchain: GoToolchain, directory: string, name: string, source: bytes::Bytes) -> Option[
    (GoListResult, Vec[string]),
] {
    let header = native_api_file_header(source)?;
    let order = native_api_order(header.1)?;
    let packages: Vec[GoListPackage] = Vec::with_capacity(order.len() + 1);
    for package_path in order {
        packages.push(
            GoListPackage {
                directory: "",
                import_path: package_path,
                name: native_api_package_name(package_path),
                standard: true,
                dependency_only: true,
                module_path: "",
                module_main: false,
                module_go_version: "",
                go_files: Vec::from_array([]),
                imports: native_api_dependencies(package_path),
            },
        )
    }
    let root_path = "command-line-arguments";
    packages.push(
        GoListPackage {
            directory,
            import_path: root_path,
            name: header.0,
            standard: false,
            dependency_only: false,
            module_path: "",
            module_main: false,
            module_go_version: "",
            go_files: Vec::from_array([name]),
            imports: header.1,
        },
    );
    Option::Some((GoListResult { toolchain, packages, root_path }, order))
}
