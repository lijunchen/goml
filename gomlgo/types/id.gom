package types;

pub struct TypeId {
    pub value: int,
}

pub struct ObjectId {
    pub value: int,
}

pub struct ScopeId {
    pub value: int,
}

pub struct PackageId {
    pub value: int,
}

pub fn type_id(value: int) -> TypeId {
    TypeId { value }
}

pub fn object_id(value: int) -> ObjectId {
    ObjectId { value }
}

pub fn scope_id(value: int) -> ScopeId {
    ScopeId { value }
}

pub fn package_id(value: int) -> PackageId {
    PackageId { value }
}
