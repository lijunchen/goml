#[derive(PartialEq, Eq, ToString)]
pub struct CellId {
    pub value: int,
}

pub fn cell_id(value: int) -> CellId {
    CellId { value }
}

pub enum Projection {
    Field(int),
    Index(int),
}

pub struct Place {
    pub root: CellId,
    pub projections: Vec[Projection],
}

pub enum FunctionTarget {
    Bytecode(bytecode::FunctionId),
    MethodExpression {
        function: bytecode::FunctionId,
        receiver_type: go_types::TypeId,
        index: Vec[int],
    },
    InterfaceMethod(go_types::ObjectId),
}

pub struct FunctionValue {
    pub target: FunctionTarget,
    pub captures: Vec[CellId],
    pub receiver: Option[Ref[Value]],
}

pub struct SliceValue {
    pub element_type: go_types::TypeId,
    pub backing: Option[Place],
    pub offset: int,
    pub length: int,
    pub capacity: int,
}

pub enum LocalValue {
    Unit,
    Bool(bool),
    Integer {
        bits: uint64,
        width: int,
        signed: bool,
    },
    Float {
        bits: uint64,
        width: int,
    },
    Complex {
        real: uint64,
        imaginary: uint64,
        width: int,
    },
    String(bytes::Bytes),
    Pointer(Option[Place]),
    Slice(SliceValue),
    Aggregate {
        type_id: go_types::TypeId,
        elements: Vec[Value],
    },
    Map(int),
    Channel(int),
    Function(Option[FunctionValue]),
}

pub enum Value {
    Local(LocalValue),
    Host {
        type_id: go_types::TypeId,
        value: HostValueRef,
    },
    Interface {
        static_type: go_types::TypeId,
        dynamic_type: Option[go_types::TypeId],
        value: Option[Ref[Value]],
    },
}

fn copied_projections(values: Vec[Projection]) -> Vec[Projection] {
    let result: Vec[Projection] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            match value {
                Projection::Field(index) => Projection::Field(index),
                Projection::Index(index) => Projection::Index(index),
            },
        )
    }
    result
}

pub fn copy_place(value: Place) -> Place {
    Place { root: value.root, projections: copied_projections(value.projections) }
}

fn copy_function(value: FunctionValue) -> FunctionValue {
    let captures: Vec[CellId] = Vec::with_capacity(value.captures.len());
    for capture in value.captures {
        captures.push(capture)
    }
    let target = match value.target {
        FunctionTarget::Bytecode(function) => FunctionTarget::Bytecode(function),
        FunctionTarget::MethodExpression { function, receiver_type, index } => {
            let copied: Vec[int] = Vec::with_capacity(index.len());
            for value in index {
                copied.push(value)
            }
            FunctionTarget::MethodExpression { function, receiver_type, index: copied }
        },
        FunctionTarget::InterfaceMethod(method) => FunctionTarget::InterfaceMethod(method),
    };
    FunctionValue {
        target,
        captures,
        receiver: match value.receiver {
            Some(receiver) => Option::Some(Ref::new(copy_value(receiver.get()))),
            None => Option::None,
        },
    }
}

fn copy_slice(value: SliceValue) -> SliceValue {
    SliceValue {
        element_type: value.element_type,
        backing: match value.backing {
            Some(place) => Option::Some(copy_place(place)),
            None => Option::None,
        },
        offset: value.offset,
        length: value.length,
        capacity: value.capacity,
    }
}

pub fn copy_value(value: Value) -> Value {
    match value {
        Value::Local(LocalValue::Pointer(value)) => Value::Local(
            LocalValue::Pointer(
                match value {
                    Some(place) => Option::Some(copy_place(place)),
                    None => Option::None,
                },
            ),
        ),
        Value::Local(LocalValue::Slice(value)) => {
            Value::Local(LocalValue::Slice(copy_slice(value)))
        },
        Value::Local(LocalValue::Aggregate { type_id, elements }) => {
            let copied: Vec[Value] = Vec::with_capacity(elements.len());
            for element in elements {
                copied.push(copy_value(element))
            }
            Value::Local(LocalValue::Aggregate { type_id, elements: copied })
        },
        Value::Local(LocalValue::Function(value)) => Value::Local(
            LocalValue::Function(
                match value {
                    Some(function) => Option::Some(copy_function(function)),
                    None => Option::None,
                },
            ),
        ),
        Value::Host { type_id, value } => {
            Value::Host { type_id, value: clone_host_value(value) }
        },
        Value::Interface { static_type, dynamic_type, value } => Value::Interface {
            static_type,
            dynamic_type,
            value: match value {
                Some(inner) => Option::Some(Ref::new(copy_value(inner.get()))),
                None => Option::None,
            },
        },
        value => value,
    }
}

pub fn integer_bits(value: Value) -> Result[(uint64, int, bool), string] {
    match value {
        Value::Local(LocalValue::Integer { bits, width, signed }) => {
            Result::Ok((bits, width, signed))
        },
        _ => Result::Err("value is not an integer"),
    }
}

pub fn integer_index(value: Value) -> Result[int, string] {
    let value = integer_host(value)?;
    if value < 0 {
        Result::Err("index is outside the host integer range")
    } else {
        Result::Ok(value)
    }
}

pub fn integer_host(value: Value) -> Result[int, string] {
    let (bits, width, signed) = integer_bits(value)?;
    if signed {
        Result::Ok(signed_integer(bits, width).to_int())
    } else if bits > 9223372036854775807.to_uint64() {
        Result::Err("integer is outside the host integer range")
    } else {
        Result::Ok(bits.to_int())
    }
}

pub fn boolean_value(value: Value) -> Result[bool, string] {
    match value {
        Value::Local(LocalValue::Bool(value)) => Result::Ok(value),
        _ => Result::Err("value is not boolean"),
    }
}

fn projections_equal(left: Vec[Projection], right: Vec[Projection]) -> bool {
    if left.len() != right.len() {
        return false
    } else {};
    for index in 0..left.len() {
        let equal = match (left[index], right[index]) {
            (Projection::Field(left), Projection::Field(right)) => left == right,
            (Projection::Index(left), Projection::Index(right)) => left == right,
            _ => false,
        };
        if !equal {
            return false
        } else {}
    }
    true
}

pub fn places_equal(left: Place, right: Place) -> bool {
    left.root.value == right.root.value && projections_equal(left.projections, right.projections)
}

fn float_bits_nan(bits: uint64, width: int) -> bool {
    if width == 32 {
        let exponent = (bits >> 23) & 255.to_uint64();
        let fraction = bits & ((1.to_uint64() << 23) - 1.to_uint64());
        exponent == 255.to_uint64() && fraction != 0.to_uint64()
    } else {
        let exponent = (bits >> 52) & 2047.to_uint64();
        let fraction = bits & ((1.to_uint64() << 52) - 1.to_uint64());
        exponent == 2047.to_uint64() && fraction != 0.to_uint64()
    }
}

fn float_bits_zero(bits: uint64, width: int) -> bool {
    if width == 32 {
        bits & ((1.to_uint64() << 31) - 1.to_uint64()) == 0.to_uint64()
    } else {
        bits & ((1.to_uint64() << 63) - 1.to_uint64()) == 0.to_uint64()
    }
}

fn float_bits_equal(left: uint64, right: uint64, width: int) -> bool {
    if float_bits_nan(left, width) || float_bits_nan(right, width) {
        false
    } else if float_bits_zero(left, width) && float_bits_zero(right, width) {
        true
    } else {
        left == right
    }
}

pub fn values_equal(world: go_types::World, left: Value, right: Value) -> Result[bool, string] {
    match (left, right) {
        (Value::Local(LocalValue::Unit), Value::Local(LocalValue::Unit)) => Result::Ok(true),
        (Value::Local(LocalValue::Bool(left)), Value::Local(LocalValue::Bool(right))) => {
            Result::Ok(left == right)
        },
        (
            Value::Local(LocalValue::Integer { bits: left, width: _, signed: _ }),
            Value::Local(LocalValue::Integer { bits: right, width: _, signed: _ }),
        ) => Result::Ok(left == right),
        (
            Value::Local(LocalValue::Float { bits: left, width }),
            Value::Local(LocalValue::Float { bits: right, width: right_width }),
        ) => Result::Ok(width == right_width && float_bits_equal(left, right, width)),
        (
            Value::Local(LocalValue::Complex { real: left_real, imaginary: left_imaginary, width },),
            Value::Local(LocalValue::Complex {
                real: right_real,
                imaginary: right_imaginary,
                width: right_width,
            },),
        ) => {
            let component_width = if width == 64 {
                32
            } else {
                64
            };
            Result::Ok(
                width == right_width && float_bits_equal(left_real, right_real, component_width)
                    && float_bits_equal(left_imaginary, right_imaginary, component_width),
            )
        },
        (Value::Local(LocalValue::String(left)), Value::Local(LocalValue::String(right))) => {
            if left.len() != right.len() {
                return Result::Ok(false)
            } else {};
            for index in 0..left.len() {
                if left.get(index) != right.get(index) {
                    return Result::Ok(false)
                } else {}
            }
            Result::Ok(true)
        },
        (Value::Local(LocalValue::Pointer(left)), Value::Local(LocalValue::Pointer(right))) => {
            Result::Ok(
                match (left, right) {
                    (Some(left), Some(right)) => places_equal(left, right),
                    (None, None) => true,
                    _ => false,
                },
            )
        },
        (
            Value::Local(LocalValue::Pointer(None)),
            Value::Local(LocalValue::Slice(SliceValue {
                element_type: _,
                backing: None,
                offset: _,
                length: _,
                capacity: _,
            })),
        ) | (
            Value::Local(LocalValue::Slice(SliceValue {
                element_type: _,
                backing: None,
                offset: _,
                length: _,
                capacity: _,
            })),
            Value::Local(LocalValue::Pointer(None)),
        ) | (Value::Local(LocalValue::Pointer(None)), Value::Local(LocalValue::Map(- 1))) | (
            Value::Local(LocalValue::Map(- 1)),
            Value::Local(LocalValue::Pointer(None)),
        ) | (Value::Local(LocalValue::Pointer(None)), Value::Local(LocalValue::Channel(- 1))) | (
            Value::Local(LocalValue::Channel(- 1)),
            Value::Local(LocalValue::Pointer(None)),
        ) | (Value::Local(LocalValue::Pointer(None)), Value::Local(LocalValue::Function(None))) | (
            Value::Local(LocalValue::Function(None)),
            Value::Local(LocalValue::Pointer(None)),
        ) => Result::Ok(true),
        (Value::Local(LocalValue::Map(left)), Value::Local(LocalValue::Map(right))) => {
            Result::Ok(left == right)
        },
        (Value::Local(LocalValue::Channel(left)), Value::Local(LocalValue::Channel(right))) => {
            Result::Ok(left == right)
        },
        (
            Value::Local(LocalValue::Function(Option::None)),
            Value::Local(LocalValue::Function(Option::None)),
        ) => Result::Ok(true),
        (
            Value::Local(LocalValue::Function(Option::None)),
            Value::Local(LocalValue::Function(Option::Some(_))),
        ) | (
            Value::Local(LocalValue::Function(Option::Some(_))),
            Value::Local(LocalValue::Function(Option::None)),
        ) => Result::Ok(false),
        (
            Value::Local(LocalValue::Aggregate { type_id: _, elements: left }),
            Value::Local(LocalValue::Aggregate { type_id: _, elements: right }),
        ) => {
            if left.len() != right.len() {
                return Result::Ok(false)
            } else {};
            for index in 0..left.len() {
                if !values_equal(world, left[index], right[index])? {
                    return Result::Ok(false)
                } else {}
            }
            Result::Ok(true)
        },
        (
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
        ) => Result::Ok(true),
        (
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
            Value::Interface { dynamic_type: Some(_), static_type: _, value: _ },
        ) | (
            Value::Interface { dynamic_type: Some(_), static_type: _, value: _ },
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
        ) | (
            Value::Interface { dynamic_type: Some(_), static_type: _, value: _ },
            Value::Local(LocalValue::Pointer(None)),
        ) | (
            Value::Local(LocalValue::Pointer(None)),
            Value::Interface { dynamic_type: Some(_), static_type: _, value: _ },
        ) => Result::Ok(false),
        (
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
            Value::Local(LocalValue::Pointer(None)),
        ) | (
            Value::Local(LocalValue::Pointer(None)),
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
        ) => Result::Ok(true),
        (
            Value::Host { type_id: _, value },
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
        ) | (
            Value::Interface { dynamic_type: None, static_type: _, value: _ },
            Value::Host { type_id: _, value },
        ) => Result::Ok(native_value_nil(value)),
        (Value::Host { type_id: _, value }, Value::Local(LocalValue::Pointer(None))) | (
            Value::Local(LocalValue::Pointer(None)),
            Value::Host { type_id: _, value },
        ) => Result::Ok(native_value_nil(value)),
        (
            Value::Interface { dynamic_type: Some(left_type), static_type: _, value: Some(left) },
            Value::Interface { dynamic_type: Some(right_type), static_type: _, value: Some(right) },
        ) => if left_type.value != right_type.value {
            Result::Ok(false)
        } else if !go_types::comparable(world, left_type) {
            Result::Err("comparing uncomparable type")
        } else {
            values_equal(world, left.get(), right.get())
        },
        _ => Result::Err("values are not comparable"),
    }
}
