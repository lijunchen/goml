fn new_native_callback_queue(completion: NativeCompletionQueue, capacity: int) -> NativeCallbackQueue {
    NativeCallbackQueue { value: new_native_callback_queue_value(completion.value, capacity) }
}

fn native_callback_token(queue: NativeCallbackQueue) -> NativeHostValue {
    NativeHostValue { value: native_callback_token_value(queue.value) }
}

fn take_native_callback_request(queue: NativeCallbackQueue) -> Option[NativeCallbackRequest] {
    let value = native_callback_request_value(queue.value);
    if native_host_value_valid(value) {
        Option::Some(NativeCallbackRequest { value })
    } else {
        Option::None
    }
}

fn close_native_callback_queue(queue: NativeCallbackQueue) -> unit {
    close_native_callback_queue_value(queue.value)
}

fn native_callback_argument_count(request: NativeCallbackRequest) -> int {
    native_callback_argument_count_value(request.value)
}

fn native_callback_method(request: NativeCallbackRequest) -> string {
    native_callback_method_value(request.value)
}

fn native_callback_argument(request: NativeCallbackRequest, index: int) -> NativeHostValue {
    NativeHostValue { value: native_callback_argument_value(request.value, index) }
}

fn write_native_callback_argument(
    request: NativeCallbackRequest,
    index: int,
    value: NativeHostValue,
) -> bool {
    write_native_callback_argument_value(request.value, index, value.value)
}

fn new_native_callback_completion(request: NativeCallbackRequest) -> NativeCallbackCompletion {
    NativeCallbackCompletion { value: new_native_callback_completion_value(request.value) }
}

fn append_native_callback_result(completion: NativeCallbackCompletion, value: NativeHostValue) -> unit {
    append_native_callback_result_value(completion.value, value.value)
}

fn set_native_callback_panic(completion: NativeCallbackCompletion, value: NativeHostValue) -> unit {
    set_native_callback_panic_value(completion.value, value.value)
}

fn set_native_callback_exit(completion: NativeCallbackCompletion, code: int) -> unit {
    set_native_callback_exit_value(completion.value, code)
}

fn set_native_callback_error(completion: NativeCallbackCompletion, message: string) -> unit {
    set_native_callback_error_value(completion.value, message)
}

fn finish_native_callback(completion: NativeCallbackCompletion) -> bool {
    finish_native_callback_value(completion.value)
}

