fn new_native_invocation(call_id: int, variadic: bool) -> NativeInvocation {
    NativeInvocation { value: new_native_invocation_value(call_id, variadic) }
}

fn new_native_value_invocation(function: HostValueRef, variadic: bool) -> NativeInvocation {
    NativeInvocation { value: new_native_value_invocation_value(function, variadic) }
}

fn new_native_completion_queue(capacity: int) -> NativeCompletionQueue {
    NativeCompletionQueue { value: new_native_invocation_queue_value(capacity) }
}

fn start_native_completion(queue: NativeCompletionQueue, invocation: NativeInvocation) -> bool {
    start_queued_native_invocation(queue.value, invocation.value)
}

fn native_completion_ready(invocation: NativeInvocation) -> bool {
    native_invocation_ready(invocation.value)
}

fn take_native_completion(queue: NativeCompletionQueue) -> bool {
    try_native_completion(queue.value)
}

fn await_native_completion(queue: NativeCompletionQueue) -> bool {
    wait_native_completion(queue.value)
}

fn close_native_completions(queue: NativeCompletionQueue) -> unit {
    close_native_completion_queue(queue.value)
}

