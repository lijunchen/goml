package interpreter;

const memory_cell_block_size: int = 4096;

pub struct Memory {
    pub cells: Vec[Vec[Value]],
    pub length: Ref[int],
    frame_cells: Vec[Value],
}

pub fn new_memory() -> Memory {
    Memory { cells: Vec::from_array([]), length: Ref::new(0), frame_cells: Vec::from_array([]) }
}

pub fn allocate_cell(memory: Memory, value: Value) -> CellId {
    let index = memory.length.get();
    let block = index / memory_cell_block_size;
    if block >= memory.cells.len() {
        memory.cells.push(Vec::with_capacity(memory_cell_block_size))
    } else {};
    memory.cells[block].push(copy_value(value));
    memory.length.set(index + 1);
    cell_id(index)
}

fn frame_cell_value(index: int) -> int {
    -index - 2
}

fn frame_cell_index(value: int) -> int {
    -value - 2
}

fn allocate_frame_cell(memory: Memory, value: Value) -> CellId {
    let index = memory.frame_cells.len();
    memory.frame_cells.push(copy_value(value));
    cell_id(frame_cell_value(index))
}

fn frame_cell_checkpoint(memory: Memory) -> int {
    memory.frame_cells.len()
}

fn release_frame_cells(memory: Memory, checkpoint: int) -> unit {
    memory.frame_cells.truncate(checkpoint)
}

fn cell_valid(memory: Memory, value: int) -> bool {
    if value >= 0 {
        value < memory.length.get()
    } else if value <= -2 {
        frame_cell_index(value) < memory.frame_cells.len()
    } else {
        false
    }
}

fn cell_value(memory: Memory, index: int) -> Value {
    if index >= 0 {
        memory.cells[index / memory_cell_block_size][index % memory_cell_block_size]
    } else {
        memory.frame_cells[frame_cell_index(index)]
    }
}

fn set_cell_value(memory: Memory, index: int, value: Value) -> unit {
    if index >= 0 {
        memory.cells[index / memory_cell_block_size][index % memory_cell_block_size] = value;
    } else {
        memory.frame_cells[frame_cell_index(index)] = value;
    }
}

fn bool_backing(memory: Memory, place: Place) -> Option[Vec[bool]] {
    let root = match place.projections {
        Some(projections) => projections.is_empty(),
        None => true,
    };
    if !root || !cell_valid(memory, place.root.value) {
        Option::None
    } else {
        match cell_value(memory, place.root.value) {
            Value::Local(LocalValue::BoolBacking(elements)) => Option::Some(elements),
            _ => Option::None,
        }
    }
}

fn load_cell(memory: Memory, cell: CellId) -> Result[Value, string] {
    if !cell_valid(memory, cell.value) {
        Result::Err("invalid cell " + cell.value.to_string())
    } else {
        Result::Ok(copy_value(cell_value(memory, cell.value)))
    }
}

fn store_cell(memory: Memory, cell: CellId, value: Value) -> Result[unit, string] {
    if !cell_valid(memory, cell.value) {
        Result::Err("invalid cell " + cell.value.to_string())
    } else {
        set_cell_value(memory, cell.value, copy_value(value));
        Result::Ok(())
    }
}

pub fn root_place(cell: CellId) -> Place {
    Place { root: cell, projections: Option::None }
}

fn projection_count(value: Option[Vec[Projection]]) -> int {
    match value {
        Some(values) => values.len(),
        None => 0,
    }
}

fn append_projections(target: Vec[Projection], value: Option[Vec[Projection]]) -> unit {
    match value {
        Some(values) => for projection in values {
            target.push(projection)
        },
        None => (),
    }
}

pub fn field_place(base: Place, indices: Vec[int]) -> Place {
    let projections: Vec[Projection] = Vec::with_capacity(
        projection_count(base.projections) + indices.len(),
    );
    append_projections(projections, base.projections);
    for index in indices {
        projections.push(Projection::Field(index))
    }
    Place { root: base.root, projections: Option::Some(projections) }
}

pub fn index_place(base: Place, index: int) -> Place {
    let projections: Vec[Projection] = Vec::with_capacity(projection_count(base.projections) + 1);
    append_projections(projections, base.projections);
    projections.push(Projection::Index(index));
    Place { root: base.root, projections: Option::Some(projections) }
}

fn slice_element_place(value: SliceValue, index: int) -> Result[Place, string] {
    if index < 0 || index >= value.length {
        return Result::Err(
            "index out of range [" + index.to_string() + "] with length " + value.length.to_string(),
        )
    } else {};
    let base = value.backing.ok_or("index of nil slice")?;
    Result::Ok(index_place(base, value.offset + index))
}

pub fn indexed_place(memory: Memory, base: Place, index: int) -> Result[Place, string] {
    match load_place(memory, base) {
        Ok(Value::Local(LocalValue::Slice(value))) => slice_element_place(value, index),
        Ok(_) => Result::Ok(index_place(base, index)),
        Err(message) => Result::Err(message),
    }
}

fn load_projection(memory: Memory, value: Value, projections: Vec[Projection], offset: int) -> Result[
    Value,
    string,
] {
    if offset >= projections.len() {
        return Result::Ok(copy_value(value))
    } else {};
    match (value, projections[offset]) {
        (
            Value::Local(LocalValue::Aggregate { type_id: _, elements, host: _ }),
            Projection::Field(index),
        ) | (
            Value::Local(LocalValue::Aggregate { type_id: _, elements, host: _ }),
            Projection::Index(index),
        ) => {
            if index < 0 || index >= elements.len() {
                Result::Err("aggregate index out of range")
            } else {
                load_projection(memory, elements[index], projections, offset + 1)
            }
        },
        (Value::Local(LocalValue::Slice(slice)), Projection::Index(index)) => {
            let place = slice_element_place(slice, index)?;
            let nested = load_place(memory, place)?;
            load_projection(memory, nested, projections, offset + 1)
        },
        (Value::Local(LocalValue::BoolBacking(elements)), Projection::Index(index)) => {
            if index < 0 || index >= elements.len() {
                Result::Err("aggregate index out of range")
            } else {
                load_projection(
                    memory,
                    Value::Local(LocalValue::Bool(elements[index])),
                    projections,
                    offset + 1,
                )
            }
        },
        _ => Result::Err("place projection does not match stored value"),
    }
}

pub fn load_place(memory: Memory, place: Place) -> Result[Value, string] {
    if !cell_valid(memory, place.root.value) {
        return Result::Err("invalid cell " + place.root.value.to_string())
    } else {};
    let value = cell_value(memory, place.root.value);
    match place.projections {
        Some(projections) => load_projection(memory, value, projections, 0),
        None => Result::Ok(copy_value(value)),
    }
}

fn borrow_projection(memory: Memory, value: Value, projections: Vec[Projection], offset: int) -> Result[
    Value,
    string,
] {
    if offset >= projections.len() {
        return Result::Ok(value)
    } else {};
    match (value, projections[offset]) {
        (
            Value::Local(LocalValue::Aggregate { type_id: _, elements, host: _ }),
            Projection::Field(index),
        ) | (
            Value::Local(LocalValue::Aggregate { type_id: _, elements, host: _ }),
            Projection::Index(index),
        ) => if index < 0 || index >= elements.len() {
            Result::Err("aggregate index out of range")
        } else {
            borrow_projection(memory, elements[index], projections, offset + 1)
        },
        (Value::Local(LocalValue::Slice(slice)), Projection::Index(index)) => {
            let place = slice_element_place(slice, index)?;
            let nested = borrow_place(memory, place)?;
            borrow_projection(memory, nested, projections, offset + 1)
        },
        (Value::Local(LocalValue::BoolBacking(elements)), Projection::Index(index)) => {
            if index < 0 || index >= elements.len() {
                Result::Err("aggregate index out of range")
            } else {
                borrow_projection(
                    memory,
                    Value::Local(LocalValue::Bool(elements[index])),
                    projections,
                    offset + 1,
                )
            }
        },
        _ => Result::Err("place projection does not match stored value"),
    }
}

pub fn borrow_place(memory: Memory, place: Place) -> Result[Value, string] {
    if !cell_valid(memory, place.root.value) {
        return Result::Err("invalid cell " + place.root.value.to_string())
    } else {};
    let value = cell_value(memory, place.root.value);
    match place.projections {
        Some(projections) => borrow_projection(memory, value, projections, 0),
        None => Result::Ok(value),
    }
}

fn store_projection(
    memory: Memory,
    current: Value,
    projections: Vec[Projection],
    offset: int,
    value: Value,
) -> Result[Value, string] {
    if offset >= projections.len() {
        return Result::Err("store projection ended without a cell")
    } else {};
    match (current, projections[offset]) {
        (
            Value::Local(LocalValue::Aggregate { type_id, elements, host: _ }),
            Projection::Field(index),
        ) | (
            Value::Local(LocalValue::Aggregate { type_id, elements, host: _ }),
            Projection::Index(index),
        ) => {
            if index < 0 || index >= elements.len() {
                return Result::Err("aggregate index out of range")
            } else {};
            let updated: Vec[Value] = Vec::with_capacity(elements.len());
            for element in elements {
                updated.push(element)
            }
            if offset + 1 == projections.len() {
                updated[index] = copy_value(value);
            } else {
                updated[index] = store_projection(
                    memory,
                    elements[index],
                    projections,
                    offset + 1,
                    value,
                )?;
            };
            Result::Ok(local_aggregate(type_id, updated))
        },
        (Value::Local(LocalValue::BoolBacking(elements)), Projection::Index(index)) => {
            if index < 0 || index >= elements.len() {
                return Result::Err("aggregate index out of range")
            } else if offset + 1 != projections.len() {
                return Result::Err("place projection does not match stored value")
            } else {};
            elements[index] = boolean_value(value)?;
            Result::Ok(Value::Local(LocalValue::BoolBacking(elements)))
        },
        (Value::Local(LocalValue::Slice(slice)), Projection::Index(index)) => {
            let mut projected = slice_element_place(slice, index)?;
            if offset + 1 == projections.len() {
                store_place(memory, projected, value)?;
            } else {
                for projection_index in offset + 1..projections.len() {
                    projected = match projections[projection_index] {
                        Projection::Field(field) => field_place(projected, Vec::from_array([field])),
                        Projection::Index(index) => index_place(projected, index),
                    };
                }
                store_place(memory, projected, value)?;
            };
            Result::Ok(Value::Local(LocalValue::Slice(slice)))
        },
        _ => Result::Err("place projection does not match stored value"),
    }
}

pub fn store_place(memory: Memory, place: Place, value: Value) -> Result[unit, string] {
    if !cell_valid(memory, place.root.value) {
        return Result::Err("invalid cell " + place.root.value.to_string())
    } else {};
    match place.projections {
        Some(projections) => {
            let updated = store_projection(
                memory,
                cell_value(memory, place.root.value),
                projections,
                0,
                value,
            )?;
            set_cell_value(memory, place.root.value, updated);
            Result::Ok(())
        },
        None => {
            set_cell_value(memory, place.root.value, copy_value(value));
            Result::Ok(())
        },
    }
}
