package interpreter;

use gomlgo::bytecode;
use gomlgo::constant;
use gomlgo::types as go_types;
use std::bytes;
use std::num;

#[go_ffi("math", "Float32bits")]
extern fn float32_bits(value: float32) -> uint32;

#[go_ffi("math", "Float32frombits")]
extern fn float32_from_bits(value: uint32) -> float32;

#[go_ffi("math", "Float64bits")]
extern fn float64_bits(value: float64) -> uint64;

#[go_ffi("math", "Float64frombits")]
extern fn float64_from_bits(value: uint64) -> float64;

#[go_ffi("strconv", "FormatFloat")]
extern fn format_float(value: float64, format: uint8, precision: int, bits: int) -> string;

#[go_ffi("math", "Trunc")]
extern fn truncate_float(value: float64) -> float64;

fn maximum_uint64() -> uint64 {
    0.to_uint64() - 1.to_uint64()
}

fn widen_float32(value: float32) -> Result[float64, string] {
    num::parse_float64(value.to_string())
}

fn narrow_float64(value: float64) -> Result[float32, string] {
    num::parse_float32(value.to_string())
}

fn signed_float64(value: int64) -> Result[float64, string] {
    num::parse_float64(value.to_string())
}

fn unsigned_float64(value: uint64) -> Result[float64, string] {
    num::parse_float64(value.to_string())
}

fn float64_integer(value: float64) -> Result[int64, string] {
    let truncated = truncate_float(value);
    let text = format_float(truncated, b'f', 0, 64);
    Result::Ok(num::parse_int(text)?.to_int64())
}

pub fn basic_kind(world: go_types::World, type_id: go_types::TypeId) -> Option[go_types::BasicKind] {
    let underlying = go_types::underlying(world, type_id);
    match go_types::get_type(world, underlying) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic { basic, name: _, untyped: _ },
        }) => Option::Some(basic),
        _ => Option::None,
    }
}

fn integer_layout(kind: go_types::BasicKind) -> Option[(int, bool)] {
    match kind {
        go_types::BasicKind::Int | go_types::BasicKind::Int64 | go_types::BasicKind::UntypedInt => {
            Option::Some((64, true))
        },
        go_types::BasicKind::Int8 => Option::Some((8, true)),
        go_types::BasicKind::Int16 => Option::Some((16, true)),
        go_types::BasicKind::Int32 | go_types::BasicKind::UntypedRune => Option::Some((32, true)),
        go_types::BasicKind::Uint | go_types::BasicKind::Uint64 | go_types::BasicKind::Uintptr => {
            Option::Some((64, false))
        },
        go_types::BasicKind::Uint8 => Option::Some((8, false)),
        go_types::BasicKind::Uint16 => Option::Some((16, false)),
        go_types::BasicKind::Uint32 => Option::Some((32, false)),
        _ => Option::None,
    }
}

fn integer_mask(width: int) -> uint64 {
    if width >= 64 {
        maximum_uint64()
    } else {
        (1.to_uint64() << width) - 1.to_uint64()
    }
}

fn normalize_integer(bits: uint64, width: int) -> uint64 {
    bits & integer_mask(width)
}

fn signed_integer(bits: uint64, width: int) -> int64 {
    let bits = normalize_integer(bits, width);
    if width >= 64 {
        bits.to_int64()
    } else if bits & (1.to_uint64() << (width - 1)) != 0.to_uint64() {
        (bits | (maximum_uint64() ^ integer_mask(width))).to_int64()
    } else {
        bits.to_int64()
    }
}

fn integer_value(bits: uint64, width: int, signed: bool) -> Value {
    Value::Local(LocalValue::Integer { bits: normalize_integer(bits, width), width, signed })
}

fn integer_magnitude(value: constant::BigInt) -> uint64 {
    let mut result = 0.to_uint64();
    if !value.magnitude.limbs.is_empty() {
        result = value.magnitude.limbs[0].to_uint64();
    } else {};
    if value.magnitude.limbs.len() > 1 {
        result = result | (value.magnitude.limbs[1].to_uint64() << 32);
    } else {};
    if value.sign < 0 {
        0.to_uint64() - result
    } else {
        result
    }
}

fn float_value(value: constant::ConstValue, kind: go_types::BasicKind) -> Result[Value, string] {
    let sizes = go_types::gc_sizes("amd64").ok_or("amd64 sizes are unavailable")?;
    let rounded = constant::convert_constant(value, kind, sizes).ok_or(
        "floating-point constant is not representable",
    )?;
    let exact = constant::constant_string(rounded);
    if kind == go_types::BasicKind::Float32 {
        let parsed = num::parse_float32(exact)?;
        Result::Ok(
            Value::Local(LocalValue::Float { bits: float32_bits(parsed).to_uint64(), width: 32 }),
        )
    } else {
        let parsed = num::parse_float64(exact)?;
        Result::Ok(Value::Local(LocalValue::Float { bits: float64_bits(parsed), width: 64 }))
    }
}

fn complex_constant_value(value: constant::ConstValue, kind: go_types::BasicKind) -> Result[
    Value,
    string,
] {
    let sizes = go_types::gc_sizes("amd64").ok_or("amd64 sizes are unavailable")?;
    let rounded = constant::convert_constant(value, kind, sizes).ok_or(
        "complex constant is not representable",
    )?;
    let (real, imaginary) = constant::constant_to_numeric_complex(rounded).ok_or(
        "constant is not complex",
    )?;
    let component_kind = if kind == go_types::BasicKind::Complex64 {
        go_types::BasicKind::Float32
    } else {
        go_types::BasicKind::Float64
    };
    let real = float_value(constant::component_to_constant(real), component_kind)?;
    let imaginary = float_value(constant::component_to_constant(imaginary), component_kind)?;
    match (real, imaginary) {
        (
            Value::Local(LocalValue::Float { bits: real, width: _ }),
            Value::Local(LocalValue::Float { bits: imaginary, width: _ }),
        ) => Result::Ok(
            Value::Local(
                LocalValue::Complex {
                    real,
                    imaginary,
                    width: if kind == go_types::BasicKind::Complex64 {
                        64
                    } else {
                        128
                    },
                },
            ),
        ),
        _ => Result::Err("complex constant components are not floating-point"),
    }
}

pub fn constant_value(
    world: go_types::World,
    type_id: go_types::TypeId,
    constant_kind: string,
    exact: string,
) -> Result[Value, string] {
    let constant = constant::constant_from_exact(constant_kind, exact).ok_or(
        "invalid exact constant " + exact,
    )?;
    let kind = basic_kind(world, type_id).ok_or("constant type is not basic")?;
    if kind == go_types::BasicKind::Complex64 || kind == go_types::BasicKind::Complex128
        || kind == go_types::BasicKind::UntypedComplex {
        return complex_constant_value(
            constant,
            if kind == go_types::BasicKind::Complex64 {
                go_types::BasicKind::Complex64
            } else {
                go_types::BasicKind::Complex128
            },
        )
    } else {};
    match constant {
        constant::ConstValue::Bool(value) => Result::Ok(Value::Local(LocalValue::Bool(value))),
        constant::ConstValue::String(value) => Result::Ok(
            Value::Local(LocalValue::String(bytes::Bytes::from_string(value))),
        ),
        constant::ConstValue::Int(value) => match integer_layout(kind) {
            Some((width, signed)) => Result::Ok(
                integer_value(integer_magnitude(value), width, signed),
            ),
            None => float_value(constant::ConstValue::Int(value), kind),
        },
        value => float_value(value, kind),
    }
}

pub fn zero_value(world: go_types::World, type_id: go_types::TypeId) -> Result[Value, string] {
    let underlying = go_types::underlying(world, type_id);
    match go_types::get_type(world, underlying) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Basic { basic, name: _, untyped: _ },
        }) => match integer_layout(basic) {
            Some((width, signed)) => Result::Ok(integer_value(0.to_uint64(), width, signed)),
            None => match basic {
                go_types::BasicKind::Bool | go_types::BasicKind::UntypedBool => {
                    Result::Ok(Value::Local(LocalValue::Bool(false)))
                },
                go_types::BasicKind::Float32 => Result::Ok(
                    Value::Local(LocalValue::Float { bits: 0.to_uint64(), width: 32 }),
                ),
                go_types::BasicKind::Float64 | go_types::BasicKind::UntypedFloat => Result::Ok(
                    Value::Local(LocalValue::Float { bits: 0.to_uint64(), width: 64 }),
                ),
                go_types::BasicKind::Complex64 => Result::Ok(
                    Value::Local(
                        LocalValue::Complex {
                            real: 0.to_uint64(),
                            imaginary: 0.to_uint64(),
                            width: 64,
                        },
                    ),
                ),
                go_types::BasicKind::Complex128 | go_types::BasicKind::UntypedComplex => Result::Ok(
                    Value::Local(
                        LocalValue::Complex {
                            real: 0.to_uint64(),
                            imaginary: 0.to_uint64(),
                            width: 128,
                        },
                    ),
                ),
                go_types::BasicKind::String | go_types::BasicKind::UntypedString => Result::Ok(
                    Value::Local(LocalValue::String(bytes::Bytes::new())),
                ),
                go_types::BasicKind::UnsafePointer | go_types::BasicKind::UntypedNil => {
                    Result::Ok(Value::Local(LocalValue::Pointer(Option::None)))
                },
                _ => Result::Err("basic type has no runtime zero value"),
            },
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Array { length, element } }) => {
            if length < 0.to_int64() || length > 9223372036854775807.to_int64() {
                return Result::Err("array length is outside the host integer range")
            } else {};
            let elements: Vec[Value] = Vec::with_capacity(length.to_int());
            for _ in 0..length.to_int() {
                elements.push(zero_value(world, element)?)
            }
            Result::Ok(Value::Local(LocalValue::Aggregate { type_id, elements }))
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Struct { fields } }) => {
            let elements: Vec[Value] = Vec::with_capacity(fields.len());
            for field in fields {
                elements.push(zero_value(world, field.variable.type_id)?)
            }
            Result::Ok(Value::Local(LocalValue::Aggregate { type_id, elements }))
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Tuple { variables } }) => {
            let elements: Vec[Value] = Vec::with_capacity(variables.len());
            for variable in variables {
                elements.push(zero_value(world, variable.type_id)?)
            }
            Result::Ok(Value::Local(LocalValue::Aggregate { type_id, elements }))
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Pointer { element: _ } }) => {
            Result::Ok(Value::Local(LocalValue::Pointer(Option::None)))
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Slice { element } }) => {
            Result::Ok(
                Value::Local(
                    LocalValue::Slice(
                        SliceValue {
                            element_type: element,
                            backing: Option::None,
                            offset: 0,
                            length: 0,
                            capacity: 0,
                        },
                    ),
                ),
            )
        },
        Some(go_types::TypeData { id: _, kind: go_types::TypeKind::Map { key: _, value: _ } }) => {
            Result::Ok(Value::Local(LocalValue::Map(-1)))
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => {
            Result::Ok(Value::Local(LocalValue::Channel(-1)))
        },
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Signature {
                receiver: _,
                receiver_type_params: _,
                type_params: _,
                params: _,
                results: _,
                variadic: _,
            },
        }) => Result::Ok(Value::Local(LocalValue::Function(Option::None))),
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Interface {
                methods: _,
                embeddeds: _,
                comparable: _,
                implicit: _,
            },
        }) => Result::Ok(
            Value::Interface {
                static_type: type_id,
                dynamic_type: Option::None,
                value: Option::None,
            },
        ),
        _ => Result::Err("type has no runtime zero value"),
    }
}

pub fn unary_value(
    op: bytecode::UnaryOp,
    value: Value,
    result_type: go_types::TypeId,
    world: go_types::World,
) -> Result[Value, string] {
    match value {
        Value::Local(LocalValue::Bool(value)) => match op {
            bytecode::UnaryOp::Not => Result::Ok(Value::Local(LocalValue::Bool(!value))),
            _ => Result::Err("invalid boolean unary operation"),
        },
        Value::Local(LocalValue::Integer { bits, width, signed }) => match op {
            bytecode::UnaryOp::Positive => Result::Ok(integer_value(bits, width, signed)),
            bytecode::UnaryOp::Negative => {
                Result::Ok(integer_value(0.to_uint64() - bits, width, signed))
            },
            bytecode::UnaryOp::Complement => Result::Ok(
                integer_value(maximum_uint64() ^ bits, width, signed),
            ),
            _ => Result::Err("invalid integer unary operation"),
        },
        Value::Local(LocalValue::Float { bits, width }) => match op {
            bytecode::UnaryOp::Positive => Result::Ok(
                Value::Local(LocalValue::Float { bits, width }),
            ),
            bytecode::UnaryOp::Negative => Result::Ok(
                Value::Local(
                    LocalValue::Float {
                        bits: if width == 32 {
                            bits ^ (1.to_uint64() << 31)
                        } else {
                            bits ^ (1.to_uint64() << 63)
                        },
                        width,
                    },
                ),
            ),
            _ => Result::Err("invalid floating-point unary operation"),
        },
        Value::Local(LocalValue::Complex { real, imaginary, width }) => match op {
            bytecode::UnaryOp::Positive => Result::Ok(
                Value::Local(LocalValue::Complex { real, imaginary, width }),
            ),
            bytecode::UnaryOp::Negative => {
                let sign = if width == 64 {
                    31
                } else {
                    63
                };
                Result::Ok(
                    Value::Local(
                        LocalValue::Complex {
                            real: real ^ (1.to_uint64() << sign),
                            imaginary: imaginary ^ (1.to_uint64() << sign),
                            width,
                        },
                    ),
                )
            },
            _ => Result::Err("invalid complex unary operation"),
        },
        _ => {
            let _ = result_type;
            let _ = world;
            Result::Err("invalid unary operand")
        },
    }
}

fn comparison_result(op: bytecode::BinaryOp, comparison: int) -> Result[Value, string] {
    let result = match op {
        bytecode::BinaryOp::Equal => comparison == 0,
        bytecode::BinaryOp::NotEqual => comparison != 0,
        bytecode::BinaryOp::Less => comparison < 0,
        bytecode::BinaryOp::LessEqual => comparison <= 0,
        bytecode::BinaryOp::Greater => comparison > 0,
        bytecode::BinaryOp::GreaterEqual => comparison >= 0,
        _ => return Result::Err("operator is not a comparison"),
    };
    Result::Ok(Value::Local(LocalValue::Bool(result)))
}

fn shift_count(value: Value) -> Result[uint64, string] {
    let (bits, width, signed) = integer_bits(value)?;
    if signed && signed_integer(bits, width) < 0.to_int64() {
        Result::Err("negative shift count")
    } else {
        Result::Ok(bits)
    }
}

fn integer_binary(op: bytecode::BinaryOp, left: Value, right: Value) -> Result[Value, string] {
    let (left_bits, width, signed) = integer_bits(left)?;
    let (right_bits, right_width, right_signed) = integer_bits(right)?;
    match op {
        bytecode::BinaryOp::Add => Result::Ok(integer_value(left_bits + right_bits, width, signed)),
        bytecode::BinaryOp::Subtract => Result::Ok(
            integer_value(left_bits - right_bits, width, signed),
        ),
        bytecode::BinaryOp::Multiply => Result::Ok(
            integer_value(left_bits * right_bits, width, signed),
        ),
        bytecode::BinaryOp::Divide | bytecode::BinaryOp::Remainder => {
            if right_bits == 0.to_uint64() {
                return Result::Err("integer divide by zero")
            } else {};
            let bits = if signed {
                let left = signed_integer(left_bits, width);
                let right = signed_integer(right_bits, right_width);
                if op == bytecode::BinaryOp::Divide {
                    (left / right).to_uint64()
                } else {
                    (left % right).to_uint64()
                }
            } else if op == bytecode::BinaryOp::Divide {
                left_bits / right_bits
            } else {
                left_bits % right_bits
            };
            Result::Ok(integer_value(bits, width, signed))
        },
        bytecode::BinaryOp::BitAnd => Result::Ok(
            integer_value(left_bits & right_bits, width, signed),
        ),
        bytecode::BinaryOp::BitOr => Result::Ok(
            integer_value(left_bits | right_bits, width, signed),
        ),
        bytecode::BinaryOp::BitXor => Result::Ok(
            integer_value(left_bits ^ right_bits, width, signed),
        ),
        bytecode::BinaryOp::AndNot => Result::Ok(
            integer_value(left_bits & (maximum_uint64() ^ right_bits), width, signed),
        ),
        bytecode::BinaryOp::ShiftLeft => {
            let count = shift_count(
                Value::Local(
                    LocalValue::Integer {
                        bits: right_bits,
                        width: right_width,
                        signed: right_signed,
                    },
                ),
            )?;
            Result::Ok(
                integer_value(
                    if count >= 64.to_uint64() {
                        0.to_uint64()
                    } else {
                        left_bits << count.to_int()
                    },
                    width,
                    signed,
                ),
            )
        },
        bytecode::BinaryOp::ShiftRight => {
            let count = shift_count(
                Value::Local(
                    LocalValue::Integer {
                        bits: right_bits,
                        width: right_width,
                        signed: right_signed,
                    },
                ),
            )?;
            let result = if signed {
                if count >= 64.to_uint64() {
                    if signed_integer(left_bits, width) < 0.to_int64() {
                        maximum_uint64()
                    } else {
                        0.to_uint64()
                    }
                } else {
                    (signed_integer(left_bits, width) >> count.to_int()).to_uint64()
                }
            } else if count >= 64.to_uint64() {
                0.to_uint64()
            } else {
                left_bits >> count.to_int()
            };
            Result::Ok(integer_value(result, width, signed))
        },
        bytecode::BinaryOp::Equal | bytecode::BinaryOp::NotEqual | bytecode::BinaryOp::Less | bytecode::BinaryOp::LessEqual | bytecode::BinaryOp::Greater | bytecode::BinaryOp::GreaterEqual => {
            let comparison = if signed {
                let left = signed_integer(left_bits, width);
                let right = signed_integer(right_bits, right_width);
                if left < right {
                    -1
                } else if left > right {
                    1
                } else {
                    0
                }
            } else if left_bits < right_bits {
                -1
            } else if left_bits > right_bits {
                1
            } else {
                0
            };
            comparison_result(op, comparison)
        },
    }
}

fn float_number(value: Value) -> Result[(float64, int), string] {
    match value {
        Value::Local(LocalValue::Float { bits, width }) => if width == 32 {
            Result::Ok((widen_float32(float32_from_bits(bits.to_uint32()))?, width))
        } else {
            Result::Ok((float64_from_bits(bits), width))
        },
        _ => Result::Err("value is not floating-point"),
    }
}

fn float_result(value: float64, width: int) -> Value {
    if width == 32 {
        Value::Local(
            LocalValue::Float {
                bits: float32_bits(narrow_float64(value).unwrap_or(0.0)).to_uint64(),
                width,
            },
        )
    } else {
        Value::Local(LocalValue::Float { bits: float64_bits(value), width })
    }
}

fn float_binary(op: bytecode::BinaryOp, left: Value, right: Value) -> Result[Value, string] {
    let (left, width) = float_number(left)?;
    let (right, _) = float_number(right)?;
    match op {
        bytecode::BinaryOp::Add => Result::Ok(float_result(left + right, width)),
        bytecode::BinaryOp::Subtract => Result::Ok(float_result(left - right, width)),
        bytecode::BinaryOp::Multiply => Result::Ok(float_result(left * right, width)),
        bytecode::BinaryOp::Divide => Result::Ok(float_result(left / right, width)),
        bytecode::BinaryOp::Equal => Result::Ok(Value::Local(LocalValue::Bool(left == right))),
        bytecode::BinaryOp::NotEqual => Result::Ok(Value::Local(LocalValue::Bool(left != right))),
        bytecode::BinaryOp::Less => Result::Ok(Value::Local(LocalValue::Bool(left < right))),
        bytecode::BinaryOp::LessEqual => Result::Ok(Value::Local(LocalValue::Bool(left <= right))),
        bytecode::BinaryOp::Greater => Result::Ok(Value::Local(LocalValue::Bool(left > right))),
        bytecode::BinaryOp::GreaterEqual => Result::Ok(
            Value::Local(LocalValue::Bool(left >= right)),
        ),
        _ => Result::Err("invalid floating-point binary operation"),
    }
}

fn complex_number(value: Value) -> Result[((float64, float64), int), string] {
    match value {
        Value::Local(LocalValue::Complex { real, imaginary, width }) => if width == 64 {
            Result::Ok(
                (
                    (
                        widen_float32(float32_from_bits(real.to_uint32()))?,
                        widen_float32(float32_from_bits(imaginary.to_uint32()))?,
                    ),
                    width,
                ),
            )
        } else {
            Result::Ok(((float64_from_bits(real), float64_from_bits(imaginary)), width))
        },
        _ => Result::Err("value is not complex"),
    }
}

fn complex_result(real: float64, imaginary: float64, width: int) -> Value {
    if width == 64 {
        Value::Local(
            LocalValue::Complex {
                real: float32_bits(narrow_float64(real).unwrap_or(0.0)).to_uint64(),
                imaginary: float32_bits(narrow_float64(imaginary).unwrap_or(0.0)).to_uint64(),
                width,
            },
        )
    } else {
        Value::Local(
            LocalValue::Complex {
                real: float64_bits(real),
                imaginary: float64_bits(imaginary),
                width,
            },
        )
    }
}

fn complex_binary(op: bytecode::BinaryOp, left: Value, right: Value) -> Result[Value, string] {
    let (left, width) = complex_number(left)?;
    let (right, _) = complex_number(right)?;
    match op {
        bytecode::BinaryOp::Add => Result::Ok(
            complex_result(left.0 + right.0, left.1 + right.1, width),
        ),
        bytecode::BinaryOp::Subtract => Result::Ok(
            complex_result(left.0 - right.0, left.1 - right.1, width),
        ),
        bytecode::BinaryOp::Multiply => Result::Ok(
            complex_result(
                left.0 * right.0 - left.1 * right.1,
                left.0 * right.1 + left.1 * right.0,
                width,
            ),
        ),
        bytecode::BinaryOp::Divide => {
            let denominator = right.0 * right.0 + right.1 * right.1;
            Result::Ok(
                complex_result(
                    (left.0 * right.0 + left.1 * right.1) / denominator,
                    (left.1 * right.0 - left.0 * right.1) / denominator,
                    width,
                ),
            )
        },
        bytecode::BinaryOp::Equal => Result::Ok(
            Value::Local(LocalValue::Bool(left.0 == right.0 && left.1 == right.1)),
        ),
        bytecode::BinaryOp::NotEqual => Result::Ok(
            Value::Local(LocalValue::Bool(left.0 != right.0 || left.1 != right.1)),
        ),
        _ => Result::Err("invalid complex binary operation"),
    }
}

fn bytes_compare(left: bytes::Bytes, right: bytes::Bytes) -> int {
    let count = if left.len() < right.len() {
        left.len()
    } else {
        right.len()
    };
    for index in 0..count {
        if left.get(index) < right.get(index) {
            return -1
        } else if left.get(index) > right.get(index) {
            return 1
        } else {}
    }
    if left.len() < right.len() {
        -1
    } else if left.len() > right.len() {
        1
    } else {
        0
    }
}

pub fn binary_value(
    op: bytecode::BinaryOp,
    left: Value,
    right: Value,
    result_type: go_types::TypeId,
    world: go_types::World,
) -> Result[Value, string] {
    match (left, right) {
        (Value::Local(LocalValue::Integer { bits, width, signed }), right) => integer_binary(
            op,
            Value::Local(LocalValue::Integer { bits, width, signed }),
            right,
        ),
        (Value::Local(LocalValue::Float { bits, width }), right) => float_binary(
            op,
            Value::Local(LocalValue::Float { bits, width }),
            right,
        ),
        (Value::Local(LocalValue::Complex { real, imaginary, width }), right) => complex_binary(
            op,
            Value::Local(LocalValue::Complex { real, imaginary, width }),
            right,
        ),
        (Value::Local(LocalValue::String(left)), Value::Local(LocalValue::String(right))) => {
            if op == bytecode::BinaryOp::Add {
                let value = bytes::Bytes::with_capacity(left.len() + right.len());
                for byte in left.to_vec() {
                    value.push(byte)
                }
                for byte in right.to_vec() {
                    value.push(byte)
                }
                Result::Ok(Value::Local(LocalValue::String(value)))
            } else {
                comparison_result(op, bytes_compare(left, right))
            }
        },
        (Value::Local(LocalValue::Bool(left)), Value::Local(LocalValue::Bool(right))) => {
            comparison_result(
                op,
                if left == right {
                    0
                } else if !left {
                    -1
                } else {
                    1
                },
            )
        },
        (left, right) => if op == bytecode::BinaryOp::Equal || op == bytecode::BinaryOp::NotEqual {
            let equal = values_equal(world, left, right)?;
            Result::Ok(
                Value::Local(
                    LocalValue::Bool(
                        if op == bytecode::BinaryOp::Equal {
                            equal
                        } else {
                            !equal
                        },
                    ),
                ),
            )
        } else {
            let _ = result_type;
            let _ = world;
            Result::Err("invalid binary operands")
        },
    }
}

pub fn convert_value(
    world: go_types::World,
    value: Value,
    source: go_types::TypeId,
    target: go_types::TypeId,
) -> Result[Value, string] {
    if go_types::is_interface(world, target) {
        if basic_kind(world, source) == Option::Some(go_types::BasicKind::UntypedNil) {
            return Result::Ok(
                Value::Interface {
                    static_type: target,
                    dynamic_type: Option::None,
                    value: Option::None,
                },
            )
        } else {};
        return match value {
            Value::Interface { static_type: _, dynamic_type, value } => Result::Ok(
                Value::Interface { static_type: target, dynamic_type, value },
            ),
            _ => Result::Ok(
                Value::Interface {
                    static_type: target,
                    dynamic_type: Option::Some(source),
                    value: Option::Some(Ref::new(copy_value(value))),
                },
            ),
        }
    } else {};
    match go_types::get_type(world, go_types::underlying(world, target)) {
        Some(go_types::TypeData {
            id: _,
            kind: go_types::TypeKind::Chan { direction: _, element: _ },
        }) => return match value {
            Value::Local(LocalValue::Channel(id)) => Result::Ok(
                Value::Local(LocalValue::Channel(id)),
            ),
            Value::Local(LocalValue::Pointer(None)) => Result::Ok(
                Value::Local(LocalValue::Channel(-1)),
            ),
            _ => Result::Err("value cannot be converted to channel"),
        },
        _ => {},
    };
    let kind = basic_kind(world, target).ok_or("target type is not a supported basic type")?;
    match integer_layout(kind) {
        Some((width, signed)) => match value {
            Value::Local(LocalValue::Integer { bits, width: source_width, signed: source_signed }) => {
                Result::Ok(
                    integer_value(
                        if source_signed {
                            signed_integer(bits, source_width).to_uint64()
                        } else {
                            bits
                        },
                        width,
                        signed,
                    ),
                )
            },
            Value::Local(LocalValue::Float { bits, width: source_width }) => {
                let value = if source_width == 32 {
                    widen_float32(float32_from_bits(bits.to_uint32()))?
                } else {
                    float64_from_bits(bits)
                };
                Result::Ok(integer_value(float64_integer(value)?.to_uint64(), width, signed))
            },
            _ => Result::Err("value cannot be converted to integer"),
        },
        None => match kind {
            go_types::BasicKind::Float32 | go_types::BasicKind::Float64 => match value {
                Value::Local(LocalValue::Integer { bits, width, signed }) => {
                    let number = if signed {
                        signed_float64(signed_integer(bits, width))?
                    } else {
                        unsigned_float64(bits)?
                    };
                    Result::Ok(
                        float_result(
                            number,
                            if kind == go_types::BasicKind::Float32 {
                                32
                            } else {
                                64
                            },
                        ),
                    )
                },
                Value::Local(LocalValue::Float { bits, width }) => Result::Ok(
                    float_result(
                        if width == 32 {
                            widen_float32(float32_from_bits(bits.to_uint32()))?
                        } else {
                            float64_from_bits(bits)
                        },
                        if kind == go_types::BasicKind::Float32 {
                            32
                        } else {
                            64
                        },
                    ),
                ),
                _ => Result::Err("value cannot be converted to floating-point"),
            },
            go_types::BasicKind::String => match value {
                Value::Local(LocalValue::String(value)) => {
                    Result::Ok(Value::Local(LocalValue::String(value)))
                },
                _ => Result::Err("non-string conversion to string is not supported yet"),
            },
            go_types::BasicKind::Bool => match value {
                Value::Local(LocalValue::Bool(value)) => {
                    Result::Ok(Value::Local(LocalValue::Bool(value)))
                },
                _ => Result::Err("value cannot be converted to bool"),
            },
            _ => Result::Err("target conversion is not supported"),
        },
    }
}

pub fn output_bytes(value: Value) -> Result[bytes::Bytes, string] {
    match value {
        Value::Local(LocalValue::Unit) => Result::Ok(bytes::Bytes::from_string("()")),
        Value::Local(LocalValue::Bool(value)) => {
            Result::Ok(bytes::Bytes::from_string(value.to_string()))
        },
        Value::Local(LocalValue::Integer { bits, width, signed }) => Result::Ok(
            bytes::Bytes::from_string(
                if signed {
                    signed_integer(bits, width).to_string()
                } else {
                    bits.to_string()
                },
            ),
        ),
        Value::Local(LocalValue::Float { bits, width }) => Result::Ok(
            bytes::Bytes::from_string(
                if width == 32 {
                    float32_from_bits(bits.to_uint32()).to_string()
                } else {
                    format_float(float64_from_bits(bits), b'g', -1, 64)
                },
            ),
        ),
        Value::Local(LocalValue::Complex { real, imaginary, width }) => {
            let component_width = if width == 64 {
                32
            } else {
                64
            };
            let real = if component_width == 32 {
                float32_from_bits(real.to_uint32()).to_string()
            } else {
                format_float(float64_from_bits(real), b'g', -1, 64)
            };
            let imaginary = if component_width == 32 {
                float32_from_bits(imaginary.to_uint32()).to_string()
            } else {
                format_float(float64_from_bits(imaginary), b'g', -1, 64)
            };
            let negative = imaginary.starts_with("-");
            Result::Ok(
                bytes::Bytes::from_string(
                    "(" + real
                        + if negative {
                            ""
                        } else {
                            "+"
                        }
                        + imaginary
                        + "i)",
                ),
            )
        },
        Value::Local(LocalValue::String(value)) => Result::Ok(value),
        Value::Local(LocalValue::Pointer(None)) => Result::Ok(bytes::Bytes::from_string("<nil>")),
        Value::Local(LocalValue::Slice(value)) => Result::Ok(
            bytes::Bytes::from_string(
                "[slice len=" + value.length.to_string() + " cap=" + value.capacity.to_string()
                    + "]",
            ),
        ),
        Value::Host { type_id: _, value } => {
            Result::Ok(bytes::Bytes::from_string(native_value_text(value)))
        },
        Value::Interface { static_type: _, dynamic_type: None, value: _ } => {
            Result::Ok(bytes::Bytes::from_string("<nil>"))
        },
        Value::Interface { static_type: _, dynamic_type: Some(_), value: Some(value) } => {
            output_bytes(value.get())
        },
        _ => Result::Ok(bytes::Bytes::from_string("<value>")),
    }
}
