#[test]
fn selects_ready_cases_from_the_configured_seed() -> unit {
    let first_config = default_config();
    first_config.select_seed = 1.to_uint64();
    let first = run(load_bytecode("select_seed"), first_config);
    let repeated = run(load_bytecode("select_seed"), first_config);
    testing::assert_eq(first.exit_code, 0);
    testing::assert_eq(first.stderr.to_string().unwrap_or(""), "first 1\nblocked-second\n");
    testing::assert_eq(
        repeated.stderr.to_string().unwrap_or(""),
        first.stderr.to_string().unwrap_or(""),
    );
    let second_config = default_config();
    second_config.select_seed = 2.to_uint64();
    let second = run(load_bytecode("select_seed"), second_config);
    testing::assert_eq(second.exit_code, 0);
    testing::assert_eq(second.stderr.to_string().unwrap_or(""), "second 2\nblocked-first\n")
}

