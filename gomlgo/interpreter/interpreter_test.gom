#[test]
fn stops_execution_when_instruction_fuel_is_exhausted() -> unit {
    let config = default_config();
    config.max_steps = 3.to_int64();
    let result = run(load_bytecode("control"), config);
    testing::assert_eq(result.exit_code, 1);
    testing::assert(result.error.is_some());
    testing::assert(result.stderr.to_string().unwrap_or("").contains("instruction limit"))
}

#[test]
fn copies_aggregate_values_and_preserves_pointer_identity() -> unit {
    let world = go_types::new_world();
    let int_type = testing::expect_some(go_types::basic_type(world, "int"), "missing int type");
    let array_type = go_types::add_type(
        world,
        go_types::TypeKind::Array { length: 2.to_int64(), element: int_type },
    );
    let memory = new_memory();
    let initial = testing::expect_ok(zero_value(world, array_type), "zero array failed");
    let first = allocate_cell(memory, initial);
    let second = allocate_cell(
        memory,
        testing::expect_ok(load_place(memory, root_place(first)), "array load failed"),
    );
    let one = testing::expect_ok(
        constant_value(world, int_type, "Int", "1"),
        "integer constant failed",
    );
    testing::assert_ok(store_place(memory, index_place(root_place(first), 0), one));
    let original = testing::expect_ok(
        load_place(memory, index_place(root_place(first), 0)),
        "original load failed",
    );
    let copied = testing::expect_ok(
        load_place(memory, index_place(root_place(second), 0)),
        "copied load failed",
    );
    testing::assert(!testing::expect_ok(values_equal(world, original, copied), "comparison failed"));
    let pointer = Value::Local(LocalValue::Pointer(Option::Some(root_place(first))));
    testing::assert(
        testing::expect_ok(
            values_equal(world, pointer, copy_value(pointer)),
            "pointer comparison failed",
        ),
    )
}

#[test]
fn preserves_precise_float64_constant_bits() -> unit {
    let world = go_types::new_world();
    let float_type = testing::expect_some(
        go_types::basic_type(world, "float64"),
        "missing float64 type",
    );
    let value = testing::expect_ok(
        constant_value(world, float_type, "Float", "183186547087/10"),
        "float constant conversion failed",
    );
    match value {
        Value::Local(LocalValue::Float { bits, width }) => {
            testing::assert_eq(width, 64);
            testing::assert_eq(bits, float64_bits(18318654708.7))
        },
        _ => testing::fail("float constant did not produce a floating-point value"),
    }
}

#[test]
fn passes_host_backed_interfaces_directly_to_native_calls() -> unit {
    let program = load_bytecode("control");
    let world = program.world;
    let package_id = go_types::add_package(world, "example/host", "host", world.universe, false);
    let object = go_types::add_object(
        world,
        go_types::ObjectKind::TypeName,
        "HostInterface",
        Option::Some(package_id),
        Option::None,
        Option::None,
        0,
        world.invalid,
    );
    let underlying = go_types::add_type(
        world,
        go_types::TypeKind::Interface {
            methods: Vec::from_array([]),
            embeddeds: Vec::from_array([]),
            comparable: false,
            implicit: false,
        },
    );
    let interface_type = go_types::add_type(
        world,
        go_types::TypeKind::Named {
            object,
            underlying,
            type_params: Vec::from_array([]),
            type_args: Vec::from_array([]),
            methods: Vec::from_array([]),
        },
    );
    testing::assert(go_types::set_object_type(world, object, interface_type));
    let string_type = testing::expect_some(
        go_types::basic_type(world, "string"),
        "missing string type",
    );
    let host = new_native_string("host");
    let state = testing::expect_ok(
        initialize_state(program, default_config()),
        "VM initialization failed",
    );
    let converted = testing::expect_ok(
        native_argument(
            state,
            Value::Interface {
                static_type: interface_type,
                dynamic_type: Option::Some(string_type),
                value: Option::Some(Ref::new(Value::Host { type_id: string_type, value: host })),
            },
            interface_type,
            "interface",
        ),
        "host interface conversion failed",
    );
    testing::assert_eq(native_value_string(converted), "host");
    testing::assert(state.native_callbacks.is_empty())
}
