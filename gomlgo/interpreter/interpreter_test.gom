fn assert_runtime_error(name: string, message: string) -> unit {
    let result = run(load_bytecode(name), default_config());
    testing::assert_eq(result.exit_code, 1);
    let error = testing::expect_some(result.error, "runtime error is missing for " + name);
    let _ = testing::expect_some(error.location, "runtime error location is missing for " + name);
    let stderr = result.stderr.to_string().unwrap_or("<non-UTF-8>");
    if !stderr.contains(message) {
        testing::fail("runtime error for " + name + " was: " + stderr)
    } else {}
}

#[test]
fn reports_sequential_runtime_errors() -> unit {
    assert_runtime_error("runtime_divide_zero", "integer divide by zero");
    assert_runtime_error("runtime_index", "index out of range");
    assert_runtime_error("runtime_nil_pointer", "nil pointer dereference");
    assert_runtime_error("runtime_make_slice", "makeslice: len out of range")
}

fn assert_matches_go(name: string) -> unit {
    let config = execution::default_config();
    let native = testing::expect_ok(
        process::Command::new(config.go_binary).arg("run").arg("main.go").current_dir(fixture(name)).env(
            "GOTOOLCHAIN",
            "local",
        ).output(),
        "Go execution failed",
    );
    let interpreted = run(load_bytecode(name), default_config());
    if interpreted.exit_code
        != process::ExitStatus::code(process::Output::status(native)).unwrap_or(-1) {
        testing::fail(
            "exit mismatch for " + name + ": "
                + interpreted.stderr.to_string().unwrap_or("<non-UTF-8>"),
        )
    } else {};
    testing::assert_eq(
        interpreted.exit_code,
        process::ExitStatus::code(process::Output::status(native)).unwrap_or(-1),
    );
    testing::assert_eq(
        interpreted.stdout.to_string().unwrap_or("<non-UTF-8>"),
        process::Output::stdout(native).to_string().unwrap_or("<non-UTF-8>"),
    );
    testing::assert_eq(
        interpreted.stderr.to_string().unwrap_or("<non-UTF-8>"),
        process::Output::stderr(native).to_string().unwrap_or("<non-UTF-8>"),
    )
}

#[test]
fn matches_go126_for_m1_single_file_corpus() -> unit {
    assert_matches_go("control");
    assert_matches_go("control_flow");
    assert_matches_go("aggregate_slice");
    assert_matches_go("string_byte_conversion");
    assert_matches_go("basic_values");
    assert_matches_go("range_values");
    assert_matches_go("globals_init");
    assert_matches_go("maps");
    assert_matches_go("methods_interfaces");
    assert_matches_go("closures");
    assert_matches_go("type_switch");
    assert_matches_go("defer_panic_recover");
    assert_matches_go("runtime_fault_recover")
}

