package goroot_compare;

use gomlgo::checker;
use gomlgo::loader;
use gomlgo::typecheck_compare;
use gomlgo::typecheck_diff;
use gomlgo::types as go_types;
use std::collections;
use std::fs;
use std::path;

pub enum CompareMode {
    Acceptance,
    Info,
}

pub struct Summary {
    pub packages: int,
    pub accepted: int,
    pub rejected: int,
    pub info_compared: int,
}

fn excluded_directory(name: string) -> bool {
    name == "testdata" || name == "vendor" || name.starts_with(".") || name.starts_with("_")
}

fn directory_import_path(root: string, directory: string) -> Option[string] {
    if directory == root {
        Option::None
    } else {
        let prefix = root + path::separator();
        if directory.starts_with(prefix) {
            Option::Some(directory.byte_slice(prefix.byte_len(), directory.byte_len()))
        } else {
            Option::None
        }
    }
}

fn collect_packages(
    config: loader::LoadConfig,
    root: string,
    directory: string,
    include_cmd: bool,
    packages: Vec[string],
) -> Result[unit, string] {
    let name = path::file_name(directory).unwrap_or("");
    if excluded_directory(name) || (!include_cmd && directory == path::join(root, "cmd")) {
        return Result::Ok(())
    } else {};
    match directory_import_path(root, directory) {
        Some(import_path) => match loader::selected_sources(config, import_path) {
            Ok(_) => packages.push(import_path),
            Err(_) => {},
        },
        None => {},
    };
    for child in fs::read_dir(directory)? {
        let entry = path::join(directory, child);
        if fs::is_dir(entry) {
            collect_packages(config, root, entry, include_cmd, packages)?
        } else {}
    }
    Result::Ok(())
}

fn oracle_sources(values: Vec[checker::SourceFile]) -> Result[
    Vec[typecheck_diff::SourceFile],
    string,
] {
    let result: Vec[typecheck_diff::SourceFile] = Vec::[];
    for value in values {
        result.push(
            typecheck_diff::SourceFile { name: value.name, source: value.source.to_string()? },
        )
    }
    Result::Ok(result)
}

fn first_oracle_diagnostic(value: typecheck_diff::CheckResponse) -> string {
    if value.diagnostics.is_empty() {
        "none"
    } else {
        value.diagnostics[0].file + ":" + value.diagnostics[0].start.to_string() + ": "
            + value.diagnostics[0].message
    }
}

fn compare_package(
    config: loader::LoadConfig,
    session: loader::LoadSession,
    import_path: string,
    mode: CompareMode,
) -> Result[(bool, bool), string] {
    let sources = loader::selected_sources(config, import_path)?;
    let package_path = if config.external_tests {
        import_path + "_test"
    } else {
        import_path
    };
    let request = match mode {
        CompareMode::Acceptance => {
            typecheck_diff::acceptance_request(package_path, oracle_sources(sources)?)
        },
        CompareMode::Info => typecheck_diff::request(package_path, oracle_sources(sources)?),
    };
    request.go_version = config.checker_config.go_version;
    request.goos = config.goos;
    request.goarch = config.goarch;
    request.config.fake_import_c = config.checker_config.fake_import_c;
    let expected = typecheck_diff::run_check(request)?;
    if import_path == "unsafe" {
        if expected.ok {
            return Result::Ok((true, false))
        } else {
            return Result::Err(
                import_path + ": oracle rejected built-in package "
                    + first_oracle_diagnostic(expected),
            )
        }
    } else {};
    match mode {
        CompareMode::Acceptance => {
            let actual = if config.include_tests {
                let check_config = config;
                check_config.include_tests = false;
                check_config.external_tests = false;
                match loader::check_sources(check_config, package_path, sources) {
                    Ok(_) => Result::Ok(()),
                    Err(message) => Result::Err(message),
                }
            } else {
                loader::check_import_path_acceptance_in_session(session, import_path)
            };
            let actual_ok = actual.is_ok();
            if actual_ok != expected.ok {
                let actual_detail = match actual {
                    Ok(_) => "",
                    Err(message) => " " + message,
                };
                return Result::Err(
                    import_path + ": package acceptance mismatch\nactual=" + actual_ok.to_string()
                        + actual_detail
                        + "\nexpected="
                        + expected.ok.to_string()
                        + " "
                        + first_oracle_diagnostic(expected),
                )
            } else {
                return Result::Ok((actual_ok, false))
            }
        },
        CompareMode::Info => {},
    };
    let actual = if config.include_tests {
        let check_config = config;
        check_config.include_tests = false;
        check_config.external_tests = false;
        loader::check_sources(check_config, package_path, sources)
    } else {
        loader::check_import_path_info_in_session(session, import_path)
    };
    let actual_ok = actual.is_ok();
    if actual_ok != expected.ok {
        let actual_detail = match actual {
            Ok(_) => "",
            Err(message) => " " + message,
        };
        return Result::Err(
            import_path + ": package acceptance mismatch\nactual=" + actual_ok.to_string()
                + actual_detail
                + "\nexpected="
                + expected.ok.to_string()
                + " "
                + first_oracle_diagnostic(expected),
        )
    } else if actual_ok {
        match (mode, actual) {
            (CompareMode::Info, Ok(result)) => {
                typecheck_compare::compare_info(import_path, result, expected)?;
                Result::Ok((true, true))
            },
            (_, Ok(_)) => Result::Ok((true, false)),
            (_, Err(message)) => Result::Err(message),
        }
    } else {
        Result::Ok((false, false))
    }
}

pub fn compare(
    root: string,
    scope: string,
    limit: int,
    start: string,
    mode: CompareMode,
    goos: string,
    goarch: string,
    cgo: bool,
    test_mode: string,
) -> Result[Summary, string] {
    let config = loader::default_config();
    config.source_roots = Vec::[root];
    config.goos = goos;
    config.goarch = goarch;
    config.cgo = cgo;
    config.checker_config.fake_import_c = cgo;
    config.checker_config.sizes = go_types::gc_sizes(goarch).ok_or("unsupported GOARCH " + goarch)?;
    config.include_tests = test_mode == "internal" || test_mode == "external";
    config.external_tests = test_mode == "external";
    let packages: Vec[string] = Vec::[];
    collect_packages(
        config,
        root,
        if scope == "cmd" {
            path::join(root, "cmd")
        } else {
            root
        },
        scope != "std",
        packages,
    )?;
    collections::sort(packages);
    let mut session = match mode {
        CompareMode::Acceptance => loader::new_load_session(config),
        CompareMode::Info => loader::new_info_load_session(config),
    };
    let mut checked = 0;
    let mut accepted = 0;
    let mut info_compared = 0;
    for import_path in packages {
        if import_path >= start && (limit < 0 || checked < limit) {
            if checked > 0 && checked % 16 == 0 {
                match mode {
                    CompareMode::Acceptance => {
                        session = loader::new_load_session(config);
                    },
                    CompareMode::Info => {
                        session = loader::new_info_load_session(config);
                    },
                }
            } else {};
            let result = compare_package(config, session, import_path, mode)?;
            checked += 1;
            if result.0 {
                accepted += 1;
            } else {};
            if result.1 {
                info_compared += 1;
            } else {}
        } else {}
    }
    Result::Ok(Summary { packages: checked, accepted, rejected: checked - accepted, info_compared })
}
