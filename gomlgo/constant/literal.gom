package constant;

use std::text;

const literal_length_limit: int = 10000;

const literal_exponent_limit: int = 2147483647;

fn without_underscores(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '_' {} else {
            builder.write_char(character)
        }
    }
    builder.finish()
}

fn literal_digit(value: byte, radix: int) -> Option[int] {
    let digit = if value >= b'0' && value <= b'9' {
        (value - b'0') as int
    } else if value >= b'a' && value <= b'f' {
        (value - b'a' + 10) as int
    } else if value >= b'A' && value <= b'F' {
        (value - b'A' + 10) as int
    } else {
        -1
    };
    if digit >= 0 && digit < radix {
        Option::Some(digit)
    } else {
        Option::None
    }
}

fn parse_exponent(value: string) -> Result[int, string] {
    if value == "" {
        return Result::Err("missing exponent")
    } else {};
    let mut sign = 1;
    let mut index = 0;
    if value.byte_get(0) == b'+' {
        index = 1;
    } else if value.byte_get(0) == b'-' {
        sign = -1;
        index = 1;
    } else {};
    if index >= value.byte_len() {
        return Result::Err("missing exponent")
    } else {};
    let mut result = 0;
    while index < value.byte_len() {
        let digit = match literal_digit(value.byte_get(index), 10) {
            Some(value) => value,
            None => return Result::Err("invalid exponent"),
        };
        if result > literal_exponent_limit / 10 || result * 10 + digit > literal_exponent_limit {
            return Result::Err("exponent is too large")
        } else {};
        result = result * 10 + digit;
        index += 1;
    }
    Result::Ok(sign * result)
}

fn exponent_marker(value: string, hexadecimal: bool) -> Option[int] {
    let mut index = 0;
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        if (hexadecimal && (byte == b'p' || byte == b'P'))
            || (!hexadecimal && (byte == b'e' || byte == b'E')) {
            return Option::Some(index)
        } else {};
        index += 1;
    }
    Option::None
}

fn remove_point(value: string) -> Result[(string, int), string] {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    let mut fraction = 0;
    let mut seen_point = false;
    let mut digits = 0;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'.' {
            if seen_point {
                return Result::Err("multiple decimal points")
            } else {};
            seen_point = true;
        } else {
            builder.values.push(byte);
            digits += 1;
            if seen_point {
                fraction += 1;
            } else {}
        }
    }
    if digits == 0 {
        Result::Err("missing mantissa")
    } else {
        Result::Ok((builder.finish(), fraction))
    }
}

fn scaled_rational(magnitude: Natural, radix: uint32, exponent: int) -> Result[BigRat, string] {
    if exponent >= 0 {
        rational_new(
            integer_from_parts(1, natural_mul(magnitude, natural_pow_small(radix, exponent))),
            natural_one(),
        )
    } else {
        rational_new(integer_from_parts(1, magnitude), natural_pow_small(radix, -exponent))
    }
}

pub fn parse_integer_literal(value: string) -> Result[ConstValue, string] {
    if value.byte_len() > literal_length_limit {
        Result::Err("excessively long constant")
    } else {
        Result::Ok(ConstValue::Int(integer_parse(value)?))
    }
}

pub fn parse_float_literal(value: string) -> Result[ConstValue, string] {
    if value.byte_len() > literal_length_limit {
        return Result::Err("excessively long constant")
    } else {};
    let normalized = without_underscores(value);
    let hexadecimal = normalized.byte_len() >= 2 && normalized.byte_get(0) == b'0'
        && (normalized.byte_get(1) == b'x' || normalized.byte_get(1) == b'X');
    let marker = exponent_marker(normalized, hexadecimal);
    let mantissa_end = match marker {
        Some(index) => index,
        None => normalized.byte_len(),
    };
    let exponent = match marker {
        Some(index) => parse_exponent(normalized.byte_slice(index + 1, normalized.byte_len()))?,
        None => if hexadecimal {
            return Result::Err("hexadecimal mantissa requires a binary exponent")
        } else {
            0
        },
    };
    let mantissa_start = if hexadecimal {
        2
    } else {
        0
    };
    let parts = remove_point(normalized.byte_slice(mantissa_start, mantissa_end))?;
    let magnitude = natural_parse_digits(
        parts.0,
        if hexadecimal {
            16 as uint32
        } else {
            10 as uint32
        },
    )?;
    if magnitude.limbs.is_empty() {
        return Result::Ok(ConstValue::Rat(rational_zero()))
    } else {};
    let scaled_exponent = if hexadecimal {
        exponent - 4 * parts.1
    } else {
        exponent - parts.1
    };
    let approximate = if hexadecimal {
        binary_float_from_natural(
            magnitude,
            scaled_exponent,
            false,
            binary_float_default_precision(),
        )
    } else {
        binary_float_from_decimal(magnitude, scaled_exponent, binary_float_default_precision())
    };
    let approximate = match approximate {
        Some(value) => value,
        None => return Result::Err("exponent is too large"),
    };
    let binary_exponent = binary_float_mantissa_exponent(approximate);
    if binary_exponent > -4096 && binary_exponent < 4096 {
        if hexadecimal {
            Result::Ok(ConstValue::Rat(scaled_rational(magnitude, 2 as uint32, scaled_exponent)?))
        } else {
            Result::Ok(ConstValue::Rat(scaled_rational(magnitude, 10 as uint32, scaled_exponent)?))
        }
    } else {
        Result::Ok(ConstValue::LargeFloat(approximate))
    }
}

pub fn parse_imaginary_literal(value: string) -> Result[ConstValue, string] {
    if value.byte_len() < 2 || value.byte_get(value.byte_len() - 1) != b'i' {
        return Result::Err("invalid imaginary literal")
    } else {};
    let number = value.byte_slice(0, value.byte_len() - 1);
    let parsed = if number.contains(".") || number.contains("e") || number.contains("E")
        || number.contains("p")
        || number.contains("P") {
        parse_float_literal(number)?
    } else {
        if number.starts_with("0b") || number.starts_with("0B") || number.starts_with("0o")
            || number.starts_with("0O")
            || number.starts_with("0x")
            || number.starts_with("0X") {
            parse_integer_literal(number)?
        } else {
            parse_float_literal(number)?
        }
    };
    match component_from_constant(parsed) {
        Some(imaginary) => Result::Ok(
            ConstValue::Complex { real: NumericComponent::Integer(integer_zero()), imaginary },
        ),
        None => Result::Err("invalid imaginary literal"),
    }
}

fn append_codepoint(builder: text::StringBuilder, value: uint32) -> Result[unit, string] {
    if value > 1114111 || (value >= 55296 && value < 57344) {
        Result::Err("escape sequence is invalid Unicode code point")
    } else {
        match char_from_uint32(value) {
            Some(value) => {
                builder.write_char(value);
                Result::Ok(())
            },
            None => Result::Err("escape sequence is invalid Unicode code point"),
        }
    }
}

fn parse_escape(value: string, index: int, quote: byte, builder: text::StringBuilder) -> Result[
    int,
    string,
] {
    if index >= value.byte_len() {
        return Result::Err("escape sequence not terminated")
    } else {};
    let escape = value.byte_get(index);
    if escape == b'a' {
        builder.values.push(7);
        Result::Ok(index + 1)
    } else if escape == b'b' {
        builder.values.push(8);
        Result::Ok(index + 1)
    } else if escape == b'f' {
        builder.values.push(12);
        Result::Ok(index + 1)
    } else if escape == b'n' {
        builder.values.push(b'\n');
        Result::Ok(index + 1)
    } else if escape == b'r' {
        builder.values.push(b'\r');
        Result::Ok(index + 1)
    } else if escape == b't' {
        builder.values.push(b'\t');
        Result::Ok(index + 1)
    } else if escape == b'v' {
        builder.values.push(11);
        Result::Ok(index + 1)
    } else if escape == b'\\' {
        builder.values.push(b'\\');
        Result::Ok(index + 1)
    } else if escape == quote {
        builder.values.push(quote);
        Result::Ok(index + 1)
    } else {
        let mut radix = 0;
        let mut digits = 0;
        let mut byte_escape = false;
        let mut cursor = index;
        if escape >= b'0' && escape <= b'7' {
            radix = 8;
            digits = 3;
            byte_escape = true;
        } else if escape == b'x' {
            radix = 16;
            digits = 2;
            byte_escape = true;
            cursor += 1;
        } else if escape == b'u' {
            radix = 16;
            digits = 4;
            cursor += 1;
        } else if escape == b'U' {
            radix = 16;
            digits = 8;
            cursor += 1;
        } else {
            return Result::Err("unknown escape sequence")
        };
        if cursor + digits > value.byte_len() {
            return Result::Err("escape sequence not terminated")
        } else {};
        let mut decoded = 0 as uint32;
        for offset in 0..digits {
            match literal_digit(value.byte_get(cursor + offset), radix) {
                Some(digit) => {
                    decoded = decoded * radix as uint32 + digit as uint32;
                },
                None => return Result::Err("illegal character in escape sequence"),
            }
        }
        if byte_escape {
            if decoded > 255 {
                Result::Err("escape sequence is invalid Unicode code point")
            } else {
                builder.values.push(decoded as byte);
                Result::Ok(cursor + digits)
            }
        } else {
            append_codepoint(builder, decoded)?;
            Result::Ok(cursor + digits)
        }
    }
}

pub fn parse_string_literal(value: string) -> Result[ConstValue, string] {
    if value.byte_len() < 2 {
        return Result::Err("string literal not terminated")
    } else {};
    let quote = value.byte_get(0);
    if value.byte_get(value.byte_len() - 1) != quote || (quote != b'"' && quote != b'`') {
        return Result::Err("string literal not terminated")
    } else {};
    let builder = text::StringBuilder::with_capacity(value.byte_len() - 2);
    if quote == b'`' {
        for index in 1..value.byte_len() - 1 {
            let byte = value.byte_get(index);
            if byte == b'\r' {} else {
                builder.values.push(byte)
            }
        }
    } else {
        let mut index = 1;
        while index < value.byte_len() - 1 {
            let byte = value.byte_get(index);
            if byte == b'\\' {
                index = parse_escape(value, index + 1, b'"', builder)?;
            } else {
                builder.values.push(byte);
                index += 1;
            }
        }
    }
    let (_, result) = string_from_utf8_raw(builder.values);
    Result::Ok(ConstValue::String(result))
}

pub fn parse_rune_literal(value: string) -> Result[ConstValue, string] {
    if value.byte_len() < 3 || value.byte_get(0) != b'\''
        || value.byte_get(value.byte_len() - 1) != b'\'' {
        return Result::Err("illegal rune literal")
    } else {};
    let content = value.byte_slice(1, value.byte_len() - 1);
    let codepoint = if content.byte_get(0) == b'\\' {
        let builder = text::StringBuilder::new();
        let end = parse_escape(content, 1, b'\'', builder)?;
        if end != content.byte_len() {
            return Result::Err("illegal rune literal")
        } else {};
        if builder.values.len() == 1 {
            builder.values[0] as uint32
        } else {
            match builder.finish().decode_at(0) {
                Some((character, width)) => if width == builder.values.len() {
                    character as uint32
                } else {
                    return Result::Err("illegal rune literal")
                },
                None => return Result::Err("illegal rune literal"),
            }
        }
    } else {
        match content.decode_at(0) {
            Some((character, width)) => if width == content.byte_len() {
                character as uint32
            } else {
                return Result::Err("illegal rune literal")
            },
            None => return Result::Err("illegal rune literal"),
        }
    };
    Result::Ok(ConstValue::Int(integer_from_parts(1, natural_from_uint64(codepoint as uint64))))
}
