package constant;

use std::testing;

fn parse_natural(value: string) -> Natural {
    testing::expect_ok(natural_parse_digits(value, 10.to_uint32()), "failed to parse natural")
}

#[test]
fn parses_and_formats_values_larger_than_uint64() -> unit {
    let value = parse_natural("1267650600228229401496703205379");
    testing::assert_eq(natural_to_string(value), "1267650600228229401496703205379");
    testing::assert_eq(natural_bit_len(value), 101);
    testing::assert(natural_bit(value, 100));
    testing::assert(natural_bit(value, 1));
    testing::assert(natural_bit(value, 0))
}

#[test]
fn arithmetic_preserves_all_limbs() -> unit {
    let left = parse_natural("18446744073709551617");
    let right = parse_natural("4294967297");
    testing::assert_eq(natural_to_string(natural_add(left, right)), "18446744078004518914");
    testing::assert_eq(
        natural_to_string(natural_sub(left, right).unwrap_or(natural_zero())),
        "18446744069414584320",
    );
    testing::assert_eq(natural_to_string(natural_mul(left, right)), "79228162532711081671548469249")
}

#[test]
fn division_round_trips_large_values() -> unit {
    let numerator = parse_natural("79228162532711081671548469252");
    let denominator = parse_natural("4294967297");
    let divided = testing::expect_ok(
        natural_div_rem(numerator, denominator),
        "large division failed",
    );
    testing::assert_eq(natural_to_string(divided.0), "18446744073709551617");
    testing::assert_eq(natural_to_string(divided.1), "3");
    testing::assert_eq(
        natural_to_string(natural_gcd(parse_natural("48"), parse_natural("18"))),
        "6",
    )
}

#[test]
fn shifts_across_limb_boundaries() -> unit {
    let shifted = natural_shift_left(natural_one(), 100);
    testing::assert_eq(natural_to_string(shifted), "1267650600228229401496703205376");
    testing::assert_eq(natural_to_string(natural_shift_right(shifted, 68)), "4294967296");
    testing::assert_eq(natural_to_string(natural_shift_right(shifted, 100)), "1");
    testing::assert(natural_is_zero(natural_shift_right(shifted, 101)))
}

#[test]
fn parses_binary_octal_and_hexadecimal_digits() -> unit {
    testing::assert_eq(
        natural_to_string(
            testing::expect_ok(
                natural_parse_digits("ffff_ffff_ffff_ffff", 16.to_uint32()),
                "hex parse failed",
            ),
        ),
        "18446744073709551615",
    );
    testing::assert_eq(
        natural_to_string(
            testing::expect_ok(natural_parse_digits("111111", 2.to_uint32()), "binary parse failed"),
        ),
        "63",
    );
    testing::assert_eq(
        natural_to_string(
            testing::expect_ok(natural_parse_digits("777", 8.to_uint32()), "octal parse failed"),
        ),
        "511",
    )
}
