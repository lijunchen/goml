package main;

use gomlgo::typecheck_compare;
use std::env;
use std::process;

fn main() -> unit {
    let arguments = env::args();
    let mode = if arguments.len() >= 2 && arguments[1] == "acceptance" {
        typecheck_compare::CompareMode::Acceptance
    } else if arguments.len() >= 2 && arguments[1] == "info" {
        typecheck_compare::CompareMode::Info
    } else {
        typecheck_compare::CompareMode::Diagnostics
    };
    let explicit_mode = arguments.len() >= 2
        && (arguments[1] == "acceptance" || arguments[1] == "diagnostics" || arguments[1] == "info");
    let root = if explicit_mode && arguments.len() >= 3 {
        arguments[2]
    } else if !explicit_mode && arguments.len() >= 2 {
        arguments[1]
    } else {
        "testdata/typecheck"
    };
    if (explicit_mode && arguments.len() > 3) || (!explicit_mode && arguments.len() > 2) {
        println("usage: gofront_type_diff [acceptance|diagnostics|info] [ROOT]");
        process::exit(1)
    } else {};
    match typecheck_compare::compare_tree_mode(root, mode) {
        Ok(summary) => println(
            "type-check acceptance zero diff: files=" + summary.files.to_string() + " accepted="
                + summary.accepted.to_string()
                + " rejected="
                + summary.rejected.to_string()
                + " info_compared="
                + summary.info_compared.to_string(),
        ),
        Err(message) => {
            println(message);
            process::exit(1)
        },
    }
}
