package main;

use gomlgo::ast;
use gomlgo::bytecode;
use gomlgo::checker;
use gomlgo::execution;
use gomlgo::interpreter;
use gomlgo::loader;
use gomlgo::native;
use gomlgo::parser;
use gomlgo::scanner;
use gomlgo::token;
use std::bytes;
use std::env;
use std::fs;
use std::io;
use std::num;
use std::path;
use std::process;
use std::crypto::hash;

const CHECK_COMMAND: string = "check";

const CHECK_PACKAGE_COMMAND: string = "check-package";

const SCAN_COMMAND: string = "scan";

const PARSE_COMMAND: string = "parse";

const PARSE_EXPR_COMMAND: string = "parse-expr";

const RUN_COMMAND: string = "run";

const EXECUTION_IMAGE_ENV: string = "GOMLGO_EXECUTION_IMAGE";

const IMAGE_SOURCE_ENV: string = "GOMLGO_IMAGE_SOURCE";

const BRIDGE_SOURCE_ENV: string = "GOMLGO_BRIDGE_SOURCE";

const CACHE_ROOT_ENV: string = "GOMLGO_NATIVE_CACHE";

const COMMAND_USAGE: string = "usage: gomlgo scan FILE | parse FILE | parse-expr EXPR | check FILE... | check-package DIRECTORY | run [--seed N] [--max-goroutines N] [--max-steps N] [--program-executable FILE] FILE [-- PROGRAM_ARGS...]";

#[go_ffi("gomlgo/nativebridge", "ReplaceProcess")]
extern fn replace_process(
    program: string,
    arguments: Slice[string],
    environment_key: string,
    environment_value: string,
) -> string;

fn fail(message: string) -> unit {
    println(message);
    process::exit(1)
}

fn read_source(file: string) -> bytes::Bytes {
    match fs::read_bytes(file) {
        Ok(source) => source,
        Err(message) => {
            fail(message);
            bytes::Bytes::new()
        },
    }
}

fn print_diagnostics(result: parser::ParseResult) -> unit {
    for value in result.diagnostics {
        println(value.offset.to_string() + "\t" + value.message)
    }
}

fn scan_file(file: string) -> unit {
    let result = scanner::scan_bytes(read_source(file));
    for value in result.tokens {
        println(
            token::name(value.kind) + "\t" + value.literal + "\t" + value.start.to_string() + "\t"
                + value.end.to_string()
                + "\t"
                + value.synthetic.to_string(),
        )
    }
    for value in result.diagnostics {
        println(value.offset.to_string() + "\t" + value.message)
    }
    if !result.diagnostics.is_empty() {
        process::exit(1)
    } else {}
}

fn print_parse_result(result: parser::ParseResult) -> unit {
    match result.root {
        Some(root) => println(ast::encode(root)),
        None => println("null"),
    };
    print_diagnostics(result);
    if !result.diagnostics.is_empty() {
        process::exit(1)
    } else {}
}

fn check_files(files: Vec[string], package_path: string) -> unit {
    if files.len() == 1 {
        let name = path::file_name(files[0]).unwrap_or(files[0]);
        if name.ends_with(".gom.go") || name == "goml_generated.go" {
            match execution::load_files(execution::default_config(), files) {
                Ok(result) => {
                    let mut fallback = false;
                    for value in result.diagnostics {
                        if value.message.starts_with("entry package must be named main")
                            || value.message.starts_with("main.main") {
                            fallback = true;
                        } else {}
                    }
                    if !fallback {
                        for value in result.diagnostics {
                            println(
                                value.file + ":" + value.start.to_string() + ":"
                                    + value.end.to_string()
                                    + ": "
                                    + value.message,
                            )
                        }
                        if result.program.is_none() || !result.diagnostics.is_empty() {
                            process::exit(1)
                        } else {};
                        return
                    } else {}
                },
                Err(_) => {},
            }
        } else {}
    } else {};
    let sources: Vec[checker::SourceFile] = Vec::new();
    for file in files {
        sources.push(checker::SourceFile { name: file, source: read_source(file) })
    }
    let result = match loader::check_sources_with_diagnostics(
        loader::default_config(),
        package_path,
        sources,
    ) {
        Ok(value) => value,
        Err(message) => {
            fail(message);
            return
        },
    };
    for value in result.diagnostics {
        println(
            value.file + ":" + value.start.to_string() + ":" + value.end.to_string() + ": "
                + value.message,
        )
    }
    if !result.diagnostics.is_empty() {
        process::exit(1)
    } else {}
}

fn check_package(directory: string) -> unit {
    match loader::check_directory(loader::default_config(), directory, directory) {
        Ok(_) => {},
        Err(message) => fail(message),
    }
}

fn write_stderr(message: string) -> unit {
    match io::write_stderr(bytes::Bytes::from_string(message + "\n")) {
        Ok(()) => {},
        Err(error) => fail(error),
    }
}

fn source_hash(files: Vec[string]) -> Result[string, string] {
    let builder = bytes::Bytes::new();
    for file in files {
        for value in fs::read_bytes(file)?.to_vec() {
            builder.push(value)
        }
    }
    Result::Ok(hash::sha256(builder))
}

fn imported_paths_hash(program: bytecode::BytecodeProgram) -> string {
    let builder = bytes::Bytes::new();
    for package_value in program.packages {
        for value in bytes::Bytes::from_string(package_value.path + "\n").to_vec() {
            builder.push(value)
        }
    }
    hash::sha256(builder)
}

fn artifact_module_root(generated: string) -> Result[string, string] {
    let mut current = path::parent(generated).ok_or("generated source has no parent")?;
    while current != "" {
        if fs::is_file(path::join(current, "goml.toml"))
            && fs::is_file(path::join(current, "nativebridge/bridge.go")) {
            return Result::Ok(current)
        } else {};
        let nested = path::join(current, "gomlgo");
        if fs::is_file(path::join(nested, "goml.toml"))
            && fs::is_file(path::join(nested, "nativebridge/bridge.go")) {
            return Result::Ok(nested)
        } else {};
        let Some(parent) = path::parent(current) else {
            break
        };
        if parent == current {
            break
        } else {};
        current = parent;
    }
    Result::Err("generated source is not below a gomlgo module root")
}

fn artifact_source() -> Result[string, string] {
    match env::var(IMAGE_SOURCE_ENV) {
        Some(value) => if fs::is_file(value) {
            Result::Ok(value)
        } else {
            Result::Err(IMAGE_SOURCE_ENV + " is not a file: " + value)
        },
        None => {
            let executable = env::current_exe()?;
            let directory = path::parent(executable).ok_or("gomlgo executable has no parent")?;
            let artifact_root = path::parent(
                path::parent(path::parent(directory).ok_or("gomlgo executable has no artifact")?).ok_or(
                    "gomlgo executable has no artifact",
                )?,
            ).ok_or("gomlgo executable has no artifact")?;
            let candidate = path::join(
                path::join(
                    path::join(artifact_root, "build/pkg/gomlgo/cmd/gomlgo"),
                    "goml_generated.go",
                ),
                "",
            );
            let candidate = path::clean(candidate);
            if fs::is_file(candidate) {
                Result::Ok(candidate)
            } else {
                Result::Err(
                    "native execution requires " + IMAGE_SOURCE_ENV + " or a gomlgo build artifact",
                )
            }
        },
    }
}

fn bridge_sources() -> Result[Vec[native::GeneratedFile], string] {
    match env::var(BRIDGE_SOURCE_ENV) {
        Some(value) => {
            let directory = path::parent(value).ok_or("native bridge source has no parent")?;
            Result::Ok(
                Vec::from_array(
                    [
                        native::GeneratedFile {
                            relative_path: "nativebridge/bridge.go",
                            content: fs::read_file(value)?,
                        },
                        native::GeneratedFile {
                            relative_path: "nativebridge/advanced.go",
                            content: fs::read_file(path::join(directory, "advanced.go"))?,
                        },
                        native::GeneratedFile {
                            relative_path: "nativebridge/catalog.go",
                            content: fs::read_file(path::join(directory, "catalog.go"))?,
                        },
                    ],
                ),
            )
        },
        None => {
            let generated = artifact_source()?;
            let package_root = artifact_module_root(generated)?;
            Result::Ok(
                Vec::from_array(
                    [
                        native::GeneratedFile {
                            relative_path: "nativebridge/bridge.go",
                            content: fs::read_file(
                                path::join(package_root, "nativebridge/bridge.go"),
                            )?,
                        },
                        native::GeneratedFile {
                            relative_path: "nativebridge/advanced.go",
                            content: fs::read_file(
                                path::join(package_root, "nativebridge/advanced.go"),
                            )?,
                        },
                        native::GeneratedFile {
                            relative_path: "nativebridge/catalog.go",
                            content: fs::read_file(
                                path::join(package_root, "nativebridge/catalog.go"),
                            )?,
                        },
                    ],
                ),
            )
        },
    }
}

fn cache_root() -> Result[string, string] {
    match env::var(CACHE_ROOT_ENV) {
        Some(value) => Result::Ok(value),
        None => {
            let module_root = artifact_module_root(artifact_source()?)?;
            Result::Ok(path::join(path::join(module_root, "_artifact"), "native-cache"))
        },
    }
}

fn native_image(
    program: bytecode::BytecodeProgram,
    files: Vec[string],
    toolchain: execution::GoToolchain,
) -> Result[string, string] {
    let generated = artifact_source()?;
    let module_root = artifact_module_root(generated)?;
    let image_sources = Vec::from_array(
        [
            native::GeneratedFile { relative_path: "main.go", content: fs::read_file(generated)? },
            native::GeneratedFile {
                relative_path: "rawstring/rawstring.go",
                content: fs::read_file(path::join(module_root, "rawstring/rawstring.go"))?,
            },
        ],
    );
    let plan = native::build_plan(
        native::BuildRequest {
            go_binary: toolchain.binary,
            cache_root: cache_root()?,
            cache: native::CacheKeyInput {
                go_version: toolchain.version,
                goos: toolchain.host_goos,
                goarch: toolchain.host_goarch,
                goamd64: env::var("GOAMD64").unwrap_or("v1"),
                goexperiment: env::var("GOEXPERIMENT").unwrap_or(""),
                cgo: false,
                tags: Vec::new(),
                source_hash: source_hash(files)?,
                import_manifest_hash: imported_paths_hash(program),
            },
            bridge_sources: bridge_sources()?,
            image_sources,
        },
        bytecode::native_manifest(program)?,
    )?;
    native::build_execution_image(plan)
}

fn execute_loaded(
    result: execution::ExecutionLoadResult,
    files: Vec[string],
    vm_config: interpreter::VmConfig,
) -> unit {
    for value in result.diagnostics {
        write_stderr(
            value.file + ":" + value.start.to_string() + ":" + value.end.to_string() + ": "
                + value.message,
        )
    }
    let Some(program) = result.program else {
        process::exit(1);
        return
    };
    let toolchain = program.toolchain;
    let lowered = bytecode::lower_unverified(program);
    for value in lowered.diagnostics {
        write_stderr(value.start.to_string() + ":" + value.end.to_string() + ": " + value.message)
    }
    let Some(program) = lowered.program else {
        process::exit(1);
        return
    };
    if !program.native_calls.is_empty() && env::var(EXECUTION_IMAGE_ENV).is_none() {
        let catalog_installed = match bytecode::native_manifest(program) {
            Ok(manifest) => native::install_catalog(manifest),
            Err(_) => false,
        };
        if !catalog_installed {
            let image = match native_image(program, files, toolchain) {
                Ok(value) => value,
                Err(message) => {
                    fail("native link failed: " + message);
                    return
                },
            };
            let arguments = env::args();
            let replacement_arguments: Vec[string] = Vec::with_capacity(arguments.len());
            replacement_arguments.push(image);
            for index in 1..arguments.len() {
                replacement_arguments.push(arguments[index])
            }
            fail(
                replace_process(
                    image,
                    replacement_arguments.slice(0, replacement_arguments.len()),
                    EXECUTION_IMAGE_ENV,
                    "1",
                ),
            );
            return
        } else {}
    } else {};
    let result = interpreter::run(program, vm_config);
    match io::write_stdout(result.stdout) {
        Ok(()) => {},
        Err(message) => fail(message),
    };
    match io::write_stderr(result.stderr) {
        Ok(()) => {},
        Err(message) => fail(message),
    };
    if result.exit_code != 0 {
        process::exit(result.exit_code)
    } else {}
}

fn run_files(arguments: Vec[string]) -> unit {
    let files: Vec[string] = Vec::new();
    let vm_config = interpreter::default_config();
    let mut index = 2;
    while index < arguments.len() && arguments[index] != "--" {
        if arguments[index] == "--seed" {
            if index + 1 >= arguments.len() {
                fail(COMMAND_USAGE)
            } else {};
            vm_config.select_seed = match num::parse_uint(arguments[index + 1]) {
                Ok(value) => value.to_u64(),
                Err(message) => {
                    fail("invalid select seed: " + message);
                    0.to_u64()
                },
            };
            index += 2;
        } else if arguments[index] == "--max-goroutines" {
            if index + 1 >= arguments.len() {
                fail(COMMAND_USAGE)
            } else {};
            vm_config.max_goroutines = match num::parse_int(arguments[index + 1]) {
                Ok(value) => if value > 0 {
                    value
                } else {
                    fail("maximum goroutine count must be positive");
                    1
                },
                Err(message) => {
                    fail("invalid maximum goroutine count: " + message);
                    1
                },
            };
            index += 2;
        } else if arguments[index] == "--max-steps" {
            if index + 1 >= arguments.len() {
                fail(COMMAND_USAGE)
            } else {};
            vm_config.max_steps = match num::parse_int(arguments[index + 1]) {
                Ok(value) => if value > 0 || value == -1 {
                    value.to_i64()
                } else {
                    fail("maximum step count must be positive or -1");
                    1.to_i64()
                },
                Err(message) => {
                    fail("invalid maximum step count: " + message);
                    1.to_i64()
                },
            };
            index += 2;
        } else if arguments[index] == "--program-executable" {
            if index + 1 >= arguments.len() {
                fail(COMMAND_USAGE)
            } else {};
            vm_config.program_executable = arguments[index + 1];
            index += 2;
        } else {
            files.push(arguments[index]);
            index += 1;
        }
    }
    if files.len() != 1 {
        fail(COMMAND_USAGE)
    } else {};
    match execution::load_files(execution::default_config(), files) {
        Ok(value) => execute_loaded(value, files, vm_config),
        Err(message) => fail(message),
    }
}

fn main() -> unit {
    let arguments = env::args();
    if arguments.len() < 2 {
        fail(COMMAND_USAGE)
    } else {
        match arguments[1] {
            CHECK_COMMAND => if arguments.len() >= 3 {
                let files: Vec[string] = Vec::new();
                for index in 2..arguments.len() {
                    files.push(arguments[index])
                }
                check_files(files, "command-line-arguments")
            } else {
                fail(COMMAND_USAGE)
            },
            CHECK_PACKAGE_COMMAND => if arguments.len() == 3 {
                check_package(arguments[2])
            } else {
                fail(COMMAND_USAGE)
            },
            SCAN_COMMAND => if arguments.len() == 3 {
                scan_file(arguments[2])
            } else {
                fail(COMMAND_USAGE)
            },
            PARSE_COMMAND => if arguments.len() == 3 {
                print_parse_result(parser::parse_file_bytes(read_source(arguments[2])))
            } else {
                fail(COMMAND_USAGE)
            },
            PARSE_EXPR_COMMAND => if arguments.len() == 3 {
                print_parse_result(parser::parse_expr(arguments[2]))
            } else {
                fail(COMMAND_USAGE)
            },
            RUN_COMMAND => run_files(arguments),
            _ => fail(COMMAND_USAGE),
        }
    }
}
