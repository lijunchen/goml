package scanner;

use gomlgo::token;

fn digit_value(value: int32) -> int {
    if value >= b'0' as int32 && value <= b'9' as int32 {
        (value - b'0' as int32) as int
    } else if ascii_lower(value) >= b'a' as int32 && ascii_lower(value) <= b'f' as int32 {
        (ascii_lower(value) - b'a' as int32 + 10) as int
    } else {
        16
    }
}

fn scan_digits(scanner: Scanner, base: int, invalid: Ref[int]) -> int {
    let mut result = 0;
    if base <= 10 {
        let maximum = b'0' as int32 + base as int32;
        while is_decimal(scanner.current.get()) || scanner.current.get() == b'_' as int32 {
            if scanner.current.get() == b'_' as int32 {
                result = result | 2;
            } else {
                result = result | 1;
                if scanner.current.get() >= maximum && invalid.get() < 0 {
                    invalid.set(scanner.offset.get())
                } else {}
            };
            next(scanner)
        }
    } else {
        while is_hex(scanner.current.get()) || scanner.current.get() == b'_' as int32 {
            if scanner.current.get() == b'_' as int32 {
                result = result | 2;
            } else {
                result = result | 1;
            };
            next(scanner)
        }
    };
    result
}

fn literal_name(prefix: int32) -> string {
    if prefix == b'x' as int32 {
        "hexadecimal literal"
    } else if prefix == b'o' as int32 || prefix == b'0' as int32 {
        "octal literal"
    } else if prefix == b'b' as int32 {
        "binary literal"
    } else {
        "decimal literal"
    }
}

fn invalid_separator(literal: string) -> int {
    let mut prefix = b' ';
    let mut previous = b'.';
    let mut index = 0;
    if literal.byte_len() >= 2 && literal.byte_get(0) == b'0' {
        let next_byte = literal.byte_get(1);
        prefix = if next_byte >= b'A' && next_byte <= b'Z' {
            next_byte + 32
        } else {
            next_byte
        };
        if prefix == b'x' || prefix == b'o' || prefix == b'b' {
            previous = b'0';
            index = 2;
        } else {}
    } else {};
    while index < literal.byte_len() {
        let before = previous;
        let current = literal.byte_get(index);
        if current == b'_' {
            if before != b'0' {
                return index
            } else {};
            previous = current;
        } else if current >= b'0' && current <= b'9'
            || (prefix == b'x'
                && ((current >= b'a' && current <= b'f') || (current >= b'A' && current <= b'F'))) {
            previous = b'0';
        } else {
            if before == b'_' {
                return index - 1
            } else {};
            previous = b'.';
        };
        index += 1;
    }
    if previous == b'_' {
        literal.byte_len() - 1
    } else {
        -1
    }
}

fn scan_number(scanner: Scanner) -> (token::Kind, string) {
    let start = scanner.offset.get();
    let mut kind = token::Kind::Illegal;
    let mut base = 10;
    let mut prefix = 0 as int32;
    let mut digit_separator = 0;
    let invalid = Ref::new(-1);
    if scanner.current.get() != b'.' as int32 {
        kind = token::Kind::Int;
        if scanner.current.get() == b'0' as int32 {
            next(scanner);
            let lowered = ascii_lower(scanner.current.get());
            if lowered == b'x' as int32 {
                next(scanner);
                base = 16;
                prefix = b'x' as int32;
            } else if lowered == b'o' as int32 {
                next(scanner);
                base = 8;
                prefix = b'o' as int32;
            } else if lowered == b'b' as int32 {
                next(scanner);
                base = 2;
                prefix = b'b' as int32;
            } else {
                base = 8;
                prefix = b'0' as int32;
                digit_separator = 1;
            }
        } else {};
        digit_separator = digit_separator | scan_digits(scanner, base, invalid);
    } else {};
    if scanner.current.get() == b'.' as int32 {
        kind = token::Kind::Float;
        if prefix == b'o' as int32 || prefix == b'b' as int32 {
            report(scanner, scanner.offset.get(), "invalid radix point in " + literal_name(prefix))
        } else {};
        next(scanner);
        digit_separator = digit_separator | scan_digits(scanner, base, invalid);
    } else {};
    if digit_separator & 1 == 0 {
        report(scanner, scanner.offset.get(), literal_name(prefix) + " has no digits")
    } else {};
    let exponent = ascii_lower(scanner.current.get());
    if exponent == b'e' as int32 || exponent == b'p' as int32 {
        if exponent == b'e' as int32 && prefix != 0 && prefix != b'0' as int32 {
            report(scanner, scanner.offset.get(), "exponent requires decimal mantissa")
        } else if exponent == b'p' as int32 && prefix != b'x' as int32 {
            report(scanner, scanner.offset.get(), "exponent requires hexadecimal mantissa")
        } else {};
        next(scanner);
        kind = token::Kind::Float;
        if scanner.current.get() == b'+' as int32 || scanner.current.get() == b'-' as int32 {
            next(scanner)
        } else {};
        let exponent_invalid = Ref::new(-1);
        let exponent_digits = scan_digits(scanner, 10, exponent_invalid);
        digit_separator = digit_separator | exponent_digits;
        if exponent_digits & 1 == 0 {
            report(scanner, scanner.offset.get(), "exponent has no digits")
        } else {}
    } else if prefix == b'x' as int32 && token::equal(kind, token::Kind::Float) {
        report(scanner, scanner.offset.get(), "hexadecimal mantissa requires a 'p' exponent")
    } else {};
    if scanner.current.get() == b'i' as int32 {
        kind = token::Kind::Imag;
        next(scanner)
    } else {};
    let literal = source_text(scanner.source, start, scanner.offset.get());
    if token::equal(kind, token::Kind::Int) && invalid.get() >= 0 {
        report(scanner, invalid.get(), "invalid digit in " + literal_name(prefix))
    } else {};
    if digit_separator & 2 != 0 {
        let invalid_offset = invalid_separator(literal);
        if invalid_offset >= 0 {
            report(scanner, start + invalid_offset, "'_' must separate successive digits")
        } else {}
    } else {};
    (kind, literal)
}
