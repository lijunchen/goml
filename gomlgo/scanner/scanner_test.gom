package scanner;

use gomlgo::differential;
use gomlgo::token;
use std::bytes;
use std::json;
use std::testing;

fn oracle_scan(source: bytes::Bytes) -> differential::OracleResponse {
    match differential::run_oracle("scan", source) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            differential::OracleResponse {
                mode: "scan",
                ok: false,
                go_version: "",
                goroot: "",
                tokens: Vec::[],
                ast: json::Value::Null,
                diagnostics: Vec::[],
            }
        },
    }
}

fn assert_scan_matches_bytes(source: bytes::Bytes) -> unit {
    let actual = scan_bytes(source);
    let expected = oracle_scan(source);
    testing::assert_eq(actual.tokens.len(), expected.tokens.len());
    for index in 0..actual.tokens.len() {
        let actual_token = actual.tokens[index];
        let expected_token = expected.tokens[index];
        if token::name(actual_token.kind) != expected_token.kind
            || actual_token.literal != expected_token.literal
            || actual_token.start != expected_token.start
            || actual_token.end != expected_token.end
            || actual_token.synthetic != expected_token.synthetic {
            testing::fail(
                "scanner mismatch at token " + index.to_string() + ": actual="
                    + token::name(actual_token.kind)
                    + " "
                    + actual_token.literal
                    + " "
                    + actual_token.start.to_string()
                    + ".."
                    + actual_token.end.to_string()
                    + " synthetic="
                    + actual_token.synthetic.to_string()
                    + ", expected="
                    + expected_token.kind
                    + " "
                    + expected_token.literal
                    + " "
                    + expected_token.start.to_string()
                    + ".."
                    + expected_token.end.to_string()
                    + " synthetic="
                    + expected_token.synthetic.to_string(),
            )
        } else {}
    }
}

fn assert_scan_matches(source: string) -> unit {
    assert_scan_matches_bytes(bytes::Bytes::from_string(source))
}

#[test]
fn matches_keywords_and_operators() -> unit {
    assert_scan_matches(
        "break default func interface select case defer go map struct chan else goto package switch const fallthrough if range type continue for import return var\n+ - * / % & | ^ << >> &^ += -= *= /= %= &= |= ^= <<= >>= &^= && || <- ++ -- == < > = ! != <= >= := ... ( ) [ ] { } , ; . : ~",
    )
}

#[test]
fn matches_identifiers_and_numbers() -> unit {
    assert_scan_matches(
        "alpha _x 世界 π2 a٢ 0 0123 0b101 0B1_0 0o755 0O7 0xff 0XCA_FE 1.0 .5 1. 1e9 1E-2 0x1.fp2 2i 3.5i 0b102 0x 1__2 1e+",
    )
}

#[test]
fn matches_strings_runes_and_comments() -> unit {
    assert_scan_matches(
        "'a' '世' '\\n' '\\x7f' '\\u4e16' \"hello\\n\" `raw\r\ntext` // line\r\n/* block\r\ntext */ identifier",
    )
}

#[test]
fn matches_semicolon_insertion() -> unit {
    assert_scan_matches("x\ny\nreturn\nx\nx++\ny\nx /* comment\nwith newline */ y\n")
}

#[test]
fn matches_bom_nul_and_invalid_utf8() -> unit {
    let source: Vec[byte] = Vec::[239, 187, 191, b'x', 0, 255, b'\n'];
    assert_scan_matches_bytes(bytes::Bytes::from_vec(source))
}

#[test]
fn preserves_explicit_semicolons() -> unit {
    let result = scan("x; y\n");
    testing::assert_eq(result.tokens.len(), 5);
    testing::assert(token::equal(result.tokens[1].kind, token::Kind::Semicolon));
    testing::assert(!result.tokens[1].synthetic);
    testing::assert_eq(result.tokens[1].literal, ";");
    testing::assert(result.tokens[3].synthetic)
}
