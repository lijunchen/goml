{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "GoML",
    "scopeName": "source.goml",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#chars"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.goml",
                    "match": "//.*$"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "meta.attribute.goml",
                    "begin": "#!?\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.attribute.begin.goml"
                        }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.attribute.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#quoted-strings"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "include": "#attribute-brackets"
                        },
                        {
                            "name": "entity.other.attribute-name.goml",
                            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                        }
                    ]
                }
            ]
        },
        "attribute-brackets": {
            "name": "meta.attribute.arguments.goml",
            "begin": "\\[",
            "end": "\\]",
            "patterns": [
                {
                    "include": "#quoted-strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#attribute-brackets"
                },
                {
                    "name": "entity.other.attribute-name.goml",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.raw.byte.goml",
                    "begin": "\\bbr(#{0,})\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"\\1",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    }
                },
                {
                    "name": "string.quoted.double.byte.goml",
                    "begin": "\\bb\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\([\"\\\\0bnfrt/]|x[a-fA-F0-9]{2})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.unquoted.multiline.goml",
                    "begin": "\\\\\\\\",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "while": "^(\\s*)(\\\\\\\\)",
                    "whileCaptures": {
                        "2": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    }
                },
                {
                    "include": "#quoted-strings"
                }
            ]
        },
        "quoted-strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.goml",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "\"|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\([\"\\\\bnfrt/]|u[a-fA-F0-9]{4})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "chars": {
            "patterns": [
                {
                    "name": "string.quoted.single.goml",
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.goml"
                        }
                    },
                    "end": "'|(?=$)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.goml"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.goml",
                            "match": "\\\\(['\\\\bnfrt/]|u[a-fA-F0-9]{4})"
                        },
                        {
                            "name": "invalid.illegal.escape.goml",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.goml",
                    "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b"
                },
                {
                    "name": "constant.numeric.float.goml",
                    "match": "\\b[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*\\b"
                },
                {
                    "name": "constant.numeric.integer.goml",
                    "match": "\\b[0-9](?:_?[0-9])*\\b"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.function.goml"
                        },
                        "2": {
                            "name": "entity.name.function.goml"
                        }
                    }
                },
                {
                    "match": "\\b(struct|enum|trait|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.type.goml"
                        },
                        "2": {
                            "name": "entity.name.type.goml"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.goml",
                    "match": "\\b(if|else|match|while|for|in|return|break|continue|go)\\b"
                },
                {
                    "name": "keyword.declaration.goml",
                    "match": "\\b(fn|let|struct|enum|trait|impl|type|use|package|extern)\\b"
                },
                {
                    "name": "keyword.other.goml",
                    "match": "\\b(dyn|as|mut|pub|where)\\b"
                },
                {
                    "name": "constant.language.boolean.goml",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "variable.language.self.goml",
                    "match": "\\bSelf\\b"
                },
                {
                    "name": "variable.language.wildcard.goml",
                    "match": "(?<![A-Za-z0-9_])_(?![A-Za-z0-9_])"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.goml",
                    "match": "\\b(bool|int|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|string|char|unit)\\b"
                },
                {
                    "name": "storage.type.builtin.goml",
                    "match": "\\b(Vec|Slice|Ref|Option|Result|HashMap|Channel|Iterator|IntoIterator|FnIterator|MapIterator|FilterIterator|TakeIterator)\\b"
                },
                {
                    "name": "entity.name.type.goml",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "name": "entity.name.namespace.goml",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=::)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.goml",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:\\[[^\\]\\r\\n]*\\])?\\s*\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.goml",
                    "match": "(\\.\\.=|\\.\\.|->|=>|::|<<|>>|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|!|&|\\||\\^|~|\\?|@)"
                }
            ]
        }
    }
}
