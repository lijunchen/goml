{
    "root": true,
    "env": {
        "es2020": true,
        "node": true
    },
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "ignorePatterns": [
        "out"
    ],
    "overrides": [
        {
            "files": [
                "src/test/**/*.ts"
            ],
            "env": {
                "mocha": true
            }
        }
    ]
}
