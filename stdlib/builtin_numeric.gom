package builtin;

#[intrinsic("numeric.convert")]
extern fn __goml_numeric_convert[T, U](value: T) -> U;

impl int {
    fn to_int8(self: int) -> int8 {
        __goml_numeric_convert::[int, int8](self)
    }

    fn to_int16(self: int) -> int16 {
        __goml_numeric_convert::[int, int16](self)
    }

    fn to_int32(self: int) -> int32 {
        __goml_numeric_convert::[int, int32](self)
    }

    fn to_int64(self: int) -> int64 {
        __goml_numeric_convert::[int, int64](self)
    }

    fn to_uint(self: int) -> uint {
        __goml_numeric_convert::[int, uint](self)
    }

    fn to_uint8(self: int) -> uint8 {
        __goml_numeric_convert::[int, uint8](self)
    }

    fn to_uint16(self: int) -> uint16 {
        __goml_numeric_convert::[int, uint16](self)
    }

    fn to_uint32(self: int) -> uint32 {
        __goml_numeric_convert::[int, uint32](self)
    }

    fn to_uint64(self: int) -> uint64 {
        __goml_numeric_convert::[int, uint64](self)
    }
}

