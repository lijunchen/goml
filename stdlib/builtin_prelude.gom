impl[T] FnIterator[T] {
    fn from_fn(next_fn: () -> Option[T]) -> Self {
        FnIterator { next_fn }
    }
}

impl[T] Iterator for FnIterator[T] {
    type Item = T;

    fn next(self: Self) -> Option[T] {
        self.next_fn()
    }
}

impl[A, B, I: Iterator] Iterator for MapIterator[A, B, I] where I::Item = A  {
    type Item = B;

    fn next(self: Self) -> Option[B] {
        match Iterator::next(self.iterator) {
            Some(value) => Option::Some(self.map_fn(value)),
            None => Option::None,
        }
    }
}

impl[T, I: Iterator] Iterator for FilterIterator[T, I] where I::Item = T  {
    type Item = T;

    fn next(self: Self) -> Option[T] {
        loop {
            match Iterator::next(self.iterator) {
                Some(value) => if self.predicate(value) {
                    return Option::Some(value)
                } else {
                    ()
                },
                None => return Option::None,
            };
        };
        Option::None
    }
}

impl[I: Iterator] Iterator for TakeIterator[I] {
    type Item = I::Item;

    fn next(self: Self) -> Option[I::Item] {
        let remaining = self.remaining.get();
        if remaining > 0 {
            self.remaining.set(remaining - 1);
            Iterator::next(self.iterator)
        } else {
            Option::None
        }
    }
}

impl[I: Iterator] IntoIterator for I {
    type Item = I::Item;

    type IntoIter = I;

    fn into_iter(self: I) -> I {
        self
    }
}

fn iterator_map[A, B, I: Iterator](iterator: I, map_fn: (A) -> B) -> MapIterator[A, B, I]
where
    I::Item = A,
{
    MapIterator { iterator, map_fn }
}

fn iterator_filter[T, I: Iterator](iterator: I, predicate: (T) -> bool) -> FilterIterator[T, I]
where
    I::Item = T,
{
    FilterIterator { iterator, predicate }
}

fn iterator_take[I: Iterator](iterator: I, count: int) -> TakeIterator[I] {
    let remaining = if count > 0 {
        count
    } else {
        0
    };
    TakeIterator { iterator, remaining: Ref::new(remaining) }
}

fn iterator_fold[T, A, I: Iterator](iterator: I, initial: A, combine: (A, T) -> A) -> A
where
    I::Item = T,
{
    let mut accumulator = initial;
    loop {
        match Iterator::next(iterator) {
            Some(value) => {
                accumulator = combine(accumulator, value);
            },
            None => break,
        };
    };
    accumulator
}

fn iterator_collect[T, I: Iterator](iterator: I) -> Vec[T] where I::Item = T {
    let values: Vec[T] = Vec::[];
    loop {
        match Iterator::next(iterator) {
            Some(value) => values.push(value),
            None => break,
        };
    };
    values
}

impl[T] Vec[T] {
    fn new() -> Self {
        vec_new()
    }

    fn with_capacity(capacity: int) -> Self {
        vec_with_capacity(capacity)
    }

    fn push(self: Self, elem: T) -> unit {
        vec_push(self, elem)
    }

    fn pushed(self: Self, elem: T) -> Self {
        let result: Vec[T] = Vec::with_capacity(self.len() + 1);
        let mut index = 0;
        while index < self.len() {
            result.push(self[index]);
            index += 1;
        };
        result.push(elem);
        result
    }

    fn get(self: Self, index: int) -> T {
        vec_get(self, index)
    }

    fn set(self: Self, index: int, elem: T) -> unit {
        vec_set(self, index, elem)
    }

    fn len(self: Self) -> int {
        vec_len(self)
    }

    fn capacity(self: Self) -> int {
        vec_capacity(self)
    }

    fn is_empty(self: Self) -> bool {
        vec_len(self) == 0
    }

    fn reserve(self: Self, additional: int) -> unit {
        vec_reserve(self, additional)
    }

    fn truncate(self: Self, len: int) -> unit {
        vec_truncate(self, len)
    }

    fn clear(self: Self) -> unit {
        self.truncate(0)
    }

    fn last(self: Self) -> Option[T] {
        let len = self.len();
        if len == 0 {
            Option::None
        } else {
            Option::Some(self[len - 1])
        }
    }

    fn pop(self: Self) -> Option[T] {
        let len = self.len();
        if len == 0 {
            Option::None
        } else {
            let value = self[len - 1];
            self.truncate(len - 1);
            Option::Some(value)
        }
    }

    fn swap(self: Self, left: int, right: int) -> unit {
        let value = self[left];
        self[left] = self[right];
        self[right] = value;
    }

    fn swap_remove(self: Self, index: int) -> T {
        let len = self.len();
        let value = self[index];
        if index + 1 < len {
            self[index] = self[len - 1];
        } else {
            ()
        };
        self.truncate(len - 1);
        value
    }

    fn insert(self: Self, index: int, value: T) -> unit {
        let len = self.len();
        if index == len {
            self.push(value)
        } else {
            let _ = self[index];
            self.push(self[len - 1]);
            let mut current = len - 1;
            while current > index {
                self[current] = self[current - 1];
                current -= 1;
            };
            self[index] = value;
        }
    }

    fn remove(self: Self, index: int) -> T {
        let len = self.len();
        let value = self[index];
        let mut current = index;
        while current + 1 < len {
            self[current] = self[current + 1];
            current += 1;
        };
        self.truncate(len - 1);
        value
    }

    fn reverse(self: Self) -> unit {
        let mut left = 0;
        let mut right = self.len() - 1;
        while left < right {
            self.swap(left, right);
            left += 1;
            right -= 1;
        }
    }

    fn extend(self: Self, other: Vec[T]) -> unit {
        let len = other.len();
        self.reserve(len);
        let mut index = 0;
        while index < len {
            self.push(other[index]);
            index += 1;
        }
    }

    fn slice(self: Self, start: int, end: int) -> Slice[T] {
        slice(self, start, end)
    }

    fn iter(self: Self) -> FnIterator[T] {
        let mut index = 0;
        let len = self.len();
        FnIterator::from_fn(
            || {
                let current = index;
                if current < len {
                    let value = self[current];
                    index = current + 1;
                    Option::Some(value)
                } else {
                    Option::None
                }
            },
        )
    }
}

impl[T] IntoIterator for Vec[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: Vec[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[T] Slice[T] {
    fn get(self: Self, index: int) -> T {
        slice_get(self, index)
    }

    fn len(self: Self) -> int {
        slice_len(self)
    }

    fn sub(self: Self, start: int, end: int) -> Self {
        slice_sub(self, start, end)
    }

    fn iter(self: Self) -> FnIterator[T] {
        let mut index = 0;
        let len = self.len();
        FnIterator::from_fn(
            || {
                let current = index;
                if current < len {
                    let value = self.get(current);
                    index = current + 1;
                    Option::Some(value)
                } else {
                    Option::None
                }
            },
        )
    }
}

impl[T] IntoIterator for Slice[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: Slice[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[K: Hash + Eq, V] HashMap[K, V] {
    fn new() -> Self {
        hashmap_new()
    }

    fn get(self: Self, key: K) -> Option[V] {
        hashmap_get(self, key)
    }

    fn set(self: Self, key: K, value: V) -> unit {
        hashmap_set(self, key, value)
    }

    fn remove(self: Self, key: K) -> unit {
        hashmap_remove(self, key)
    }

    fn len(self: Self) -> int {
        hashmap_len(self)
    }

    fn contains(self: Self, key: K) -> bool {
        hashmap_contains(self, key)
    }

    fn entries(self: Self) -> Vec[(K, V)] {
        hashmap_entries(self)
    }
}

impl[T] Ref[T] {
    fn new(value: T) -> Self {
        ref(value)
    }

    fn get(self: Self) -> T {
        ref_get(self)
    }

    fn set(self: Self, value: T) -> unit {
        ref_set(self, value)
    }
}

impl[T] Channel[T] {
    fn new(capacity: int) -> Self {
        channel_new(capacity)
    }

    fn send(self: Self, value: T) -> unit {
        channel_send(self, value)
    }

    fn recv(self: Self) -> Option[T] {
        let (value, ok) = channel_recv(self);
        if ok {
            Option::Some(value)
        } else {
            Option::None
        }
    }

    fn close(self: Self) -> unit {
        channel_close(self)
    }
}

#[lang("range")]
fn __goml_builtin_range(start: int, end: int) -> FnIterator[int] {
    let mut current = start;
    FnIterator::from_fn(
        || {
            let value = current;
            if value < end {
                current = value + 1;
                Option::Some(value)
            } else {
                Option::None
            }
        },
    )
}

#[lang("range")]
fn range(start: int, end: int) -> FnIterator[int] {
    __goml_builtin_range(start, end)
}

