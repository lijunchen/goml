package builtin;

fn print[T: ToString](value: T) -> unit {
    string_print(ToString::to_string(value))
}

fn println[T: ToString](value: T) -> unit {
    string_println(ToString::to_string(value))
}

fn char_from_uint32(value: uint32) -> Option[char] {
    let (valid, value) = char_from_uint32_raw(value);
    if valid {
        Option::Some(value)
    } else {
        Option::None
    }
}

impl int {
    fn to_string(self: int) -> string {
        int_to_string(self)
    }
}

impl int32 {
    fn to_string(self: int32) -> string {
        int32_to_string(self)
    }
}

impl char {
    fn to_string(self: char) -> string {
        char_to_string(self)
    }
}

impl string {
    fn len(self: string) -> int {
        string_len(self)
    }

    fn byte_len(self: string) -> int {
        string_len(self)
    }

    fn get(self: string, index: int) -> char {
        string_get(self, index)
    }

    fn byte_get(self: string, index: int) -> byte {
        string_byte_get(self, index)
    }

    fn byte_slice(self: string, start: int, end: int) -> string {
        string_byte_slice(self, start, end)
    }

    fn is_char_boundary(self: string, index: int) -> bool {
        string_is_char_boundary(self, index)
    }

    fn decode_at(self: string, index: int) -> Option[(char, int)] {
        let (valid, value, width) = string_decode_utf8_at(self, index);
        if valid {
            Option::Some((value, width))
        } else {
            Option::None
        }
    }

    fn to_bytes(self: string) -> Vec[byte] {
        string_to_bytes(self)
    }

    fn chars(self: string) -> FnIterator[char] {
        let mut index = 0;
        FnIterator::from_fn(
            || {
                match self.decode_at(index) {
                    Some(decoded) => {
                        let (value, width) = decoded;
                        index += width;
                        Option::Some(value)
                    },
                    None => Option::None,
                }
            },
        )
    }

    fn char_indices(self: string) -> FnIterator[(int, char)] {
        let mut index = 0;
        FnIterator::from_fn(
            || {
                let current = index;
                match self.decode_at(current) {
                    Some(decoded) => {
                        let (value, width) = decoded;
                        index = current + width;
                        Option::Some((current, value))
                    },
                    None => Option::None,
                }
            },
        )
    }
}

