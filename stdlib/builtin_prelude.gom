    }
}

impl[T] FnIterator[T] {
    fn from_fn(next_fn: () -> Option[T]) -> Self {
        FnIterator { next_fn }
    }
}

impl[T] Iterator for FnIterator[T] {
    type Item = T;

    fn next(self: Self) -> Option[T] {
        self.next_fn()
    }
}

impl[I: Iterator] IntoIterator for I {
    type Item = I::Item;

    type IntoIter = I;

    fn into_iter(self: I) -> I {
        self
    }
}

impl[T] Vec[T] {
    fn new() -> Self {
        vec_new()
    }

    fn with_capacity(capacity: int) -> Self {
        vec_with_capacity(capacity)
    }

    fn push(self: Self, elem: T) -> unit {
        vec_push(self, elem)
    }

    fn pushed(self: Self, elem: T) -> Self {
        let result: Vec[T] = Vec::with_capacity(self.len() + 1);
        let mut index = 0;
        while index < self.len() {
            result.push(self[index]);
            index += 1;
        }
        result.push(elem);
        result
    }

    fn get(self: Self, index: int) -> T {
        vec_get(self, index)
    }

    fn set(self: Self, index: int, elem: T) -> unit {
        vec_set(self, index, elem)
    }

    fn len(self: Self) -> int {
        vec_len(self)
    }

    fn capacity(self: Self) -> int {
        vec_capacity(self)
    }

    fn is_empty(self: Self) -> bool {
        vec_len(self) == 0
    }

    fn reserve(self: Self, additional: int) -> unit {
        vec_reserve(self, additional)
    }

    fn truncate(self: Self, len: int) -> unit {
        vec_truncate(self, len)
    }

    fn clear(self: Self) -> unit {
        self.truncate(0)
    }

    fn last(self: Self) -> Option[T] {
        let len = self.len();
        if len == 0 {
            Option::None
        } else {
            Option::Some(self[len - 1])
        }
    }

    fn pop(self: Self) -> Option[T] {
        let len = self.len();
        if len == 0 {
            Option::None
        } else {
            let value = self[len - 1];
            self.truncate(len - 1);
            Option::Some(value)
        }
    }

    fn swap(self: Self, left: int, right: int) -> unit {
        let value = self[left];
        self[left] = self[right];
        self[right] = value;
    }

    fn swap_remove(self: Self, index: int) -> T {
        let len = self.len();
        let value = self[index];
        if index + 1 < len {
            self[index] = self[len - 1];
        } else {};
        self.truncate(len - 1);
        value
    }

    fn insert(self: Self, index: int, value: T) -> unit {
        let len = self.len();
        if index == len {
            self.push(value)
        } else {
            let _ = self[index];
            self.push(self[len - 1]);
            let mut current = len - 1;
            while current > index {
                self[current] = self[current - 1];
                current -= 1;
            }
            self[index] = value;
        }
    }

    fn remove(self: Self, index: int) -> T {
        let len = self.len();
        let value = self[index];
        let mut current = index;
        while current + 1 < len {
            self[current] = self[current + 1];
            current += 1;
        }
        self.truncate(len - 1);
        value
    }

    fn reverse(self: Self) -> unit {
        let mut left = 0;
        let mut right = self.len() - 1;
        while left < right {
            self.swap(left, right);
            left += 1;
            right -= 1;
        }
    }

    fn extend(self: Self, other: Vec[T]) -> unit {
        let len = other.len();
        self.reserve(len);
        let mut index = 0;
        while index < len {
            self.push(other[index]);
            index += 1;
        }
    }

    fn slice(self: Self, start: int, end: int) -> Slice[T] {
        slice(self, start, end)
    }

    fn iter(self: Self) -> FnIterator[T] {
        let mut index = 0;
        let len = self.len();
        FnIterator::from_fn(
            || {
                let current = index;
                if current < len {
                    let value = self[current];
                    index = current + 1;
                    Option::Some(value)
                } else {
                    Option::None
                }
            },
        )
    }
}

impl[T] IntoIterator for Vec[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: Vec[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[T] Slice[T] {
    fn get(self: Self, index: int) -> T {
        slice_get(self, index)
    }

    fn len(self: Self) -> int {
        slice_len(self)
    }

    fn sub(self: Self, start: int, end: int) -> Self {
        slice_sub(self, start, end)
    }

    fn iter(self: Self) -> FnIterator[T] {
        let mut index = 0;
        let len = self.len();
        FnIterator::from_fn(
            || {
                let current = index;
                if current < len {
                    let value = self.get(current);
                    index = current + 1;
                    Option::Some(value)
                } else {
                    Option::None
                }
            },
        )
    }
}

impl[T] IntoIterator for Slice[T] {
    type Item = T;

    type IntoIter = FnIterator[T];

    fn into_iter(self: Slice[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl[K: Hash + Eq, V] HashMap[K, V] {
    fn new() -> Self {
        hashmap_new()
    }

    fn get(self: Self, key: K) -> Option[V] {
        hashmap_get(self, key)
    }

    fn set(self: Self, key: K, value: V) -> unit {
        hashmap_set(self, key, value)
    }

    fn remove(self: Self, key: K) -> unit {
        hashmap_remove(self, key)
    }

    fn len(self: Self) -> int {
        hashmap_len(self)
    }

    fn contains(self: Self, key: K) -> bool {
        hashmap_contains(self, key)
    }

    fn entries(self: Self) -> Vec[(K, V)] {
        hashmap_entries(self)
    }
}

impl[T] Ref[T] {
    fn new(value: T) -> Self {
        ref(value)
    }

    fn get(self: Self) -> T {
        ref_get(self)
    }

    fn set(self: Self, value: T) -> unit {
        ref_set(self, value)
    }
}

impl[T] Channel[T] {
    fn new(capacity: int) -> Self {
        channel_new(capacity)
    }

    fn send(self: Self, value: T) -> unit {
        channel_send(self, value)
    }

    fn recv(self: Self) -> Option[T] {
        let (value, ok) = channel_recv(self);
        if ok {
            Option::Some(value)
        } else {
            Option::None
        }
    }

    fn close(self: Self) -> unit {
        channel_close(self)
    }
}

#[lang("range")]
fn __goml_builtin_range(start: int, end: int) -> FnIterator[int] {
    let mut current = start;
    FnIterator::from_fn(
        || {
            let value = current;
            if value < end {
                current = value + 1;
                Option::Some(value)
            } else {
                Option::None
            }
        },
    )
}

#[lang("range")]
fn range(start: int, end: int) -> FnIterator[int] {
    __goml_builtin_range(start, end)
}

impl ToString for uint {
    fn to_string(self: uint) -> string {
        uint_to_string(self)
    }
}

impl Debug for uint {
    fn debug(self: uint) -> string {
        ToString::to_string(self)
    }
}

impl Eq for uint {
    fn eq(self: uint, other: uint) -> bool {
        __goml_primitive_eq(self, other)
    }
}

impl Hash for uint {
    fn hash(self: uint) -> uint64 {
        uint_hash(self)
    }
}

impl string {
    fn starts_with(self: string, prefix: string) -> bool {
        prefix.byte_len() <= self.byte_len() && self.is_char_boundary(prefix.byte_len())
            && self.byte_slice(0, prefix.byte_len()) == prefix
    }

    fn ends_with(self: string, suffix: string) -> bool {
        if suffix.byte_len() > self.byte_len() {
            false
        } else {
            let start = self.byte_len() - suffix.byte_len();
            self.is_char_boundary(start) && self.byte_slice(start, self.byte_len()) == suffix
        }
    }

    fn contains(self: string, expected: string) -> bool {
        if expected.byte_len() == 0 {
            true
        } else if expected.byte_len() > self.byte_len() {
            false
        } else {
            for start in 0..self.byte_len() - expected.byte_len() + 1 {
                let end = start + expected.byte_len();
                if self.is_char_boundary(start) && self.is_char_boundary(end)
                    && self.byte_slice(start, end) == expected {
                    return true
                } else {}
            }
            false
        }
    }
}

impl[T] Option[T] {
    fn is_some(self: Option[T]) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(self: Option[T]) -> bool {
        !self.is_some()
    }

    fn unwrap_or(self: Option[T], fallback: T) -> T {
        match self {
            Some(value) => value,
            None => fallback,
        }
    }

    fn unwrap_or_else(self: Option[T], fallback: () -> T) -> T {
        match self {
            Some(value) => value,
            None => fallback(),
        }
    }
}

impl[T, E] Result[T, E] {
    fn is_ok(self: Result[T, E]) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn is_err(self: Result[T, E]) -> bool {
        !self.is_ok()
    }

    fn unwrap_or(self: Result[T, E], fallback: T) -> T {
        match self {
            Ok(value) => value,
            Err(_) => fallback,
        }
    }

    fn unwrap_or_else(self: Result[T, E], fallback: (E) -> T) -> T {
        match self {
            Ok(value) => value,
            Err(error) => fallback(error),
        }
    }
}

#[lang("range_inclusive")]
fn __goml_builtin_range_inclusive(start: int, end: int) -> FnIterator[int] {
    let mut current = start;
    let mut finished = false;
    FnIterator::from_fn(
        || {
            if finished || current > end {
                Option::None
            } else {
                let value = current;
                if value == end {
                    finished = true;
                } else {
                    current = value + 1;
                };
                Option::Some(value)
            }
        },
    )
}

impl[T] Option[T] {
    fn map[U](self: Option[T], map_fn: (T) -> U) -> Option[U] {
        match self {
            Some(value) => Option::Some(map_fn(value)),
            None => Option::None,
        }
    }

    fn and_then[U](self: Option[T], next: (T) -> Option[U]) -> Option[U] {
        match self {
            Some(value) => next(value),
            None => Option::None,
        }
    }

    fn ok_or[E](self: Option[T], error: E) -> Result[T, E] {
        match self {
            Some(value) => Result::Ok(value),
            None => Result::Err(error),
        }
    }
}

impl[T, E] Result[T, E] {
    fn map[U](self: Result[T, E], map_fn: (T) -> U) -> Result[U, E] {
        match self {
            Ok(value) => Result::Ok(map_fn(value)),
            Err(error) => Result::Err(error),
        }
    }

    fn map_err[F](self: Result[T, E], map_fn: (E) -> F) -> Result[T, F] {
        match self {
            Ok(value) => Result::Ok(value),
            Err(error) => Result::Err(map_fn(error)),
        }
    }

    fn and_then[U](self: Result[T, E], next: (T) -> Result[U, E]) -> Result[U, E] {
        match self {
            Ok(value) => next(value),
            Err(error) => Result::Err(error),
        }
    }
}
