package builtin;

#[runtime("core.string_get")]
extern fn string_get_raw(value: string, index: int) -> char;

#[runtime("core.string_byte_slice")]
extern fn string_byte_slice_raw(value: string, start: int, end: int) -> string;

#[runtime("core.string_from_utf8")]
extern fn string_from_utf8_raw(bytes: Vec[byte]) -> (bool, string);

#[runtime("core.char_to_string")]
extern fn char_to_string_raw(value: char) -> string;

fn utf8_invalid_decode() -> (bool, char, int) {
    (false, '\u0000', 0)
}

fn utf8_valid_decode(value: uint32, width: int) -> (bool, char, int) {
    match char_from_uint32(value) {
        Some(character) => (true, character, width),
        None => utf8_invalid_decode(),
    }
}

fn utf8_invalid_continuation(value: uint32) -> bool {
    value < 128 || value > 191
}

fn utf8_valid_scalar(value: uint32) -> bool {
    value <= 1114111 && !(value >= 55296 && value <= 57343)
}

fn string_decode_utf8_at(value: string, index: int) -> (bool, char, int) {
    let length = value.byte_len();
    if index < 0 || index >= length {
        return utf8_invalid_decode()
    } else {};
    let first = value.byte_get(index) as uint32;
    if first < 128 {
        utf8_valid_decode(first, 1)
    } else if first < 194 {
        utf8_invalid_decode()
    } else if first < 224 {
        if length - index < 2 {
            return utf8_invalid_decode()
        } else {};
        let second = value.byte_get(index + 1) as uint32;
        if utf8_invalid_continuation(second) {
            utf8_invalid_decode()
        } else {
            utf8_valid_decode(((first & 31) << 6) | (second & 63), 2)
        }
    } else if first < 240 {
        if length - index < 3 {
            return utf8_invalid_decode()
        } else {};
        let second = value.byte_get(index + 1) as uint32;
        let third = value.byte_get(index + 2) as uint32;
        if utf8_invalid_continuation(second) || utf8_invalid_continuation(third)
            || (first == 224 && second < 160)
            || (first == 237 && second >= 160) {
            utf8_invalid_decode()
        } else {
            utf8_valid_decode(((first & 15) << 12) | ((second & 63) << 6) | (third & 63), 3)
        }
    } else if first < 245 {
        if length - index < 4 {
            return utf8_invalid_decode()
        } else {};
        let second = value.byte_get(index + 1) as uint32;
        let third = value.byte_get(index + 2) as uint32;
        let fourth = value.byte_get(index + 3) as uint32;
        if utf8_invalid_continuation(second) || utf8_invalid_continuation(third)
            || utf8_invalid_continuation(fourth)
            || (first == 240 && second < 144)
            || (first == 244 && second > 143) {
            utf8_invalid_decode()
        } else {
            utf8_valid_decode(
                ((first & 7) << 18) | ((second & 63) << 12) | ((third & 63) << 6) | (fourth & 63),
                4,
            )
        }
    } else {
        utf8_invalid_decode()
    }
}

fn string_is_char_boundary(value: string, index: int) -> bool {
    if index < 0 || index > value.byte_len() {
        false
    } else if index == value.byte_len() {
        true
    } else {
        (value.byte_get(index) & 192) != 128
    }
}

fn string_get(value: string, index: int) -> char {
    let (valid, character, _) = string_decode_utf8_at(value, index);
    if valid {
        character
    } else {
        string_get_raw("", -1)
    }
}

fn string_byte_slice(value: string, start: int, end: int) -> string {
    if string_is_char_boundary(value, start) && string_is_char_boundary(value, end) {
        string_byte_slice_raw(value, start, end)
    } else {
        string_byte_slice_raw(value, -1, -1)
    }
}

fn string_from_utf8(bytes: Vec[byte]) -> (bool, string) {
    let (_, value) = string_from_utf8_raw(bytes);
    let mut index = 0;
    while index < value.byte_len() {
        let (valid, _, width) = string_decode_utf8_at(value, index);
        if valid {
            index += width;
        } else {
            return (false, "")
        }
    };
    (true, value)
}

fn char_to_string(value: char) -> string {
    if utf8_valid_scalar(value as uint32) {
        char_to_string_raw(value)
    } else {
        let _ = string_get_raw("", -1);
        ""
    }
}

fn print[T: ToString](value: T) -> unit {
    string_print(ToString::to_string(value))
}

fn println[T: ToString](value: T) -> unit {
    string_println(ToString::to_string(value))
}

fn char_from_uint32(value: uint32) -> Option[char] {
    if utf8_valid_scalar(value) {
        let (_, character) = char_from_uint32_raw(value);
        Option::Some(character)
    } else {
        Option::None
    }
}

impl int {
    fn to_string(self: int) -> string {
        int_to_string(self)
    }
}

impl int32 {
    fn to_string(self: int32) -> string {
        int32_to_string(self)
    }
}

impl char {
    fn to_string(self: char) -> string {
        char_to_string(self)
    }
}

impl string {
    fn len(self: string) -> int {
        string_len(self)
    }

    fn byte_len(self: string) -> int {
        string_len(self)
    }

    fn get(self: string, index: int) -> char {
        string_get(self, index)
    }

    fn byte_get(self: string, index: int) -> byte {
        string_byte_get(self, index)
    }

    fn byte_slice(self: string, start: int, end: int) -> string {
        string_byte_slice(self, start, end)
    }

    fn is_char_boundary(self: string, index: int) -> bool {
        string_is_char_boundary(self, index)
    }

    fn decode_at(self: string, index: int) -> Option[(char, int)] {
        let (valid, value, width) = string_decode_utf8_at(self, index);
        if valid {
            Option::Some((value, width))
        } else {
            Option::None
        }
    }

    fn to_bytes(self: string) -> Vec[byte] {
        string_to_bytes(self)
    }

    fn chars(self: string) -> FnIterator[char] {
        let mut index = 0;
        FnIterator::from_fn(
            || {
                match self.decode_at(index) {
                    Some(decoded) => {
                        let (value, width) = decoded;
                        index += width;
                        Option::Some(value)
                    },
                    None => Option::None,
                }
            },
        )
    }

    fn char_indices(self: string) -> FnIterator[(int, char)] {
        let mut index = 0;
        FnIterator::from_fn(
            || {
                let current = index;
                match self.decode_at(current) {
                    Some(decoded) => {
                        let (value, width) = decoded;
                        index = current + width;
                        Option::Some((current, value))
                    },
                    None => Option::None,
                }
            },
        )
    }
}

