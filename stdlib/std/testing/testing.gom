package testing;

use std::internal::host;

pub fn fail(message: string) -> unit {
    host::test_fail(message)
}

pub fn assert(condition: bool) -> unit {
    if condition {} else {
        fail("assertion failed")
    }
}

pub fn assert_eq[T: PartialEq + Debug](actual: T, expected: T) -> unit {
    if PartialEq::eq(actual, expected) {} else {
        fail(
            "assertion failed: values are not equal\n  actual: " + Debug::debug(actual)
                + "\nexpected: "
                + Debug::debug(expected),
        )
    }
}

pub fn assert_ne[T: PartialEq + Debug](actual: T, expected: T) -> unit {
    if PartialEq::eq(actual, expected) {
        fail("assertion failed: values are equal\nvalue: " + Debug::debug(actual))
    } else {}
}
