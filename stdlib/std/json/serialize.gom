package json;

use std::serde;
pub use serde::{Deserialize, Serialize};

fn serde_fields_to_json(fields: Vec[(string, serde::Value)]) -> Vec[(string, Value)] {
    let result: Vec[(string, Value)] = Vec::with_capacity(fields.len());
    for field in fields {
        result.push((field.0, from_serde_value(field.1)))
    }
    result
}

fn serde_items_to_json(items: Vec[serde::Value]) -> Vec[Value] {
    let result: Vec[Value] = Vec::with_capacity(items.len());
    for item in items {
        result.push(from_serde_value(item))
    }
    result
}

fn serde_optional_to_json(items: Vec[serde::Value]) -> Value {
    if items.len() == 0 {
        Value::Null
    } else {
        from_serde_value(items[0])
    }
}

fn serde_variant_to_json(name: string, kind: int, fields: Vec[(string, serde::Value)]) -> Value {
    if kind == 0 {
        Value::String(name)
    } else if kind == 1 {
        let values: Vec[Value] = Vec::with_capacity(fields.len());
        for field in fields {
            values.push(from_serde_value(field.1))
        }
        Value::Object(Vec::[(name, Value::Array(values))])
    } else {
        Value::Object(Vec::[(name, Value::Object(serde_fields_to_json(fields)))])
    }
}

pub fn from_serde_value(value: serde::Value) -> Value {
    match value {
        serde::Value::Unit => Value::Null,
        serde::Value::Bool(value) => Value::Bool(value),
        serde::Value::Int(value) => Value::Number(value.to_string()),
        serde::Value::Int8(value) => Value::Number(value.to_string()),
        serde::Value::Int16(value) => Value::Number(value.to_string()),
        serde::Value::Int32(value) => Value::Number(value.to_string()),
        serde::Value::Int64(value) => Value::Number(value.to_string()),
        serde::Value::Uint(value) => Value::Number(value.to_string()),
        serde::Value::Uint8(value) => Value::Number(value.to_string()),
        serde::Value::Uint16(value) => Value::Number(value.to_string()),
        serde::Value::Uint32(value) => Value::Number(value.to_string()),
        serde::Value::Uint64(value) => Value::Number(value.to_string()),
        serde::Value::Float32(value) => Value::Number(value.to_string()),
        serde::Value::Float64(value) => Value::Number(value.to_string()),
        serde::Value::Number(value) => Value::Number(value),
        serde::Value::String(value) => Value::String(value),
        serde::Value::Char(value) => Value::String(value.to_string()),
        serde::Value::Sequence(items) => Value::Array(serde_items_to_json(items)),
        serde::Value::Tuple(items) => Value::Array(serde_items_to_json(items)),
        serde::Value::Optional(items) => serde_optional_to_json(items),
        serde::Value::Struct(fields) => Value::Object(serde_fields_to_json(fields)),
        serde::Value::Variant { index: _, name, kind, fields } => {
            serde_variant_to_json(name, kind, fields)
        },
    }
}

fn json_fields_to_serde(fields: Vec[(string, Value)]) -> Vec[(string, serde::Value)] {
    let result: Vec[(string, serde::Value)] = Vec::with_capacity(fields.len());
    for field in fields {
        result.push((field.0, into_serde_value(field.1)))
    }
    result
}

fn json_items_to_serde(items: Vec[Value]) -> Vec[serde::Value] {
    let result: Vec[serde::Value] = Vec::with_capacity(items.len());
    for item in items {
        result.push(into_serde_value(item))
    }
    result
}

pub fn into_serde_value(value: Value) -> serde::Value {
    match value {
        Value::Object(fields) => serde::Value::Struct(json_fields_to_serde(fields)),
        Value::Array(items) => serde::Value::Sequence(json_items_to_serde(items)),
        Value::String(value) => serde::Value::String(value),
        Value::Number(value) => serde::Value::Number(value),
        Value::Bool(value) => serde::Value::Bool(value),
        Value::Null => serde::Value::Unit,
    }
}

pub fn to_value[T: Serialize](value: T) -> Value {
    from_serde_value(serde::to_value(value))
}

pub fn from_value[T: Deserialize](value: Value) -> Result[T, string] {
    serde::from_value(into_serde_value(value))
}

pub fn stringify[T: Serialize](value: T) -> string {
    encode(to_value(value))
}

pub fn to_string[T: Serialize](value: T) -> string {
    stringify(value)
}

pub fn from_string[T: Deserialize](input: string) -> Result[T, string] {
    let value = parse(input)?;
    from_value(value)
}

impl Serialize for Value {
    fn serialize(self: Value) -> serde::Value {
        into_serde_value(self)
    }
}

impl Deserialize for Value {
    fn deserialize(value: serde::Value) -> Result[Value, string] {
        Result::Ok(from_serde_value(value))
    }

    fn schema() -> serde::TypedSchema[Value] {
        serde::typed_schema(serde::Schema::Any)
    }
}
