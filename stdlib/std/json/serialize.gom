package json;

pub trait Serialize {
    fn serialize(self: Self) -> Value;
}

pub fn array(items: Vec[Value]) -> Value {
    Value::Array(items)
}

pub fn string_value(value: string) -> Value {
    Value::String(value)
}

pub fn variant(name: string, value: Value) -> Value {
    Value::Object(Vec::[(name, value)])
}

pub fn stringify[T: Serialize](value: T) -> string {
    encode(value.serialize())
}

impl Serialize for Value {
    fn serialize(self: Value) -> Value {
        self
    }
}

impl Serialize for unit {
    fn serialize(self: unit) -> Value {
        Value::Null
    }
}

impl Serialize for bool {
    fn serialize(self: bool) -> Value {
        Value::Bool(self)
    }
}

impl Serialize for string {
    fn serialize(self: string) -> Value {
        Value::String(self)
    }
}

impl Serialize for char {
    fn serialize(self: char) -> Value {
        Value::String(self.to_string())
    }
}

impl Serialize for int {
    fn serialize(self: int) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for int8 {
    fn serialize(self: int8) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for int16 {
    fn serialize(self: int16) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for int32 {
    fn serialize(self: int32) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for int64 {
    fn serialize(self: int64) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for uint {
    fn serialize(self: uint) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for uint8 {
    fn serialize(self: uint8) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for uint16 {
    fn serialize(self: uint16) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for uint32 {
    fn serialize(self: uint32) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for uint64 {
    fn serialize(self: uint64) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for float32 {
    fn serialize(self: float32) -> Value {
        Value::Number(self.to_string())
    }
}

impl Serialize for float64 {
    fn serialize(self: float64) -> Value {
        Value::Number(self.to_string())
    }
}

impl[T: Serialize] Serialize for Vec[T] {
    fn serialize(self: Vec[T]) -> Value {
        let items: Vec[Value] = Vec::[];
        for item in self {
            items.push(item.serialize())
        }
        Value::Array(items)
    }
}

impl[T: Serialize] Serialize for Option[T] {
    fn serialize(self: Option[T]) -> Value {
        match self {
            Some(value) => value.serialize(),
            None => Value::Null,
        }
    }
}

impl[A: Serialize, B: Serialize] Serialize for (A, B) {
    fn serialize(self: (A, B)) -> Value {
        Value::Array(Vec::[self.0.serialize(), self.1.serialize()])
    }
}

impl[A: Serialize, B: Serialize, C: Serialize] Serialize for (A, B, C) {
    fn serialize(self: (A, B, C)) -> Value {
        Value::Array(Vec::[self.0.serialize(), self.1.serialize(), self.2.serialize()])
    }
}

#[comptime_derive]
fn serialize_expr_list() -> MetaExprList {
    meta_expr_list_new()
}

#[comptime_derive]
fn serialize_expr_list_one(value: MetaExpr) -> MetaExprList {
    let values = serialize_expr_list();
    meta_expr_list_push(values, value);
    values
}

#[comptime_derive]
fn serialize_expr_list_two(first: MetaExpr, second: MetaExpr) -> MetaExprList {
    let values = serialize_expr_list_one(first);
    meta_expr_list_push(values, second);
    values
}

#[comptime_derive]
fn serialize_type_seen(input: DeriveInput, variant: int, field: int, ty: MetaType) -> bool {
    if derive_item_kind(input) == 0 {
        let mut previous = 0;
        while previous < field {
            if meta_type_equal(derive_field_type(input, previous), ty) {
                return true
            } else {};
            previous = previous + 1;
        }
    } else {
        let mut previous_variant = 0;
        while previous_variant < variant {
            let mut previous_field = 0;
            while previous_field < derive_variant_field_count(input, previous_variant) {
                if meta_type_equal(
                    derive_variant_field_type(input, previous_variant, previous_field),
                    ty,
                ) {
                    return true
                } else {};
                previous_field = previous_field + 1;
            }
            previous_variant = previous_variant + 1;
        }
        let mut previous_field = 0;
        while previous_field < field {
            if meta_type_equal(derive_variant_field_type(input, variant, previous_field), ty) {
                return true
            } else {};
            previous_field = previous_field + 1;
        }
    };
    false
}

#[comptime_derive]
fn serialize_add_predicates(input: DeriveInput, output: DeriveOutput) -> unit {
    if derive_item_kind(input) == 0 {
        let mut field = 0;
        while field < derive_field_count(input) {
            let ty = derive_field_type(input, field);
            if meta_type_contains_generic(input, ty) && !serialize_type_seen(input, 0, field, ty) {
                derive_output_add_predicate(output, ty, "Serialize")
            } else {};
            field = field + 1;
        }
    } else {
        let mut variant = 0;
        while variant < derive_variant_count(input) {
            let mut field = 0;
            while field < derive_variant_field_count(input, variant) {
                let ty = derive_variant_field_type(input, variant, field);
                if meta_type_contains_generic(input, ty)
                    && !serialize_type_seen(input, variant, field, ty) {
                    derive_output_add_predicate(output, ty, "Serialize")
                } else {};
                field = field + 1;
            }
            variant = variant + 1;
        }
    }
}

#[comptime_derive]
fn serialize_value(input: DeriveInput, value: MetaExpr) -> MetaExpr {
    meta_expr_trait_call(input, "Serialize", "serialize", serialize_expr_list_one(value))
}

#[comptime_derive]
fn serialize_new_vec() -> MetaExpr {
    meta_expr_call_site("vec_new", serialize_expr_list())
}

#[comptime_derive]
fn serialize_push(target: MetaExpr, value: MetaExpr) -> MetaExpr {
    meta_expr_call_site("vec_push", serialize_expr_list_two(target, value))
}

#[comptime_derive]
fn serialize_pair(name: string, value: MetaExpr) -> MetaExpr {
    meta_expr_tuple(serialize_expr_list_two(meta_expr_string(name), value))
}

#[comptime_derive]
fn serialize_definition_call(input: DeriveInput, name: string, value: MetaExpr) -> MetaExpr {
    meta_expr_call(input, name, serialize_expr_list_one(value))
}

#[comptime_derive]
fn serialize_variant_call(input: DeriveInput, name: string, value: MetaExpr) -> MetaExpr {
    meta_expr_call(input, "variant", serialize_expr_list_two(meta_expr_string(name), value))
}

#[comptime_derive]
fn serialize_struct_body(input: DeriveInput) -> MetaExpr {
    let block = meta_block_new();
    let fields = derive_fresh_name(input, "json_fields");
    meta_block_let(block, fields, serialize_new_vec());
    let mut field = 0;
    while field < derive_field_count(input) {
        let name = derive_field_name(input, field);
        meta_block_expr(
            block,
            serialize_push(
                meta_expr_var(fields),
                serialize_pair(
                    name,
                    serialize_value(input, meta_expr_field(meta_expr_var("self"), name)),
                ),
            ),
        );
        field = field + 1;
    }
    meta_block_finish(block, serialize_definition_call(input, "object", meta_expr_var(fields)))
}

#[comptime_derive]
fn serialize_enum_body(input: DeriveInput) -> MetaExpr {
    let item_name = derive_item_name(input);
    let arms = meta_arm_list_new();
    let mut variant_index = 0;
    while variant_index < derive_variant_count(input) {
        let name = derive_variant_name(input, variant_index);
        let kind = derive_variant_kind(input, variant_index);
        let positional = meta_pattern_list_new();
        let named = meta_pattern_field_list_new();
        let block = meta_block_new();
        let values = derive_fresh_name(input, "json_values");
        if kind == 0 {} else {
            meta_block_let(block, values, serialize_new_vec())
        };
        let mut field = 0;
        while field < derive_variant_field_count(input, variant_index) {
            let binding = derive_fresh_name(input, "json_field");
            if kind == 2 {
                meta_pattern_field_list_push(
                    named,
                    derive_variant_field_name(input, variant_index, field),
                    meta_pattern_bind(binding),
                )
            } else {
                meta_pattern_list_push(positional, meta_pattern_bind(binding))
            };
            let value = serialize_value(input, meta_expr_var(binding));
            meta_block_expr(
                block,
                serialize_push(
                    meta_expr_var(values),
                    if kind == 2 {
                        serialize_pair(
                            derive_variant_field_name(input, variant_index, field),
                            value,
                        )
                    } else {
                        value
                    },
                ),
            );
            field = field + 1;
        }
        let constructor = item_name + "::" + name;
        let pattern = if kind == 2 {
            meta_pattern_struct(constructor, named, false)
        } else {
            meta_pattern_constructor(constructor, positional)
        };
        let body = if kind == 0 {
            serialize_definition_call(input, "string_value", meta_expr_string(name))
        } else {
            let payload = if kind == 2 {
                serialize_definition_call(input, "object", meta_expr_var(values))
            } else {
                serialize_definition_call(input, "array", meta_expr_var(values))
            };
            meta_block_finish(block, serialize_variant_call(input, name, payload))
        };
        meta_arm_list_push(arms, meta_arm(pattern, body));
        variant_index = variant_index + 1;
    }
    meta_expr_match(meta_expr_var("self"), arms)
}

#[comptime_derive(Serialize)]
pub fn derive_serialize(input: DeriveInput) -> DeriveOutput {
    let output = derive_output_new(input, "Serialize");
    serialize_add_predicates(input, output);
    let params = meta_param_list_new();
    meta_param_list_push(params, "self", derive_target_type(input));
    let body = if derive_item_kind(input) == 0 {
        serialize_struct_body(input)
    } else {
        serialize_enum_body(input)
    };
    derive_output_add_method(
        output,
        meta_method("serialize", params, meta_type_named(input, "Value"), body),
    );
    output
}
