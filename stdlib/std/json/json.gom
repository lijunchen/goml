package json;

use std::text;

pub enum Value {
    Object(Vec[(string, Value)]),
    Array(Vec[Value]),
    String(string),
    Number(string),
    Bool(bool),
    Null,
}

struct JsonParser {
    input: string,
    index: Ref[int],
}

fn json_parser(input: string) -> JsonParser {
    JsonParser { input, index: Ref::new(0) }
}

fn json_error(value: JsonParser, message: string) -> string {
    f"{message} at byte {value.index.get()}"
}

fn json_whitespace(value: byte) -> bool {
    value == b'\t' || value == b'\n' || value == b'\r' || value == b' '
}

fn skip_json_whitespace(value: JsonParser) -> unit {
    while value.index.get() < value.input.byte_len()
        && json_whitespace(value.input.byte_get(value.index.get())) {
        value.index.set(value.index.get() + 1)
    }
}

fn hex_digit(value: byte) -> Option[uint32] {
    if value >= b'0' && value <= b'9' {
        Option::Some((value - b'0') as uint32)
    } else if value >= b'A' && value <= b'F' {
        Option::Some((value - b'A' + 10) as uint32)
    } else if value >= b'a' && value <= b'f' {
        Option::Some((value - b'a' + 10) as uint32)
    } else {
        Option::None
    }
}

fn parse_hex_quad(value: JsonParser) -> Result[uint32, string] {
    if value.index.get() + 4 > value.input.byte_len() {
        Result::Err(json_error(value, "incomplete unicode escape"))
    } else {
        let mut result = 0 as uint32;
        for offset in 0..4 {
            match hex_digit(value.input.byte_get(value.index.get() + offset)) {
                Some(digit) => {
                    result = result * 16 + digit;
                },
                None => {
                    return Result::Err(json_error(value, "invalid unicode escape"))
                },
            }
        };
        value.index.set(value.index.get() + 4);
        Result::Ok(result)
    }
}

fn write_codepoint(value: JsonParser, builder: text::StringBuilder, codepoint: uint32) -> Result[
    unit,
    string,
] {
    match char_from_uint32(codepoint) {
        Some(character) => {
            builder.write_char(character);
            Result::Ok(())
        },
        None => Result::Err(json_error(value, "invalid unicode codepoint")),
    }
}

fn parse_unicode_escape(value: JsonParser, builder: text::StringBuilder) -> Result[unit, string] {
    let first = parse_hex_quad(value)?;
    if first >= 55296 && first <= 56319 {
        if value.index.get() + 2 > value.input.byte_len()
            || value.input.byte_get(value.index.get()) != b'\\'
            || value.input.byte_get(value.index.get() + 1) != b'u' {
            Result::Err(json_error(value, "missing low surrogate"))
        } else {
            value.index.set(value.index.get() + 2);
            let second = parse_hex_quad(value)?;
            if second < 56320 || second > 57343 {
                Result::Err(json_error(value, "invalid low surrogate"))
            } else {
                write_codepoint(value, builder, 65536 + (first - 55296) * 1024 + second - 56320)
            }
        }
    } else if first >= 56320 && first <= 57343 {
        Result::Err(json_error(value, "unexpected low surrogate"))
    } else {
        write_codepoint(value, builder, first)
    }
}

fn parse_json_string(value: JsonParser) -> Result[string, string] {
    if value.index.get() >= value.input.byte_len()
        || value.input.byte_get(value.index.get()) != b'"' {
        return Result::Err(json_error(value, "expected string"))
    } else {
        value.index.set(value.index.get() + 1)
    };
    let builder = text::StringBuilder::new();
    let mut segment = value.index.get();
    while value.index.get() < value.input.byte_len() {
        let byte = value.input.byte_get(value.index.get());
        if byte == b'"' {
            if segment < value.index.get() {
                builder.write_string(value.input.byte_slice(segment, value.index.get()))
            } else {
                ()
            };
            value.index.set(value.index.get() + 1);
            return Result::Ok(builder.finish())
        } else if byte == b'\\' {
            if segment < value.index.get() {
                builder.write_string(value.input.byte_slice(segment, value.index.get()))
            } else {
                ()
            };
            value.index.set(value.index.get() + 1);
            if value.index.get() >= value.input.byte_len() {
                return Result::Err(json_error(value, "incomplete escape"))
            } else {
                ()
            };
            let escape = value.input.byte_get(value.index.get());
            value.index.set(value.index.get() + 1);
            if escape == b'"' {
                builder.write_char('"')
            } else if escape == b'\\' {
                builder.write_char('\\')
            } else if escape == b'/' {
                builder.write_char('/')
            } else if escape == b'b' {
                match char_from_uint32(8) {
                    Some(character) => builder.write_char(character),
                    None => (),
                }
            } else if escape == b'f' {
                match char_from_uint32(12) {
                    Some(character) => builder.write_char(character),
                    None => (),
                }
            } else if escape == b'n' {
                builder.write_char('\n')
            } else if escape == b'r' {
                builder.write_char('\r')
            } else if escape == b't' {
                builder.write_char('\t')
            } else if escape == b'u' {
                parse_unicode_escape(value, builder)?
            } else {
                return Result::Err(json_error(value, "invalid escape"))
            };
            segment = value.index.get();
        } else if byte < b' ' {
            return Result::Err(json_error(value, "unescaped control character"))
        } else {
            value.index.set(value.index.get() + 1)
        }
    };
    Result::Err(json_error(value, "unterminated string"))
}

fn json_digit(value: byte) -> bool {
    value >= b'0' && value <= b'9'
}

fn parse_digits(value: JsonParser) -> bool {
    let start = value.index.get();
    while value.index.get() < value.input.byte_len()
        && json_digit(value.input.byte_get(value.index.get())) {
        value.index.set(value.index.get() + 1)
    };
    value.index.get() > start
}

fn parse_json_number(value: JsonParser) -> Result[Value, string] {
    let start = value.index.get();
    if value.input.byte_get(value.index.get()) == b'-' {
        value.index.set(value.index.get() + 1)
    } else {
        ()
    };
    if value.index.get() >= value.input.byte_len() {
        return Result::Err(json_error(value, "incomplete number"))
    } else if value.input.byte_get(value.index.get()) == b'0' {
        value.index.set(value.index.get() + 1);
        if value.index.get() < value.input.byte_len()
            && json_digit(value.input.byte_get(value.index.get())) {
            return Result::Err(json_error(value, "invalid leading zero"))
        } else {
            ()
        }
    } else if !parse_digits(value) {
        return Result::Err(json_error(value, "expected number"))
    } else {
        ()
    };
    if value.index.get() < value.input.byte_len() && value.input.byte_get(value.index.get()) == b'.' {
        value.index.set(value.index.get() + 1);
        if !parse_digits(value) {
            return Result::Err(json_error(value, "missing fraction digits"))
        } else {
            ()
        }
    } else {
        ()
    };
    if value.index.get() < value.input.byte_len()
        && (value.input.byte_get(value.index.get()) == b'e'
            || value.input.byte_get(value.index.get()) == b'E') {
        value.index.set(value.index.get() + 1);
        if value.index.get() < value.input.byte_len()
            && (value.input.byte_get(value.index.get()) == b'+'
                || value.input.byte_get(value.index.get()) == b'-') {
            value.index.set(value.index.get() + 1)
        } else {
            ()
        };
        if !parse_digits(value) {
            return Result::Err(json_error(value, "missing exponent digits"))
        } else {
            ()
        }
    } else {
        ()
    };
    Result::Ok(Value::Number(value.input.byte_slice(start, value.index.get())))
}

fn parse_json_literal(value: JsonParser, expected: string, result: Value) -> Result[Value, string] {
    if value.index.get() + expected.byte_len() <= value.input.byte_len()
        && value.input.byte_slice(value.index.get(), value.index.get() + expected.byte_len())
            == expected {
        value.index.set(value.index.get() + expected.byte_len());
        Result::Ok(result)
    } else {
        Result::Err(json_error(value, "invalid literal"))
    }
}

fn parse_json_array(value: JsonParser) -> Result[Value, string] {
    value.index.set(value.index.get() + 1);
    skip_json_whitespace(value);
    let result: Vec[Value] = Vec::[];
    if value.index.get() < value.input.byte_len() && value.input.byte_get(value.index.get()) == b']' {
        value.index.set(value.index.get() + 1);
        return Result::Ok(Value::Array(result))
    } else {
        ()
    };
    while value.index.get() < value.input.byte_len() {
        let item = parse_json_value(value)?;
        result.push(item);
        skip_json_whitespace(value);
        if value.index.get() >= value.input.byte_len() {
            return Result::Err(json_error(value, "unterminated array"))
        } else if value.input.byte_get(value.index.get()) == b']' {
            value.index.set(value.index.get() + 1);
            return Result::Ok(Value::Array(result))
        } else if value.input.byte_get(value.index.get()) == b',' {
            value.index.set(value.index.get() + 1);
            skip_json_whitespace(value)
        } else {
            return Result::Err(json_error(value, "expected array separator"))
        }
    };
    Result::Err(json_error(value, "unterminated array"))
}

fn parse_json_object(value: JsonParser) -> Result[Value, string] {
    value.index.set(value.index.get() + 1);
    skip_json_whitespace(value);
    let result: Vec[(string, Value)] = Vec::[];
    if value.index.get() < value.input.byte_len() && value.input.byte_get(value.index.get()) == b'}' {
        value.index.set(value.index.get() + 1);
        return Result::Ok(Value::Object(result))
    } else {
        ()
    };
    while value.index.get() < value.input.byte_len() {
        let name = parse_json_string(value)?;
        skip_json_whitespace(value);
        if value.index.get() >= value.input.byte_len()
            || value.input.byte_get(value.index.get()) != b':' {
            return Result::Err(json_error(value, "expected object colon"))
        } else {
            value.index.set(value.index.get() + 1)
        };
        skip_json_whitespace(value);
        let item = parse_json_value(value)?;
        result.push((name, item));
        skip_json_whitespace(value);
        if value.index.get() >= value.input.byte_len() {
            return Result::Err(json_error(value, "unterminated object"))
        } else if value.input.byte_get(value.index.get()) == b'}' {
            value.index.set(value.index.get() + 1);
            return Result::Ok(Value::Object(result))
        } else if value.input.byte_get(value.index.get()) == b',' {
            value.index.set(value.index.get() + 1);
            skip_json_whitespace(value)
        } else {
            return Result::Err(json_error(value, "expected object separator"))
        }
    };
    Result::Err(json_error(value, "unterminated object"))
}

fn parse_json_value(value: JsonParser) -> Result[Value, string] {
    skip_json_whitespace(value);
    if value.index.get() >= value.input.byte_len() {
        Result::Err(json_error(value, "expected JSON value"))
    } else {
        match value.input.byte_get(value.index.get()) {
            b'{' => parse_json_object(value),
            b'[' => parse_json_array(value),
            b'"' => match parse_json_string(value) {
                Ok(text) => Result::Ok(String(text)),
                Err(error) => Result::Err(error),
            },
            b't' => parse_json_literal(value, "true", Bool(true)),
            b'f' => parse_json_literal(value, "false", Bool(false)),
            b'n' => parse_json_literal(value, "null", Null),
            byte => if byte == b'-' || json_digit(byte) {
                parse_json_number(value)
            } else {
                Result::Err(json_error(value, "unexpected JSON token"))
            },
        }
    }
}

pub fn parse(input: string) -> Result[Value, string] {
    let parser = json_parser(input);
    let result = parse_json_value(parser)?;
    skip_json_whitespace(parser);
    if parser.index.get() == input.byte_len() {
        Result::Ok(result)
    } else {
        Result::Err(json_error(parser, "trailing JSON data"))
    }
}

fn json_hex_digit(value: byte) -> char {
    "0123456789abcdef".get(value as int)
}

fn write_json_string(builder: text::StringBuilder, value: string) -> unit {
    builder.write_char('"');
    let mut start = 0;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if byte == b'"' || byte == b'\\' || byte == b'\b' || byte == b'\t' || byte == b'\n'
            || byte == b'\f'
            || byte == b'\r'
            || byte < b' ' {
            if start < index {
                builder.write_string(value.byte_slice(start, index))
            } else {
                ()
            };
            if byte == b'"' {
                builder.write_string("\\\"")
            } else if byte == b'\\' {
                builder.write_string("\\\\")
            } else if byte == b'\b' {
                builder.write_string("\\b")
            } else if byte == b'\t' {
                builder.write_string("\\t")
            } else if byte == b'\n' {
                builder.write_string("\\n")
            } else if byte == b'\f' {
                builder.write_string("\\f")
            } else if byte == b'\r' {
                builder.write_string("\\r")
            } else {
                builder.write_string("\\u00");
                builder.write_char(json_hex_digit(byte / 16));
                builder.write_char(json_hex_digit(byte % 16))
            };
            start = index + 1;
        } else {
            ()
        }
    };
    if start < value.byte_len() {
        builder.write_string(value.byte_slice(start, value.byte_len()))
    } else {
        ()
    };
    builder.write_char('"')
}

fn write_json_value(builder: text::StringBuilder, value: Value) -> unit {
    match value {
        Object(fields) => {
            builder.write_char('{');
            let mut index = 0;
            for field in fields {
                if index > 0 {
                    builder.write_char(',')
                } else {
                    ()
                };
                write_json_string(builder, field.0);
                builder.write_char(':');
                write_json_value(builder, field.1);
                index += 1;
            };
            builder.write_char('}')
        },
        Array(items) => {
            builder.write_char('[');
            let mut index = 0;
            for item in items {
                if index > 0 {
                    builder.write_char(',')
                } else {
                    ()
                };
                write_json_value(builder, item);
                index += 1;
            };
            builder.write_char(']')
        },
        String(text) => write_json_string(builder, text),
        Number(number) => builder.write_string(number),
        Bool(value) => builder.write_string(
            if value {
                "true"
            } else {
                "false"
            },
        ),
        Null => builder.write_string("null"),
    }
}

pub fn encode(value: Value) -> string {
    let builder = text::StringBuilder::new();
    write_json_value(builder, value);
    builder.finish()
}

pub fn field(value: Value, name: string) -> Option[Value] {
    match value {
        Object(fields) => {
            for field in fields {
                if field.0 == name {
                    return Option::Some(field.1)
                } else {
                    ()
                }
            };
            Option::None
        },
        _ => Option::None,
    }
}

pub fn as_string(value: Value) -> Option[string] {
    match value {
        String(text) => Option::Some(text),
        _ => Option::None,
    }
}

fn parse_json_int_text(value: string) -> Option[int] {
    if value.byte_len() == 0 {
        Option::None
    } else {
        let negative = value.byte_get(0) == b'-';
        let mut index = if negative {
            1
        } else {
            0
        };
        let mut result = 0;
        if index == value.byte_len() {
            return Option::None
        } else {
            ()
        };
        while index < value.byte_len() {
            let byte = value.byte_get(index);
            if byte < b'0' || byte > b'9' {
                return Option::None
            } else {
                result = result * 10 + (byte - b'0') as int;
            };
            index += 1;
        };
        Option::Some(
            if negative {
                0 - result
            } else {
                result
            },
        )
    }
}

pub fn as_int(value: Value) -> Option[int] {
    match value {
        Number(number) => parse_json_int_text(number),
        _ => Option::None,
    }
}

pub fn as_bool(value: Value) -> Option[bool] {
    match value {
        Bool(result) => Option::Some(result),
        _ => Option::None,
    }
}

pub fn as_array(value: Value) -> Option[Vec[Value]] {
    match value {
        Array(items) => Option::Some(items),
        _ => Option::None,
    }
}

pub fn object(fields: Vec[(string, Value)]) -> Value {
    Value::Object(fields)
}
