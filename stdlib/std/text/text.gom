package text;

fn is_ascii_whitespace_byte(value: uint8) -> bool {
    value == 9 || value == 10 || value == 11 || value == 12 || value == 13 || value == 32
}

fn find_from(value: string, expected: string, start: int) -> Option[int] {
    if start < 0 || start > value.byte_len() {
        Option::None
    } else if expected.byte_len() == 0 {
        Option::Some(start)
    } else if expected.byte_len() > value.byte_len() - start {
        Option::None
    } else {
        let limit = value.byte_len() - expected.byte_len();
        let index = Ref::new(start);
        while index.get() <= limit {
            let end = index.get() + expected.byte_len();
            if value.is_char_boundary(index.get()) && value.is_char_boundary(end)
                && value.byte_slice(index.get(), end) == expected {
                return Option::Some(index.get())
            } else {
                index.set(index.get() + 1)
            }
        };
        Option::None
    }
}

pub fn find(value: string, expected: string) -> Option[int] {
    find_from(value, expected, 0)
}

pub fn trim_start(value: string) -> string {
    let start = Ref::new(0);
    while start.get() < value.byte_len() && is_ascii_whitespace_byte(value.byte_get(start.get())) {
        start.set(start.get() + 1)
    };
    value.byte_slice(start.get(), value.byte_len())
}

pub fn trim_end(value: string) -> string {
    let end = Ref::new(value.byte_len());
    while end.get() > 0 && is_ascii_whitespace_byte(value.byte_get(end.get() - 1)) {
        end.set(end.get() - 1)
    };
    value.byte_slice(0, end.get())
}

pub fn trim(value: string) -> string {
    trim_end(trim_start(value))
}

pub fn split(value: string, separator: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    if separator.byte_len() == 0 {
        result.push(value);
        return result
    } else {
        ()
    };
    let start = Ref::new(0);
    let done: Ref[bool] = Ref::new(false);
    while done.get() == false {
        match find_from(value, separator, start.get()) {
            Option::Some(index) => {
                result.push(value.byte_slice(start.get(), index));
                start.set(index + separator.byte_len())
            },
            Option::None => {
                result.push(value.byte_slice(start.get(), value.byte_len()));
                done.set(true)
            },
        }
    };
    result
}

pub fn split_once(value: string, separator: string) -> Option[(string, string)] {
    if separator.byte_len() == 0 {
        Option::None
    } else {
        match find(value, separator) {
            Option::Some(index) => Option::Some(
                (
                    value.byte_slice(0, index),
                    value.byte_slice(index + separator.byte_len(), value.byte_len()),
                ),
            ),
            Option::None => Option::None,
        }
    }
}

pub fn lines(value: string) -> Vec[string] {
    let result = split(value, "\n");
    if result.len() > 0 && result.get(result.len() - 1) == "" {
        let _ = result.pop();
    } else {
        ()
    };
    for index in range(0, result.len()) {
        let line = result.get(index);
        if line.byte_len() > 0 && line.byte_get(line.byte_len() - 1) == 13 {
            result.set(index, line.byte_slice(0, line.byte_len() - 1))
        } else {
            ()
        }
    };
    result
}

pub fn replace(value: string, expected: string, replacement: string) -> string {
    if expected.byte_len() == 0 {
        value
    } else {
        let builder = StringBuilder::with_capacity(value.byte_len());
        let start = Ref::new(0);
        let done: Ref[bool] = Ref::new(false);
        while done.get() == false {
            match find_from(value, expected, start.get()) {
                Option::Some(index) => {
                    builder.write_string(value.byte_slice(start.get(), index));
                    builder.write_string(replacement);
                    start.set(index + expected.byte_len())
                },
                Option::None => {
                    builder.write_string(value.byte_slice(start.get(), value.byte_len()));
                    done.set(true)
                },
            }
        };
        builder.finish()
    }
}

pub fn join(values: Vec[string], separator: string) -> string {
    let builder = StringBuilder::new();
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        builder.write_string(values.get(index))
    };
    builder.finish()
}

pub fn repeat(value: string, count: int) -> string {
    if count <= 0 || value.byte_len() == 0 {
        ""
    } else {
        let builder = StringBuilder::with_capacity(value.byte_len() * count);
        for _ in range(0, count) {
            builder.write_string(value)
        };
        builder.finish()
    }
}

pub fn is_ascii(value: string) -> bool {
    let ascii = Ref::new(true);
    let index = Ref::new(0);
    while ascii.get() && index.get() < value.byte_len() {
        if value.byte_get(index.get()) > 127 {
            ascii.set(false)
        } else {
            index.set(index.get() + 1)
        }
    };
    ascii.get()
}

pub fn to_ascii_lowercase(value: string) -> string {
    let values = value.to_bytes();
    for index in range(0, values.len()) {
        let current = values.get(index);
        if current >= 65 && current <= 90 {
            values.set(index, current + 32)
        } else {
            ()
        }
    };
    let (_, result) = string_from_utf8(values);
    result
}

pub fn to_ascii_uppercase(value: string) -> string {
    let values = value.to_bytes();
    for index in range(0, values.len()) {
        let current = values.get(index);
        if current >= 97 && current <= 122 {
            values.set(index, current - 32)
        } else {
            ()
        }
    };
    let (_, result) = string_from_utf8(values);
    result
}
