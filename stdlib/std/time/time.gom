package time;

use std::internal::host;

pub struct Duration {
    nanoseconds: int64,
}

impl Duration {
    pub fn zero() -> Duration {
        Duration { nanoseconds: 0 }
    }

    pub fn from_nanoseconds(value: int64) -> Duration {
        Duration {
            nanoseconds: if value < 0 { 0 } else { value },
        }
    }

    pub fn from_microseconds(value: int64) -> Duration {
        Duration::from_nanoseconds(value * 1000)
    }

    pub fn from_milliseconds(value: int64) -> Duration {
        Duration::from_nanoseconds(value * 1000000)
    }

    pub fn from_seconds(value: int64) -> Duration {
        Duration::from_nanoseconds(value * 1000000000)
    }

    pub fn as_nanoseconds(self: Duration) -> int64 {
        self.nanoseconds
    }

    pub fn as_microseconds(self: Duration) -> int64 {
        self.nanoseconds / 1000
    }

    pub fn as_milliseconds(self: Duration) -> int64 {
        self.nanoseconds / 1000000
    }

    pub fn as_seconds(self: Duration) -> int64 {
        self.nanoseconds / 1000000000
    }

    pub fn is_zero(self: Duration) -> bool {
        self.nanoseconds == 0
    }

    pub fn add(self: Duration, other: Duration) -> Duration {
        Duration::from_nanoseconds(self.nanoseconds + other.nanoseconds)
    }

    pub fn subtract(self: Duration, other: Duration) -> Duration {
        Duration::from_nanoseconds(self.nanoseconds - other.nanoseconds)
    }
}

pub struct Instant {
    nanoseconds: int64,
}

impl Instant {
    pub fn now() -> Instant {
        Instant {
            nanoseconds: host::monotonic_nanoseconds(),
        }
    }

    pub fn elapsed(self: Instant) -> Duration {
        Instant::now().duration_since(self)
    }

    pub fn duration_since(self: Instant, earlier: Instant) -> Duration {
        Duration::from_nanoseconds(self.nanoseconds - earlier.nanoseconds)
    }
}

pub struct SystemTime {
    unix_nanoseconds: int64,
}

impl SystemTime {
    pub fn now() -> SystemTime {
        SystemTime {
            unix_nanoseconds: host::unix_nanoseconds(),
        }
    }

    pub fn from_unix_nanoseconds(value: int64) -> SystemTime {
        SystemTime {
            unix_nanoseconds: value,
        }
    }

    pub fn unix_nanoseconds(self: SystemTime) -> int64 {
        self.unix_nanoseconds
    }

    pub fn unix_milliseconds(self: SystemTime) -> int64 {
        self.unix_nanoseconds / 1000000
    }

    pub fn unix_seconds(self: SystemTime) -> int64 {
        self.unix_nanoseconds / 1000000000
    }
}

pub fn sleep(duration: Duration) -> unit {
    host::sleep_nanoseconds(duration.as_nanoseconds())
}
