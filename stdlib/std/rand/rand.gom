package rand;

pub const algorithm: string = "splitmix64-v1";

fn advance(state: Ref[uint64]) -> uint64 {
    let next = state.get() + 0x9e3779b97f4a7c15;
    state.set(next);
    let mut value = next;
    value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9;
    value = (value ^ (value >> 27)) * 0x94d049bb133111eb;
    value ^ (value >> 31)
}

pub fn next_u64(seed: uint64) -> uint64 {
    advance(Ref::new(seed))
}

pub fn bytes(seed: uint64, length: int) -> Vec[byte] {
    let output: Vec[byte] = Vec::with_capacity(
        if length > 0 {
            length
        } else {
            0
        },
    );
    let state = Ref::new(seed);
    let mut remaining = length;
    while remaining > 0 {
        let value = advance(state);
        let count = if remaining < 8 {
            remaining
        } else {
            8
        };
        for index in 0..count {
            output.push((value >> (index * 8)) as byte)
        }
        remaining -= count;
    }
    output
}

pub fn int_range(seed: uint64, start: int, end: int) -> Option[int] {
    if start >= end {
        Option::None
    } else {
        let width = (end - start) as uint64;
        Option::Some(start + (next_u64(seed) % width) as int)
    }
}

pub fn shuffle[T](values: Vec[T], seed: uint64) -> Vec[T] {
    let output: Vec[T] = Vec::with_capacity(values.len());
    for value in values {
        output.push(value)
    }
    let state = Ref::new(seed);
    let mut remaining = output.len();
    while remaining > 1 {
        let index = (advance(state) % (remaining as uint64)) as int;
        let last = remaining - 1;
        let value = output[index];
        output[index] = output[last];
        output[last] = value;
        remaining -= 1;
    }
    output
}
