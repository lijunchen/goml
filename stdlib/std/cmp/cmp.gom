pub struct Reverse[T] {
    pub value: T,
}

impl[T] Reverse[T] {
    pub fn new(value: T) -> Reverse[T] {
        Reverse { value }
    }

    pub fn into_inner(self: Reverse[T]) -> T {
        self.value
    }
}

impl[T: Eq] Eq for Reverse[T] {
    fn eq(self: Reverse[T], other: Reverse[T]) -> bool {
        self.value == other.value
    }
}

impl[T: Ord] Ord for Reverse[T] {
    fn cmp(self: Reverse[T], other: Reverse[T]) -> Ordering {
        Ord::cmp(other.value, self.value)
    }
}

pub fn compare[T: Ord](left: T, right: T) -> Ordering {
    Ord::cmp(left, right)
}

pub fn min[T: Ord](left: T, right: T) -> T {
    min_by(left, right, |first: T, second: T| compare(first, second))
}

pub fn max[T: Ord](left: T, right: T) -> T {
    max_by(left, right, |first: T, second: T| compare(first, second))
}

pub fn min_by[T](left: T, right: T, compare_fn: (T, T) -> Ordering) -> T {
    if compare_fn(left, right).is_gt() {
        right
    } else {
        left
    }
}

pub fn max_by[T](left: T, right: T, compare_fn: (T, T) -> Ordering) -> T {
    if compare_fn(left, right).is_gt() {
        left
    } else {
        right
    }
}

pub fn min_by_key[T, K: Ord](left: T, right: T, key: (T) -> K) -> T {
    let left_key = key(left);
    let right_key = key(right);
    min_by(left, right, |_: T, _: T| compare(left_key, right_key))
}

pub fn max_by_key[T, K: Ord](left: T, right: T, key: (T) -> K) -> T {
    let left_key = key(left);
    let right_key = key(right);
    max_by(left, right, |_: T, _: T| compare(left_key, right_key))
}

pub fn clamp[T: Ord](value: T, minimum: T, maximum: T) -> Result[T, string] {
    if compare(minimum, maximum).is_gt() {
        Result::Err("minimum exceeds maximum")
    } else if compare(value, minimum).is_lt() {
        Result::Ok(minimum)
    } else if compare(value, maximum).is_gt() {
        Result::Ok(maximum)
    } else {
        Result::Ok(value)
    }
}
