package collections;

pub struct BitSet {
    words: Vec[uint64],
    len: Ref[int32],
}

impl BitSet {
    fn new() -> BitSet {
        BitSet {
            words: Vec::new(),
            len: Ref::new(0),
        }
    }

    fn len(self: BitSet) -> int32 {
        self.len.get()
    }

    fn is_empty(self: BitSet) -> bool {
        self.len.get() == 0
    }

    fn contains(self: BitSet, index: int32) -> bool {
        if index < 0 {
            false
        } else {
            let word_index = index / 64;
            if word_index >= self.words.len() {
                false
            } else {
                let mask = 1u64 << (index % 64);
                self.words.get(word_index) & mask != 0u64
            }
        }
    }

    fn insert(self: BitSet, index: int32) -> bool {
        if index < 0 {
            false
        } else {
            let word_index = index / 64;
            while self.words.len() <= word_index {
                self.words.push(0u64);
            };
            let mask = 1u64 << (index % 64);
            let old = self.words.get(word_index);
            if old & mask != 0u64 {
                false
            } else {
                self.words.set(word_index, old | mask);
                self.len.set(self.len.get() + 1);
                true
            }
        }
    }

    fn remove(self: BitSet, index: int32) -> bool {
        if !self.contains(index) {
            false
        } else {
            let word_index = index / 64;
            let mask = 1u64 << (index % 64);
            self.words.set(word_index, self.words.get(word_index) & ~mask);
            self.len.set(self.len.get() - 1);
            true
        }
    }

    fn clear(self: BitSet) -> unit {
        self.words.clear();
        self.len.set(0)
    }
}
