package collections;

pub struct Symbol {
    index: int32,
}

impl Symbol {
    fn index(self: Symbol) -> int32 {
        self.index
    }
}

impl Eq for Symbol {
    fn eq(self: Symbol, other: Symbol) -> bool {
        self.index == other.index
    }
}

impl Hash for Symbol {
    fn hash(self: Symbol) -> uint64 {
        Hash::hash(self.index)
    }
}

pub struct Interner {
    symbols: HashMap[string, Symbol],
    values: Vec[string],
}

impl Interner {
    fn new() -> Interner {
        Interner {
            symbols: HashMap::new(),
            values: Vec::new(),
        }
    }

    fn len(self: Interner) -> int32 {
        self.values.len()
    }

    fn is_empty(self: Interner) -> bool {
        self.values.len() == 0
    }

    fn contains(self: Interner, value: string) -> bool {
        self.symbols.contains(value)
    }

    fn intern(self: Interner, value: string) -> Symbol {
        match self.symbols.get(value) {
            Option::Some(symbol) => symbol,
            Option::None => {
                let symbol = Symbol {
                    index: self.values.len(),
                };
                self.values.push(value);
                self.symbols.set(value, symbol);
                symbol
            },
        }
    }

    fn get(self: Interner, symbol: Symbol) -> string {
        self.values.get(symbol.index)
    }

    fn resolve(self: Interner, symbol: Symbol) -> Option[string] {
        if symbol.index >= 0 && symbol.index < self.values.len() {
            Option::Some(self.values.get(symbol.index))
        } else {
            Option::None
        }
    }
}
