package env;

use std::internal::host;

pub fn args() -> Vec[string] {
    host::args()
}

pub fn current_dir() -> Result[string, string] {
    let (ok, value, err) = host::current_dir();
    if ok {
        Result::Ok(value)
    } else {
        Result::Err(err)
    }
}

pub fn current_exe() -> Result[string, string] {
    let (ok, value, err) = host::current_exe();
    if ok {
        Result::Ok(value)
    } else {
        Result::Err(err)
    }
}

pub fn var(name: string) -> Option[string] {
    let (found, value) = host::env_var(name);
    if found {
        Option::Some(value)
    } else {
        Option::None
    }
}
