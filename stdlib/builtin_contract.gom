package builtin;

trait Iterator {
    type Item;
    fn next(self: Self) -> Option[Self::Item];
}

trait IntoIterator {
    type Item;
    type IntoIter: Iterator;
    fn into_iter(self: Self) -> Self::IntoIter;
}

struct FnIterator[T] {
    next_fn: () -> Option[T],
}

struct MapIterator[A, B, I] {
    iterator: I,
    map_fn: (A) -> B,
}

struct FilterIterator[T, I] {
    iterator: I,
    predicate: (T) -> bool,
}

struct TakeIterator[I] {
    iterator: I,
    remaining: Ref[int],
}
