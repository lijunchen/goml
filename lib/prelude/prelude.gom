package prelude;

pub fn print[T: ToString](value: T) -> unit {
    string_print(ToString::to_string(value))
}

pub fn println[T: ToString](value: T) -> unit {
    string_println(ToString::to_string(value))
}

pub fn char_from_uint32(value: uint32) -> Option[char] {
    __goml_builtin_char_from_uint32(value)
}

pub fn range(start: int, end: int) -> FnIterator[int] {
    __goml_builtin_range(start, end)
}
