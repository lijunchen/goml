package env;

use std::internal::host;
use std::io;
use std::text;

fn operation_error(operation: string, message: string) -> io::Error {
    io::Error::new(io::ErrorKind::Other, operation, Option::None, Option::None, message)
}

pub fn args() -> Vec[string] {
    host::args()
}

pub fn current_dir() -> Result[string, string] {
    let (ok, value, err) = host::current_dir();
    if ok {
        Result::Ok(value)
    } else {
        Result::Err(err)
    }
}

pub fn current_dir_structured() -> Result[string, io::Error] {
    match current_dir() {
        Ok(value) => Result::Ok(value),
        Err(message) => Result::Err(operation_error("current directory", message)),
    }
}

pub fn current_exe() -> Result[string, string] {
    let (ok, value, err) = host::current_exe();
    if ok {
        Result::Ok(value)
    } else {
        Result::Err(err)
    }
}

pub fn current_exe_structured() -> Result[string, io::Error] {
    match current_exe() {
        Ok(value) => Result::Ok(value),
        Err(message) => Result::Err(operation_error("current executable", message)),
    }
}

pub fn var(name: string) -> Option[string] {
    let (found, value) = host::env_var(name);
    if found {
        Option::Some(value)
    } else {
        Option::None
    }
}

pub fn var_structured(name: string) -> Result[string, VarError] {
    match var(name) {
        Some(value) => Result::Ok(value),
        None => Result::Err(VarError::new(io::ErrorKind::NotFound, name, "not present")),
    }
}

pub fn vars() -> Vec[(string, string)] {
    let result: Vec[(string, string)] = Vec::from_array([]);
    for entry in host::env_vars() {
        match text::split_once(entry, "=") {
            Some(pair) => result.push(pair),
            None => result.push((entry, "")),
        }
    }
    result
}
