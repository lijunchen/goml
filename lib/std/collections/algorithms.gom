package collections;

use std::cmp;

pub fn stable_sort_by[T](values: Vec[T], compare: (T, T) -> int) -> unit {
    values.stable_sort_by(compare)
}

pub fn sort_by[T](values: Vec[T], compare: (T, T) -> int) -> unit {
    values.sort_by(compare)
}

pub fn stable_sort_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> unit {
    values.stable_sort_by_ordering(compare)
}

pub fn sort_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> unit {
    values.sort_by_ordering(compare)
}

pub fn stable_sort[T: cmp::Ord](values: Vec[T]) -> unit {
    values.stable_sort_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn sort[T: cmp::Ord](values: Vec[T]) -> unit {
    values.sort_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn binary_search_by[T](values: Vec[T], compare: (T) -> int) -> Option[int] {
    values.binary_search_by(compare)
}

pub fn binary_search_by_ordering[T](values: Vec[T], compare: (T) -> cmp::Ordering) -> Option[int] {
    values.binary_search_by_ordering(compare)
}

pub fn binary_search[T: cmp::Ord](values: Vec[T], expected: T) -> Option[int] {
    values.binary_search_by_ordering(|value: T| cmp::compare(value, expected))
}

pub fn position_by[T](values: Vec[T], predicate: (T) -> bool) -> Option[int] {
    values.position(predicate)
}

pub fn min_by[T](values: Vec[T], compare: (T, T) -> int) -> Option[T] {
    values.min_by(compare)
}

pub fn max_by[T](values: Vec[T], compare: (T, T) -> int) -> Option[T] {
    values.max_by(compare)
}

pub fn min_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> Option[T] {
    values.min_by_ordering(compare)
}

pub fn max_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> Option[T] {
    values.max_by_ordering(compare)
}

pub fn min[T: cmp::Ord](values: Vec[T]) -> Option[T] {
    values.min_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn max[T: cmp::Ord](values: Vec[T]) -> Option[T] {
    values.max_by_ordering(|left: T, right: T| cmp::compare(left, right))
}

pub fn dedup_by[T](values: Vec[T], equal: (T, T) -> bool) -> unit {
    values.dedup_by(equal)
}

pub fn dedup[T: PartialEq](values: Vec[T]) -> unit {
    values.dedup()
}
