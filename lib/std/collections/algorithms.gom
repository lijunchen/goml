package collections;

use std::cmp;

fn smaller(left: int, right: int) -> int {
    if left < right {
        left
    } else {
        right
    }
}

pub fn stable_sort_by[T](values: Vec[T], compare: (T, T) -> int) -> unit {
    let length = values.len();
    if length < 2 {
        return
    } else {};
    let buffer: Vec[T] = Vec::with_capacity(length);
    for index in 0..length {
        buffer.push(values[index])
    }
    let mut width = 1;
    while width < length {
        let mut left = 0;
        while left < length {
            let middle = smaller(left + width, length);
            let right = smaller(middle + width, length);
            let mut first = left;
            let mut second = middle;
            let mut output = left;
            while first < middle && second < right {
                if compare(values[first], values[second]) <= 0 {
                    buffer[output] = values[first];
                    first += 1;
                } else {
                    buffer[output] = values[second];
                    second += 1;
                };
                output += 1;
            }
            while first < middle {
                buffer[output] = values[first];
                first += 1;
                output += 1;
            }
            while second < right {
                buffer[output] = values[second];
                second += 1;
                output += 1;
            }
            left = right;
        }
        for index in 0..length {
            values[index] = buffer[index];
        }
        width = if width > length / 2 {
            length
        } else {
            width * 2
        };
    }
}

pub fn sort_by[T](values: Vec[T], compare: (T, T) -> int) -> unit {
    stable_sort_by(values, compare)
}

pub fn stable_sort_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> unit {
    stable_sort_by(values, |left: T, right: T| compare(left, right).to_int())
}

pub fn sort_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> unit {
    stable_sort_by_ordering(values, compare)
}

pub fn stable_sort[T: cmp::Ord](values: Vec[T]) -> unit {
    stable_sort_by_ordering(values, |left: T, right: T| cmp::compare(left, right))
}

pub fn sort[T: cmp::Ord](values: Vec[T]) -> unit {
    stable_sort(values)
}

pub fn binary_search_by[T](values: Vec[T], compare: (T) -> int) -> Option[int] {
    let mut low = 0;
    let mut high = values.len();
    while low < high {
        let middle = low + (high - low) / 2;
        if compare(values[middle]) < 0 {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    if low < values.len() && compare(values[low]) == 0 {
        Option::Some(low)
    } else {
        Option::None
    }
}

pub fn binary_search_by_ordering[T](values: Vec[T], compare: (T) -> cmp::Ordering) -> Option[int] {
    binary_search_by(values, |value: T| compare(value).to_int())
}

pub fn binary_search[T: cmp::Ord](values: Vec[T], expected: T) -> Option[int] {
    binary_search_by_ordering(values, |value: T| cmp::compare(value, expected))
}

pub fn position_by[T](values: Vec[T], predicate: (T) -> bool) -> Option[int] {
    for index in 0..values.len() {
        if predicate(values[index]) {
            return Option::Some(index)
        } else {}
    }
    Option::None
}

pub fn contains[T: PartialEq](values: Vec[T], expected: T) -> bool {
    values.contains(expected)
}

pub fn min_by[T](values: Vec[T], compare: (T, T) -> int) -> Option[T] {
    if values.is_empty() {
        Option::None
    } else {
        let mut best = values[0];
        for index in 1..values.len() {
            let value = values[index];
            if compare(value, best) < 0 {
                best = value;
            } else {}
        }
        Option::Some(best)
    }
}

pub fn max_by[T](values: Vec[T], compare: (T, T) -> int) -> Option[T] {
    if values.is_empty() {
        Option::None
    } else {
        let mut best = values[0];
        for index in 1..values.len() {
            let value = values[index];
            if compare(value, best) > 0 {
                best = value;
            } else {}
        }
        Option::Some(best)
    }
}

pub fn min_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> Option[T] {
    min_by(values, |left: T, right: T| compare(left, right).to_int())
}

pub fn max_by_ordering[T](values: Vec[T], compare: (T, T) -> cmp::Ordering) -> Option[T] {
    max_by(values, |left: T, right: T| compare(left, right).to_int())
}

pub fn min[T: cmp::Ord](values: Vec[T]) -> Option[T] {
    min_by_ordering(values, |left: T, right: T| cmp::compare(left, right))
}

pub fn max[T: cmp::Ord](values: Vec[T]) -> Option[T] {
    max_by_ordering(values, |left: T, right: T| cmp::compare(left, right))
}

pub fn dedup_by[T](values: Vec[T], equal: (T, T) -> bool) -> unit {
    if values.len() < 2 {
        return
    } else {};
    let mut output = 1;
    for index in 1..values.len() {
        let value = values[index];
        if !equal(values[output - 1], value) {
            values[output] = value;
            output += 1;
        } else {}
    }
    values.truncate(output)
}

pub fn dedup[T: PartialEq](values: Vec[T]) -> unit {
    dedup_by(values, |left: T, right: T| PartialEq::eq(left, right))
}
