package json;

use module::serde;
use module::text;
pub use serde::{Deserialize, Serialize};

enum JsonSerializeFrame {
    Optional {
        ready: Ref[bool],
    },
    Array {
        length: int,
        index: Ref[int],
        ready: Ref[bool],
    },
    Map {
        length: int,
        index: Ref[int],
        state: Ref[int],
    },
    Struct {
        length: int,
        index: Ref[int],
        ready: Ref[bool],
    },
    Variant {
        kind: int,
        length: int,
        index: Ref[int],
        ready: Ref[bool],
    },
}

struct JsonSerializer {
    builder: text::StringBuilder,
    frames: Vec[JsonSerializeFrame],
    root_written: Ref[bool],
}

fn json_serializer() -> JsonSerializer {
    JsonSerializer {
        builder: text::StringBuilder::new(),
        frames: Vec::from_array([]),
        root_written: Ref::new(false),
    }
}

fn claim_json_value(serializer: JsonSerializer) -> Result[unit, string] {
    if serializer.frames.is_empty() {
        if serializer.root_written.get() {
            Result::Err("JSON serialization produced more than one root value")
        } else {
            serializer.root_written.set(true);
            Result::Ok(())
        }
    } else {
        let frame = serializer.frames.len() - 1;
        match serializer.frames[frame] {
            JsonSerializeFrame::Optional { ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("optional is not expecting a value")
            },
            JsonSerializeFrame::Array { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("array is not expecting a value")
            },
            JsonSerializeFrame::Map { length: _, index, state } => if state.get() == 3 {
                index.set(index.get() + 1);
                state.set(0);
                Result::Ok(())
            } else if state.get() == 1 {
                Result::Err("JSON object keys must serialize as strings")
            } else {
                Result::Err("map is not expecting a value")
            },
            JsonSerializeFrame::Struct { length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("object is not expecting a field value")
            },
            JsonSerializeFrame::Variant { kind: _, length: _, index: _, ready } => if ready.get() {
                ready.set(false);
                Result::Ok(())
            } else {
                Result::Err("variant is not expecting a field value")
            },
        }
    }
}

fn claim_json_string(serializer: JsonSerializer) -> Result[unit, string] {
    if serializer.frames.is_empty() {
        claim_json_value(serializer)
    } else {
        let frame = serializer.frames.len() - 1;
        match serializer.frames[frame] {
            JsonSerializeFrame::Map { length: _, index: _, state } => if state.get() == 1 {
                state.set(2);
                Result::Ok(())
            } else {
                claim_json_value(serializer)
            },
            _ => claim_json_value(serializer),
        }
    }
}

fn finish_json_serializer(serializer: JsonSerializer) -> Result[string, string] {
    if !serializer.frames.is_empty() {
        Result::Err("JSON serialization ended inside a compound value")
    } else if !serializer.root_written.get() {
        Result::Err("JSON serialization produced no value")
    } else {
        Result::Ok(serializer.builder.finish())
    }
}

impl serde::Serializer for JsonSerializer {
    fn serialize_unit(self: JsonSerializer) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string("null");
        Result::Ok(())
    }

    fn serialize_bool(self: JsonSerializer, value: bool) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(
            if value {
                "true"
            } else {
                "false"
            },
        );
        Result::Ok(())
    }

    fn serialize_int(self: JsonSerializer, value: int) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_int8(self: JsonSerializer, value: int8) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_int16(self: JsonSerializer, value: int16) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_int32(self: JsonSerializer, value: int32) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_int64(self: JsonSerializer, value: int64) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_uint(self: JsonSerializer, value: uint) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_uint8(self: JsonSerializer, value: uint8) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_uint16(self: JsonSerializer, value: uint16) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_uint32(self: JsonSerializer, value: uint32) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_uint64(self: JsonSerializer, value: uint64) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_float32(self: JsonSerializer, value: float32) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_float64(self: JsonSerializer, value: float64) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value.to_string());
        Result::Ok(())
    }

    fn serialize_number(self: JsonSerializer, value: string) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_string(value);
        Result::Ok(())
    }

    fn serialize_string(self: JsonSerializer, value: string) -> Result[unit, string] {
        claim_json_string(self)?;
        write_json_string(self.builder, value);
        Result::Ok(())
    }

    fn serialize_char(self: JsonSerializer, value: char) -> Result[unit, string] {
        claim_json_string(self)?;
        write_json_string(self.builder, value.to_string());
        Result::Ok(())
    }

    fn serialize_bytes(self: JsonSerializer, value: Slice[byte]) -> Result[unit, string] {
        claim_json_value(self)?;
        self.builder.write_char('[');
        let mut index = 0;
        while index < value.len() {
            if index > 0 {
                self.builder.write_char(',')
            } else {};
            self.builder.write_string(value[index].to_string());
            index = index + 1;
        }
        self.builder.write_char(']');
        Result::Ok(())
    }

    fn begin_optional(self: JsonSerializer, present: bool) -> Result[unit, string] {
        claim_json_value(self)?;
        if !present {
            self.builder.write_string("null")
        } else {};
        self.frames.push(JsonSerializeFrame::Optional { ready: Ref::new(present) });
        Result::Ok(())
    }

    fn end_optional(self: JsonSerializer) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("end_optional without begin_optional")
        } else {};
        match self.frames[self.frames.len() - 1] {
            JsonSerializeFrame::Optional { ready } => if ready.get() {
                Result::Err("optional item was not serialized")
            } else {
                let _ = self.frames.pop();
                Result::Ok(())
            },
            _ => Result::Err("end_optional does not match active JSON value"),
        }
    }

    fn begin_sequence(self: JsonSerializer, length: int) -> Result[unit, string] {
        if length < 0 {
            return Result::Err("sequence length cannot be negative")
        } else {};
        claim_json_value(self)?;
        self.builder.write_char('[');
        self.frames.push(
            JsonSerializeFrame::Array { length, index: Ref::new(0), ready: Ref::new(false) },
        );
        Result::Ok(())
    }

    fn begin_sequence_element(self: JsonSerializer, index: int) -> Result[unit, string] {
        begin_json_array_element(self, index)
    }

    fn end_sequence(self: JsonSerializer) -> Result[unit, string] {
        end_json_array(self)
    }

    fn begin_tuple(self: JsonSerializer, length: int) -> Result[unit, string] {
        if length < 0 {
            return Result::Err("tuple length cannot be negative")
        } else {};
        claim_json_value(self)?;
        self.builder.write_char('[');
        self.frames.push(
            JsonSerializeFrame::Array { length, index: Ref::new(0), ready: Ref::new(false) },
        );
        Result::Ok(())
    }

    fn begin_tuple_element(self: JsonSerializer, index: int) -> Result[unit, string] {
        begin_json_array_element(self, index)
    }

    fn end_tuple(self: JsonSerializer) -> Result[unit, string] {
        end_json_array(self)
    }

    fn begin_map(self: JsonSerializer, length: int) -> Result[unit, string] {
        if length < 0 {
            Result::Err("map length cannot be negative")
        } else {
            claim_json_value(self)?;
            self.builder.write_char('{');
            self.frames.push(
                JsonSerializeFrame::Map { length, index: Ref::new(0), state: Ref::new(0) },
            );
            Result::Ok(())
        }
    }

    fn begin_map_key(self: JsonSerializer, index: int) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("map key without map")
        } else {};
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            JsonSerializeFrame::Map { length, index: next, state } => if state.get() != 0
                || index != next.get()
                || index >= length {
                Result::Err("map key index is out of order")
            } else {
                if index > 0 {
                    self.builder.write_char(',')
                } else {};
                state.set(1);
                Result::Ok(())
            },
            _ => Result::Err("map key outside a map"),
        }
    }

    fn begin_map_value(self: JsonSerializer, index: int) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("map value without map")
        } else {};
        let frame = self.frames.len() - 1;
        match self.frames[frame] {
            JsonSerializeFrame::Map { length: _, index: next, state } => if state.get() != 2
                || index != next.get() {
                Result::Err("map value has no completed key")
            } else {
                self.builder.write_char(':');
                state.set(3);
                Result::Ok(())
            },
            _ => Result::Err("map value outside a map"),
        }
    }

    fn end_map(self: JsonSerializer) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("end_map without begin_map")
        } else {};
        match self.frames[self.frames.len() - 1] {
            JsonSerializeFrame::Map { length, index, state } => if state.get() != 0
                || index.get() != length {
                Result::Err("map length does not match serialized entries")
            } else {
                let _ = self.frames.pop();
                self.builder.write_char('}');
                Result::Ok(())
            },
            _ => Result::Err("end_map does not match active JSON value"),
        }
    }

    fn begin_struct(self: JsonSerializer, name: string, fields: int) -> Result[unit, string] {
        let _ = name;
        if fields < 0 {
            return Result::Err("struct field count cannot be negative")
        } else {};
        claim_json_value(self)?;
        self.builder.write_char('{');
        self.frames.push(
            JsonSerializeFrame::Struct {
                length: fields,
                index: Ref::new(0),
                ready: Ref::new(false),
            },
        );
        Result::Ok(())
    }

    fn begin_struct_field(self: JsonSerializer, index: int, name: string) -> Result[unit, string] {
        begin_json_named_field(self, index, name, false)
    }

    fn end_struct(self: JsonSerializer) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("end_struct without begin_struct")
        } else {};
        match self.frames[self.frames.len() - 1] {
            JsonSerializeFrame::Struct { length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err("struct field count does not match serialized values")
            } else {
                let _ = self.frames.pop();
                self.builder.write_char('}');
                Result::Ok(())
            },
            _ => Result::Err("end_struct does not match active JSON value"),
        }
    }

    fn begin_variant(
        self: JsonSerializer,
        enum_name: string,
        index: int,
        name: string,
        kind: int,
        fields: int,
    ) -> Result[unit, string] {
        let _ = enum_name;
        if index < 0 {
            return Result::Err("enum variant index cannot be negative")
        } else if kind < 0 || kind > 2 {
            return Result::Err("invalid enum variant kind")
        } else if fields < 0 || kind == 0 && fields != 0 {
            return Result::Err("invalid enum variant field count")
        } else {};
        claim_json_value(self)?;
        if kind == 0 {
            write_json_string(self.builder, name)
        } else {
            self.builder.write_char('{');
            write_json_string(self.builder, name);
            self.builder.write_char(':');
            self.builder.write_char(
                if kind == 1 {
                    '['
                } else {
                    '{'
                },
            )
        };
        self.frames.push(
            JsonSerializeFrame::Variant {
                kind,
                length: fields,
                index: Ref::new(0),
                ready: Ref::new(false),
            },
        );
        Result::Ok(())
    }

    fn begin_variant_field(self: JsonSerializer, index: int, name: string) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("variant field without variant")
        } else {};
        match self.frames[self.frames.len() - 1] {
            JsonSerializeFrame::Variant { kind, length, index: next, ready } => if kind == 0
                || ready.get()
                || index != next.get()
                || index >= length {
                Result::Err("variant field index is out of order")
            } else {
                if index > 0 {
                    self.builder.write_char(',')
                } else {};
                if kind == 2 {
                    write_json_string(self.builder, name);
                    self.builder.write_char(':')
                } else {};
                next.set(index + 1);
                ready.set(true);
                Result::Ok(())
            },
            _ => Result::Err("variant field outside a variant"),
        }
    }

    fn end_variant(self: JsonSerializer) -> Result[unit, string] {
        if self.frames.is_empty() {
            return Result::Err("end_variant without begin_variant")
        } else {};
        match self.frames[self.frames.len() - 1] {
            JsonSerializeFrame::Variant { kind, length, index, ready } => if ready.get()
                || index.get() != length {
                Result::Err("variant field count does not match serialized values")
            } else {
                let _ = self.frames.pop();
                if kind == 1 {
                    self.builder.write_string("]}")
                } else if kind == 2 {
                    self.builder.write_string("}}")
                } else {};
                Result::Ok(())
            },
            _ => Result::Err("end_variant does not match active JSON value"),
        }
    }
}

fn begin_json_array_element(serializer: JsonSerializer, index: int) -> Result[unit, string] {
    if serializer.frames.is_empty() {
        return Result::Err("array element without array")
    } else {};
    match serializer.frames[serializer.frames.len() - 1] {
        JsonSerializeFrame::Array { length, index: next, ready } => if ready.get()
            || index != next.get()
            || index >= length {
            Result::Err("array element index is out of order")
        } else {
            if index > 0 {
                serializer.builder.write_char(',')
            } else {};
            next.set(index + 1);
            ready.set(true);
            Result::Ok(())
        },
        _ => Result::Err("array element outside an array"),
    }
}

fn end_json_array(serializer: JsonSerializer) -> Result[unit, string] {
    if serializer.frames.is_empty() {
        return Result::Err("array end without array")
    } else {};
    match serializer.frames[serializer.frames.len() - 1] {
        JsonSerializeFrame::Array { length, index, ready } => if ready.get()
            || index.get() != length {
            Result::Err("array length does not match serialized elements")
        } else {
            let _ = serializer.frames.pop();
            serializer.builder.write_char(']');
            Result::Ok(())
        },
        _ => Result::Err("array end does not match active JSON value"),
    }
}

fn begin_json_named_field(serializer: JsonSerializer, index: int, name: string, variant: bool) -> Result[
    unit,
    string,
] {
    let _ = variant;
    if serializer.frames.is_empty() {
        return Result::Err("object field without object")
    } else {};
    match serializer.frames[serializer.frames.len() - 1] {
        JsonSerializeFrame::Struct { length, index: next, ready } => if ready.get()
            || index != next.get()
            || index >= length {
            Result::Err("object field index is out of order")
        } else {
            if index > 0 {
                serializer.builder.write_char(',')
            } else {};
            write_json_string(serializer.builder, name);
            serializer.builder.write_char(':');
            next.set(index + 1);
            ready.set(true);
            Result::Ok(())
        },
        _ => Result::Err("object field outside an object"),
    }
}

fn serde_fields_to_json(fields: Vec[(string, serde::Value)]) -> Vec[(string, Value)] {
    let result: Vec[(string, Value)] = Vec::with_capacity(fields.len());
    for field in fields {
        result.push((field.0, from_serde_value(field.1)))
    }
    result
}

fn serde_items_to_json(items: Vec[serde::Value]) -> Vec[Value] {
    let result: Vec[Value] = Vec::with_capacity(items.len());
    for item in items {
        result.push(from_serde_value(item))
    }
    result
}

fn serde_optional_to_json(items: Vec[serde::Value]) -> Value {
    if items.len() == 0 {
        Value::Null
    } else {
        from_serde_value(items[0])
    }
}

fn serde_variant_to_json(name: string, kind: int, fields: Vec[(string, serde::Value)]) -> Value {
    if kind == 0 {
        Value::String(name)
    } else if kind == 1 {
        let values: Vec[Value] = Vec::with_capacity(fields.len());
        for field in fields {
            values.push(from_serde_value(field.1))
        }
        Value::Object(Vec::from_array([(name, Value::Array(values))]))
    } else {
        Value::Object(Vec::from_array([(name, Value::Object(serde_fields_to_json(fields)))]))
    }
}

pub fn from_serde_value(value: serde::Value) -> Value {
    match value {
        serde::Value::Unit => Value::Null,
        serde::Value::Bool(value) => Value::Bool(value),
        serde::Value::Int(value) => Value::Number(value.to_string()),
        serde::Value::Int8(value) => Value::Number(value.to_string()),
        serde::Value::Int16(value) => Value::Number(value.to_string()),
        serde::Value::Int32(value) => Value::Number(value.to_string()),
        serde::Value::Int64(value) => Value::Number(value.to_string()),
        serde::Value::Uint(value) => Value::Number(value.to_string()),
        serde::Value::Uint8(value) => Value::Number(value.to_string()),
        serde::Value::Uint16(value) => Value::Number(value.to_string()),
        serde::Value::Uint32(value) => Value::Number(value.to_string()),
        serde::Value::Uint64(value) => Value::Number(value.to_string()),
        serde::Value::Float32(value) => Value::Number(value.to_string()),
        serde::Value::Float64(value) => Value::Number(value.to_string()),
        serde::Value::Number(value) => Value::Number(value),
        serde::Value::String(value) => Value::String(value),
        serde::Value::Char(value) => Value::String(value.to_string()),
        serde::Value::Sequence(items) => Value::Array(serde_items_to_json(items)),
        serde::Value::Tuple(items) => Value::Array(serde_items_to_json(items)),
        serde::Value::Optional(items) => serde_optional_to_json(items),
        serde::Value::Struct(fields) => Value::Object(serde_fields_to_json(fields)),
        serde::Value::Variant { index: _, name, kind, fields } => {
            serde_variant_to_json(name, kind, fields)
        },
    }
}

fn json_fields_to_serde(fields: Vec[(string, Value)]) -> Vec[(string, serde::Value)] {
    let result: Vec[(string, serde::Value)] = Vec::with_capacity(fields.len());
    for field in fields {
        result.push((field.0, into_serde_value(field.1)))
    }
    result
}

fn json_items_to_serde(items: Vec[Value]) -> Vec[serde::Value] {
    let result: Vec[serde::Value] = Vec::with_capacity(items.len());
    for item in items {
        result.push(into_serde_value(item))
    }
    result
}

pub fn into_serde_value(value: Value) -> serde::Value {
    match value {
        Value::Object(fields) => serde::Value::Struct(json_fields_to_serde(fields)),
        Value::Array(items) => serde::Value::Sequence(json_items_to_serde(items)),
        Value::String(value) => serde::Value::String(value),
        Value::Number(value) => serde::Value::Number(value),
        Value::Bool(value) => serde::Value::Bool(value),
        Value::Null => serde::Value::Unit,
    }
}

pub fn to_value[T: Serialize](value: T) -> Result[Value, string] {
    Result::Ok(from_serde_value(serde::to_value(value)?))
}

pub fn from_value[T: Deserialize](value: Value) -> Result[T, string] {
    serde::from_value(into_serde_value(value))
}

pub fn try_stringify[T: Serialize](value: T) -> Result[string, string] {
    let serializer = json_serializer();
    Serialize::serialize(value, serializer)?;
    finish_json_serializer(serializer)
}

pub fn stringify[T: Serialize](value: T) -> string {
    match try_stringify(value) {
        Ok(encoded) => encoded,
        Err(_) => "",
    }
}

pub fn try_to_string[T: Serialize](value: T) -> Result[string, string] {
    try_stringify(value)
}

pub fn to_string[T: Serialize](value: T) -> string {
    stringify(value)
}

pub fn from_string[T: Deserialize](input: string) -> Result[T, string] {
    let deserializer = json_deserializer(input);
    let decoded: Result[T, string] = Deserialize::deserialize(deserializer);
    let value: T = match decoded {
        Ok(value) => value,
        Err(error) => return Result::Err(contextualize_json_error(deserializer, error)),
    };
    match finish_json_deserializer(deserializer) {
        Ok(()) => Result::Ok(value),
        Err(error) => Result::Err(contextualize_json_error(deserializer, error)),
    }
}

impl Serialize for Value {
    fn serialize[S: serde::Serializer](self: Value, serializer: S) -> Result[unit, string] {
        serde::serialize_value_into(into_serde_value(self), serializer)
    }
}

impl Deserialize for Value {
    fn deserialize[D: serde::Deserializer](deserializer: D) -> Result[Value, string] {
        Result::Ok(from_serde_value(serde::Deserializer::deserialize_any(deserializer)?))
    }
}
