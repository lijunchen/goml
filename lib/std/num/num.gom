package num;

fn integer_digit(value: byte) -> Option[isize] {
    if value >= b'0' && value <= b'9' {
        Option::Some((value - b'0').to_isize())
    } else if value >= b'a' && value <= b'z' {
        Option::Some((value - b'a' + 10).to_isize())
    } else if value >= b'A' && value <= b'Z' {
        Option::Some((value - b'A' + 10).to_isize())
    } else {
        Option::None
    }
}

fn integer_base(value: string, start: isize, radix: isize) -> (bool, isize, isize, bool) {
    if radix != 0 && (radix < 2 || radix > 36) {
        return (false, start, radix, false)
    } else if radix != 0 {
        return (true, start, radix, false)
    } else if start < value.byte_len() && value.byte_get(start) == b'0' {
        if start + 1 < value.byte_len() {
            let marker = value.byte_get(start + 1);
            if marker == b'x' || marker == b'X' {
                return (true, start + 2, 16, true)
            } else if marker == b'o' || marker == b'O' {
                return (true, start + 2, 8, true)
            } else if marker == b'b' || marker == b'B' {
                return (true, start + 2, 2, true)
            }
        };
        (true, start, 8, true)
    } else {
        (true, start, 10, true)
    }
}

fn integer_magnitude(
    value: string,
    start: isize,
    radix: isize,
    allow_underscores: bool,
    prefix: bool,
    limit: u64,
) -> (bool, u64, string) {
    let mut index = start;
    let mut result: u64 = 0;
    let mut saw_digit = false;
    let mut previous_digit = false;
    while index < value.byte_len() {
        let current = value.byte_get(index);
        if current == b'_' {
            let after_prefix = prefix && !saw_digit && index == start;
            if !allow_underscores || (!previous_digit && !after_prefix)
                || index + 1 >= value.byte_len() {
                return (false, 0, "invalid syntax")
            }
            match integer_digit(value.byte_get(index + 1)) {
                Some(digit) => if digit >= radix {
                    return (false, 0, "invalid syntax")
                },
                None => return (false, 0, "invalid syntax"),
            }
            previous_digit = false;
            index += 1;
        } else {
            let Some(digit) = integer_digit(current) else {
                return (false, 0, "invalid syntax");
            };
            if digit >= radix {
                return (false, 0, "invalid syntax")
            }
            let unsigned_digit = digit.to_u64();
            let unsigned_radix = radix.to_u64();
            if result > (limit - unsigned_digit) / unsigned_radix {
                return (false, 0, "value out of range")
            }
            result = result * unsigned_radix + unsigned_digit;
            saw_digit = true;
            previous_digit = true;
            index += 1;
        }
    }
    if !saw_digit || !previous_digit {
        (false, 0, "invalid syntax")
    } else {
        (true, result, "")
    }
}

fn parse_int_value(value: string, radix: isize) -> (bool, isize, string) {
    let mut start = 0;
    let mut negative = false;
    if start < value.byte_len() && (value.byte_get(start) == b'+' || value.byte_get(start) == b'-') {
        negative = value.byte_get(start) == b'-';
        start += 1;
    }
    let (valid_radix, digits_start, actual_radix, prefix) = integer_base(value, start, radix);
    if !valid_radix {
        return (false, 0, "invalid radix")
    }
    let limit: u64 = if negative {
        9223372036854775808
    } else {
        9223372036854775807
    };
    let (valid, magnitude, message) = integer_magnitude(
        value,
        digits_start,
        actual_radix,
        radix == 0,
        prefix,
        limit,
    );
    if !valid {
        (false, 0, message)
    } else if negative && magnitude == 9223372036854775808 {
        (true, -9223372036854775807 - 1, "")
    } else if negative {
        (true, 0 - magnitude.to_isize(), "")
    } else {
        (true, magnitude.to_isize(), "")
    }
}

fn parse_uint_value(value: string, radix: isize) -> (bool, usize, string) {
    let (valid_radix, digits_start, actual_radix, prefix) = integer_base(value, 0, radix);
    if !valid_radix {
        return (false, 0, "invalid radix")
    }
    let (valid, magnitude, message) = integer_magnitude(
        value,
        digits_start,
        actual_radix,
        radix == 0,
        prefix,
        18446744073709551615,
    );
    if valid {
        (true, magnitude.to_usize(), "")
    } else {
        (false, 0, message)
    }
}

fn parse_float32_value(value: string) -> (bool, f32, string) {
    let (valid, parsed) = __goml_builtin_string_parse_float32(value);
    if valid {
        (true, parsed.to_f32(), "")
    } else {
        (false, 0.0, "invalid syntax")
    }
}

fn parse_float64_value(value: string) -> (bool, f64, string) {
    let (valid, parsed) = __goml_builtin_string_parse_float64(value);
    if valid {
        (true, parsed, "")
    } else {
        (false, 0.0, "invalid syntax")
    }
}

pub fn parse_int_structured(value: string) -> Result[isize, ParseIntError] {
    parse_int_radix_structured(value, 10)
}

pub fn parse_int_radix_structured(value: string, radix: isize) -> Result[isize, ParseIntError] {
    let (ok, parsed, message) = parse_int_value(value, radix);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(ParseIntError::new(value, radix, message))
    }
}

pub fn parse_uint_structured(value: string) -> Result[usize, ParseIntError] {
    parse_uint_radix_structured(value, 10)
}

pub fn parse_uint_radix_structured(value: string, radix: isize) -> Result[usize, ParseIntError] {
    let (ok, parsed, message) = parse_uint_value(value, radix);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(ParseIntError::new(value, radix, message))
    }
}

pub fn parse_float32_structured(value: string) -> Result[f32, ParseFloatError] {
    let (ok, parsed, message) = parse_float32_value(value);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(ParseFloatError::new(value, message))
    }
}

pub fn parse_float64_structured(value: string) -> Result[f64, ParseFloatError] {
    let (ok, parsed, message) = parse_float64_value(value);
    if ok {
        Result::Ok(parsed)
    } else {
        Result::Err(ParseFloatError::new(value, message))
    }
}

pub fn checked_add_int64(left: i64, right: i64) -> Option[i64] {
    if right > 0 && left > 9223372036854775807 - right {
        Option::None
    } else if right < 0 && left < -9223372036854775807 - 1 - right {
        Option::None
    } else {
        Option::Some(left + right)
    }
}

pub fn checked_subtract_int64(left: i64, right: i64) -> Option[i64] {
    if right > 0 && left < -9223372036854775807 - 1 + right {
        Option::None
    } else if right < 0 && left > 9223372036854775807 + right {
        Option::None
    } else {
        Option::Some(left - right)
    }
}

pub fn checked_multiply_int64(left: i64, right: i64) -> Option[i64] {
    if left == 0 || right == 0 {
        Option::Some(0)
    } else if left == -9223372036854775807 - 1 && right == -1 {
        Option::None
    } else if right == -9223372036854775807 - 1 && left == -1 {
        Option::None
    } else {
        let result = left * right;
        if result / right == left {
            Option::Some(result)
        } else {
            Option::None
        }
    }
}

pub fn saturating_add_int64(left: i64, right: i64) -> i64 {
    match checked_add_int64(left, right) {
        Some(value) => value,
        None => if right < 0 {
            -9223372036854775807 - 1
        } else {
            9223372036854775807
        },
    }
}

pub fn saturating_subtract_int64(left: i64, right: i64) -> i64 {
    match checked_subtract_int64(left, right) {
        Some(value) => value,
        None => if right < 0 {
            9223372036854775807
        } else {
            -9223372036854775807 - 1
        },
    }
}

pub fn saturating_multiply_int64(left: i64, right: i64) -> i64 {
    match checked_multiply_int64(left, right) {
        Some(value) => value,
        None => if (left < 0) != (right < 0) {
            -9223372036854775807 - 1
        } else {
            9223372036854775807
        },
    }
}
