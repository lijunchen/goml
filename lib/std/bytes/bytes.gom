package bytes;

pub type ByteBuffer = Bytes;

pub struct Bytes {
    pub values: Vec[byte],
}

impl Bytes {
    pub fn new() -> Bytes {
        Bytes { values: Vec::new() }
    }

    pub fn with_capacity(capacity: isize) -> Bytes {
        Bytes { values: Vec::with_capacity(capacity) }
    }

    pub fn from_vec(values: Vec[byte]) -> Bytes {
        Bytes { values }
    }

    pub fn from_string(value: string) -> Bytes {
        Bytes { values: value.to_bytes() }
    }

    pub fn len(self: Bytes) -> isize {
        self.values.len()
    }

    pub fn capacity(self: Bytes) -> isize {
        self.values.capacity()
    }

    pub fn is_empty(self: Bytes) -> bool {
        self.values.is_empty()
    }

    pub fn get(self: Bytes, index: isize) -> byte {
        self.values[index]
    }

    pub fn get_checked(self: Bytes, index: isize) -> Option[byte] {
        self.values.get_checked(index)
    }

    pub fn set(self: Bytes, index: isize, value: byte) -> unit {
        self.values[index] = value;
    }

    pub fn set_checked(self: Bytes, index: isize, value: byte) -> bool {
        self.values.as_mut_slice().set_checked(index, value)
    }

    pub fn push(self: Bytes, value: byte) -> unit {
        self.values.push(value)
    }

    pub fn pop(self: Bytes) -> Option[byte] {
        self.values.pop()
    }

    pub fn reserve(self: Bytes, additional: isize) -> unit {
        self.values.reserve(additional)
    }

    pub fn truncate(self: Bytes, len: isize) -> unit {
        self.values.truncate(len)
    }

    pub fn clear(self: Bytes) -> unit {
        self.values.clear()
    }

    pub fn slice(self: Bytes, start: isize, end: isize) -> Slice[byte] {
        self.values.slice(start, end)
    }

    pub fn slice_checked(self: Bytes, start: isize, end: isize) -> Option[Slice[byte]] {
        self.values.slice_checked(start, end)
    }

    pub fn as_slice(self: Bytes) -> Slice[byte] {
        self.values.as_slice()
    }

    pub fn slice_mut(self: Bytes, start: isize, end: isize) -> MutSlice[byte] {
        self.values.slice_mut(start, end)
    }

    pub fn slice_mut_checked(self: Bytes, start: isize, end: isize) -> Option[MutSlice[byte]] {
        self.values.slice_mut_checked(start, end)
    }

    pub fn as_mut_slice(self: Bytes) -> MutSlice[byte] {
        self.values.as_mut_slice()
    }

    pub fn extend_from_slice(self: Bytes, source: Slice[byte]) -> unit {
        self.values.reserve(source.len());
        for value in source {
            self.values.push(value)
        }
    }

    pub fn to_vec(self: Bytes) -> Vec[byte] {
        self.values
    }

    pub fn to_string(self: Bytes) -> Result[string, string] {
        let (valid, value) = string_from_utf8(self.values);
        if valid {
            Result::Ok(value)
        } else {
            Result::Err("invalid UTF-8")
        }
    }

    pub fn builder() -> Builder {
        Builder::new()
    }
}
