package builtin;

trait Iterator {
    type Item;
    fn next(self: Self) -> Option[Self::Item];
}

trait IntoIterator {
    type Item;
    type IntoIter: Iterator;
    fn into_iter(self: Self) -> Self::IntoIter;
}

struct FnIterator[T] {
    next_fn: () -> Option[T],
}

struct OnceCell[T] {}

struct FrozenVec[T] {
    values: Vec[T],
}
