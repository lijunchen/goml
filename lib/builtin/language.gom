package builtin;

#[lang("range")]
fn __goml_builtin_range(start: int, end: int) -> FnIterator[int] {
    let mut current = start;
    FnIterator::from_fn(
        || {
            let value = current;
            if value < end {
                current = value + 1;
                Option::Some(value)
            } else {
                Option::None
            }
        },
    )
}

#[lang("range_inclusive")]
fn __goml_builtin_range_inclusive(start: int, end: int) -> FnIterator[int] {
    let mut current = start;
    let mut finished = false;
    FnIterator::from_fn(
        || {
            if finished || current > end {
                Option::None
            } else {
                let value = current;
                if value == end {
                    finished = true;
                } else {
                    current = value + 1;
                };
                Option::Some(value)
            }
        },
    )
}
