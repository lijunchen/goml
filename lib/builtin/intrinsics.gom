package builtin;

#[runtime("core.unit_to_string")]
pub extern fn unit_to_string(value: unit) -> string;

#[runtime("core.bool_to_string")]
pub extern fn bool_to_string(value: bool) -> string;

#[runtime("core.string_len")]
pub extern fn string_len(value: string) -> int;

#[runtime("core.string_byte_get")]
pub extern fn string_byte_get(value: string, index: int) -> byte;

#[runtime("core.string_to_bytes")]
pub extern fn string_to_bytes(value: string) -> Vec[byte];

#[runtime("core.string_concat")]
pub extern fn string_concat(values: Vec[string]) -> string;

#[runtime("core.char_from_uint32")]
pub extern fn char_from_uint32_raw(value: uint32) -> (bool, char);

#[runtime("core.int_to_string")]
pub extern fn int_to_string(value: int) -> string;

#[runtime("core.int8_to_string")]
pub extern fn int8_to_string(value: int8) -> string;

#[runtime("core.int16_to_string")]
pub extern fn int16_to_string(value: int16) -> string;

#[runtime("core.int32_to_string")]
pub extern fn int32_to_string(value: int32) -> string;

#[runtime("core.int64_to_string")]
pub extern fn int64_to_string(value: int64) -> string;

#[runtime("core.uint_to_string")]
pub extern fn uint_to_string(value: uint) -> string;

#[runtime("core.uint8_to_string")]
pub extern fn uint8_to_string(value: uint8) -> string;

#[runtime("core.uint16_to_string")]
pub extern fn uint16_to_string(value: uint16) -> string;

#[runtime("core.uint32_to_string")]
pub extern fn uint32_to_string(value: uint32) -> string;

#[runtime("core.uint64_to_string")]
pub extern fn uint64_to_string(value: uint64) -> string;

#[runtime("core.float32_to_string")]
pub extern fn float32_to_string(value: float32) -> string;

#[runtime("core.float64_to_string")]
pub extern fn float64_to_string(value: float64) -> string;

#[runtime("core.string_parse_float32")]
pub extern fn string_parse_float32(value: string) -> (bool, float64);

#[runtime("core.string_parse_float64")]
pub extern fn string_parse_float64(value: string) -> (bool, float64);

#[runtime("core.int_hash")]
pub extern fn int_hash(value: int) -> uint64;

#[runtime("core.int8_hash")]
pub extern fn int8_hash(value: int8) -> uint64;

#[runtime("core.int16_hash")]
pub extern fn int16_hash(value: int16) -> uint64;

#[runtime("core.int32_hash")]
pub extern fn int32_hash(value: int32) -> uint64;

#[runtime("core.int64_hash")]
pub extern fn int64_hash(value: int64) -> uint64;

#[runtime("core.uint_hash")]
pub extern fn uint_hash(value: uint) -> uint64;

#[runtime("core.uint8_hash")]
pub extern fn uint8_hash(value: uint8) -> uint64;

#[runtime("core.uint16_hash")]
pub extern fn uint16_hash(value: uint16) -> uint64;

#[runtime("core.uint32_hash")]
pub extern fn uint32_hash(value: uint32) -> uint64;

#[runtime("core.float32_hash")]
pub extern fn float32_hash(value: float32) -> uint64;

#[runtime("core.float64_hash")]
pub extern fn float64_hash(value: float64) -> uint64;

#[runtime("core.string_hash")]
pub extern fn string_hash(value: string) -> uint64;

#[runtime("core.char_hash")]
pub extern fn char_hash(value: char) -> uint64;

#[runtime("core.string_print")]
pub extern fn string_print(value: string) -> unit;

#[runtime("core.string_println")]
pub extern fn string_println(value: string) -> unit;

#[intrinsic("vec.new")]
pub extern fn vec_new[T]() -> Vec[T];

#[intrinsic("vec.with_capacity")]
pub extern fn vec_with_capacity[T](capacity: int) -> Vec[T];

#[intrinsic("vec.push")]
pub extern fn vec_push[T](values: Vec[T], value: T) -> unit;

#[intrinsic("vec.get")]
pub extern fn vec_get[T](values: Vec[T], index: int) -> T;

#[intrinsic("vec.set")]
pub extern fn vec_set[T](values: Vec[T], index: int, value: T) -> unit;

#[intrinsic("vec.len")]
pub extern fn vec_len[T](values: Vec[T]) -> int;

#[intrinsic("vec.capacity")]
pub extern fn vec_capacity[T](values: Vec[T]) -> int;

#[intrinsic("vec.reserve")]
pub extern fn vec_reserve[T](values: Vec[T], additional: int) -> unit;

#[intrinsic("vec.truncate")]
pub extern fn vec_truncate[T](values: Vec[T], length: int) -> unit;

#[intrinsic("once_cell.new")]
pub extern fn once_cell_new[T]() -> OnceCell[T];

#[intrinsic("once_cell.get_or_init")]
pub extern fn once_cell_get_or_init[T](cell: OnceCell[T], init: () -> T) -> T;

#[intrinsic("slice.new")]
pub extern fn slice[T](values: Vec[T], start: int, end: int) -> Slice[T];

#[intrinsic("slice.get")]
pub extern fn slice_get[T](values: Slice[T], index: int) -> T;

#[intrinsic("slice.len")]
pub extern fn slice_len[T](values: Slice[T]) -> int;

#[intrinsic("slice.sub")]
pub extern fn slice_sub[T](values: Slice[T], start: int, end: int) -> Slice[T];

#[intrinsic("hashmap.new")]
pub extern fn hashmap_new[K: Hash + Eq, V]() -> HashMap[K, V];

#[intrinsic("hashmap.get")]
pub extern fn hashmap_get[K: Hash + Eq, V](values: HashMap[K, V], key: K) -> Option[V];

#[intrinsic("hashmap.set")]
pub extern fn hashmap_set[K: Hash + Eq, V](values: HashMap[K, V], key: K, value: V) -> unit;

#[intrinsic("hashmap.remove")]
pub extern fn hashmap_remove[K: Hash + Eq, V](values: HashMap[K, V], key: K) -> unit;

#[intrinsic("hashmap.len")]
pub extern fn hashmap_len[K: Hash + Eq, V](values: HashMap[K, V]) -> int;

#[intrinsic("hashmap.contains")]
pub extern fn hashmap_contains[K: Hash + Eq, V](values: HashMap[K, V], key: K) -> bool;

#[intrinsic("hashmap.entries")]
pub extern fn hashmap_entries[K: Hash + Eq, V](values: HashMap[K, V]) -> Vec[(K, V)];

#[intrinsic("channel.new")]
pub extern fn channel_new[T](capacity: int) -> Channel[T];

#[intrinsic("channel.send")]
pub extern fn channel_send[T](channel: Channel[T], value: T) -> unit;

#[intrinsic("channel.recv")]
pub extern fn channel_recv[T](channel: Channel[T]) -> (T, bool);

#[intrinsic("channel.send_cancel")]
pub extern fn channel_send_cancel[T](channel: Channel[T], value: T, cancel: int64) -> bool;

#[intrinsic("channel.recv_cancel")]
pub extern fn channel_recv_cancel[T](channel: Channel[T], cancel: int64) -> (T, bool, bool);

#[intrinsic("channel.close")]
pub extern fn channel_close[T](channel: Channel[T]) -> unit;

#[intrinsic("channel.sender")]
pub extern fn channel_sender[T](channel: Channel[T]) -> Sender[T];

#[intrinsic("channel.receiver")]
pub extern fn channel_receiver[T](channel: Channel[T]) -> Receiver[T];

#[intrinsic("channel.split")]
pub extern fn channel_split[T](channel: Channel[T]) -> (Sender[T], Receiver[T]);

#[intrinsic("channel.send")]
pub extern fn sender_send[T](channel: Sender[T], value: T) -> unit;

#[intrinsic("channel.recv")]
pub extern fn receiver_recv[T](channel: Receiver[T]) -> (T, bool);

#[intrinsic("channel.close")]
pub extern fn sender_close[T](channel: Sender[T]) -> unit;

#[intrinsic("channel.dynamic_select")]
pub extern fn channel_dynamic_select[T](
    kinds: Slice[int],
    receivers: Slice[Receiver[T]],
    senders: Slice[Sender[T]],
    values: Slice[T],
) -> (int, int, T, bool, bool);

#[intrinsic("channel.dynamic_try_select")]
pub extern fn channel_dynamic_try_select[T](
    kinds: Slice[int],
    receivers: Slice[Receiver[T]],
    senders: Slice[Sender[T]],
    values: Slice[T],
) -> (int, int, T, bool, bool);

#[intrinsic("channel.dynamic_try_select_priority")]
pub extern fn channel_dynamic_try_select_priority[T](
    kinds: Slice[int],
    receivers: Slice[Receiver[T]],
    senders: Slice[Sender[T]],
    values: Slice[T],
) -> (int, int, T, bool, bool);

#[intrinsic("ref.new")]
pub extern fn ref[T](value: T) -> Ref[T];

#[intrinsic("ref.get")]
pub extern fn ref_get[T](reference: Ref[T]) -> T;

#[intrinsic("ref.set")]
pub extern fn ref_set[T](reference: Ref[T], value: T) -> unit;

#[intrinsic("ref.ptr_eq")]
pub extern fn ptr_eq[T](left: Ref[T], right: Ref[T]) -> bool;

#[intrinsic("ref.ptr_hash")]
pub extern fn ptr_hash[T](reference: Ref[T]) -> uint64;

#[intrinsic("compiler.missing")]
pub extern fn missing[T](message: string) -> T;
