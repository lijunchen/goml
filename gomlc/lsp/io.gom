package lsp;

use std::bytes;
use std::io;
use std::json;

fn read_stdin_line() -> Result[bytes::Bytes, string] {
    let data = bytes::Bytes::new();
    loop {
        match io::read_stdin_exact(1) {
            Ok(chunk) => {
                let value = chunk.get(0);
                data.push(value);
                if value == 10 {
                    return Result::Ok(data)
                } else {}
            },
            Err(error) => if !data.is_empty() {
                return Result::Ok(data)
            } else {
                return Result::Err(error)
            },
        }
    }
}

pub fn read_rpc_payload() -> Result[string, string] {
    let mut length: Option[int] = Option::None;
    let length = loop {
        let line = read_stdin_line()?.to_string()?;
        if header_line_content(line) == "" {
            break length
        } else if is_content_length_header(line) {
            match length {
                Some(_) => {
                    return Result::Err("duplicate Content-Length header")
                },
                None => match content_length(line) {
                    Ok(value) => {
                        length = Option::Some(value);
                    },
                    Err(error) => return Result::Err(error),
                },
            }
        } else {}
    };
    match length {
        Some(length) => match io::read_stdin_exact(length) {
            Ok(data) => data.to_string(),
            Err(error) => Result::Err(error),
        },
        None => Result::Err("missing Content-Length header"),
    }
}

pub fn write_rpc_message(value: json::Value) -> Result[unit, string] {
    io::write_stdout(bytes::Bytes::from_string(framed_json(value)))
}
