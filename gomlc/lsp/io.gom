package lsp;

use std::bytes;
use std::io;
use std::json;
use std::utf8;
use utf8::BytesUtf8;

fn read_stdin_line() -> Result[bytes::Bytes, string] {
    let data = bytes::Bytes::new();
    loop {
        match io::read_stdin_exact_structured(1) {
            Ok(chunk) => {
                let value = chunk.get(0);
                data.push(value);
                if value == 10 {
                    return Result::Ok(data)
                } else {}
            },
            Err(error) => if !data.is_empty() {
                return Result::Ok(data)
            } else {
                return Result::Err(error.to_string())
            },
        }
    }
}

pub fn read_rpc_payload() -> Result[string, string] {
    let mut length: Option[isize] = Option::None;
    let length = loop {
        let line = read_stdin_line()?.to_string_utf8().map_err(|error| error.to_string())?;
        if header_line_content(line) == "" {
            break length
        } else if is_content_length_header(line) {
            match length {
                Some(_) => {
                    return Result::Err("duplicate Content-Length header")
                },
                None => match content_length(line) {
                    Ok(value) => {
                        length = Option::Some(value);
                    },
                    Err(error) => return Result::Err(error),
                },
            }
        } else {}
    };
    match length {
        Some(length) => match io::read_stdin_exact_structured(length) {
            Ok(data) => data.to_string_utf8().map_err(|error| error.to_string()),
            Err(error) => Result::Err(error.to_string()),
        },
        None => Result::Err("missing Content-Length header"),
    }
}

pub fn write_rpc_message(value: json::Value) -> Result[(), string] {
    io::write_stdout_structured(bytes::Bytes::from_string(framed_json(value))).map_err(
        |error| error.to_string(),
    )
}
