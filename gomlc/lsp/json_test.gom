package lsp;

use std::json;
use std::testing;

#[test]
fn parses_and_encodes_json_values() -> unit {
    let input = "{\"name\":\"GoML\\n语言\",\"id\":42,\"ok\":true,\"items\":[null,\"x\"]}";
    match json::parse(input) {
        Ok(value) => {
            match json::field(value, "name") {
                Some(name) => match json::as_string(name) {
                    Some(text) => {
                        testing::assert_eq(text, "GoML\n语言")
                    },
                    None => testing::fail("expected string name"),
                },
                None => testing::fail("expected name"),
            };
            match json::parse(json::encode(value)) {
                Ok(roundtrip) => match json::field(roundtrip, "id") {
                    Some(id) => match json::as_int(id) {
                        Some(number) => testing::assert_eq(number, 42),
                        None => testing::fail("expected integer id"),
                    },
                    None => testing::fail("expected id"),
                },
                Err(error) => testing::fail(error),
            }
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn rejects_invalid_json() -> unit {
    match json::parse("{\"bad\": [1,]}") {
        Ok(_) => testing::fail("expected invalid JSON"),
        Err(_) => (),
    };
    match json::parse("01") {
        Ok(_) => testing::fail("expected invalid number"),
        Err(_) => (),
    };
    match json::parse("\"\\ud83d\\ude00\"") {
        Ok(String(value)) => {
            testing::assert_eq(value, "😀")
        },
        Ok(_) => testing::fail("expected string"),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn converts_utf16_positions_and_file_uris() -> unit {
    let source = "a😀中\nx";
    let position = offset_to_position(source, 5);
    testing::assert_eq(position.line, 0);
    testing::assert_eq(position.character, 3);
    testing::assert_eq(position_to_offset(source, Position { line: 0, character: 3 }), 5);
    match position_to_offset_checked(source, Position { line: 0, character: 2 }) {
        Some(_) => testing::fail("expected invalid surrogate position"),
        None => (),
    };
    let uri = path_to_uri("/tmp/GoML 语言/main.gom");
    match uri_to_path(uri) {
        Ok(value) => {
            testing::assert_eq(value, "/tmp/GoML 语言/main.gom")
        },
        Err(error) => testing::fail(error),
    };
    match uri_to_path("file:///tmp/%FF.gom") {
        Err(error) => testing::assert_eq(error, "URI path is not valid UTF-8"),
        Ok(_) => testing::fail("expected invalid UTF-8 URI"),
    }
}

#[test]
fn converts_crlf_and_cr_line_endings_without_column_drift() -> unit {
    let source = "α\r\n😀x\ry";
    let emoji_end = offset_to_position(source, 8);
    testing::assert_eq(emoji_end.line, 1);
    testing::assert_eq(emoji_end.character, 2);
    let second_line_end = offset_to_position(source, 9);
    testing::assert_eq(second_line_end.line, 1);
    testing::assert_eq(second_line_end.character, 3);
    let third_line = offset_to_position(source, 10);
    testing::assert_eq(third_line.line, 2);
    testing::assert_eq(third_line.character, 0);
    testing::assert_eq(position_to_offset(source, Position { line: 1, character: 2 }), 8);
    testing::assert_eq(position_to_offset(source, Position { line: 2, character: 0 }), 10);
    testing::assert(
        position_to_offset_checked(source, Position { line: 1, character: 1 }).is_none(),
    )
}

#[test]
fn frames_and_parses_json_rpc_metadata() -> unit {
    let message = rpc_success(json::Value::Number("7"), json::Value::String("ok"));
    let framed = framed_json(message);
    let body = json::encode(message);
    testing::assert_eq(framed, "Content-Length: " + body.byte_len().to_string() + "\r\n\r\n" + body);
    match content_length("Content-Length: 123\r\n") {
        Ok(value) => testing::assert_eq(value, 123),
        Err(error) => testing::fail(error),
    };
    match content_length("content-length:\t42\n") {
        Ok(value) => testing::assert_eq(value, 42),
        Err(error) => testing::fail(error),
    };
    testing::assert(is_content_length_header("Content-Length: 123\r\n"));
    testing::assert(is_content_length_header("CONTENT-LENGTH: 123\r\n"));
    testing::assert(
        !is_content_length_header("Content-Type: application/vscode-jsonrpc; charset=utf-8\r\n"),
    )
}
