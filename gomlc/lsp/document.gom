package lsp;

use module::line_index as text_index;
use module::query;

pub struct Document {
    pub uri: string,
    pub path: string,
    pub text: string,
    pub version: isize,
    pub line_index: text_index::LineIndex,
}

struct CachedAnalysis {
    path: string,
    generation: isize,
    analysis: query::Analysis,
}

struct CachedLineIndex {
    path: string,
    generation: isize,
    index: text_index::LineIndex,
}

pub struct Server {
    documents: Vec[Document],
    analyses: Vec[CachedAnalysis],
    line_indexes: Vec[CachedLineIndex],
    analysis_context: query::AnalysisContext,
    generation: Ref[isize],
    running: Ref[bool],
    shutdown: Ref[bool],
}

pub fn new_server() -> Server {
    Server {
        documents: Vec::new(),
        analyses: Vec::new(),
        line_indexes: Vec::new(),
        analysis_context: query::analysis_context(),
        generation: Ref::new(0),
        running: Ref::new(true),
        shutdown: Ref::new(false),
    }
}

pub fn server_running(value: Server) -> bool {
    value.running.get()
}

fn advance_generation(value: Server) -> () {
    value.generation.set(value.generation.get() + 1);
    value.line_indexes.clear()
}

pub fn invalidate_analyses(value: Server) -> () {
    value.analyses.clear();
    advance_generation(value)
}

fn invalidate_other_analyses(value: Server, path: string) -> () {
    let mut index = value.analyses.len();
    while index > 0 {
        index = index - 1;
        if value.analyses[index].path != path {
            let _ = value.analyses.remove(index);
        } else {}
    }
    advance_generation(value)
}

fn analysis_index(value: Server, path: string) -> Option[isize] {
    let mut index = value.analyses.len() - 1;
    while index >= 0 {
        if value.analyses[index].path == path {
            return Option::Some(index)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn document_index(value: Server, uri: string) -> Option[isize] {
    let mut index = value.documents.len() - 1;
    while index >= 0 {
        if value.documents[index].uri == uri {
            return Option::Some(index)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

pub fn server_document(value: Server, uri: string) -> Option[Document] {
    match document_index(value, uri) {
        Some(index) => Option::Some(value.documents[index]),
        None => Option::None,
    }
}

fn source_line_index(value: Server, source_path: string, source: string) -> text_index::LineIndex {
    let mut document_cursor = value.documents.len() - 1;
    while document_cursor >= 0 {
        let document = value.documents[document_cursor];
        if document.path == source_path {
            return document.line_index
        } else {
            document_cursor = document_cursor - 1;
        }
    }
    let mut index_cursor = value.line_indexes.len() - 1;
    while index_cursor >= 0 {
        let cached = value.line_indexes[index_cursor];
        if cached.path == source_path && cached.generation == value.generation.get() {
            return cached.index
        } else {
            index_cursor = index_cursor - 1;
        }
    }
    let index = line_index(source);
    value.line_indexes.push(
        CachedLineIndex { path: source_path, generation: value.generation.get(), index },
    );
    index
}

pub fn open_document(value: Server, document: Document) -> () {
    let path = document.path;
    match document_index(value, document.uri) {
        Some(index) => value.documents.set(index, document),
        None => value.documents.push(document),
    };
    invalidate_other_analyses(value, path)
}

pub fn change_document(value: Server, uri: string, text: string, version: isize) -> () {
    match document_index(value, uri) {
        Some(index) => {
            let current = value.documents[index];
            value.documents.set(
                index,
                Document {
                    uri: current.uri,
                    path: current.path,
                    text,
                    version,
                    line_index: line_index(text),
                },
            );
            invalidate_other_analyses(value, current.path)
        },
        None => (),
    }
}

pub fn close_document(value: Server, uri: string) -> () {
    match document_index(value, uri) {
        Some(index) => {
            let _ = value.documents.remove(index);
            invalidate_analyses(value)
        },
        None => (),
    }
}

pub fn cached_document_analysis(value: Server, document: Document) -> Option[query::Analysis] {
    match analysis_index(value, document.path) {
        Some(index) => Option::Some(value.analyses[index].analysis),
        None => Option::None,
    }
}

fn source_overrides(value: Server) -> Vec[query::SourceOverride] {
    let result: Vec[query::SourceOverride] = Vec::new();
    for document in value.documents {
        result.push(query::SourceOverride { path: document.path, source: document.text })
    }
    result
}

pub fn document_analysis(value: Server, document: Document) -> query::Analysis {
    match analysis_index(value, document.path) {
        Some(index) => {
            let cached = value.analyses[index];
            if cached.path == document.path && cached.generation == value.generation.get() {
                return cached.analysis
            } else {}
        },
        None => (),
    };
    let analysis = query::analyze_with_context(
        value.analysis_context,
        document.path,
        document.text,
        source_overrides(value),
    );
    let cached = CachedAnalysis {
        path: document.path,
        generation: value.generation.get(),
        analysis,
    };
    match analysis_index(value, document.path) {
        Some(index) => value.analyses.set(index, cached),
        None => value.analyses.push(cached),
    };
    analysis
}
