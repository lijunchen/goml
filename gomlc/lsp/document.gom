package lsp;

use gomlc::query;

pub struct Document {
    pub uri: string,
    pub path: string,
    pub text: string,
    pub version: int,
}

struct CachedAnalysis {
    path: string,
    generation: int,
    analysis: query::Analysis,
}

pub struct Server {
    documents: Vec[Document],
    analyses: Vec[CachedAnalysis],
    generation: Ref[int],
    running: Ref[bool],
    shutdown: Ref[bool],
}

pub fn new_server() -> Server {
    Server {
        documents: Vec::new(),
        analyses: Vec::new(),
        generation: Ref::new(0),
        running: Ref::new(true),
        shutdown: Ref::new(false),
    }
}

pub fn server_running(value: Server) -> bool {
    value.running.get()
}

pub fn invalidate_analyses(value: Server) -> unit {
    value.generation.set(value.generation.get() + 1);
    value.analyses.clear()
}

fn document_index(value: Server, uri: string) -> Option[int] {
    let index = Ref::new(value.documents.len() - 1);
    while index.get() >= 0 {
        if value.documents[index.get()].uri == uri {
            return Option::Some(index.get())
        } else {
            index.set(index.get() - 1)
        }
    };
    Option::None
}

pub fn server_document(value: Server, uri: string) -> Option[Document] {
    match document_index(value, uri) {
        Some(index) => Option::Some(value.documents[index]),
        None => Option::None,
    }
}

pub fn open_document(value: Server, document: Document) -> unit {
    match document_index(value, document.uri) {
        Some(index) => value.documents.set(index, document),
        None => value.documents.push(document),
    };
    invalidate_analyses(value)
}

pub fn change_document(value: Server, uri: string, text: string, version: int) -> unit {
    match document_index(value, uri) {
        Some(index) => {
            let current = value.documents[index];
            value.documents.set(
                index,
                Document { uri: current.uri, path: current.path, text, version },
            );
            invalidate_analyses(value)
        },
        None => (),
    }
}

pub fn close_document(value: Server, uri: string) -> unit {
    match document_index(value, uri) {
        Some(index) => {
            let _ = value.documents.remove(index);
            invalidate_analyses(value)
        },
        None => (),
    }
}

fn source_overrides(value: Server) -> Vec[query::SourceOverride] {
    let result = Vec::new();
    for document in value.documents {
        result.push(query::SourceOverride { path: document.path, source: document.text })
    };
    result
}

pub fn document_analysis(value: Server, document: Document) -> query::Analysis {
    let index = Ref::new(value.analyses.len() - 1);
    while index.get() >= 0 {
        let cached = value.analyses[index.get()];
        if cached.path == document.path && cached.generation == value.generation.get() {
            return cached.analysis
        } else {
            index.set(index.get() - 1)
        }
    };
    let analysis = query::analyze_with_overrides(
        document.path,
        document.text,
        source_overrides(value),
    );
    value.analyses.push(
        CachedAnalysis { path: document.path, generation: value.generation.get(), analysis },
    );
    analysis
}
