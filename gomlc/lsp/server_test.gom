package lsp;

use gomlc::version;
use std::json;
use std::testing;

fn response_result(value: json::Value) -> Option[json::Value] {
    json::field(value, "result")
}

#[test]
fn initializes_and_answers_hover_requests() -> unit {
    let server = new_server();
    match handle_payload(
        server,
        "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}",
    ) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            match response_result(messages.get(0)) {
                Some(result) => match json::field(result, "serverInfo") {
                    Some(info) => match json::field(info, "name") {
                        Some(name) => match json::as_string(name) {
                            Some(name) => {
                                testing::assert_eq(name, "gomllsp");
                                match json::field(info, "version") {
                                    Some(value) => match json::as_string(value) {
                                        Some(value) => testing::assert_eq(value, version::current()),
                                        None => testing::fail("expected server version"),
                                    },
                                    None => testing::fail("expected server version"),
                                }
                            },
                            None => testing::fail("expected server name"),
                        },
                        None => testing::fail("expected server name"),
                    },
                    None => testing::fail("expected server info"),
                },
                None => testing::fail("expected initialize result"),
            }
        },
        Err(error) => testing::fail(error),
    };
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/gomllsp-test.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> int32 { let value = 42; value }\"}}}";
    match handle_payload(server, open) {
        Ok(messages) => testing::assert_eq(messages.len(), 1),
        Err(error) => testing::fail(error),
    };
    let hover = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/gomllsp-test.gom\"},\"position\":{\"line\":0,\"character\":38}}}";
    match handle_payload(server, hover) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            match response_result(messages.get(0)) {
                Some(result) => match json::field(result, "contents") {
                    Some(contents) => match json::field(contents, "value") {
                        Some(value) => match json::as_string(value) {
                            Some(value) => {
                                testing::assert_eq(value, "```goml\nint32\n```")
                            },
                            None => testing::fail("expected hover text"),
                        },
                        None => testing::fail("expected hover value"),
                    },
                    None => testing::fail("expected hover contents"),
                },
                None => testing::fail("expected hover result"),
            }
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn returns_expanded_derive_source() -> unit {
    let server = new_server();
    let source = "#[derive(PartialEq, Eq)] struct Key { value: int } fn main() -> unit { () }";
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/expanded.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\""
        + source
        + "\"}}}";
    match handle_payload(server, open) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    let request = "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"goml/expandedDerive\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/expanded.gom\"}}}";
    match handle_payload(server, request) {
        Ok(messages) => match response_result(messages.get(0)) {
            Some(result) => match json::as_string(result) {
                Some(value) => {
                    testing::assert(value.contains("impl PartialEq for Key"));
                    testing::assert(value.contains("impl Eq for Key"))
                },
                None => testing::fail("expected expanded derive source"),
            },
            None => testing::fail("expected expanded derive result"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn applies_full_document_changes_and_stops_on_exit() -> unit {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/gomllsp-change.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> int32 { 1 }\"}}}";
    match handle_payload(server, open) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    let change = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/gomllsp-change.gom\",\"version\":2},\"contentChanges\":[{\"text\":\"fn main() -> int32 { 2 }\"}]}}";
    match handle_payload(server, change) {
        Ok(_) => match server_document(server, "file:///tmp/gomllsp-change.gom") {
            Some(document) => {
                testing::assert_eq(document.version, 2);
                testing::assert_eq(document.text, "fn main() -> int32 { 2 }")
            },
            None => testing::fail("expected changed document"),
        },
        Err(error) => testing::fail(error),
    };
    let _ = handle_payload(server, "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
    testing::assert(!server_running(server))
}

#[test]
fn keeps_cached_analysis_when_an_open_document_is_saved() -> unit {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/gomllsp-save.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> int { 1 }\"}}}";
    match handle_payload(server, open) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    testing::assert_eq(server.analyses.len(), 1);
    let generation = server.generation.get();
    let save = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didSave\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/gomllsp-save.gom\"}}}";
    match handle_payload(server, save) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    testing::assert_eq(server.analyses.len(), 1);
    testing::assert_eq(server.generation.get(), generation)
}

#[test]
fn returns_run_test_code_lenses() -> unit {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/value_test.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"package value;\\n#[test]\\nfn works() -> unit { () }\\n\"}}}";
    match handle_payload(server, open) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    let request = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/codeLens\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/value_test.gom\"}}}";
    match handle_payload(server, request) {
        Ok(messages) => match response_result(messages.get(0)) {
            Some(result) => match json::as_array(result) {
                Some(lenses) => {
                    testing::assert_eq(lenses.len(), 1);
                    match json::field(lenses.get(0), "command") {
                        Some(command) => match json::field(command, "command") {
                            Some(value) => match json::as_string(value) {
                                Some(value) => {
                                    testing::assert_eq(value, "goml.runTest")
                                },
                                None => {
                                    testing::fail("expected command name")
                                },
                            },
                            None => testing::fail("expected command"),
                        },
                        None => testing::fail("expected code lens command"),
                    }
                },
                None => testing::fail("expected code lenses"),
            },
            None => testing::fail("expected code lens result"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn converts_diagnostic_fixes_to_code_actions() -> unit {
    let server = new_server();
    let request = "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/main.gom\"},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"context\":{\"diagnostics\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"message\":\"replace\",\"data\":{\"fixes\":[{\"uri\":\"file:///tmp/main.gom\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"replacement\":\"x\",\"title\":\"Replace value\",\"preferred\":true}]}}]}}}";
    match handle_payload(server, request) {
        Ok(messages) => match response_result(messages.get(0)) {
            Some(result) => match json::as_array(result) {
                Some(actions) => {
                    testing::assert_eq(actions.len(), 1);
                    match json::field(actions.get(0), "title") {
                        Some(value) => match json::as_string(value) {
                            Some(value) => {
                                testing::assert_eq(value, "Replace value")
                            },
                            None => testing::fail("expected title"),
                        },
                        None => testing::fail("expected action title"),
                    }
                },
                None => testing::fail("expected code actions"),
            },
            None => testing::fail("expected code action result"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn returns_null_when_no_code_actions_apply() -> unit {
    let server = new_server();
    let request = "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"textDocument/codeAction\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/main.gom\"},\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"context\":{\"diagnostics\":[]}}}";
    match handle_payload(server, request) {
        Ok(messages) => match response_result(messages.get(0)) {
            Some(Null) => (),
            Some(_) => testing::fail("expected null code actions"),
            None => testing::fail("expected code action result"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn reports_json_rpc_parse_and_invalid_request_errors() -> unit {
    let server = new_server();
    match handle_payload(server, "{") {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            match json::field(messages.get(0), "error") {
                Some(error) => match json::field(error, "code") {
                    Some(code) => match json::as_int(code) {
                        Some(code) => testing::assert_eq(code, -32700),
                        None => testing::fail("expected parse code"),
                    },
                    None => testing::fail("expected parse error code"),
                },
                None => testing::fail("expected parse error"),
            }
        },
        Err(error) => testing::fail(error),
    };
    match handle_payload(server, "{\"jsonrpc\":\"1.0\",\"id\":1,\"method\":\"initialize\"}") {
        Ok(messages) => match json::field(messages.get(0), "error") {
            Some(error) => match json::field(error, "code") {
                Some(code) => match json::as_int(code) {
                    Some(code) => testing::assert_eq(code, -32600),
                    None => testing::fail("expected request code"),
                },
                None => testing::fail("expected request error code"),
            },
            None => testing::fail("expected invalid request error"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn filters_inlay_hints_to_the_requested_range() -> unit {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/inlay.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> unit {\\n    let first = 1;\\n    let second = 2;\\n    ()\\n}\"}}}";
    match handle_payload(server, open) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    let request = "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/inlayHint\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/inlay.gom\"},\"range\":{\"start\":{\"line\":2,\"character\":0},\"end\":{\"line\":3,\"character\":0}}}}";
    match handle_payload(server, request) {
        Ok(messages) => match response_result(messages.get(0)) {
            Some(result) => match json::as_array(result) {
                Some(hints) => {
                    testing::assert_eq(hints.len(), 1);
                    match json::field(hints.get(0), "label") {
                        Some(label) => match json::as_string(label) {
                            Some(label) => {
                                testing::assert_eq(label, ": int")
                            },
                            None => testing::fail("expected hint label"),
                        },
                        None => testing::fail("expected hint"),
                    }
                },
                None => testing::fail("expected inlay hints"),
            },
            None => testing::fail("expected inlay result"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn rejects_requests_after_shutdown() -> unit {
    let server = new_server();
    let shutdown = "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"shutdown\"}";
    match handle_payload(server, shutdown) {
        Ok(messages) => testing::assert_eq(messages.len(), 1),
        Err(error) => testing::fail(error),
    };
    let request = "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"initialize\"}";
    match handle_payload(server, request) {
        Ok(messages) => match json::field(messages.get(0), "error") {
            Some(error) => match json::field(error, "code") {
                Some(code) => match json::as_int(code) {
                    Some(code) => testing::assert_eq(code, -32600),
                    None => testing::fail("expected shutdown code"),
                },
                None => testing::fail("expected shutdown error code"),
            },
            None => testing::fail("expected shutdown error"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn includes_diagnostics_in_hover() -> unit {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/hover-error.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> int32 { missing }\"}}}";
    match handle_payload(server, open) {
        Ok(_) => (),
        Err(error) => testing::fail(error),
    };
    let request = "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/hover-error.gom\"},\"position\":{\"line\":0,\"character\":21}}}";
    match handle_payload(server, request) {
        Ok(messages) => match response_result(messages.get(0)) {
            Some(result) => match json::field(result, "contents") {
                Some(contents) => match json::field(contents, "value") {
                    Some(value) => match json::as_string(value) {
                        Some(value) => testing::assert(value.contains("**Diagnostics**")),
                        None => testing::fail("expected hover text"),
                    },
                    None => testing::fail("expected hover value"),
                },
                None => testing::fail("expected hover contents"),
            },
            None => testing::fail("expected hover result"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn publishes_recovered_parser_diagnostics_at_utf16_positions() -> unit {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/recovery.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> unit {\\r\\n    let text = \\\"中\\\"\\r\\n    println(text);\\r\\n}\\r\\n\"}}}";
    match handle_payload(server, open) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            let encoded = json::encode(messages.get(0));
            testing::assert(encoded.contains("expect \\\";\\\""));
            testing::assert(
                encoded.contains(
                    "\"start\":{\"line\":1,\"character\":18},\"end\":{\"line\":1,\"character\":18}",
                ),
            );
            testing::assert(!encoded.contains("Unknown value text"))
        },
        Err(error) => testing::fail(error),
    }
}
