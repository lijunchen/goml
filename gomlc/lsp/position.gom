package lsp;

pub struct Position {
    pub line: int,
    pub character: int,
}

pub struct Range {
    pub start: Position,
    pub end: Position,
}

fn utf8_width(value: uint8) -> int {
    if value < 128 {
        1
    } else if value < 224 {
        2
    } else if value < 240 {
        3
    } else {
        4
    }
}

fn utf16_width(value: uint8) -> int {
    if utf8_width(value) == 4 {
        2
    } else {
        1
    }
}

pub fn offset_to_position(source: string, offset: int) -> Position {
    let limit = if offset < 0 {
        0
    } else if offset > source.byte_len() {
        source.byte_len()
    } else {
        offset
    };
    let mut line = 0;
    let mut character = 0;
    let mut index = 0;
    while index < limit {
        let byte = source.byte_get(index);
        if byte == b'\n' {
            line = line + 1;
            character = 0;
            index = index + 1;
        } else {
            let width = utf8_width(byte);
            if index + width <= limit {
                character = character + utf16_width(byte);
                index = index + width;
            } else {
                index = limit;
            }
        }
    }
    Position { line, character }
}

pub fn position_to_offset(source: string, position: Position) -> int {
    let mut line = 0;
    let mut character = 0;
    let mut index = 0;
    while index < source.byte_len() {
        if line == position.line && character >= position.character {
            return index
        } else {};
        let byte = source.byte_get(index);
        if byte == b'\n' {
            if line == position.line {
                return index
            } else {
                line = line + 1;
                character = 0;
                index = index + 1;
            }
        } else {
            let width = utf8_width(byte);
            let units = utf16_width(byte);
            if line == position.line && character + units > position.character {
                return index
            } else {
                character = character + units;
                index = index + width;
            }
        }
    }
    source.byte_len()
}

pub fn position_to_offset_checked(source: string, position: Position) -> Option[int] {
    if position.line < 0 || position.character < 0 {
        Option::None
    } else {
        let offset = position_to_offset(source, position);
        let actual = offset_to_position(source, offset);
        if actual.line == position.line && actual.character == position.character {
            Option::Some(offset)
        } else {
            Option::None
        }
    }
}

pub fn offsets_to_range(source: string, start: int, end: int) -> Range {
    Range { start: offset_to_position(source, start), end: offset_to_position(source, end) }
}
