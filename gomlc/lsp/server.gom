package lsp;

use gomlc::ast;
use gomlc::query;
use gomlc::strings;
use gomlc::tast;
use gomlc::vecs;
use gomlc::version;
use std::fs;
use std::json;
use std::text;

fn required_field(value: json::Value, name: string) -> Result[json::Value, string] {
    match json::field(value, name) {
        Some(field) => Result::Ok(field),
        None => Result::Err("missing field " + name),
    }
}

fn required_string_field(
    value: json::Value,
    name: string,
) -> Result[string, string] {
    match required_field(value, name) {
        Ok(field) => match json::as_string(field) {
            Some(text) => Result::Ok(text),
            None => Result::Err("field " + name + " must be a string"),
        },
        Err(error) => Result::Err(error),
    }
}

fn optional_int_field(value: json::Value, name: string, fallback: int) -> int {
    match json::field(value, name) {
        Some(field) => match json::as_int(field) {
            Some(number) => number,
            None => fallback,
        },
        None => fallback,
    }
}

fn text_document(value: json::Value) -> Result[json::Value, string] {
    required_field(value, "textDocument")
}

fn text_document_uri(value: json::Value) -> Result[string, string] {
    match text_document(value) {
        Ok(document) => required_string_field(document, "uri"),
        Err(error) => Result::Err(error),
    }
}

fn request_document(
    server: Server,
    params: json::Value,
) -> Result[Document, string] {
    let uri = match text_document_uri(params) {
        Ok(uri) => uri,
        Err(error) => return Result::Err(error),
    };
    match server_document(server, uri) {
        Some(document) => Result::Ok(document),
        None => Result::Err("document is not open: " + uri),
    }
}

fn request_position(params: json::Value) -> Result[Position, string] {
    match required_field(params, "position") {
        Ok(position) => parse_position(position),
        Err(error) => Result::Err(error),
    }
}

fn request_offset(
    document: Document,
    position: Position,
) -> Result[int, string] {
    match position_to_offset_checked(document.text, position) {
        Some(offset) => Result::Ok(offset),
        None => Result::Err("position is outside the document"),
    }
}

fn initialize_result() -> json::Value {
    let triggers = Vec::new();
    triggers.push(json::Value::String("."));
    triggers.push(json::Value::String(":"));
    triggers.push(json::Value::String(" "));
    let completion = Vec::new();
    push_json_field(
        completion,
        "triggerCharacters",
        json::Value::Array(triggers),
    );
    push_json_field(
        completion,
        "resolveProvider",
        json::Value::Bool(false),
    );
    let signature_triggers = Vec::new();
    signature_triggers.push(json::Value::String("("));
    signature_triggers.push(json::Value::String(","));
    let retriggers = Vec::new();
    retriggers.push(json::Value::String(","));
    let signature = Vec::new();
    push_json_field(
        signature,
        "triggerCharacters",
        json::Value::Array(signature_triggers),
    );
    push_json_field(
        signature,
        "retriggerCharacters",
        json::Value::Array(retriggers),
    );
    let capabilities = Vec::new();
    push_json_field(
        capabilities,
        "positionEncoding",
        json::Value::String("utf-16"),
    );
    push_json_field(
        capabilities,
        "textDocumentSync",
        json::Value::Number("1"),
    );
    push_json_field(
        capabilities,
        "hoverProvider",
        json::Value::Bool(true),
    );
    push_json_field(
        capabilities,
        "completionProvider",
        json::Value::Object(completion),
    );
    push_json_field(
        capabilities,
        "signatureHelpProvider",
        json::Value::Object(signature),
    );
    push_json_field(
        capabilities,
        "inlayHintProvider",
        json::Value::Bool(true),
    );
    push_json_field(
        capabilities,
        "definitionProvider",
        json::Value::Bool(true),
    );
    let code_lens = Vec::new();
    push_json_field(
        code_lens,
        "resolveProvider",
        json::Value::Bool(false),
    );
    push_json_field(
        capabilities,
        "codeLensProvider",
        json::Value::Object(code_lens),
    );
    push_json_field(
        capabilities,
        "codeActionProvider",
        json::Value::Bool(true),
    );
    let server_info = Vec::new();
    push_json_field(
        server_info,
        "name",
        json::Value::String("gomllsp"),
    );
    push_json_field(
        server_info,
        "version",
        json::Value::String(version::current()),
    );
    let result = Vec::new();
    push_json_field(
        result,
        "capabilities",
        json::Value::Object(capabilities),
    );
    push_json_field(
        result,
        "serverInfo",
        json::Value::Object(server_info),
    );
    json::Value::Object(result)
}

fn source_for_path(
    analysis: query::Analysis,
    source_path: string,
) -> Option[string] {
    let index = Ref::new(analysis.sources.len() - 1);
    while index.get() >= 0 {
        let source = analysis.sources.get(index.get());
        if source.path == source_path {
            return Option::Some(source.source)
        } else {
            index.set(index.get() - 1)
        }
    };
    match fs::read_file(source_path) {
        Ok(source) => Option::Some(source),
        Err(_) => Option::None,
    }
}

fn diagnostic_text(value: tast::Diagnostic) -> string {
    match value.primary_label {
        Some(label) => value.message + "\n" + label,
        None => value.message,
    }
}

fn diagnostic_contains_offset(
    value: tast::Diagnostic,
    source_path: string,
    offset: int,
) -> bool {
    (value.source_path == "" || value.source_path == source_path)
        && match value.span {
            Some(span) => if span.start == span.end {
                offset == span.start
            } else {
                span.start <= offset && offset < span.end
            },
            None => offset == 0,
        }
}

fn join_strings(values: Vec[string], separator: string) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        builder.write_string(values.get(index))
    };
    builder.finish()
}

fn hover_response(
    server: Server,
    params: json::Value,
) -> Result[json::Value, string] {
    let document = match request_document(server, params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let position = match request_position(params) {
        Ok(position) => position,
        Err(error) => return Result::Err(error),
    };
    let analysis = document_analysis(server, document);
    let offset = match request_offset(document, position) {
        Ok(offset) => offset,
        Err(error) => return Result::Err(error),
    };
    let sections = Vec::new();
    match query::hover(analysis, offset) {
        Some(hover) => sections.push(
            "```goml\n" + hover.contents + "\n```",
        ),
        None => (),
    };
    let diagnostic_lines = Vec::new();
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic_contains_offset(
            diagnostic,
            document.path,
            offset,
        ) {
            let line = match diagnostic.severity {
                Error => "- ",
                Warning => "+ ",
            } + diagnostic_text(diagnostic);
            if vecs::contains(diagnostic_lines, line) {
                ()
            } else {
                diagnostic_lines.push(line)
            }
        } else {
            ()
        }
    };
    if diagnostic_lines.len() > 0 {
        sections.push(
            "**Diagnostics**\n```diff\n"
                + join_strings(diagnostic_lines, "\n")
                + "\n```",
        )
    } else {
        ()
    };
    if sections.len() == 0 {
        Result::Ok(json::Value::Null)
    } else {
        let contents = Vec::new();
        push_json_field(
            contents,
            "kind",
            json::Value::String("markdown"),
        );
        push_json_field(
            contents,
            "value",
            json::Value::String(join_strings(sections, "\n\n")),
        );
        let result = Vec::new();
        push_json_field(
            result,
            "contents",
            json::Value::Object(contents),
        );
        Result::Ok(json::Value::Object(result))
    }
}

fn completion_kind(value: query::CompletionKind) -> int {
    match value {
        Package => 9,
        Method => 2,
        Function => 3,
        Field => 5,
        Variable => 6,
        Keyword => 14,
        Trait => 8,
        Enum => 13,
        Variant => 20,
        Struct => 22,
    }
}

fn completion_response(
    server: Server,
    params: json::Value,
) -> Result[json::Value, string] {
    let document = match request_document(server, params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let position = match request_position(params) {
        Ok(position) => position,
        Err(error) => return Result::Err(error),
    };
    let analysis = document_analysis(server, document);
    let offset = match request_offset(document, position) {
        Ok(offset) => offset,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in query::completions(analysis, offset) {
        let fields = Vec::new();
        push_json_field(
            fields,
            "label",
            json::Value::String(item.label),
        );
        push_json_field(
            fields,
            "detail",
            json::Value::String(item.detail),
        );
        push_json_field(
            fields,
            "kind",
            json::Value::Number(completion_kind(item.kind).to_string()),
        );
        result.push(json::Value::Object(fields))
    };
    Result::Ok(json::Value::Array(result))
}

fn signature_response(
    server: Server,
    params: json::Value,
) -> Result[json::Value, string] {
    let document = match request_document(server, params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let position = match request_position(params) {
        Ok(position) => position,
        Err(error) => return Result::Err(error),
    };
    let analysis = document_analysis(server, document);
    let offset = match request_offset(document, position) {
        Ok(offset) => offset,
        Err(error) => return Result::Err(error),
    };
    match query::signature_help(analysis, offset) {
        Some(signature) => {
            let parameters = Vec::new();
            for parameter in signature.parameters {
                let fields = Vec::new();
                push_json_field(
                    fields,
                    "label",
                    json::Value::String(parameter),
                );
                parameters.push(json::Value::Object(fields))
            };
            let item = Vec::new();
            push_json_field(
                item,
                "label",
                json::Value::String(signature.label),
            );
            push_json_field(
                item,
                "parameters",
                json::Value::Array(parameters),
            );
            let signatures = Vec::new();
            signatures.push(json::Value::Object(item));
            let result = Vec::new();
            push_json_field(
                result,
                "signatures",
                json::Value::Array(signatures),
            );
            push_json_field(
                result,
                "activeSignature",
                json::Value::Number("0"),
            );
            push_json_field(
                result,
                "activeParameter",
                json::Value::Number(
                    signature.active_parameter.to_string(),
                ),
            );
            Result::Ok(json::Value::Object(result))
        },
        None => Result::Ok(json::Value::Null),
    }
}

fn inlay_response(
    server: Server,
    params: json::Value,
) -> Result[json::Value, string] {
    let document = match request_document(server, params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let requested_range = match required_field(params, "range") {
        Ok(value) => match parse_range(value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let range_start = match request_offset(
        document,
        requested_range.start,
    ) {
        Ok(offset) => offset,
        Err(error) => return Result::Err(error),
    };
    let range_end = match request_offset(document, requested_range.end) {
        Ok(offset) => offset,
        Err(error) => return Result::Err(error),
    };
    let analysis = document_analysis(server, document);
    let result = Vec::new();
    for hint in query::inlay_hints(analysis) {
        if hint.position >= range_start && hint.position <= range_end {
            let position = Ref::new(hint.position);
            while position.get() > 0
                && (document.text.byte_get(position.get() - 1) == 32
                    || document.text.byte_get(position.get() - 1) == 9)
            {
                position.set(position.get() - 1)
            };
            let fields = Vec::new();
            push_json_field(
                fields,
                "position",
                position_json(offset_to_position(
                    document.text,
                    position.get(),
                )),
            );
            push_json_field(
                fields,
                "label",
                json::Value::String(hint.label),
            );
            push_json_field(fields, "kind", json::Value::Number("1"));
            push_json_field(
                fields,
                "paddingRight",
                json::Value::Bool(true),
            );
            result.push(json::Value::Object(fields))
        } else {
            ()
        }
    };
    Result::Ok(json::Value::Array(result))
}

fn definition_response(
    server: Server,
    params: json::Value,
) -> Result[json::Value, string] {
    let document = match request_document(server, params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let position = match request_position(params) {
        Ok(position) => position,
        Err(error) => return Result::Err(error),
    };
    let analysis = document_analysis(server, document);
    let offset = match request_offset(document, position) {
        Ok(offset) => offset,
        Err(error) => return Result::Err(error),
    };
    let locations = Vec::new();
    for definition in query::goto_definitions(analysis, offset) {
        match source_for_path(analysis, definition.source_path) {
            Some(source) => {
                let location = Vec::new();
                push_json_field(
                    location,
                    "uri",
                    json::Value::String(path_to_uri(
                        definition.source_path,
                    )),
                );
                push_json_field(
                    location,
                    "range",
                    range_json(offsets_to_range(
                        source,
                        definition.span.start,
                        definition.span.end,
                    )),
                );
                locations.push(json::Value::Object(location))
            },
            None => (),
        }
    };
    if locations.len() == 0 {
        Result::Ok(json::Value::Null)
    } else if locations.len() == 1 {
        Result::Ok(locations.get(0))
    } else {
        Result::Ok(json::Value::Array(locations))
    }
}

fn test_kind_name(value: query::TestItemKind) -> string {
    match value {
        Internal => "internal",
        External => "external",
    }
}

fn code_lens_response(
    server: Server,
    params: json::Value,
) -> Result[json::Value, string] {
    let document = match request_document(server, params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in query::test_items(document.path, document.text) {
        let arguments = Vec::new();
        arguments.push(json::Value::String(document.uri));
        arguments.push(json::Value::String(item.name));
        arguments.push(json::Value::String(test_kind_name(item.kind)));
        let command = Vec::new();
        push_json_field(
            command,
            "title",
            json::Value::String("Run Test"),
        );
        push_json_field(
            command,
            "command",
            json::Value::String("goml.runTest"),
        );
        push_json_field(
            command,
            "arguments",
            json::Value::Array(arguments),
        );
        let lens = Vec::new();
        push_json_field(
            lens,
            "range",
            range_json(offsets_to_range(
                document.text,
                item.span.start,
                item.span.end,
            )),
        );
        push_json_field(
            lens,
            "command",
            json::Value::Object(command),
        );
        result.push(json::Value::Object(lens))
    };
    Result::Ok(json::Value::Array(result))
}

fn fix_action(
    diagnostic: json::Value,
    fix: json::Value,
) -> Option[json::Value] {
    let uri = match json::field(fix, "uri") {
        Some(value) => match json::as_string(value) {
            Some(value) => value,
            None => return Option::None,
        },
        None => return Option::None,
    };
    let range = match json::field(fix, "range") {
        Some(value) => value,
        None => return Option::None,
    };
    let replacement = match json::field(fix, "replacement") {
        Some(value) => match json::as_string(value) {
            Some(value) => value,
            None => return Option::None,
        },
        None => return Option::None,
    };
    let title = match json::field(fix, "title") {
        Some(value) => match json::as_string(value) {
            Some(value) => value,
            None => "Apply suggested fix",
        },
        None => "Apply suggested fix",
    };
    let preferred = match json::field(fix, "preferred") {
        Some(Bool(value)) => value,
        _ => false,
    };
    let edit = Vec::new();
    push_json_field(edit, "range", range);
    push_json_field(
        edit,
        "newText",
        json::Value::String(replacement),
    );
    let edits = Vec::new();
    edits.push(json::Value::Object(edit));
    let changes = Vec::new();
    changes.push((uri, json::Value::Array(edits)));
    let workspace_edit = Vec::new();
    push_json_field(
        workspace_edit,
        "changes",
        json::Value::Object(changes),
    );
    let diagnostics = Vec::new();
    diagnostics.push(diagnostic);
    let action = Vec::new();
    push_json_field(action, "title", json::Value::String(title));
    push_json_field(
        action,
        "kind",
        json::Value::String("quickfix"),
    );
    push_json_field(
        action,
        "diagnostics",
        json::Value::Array(diagnostics),
    );
    push_json_field(
        action,
        "edit",
        json::Value::Object(workspace_edit),
    );
    push_json_field(
        action,
        "isPreferred",
        json::Value::Bool(preferred),
    );
    Option::Some(json::Value::Object(action))
}

fn code_action_response(params: json::Value) -> Result[json::Value, string] {
    let context = match required_field(params, "context") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let diagnostics = match required_field(context, "diagnostics") {
        Ok(Array(values)) => values,
        Ok(_) => return Result::Err(
            "field diagnostics must be an array",
        ),
        Err(error) => return Result::Err(error),
    };
    let actions = Vec::new();
    for diagnostic in diagnostics {
        match json::field(diagnostic, "data") {
            Some(data) => match json::field(data, "fixes") {
                Some(Array(fixes)) => for fix in fixes {
                    match fix_action(diagnostic, fix) {
                        Some(action) => actions.push(action),
                        None => (),
                    }
                },
                _ => (),
            },
            None => (),
        }
    };
    if actions.len() == 0 {
        Result::Ok(json::Value::Null)
    } else {
        Result::Ok(json::Value::Array(actions))
    }
}

fn diagnostic_severity(value: tast::DiagnosticSeverity) -> int {
    match value {
        Error => 1,
        Warning => 2,
    }
}

fn diagnostic_json(
    document: Document,
    analysis: query::Analysis,
    value: tast::Diagnostic,
) -> json::Value {
    let span = match value.span {
        Some(span) => span,
        None => ast::span(0, 0),
    };
    let fields = Vec::new();
    push_json_field(
        fields,
        "range",
        range_json(offsets_to_range(
            document.text,
            span.start,
            span.end,
        )),
    );
    push_json_field(
        fields,
        "severity",
        json::Value::Number(diagnostic_severity(value.severity).to_string()),
    );
    push_json_field(
        fields,
        "source",
        json::Value::String("goml"),
    );
    push_json_field(
        fields,
        "message",
        json::Value::String(diagnostic_text(value)),
    );
    let related = Vec::new();
    for label in value.secondary_labels {
        match source_for_path(analysis, label.source_path) {
            Some(source) => {
                let location = Vec::new();
                push_json_field(
                    location,
                    "uri",
                    json::Value::String(path_to_uri(label.source_path)),
                );
                push_json_field(
                    location,
                    "range",
                    range_json(offsets_to_range(
                        source,
                        label.span.start,
                        label.span.end,
                    )),
                );
                let information = Vec::new();
                push_json_field(
                    information,
                    "location",
                    json::Value::Object(location),
                );
                push_json_field(
                    information,
                    "message",
                    json::Value::String(label.message),
                );
                related.push(json::Value::Object(information))
            },
            None => (),
        }
    };
    if related.len() > 0 {
        push_json_field(
            fields,
            "relatedInformation",
            json::Value::Array(related),
        )
    } else {
        ()
    };
    json::Value::Object(fields)
}

fn publish_diagnostics(server: Server, document: Document) -> json::Value {
    let analysis = document_analysis(server, document);
    let diagnostics = Vec::new();
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic.source_path == ""
            || diagnostic.source_path == document.path
        {
            diagnostics.push(diagnostic_json(
                document,
                analysis,
                diagnostic,
            ))
        } else {
            ()
        }
    };
    let params = Vec::new();
    push_json_field(
        params,
        "uri",
        json::Value::String(document.uri),
    );
    push_json_field(
        params,
        "version",
        json::Value::Number(document.version.to_string()),
    );
    push_json_field(
        params,
        "diagnostics",
        json::Value::Array(diagnostics),
    );
    rpc_notification(
        "textDocument/publishDiagnostics",
        json::Value::Object(params),
    )
}

fn publish_all_diagnostics(server: Server) -> Vec[json::Value] {
    let result = Vec::new();
    for document in server.documents {
        result.push(publish_diagnostics(server, document))
    };
    result
}

fn did_open(server: Server, params: json::Value) -> Result[json::Value, string] {
    let text_document = match text_document(params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let uri = match required_string_field(text_document, "uri") {
        Ok(uri) => uri,
        Err(error) => return Result::Err(error),
    };
    let path = match uri_to_path(uri) {
        Ok(path) => path,
        Err(error) => return Result::Err(error),
    };
    let text = match required_string_field(text_document, "text") {
        Ok(text) => text,
        Err(error) => return Result::Err(error),
    };
    let document = Document {
        uri,
        path,
        text,
        version: optional_int_field(text_document, "version", 0),
    };
    open_document(server, document);
    Result::Ok(publish_diagnostics(server, document))
}

fn did_change(server: Server, params: json::Value) -> Result[json::Value, string] {
    let uri = match text_document_uri(params) {
        Ok(uri) => uri,
        Err(error) => return Result::Err(error),
    };
    let text_document = match text_document(params) {
        Ok(document) => document,
        Err(error) => return Result::Err(error),
    };
    let version = optional_int_field(text_document, "version", 0);
    let changes = match required_field(params, "contentChanges") {
        Ok(changes) => match json::as_array(changes) {
            Some(changes) => changes,
            None => {
                return Result::Err("contentChanges must be an array")
            },
        },
        Err(error) => return Result::Err(error),
    };
    if changes.len() == 0 {
        return Result::Err("contentChanges must not be empty")
    } else {
        ()
    };
    let text = match required_string_field(
        changes.get(changes.len() - 1),
        "text",
    ) {
        Ok(text) => text,
        Err(error) => return Result::Err(error),
    };
    change_document(server, uri, text, version);
    match server_document(server, uri) {
        Some(document) => {
            Result::Ok(publish_diagnostics(server, document))
        },
        None => Result::Err("document is not open: " + uri),
    }
}

fn did_close(server: Server, params: json::Value) -> Result[json::Value, string] {
    let uri = match text_document_uri(params) {
        Ok(uri) => uri,
        Err(error) => return Result::Err(error),
    };
    close_document(server, uri);
    let diagnostic_params = Vec::new();
    push_json_field(
        diagnostic_params,
        "uri",
        json::Value::String(uri),
    );
    push_json_field(
        diagnostic_params,
        "diagnostics",
        json::Value::Array(Vec::new()),
    );
    Result::Ok(rpc_notification(
        "textDocument/publishDiagnostics",
        json::Value::Object(diagnostic_params),
    ))
}

fn did_save(server: Server, params: json::Value) -> Result[unit, string] {
    let uri = match text_document_uri(params) {
        Ok(uri) => uri,
        Err(error) => return Result::Err(error),
    };
    match server_document(server, uri) {
        Some(_) => {
            invalidate_analyses(server);
            Result::Ok(())
        },
        None => Result::Err("document is not open: " + uri),
    }
}

fn request_result(
    server: Server,
    message: RpcMessage,
) -> Result[json::Value, string] {
    if message.method == "initialize" {
        Result::Ok(initialize_result())
    } else if message.method == "shutdown" {
        server.shutdown.set(true);
        Result::Ok(json::Value::Null)
    } else if message.method == "textDocument/hover" {
        hover_response(server, message.params)
    } else if message.method == "textDocument/completion" {
        completion_response(server, message.params)
    } else if message.method == "textDocument/signatureHelp" {
        signature_response(server, message.params)
    } else if message.method == "textDocument/inlayHint" {
        inlay_response(server, message.params)
    } else if message.method == "textDocument/definition" {
        definition_response(server, message.params)
    } else if message.method == "textDocument/codeLens" {
        code_lens_response(server, message.params)
    } else if message.method == "textDocument/codeAction" {
        code_action_response(message.params)
    } else {
        Result::Err("method not found: " + message.method)
    }
}

pub fn handle_json(server: Server, value: json::Value) -> Vec[json::Value] {
    let output = Vec::new();
    match parse_rpc_message(value) {
        Ok(message) => if server.shutdown.get()
            && message.method != "exit"
        {
            match message.id {
                Some(id) => output.push(rpc_error(
                    id,
                    -32600,
                    "server has shut down",
                )),
                None => (),
            }
        } else if message.method == "exit" {
            server.running.set(false)
        } else if message.method == "initialized" {
            ()
        } else if message.method == "textDocument/didOpen" {
            match did_open(server, message.params) {
                Ok(_) => for notification in publish_all_diagnostics(
                    server,
                ) {
                    output.push(notification)
                },
                Err(_) => (),
            }
        } else if message.method == "textDocument/didChange" {
            match did_change(server, message.params) {
                Ok(_) => for notification in publish_all_diagnostics(
                    server,
                ) {
                    output.push(notification)
                },
                Err(_) => (),
            }
        } else if message.method == "textDocument/didClose" {
            match did_close(server, message.params) {
                Ok(notification) => {
                    output.push(notification);
                    for current in publish_all_diagnostics(server) {
                        output.push(current)
                    }
                },
                Err(_) => (),
            }
        } else if message.method == "textDocument/didSave" {
            match did_save(server, message.params) {
                Ok(()) => for notification in publish_all_diagnostics(
                    server,
                ) {
                    output.push(notification)
                },
                Err(_) => (),
            }
        } else {
            match message.id {
                Some(id) => match request_result(server, message) {
                    Ok(result) => output.push(rpc_success(id, result)),
                    Err(error) => output.push(rpc_error(
                        id,
                        if strings::starts_with(error, "method not found:") {
                            -32601
                        } else {
                            -32602
                        },
                        error,
                    )),
                },
                None => (),
            }
        },
        Err(error) => output.push(rpc_error(
            json::Value::Null,
            -32600,
            error,
        )),
    };
    output
}

pub fn handle_payload(
    server: Server,
    payload: string,
) -> Result[Vec[json::Value], string] {
    match json::parse(payload) {
        Ok(value) => Result::Ok(handle_json(server, value)),
        Err(error) => Result::Ok(Vec::new().pushed(rpc_error(
            json::Value::Null,
            -32700,
            error,
        ))),
    }
}

pub fn run_server() -> Result[unit, string] {
    let server = new_server();
    while server_running(server) {
        let payload = match read_rpc_payload() {
            Ok(payload) => payload,
            Err(error) => return Result::Err(error),
        };
        match handle_payload(server, payload) {
            Ok(messages) => for message in messages {
                match write_rpc_message(message) {
                    Ok(()) => (),
                    Err(error) => return Result::Err(error),
                }
            },
            Err(error) => return Result::Err(error),
        }
    };
    if server.shutdown.get() {
        Result::Ok(())
    } else {
        Result::Err("exit notification received before shutdown")
    }
}
