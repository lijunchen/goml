package lsp;

use std::json;

pub struct RpcMessage {
    pub id: Option[json::Value],
    pub method: string,
    pub params: json::Value,
}

fn json_fields(values: Vec[(string, json::Value)]) -> json::Value {
    json::Value::Object(values)
}

fn push_json_field(values: Vec[(string, json::Value)], name: string, value: json::Value) -> unit {
    values.push((name, value))
}

pub fn parse_rpc_message(value: json::Value) -> Result[RpcMessage, string] {
    match json::field(value, "jsonrpc") {
        Some(String(version)) => if version != "2.0" {
            return Result::Err("JSON-RPC version must be 2.0")
        } else {
            ()
        },
        Some(_) => return Result::Err("JSON-RPC version must be a string"),
        None => return Result::Err("JSON-RPC message has no version"),
    };
    let method = match json::field(value, "method") {
        Some(method) => match json::as_string(method) {
            Some(method) => method,
            None => return Result::Err("JSON-RPC method must be a string"),
        },
        None => return Result::Err("JSON-RPC message has no method"),
    };
    let id = json::field(value, "id");
    let params = match json::field(value, "params") {
        Some(params) => params,
        None => json::Value::Null,
    };
    Result::Ok(RpcMessage { id, method, params })
}

pub fn rpc_success(id: json::Value, result: json::Value) -> json::Value {
    let fields = Vec::new();
    push_json_field(fields, "jsonrpc", json::Value::String("2.0"));
    push_json_field(fields, "id", id);
    push_json_field(fields, "result", result);
    json_fields(fields)
}

pub fn rpc_error(id: json::Value, code: int, message: string) -> json::Value {
    let error = Vec::new();
    push_json_field(error, "code", json::Value::Number(code.to_string()));
    push_json_field(error, "message", json::Value::String(message));
    let fields = Vec::new();
    push_json_field(fields, "jsonrpc", json::Value::String("2.0"));
    push_json_field(fields, "id", id);
    push_json_field(fields, "error", json_fields(error));
    json_fields(fields)
}

pub fn rpc_notification(method: string, params: json::Value) -> json::Value {
    let fields = Vec::new();
    push_json_field(fields, "jsonrpc", json::Value::String("2.0"));
    push_json_field(fields, "method", json::Value::String(method));
    push_json_field(fields, "params", params);
    json_fields(fields)
}

pub fn framed_json(value: json::Value) -> string {
    let body = json::encode(value);
    "Content-Length: " + body.byte_len().to_string() + "\r\n\r\n" + body
}

fn ascii_lower(value: uint8) -> uint8 {
    if value >= 65 && value <= 90 {
        value + 32
    } else {
        value
    }
}

fn ascii_prefix_equal_case_insensitive(value: string, expected: string) -> bool {
    if value.byte_len() < expected.byte_len() {
        false
    } else {
        for index in 0..expected.byte_len() {
            if ascii_lower(value.byte_get(index)) != ascii_lower(expected.byte_get(index)) {
                return false
            } else {
                ()
            }
        };
        true
    }
}

fn header_line_content(value: string) -> string {
    let end = Ref::new(value.byte_len());
    while end.get() > 0
        && (value.byte_get(end.get() - 1) == b'\n' || value.byte_get(end.get() - 1) == b'\r') {
        end.set(end.get() - 1)
    };
    value.byte_slice(0, end.get())
}

fn decimal_length(value: string) -> Result[int, string] {
    let result = Ref::new(0);
    if value.byte_len() == 0 {
        return Result::Err("empty Content-Length")
    } else {
        ()
    };
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Result::Err("invalid Content-Length")
        } else {
            result.set(result.get() * 10 + (byte - 48) as int)
        }
    };
    Result::Ok(result.get())
}

pub fn content_length(value: string) -> Result[int, string] {
    let line = header_line_content(value);
    let prefix = "Content-Length:";
    if !ascii_prefix_equal_case_insensitive(line, prefix) {
        Result::Err("expected Content-Length header")
    } else {
        let start = Ref::new(prefix.byte_len());
        while start.get() < line.byte_len()
            && (line.byte_get(start.get()) == b' ' || line.byte_get(start.get()) == b'\t') {
            start.set(start.get() + 1)
        };
        decimal_length(line.byte_slice(start.get(), line.byte_len()))
    }
}

fn is_content_length_header(value: string) -> bool {
    let line = header_line_content(value);
    ascii_prefix_equal_case_insensitive(line, "Content-Length:")
}

pub fn position_json(value: Position) -> json::Value {
    let fields = Vec::new();
    push_json_field(fields, "line", json::Value::Number(value.line.to_string()));
    push_json_field(fields, "character", json::Value::Number(value.character.to_string()));
    json_fields(fields)
}

pub fn range_json(value: Range) -> json::Value {
    let fields = Vec::new();
    push_json_field(fields, "start", position_json(value.start));
    push_json_field(fields, "end", position_json(value.end));
    json_fields(fields)
}

pub fn parse_position(value: json::Value) -> Result[Position, string] {
    let line = match json::field(value, "line") {
        Some(line) => match json::as_int(line) {
            Some(line) => line,
            None => return Result::Err("position line must be an integer"),
        },
        None => return Result::Err("position has no line"),
    };
    let character = match json::field(value, "character") {
        Some(character) => match json::as_int(character) {
            Some(character) => character,
            None => {
                return Result::Err("position character must be an integer")
            },
        },
        None => return Result::Err("position has no character"),
    };
    Result::Ok(Position { line, character })
}

pub fn parse_range(value: json::Value) -> Result[Range, string] {
    let start = match json::field(value, "start") {
        Some(value) => parse_position(value)?,
        None => return Result::Err("range has no start"),
    };
    let end = match json::field(value, "end") {
        Some(value) => parse_position(value)?,
        None => return Result::Err("range has no end"),
    };
    Result::Ok(Range { start, end })
}
