package core;

use gomlc::ast;
use gomlc::tast;
use std::text;

struct Lowerer {
    counter: Ref[int],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
    cleanups: Vec[tast::Expr],
    loop_cleanup_depths: Vec[int],
    cleanup_lowering_depth: Ref[int],
}

struct EnumCase {
    constructor: tast::Constructor,
    variables: Vec[(string, tast::Type)],
    rows: Vec[PatternRow],
}

fn gensym(ctx: Lowerer, prefix: string) -> string {
    let current = ctx.counter.get();
    ctx.counter.set(current + 1);
    prefix + current.to_string()
}

fn type_text(value: tast::Type) -> string {
    let builder = text::StringBuilder::new();
    tast::write_type(builder, value);
    builder.finish()
}

fn compact_text(value: string) -> string {
    let builder = text::StringBuilder::new();
    for character in value.chars() {
        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {} else {
            builder.write_char(character)
        }
    }
    builder.finish()
}

fn compact_type(value: tast::Type) -> string {
    compact_text(type_text(value))
}

fn inherent_base(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        Unit => "unit",
        Bool => "bool",
        Int => "int",
        Int8 => "int8",
        Int16 => "int16",
        Int32 => "int32",
        Int64 => "int64",
        Uint => "uint",
        Uint8 => "uint8",
        Uint16 => "uint16",
        Uint32 => "uint32",
        Uint64 => "uint64",
        Float32 => "float32",
        Float64 => "float64",
        String => "string",
        Char => "char",
        Con { name } => name,
        App { ty: base, args: _ } => inherent_base(base),
        Slice { elem: _ } => "Slice",
        VecType { elem: _ } => "Vec",
        RefType { elem: _ } => "Ref",
        HashMap { key: _, value: _ } => "HashMap",
        Channel { elem: _ } => "Channel",
        other => compact_type(other),
    }
}

pub fn inherent_method_name(owner: tast::Type, name: string) -> string {
    "inherent#" + inherent_base(owner) + "#" + compact_type(owner) + "#" + name
}

fn nominal_parts(value: tast::Type) -> Option[(string, Vec[tast::Type])] {
    match tast::resolve_type(value) {
        Con { name } => Option::Some((name, Vec::[])),
        App { ty: Con { name }, args } => Option::Some((name, args)),
        _ => Option::None,
    }
}

fn find_enum(ctx: Lowerer, name: string) -> Option[tast::EnumDef] {
    let mut index = ctx.enums.len() - 1;
    while index >= 0 {
        let value = ctx.enums[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn find_struct(ctx: Lowerer, name: string) -> Option[tast::StructDef] {
    let mut index = ctx.structs.len() - 1;
    while index >= 0 {
        let value = ctx.structs[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn trait_impl_method_name(reference: tast::TraitRef, for_ty: tast::Type, name: string) -> string {
    let dispatch = if reference.args.is_empty() {
        compact_type(for_ty)
    } else {
        let builder = text::StringBuilder::new();
        builder.write_char('[');
        for index in 0..reference.args.len() {
            if index > 0 {
                builder.write_char(',')
            } else {};
            builder.write_string(compact_type(reference.args[index]))
        }
        builder.write_string("]@");
        builder.write_string(compact_type(for_ty));
        builder.finish()
    };
    "trait_impl#" + reference.name + "#" + dispatch + "#" + name
}

fn lower_exprs(ctx: Lowerer, values: Vec[tast::Expr]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::[];
    for value in values {
        result.push(lower_expr(ctx, value))
    }
    result
}

fn arguments_after_first(values: Vec[Expr]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::[];
    for index in 1..values.len() {
        result.push(values[index])
    }
    result
}

fn bool_expr(value: bool) -> Expr {
    Expr::Prim { value: tast::Primitive::Bool { value }, ty: tast::Type::Bool }
}

fn trait_eq_call(trait_name: string, left: Expr, right: Expr) -> Expr {
    let args: Vec[Expr] = Vec::[];
    args.push(right);
    Expr::TraitCall {
        trait_ref: tast::TraitRef { name: trait_name, args: Vec::[] },
        method_name: "eq",
        instance_name: Option::None,
        receiver: left,
        args,
        ty: tast::Type::Bool,
    }
}

fn eq_conjunction(values: Vec[Expr]) -> Expr {
    if values.is_empty() {
        bool_expr(true)
    } else {
        let mut result = values[values.len() - 1];
        let mut index = values.len() - 2;
        while index >= 0 {
            result = Expr::If {
                cond: values[index],
                then_branch: result,
                else_branch: bool_expr(false),
                ty: tast::Type::Bool,
            };
            index = index - 1;
        }
        result
    }
}

fn structural_eq(trait_name: string, left: Expr, right: Expr, ty: tast::Type) -> Expr {
    match tast::resolve_type(ty) {
        Tuple { items: types } => {
            let values: Vec[Expr] = Vec::[];
            for index in 0..types.len() {
                let item_ty = types[index];
                values.push(
                    structural_eq(
                        trait_name,
                        Expr::Proj { tuple: left, index, ty: item_ty },
                        Expr::Proj { tuple: right, index, ty: item_ty },
                        item_ty,
                    ),
                )
            }
            eq_conjunction(values)
        },
        Array { len: length, elem: element } => {
            let values: Vec[Expr] = Vec::[];
            for index in 0..length {
                let index_expr = Expr::Prim {
                    value: tast::Primitive::Int { value: index.to_string() },
                    ty: tast::Type::Int,
                };
                let parameter_types: Vec[tast::Type] = Vec::[];
                parameter_types.push(ty);
                parameter_types.push(tast::Type::Int);
                let function_ty = tast::Type::Func { params: parameter_types, ret_ty: element };
                let left_args: Vec[Expr] = Vec::[];
                left_args.push(left);
                left_args.push(index_expr);
                let right_args: Vec[Expr] = Vec::[];
                right_args.push(right);
                right_args.push(index_expr);
                values.push(
                    structural_eq(
                        trait_name,
                        Expr::Call {
                            func: Expr::Callable {
                                callable: tast::Callable::Intrinsic("array.get"),
                                ty: function_ty,
                            },
                            args: left_args,
                            ty: element,
                        },
                        Expr::Call {
                            func: Expr::Callable {
                                callable: tast::Callable::Intrinsic("array.get"),
                                ty: function_ty,
                            },
                            args: right_args,
                            ty: element,
                        },
                        element,
                    ),
                )
            }
            eq_conjunction(values)
        },
        _ => trait_eq_call(trait_name, left, right),
    }
}

fn lower_eq_expr(
    ctx: Lowerer,
    trait_name: string,
    op: ast::BinaryOp,
    left: tast::Expr,
    right: tast::Expr,
) -> Expr {
    let operand_ty = tast::expr_type(left);
    let left_value = lower_expr(ctx, left);
    let right_value = lower_expr(ctx, right);
    let eq = match tast::resolve_type(operand_ty) {
        Tuple { items: _ } | Array { len: _, elem: _ } => {
            let left_name = gensym(ctx, "_eq_lhs");
            let right_name = gensym(ctx, "_eq_rhs");
            let stmts: Vec[LetStmt] = Vec::[];
            stmts.push(LetStmt { name: left_name, value: left_value, ty: operand_ty });
            stmts.push(LetStmt { name: right_name, value: right_value, ty: operand_ty });
            Expr::Block {
                block: Block {
                    stmts,
                    tail: Option::Some(
                        structural_eq(
                            trait_name,
                            Expr::Var { name: left_name, ty: operand_ty },
                            Expr::Var { name: right_name, ty: operand_ty },
                            operand_ty,
                        ),
                    ),
                },
                ty: tast::Type::Bool,
            }
        },
        _ => trait_eq_call(trait_name, left_value, right_value),
    };
    if match op {
        NotEq => true,
        _ => false,
    } {
        Expr::Unary { op: ast::UnaryOp::Not, expr: eq, ty: tast::Type::Bool }
    } else {
        eq
    }
}

fn negated_integer(value: tast::Primitive) -> Option[tast::Primitive] {
    match value {
        Int { value } => Option::Some(tast::Primitive::Int { value: "-" + value }),
        _ => Option::None,
    }
}

fn lower_call(ctx: Lowerer, function: tast::Expr, arguments: Vec[tast::Expr], ty: tast::Type) -> Expr {
    let args = lower_exprs(ctx, arguments);
    match function {
        Callable { callable: TraitMethod { trait_ref: reference, method_name: name }, ty: _ } => if args.len()
            > 0 {
            Expr::TraitCall {
                trait_ref: reference,
                method_name: name,
                instance_name: Option::None,
                receiver: args[0],
                args: arguments_after_first(args),
                ty,
            }
        } else {
            Expr::Call {
                func: Expr::Callable {
                    callable: tast::Callable::TraitMethod {
                        trait_ref: reference,
                        method_name: name,
                    },
                    ty: tast::Type::Error,
                },
                args,
                ty,
            }
        },
        Callable {
            callable: DynTraitMethod {
                trait_name: owner,
                dispatch_name: dispatch,
                method_name: name,
            },
            ty: _,
        } => if !args.is_empty() {
            Expr::DynCall {
                trait_name: owner,
                method_name: dispatch + "#" + name,
                receiver: args[0],
                args: arguments_after_first(args),
                ty,
            }
        } else {
            Expr::Call {
                func: Expr::Callable {
                    callable: tast::Callable::DynTraitMethod {
                        trait_name: owner,
                        dispatch_name: dispatch,
                        method_name: name,
                    },
                    ty: tast::Type::Error,
                },
                args,
                ty,
            }
        },
        Callable {
            callable: InherentMethod { receiver_ty: owner, method_name: name },
            ty: method_ty,
        } => {
            Expr::Call {
                func: Expr::Callable {
                    callable: tast::Callable::InherentMethod {
                        receiver_ty: owner,
                        method_name: name,
                    },
                    ty: method_ty,
                },
                args,
                ty,
            }
        },
        other => Expr::Call { func: lower_expr(ctx, other), args, ty },
    }
}

fn lower_pattern_expr(value: tast::Pat) -> Option[Expr] {
    match value {
        Prim { value: primitive, ty } => Option::Some(Expr::Prim { value: primitive, ty }),
        Constr { constructor, args, ty } => {
            let result: Vec[Expr] = Vec::[];
            for arg in args {
                match lower_pattern_expr(arg) {
                    Some(expr) => result.push(expr),
                    None => return Option::None,
                }
            }
            Option::Some(Expr::Constr { constructor, args: result, ty })
        },
        Tuple { items, ty } => {
            let result: Vec[Expr] = Vec::[];
            for item in items {
                match lower_pattern_expr(item) {
                    Some(expr) => result.push(expr),
                    None => return Option::None,
                }
            }
            Option::Some(Expr::Tuple { items: result, ty })
        },
        _ => Option::None,
    }
}

fn missing_expr(ty: tast::Type) -> Expr {
    let params: Vec[tast::Type] = Vec::[];
    params.push(tast::Type::String);
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::Prim { value: tast::Primitive::String { value: "" }, ty: tast::Type::String });
    Expr::Call {
        func: Expr::Callable {
            callable: tast::Callable::Intrinsic("compiler.missing"),
            ty: tast::Type::Func { params, ret_ty: ty },
        },
        args,
        ty,
    }
}

fn bind_match_pattern(
    source_name: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
    ty: tast::Type,
    body: Expr,
) -> Expr {
    match pattern {
        Var { name, is_mut: _, ty: pat_ty } => {
            let stmts: Vec[LetStmt] = Vec::[];
            stmts.push(
                LetStmt { name, value: Expr::Var { name: source_name, ty: source_ty }, ty: pat_ty },
            );
            Expr::Block { block: Block { stmts, tail: Option::Some(body) }, ty }
        },
        _ => body,
    }
}

fn lower_generic_match(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    arms: Vec[tast::Arm],
    ty: tast::Type,
) -> Expr {
    let result: Vec[Arm] = Vec::[];
    let mut default: Option[Expr] = Option::None;
    for arm in arms {
        match arm.pat {
            Wild { ty: _ } | Var { name: _, is_mut: _, ty: _ } => {
                default = Option::Some(
                    bind_match_pattern(
                        source_name,
                        source_ty,
                        arm.pat,
                        ty,
                        lower_expr(ctx, arm.body),
                    ),
                );
            },
            pattern => match lower_pattern_expr(pattern) {
                Some(lhs) => result.push(Arm { lhs, body: lower_expr(ctx, arm.body) }),
                None => if default.is_none() {
                    default = Option::Some(lower_expr(ctx, arm.body));
                } else {},
            },
        }
    }
    Expr::Match { expr: Expr::Var { name: source_name, ty: source_ty }, arms: result, default, ty }
}

fn pattern_matches_bool(value: tast::Pat, expected: bool) -> bool {
    match value {
        Prim { value: Bool { value }, ty: _ } => value == expected,
        Wild { ty: _ } | Var { name: _, is_mut: _, ty: _ } => true,
        _ => false,
    }
}

fn bool_arm(arms: Vec[tast::Arm], expected: bool) -> Option[tast::Arm] {
    for arm in arms {
        if pattern_matches_bool(arm.pat, expected) {
            return Option::Some(arm)
        } else {}
    }
    Option::None
}

fn lower_bool_match(ctx: Lowerer, source_name: string, arms: Vec[tast::Arm], ty: tast::Type) -> Expr {
    let result: Vec[Arm] = Vec::[];
    for expected in Vec::[true, false] {
        let body = match bool_arm(arms, expected) {
            Some(arm) => bind_match_pattern(
                source_name,
                tast::Type::Bool,
                arm.pat,
                ty,
                lower_expr(ctx, arm.body),
            ),
            None => missing_expr(ty),
        };
        result.push(Arm { lhs: bool_expr(expected), body })
    }
    Expr::Match {
        expr: Expr::Var { name: source_name, ty: tast::Type::Bool },
        arms: result,
        default: Option::None,
        ty,
    }
}

fn lower_unit_match(ctx: Lowerer, source_name: string, arms: Vec[tast::Arm], ty: tast::Type) -> Expr {
    let body = if !arms.is_empty() {
        let arm = arms[0];
        bind_match_pattern(source_name, tast::Type::Unit, arm.pat, ty, lower_expr(ctx, arm.body))
    } else {
        missing_expr(ty)
    };
    let result: Vec[Arm] = Vec::[];
    result.push(
        Arm { lhs: Expr::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit }, body },
    );
    Expr::Match {
        expr: Expr::Var { name: source_name, ty: tast::Type::Unit },
        arms: result,
        default: Option::None,
        ty,
    }
}

fn enum_rows_for_variant(
    arms: Vec[tast::Arm],
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
    source_name: string,
    source_ty: tast::Type,
) -> Option[Vec[PatternRow]] {
    let rows: Vec[PatternRow] = Vec::[];
    for arm in arms {
        match arm.guard {
            Some(_) => return Option::None,
            None => match arm.pat {
                Constr { constructor, args: patterns, ty: _ } => if constructor.name
                    == constructor_name {
                    if patterns.len() == variables.len() {
                        let columns: Vec[PatternColumn] = Vec::[];
                        for index in 0..patterns.len() {
                            let variable = variables[index];
                            columns.push(
                                PatternColumn {
                                    source: variable.0,
                                    source_ty: variable.1,
                                    pattern: patterns[index],
                                },
                            )
                        }
                        rows.push(PatternRow { columns, bindings: Vec::[], body: arm.body })
                    } else {
                        return Option::None
                    }
                } else {},
                Wild { ty: _ } => rows.push(
                    PatternRow { columns: Vec::[], bindings: Vec::[], body: arm.body },
                ),
                Var { name, is_mut: _, ty } => {
                    let bindings: Vec[PatternBinding] = Vec::[];
                    bindings.push(PatternBinding { name, source: source_name, ty });
                    rows.push(PatternRow { columns: Vec::[], bindings, body: arm.body })
                },
                _ => return Option::None,
            },
        }
    }
    if !rows.is_empty() {
        Option::Some(rows)
    } else {
        Option::None
    }
}

fn enum_match_cases(
    ctx: Lowerer,
    definition: tast::EnumDef,
    type_args: Vec[tast::Type],
    arms: Vec[tast::Arm],
    source_name: string,
    source_ty: tast::Type,
) -> Option[Vec[EnumCase]] {
    let cases: Vec[EnumCase] = Vec::[];
    for variant_index in 0..definition.variants.len() {
        let variant = definition.variants[variant_index];
        let constructor_name = definition.name + "::" + variant.name;
        let variables: Vec[(string, tast::Type)] = Vec::[];
        for field in tast::enum_variant_field_types(variant.fields) {
            variables.push(
                (gensym(ctx, "x"), tast::substitute_params(field, definition.generics, type_args)),
            )
        }
        match enum_rows_for_variant(arms, constructor_name, variables, source_name, source_ty) {
            Some(rows) => cases.push(
                EnumCase {
                    constructor: tast::Constructor {
                        name: constructor_name,
                        fields: Vec::[],
                        is_struct: false,
                        tag: Option::Some(variant_index),
                    },
                    variables,
                    rows,
                },
            ),
            None => return Option::None,
        }
    }
    Option::Some(cases)
}

fn lower_enum_cases(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    cases: Vec[EnumCase],
    ty: tast::Type,
) -> Expr {
    let result: Vec[Arm] = Vec::[];
    for case in cases {
        let args: Vec[Expr] = Vec::[];
        let extractions: Vec[LetStmt] = Vec::[];
        for index in 0..case.variables.len() {
            let variable = case.variables[index];
            args.push(Expr::Var { name: variable.0, ty: variable.1 });
            extractions.push(
                LetStmt {
                    name: variable.0,
                    value: Expr::ConstrGet {
                        expr: Expr::Var { name: source_name, ty: source_ty },
                        constructor: case.constructor,
                        field_index: index,
                        ty: variable.1,
                    },
                    ty: variable.1,
                },
            )
        }
        let body = lower_pattern_rows(ctx, case.rows, ty);
        let body = if !extractions.is_empty() {
            Expr::Block { block: Block { stmts: extractions, tail: Option::Some(body) }, ty }
        } else {
            body
        };
        result.push(
            Arm { lhs: Expr::Constr { constructor: case.constructor, args, ty: source_ty }, body },
        )
    }
    Expr::Match {
        expr: Expr::Var { name: source_name, ty: source_ty },
        arms: result,
        default: Option::None,
        ty,
    }
}

fn lower_match_on_variable(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    arms: Vec[tast::Arm],
    ty: tast::Type,
) -> Expr {
    match nominal_parts(source_ty) {
        Some((name, type_args)) => match find_enum(ctx, name) {
            Some(_) => match pattern_rows_from_arms(source_name, source_ty, arms) {
                Some(rows) => lower_pattern_rows(ctx, rows, ty),
                None => lower_generic_match(ctx, source_name, source_ty, arms, ty),
            },
            None => match find_struct(ctx, name) {
                Some(_) => match pattern_rows_from_arms(source_name, source_ty, arms) {
                    Some(rows) => lower_pattern_rows(ctx, rows, ty),
                    None => {
                        lower_generic_match(ctx, source_name, source_ty, arms, ty)
                    },
                },
                None => lower_generic_match(ctx, source_name, source_ty, arms, ty),
            },
        },
        None => match tast::resolve_type(source_ty) {
            Bool => lower_bool_match(ctx, source_name, arms, ty),
            Unit => lower_unit_match(ctx, source_name, arms, ty),
            Tuple { items: _ } => match pattern_rows_from_arms(source_name, source_ty, arms) {
                Some(rows) => lower_pattern_rows(ctx, rows, ty),
                None => lower_generic_match(ctx, source_name, source_ty, arms, ty),
            },
            _ => if primitive_pattern_type(source_ty) {
                match pattern_rows_from_arms(source_name, source_ty, arms) {
                    Some(rows) => lower_pattern_rows(ctx, rows, ty),
                    None => {
                        lower_generic_match(ctx, source_name, source_ty, arms, ty)
                    },
                }
            } else {
                lower_generic_match(ctx, source_name, source_ty, arms, ty)
            },
        },
    }
}

fn lower_match(ctx: Lowerer, source: tast::Expr, arms: Vec[tast::Arm], ty: tast::Type) -> Expr {
    let source_ty = tast::expr_type(source);
    if arms_require_ordered(arms) {
        lower_ordered_match(ctx, source, arms, ty)
    } else if arms.is_empty() {
        let source_value = lower_expr(ctx, source);
        let source_name = gensym(ctx, "_wild");
        let stmts: Vec[LetStmt] = Vec::[];
        stmts.push(LetStmt { name: source_name, value: source_value, ty: source_ty });
        Expr::Block { block: Block { stmts, tail: Option::Some(missing_expr(ty)) }, ty }
    } else {
        match source {
            Var { name: source_name, ty: _ } => {
                lower_match_on_variable(ctx, source_name, source_ty, arms, ty)
            },
            other => {
                let source_name = gensym(ctx, "mtmp");
                let source_value = lower_expr(ctx, other);
                let body = lower_match_on_variable(ctx, source_name, source_ty, arms, ty);
                let stmts: Vec[LetStmt] = Vec::[];
                stmts.push(LetStmt { name: source_name, value: source_value, ty: source_ty });
                Expr::Block { block: Block { stmts, tail: Option::Some(body) }, ty }
            },
        }
    }
}

fn lower_index(ctx: Lowerer, base: tast::Expr, index: tast::Expr, ty: tast::Type) -> Expr {
    let base_ty = tast::expr_type(base);
    let index_ty = tast::expr_type(index);
    let callable = match tast::resolve_type(base_ty) {
        Array { len: _, elem: _ } => tast::Callable::Intrinsic("array.get"),
        VecType { elem: _ } => tast::Callable::Intrinsic("vec.get"),
        Slice { elem: _ } => tast::Callable::Intrinsic("slice.get"),
        HashMap { key: _, value: _ } => tast::Callable::Intrinsic("hashmap.get"),
        String => tast::Callable::Runtime("core.string_get"),
        _ => tast::Callable::Intrinsic("compiler.missing"),
    };
    let params: Vec[tast::Type] = Vec::[];
    params.push(base_ty);
    params.push(index_ty);
    let args: Vec[Expr] = Vec::[];
    args.push(lower_expr(ctx, base));
    args.push(lower_expr(ctx, index));
    Expr::Call {
        func: Expr::Callable { callable, ty: tast::Type::Func { params, ret_ty: ty } },
        args,
        ty,
    }
}

fn lower_field(ctx: Lowerer, value: tast::Expr, name: string, ty: tast::Type) -> Expr {
    let owner = inherent_base(tast::expr_type(value));
    match find_struct(ctx, owner) {
        Some(definition) => {
            let fields: Vec[string] = Vec::[];
            let mut field_index = 0;
            for index in 0..definition.fields.len() {
                let field = definition.fields[index];
                fields.push(field.0);
                if field.0 == name {
                    field_index = index;
                } else {}
            }
            Expr::ConstrGet {
                expr: lower_expr(ctx, value),
                constructor: tast::Constructor {
                    name: owner,
                    fields,
                    is_struct: true,
                    tag: Option::None,
                },
                field_index,
                ty,
            }
        },
        None => {
            let fields: Vec[string] = Vec::[];
            fields.push(name);
            Expr::ConstrGet {
                expr: lower_expr(ctx, value),
                constructor: tast::Constructor {
                    name: owner,
                    fields,
                    is_struct: true,
                    tag: Option::None,
                },
                field_index: 0,
                ty,
            }
        },
    }
}

fn direct_for_body(
    ctx: Lowerer,
    pattern: tast::Pat,
    index_name: string,
    item_value: Expr,
    body: tast::Expr,
) -> Expr {
    let item_ty = tast::pat_type(pattern);
    let item_name = gensym(ctx, "for_item");
    let advance_name = gensym(ctx, "_wild");
    let stmts: Vec[LetStmt] = Vec::[];
    stmts.push(LetStmt { name: item_name, value: item_value, ty: item_ty });
    stmts.push(
        LetStmt {
            name: advance_name,
            value: Expr::Assign {
                name: index_name,
                value: Expr::Binary {
                    op: ast::BinaryOp::Add,
                    lhs: Expr::Var { name: index_name, ty: tast::Type::Int },
                    rhs: ordered_int(1),
                    ty: tast::Type::Int,
                },
                target_ty: tast::Type::Int,
                ty: tast::Type::Unit,
            },
            ty: tast::Type::Unit,
        },
    );
    Expr::Block {
        block: Block {
            stmts,
            tail: Option::Some(
                lower_pattern_continuation(
                    ctx,
                    item_name,
                    item_ty,
                    pattern,
                    body,
                    Option::None,
                    tast::Type::Unit,
                ),
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn direct_for_loop(
    ctx: Lowerer,
    pattern: tast::Pat,
    source_stmts: Vec[LetStmt],
    index_name: string,
    limit_name: string,
    item_value: Expr,
    body: tast::Expr,
) -> Expr {
    Expr::Block {
        block: Block {
            stmts: source_stmts,
            tail: Option::Some(
                Expr::While {
                    cond: Expr::Binary {
                        op: ast::BinaryOp::Less,
                        lhs: Expr::Var { name: index_name, ty: tast::Type::Int },
                        rhs: Expr::Var { name: limit_name, ty: tast::Type::Int },
                        ty: tast::Type::Bool,
                    },
                    body: direct_for_body(ctx, pattern, index_name, item_value, body),
                    ty: tast::Type::Unit,
                },
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn direct_range_for(ctx: Lowerer, pattern: tast::Pat, args: Vec[tast::Expr], body: tast::Expr) -> Option[
    Expr,
] {
    if args.len() != 2 {
        Option::None
    } else {
        let index_name = gensym(ctx, "for_index");
        let limit_name = gensym(ctx, "for_limit");
        let stmts: Vec[LetStmt] = Vec::[];
        stmts.push(
            LetStmt { name: index_name, value: lower_expr(ctx, args[0]), ty: tast::Type::Int },
        );
        stmts.push(
            LetStmt { name: limit_name, value: lower_expr(ctx, args[1]), ty: tast::Type::Int },
        );
        Option::Some(
            direct_for_loop(
                ctx,
                pattern,
                stmts,
                index_name,
                limit_name,
                Expr::Var { name: index_name, ty: tast::Type::Int },
                body,
            ),
        )
    }
}

fn direct_inclusive_range_body(
    ctx: Lowerer,
    pattern: tast::Pat,
    index_name: string,
    limit_name: string,
    done_name: string,
    body: tast::Expr,
) -> Expr {
    let item_ty = tast::pat_type(pattern);
    let item_name = gensym(ctx, "for_item");
    let advance_name = gensym(ctx, "_wild");
    let stmts: Vec[LetStmt] = Vec::[];
    stmts.push(
        LetStmt {
            name: item_name,
            value: Expr::Var { name: index_name, ty: tast::Type::Int },
            ty: item_ty,
        },
    );
    stmts.push(
        LetStmt {
            name: advance_name,
            value: Expr::If {
                cond: Expr::Binary {
                    op: ast::BinaryOp::Eq,
                    lhs: Expr::Var { name: index_name, ty: tast::Type::Int },
                    rhs: Expr::Var { name: limit_name, ty: tast::Type::Int },
                    ty: tast::Type::Bool,
                },
                then_branch: Expr::Assign {
                    name: done_name,
                    value: bool_expr(true),
                    target_ty: tast::Type::Bool,
                    ty: tast::Type::Unit,
                },
                else_branch: Expr::Assign {
                    name: index_name,
                    value: Expr::Binary {
                        op: ast::BinaryOp::Add,
                        lhs: Expr::Var { name: index_name, ty: tast::Type::Int },
                        rhs: ordered_int(1),
                        ty: tast::Type::Int,
                    },
                    target_ty: tast::Type::Int,
                    ty: tast::Type::Unit,
                },
                ty: tast::Type::Unit,
            },
            ty: tast::Type::Unit,
        },
    );
    Expr::Block {
        block: Block {
            stmts,
            tail: Option::Some(
                lower_pattern_continuation(
                    ctx,
                    item_name,
                    item_ty,
                    pattern,
                    body,
                    Option::None,
                    tast::Type::Unit,
                ),
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn direct_inclusive_range_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    args: Vec[tast::Expr],
    body: tast::Expr,
) -> Option[Expr] {
    if args.len() != 2 {
        Option::None
    } else {
        let index_name = gensym(ctx, "for_index");
        let limit_name = gensym(ctx, "for_limit");
        let done_name = gensym(ctx, "for_done");
        let stmts: Vec[LetStmt] = Vec::[];
        stmts.push(
            LetStmt { name: index_name, value: lower_expr(ctx, args[0]), ty: tast::Type::Int },
        );
        stmts.push(
            LetStmt { name: limit_name, value: lower_expr(ctx, args[1]), ty: tast::Type::Int },
        );
        stmts.push(
            LetStmt {
                name: done_name,
                value: Expr::Binary {
                    op: ast::BinaryOp::Greater,
                    lhs: Expr::Var { name: index_name, ty: tast::Type::Int },
                    rhs: Expr::Var { name: limit_name, ty: tast::Type::Int },
                    ty: tast::Type::Bool,
                },
                ty: tast::Type::Bool,
            },
        );
        Option::Some(
            Expr::Block {
                block: Block {
                    stmts,
                    tail: Option::Some(
                        Expr::While {
                            cond: Expr::Unary {
                                op: ast::UnaryOp::Not,
                                expr: Expr::Var { name: done_name, ty: tast::Type::Bool },
                                ty: tast::Type::Bool,
                            },
                            body: direct_inclusive_range_body(
                                ctx,
                                pattern,
                                index_name,
                                limit_name,
                                done_name,
                                body,
                            ),
                            ty: tast::Type::Unit,
                        },
                    ),
                },
                ty: tast::Type::Unit,
            },
        )
    }
}

fn direct_container_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    container_ty: tast::Type,
    len_intrinsic: string,
    get_intrinsic: string,
    body: tast::Expr,
) -> Expr {
    let item_ty = tast::pat_type(pattern);
    let source_name = gensym(ctx, "for_source");
    let limit_name = gensym(ctx, "for_limit");
    let index_name = gensym(ctx, "for_index");
    let len_params: Vec[tast::Type] = Vec::[];
    len_params.push(container_ty);
    let len_args: Vec[Expr] = Vec::[];
    len_args.push(Expr::Var { name: source_name, ty: container_ty });
    let stmts: Vec[LetStmt] = Vec::[];
    stmts.push(LetStmt { name: source_name, value: lower_expr(ctx, iterator), ty: container_ty });
    stmts.push(
        LetStmt {
            name: limit_name,
            value: place_intrinsic_call(len_intrinsic, len_params, tast::Type::Int, len_args),
            ty: tast::Type::Int,
        },
    );
    stmts.push(LetStmt { name: index_name, value: ordered_int(0), ty: tast::Type::Int });
    let get_params: Vec[tast::Type] = Vec::[];
    get_params.push(container_ty);
    get_params.push(tast::Type::Int);
    let get_args: Vec[Expr] = Vec::[];
    get_args.push(Expr::Var { name: source_name, ty: container_ty });
    get_args.push(Expr::Var { name: index_name, ty: tast::Type::Int });
    direct_for_loop(
        ctx,
        pattern,
        stmts,
        index_name,
        limit_name,
        place_intrinsic_call(get_intrinsic, get_params, item_ty, get_args),
        body,
    )
}

fn lower_direct_for(ctx: Lowerer, pattern: tast::Pat, iterator: tast::Expr, body: tast::Expr) -> Option[
    Expr,
] {
    match iterator {
        Call {
            func: Callable { callable: LangItem { item: "range", function_name: _ }, ty: _ },
            args,
            ty: _,
        } => {
            direct_range_for(ctx, pattern, args, body)
        },
        Call {
            func: Callable {
                callable: LangItem { item: "range_inclusive", function_name: _ },
                ty: _,
            },
            args,
            ty: _,
        } => direct_inclusive_range_for(ctx, pattern, args, body),
        other => {
            let container_ty = tast::resolve_type(tast::expr_type(other));
            match container_ty {
                VecType { elem: _ } => Option::Some(
                    direct_container_for(
                        ctx,
                        pattern,
                        other,
                        container_ty,
                        "vec.len",
                        "vec.get",
                        body,
                    ),
                ),
                Slice { elem: _ } => Option::Some(
                    direct_container_for(
                        ctx,
                        pattern,
                        other,
                        container_ty,
                        "slice.len",
                        "slice.get",
                        body,
                    ),
                ),
                _ => Option::None,
            }
        },
    }
}

fn lower_iterator_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    into_iterator: tast::TraitRef,
    iterator_trait: tast::TraitRef,
    iterator_ty: tast::Type,
    body: tast::Expr,
) -> Expr {
    let item_ty = tast::pat_type(pattern);
    let option_args: Vec[tast::Type] = Vec::[];
    option_args.push(item_ty);
    let option_ty = tast::Type::App { ty: tast::Type::Con { name: "Option" }, args: option_args };
    let iterator_name = gensym(ctx, "for_iter");
    let next_name = gensym(ctx, "for_next");
    let no_args: Vec[Expr] = Vec::[];
    let iterator_value = Expr::TraitCall {
        trait_ref: into_iterator,
        method_name: "into_iter",
        instance_name: Option::None,
        receiver: lower_expr(ctx, iterator),
        args: no_args,
        ty: iterator_ty,
    };
    let next_args: Vec[Expr] = Vec::[];
    let next_value = Expr::TraitCall {
        trait_ref: iterator_trait,
        method_name: "next",
        instance_name: Option::None,
        receiver: Expr::Var { name: iterator_name, ty: iterator_ty },
        args: next_args,
        ty: option_ty,
    };
    let some_patterns: Vec[tast::Pat] = Vec::[];
    some_patterns.push(pattern);
    let arms: Vec[tast::Arm] = Vec::[];
    arms.push(
        tast::Arm {
            pat: tast::Pat::Constr {
                constructor: tast::Constructor {
                    name: "Option::Some",
                    fields: Vec::[],
                    is_struct: false,
                    tag: Option::Some(1),
                },
                args: some_patterns,
                ty: option_ty,
            },
            guard: Option::None,
            body,
        },
    );
    arms.push(
        tast::Arm {
            pat: tast::Pat::Constr {
                constructor: tast::Constructor {
                    name: "Option::None",
                    fields: Vec::[],
                    is_struct: false,
                    tag: Option::Some(0),
                },
                args: Vec::[],
                ty: option_ty,
            },
            guard: Option::None,
            body: tast::Expr::Break { target: 0, value: Option::None, ty: tast::Type::Unit },
        },
    );
    let loop_stmts: Vec[LetStmt] = Vec::[];
    loop_stmts.push(LetStmt { name: next_name, value: next_value, ty: option_ty });
    let loop_body = Expr::Block {
        block: Block {
            stmts: loop_stmts,
            tail: Option::Some(
                lower_match_on_variable(ctx, next_name, option_ty, arms, tast::Type::Unit),
            ),
        },
        ty: tast::Type::Unit,
    };
    let stmts: Vec[LetStmt] = Vec::[];
    stmts.push(LetStmt { name: iterator_name, value: iterator_value, ty: iterator_ty });
    Expr::Block {
        block: Block {
            stmts,
            tail: Option::Some(
                Expr::While { cond: bool_expr(true), body: loop_body, ty: tast::Type::Unit },
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn lower_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    into_iterator: tast::TraitRef,
    iterator_trait: tast::TraitRef,
    iterator_ty: tast::Type,
    body: tast::Expr,
) -> Expr {
    if ctx.optimize_builtin_iterators {
        match lower_direct_for(ctx, pattern, iterator, body) {
            Some(value) => value,
            None => lower_iterator_for(
                ctx,
                pattern,
                iterator,
                into_iterator,
                iterator_trait,
                iterator_ty,
                body,
            ),
        }
    } else {
        lower_iterator_for(ctx, pattern, iterator, into_iterator, iterator_trait, iterator_ty, body)
    }
}

fn lower_expr(ctx: Lowerer, value: tast::Expr) -> Expr {
    match value {
        Var { name, ty } => Expr::Var { name, ty },
        Callable { callable: Function(name), ty } | Callable {
            callable: LangItem { item: _, function_name: name },
            ty,
        } => {
            Expr::Var { name, ty }
        },
        Callable { callable, ty } => Expr::Callable { callable, ty },
        Prim { value, ty } => Expr::Prim { value, ty },
        Constr { constructor, args, ty } => {
            Expr::Constr { constructor, args: lower_exprs(ctx, args), ty }
        },
        Tuple { items, ty } => Expr::Tuple { items: lower_exprs(ctx, items), ty },
        Array { items, ty } => Expr::Array { items: lower_exprs(ctx, items), ty },
        Closure { params, body, ty } => {
            let saved_cleanups: Vec[tast::Expr] = Vec::[];
            for value in ctx.cleanups {
                saved_cleanups.push(value)
            }
            let saved_loop_depths: Vec[int] = Vec::[];
            for value in ctx.loop_cleanup_depths {
                saved_loop_depths.push(value)
            }
            let saved_cleanup_lowering_depth = ctx.cleanup_lowering_depth.get();
            ctx.cleanups.truncate(0);
            ctx.loop_cleanup_depths.truncate(0);
            ctx.cleanup_lowering_depth.set(0);
            let body = lower_expr(ctx, body);
            for value in saved_cleanups {
                ctx.cleanups.push(value)
            }
            for value in saved_loop_depths {
                ctx.loop_cleanup_depths.push(value)
            }
            ctx.cleanup_lowering_depth.set(saved_cleanup_lowering_depth);
            Expr::Closure { params, body, ty }
        },
        Block { block, ty } => Expr::Block { block: lower_block(ctx, block, ty), ty },
        Match { expr: source, arms, ty } => lower_match(ctx, source, arms, ty),
        If { cond, then_branch, else_branch, ty } => Expr::If {
            cond: lower_expr(ctx, cond),
            then_branch: lower_expr(ctx, then_branch),
            else_branch: lower_expr(ctx, else_branch),
            ty,
        },
        While { cond, body, ty } => {
            let cond = lower_expr(ctx, cond);
            ctx.loop_cleanup_depths.push(ctx.cleanups.len());
            let body = lower_expr(ctx, body);
            ctx.loop_cleanup_depths.truncate(ctx.loop_cleanup_depths.len() - 1);
            Expr::While { cond, body, ty }
        },
        Loop { body, ty } => {
            ctx.loop_cleanup_depths.push(ctx.cleanups.len());
            let body = lower_expr(ctx, body);
            ctx.loop_cleanup_depths.truncate(ctx.loop_cleanup_depths.len() - 1);
            Expr::Loop { body, ty }
        },
        For {
            pat: pattern,
            iterator,
            into_iter_trait_ref: into_iterator,
            iterator_trait_ref: iterator_trait,
            iterator_ty,
            body,
            ty: _,
        } => {
            ctx.loop_cleanup_depths.push(ctx.cleanups.len());
            let result = lower_for(
                ctx,
                pattern,
                iterator,
                into_iterator,
                iterator_trait,
                iterator_ty,
                body,
            );
            ctx.loop_cleanup_depths.truncate(ctx.loop_cleanup_depths.len() - 1);
            result
        },
        Break { target, value, ty } => lower_break(ctx, target, value, ty),
        Continue { target, ty } => lower_continue(ctx, target, ty),
        Return { expr: value, ty } => lower_return(ctx, value, ty),
        Go { expr: value, ty } => Expr::Go { expr: lower_expr(ctx, value), ty },
        Call { func: function, args, ty } => lower_call(ctx, function, args, ty),
        Unary { op: Neg, expr: Prim { value, ty: _ }, ty } => {
            match negated_integer(value) {
                Some(primitive) => Expr::Prim { value: primitive, ty },
                None => Expr::Unary {
                    op: ast::UnaryOp::Neg,
                    expr: lower_expr(ctx, tast::Expr::Prim { value, ty }),
                    ty,
                },
            }
        },
        Unary { op, expr: value, ty } => Expr::Unary { op, expr: lower_expr(ctx, value), ty },
        Cast { expr: value, ty } => Expr::Cast { expr: lower_expr(ctx, value), ty },
        Proj { tuple: value, index, ty } => if tast_expr_exits(value) {
            exit_expr_as(ctx, lower_expr(ctx, value), ty)
        } else {
            Expr::Proj { tuple: lower_expr(ctx, value), index, ty }
        },
        Field { expr: value, field_name: name, ty } => if tast_expr_exits(value) {
            exit_expr_as(ctx, lower_expr(ctx, value), ty)
        } else {
            lower_field(ctx, value, name, ty)
        },
        Index { base, index, ty } => if tast_expr_exits(base) {
            exit_expr_as(ctx, lower_expr(ctx, base), ty)
        } else if tast_expr_exits(index) {
            let base_ty = tast::expr_type(base);
            let base_value = lower_expr(ctx, base);
            let index_value = lower_expr(ctx, index);
            let stmts: Vec[LetStmt] = Vec::[];
            stmts.push(LetStmt { name: gensym(ctx, "_wild"), value: base_value, ty: base_ty });
            Expr::Block {
                block: Block { stmts, tail: Option::Some(exit_expr_as(ctx, index_value, ty)) },
                ty,
            }
        } else {
            lower_index(ctx, base, index, ty)
        },
        Binary { op: And, lhs: left, rhs: right, ty, resolution: _ } => Expr::If {
            cond: lower_expr(ctx, left),
            then_branch: lower_expr(ctx, right),
            else_branch: bool_expr(false),
            ty,
        },
        Binary { op: Or, lhs: left, rhs: right, ty, resolution: _ } => Expr::If {
            cond: lower_expr(ctx, left),
            then_branch: bool_expr(true),
            else_branch: lower_expr(ctx, right),
            ty,
        },
        Binary { op, lhs: left, rhs: right, ty: _, resolution: Overloaded { trait_name } } => {
            lower_eq_expr(ctx, trait_name, op, left, right)
        },
        Binary { op, lhs: left, rhs: right, ty, resolution: _ } => {
            Expr::Binary { op, lhs: lower_expr(ctx, left), rhs: lower_expr(ctx, right), ty }
        },
        ToDyn { trait_name: name, for_ty, expr: value, ty } => {
            Expr::ToDyn { trait_name: name, for_ty, expr: lower_expr(ctx, value), ty }
        },
    }
}

fn lower_cleanup_stmts(ctx: Lowerer, start: int) -> Vec[LetStmt] {
    let result: Vec[LetStmt] = Vec::[];
    let mut index = ctx.cleanups.len();
    while index > start {
        index = index - 1;
        ctx.cleanup_lowering_depth.set(ctx.cleanup_lowering_depth.get() + 1);
        let value = lower_expr(ctx, ctx.cleanups[index]);
        ctx.cleanup_lowering_depth.set(ctx.cleanup_lowering_depth.get() - 1);
        result.push(LetStmt { name: gensym(ctx, "_defer"), value, ty: tast::Type::Unit })
    }
    result
}

fn lower_break(ctx: Lowerer, target: int, value: Option[tast::Expr], ty: tast::Type) -> Expr {
    let start = if ctx.loop_cleanup_depths.is_empty() {
        0
    } else {
        ctx.loop_cleanup_depths[ctx.loop_cleanup_depths.len() - 1 - target]
    };
    if ctx.cleanup_lowering_depth.get() > 0 || ctx.cleanups.len() == start {
        Expr::Break {
            target,
            value: match value {
                Some(expr) => Option::Some(lower_expr(ctx, expr)),
                None => Option::None,
            },
            ty,
        }
    } else {
        match value {
            Some(source) => {
                let value_ty = tast::expr_type(source);
                let name = gensym(ctx, "defer_break");
                let stmts: Vec[LetStmt] = Vec::[];
                stmts.push(LetStmt { name, value: lower_expr(ctx, source), ty: value_ty });
                for stmt in lower_cleanup_stmts(ctx, start) {
                    stmts.push(stmt)
                }
                Expr::Block {
                    block: Block {
                        stmts,
                        tail: Option::Some(
                            Expr::Break {
                                target,
                                value: Option::Some(Expr::Var { name, ty: value_ty }),
                                ty,
                            },
                        ),
                    },
                    ty,
                }
            },
            None => Expr::Block {
                block: Block {
                    stmts: lower_cleanup_stmts(ctx, start),
                    tail: Option::Some(Expr::Break { target, value: Option::None, ty }),
                },
                ty,
            },
        }
    }
}

fn lower_continue(ctx: Lowerer, target: int, ty: tast::Type) -> Expr {
    let start = if ctx.loop_cleanup_depths.is_empty() {
        0
    } else {
        ctx.loop_cleanup_depths[ctx.loop_cleanup_depths.len() - 1 - target]
    };
    if ctx.cleanup_lowering_depth.get() > 0 || ctx.cleanups.len() == start {
        Expr::Continue { target, ty }
    } else {
        Expr::Block {
            block: Block {
                stmts: lower_cleanup_stmts(ctx, start),
                tail: Option::Some(Expr::Continue { target, ty }),
            },
            ty,
        }
    }
}

fn lower_return(ctx: Lowerer, value: Option[tast::Expr], ty: tast::Type) -> Expr {
    if ctx.cleanup_lowering_depth.get() > 0 || ctx.cleanups.is_empty() {
        Expr::Return {
            expr: match value {
                Some(expr) => Option::Some(lower_expr(ctx, expr)),
                None => Option::None,
            },
            ty,
        }
    } else {
        match value {
            Some(source) => {
                let value_ty = tast::expr_type(source);
                let name = gensym(ctx, "defer_return");
                let stmts: Vec[LetStmt] = Vec::[];
                stmts.push(LetStmt { name, value: lower_expr(ctx, source), ty: value_ty });
                for stmt in lower_cleanup_stmts(ctx, 0) {
                    stmts.push(stmt)
                }
                Expr::Block {
                    block: Block {
                        stmts,
                        tail: Option::Some(
                            Expr::Return {
                                expr: Option::Some(Expr::Var { name, ty: value_ty }),
                                ty,
                            },
                        ),
                    },
                    ty,
                }
            },
            None => Expr::Block {
                block: Block {
                    stmts: lower_cleanup_stmts(ctx, 0),
                    tail: Option::Some(Expr::Return { expr: Option::None, ty }),
                },
                ty,
            },
        }
    }
}

fn prepend_stmt(value: LetStmt, rest: Block) -> Block {
    let stmts: Vec[LetStmt] = Vec::[];
    stmts.push(value);
    for stmt in rest.stmts {
        stmts.push(stmt)
    }
    Block { stmts, tail: rest.tail }
}

fn remaining_tast_block(
    ctx: Lowerer,
    stmts: Vec[tast::Stmt],
    index: int,
    tail: Option[tast::Expr],
    ty: tast::Type,
    cleanup_start: int,
) -> tast::Expr {
    let remaining: Vec[tast::Stmt] = Vec::[];
    for current in index..stmts.len() {
        remaining.push(stmts[current])
    }
    if ctx.cleanups.len() == cleanup_start {
        return tast::Expr::Block { block: tast::Block { stmts: remaining, tail }, ty }
    } else {};
    let tail = match tail {
        Some(value) => {
            let value_ty = tast::expr_type(value);
            let name = gensym(ctx, "defer_tast_result");
            let stmts: Vec[tast::Stmt] = Vec::[];
            stmts.push(
                tast::Stmt::Let {
                    is_mut: false,
                    pat: tast::Pat::Var { name, is_mut: false, ty: value_ty },
                    value,
                },
            );
            let mut cleanup_index = ctx.cleanups.len();
            while cleanup_index > cleanup_start {
                cleanup_index = cleanup_index - 1;
                stmts.push(tast::Stmt::Expr { expr: ctx.cleanups[cleanup_index] })
            }
            Option::Some(
                tast::Expr::Block {
                    block: tast::Block {
                        stmts,
                        tail: Option::Some(tast::Expr::Var { name, ty: value_ty }),
                    },
                    ty: value_ty,
                },
            )
        },
        None => {
            let mut cleanup_index = ctx.cleanups.len();
            while cleanup_index > cleanup_start {
                cleanup_index = cleanup_index - 1;
                remaining.push(tast::Stmt::Expr { expr: ctx.cleanups[cleanup_index] })
            }
            Option::None
        },
    };
    tast::Expr::Block { block: tast::Block { stmts: remaining, tail }, ty }
}

fn lower_pattern_continuation(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
    body: tast::Expr,
    failure: Option[tast::Expr],
    ty: tast::Type,
) -> Expr {
    if pattern_requires_ordered(pattern) {
        lower_ordered_pattern(
            ctx,
            pattern,
            Expr::Var { name: source_name, ty: source_ty },
            lower_expr(ctx, body),
            match failure {
                Some(value) => lower_expr(ctx, value),
                None => missing_expr(ty),
            },
            ty,
        )
    } else {
        let columns: Vec[PatternColumn] = Vec::[];
        columns.push(PatternColumn { source: source_name, source_ty, pattern });
        let rows: Vec[PatternRow] = Vec::[];
        rows.push(PatternRow { columns, bindings: Vec::[], body });
        match failure {
            Some(value) => {
                let fallback_columns: Vec[PatternColumn] = Vec::[];
                fallback_columns.push(
                    PatternColumn {
                        source: source_name,
                        source_ty,
                        pattern: tast::Pat::Wild { ty: source_ty },
                    },
                );
                rows.push(PatternRow { columns: fallback_columns, bindings: Vec::[], body: value })
            },
            None => (),
        };
        lower_pattern_rows(ctx, rows, ty)
    }
}

fn lower_block_from(
    ctx: Lowerer,
    stmts: Vec[tast::Stmt],
    index: int,
    tail: Option[tast::Expr],
    ty: tast::Type,
    cleanup_start: int,
) -> Block {
    if index >= stmts.len() {
        if ctx.cleanups.len() == cleanup_start {
            Block {
                stmts: Vec::[],
                tail: match tail {
                    Some(value) => Option::Some(lower_expr(ctx, value)),
                    None => Option::None,
                },
            }
        } else {
            match tail {
                Some(value) => if tast_expr_exits(value) {
                    Block { stmts: Vec::[], tail: Option::Some(lower_expr(ctx, value)) }
                } else {
                    let value_ty = tast::expr_type(value);
                    let name = gensym(ctx, "defer_result");
                    let result: Vec[LetStmt] = Vec::[];
                    result.push(LetStmt { name, value: lower_expr(ctx, value), ty: value_ty });
                    for stmt in lower_cleanup_stmts(ctx, cleanup_start) {
                        result.push(stmt)
                    }
                    Block { stmts: result, tail: Option::Some(Expr::Var { name, ty: value_ty }) }
                },
                None => Block { stmts: lower_cleanup_stmts(ctx, cleanup_start), tail: Option::None },
            }
        }
    } else {
        match stmts[index] {
            Defer { expr } => {
                ctx.cleanups.push(expr);
                lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start)
            },
            Let { is_mut: _, pat: Var { name, is_mut: _, ty: pat_ty }, value } => {
                let core_value = lower_expr(ctx, value);
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(LetStmt { name, value: core_value, ty: pat_ty }, rest)
            },
            Let { is_mut: _, pat: pattern, value } => {
                let value_ty = tast::expr_type(value);
                let core_value = lower_expr(ctx, value);
                let name = gensym(ctx, "mtmp");
                match plan_flat_pattern(ctx, name, pattern) {
                    Some(plan) => {
                        let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                        let result: Vec[LetStmt] = Vec::[];
                        result.push(LetStmt { name, value: core_value, ty: value_ty });
                        Block {
                            stmts: result,
                            tail: Option::Some(
                                apply_pattern_plan(plan, Expr::Block { block: rest, ty }, ty),
                            ),
                        }
                    },
                    None => {
                        let body = remaining_tast_block(
                            ctx,
                            stmts,
                            index + 1,
                            tail,
                            ty,
                            cleanup_start,
                        );
                        let matched = lower_pattern_continuation(
                            ctx,
                            name,
                            value_ty,
                            pattern,
                            body,
                            Option::None,
                            ty,
                        );
                        let result: Vec[LetStmt] = Vec::[];
                        result.push(LetStmt { name, value: core_value, ty: value_ty });
                        Block { stmts: result, tail: Option::Some(matched) }
                    },
                }
            },
            LetElse { is_mut: _, pat: pattern, value, else_branch } => {
                let value_ty = tast::expr_type(value);
                let core_value = lower_expr(ctx, value);
                let name = gensym(ctx, "mtmp");
                let body = remaining_tast_block(ctx, stmts, index + 1, tail, ty, cleanup_start);
                let matched = lower_pattern_continuation(
                    ctx,
                    name,
                    value_ty,
                    pattern,
                    body,
                    Option::Some(else_branch),
                    ty,
                );
                let result: Vec[LetStmt] = Vec::[];
                result.push(LetStmt { name, value: core_value, ty: value_ty });
                Block { stmts: result, tail: Option::Some(matched) }
            },
            Expr { expr: value } => {
                let value_ty = tast::expr_type(value);
                let core_value = lower_expr(ctx, value);
                let name = gensym(ctx, "_wild");
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(LetStmt { name, value: core_value, ty: value_ty }, rest)
            },
            Assign { target, op, value } => {
                let action = lower_assignment(ctx, target, op, value);
                let binding = gensym(ctx, "_wild");
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(LetStmt { name: binding, value: action, ty: tast::Type::Unit }, rest)
            },
        }
    }
}

fn lower_block(ctx: Lowerer, value: tast::Block, ty: tast::Type) -> Block {
    let cleanup_start = ctx.cleanups.len();
    let result = lower_block_from(ctx, value.stmts, 0, value.tail, ty, cleanup_start);
    ctx.cleanups.truncate(cleanup_start);
    result
}

fn lower_function(
    ctx: Lowerer,
    name: string,
    origin: FunctionOrigin,
    trait_impl: Option[TraitImpl],
    value: tast::Function,
    retain_generics: bool,
) -> Function {
    let hidden_cells = hidden_mutable_cells(value.body);
    let body = lower_block(ctx, value.body, value.ret_ty);
    Function {
        name,
        origin,
        root: true,
        generics: if retain_generics {
            value.generics
        } else {
            Vec::[]
        },
        predicates: value.predicates,
        trait_impl,
        params: value.params,
        ret_ty: value.ret_ty,
        body: if hidden_cells.is_empty() {
            body
        } else {
            lower_hidden_block(body, hidden_cells)
        },
    }
}

fn lower_file_with_types(
    value: tast::File,
    counter: Ref[int],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
) -> File {
    let enums = value.enums;
    let structs = value.structs;
    let all_enums: Vec[tast::EnumDef] = Vec::[];
    for definition in dependency_enums {
        all_enums.push(definition)
    }
    for definition in enums {
        all_enums.push(definition)
    }
    let all_structs: Vec[tast::StructDef] = Vec::[];
    for definition in dependency_structs {
        all_structs.push(definition)
    }
    for definition in structs {
        all_structs.push(definition)
    }
    let ctx = Lowerer {
        counter,
        enums: all_enums,
        structs: all_structs,
        optimize_builtin_iterators,
        cleanups: Vec::[],
        loop_cleanup_depths: Vec::[],
        cleanup_lowering_depth: Ref::new(0),
    };
    let functions: Vec[Function] = Vec::[];
    for item in value.items {
        match item {
            Function(function) => functions.push(
                lower_function(
                    ctx,
                    function.name,
                    FunctionOrigin::Source,
                    Option::None,
                    function,
                    false,
                ),
            ),
            ImplBlock(block) => for method in block.methods {
                let trait_impl = match block.trait_ref {
                    Some(reference) => Option::Some(
                        TraitImpl {
                            trait_ref: reference,
                            for_ty: block.for_type,
                            associated_types: block.associated_types,
                            generic_count: block.generics.len(),
                            predicate_count: block.predicates.len(),
                        },
                    ),
                    None => Option::None,
                };
                let name = match block.trait_ref {
                    Some(reference) => trait_impl_method_name(
                        reference,
                        block.for_type,
                        method.name,
                    ),
                    None => inherent_method_name(block.for_type, method.name),
                };
                let origin = match block.trait_ref {
                    Some(_) => FunctionOrigin::TraitImplementation { method_name: method.name },
                    None => FunctionOrigin::Inherent {
                        owner: block.for_type,
                        method_name: method.name,
                    },
                };
                functions.push(lower_function(ctx, name, origin, trait_impl, method, true))
            },
        }
    }
    File { functions, enums, structs, type_instances: Vec::[], constants: value.constants }
}

fn lower_file(value: tast::File, counter: Ref[int]) -> File {
    lower_file_with_types(value, counter, Vec::[], Vec::[], false)
}

pub fn lower_with_counter_types_and_options(
    value: tast::CheckResult,
    counter: Ref[int],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
) -> File {
    match value.tast {
        Some(file) => lower_file_with_types(
            file,
            counter,
            dependency_enums,
            dependency_structs,
            optimize_builtin_iterators,
        ),
        None => File {
            functions: Vec::[],
            enums: Vec::[],
            structs: Vec::[],
            type_instances: Vec::[],
            constants: Vec::[],
        },
    }
}

pub fn lower_with_counter_and_types(
    value: tast::CheckResult,
    counter: Ref[int],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
) -> File {
    lower_with_counter_types_and_options(
        value,
        counter,
        dependency_enums,
        dependency_structs,
        false,
    )
}

pub fn lower_with_counter(value: tast::CheckResult, counter: Ref[int]) -> File {
    match value.tast {
        Some(file) => lower_file(file, counter),
        None => File {
            functions: Vec::[],
            enums: Vec::[],
            structs: Vec::[],
            type_instances: Vec::[],
            constants: Vec::[],
        },
    }
}

pub fn lower(value: tast::CheckResult) -> File {
    lower_with_counter(value, Ref::new(0))
}
