package core;

use gomlc::ast;
use gomlc::hir;
use gomlc::parser;
use gomlc::tast;

fn non_root(value: Function) -> Function {
    Function {
        name: value.name,
        root: false,
        generics: value.generics,
        predicates: value.predicates,
        trait_impl: value.trait_impl,
        params: value.params,
        ret_ty: value.ret_ty,
        body: value.body,
    }
}

pub fn lower_builtins(counter: Ref[int]) -> File {
    lower_with_counter(
        tast::check(hir::lower(
            ast::lower(parser::parse(builtin_source())),
            "builtin_contract.gom",
        )),
        counter,
    )
}

pub fn link_with_dependencies(
    builtins: File,
    dependencies: Vec[File],
    user: File,
) -> File {
    let functions: Vec[Function] = Vec::new();
    for function in builtins.functions {
        functions.push(non_root(function))
    };
    for dependency in dependencies {
        for function in dependency.functions {
            functions.push(function)
        }
    };
    for function in user.functions {
        functions.push(function)
    };
    let enums: Vec[tast::EnumDef] = Vec::new();
    for value in builtins.enums {
        enums.push(value)
    };
    for dependency in dependencies {
        for value in dependency.enums {
            enums.push(value)
        }
    };
    for value in user.enums {
        enums.push(value)
    };
    let structs: Vec[tast::StructDef] = Vec::new();
    for value in builtins.structs {
        structs.push(value)
    };
    for dependency in dependencies {
        for value in dependency.structs {
            structs.push(value)
        }
    };
    for value in user.structs {
        structs.push(value)
    };
    let type_instances: Vec[TypeInstance] = Vec::new();
    for value in builtins.type_instances {
        type_instances.push(value)
    };
    for dependency in dependencies {
        for value in dependency.type_instances {
            type_instances.push(value)
        }
    };
    for value in user.type_instances {
        type_instances.push(value)
    };
    let constants: Vec[tast::Constant] = Vec::new();
    for value in builtins.constants {
        constants.push(value)
    };
    for dependency in dependencies {
        for value in dependency.constants {
            constants.push(value)
        }
    };
    for value in user.constants {
        constants.push(value)
    };
    File { functions, enums, structs, type_instances, constants }
}

pub fn link_with_builtins(builtins: File, user: File) -> File {
    link_with_dependencies(builtins, Vec::new(), user)
}
