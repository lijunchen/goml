package core;

use gomlc::tast;
use std::collections;

fn push_name(values: Vec[string], value: string) -> unit {
    if collections::contains(values, value) {} else {
        values.push(value)
    }
}

fn push_mutable(values: Vec[(string, tast::Type)], name: string, ty: tast::Type) -> unit {
    for value in values {
        if value.0 == name {
            return ()
        } else {}
    }
    values.push((name, ty))
}

fn collect_mutable_exprs(values: Vec[tast::Expr], result: Vec[(string, tast::Type)]) -> unit {
    for value in values {
        collect_mutable_expr(value, result)
    }
}

fn collect_mutable_block(value: tast::Block, result: Vec[(string, tast::Type)]) -> unit {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_mutable_expr(expr, result),
            Let { is_mut, pat: pattern, value: expr } => {
                collect_mutable_pattern(pattern, is_mut, result);
                collect_mutable_expr(expr, result)
            },
            LetElse { is_mut, pat: pattern, value: expr, else_branch } => {
                collect_mutable_pattern(pattern, is_mut, result);
                collect_mutable_expr(expr, result);
                collect_mutable_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_mutable_expr(target, result);
                collect_mutable_expr(expr, result)
            },
            Expr { expr } => collect_mutable_expr(expr, result),
        }
    }
    match value.tail {
        Some(expr) => collect_mutable_expr(expr, result),
        None => (),
    }
}

fn collect_mutable_expr(value: tast::Expr, result: Vec[(string, tast::Type)]) -> unit {
    match value {
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
        Break { value, ty: _, .. } => match value {
            Some(expr) => collect_mutable_expr(expr, result),
            None => (),
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_mutable_exprs(args, result),
        Closure { params: _, body, ty: _ } => collect_mutable_expr(body, result),
        Block { block, ty: _ } => collect_mutable_block(block, result),
        Match { expr: source, arms, ty: _ } => {
            collect_mutable_expr(source, result);
            for arm in arms {
                collect_mutable_pattern(arm.pat, false, result);
                match arm.guard {
                    Some(guard) => collect_mutable_expr(guard, result),
                    None => (),
                };
                collect_mutable_expr(arm.body, result)
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_mutable_expr(cond, result);
            collect_mutable_expr(then_branch, result);
            collect_mutable_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_mutable_expr(cond, result);
            collect_mutable_expr(body, result)
        },
        Loop { body, ty: _ } => collect_mutable_expr(body, result),
        For {
            pat,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_mutable_pattern(pat, false, result);
            collect_mutable_expr(iterator, result);
            collect_mutable_expr(body, result)
        },
        Return { expr, ty: _ } => match expr {
            Some(value) => collect_mutable_expr(value, result),
            None => (),
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_mutable_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_mutable_expr(function, result);
            collect_mutable_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_mutable_expr(base, result);
            collect_mutable_expr(index, result)
        },
    }
}

fn collect_mutable_pattern(value: tast::Pat, inherited: bool, result: Vec[(string, tast::Type)]) -> unit {
    match value {
        Var { name, is_mut, ty } => if inherited || is_mut {
            push_mutable(result, name, ty)
        } else {},
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Or {
            pats: args,
            ty: _,
        } => for arg in args {
            collect_mutable_pattern(arg, inherited, result)
        },
        Array { prefix, rest, suffix, ty: _ } => {
            for item in prefix {
                collect_mutable_pattern(item, inherited, result)
            }
            match rest {
                Some(value) => match value.binding {
                    Some(name) => if inherited {
                        push_mutable(result, name, value.ty)
                    } else {},
                    None => (),
                },
                None => (),
            };
            for item in suffix {
                collect_mutable_pattern(item, inherited, result)
            }
        },
        Alias { name, pat, ty } => {
            if inherited {
                push_mutable(result, name, ty)
            } else {};
            collect_mutable_pattern(pat, inherited, result)
        },
        Prim { value: _, ty: _ } | Range { start: _, end: _, inclusive: _, ty: _ } | Wild { ty: _ } => (),
    }
}

fn collect_pattern_names(value: tast::Pat, result: Vec[string]) -> unit {
    match value {
        Var { name, is_mut: _, ty: _ } => push_name(result, name),
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Or {
            pats: args,
            ty: _,
        } => {
            for arg in args {
                collect_pattern_names(arg, result)
            }
        },
        Array { prefix, rest, suffix, ty: _ } => {
            for item in prefix {
                collect_pattern_names(item, result)
            }
            match rest {
                Some(value) => match value.binding {
                    Some(name) => push_name(result, name),
                    None => (),
                },
                None => (),
            };
            for item in suffix {
                collect_pattern_names(item, result)
            }
        },
        Alias { name, pat: pattern, ty: _ } => {
            push_name(result, name);
            collect_pattern_names(pattern, result)
        },
        Prim { value: _, ty: _ } | Range { start: _, end: _, inclusive: _, ty: _ } | Wild { ty: _ } => (),
    }
}

fn collect_bound_exprs(values: Vec[tast::Expr], result: Vec[string]) -> unit {
    for value in values {
        collect_bound_expr(value, result)
    }
}

fn collect_bound_block(value: tast::Block, result: Vec[string]) -> unit {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_bound_expr(expr, result),
            Let { is_mut: _, pat: pattern, value: expr } => {
                collect_pattern_names(pattern, result);
                collect_bound_expr(expr, result)
            },
            LetElse { is_mut: _, pat: pattern, value: expr, else_branch } => {
                collect_pattern_names(pattern, result);
                collect_bound_expr(expr, result);
                collect_bound_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_bound_expr(target, result);
                collect_bound_expr(expr, result)
            },
            Expr { expr } => collect_bound_expr(expr, result),
        }
    }
    match value.tail {
        Some(expr) => collect_bound_expr(expr, result),
        None => (),
    }
}

fn collect_bound_expr(value: tast::Expr, result: Vec[string]) -> unit {
    match value {
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Closure {
            params: _,
            body: _,
            ty: _,
        } | Continue { ty: _, .. } => (),
        Break { value, ty: _, .. } => match value {
            Some(expr) => collect_bound_expr(expr, result),
            None => (),
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_bound_exprs(args, result),
        Block { block, ty: _ } => collect_bound_block(block, result),
        Match { expr: source, arms, ty: _ } => {
            collect_bound_expr(source, result);
            for arm in arms {
                collect_pattern_names(arm.pat, result);
                match arm.guard {
                    Some(guard) => collect_bound_expr(guard, result),
                    None => (),
                };
                collect_bound_expr(arm.body, result)
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_bound_expr(cond, result);
            collect_bound_expr(then_branch, result);
            collect_bound_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_bound_expr(cond, result);
            collect_bound_expr(body, result)
        },
        Loop { body, ty: _ } => collect_bound_expr(body, result),
        For {
            pat: pattern,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_pattern_names(pattern, result);
            collect_bound_expr(iterator, result);
            collect_bound_expr(body, result)
        },
        Return { expr, ty: _ } => match expr {
            Some(value) => collect_bound_expr(value, result),
            None => (),
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_bound_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_bound_expr(function, result);
            collect_bound_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_bound_expr(base, result);
            collect_bound_expr(index, result)
        },
    }
}

fn collect_reference_exprs(values: Vec[tast::Expr], result: Vec[string]) -> unit {
    for value in values {
        collect_reference_expr(value, result)
    }
}

fn collect_reference_block(value: tast::Block, result: Vec[string]) -> unit {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_reference_expr(expr, result),
            Let { is_mut: _, pat: _, value: expr } => collect_reference_expr(expr, result),
            LetElse { is_mut: _, pat: _, value: expr, else_branch } => {
                collect_reference_expr(expr, result);
                collect_reference_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_reference_expr(target, result);
                collect_reference_expr(expr, result)
            },
            Expr { expr } => collect_reference_expr(expr, result),
        }
    }
    match value.tail {
        Some(expr) => collect_reference_expr(expr, result),
        None => (),
    }
}

fn collect_reference_expr(value: tast::Expr, result: Vec[string]) -> unit {
    match value {
        Var { name, ty: _ } => push_name(result, name),
        Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Closure {
            params: _,
            body: _,
            ty: _,
        } | Continue { ty: _, .. } => (),
        Break { value, ty: _, .. } => match value {
            Some(expr) => collect_reference_expr(expr, result),
            None => (),
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_reference_exprs(args, result),
        Block { block, ty: _ } => collect_reference_block(block, result),
        Match { expr: source, arms, ty: _ } => {
            collect_reference_expr(source, result);
            for arm in arms {
                match arm.guard {
                    Some(guard) => collect_reference_expr(guard, result),
                    None => (),
                };
                collect_reference_expr(arm.body, result)
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_reference_expr(cond, result);
            collect_reference_expr(then_branch, result);
            collect_reference_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_reference_expr(cond, result);
            collect_reference_expr(body, result)
        },
        Loop { body, ty: _ } => collect_reference_expr(body, result),
        For {
            pat: _,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_reference_expr(iterator, result);
            collect_reference_expr(body, result)
        },
        Return { expr, ty: _ } => match expr {
            Some(value) => collect_reference_expr(value, result),
            None => (),
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_reference_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_reference_expr(function, result);
            collect_reference_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_reference_expr(base, result);
            collect_reference_expr(index, result)
        },
    }
}

fn collect_capture_exprs(values: Vec[tast::Expr], result: Vec[string]) -> unit {
    for value in values {
        collect_capture_expr(value, result)
    }
}

fn collect_capture_block(value: tast::Block, result: Vec[string]) -> unit {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_capture_expr(expr, result),
            Let { is_mut: _, pat: _, value: expr } => collect_capture_expr(expr, result),
            LetElse { is_mut: _, pat: _, value: expr, else_branch } => {
                collect_capture_expr(expr, result);
                collect_capture_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_capture_expr(target, result);
                collect_capture_expr(expr, result)
            },
            Expr { expr } => collect_capture_expr(expr, result),
        }
    }
    match value.tail {
        Some(expr) => collect_capture_expr(expr, result),
        None => (),
    }
}

fn collect_closure_captures(params: Vec[tast::ClosureParam], body: tast::Expr, result: Vec[string]) -> unit {
    let bound: Vec[string] = Vec::[];
    for param in params {
        push_name(bound, param.name)
    }
    collect_bound_expr(body, bound);
    let references: Vec[string] = Vec::[];
    collect_reference_expr(body, references);
    for name in references {
        if collections::contains(bound, name) {} else {
            push_name(result, name)
        }
    }
    collect_capture_expr(body, result)
}

fn collect_capture_expr(value: tast::Expr, result: Vec[string]) -> unit {
    match value {
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
        Break { value, ty: _, .. } => match value {
            Some(expr) => collect_capture_expr(expr, result),
            None => (),
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_capture_exprs(args, result),
        Closure { params, body, ty: _ } => collect_closure_captures(params, body, result),
        Block { block, ty: _ } => collect_capture_block(block, result),
        Match { expr: source, arms, ty: _ } => {
            collect_capture_expr(source, result);
            for arm in arms {
                match arm.guard {
                    Some(guard) => collect_capture_expr(guard, result),
                    None => (),
                };
                collect_capture_expr(arm.body, result)
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_capture_expr(cond, result);
            collect_capture_expr(then_branch, result);
            collect_capture_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_capture_expr(cond, result);
            collect_capture_expr(body, result)
        },
        Loop { body, ty: _ } => collect_capture_expr(body, result),
        For {
            pat: _,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_capture_expr(iterator, result);
            collect_capture_expr(body, result)
        },
        Return { expr, ty: _ } => match expr {
            Some(value) => collect_capture_expr(value, result),
            None => (),
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_capture_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_capture_expr(function, result);
            collect_capture_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_capture_expr(base, result);
            collect_capture_expr(index, result)
        },
    }
}

fn hidden_mutable_cells(value: tast::Block) -> Vec[(string, tast::Type)] {
    let mutables: Vec[(string, tast::Type)] = Vec::[];
    collect_mutable_block(value, mutables);
    let captures: Vec[string] = Vec::[];
    collect_capture_block(value, captures);
    let result: Vec[(string, tast::Type)] = Vec::[];
    for value in mutables {
        if collections::contains(captures, value.0) {
            result.push(value)
        } else {}
    }
    result
}

fn hidden_cell_type(value: tast::Type) -> tast::Type {
    tast::Type::RefType { elem: value }
}

fn hidden_cell_inner(cells: Vec[(string, tast::Type)], name: string) -> Option[tast::Type] {
    let mut index = cells.len() - 1;
    while index >= 0 {
        let value = cells[index];
        if value.0 == name {
            return Option::Some(value.1)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn intrinsic_expr(name: string, params: Vec[tast::Type], ret_ty: tast::Type) -> Expr {
    Expr::Callable {
        callable: tast::Callable::Intrinsic(name),
        ty: tast::Type::Func { params, ret_ty },
    }
}

fn hidden_cell_var(name: string, inner_ty: tast::Type) -> Expr {
    Expr::Var { name, ty: hidden_cell_type(inner_ty) }
}

fn hidden_ref_alloc(value: Expr, inner_ty: tast::Type) -> Expr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::[];
    params.push(inner_ty);
    let args: Vec[Expr] = Vec::[];
    args.push(value);
    Expr::Call { func: intrinsic_expr("ref.new", params, ref_ty), args, ty: ref_ty }
}

fn hidden_ref_get(name: string, inner_ty: tast::Type) -> Expr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::[];
    params.push(ref_ty);
    let args: Vec[Expr] = Vec::[];
    args.push(hidden_cell_var(name, inner_ty));
    Expr::Call { func: intrinsic_expr("ref.get", params, inner_ty), args, ty: inner_ty }
}

fn hidden_ref_set(name: string, inner_ty: tast::Type, value: Expr) -> Expr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::[];
    params.push(ref_ty);
    params.push(inner_ty);
    let args: Vec[Expr] = Vec::[];
    args.push(hidden_cell_var(name, inner_ty));
    args.push(value);
    Expr::Call {
        func: intrinsic_expr("ref.set", params, tast::Type::Unit),
        args,
        ty: tast::Type::Unit,
    }
}

fn lower_hidden_exprs(values: Vec[Expr], cells: Vec[(string, tast::Type)]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::[];
    for value in values {
        result.push(lower_hidden_expr(value, cells))
    }
    result
}

fn lower_hidden_block(value: Block, cells: Vec[(string, tast::Type)]) -> Block {
    let stmts: Vec[LetStmt] = Vec::[];
    for stmt in value.stmts {
        let lowered = lower_hidden_expr(stmt.value, cells);
        match hidden_cell_inner(cells, stmt.name) {
            Some(inner_ty) => stmts.push(
                LetStmt {
                    name: stmt.name,
                    value: hidden_ref_alloc(lowered, inner_ty),
                    ty: hidden_cell_type(inner_ty),
                },
            ),
            None => stmts.push(LetStmt { name: stmt.name, value: lowered, ty: stmt.ty }),
        }
    }
    Block {
        stmts,
        tail: match value.tail {
            Some(expr) => Option::Some(lower_hidden_expr(expr, cells)),
            None => Option::None,
        },
    }
}

fn lower_hidden_arms(values: Vec[Arm], cells: Vec[(string, tast::Type)]) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::[];
    for value in values {
        result.push(
            Arm {
                lhs: lower_hidden_expr(value.lhs, cells),
                body: lower_hidden_expr(value.body, cells),
            },
        )
    }
    result
}

fn lower_hidden_expr(value: Expr, cells: Vec[(string, tast::Type)]) -> Expr {
    match value {
        Var { name, ty } => match hidden_cell_inner(cells, name) {
            Some(inner_ty) => hidden_ref_get(name, inner_ty),
            None => Expr::Var { name, ty },
        },
        Callable { callable, ty } => Expr::Callable { callable, ty },
        Prim { value, ty } => Expr::Prim { value, ty },
        Constr { constructor, args, ty } => {
            Expr::Constr { constructor, args: lower_hidden_exprs(args, cells), ty }
        },
        Tuple { items, ty } => Expr::Tuple { items: lower_hidden_exprs(items, cells), ty },
        Array { items, ty } => Expr::Array { items: lower_hidden_exprs(items, cells), ty },
        Closure { params, body, ty } => {
            Expr::Closure { params, body: lower_hidden_expr(body, cells), ty }
        },
        Block { block, ty } => Expr::Block { block: lower_hidden_block(block, cells), ty },
        Match { expr: source, arms, default, ty } => Expr::Match {
            expr: lower_hidden_expr(source, cells),
            arms: lower_hidden_arms(arms, cells),
            default: match default {
                Some(expr) => Option::Some(lower_hidden_expr(expr, cells)),
                None => Option::None,
            },
            ty,
        },
        If { cond, then_branch, else_branch, ty } => Expr::If {
            cond: lower_hidden_expr(cond, cells),
            then_branch: lower_hidden_expr(then_branch, cells),
            else_branch: lower_hidden_expr(else_branch, cells),
            ty,
        },
        While { cond, body, ty } => {
            Expr::While {
                cond: lower_hidden_expr(cond, cells),
                body: lower_hidden_expr(body, cells),
                ty,
            }
        },
        Loop { body, ty } => Expr::Loop { body: lower_hidden_expr(body, cells), ty },
        Break { target, value, ty } => Expr::Break {
            target,
            value: match value {
                Some(expr) => Option::Some(lower_hidden_expr(expr, cells)),
                None => Option::None,
            },
            ty,
        },
        Continue { target, ty } => Expr::Continue { target, ty },
        Return { expr, ty } => Expr::Return {
            expr: match expr {
                Some(value) => Option::Some(lower_hidden_expr(value, cells)),
                None => Option::None,
            },
            ty,
        },
        Go { expr, ty } => Expr::Go { expr: lower_hidden_expr(expr, cells), ty },
        ConstrGet { expr, constructor, field_index, ty } => Expr::ConstrGet {
            expr: lower_hidden_expr(expr, cells),
            constructor,
            field_index,
            ty,
        },
        Unary { op, expr, ty } => Expr::Unary { op, expr: lower_hidden_expr(expr, cells), ty },
        Cast { expr, ty } => Expr::Cast { expr: lower_hidden_expr(expr, cells), ty },
        Binary { op, lhs: left, rhs: right, ty } => Expr::Binary {
            op,
            lhs: lower_hidden_expr(left, cells),
            rhs: lower_hidden_expr(right, cells),
            ty,
        },
        Assign { name, value: expr, target_ty, ty } => {
            let expr = lower_hidden_expr(expr, cells);
            match hidden_cell_inner(cells, name) {
                Some(inner_ty) => hidden_ref_set(name, inner_ty, expr),
                None => Expr::Assign { name, value: expr, target_ty, ty },
            }
        },
        Call { func: function, args, ty } => Expr::Call {
            func: lower_hidden_expr(function, cells),
            args: lower_hidden_exprs(args, cells),
            ty,
        },
        ToDyn { trait_name: name, for_ty, expr, ty } => {
            Expr::ToDyn { trait_name: name, for_ty, expr: lower_hidden_expr(expr, cells), ty }
        },
        DynCall { trait_name: owner, method_name: name, receiver, args, ty } => Expr::DynCall {
            trait_name: owner,
            method_name: name,
            receiver: lower_hidden_expr(receiver, cells),
            args: lower_hidden_exprs(args, cells),
            ty,
        },
        TraitCall { trait_ref: reference, method_name: name, instance_name, receiver, args, ty } => Expr::TraitCall {
            trait_ref: reference,
            method_name: name,
            instance_name,
            receiver: lower_hidden_expr(receiver, cells),
            args: lower_hidden_exprs(args, cells),
            ty,
        },
        Proj { tuple: expr, index, ty } => {
            Expr::Proj { tuple: lower_hidden_expr(expr, cells), index, ty }
        },
    }
}
