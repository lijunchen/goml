package core;

use gomlc::tast;
use std::text;

struct PatternBinding {
    name: string,
    source: string,
    ty: tast::Type,
}

struct PatternPlan {
    projections: Vec[LetStmt],
    bindings: Vec[PatternBinding],
}

struct PatternColumn {
    source: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
}

struct PatternRow {
    columns: Vec[PatternColumn],
    bindings: Vec[PatternBinding],
    body: tast::Expr,
}

struct PatternEnumCase {
    constructor: tast::Constructor,
    variables: Vec[(string, tast::Type)],
    rows: Vec[PatternRow],
}

struct PrimitivePatternCase {
    key: string,
    value: tast::Primitive,
    ty: tast::Type,
}

fn flat_pattern_items(items: Vec[tast::Pat]) -> bool {
    for item in items {
        match item {
            Var { name: _, ty: _ } | Wild { ty: _ } => (),
            _ => return false,
        }
    };
    true
}

fn plan_flat_pattern(
    ctx: Lowerer,
    source: string,
    pattern: tast::Pat,
) -> Option[PatternPlan] {
    match pattern {
        Tuple { items, ty: tuple_ty } => match tast::resolve_type(tuple_ty) {
            Tuple { items: types } => if items.len() == types.len() && flat_pattern_items(items) {
                let names: Vec[string] = Vec::new();
                for _ in types {
                    names.push(gensym(ctx, "x"))
                };
                let projections: Vec[LetStmt] = Vec::new();
                let bindings: Vec[PatternBinding] = Vec::new();
                for index in range(0, items.len()) {
                    let item_ty = types[index];
                    let projection_name = names[index];
                    projections.push(LetStmt {
                        name: projection_name,
                        value: Expr::Proj {
                            tuple: Expr::Var { name: source, ty: tuple_ty },
                            index,
                            ty: item_ty,
                        },
                        ty: item_ty,
                    });
                    match items[index] {
                        Var { name, ty } => bindings.push(PatternBinding {
                            name,
                            source: projection_name,
                            ty,
                        }),
                        Wild { ty: _ } => (),
                        _ => (),
                    }
                };
                Option::Some(PatternPlan {
                    projections,
                    bindings,
                })
            } else {
                Option::None
            },
            _ => Option::None,
        },
        Constr { constructor, args: items, ty: struct_ty } => if constructor.is_struct && flat_pattern_items(items) {
            let names: Vec[string] = Vec::new();
            for _ in items {
                names.push(gensym(ctx, "x"))
            };
            let projections: Vec[LetStmt] = Vec::new();
            let bindings: Vec[PatternBinding] = Vec::new();
            for index in range(0, items.len()) {
                let item = items[index];
                let item_ty = tast::pat_type(item);
                let projection_name = names[index];
                projections.push(LetStmt {
                    name: projection_name,
                    value: Expr::ConstrGet {
                        expr: Expr::Var { name: source, ty: struct_ty },
                        constructor,
                        field_index: index,
                        ty: item_ty,
                    },
                    ty: item_ty,
                });
                match item {
                    Var { name, ty } => bindings.push(PatternBinding {
                        name,
                        source: projection_name,
                        ty,
                    }),
                    Wild { ty: _ } => (),
                    _ => (),
                }
            };
            Option::Some(PatternPlan {
                projections,
                bindings,
            })
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn apply_pattern_plan(
    plan: PatternPlan,
    body: Expr,
    body_ty: tast::Type,
) -> Expr {
    let result = Ref::new(body);
    for binding in plan.bindings {
        let stmts: Vec[LetStmt] = Vec::new();
        stmts.push(LetStmt {
            name: binding.name,
            value: Expr::Var { name: binding.source, ty: binding.ty },
            ty: binding.ty,
        });
        result.set(Expr::Block {
            block: Block {
                            stmts,
                            tail: Option::Some(result.get()),
                        },
            ty: body_ty,
        })
    };
    Expr::Block {
        block: Block {
                    stmts: plan.projections,
                    tail: Option::Some(result.get()),
                },
        ty: body_ty,
    }
}

fn normalize_pattern_rows(rows: Vec[PatternRow]) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        let columns: Vec[PatternColumn] = Vec::new();
        let bindings: Vec[PatternBinding] = Vec::new();
        for binding in row.bindings {
            bindings.push(binding)
        };
        for column in row.columns {
            match column.pattern {
                Var { name, ty } => bindings.push(PatternBinding {
                    name,
                    source: column.source,
                    ty,
                }),
                Wild { ty: _ } => (),
                _ => columns.push(column),
            }
        };
        result.push(PatternRow {
            columns,
            bindings,
            body: row.body,
        })
    };
    result
}

fn expand_or_pattern_rows(rows: Vec[PatternRow], source: string) -> Option[Vec[PatternRow]] {
    let result: Vec[PatternRow] = Vec::new();
    let expanded_rows: Vec[unit] = Vec::new();
    for row in rows {
        match or_pattern_column_index(row, source) {
            Some(index) => {
                let column = row.columns[index];
                match column.pattern {
                    Or { pats: patterns, ty: _ } => for pattern in patterns {
                        let columns: Vec[PatternColumn] = Vec::new();
                        for column_index in range(0, row.columns.len()) {
                            let value = row.columns[column_index];
                            if column_index == index {
                                columns.push(PatternColumn {
                                    source: value.source,
                                    source_ty: value.source_ty,
                                    pattern,
                                })
                            } else {
                                columns.push(value)
                            }
                        };
                        result.push(PatternRow {
                            columns,
                            bindings: row.bindings,
                            body: row.body,
                        })
                    },
                    _ => result.push(row),
                };
                expanded_rows.push(())
            },
            None => result.push(row),
        }
    };
    if expanded_rows.len() > 0 {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn or_pattern_column_index(
    row: PatternRow,
    source: string,
) -> Option[int] {
    for index in range(0, row.columns.len()) {
        let column = row.columns[index];
        if column.source == source {
            match column.pattern {
                Or { pats: _, ty: _ } => return Option::Some(index),
                _ => (),
            }
        } else {
            ()
        }
    };
    Option::None
}

fn pattern_source_count(rows: Vec[PatternRow], source: string) -> int {
    let count = Ref::new(0);
    for row in rows {
        for column in row.columns {
            if column.source == source {
                count.set(count.get() + 1)
            } else {
                ()
            }
        }
    };
    count.get()
}

fn branch_pattern_column(rows: Vec[PatternRow]) -> Option[PatternColumn] {
    if rows.len() == 0 || rows[0].columns.len() == 0 {
        Option::None
    } else {
        let selected = Ref::new(0);
        let best = Ref::new(-1);
        let columns = rows[0].columns;
        for index in range(0, columns.len()) {
            let column = columns[index];
            let count = pattern_source_count(rows, column.source);
            if count >= best.get() {
                best.set(count);
                selected.set(index)
            } else {
                ()
            }
        };
        Option::Some(columns[selected.get()])
    }
}

fn lower_pattern_row_body(ctx: Lowerer, row: PatternRow) -> Expr {
    let body_ty = tast::expr_type(row.body);
    let result = Ref::new(lower_expr(ctx, row.body));
    for binding in row.bindings {
        let stmts: Vec[LetStmt] = Vec::new();
        stmts.push(LetStmt {
            name: binding.name,
            value: Expr::Var { name: binding.source, ty: binding.ty },
            ty: binding.ty,
        });
        result.set(Expr::Block {
            block: Block {
                            stmts,
                            tail: Option::Some(result.get()),
                        },
            ty: body_ty,
        })
    };
    result.get()
}

fn bool_pattern_row(
    row: PatternRow,
    source: string,
    expected: bool,
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Prim { value: Bool { value }, ty: _ } => if value == expected {
                    ()
                } else {
                    return Option::None
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    };
    Option::Some(PatternRow {
        columns,
        bindings: row.bindings,
        body: row.body,
    })
}

fn bool_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    expected: bool,
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match bool_pattern_row(row, source, expected) {
            Some(value) => result.push(value),
            None => (),
        }
    };
    result
}

fn tuple_pattern_row(
    row: PatternRow,
    source: string,
    names: Vec[string],
    types: Vec[tast::Type],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Tuple { items, ty: _ } => if items.len() == names.len() {
                    for index in range(0, items.len()) {
                        columns.push(PatternColumn {
                            source: names[index],
                            source_ty: types[index],
                            pattern: items[index],
                        })
                    }
                } else {
                    return Option::None
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    };
    Option::Some(PatternRow {
        columns,
        bindings: row.bindings,
        body: row.body,
    })
}

fn tuple_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    names: Vec[string],
    types: Vec[tast::Type],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match tuple_pattern_row(row, source, names, types) {
            Some(value) => result.push(value),
            None => (),
        }
    };
    result
}

fn lower_tuple_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    types: Vec[tast::Type],
    ty: tast::Type,
) -> Expr {
    let names: Vec[string] = Vec::new();
    for _ in types {
        names.push(gensym(ctx, "x"))
    };
    let inner = lower_pattern_rows(
        ctx,
        tuple_pattern_rows(rows, column.source, names, types),
        ty,
    );
    let stmts: Vec[LetStmt] = Vec::new();
    for index in range(0, types.len()) {
        stmts.push(LetStmt {
            name: names[index],
            value: Expr::Proj {
                tuple: Expr::Var { name: column.source, ty: column.source_ty },
                index,
                ty: types[index],
            },
            ty: types[index],
        })
    };
    Expr::Block {
        block: Block {
                    stmts,
                    tail: Option::Some(inner),
                },
        ty,
    }
}

fn struct_pattern_row(
    row: PatternRow,
    source: string,
    names: Vec[string],
    fields: Vec[(string, tast::Type)],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Constr { constructor, args: patterns, ty: _ } => {
                    if constructor.is_struct && patterns.len() == names.len() {
                        for index in range(0, patterns.len()) {
                            columns.push(PatternColumn {
                                source: names[index],
                                source_ty: fields[index].1,
                                pattern: patterns[index],
                            })
                        }
                    } else {
                        return Option::None
                    }
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    };
    Option::Some(PatternRow {
        columns,
        bindings: row.bindings,
        body: row.body,
    })
}

fn struct_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    names: Vec[string],
    fields: Vec[(string, tast::Type)],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match struct_pattern_row(row, source, names, fields) {
            Some(value) => result.push(value),
            None => (),
        }
    };
    result
}

fn lower_struct_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    constructor: tast::Constructor,
    fields: Vec[(string, tast::Type)],
    ty: tast::Type,
) -> Expr {
    let names: Vec[string] = Vec::new();
    for _ in fields {
        names.push(gensym(ctx, "x"))
    };
    let inner = lower_pattern_rows(
        ctx,
        struct_pattern_rows(rows, column.source, names, fields),
        ty,
    );
    let stmts: Vec[LetStmt] = Vec::new();
    for index in range(0, fields.len()) {
        stmts.push(LetStmt {
            name: names[index],
            value: Expr::ConstrGet {
                expr: Expr::Var { name: column.source, ty: column.source_ty },
                constructor,
                field_index: index,
                ty: fields[index].1,
            },
            ty: fields[index].1,
        })
    };
    Expr::Block {
        block: Block {
                    stmts,
                    tail: Option::Some(inner),
                },
        ty,
    }
}

fn enum_pattern_row(
    row: PatternRow,
    source: string,
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Constr { constructor, args: patterns, ty: _ } => {
                    if constructor.name == constructor_name && patterns.len() == variables.len() {
                        for index in range(0, patterns.len()) {
                            let variable = variables[index];
                            columns.push(PatternColumn {
                                source: variable.0,
                                source_ty: variable.1,
                                pattern: patterns[index],
                            })
                        }
                    } else {
                        return Option::None
                    }
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    };
    Option::Some(PatternRow {
        columns,
        bindings: row.bindings,
        body: row.body,
    })
}

fn enum_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match enum_pattern_row(row, source, constructor_name, variables) {
            Some(value) => result.push(value),
            None => (),
        }
    };
    result
}

fn enum_pattern_present(
    rows: Vec[PatternRow],
    source: string,
    constructor_name: string,
) -> bool {
    for row in rows {
        for column in row.columns {
            if column.source == source {
                match column.pattern {
                    Constr { constructor, args: _, ty: _ } => {
                        if constructor.name == constructor_name {
                            return true
                        } else {
                            ()
                        }
                    },
                    _ => (),
                }
            } else {
                ()
            }
        }
    };
    false
}

fn pattern_default_rows(rows: Vec[PatternRow], source: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if pattern_row_has_source(row, source) {
            ()
        } else {
            result.push(row)
        }
    };
    result
}

fn pattern_row_has_source(row: PatternRow, source: string) -> bool {
    for column in row.columns {
        if column.source == source {
            return true
        } else {
            ()
        }
    };
    false
}

fn lower_enum_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    definition: tast::EnumDef,
    type_args: Vec[tast::Type],
    ty: tast::Type,
) -> Expr {
    let cases: Vec[PatternEnumCase] = Vec::new();
    for variant_index in range(0, definition.variants.len()) {
        let variant = definition.variants[variant_index];
        let constructor_name = definition.name + "::" + variant.name;
        let variables: Vec[(string, tast::Type)] = Vec::new();
        for field in tast::enum_variant_field_types(variant.fields) {
            variables.push((
                gensym(ctx, "x"),
                tast::substitute_params(field, definition.generics, type_args),
            ))
        };
        if enum_pattern_present(rows, column.source, constructor_name) {
            cases.push(PatternEnumCase {
                constructor: tast::Constructor {
                    name: constructor_name,
                    fields: Vec::new(),
                    is_struct: false,
                    tag: Option::Some(variant_index),
                },
                variables,
                rows: enum_pattern_rows(
                    rows,
                    column.source,
                    constructor_name,
                    variables,
                ),
            })
        } else {
            ()
        }
    };
    let complete = cases.len() == definition.variants.len();
    let arms: Vec[Arm] = Vec::new();
    for case in cases {
        let args: Vec[Expr] = Vec::new();
        let stmts: Vec[LetStmt] = Vec::new();
        for index in range(0, case.variables.len()) {
            let variable = case.variables[index];
            args.push(Expr::Var { name: variable.0, ty: variable.1 });
            stmts.push(LetStmt {
                name: variable.0,
                value: Expr::ConstrGet {
                    expr: Expr::Var { name: column.source, ty: column.source_ty },
                    constructor: case.constructor,
                    field_index: index,
                    ty: variable.1,
                },
                ty: variable.1,
            })
        };
        let inner = lower_pattern_rows(ctx, case.rows, ty);
        let body = if stmts.len() == 0 {
            inner
        } else {
            Expr::Block {
                block: Block {
                                    stmts,
                                    tail: Option::Some(inner),
                                },
                ty,
            }
        };
        arms.push(Arm {
            lhs: Expr::Constr { constructor: case.constructor, args, ty: column.source_ty },
            body,
        })
    };
    let defaults = pattern_default_rows(rows, column.source);
    let default = if complete || defaults.len() == 0 {
        Option::None
    } else {
        Option::Some(lower_pattern_rows(ctx, defaults, ty))
    };
    Expr::Match {
        expr: Expr::Var { name: column.source, ty: column.source_ty },
        arms,
        default,
        ty,
    }
}

fn lower_bool_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> Expr {
    let arms: Vec[Arm] = Vec::new();
    for expected in Vec::new().pushed(true).pushed(false) {
        arms.push(Arm {
            lhs: bool_expr(expected),
            body: lower_pattern_rows(
                ctx,
                bool_pattern_rows(rows, column.source, expected),
                ty,
            ),
        })
    };
    Expr::Match {
        expr: Expr::Var { name: column.source, ty: column.source_ty },
        arms,
        default: Option::None,
        ty,
    }
}

fn unit_pattern_row(row: PatternRow, source: string) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Prim { value: Unit, ty: _ } => (),
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    };
    Option::Some(PatternRow {
        columns,
        bindings: row.bindings,
        body: row.body,
    })
}

fn unit_pattern_rows(rows: Vec[PatternRow], source: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match unit_pattern_row(row, source) {
            Some(value) => result.push(value),
            None => (),
        }
    };
    result
}

fn lower_unit_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> Expr {
    let arms: Vec[Arm] = Vec::new();
    arms.push(Arm {
        lhs: Expr::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit },
        body: lower_pattern_rows(ctx, unit_pattern_rows(rows, column.source), ty),
    });
    Expr::Match {
        expr: Expr::Var { name: column.source, ty: column.source_ty },
        arms,
        default: Option::None,
        ty,
    }
}

fn primitive_pattern_key(value: tast::Primitive, ty: tast::Type) -> string {
    let builder = text::StringBuilder::new();
    tast::write_type(builder, ty);
    builder.write_char(':');
    tast::write_primitive(builder, value);
    builder.finish()
}

fn primitive_pattern_case_exists(
    values: Vec[PrimitivePatternCase],
    key: string,
) -> bool {
    for value in values {
        if value.key == key {
            return true
        } else {
            ()
        }
    };
    false
}

fn primitive_pattern_cases(rows: Vec[PatternRow], source: string) -> Vec[PrimitivePatternCase] {
    let result: Vec[PrimitivePatternCase] = Vec::new();
    for row in rows {
        for column in row.columns {
            if column.source == source {
                match column.pattern {
                    Prim { value, ty } => {
                        let key = primitive_pattern_key(value, ty);
                        if primitive_pattern_case_exists(result, key) {
                            ()
                        } else {
                            result.push(PrimitivePatternCase {
                                key,
                                value,
                                ty,
                            })
                        }
                    },
                    _ => (),
                }
            } else {
                ()
            }
        }
    };
    result
}

fn primitive_pattern_row(
    row: PatternRow,
    source: string,
    key: string,
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Prim { value, ty } => {
                    if primitive_pattern_key(value, ty) == key {
                        ()
                    } else {
                        return Option::None
                    }
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    };
    Option::Some(PatternRow {
        columns,
        bindings: row.bindings,
        body: row.body,
    })
}

fn primitive_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    key: string,
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match primitive_pattern_row(row, source, key) {
            Some(value) => result.push(value),
            None => (),
        }
    };
    result
}

fn lower_primitive_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> Expr {
    let arms: Vec[Arm] = Vec::new();
    for case in primitive_pattern_cases(rows, column.source) {
        arms.push(Arm {
            lhs: Expr::Prim { value: case.value, ty: case.ty },
            body: lower_pattern_rows(
                ctx,
                primitive_pattern_rows(rows, column.source, case.key),
                ty,
            ),
        })
    };
    let defaults = pattern_default_rows(rows, column.source);
    let default = if defaults.len() == 0 {
        Option::None
    } else {
        Option::Some(lower_pattern_rows(ctx, defaults, ty))
    };
    Expr::Match {
        expr: Expr::Var { name: column.source, ty: column.source_ty },
        arms,
        default,
        ty,
    }
}

fn primitive_pattern_type(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        Int
        | Int8
        | Int16
        | Int32
        | Int64
        | Uint
        | Uint8
        | Uint16
        | Uint32
        | Uint64
        | Float32
        | Float64
        | String
        | Char => true,
        _ => false,
    }
}

fn lower_pattern_rows(ctx: Lowerer, values: Vec[PatternRow], ty: tast::Type) -> Expr {
    let rows = normalize_pattern_rows(values);
    if rows.len() == 0 {
        missing_expr(ty)
    } else if rows[0].columns.len() == 0 {
        lower_pattern_row_body(ctx, rows[0])
    } else {
        match branch_pattern_column(rows) {
            Some(column) => match expand_or_pattern_rows(rows, column.source) {
                Some(expanded) => lower_pattern_rows(ctx, expanded, ty),
                None => match nominal_parts(column.source_ty) {
                    Some((name, type_args)) => match find_enum(ctx, name) {
                        Some(definition) => lower_enum_pattern_rows(
                            ctx,
                            rows,
                            column,
                            definition,
                            type_args,
                            ty,
                        ),
                        None => match struct_place_details(ctx, column.source_ty) {
                            Some((constructor, fields)) => lower_struct_pattern_rows(
                                ctx,
                                rows,
                                column,
                                constructor,
                                fields,
                                ty,
                            ),
                            None => lower_pattern_row_body(ctx, rows[0]),
                        },
                    },
                    None => match tast::resolve_type(column.source_ty) {
                        Unit => lower_unit_pattern_rows(ctx, rows, column, ty),
                        Bool => lower_bool_pattern_rows(ctx, rows, column, ty),
                        Tuple { items: types } => {
                            lower_tuple_pattern_rows(ctx, rows, column, types, ty)
                        },
                        _ => if primitive_pattern_type(column.source_ty) {
                            lower_primitive_pattern_rows(ctx, rows, column, ty)
                        } else {
                            lower_pattern_row_body(ctx, rows[0])
                        },
                    },
                },
            },
            None => missing_expr(ty),
        }
    }
}

fn pattern_rows_from_arms(
    source: string,
    source_ty: tast::Type,
    arms: Vec[tast::Arm],
) -> Option[Vec[PatternRow]] {
    let rows: Vec[PatternRow] = Vec::new();
    for arm in arms {
        match arm.guard {
            Some(_) => return Option::None,
            None => {
                let columns: Vec[PatternColumn] = Vec::new();
                columns.push(PatternColumn {
                    source,
                    source_ty,
                    pattern: arm.pat,
                });
                rows.push(PatternRow {
                    columns,
                    bindings: Vec::new(),
                    body: arm.body,
                })
            },
        }
    };
    Option::Some(rows)
}
