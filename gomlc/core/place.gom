package core;

use gomlc::ast;
use gomlc::tast;

enum PlaceRoot {
    Local {
        name: string,
        ty: tast::Type,
    },
    Ref {
        expr: tast::Expr,
        ty: tast::Type,
    },
    Value {
        expr: tast::Expr,
        ty: tast::Type,
    },
}

enum PlaceStep {
    Proj {
        parent_ty: tast::Type,
        index: int,
        item_ty: tast::Type,
    },
    Field {
        parent_ty: tast::Type,
        field_name: string,
        item_ty: tast::Type,
    },
    Index {
        container_ty: tast::Type,
        index: tast::Expr,
        item_ty: tast::Type,
    },
}

enum EvaluatedPlaceStep {
    Proj {
        parent_var: string,
        parent_ty: tast::Type,
        index: int,
    },
    Field {
        parent_var: string,
        parent_ty: tast::Type,
        field_name: string,
    },
    Index {
        parent_var: string,
        parent_ty: tast::Type,
        index_var: string,
        index_ty: tast::Type,
    },
}

enum CompiledPlaceRoot {
    Local {
        name: string,
        ty: tast::Type,
    },
    Ref {
        ref_var: string,
        ref_ty: tast::Type,
    },
    Value,
}

fn ref_get_argument(value: tast::Expr) -> Option[tast::Expr] {
    match value {
        Call { func: function, args, ty: _ } => if args.len() == 1 {
            match function {
                Callable { callable: Intrinsic(name), ty: _ } => {
                    if name == "ref.get" {
                        Option::Some(args[0])
                    } else {
                        Option::None
                    }
                },
                Callable {
                    callable: InherentMethod { receiver_ty: RefType { elem: _ }, method_name: name },
                    ty: _,
                } => if name == "get" {
                    Option::Some(args[0])
                } else {
                    Option::None
                },
                _ => Option::None,
            }
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn decompose_place_from(value: tast::Expr, steps: Vec[PlaceStep]) -> Option[PlaceRoot] {
    match value {
        Var { name, ty } => Option::Some(PlaceRoot::Local { name, ty }),
        Proj { tuple: parent, index, ty } => match decompose_place_from(parent, steps) {
            Some(root) => {
                steps.push(
                    PlaceStep::Proj { parent_ty: tast::expr_type(parent), index, item_ty: ty },
                );
                Option::Some(root)
            },
            None => Option::None,
        },
        Field { expr: parent, field_name: name, ty } => match decompose_place_from(parent, steps) {
            Some(root) => {
                steps.push(
                    PlaceStep::Field {
                        parent_ty: tast::expr_type(parent),
                        field_name: name,
                        item_ty: ty,
                    },
                );
                Option::Some(root)
            },
            None => Option::None,
        },
        Index { base: parent, index, ty } => match decompose_place_from(parent, steps) {
            Some(root) => {
                steps.push(
                    PlaceStep::Index { container_ty: tast::expr_type(parent), index, item_ty: ty },
                );
                Option::Some(root)
            },
            None => Option::None,
        },
        other => match ref_get_argument(other) {
            Some(reference) => Option::Some(
                PlaceRoot::Ref { expr: reference, ty: tast::expr_type(other) },
            ),
            None => Option::Some(PlaceRoot::Value { expr: other, ty: tast::expr_type(other) }),
        },
    }
}

fn decompose_place(value: tast::Expr) -> Option[(PlaceRoot, Vec[PlaceStep])] {
    let steps: Vec[PlaceStep] = Vec::new();
    match decompose_place_from(value, steps) {
        Some(root) => Option::Some((root, steps)),
        None => Option::None,
    }
}

fn place_intrinsic_call(name: string, params: Vec[tast::Type], ret_ty: tast::Type, args: Vec[Expr]) -> Expr {
    Expr::Call { func: intrinsic_expr(name, params, ret_ty), args, ty: ret_ty }
}

fn place_ref_get(value: Expr, ref_ty: tast::Type, inner_ty: tast::Type) -> Expr {
    let params: Vec[tast::Type] = Vec::new();
    params.push(ref_ty);
    let args: Vec[Expr] = Vec::new();
    args.push(value);
    place_intrinsic_call("ref.get", params, inner_ty, args)
}

fn place_ref_set(value: Expr, updated: Expr, ref_ty: tast::Type) -> Expr {
    let params: Vec[tast::Type] = Vec::new();
    params.push(ref_ty);
    params.push(expr_type(updated));
    let args: Vec[Expr] = Vec::new();
    args.push(value);
    args.push(updated);
    place_intrinsic_call("ref.set", params, tast::Type::Unit, args)
}

fn place_index_read(container: Expr, container_ty: tast::Type, index: Expr, item_ty: tast::Type) -> Expr {
    let name = match tast::resolve_type(container_ty) {
        Array { len: _, elem: _ } => "array.get",
        VecType { elem: _ } => "vec.get",
        Slice { elem: _ } => "slice.get",
        HashMap { key: _, value: _ } => "hashmap.get",
        _ => "compiler.missing",
    };
    let params: Vec[tast::Type] = Vec::new();
    params.push(container_ty);
    params.push(expr_type(index));
    let args: Vec[Expr] = Vec::new();
    args.push(container);
    args.push(index);
    place_intrinsic_call(name, params, item_ty, args)
}

fn place_array_set(container: Expr, index: Expr, value: Expr) -> Expr {
    let container_ty = expr_type(container);
    let params: Vec[tast::Type] = Vec::new();
    params.push(container_ty);
    params.push(tast::Type::Int);
    params.push(expr_type(value));
    let args: Vec[Expr] = Vec::new();
    args.push(container);
    args.push(index);
    args.push(value);
    place_intrinsic_call("array.set", params, container_ty, args)
}

fn place_vec_set(container: Expr, index: Expr, value: Expr) -> Expr {
    let params: Vec[tast::Type] = Vec::new();
    params.push(expr_type(container));
    params.push(tast::Type::Int);
    params.push(expr_type(value));
    let args: Vec[Expr] = Vec::new();
    args.push(container);
    args.push(index);
    args.push(value);
    place_intrinsic_call("vec.set", params, tast::Type::Unit, args)
}

fn place_hashmap_set(container: Expr, index: Expr, value: Expr) -> Expr {
    let params: Vec[tast::Type] = Vec::new();
    params.push(expr_type(container));
    params.push(expr_type(index));
    params.push(expr_type(value));
    let args: Vec[Expr] = Vec::new();
    args.push(container);
    args.push(index);
    args.push(value);
    place_intrinsic_call("hashmap.set", params, tast::Type::Unit, args)
}

fn struct_place_details(ctx: Lowerer, parent_ty: tast::Type) -> Option[
    (tast::Constructor, Vec[(string, tast::Type)]),
] {
    match nominal_parts(parent_ty) {
        Some((name, args)) => match find_struct(ctx, name) {
            Some(definition) => {
                let fields: Vec[(string, tast::Type)] = Vec::new();
                let field_names: Vec[string] = Vec::new();
                for field in definition.fields {
                    field_names.push(field.0);
                    fields.push(
                        (field.0, tast::substitute_params(field.1, definition.generics, args)),
                    )
                };
                Option::Some(
                    (
                        tast::Constructor {
                            name,
                            fields: field_names,
                            is_struct: true,
                            tag: Option::None,
                        },
                        fields,
                    ),
                )
            },
            None => Option::None,
        },
        None => Option::None,
    }
}

fn place_field_get(
    ctx: Lowerer,
    parent: Expr,
    parent_ty: tast::Type,
    field_name: string,
    item_ty: tast::Type,
) -> Expr {
    match struct_place_details(ctx, parent_ty) {
        Some((constructor, fields)) => {
            let field_index = Ref::new(0);
            for index in range(0, fields.len()) {
                if fields[index].0 == field_name {
                    field_index.set(index)
                } else {
                    ()
                }
            };
            Expr::ConstrGet {
                expr: parent,
                constructor,
                field_index: field_index.get(),
                ty: item_ty,
            }
        },
        None => missing_expr(item_ty),
    }
}

fn rebuild_tuple(parent: Expr, parent_ty: tast::Type, index: int, value: Expr) -> Expr {
    match tast::resolve_type(parent_ty) {
        Tuple { items: types } => {
            let items: Vec[Expr] = Vec::new();
            for item_index in range(0, types.len()) {
                if item_index == index {
                    items.push(value)
                } else {
                    items.push(
                        Expr::Proj { tuple: parent, index: item_index, ty: types[item_index] },
                    )
                }
            };
            Expr::Tuple { items, ty: parent_ty }
        },
        _ => missing_expr(parent_ty),
    }
}

fn rebuild_struct(
    ctx: Lowerer,
    parent: Expr,
    parent_ty: tast::Type,
    field_name: string,
    value: Expr,
) -> Expr {
    match struct_place_details(ctx, parent_ty) {
        Some((constructor, fields)) => {
            let args: Vec[Expr] = Vec::new();
            for index in range(0, fields.len()) {
                let field = fields[index];
                if field.0 == field_name {
                    args.push(value)
                } else {
                    args.push(
                        Expr::ConstrGet {
                            expr: parent,
                            constructor,
                            field_index: index,
                            ty: field.1,
                        },
                    )
                }
            };
            Expr::Constr { constructor, args, ty: parent_ty }
        },
        None => missing_expr(parent_ty),
    }
}

fn lower_index_assignment(
    ctx: Lowerer,
    target: tast::Expr,
    op: ast::AssignmentOp,
    value: tast::Expr,
) -> Expr {
    match decompose_place(target) {
        Some((root, steps)) => if steps.len() > 0 {
            let stmts: Vec[LetStmt] = Vec::new();
            let compiled_root: Ref[CompiledPlaceRoot] = Ref::new(CompiledPlaceRoot::Value);
            let current_name = Ref::new("");
            let current_ty = Ref::new(tast::Type::Error);
            match root {
                Local { name, ty } => {
                    let root_name = gensym(ctx, "place_root");
                    stmts.push(LetStmt { name: root_name, value: Expr::Var { name, ty }, ty });
                    compiled_root.set(CompiledPlaceRoot::Local { name, ty });
                    current_name.set(root_name);
                    current_ty.set(ty)
                },
                Ref { expr: reference, ty } => {
                    let ref_ty = tast::expr_type(reference);
                    let ref_name = gensym(ctx, "place_ref");
                    stmts.push(
                        LetStmt { name: ref_name, value: lower_expr(ctx, reference), ty: ref_ty },
                    );
                    let root_name = gensym(ctx, "place_root");
                    stmts.push(
                        LetStmt {
                            name: root_name,
                            value: place_ref_get(
                                Expr::Var { name: ref_name, ty: ref_ty },
                                ref_ty,
                                ty,
                            ),
                            ty,
                        },
                    );
                    compiled_root.set(CompiledPlaceRoot::Ref { ref_var: ref_name, ref_ty });
                    current_name.set(root_name);
                    current_ty.set(ty)
                },
                Value { expr, ty } => {
                    let root_name = gensym(ctx, "place_root");
                    stmts.push(LetStmt { name: root_name, value: lower_expr(ctx, expr), ty });
                    current_name.set(root_name);
                    current_ty.set(ty)
                },
            };
            let evaluated: Vec[EvaluatedPlaceStep] = Vec::new();
            for step in steps {
                match step {
                    Proj { parent_ty, index, item_ty } => {
                        let parent_name = current_name.get();
                        let next_name = gensym(ctx, "place");
                        stmts.push(
                            LetStmt {
                                name: next_name,
                                value: Expr::Proj {
                                    tuple: Expr::Var { name: parent_name, ty: current_ty.get() },
                                    index,
                                    ty: item_ty,
                                },
                                ty: item_ty,
                            },
                        );
                        evaluated.push(
                            EvaluatedPlaceStep::Proj { parent_var: parent_name, parent_ty, index },
                        );
                        current_name.set(next_name);
                        current_ty.set(item_ty)
                    },
                    Field { parent_ty, field_name, item_ty } => {
                        let parent_name = current_name.get();
                        let next_name = gensym(ctx, "place");
                        stmts.push(
                            LetStmt {
                                name: next_name,
                                value: place_field_get(
                                    ctx,
                                    Expr::Var { name: parent_name, ty: current_ty.get() },
                                    parent_ty,
                                    field_name,
                                    item_ty,
                                ),
                                ty: item_ty,
                            },
                        );
                        evaluated.push(
                            EvaluatedPlaceStep::Field {
                                parent_var: parent_name,
                                parent_ty,
                                field_name,
                            },
                        );
                        current_name.set(next_name);
                        current_ty.set(item_ty)
                    },
                    Index { container_ty, index, item_ty } => {
                        let parent_name = current_name.get();
                        let index_ty = tast::expr_type(index);
                        let index_name = gensym(ctx, "index");
                        stmts.push(
                            LetStmt {
                                name: index_name,
                                value: lower_expr(ctx, index),
                                ty: index_ty,
                            },
                        );
                        let next_name = gensym(ctx, "place");
                        stmts.push(
                            LetStmt {
                                name: next_name,
                                value: place_index_read(
                                    Expr::Var { name: parent_name, ty: current_ty.get() },
                                    container_ty,
                                    Expr::Var { name: index_name, ty: index_ty },
                                    item_ty,
                                ),
                                ty: item_ty,
                            },
                        );
                        evaluated.push(
                            EvaluatedPlaceStep::Index {
                                parent_var: parent_name,
                                parent_ty: container_ty,
                                index_var: index_name,
                                index_ty,
                            },
                        );
                        current_name.set(next_name);
                        current_ty.set(item_ty)
                    },
                }
            };
            let value_ty = tast::expr_type(value);
            let value_name = gensym(ctx, "value");
            stmts.push(LetStmt { name: value_name, value: lower_expr(ctx, value), ty: value_ty });
            let updated = Ref::new(
                match op {
                    Compound(operator) => Expr::Binary {
                        op: operator,
                        lhs: Expr::Var { name: current_name.get(), ty: current_ty.get() },
                        rhs: Expr::Var { name: value_name, ty: value_ty },
                        ty: current_ty.get(),
                    },
                    Plain => Expr::Var { name: value_name, ty: value_ty },
                },
            );
            let final_action: Ref[Option[Expr]] = Ref::new(Option::None);
            let stopped = Ref::new(false);
            for offset in range(0, evaluated.len()) {
                if stopped.get() {
                    ()
                } else {
                    match evaluated[evaluated.len() - 1 - offset] {
                        Proj { parent_var: parent_name, parent_ty, index } => {
                            updated.set(
                                rebuild_tuple(
                                    Expr::Var { name: parent_name, ty: parent_ty },
                                    parent_ty,
                                    index,
                                    updated.get(),
                                ),
                            )
                        },
                        Field { parent_var: parent_name, parent_ty, field_name } => {
                            updated.set(
                                rebuild_struct(
                                    ctx,
                                    Expr::Var { name: parent_name, ty: parent_ty },
                                    parent_ty,
                                    field_name,
                                    updated.get(),
                                ),
                            )
                        },
                        Index {
                            parent_var: parent_name,
                            parent_ty,
                            index_var: index_name,
                            index_ty,
                        } => match tast::resolve_type(parent_ty) {
                            Array { len: _, elem: _ } => updated.set(
                                place_array_set(
                                    Expr::Var { name: parent_name, ty: parent_ty },
                                    Expr::Var { name: index_name, ty: index_ty },
                                    updated.get(),
                                ),
                            ),
                            VecType { elem: _ } => {
                                final_action.set(
                                    Option::Some(
                                        place_vec_set(
                                            Expr::Var { name: parent_name, ty: parent_ty },
                                            Expr::Var { name: index_name, ty: index_ty },
                                            updated.get(),
                                        ),
                                    ),
                                );
                                stopped.set(true)
                            },
                            HashMap { key: _, value: _ } => {
                                final_action.set(
                                    Option::Some(
                                        place_hashmap_set(
                                            Expr::Var { name: parent_name, ty: parent_ty },
                                            Expr::Var { name: index_name, ty: index_ty },
                                            updated.get(),
                                        ),
                                    ),
                                );
                                stopped.set(true)
                            },
                            _ => {
                                final_action.set(Option::Some(missing_expr(tast::Type::Unit)));
                                stopped.set(true)
                            },
                        },
                    }
                }
            };
            let action = match final_action.get() {
                Some(value) => value,
                None => match compiled_root.get() {
                    Local { name, ty } => Expr::Assign {
                        name,
                        value: updated.get(),
                        target_ty: ty,
                        ty: tast::Type::Unit,
                    },
                    Ref { ref_var: name, ref_ty: ty } => place_ref_set(
                        Expr::Var { name, ty },
                        updated.get(),
                        ty,
                    ),
                    Value => missing_expr(tast::Type::Unit),
                },
            };
            Expr::Block { block: Block { stmts, tail: Option::Some(action) }, ty: tast::Type::Unit }
        } else {
            missing_expr(tast::Type::Unit)
        },
        None => missing_expr(tast::Type::Unit),
    }
}

fn lower_local_compound_assignment(
    ctx: Lowerer,
    name: string,
    target_ty: tast::Type,
    op: ast::BinaryOp,
    value: tast::Expr,
) -> Expr {
    let old_name = gensym(ctx, "compound_old");
    let value_name = gensym(ctx, "compound_value");
    let value_ty = tast::expr_type(value);
    let stmts: Vec[LetStmt] = Vec::new();
    stmts.push(LetStmt { name: old_name, value: Expr::Var { name, ty: target_ty }, ty: target_ty });
    stmts.push(LetStmt { name: value_name, value: lower_expr(ctx, value), ty: value_ty });
    Expr::Block {
        block: Block {
            stmts,
            tail: Option::Some(
                Expr::Assign {
                    name,
                    value: Expr::Binary {
                        op,
                        lhs: Expr::Var { name: old_name, ty: target_ty },
                        rhs: Expr::Var { name: value_name, ty: value_ty },
                        ty: target_ty,
                    },
                    target_ty,
                    ty: tast::Type::Unit,
                },
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn lower_assignment(ctx: Lowerer, target: tast::Expr, op: ast::AssignmentOp, value: tast::Expr) -> Expr {
    match target {
        Var { name, ty: target_ty } => match op {
            Compound(operator) => {
                lower_local_compound_assignment(ctx, name, target_ty, operator, value)
            },
            Plain => Expr::Assign {
                name,
                value: lower_expr(ctx, value),
                target_ty,
                ty: tast::Type::Unit,
            },
        },
        Index { base: _, index: _, ty: _ } => {
            lower_index_assignment(ctx, target, op, value)
        },
        Proj { tuple: _, index: _, ty: _ } | Field { expr: _, field_name: _, ty: _ } => {
            lower_index_assignment(ctx, target, op, value)
        },
        _ => missing_expr(tast::Type::Unit),
    }
}
