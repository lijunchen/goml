    IMPL_ASSOCIATED_TYPE,
    TYPE_ALIAS,
    CONST,
    STRUCT,
    STRUCT_FIELD_LIST,
    STRUCT_FIELD,
    TYPE_LIST,
    TYPE_UNIT,
    TYPE_BOOL,
    TYPE_INT,
    TYPE_INT8,
    TYPE_INT16,
    TYPE_INT32,
    TYPE_INT64,
    TYPE_UINT,
    TYPE_UINT8,
    TYPE_UINT16,
    TYPE_UINT32,
    TYPE_UINT64,
    TYPE_FLOAT32,
    TYPE_FLOAT64,
    TYPE_STRING,
    TYPE_CHAR,
    TYPE_TUPLE,
    TYPE_TAPP,
    TYPE_DYN,
    TYPE_ARRAY,
    TYPE_FUNC,
    EXPR_LITERAL,
    EXPR_IDENT,
    PATH,
    EXPR_PAREN,
    EXPR_RANGE,
    EXPR_BINARY,
    EXPR_PREFIX,
    EXPR_CAST,
    EXPR_IF,
    EXPR_IF_COND,
    EXPR_IF_THEN,
    EXPR_IF_ELSE,
    EXPR_WHILE,
    EXPR_WHILE_COND,
    EXPR_WHILE_BODY,
    EXPR_FOR,
    EXPR_BREAK,
    EXPR_CONTINUE,
    EXPR_MATCH,
    EXPR_GO,
    EXPR_RETURN,
    EXPR_UNIT,
    EXPR_BOOL,
    EXPR_INT,
    EXPR_FLOAT,
    EXPR_CHAR,
    EXPR_BYTE,
    EXPR_STR,
    EXPR_MULTILINE_STR,
    EXPR_INTERPOLATED_STRING,
    INTERPOLATED_STRING_EXPR,
    EXPR_ARRAY_LITERAL,
    EXPR_VEC_LITERAL,
    EXPR_HASHMAP_LITERAL,
    HASHMAP_LITERAL_ENTRY,
    EXPR_TUPLE,
    EXPR_CALL,
    EXPR_INDEX,
    EXPR_TRY,
    EXPR_STRUCT_LITERAL,
    ARG_LIST,
    ARG,
    STRUCT_LITERAL_FIELD_LIST,
