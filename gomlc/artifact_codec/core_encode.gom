package codec;

use gomlc::artifact_wire as wire;

use gomlc::ast;
use gomlc::core;
use gomlc::strings;
use gomlc::tast;
use std::text;

pub fn artifact_json_string_array(writer: wire::ArtifactJsonWriter, values: Vec[string]) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_string(writer, value)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_float_number(value: string) -> string {
    if strings::contains(value, ".") || strings::contains(value, "e")
        || strings::contains(value, "E") {
        value
    } else {
        value + ".0"
    }
}

pub fn artifact_json_primitive_value(
    writer: wire::ArtifactJsonWriter,
    kind: string,
    value: string,
    quoted: bool,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, kind);
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "value");
    if quoted {
        wire::artifact_json_string(writer, value)
    } else {
        wire::artifact_json_number(writer, value)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_integer_kind(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        Int => "Int",
        Int8 => "Int8",
        Int16 => "Int16",
        Int32 => "Int32",
        Int64 => "Int64",
        Uint => "UInt",
        Uint8 => "UInt8",
        Uint16 => "UInt16",
        Uint32 => "UInt32",
        Uint64 => "UInt64",
        _ => {
            fail("error[compile]: invalid integer type in compiler artifact");
            "Int32"
        },
    }
}

pub fn artifact_float_kind(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        Float32 => "Float32",
        Float64 => "Float64",
        _ => {
            fail("error[compile]: invalid float type in compiler artifact");
            "Float64"
        },
    }
}

pub fn artifact_json_primitive(writer: wire::ArtifactJsonWriter, value: tast::Primitive, ty: tast::Type) -> unit {
    match value {
        Unit => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "Unit");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            wire::artifact_json_null(writer);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Bool { value } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "Bool");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            wire::artifact_json_bool(writer, value);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Int { value } => artifact_json_primitive_value(
            writer,
            artifact_integer_kind(ty),
            value,
            false,
        ),
        Int8 { value } => artifact_json_primitive_value(writer, "Int8", value, false),
        Int16 { value } => artifact_json_primitive_value(writer, "Int16", value, false),
        Int32 { value } => artifact_json_primitive_value(writer, "Int32", value, false),
        Int64 { value } => artifact_json_primitive_value(writer, "Int64", value, false),
        Uint { value } => artifact_json_primitive_value(writer, "UInt", value, false),
        Uint8 { value } => artifact_json_primitive_value(writer, "UInt8", value, false),
        Uint16 { value } => artifact_json_primitive_value(writer, "UInt16", value, false),
        Uint32 { value } => artifact_json_primitive_value(writer, "UInt32", value, false),
        Uint64 { value } => artifact_json_primitive_value(writer, "UInt64", value, false),
        Float { value } => artifact_json_primitive_value(
            writer,
            artifact_float_kind(ty),
            artifact_float_number(value),
            false,
        ),
        Float32 { value } => artifact_json_primitive_value(
            writer,
            "Float32",
            artifact_float_number(value),
            false,
        ),
        Float64 { value } => artifact_json_primitive_value(
            writer,
            "Float64",
            artifact_float_number(value),
            false,
        ),
        String { value } => artifact_json_primitive_value(writer, "String", value, true),
        Char { value } => artifact_json_primitive_value(writer, "Char", value.to_string(), true),
    }
}

pub fn artifact_constructor_separator(value: string) -> int {
    let mut result = -1;
    if value.byte_len() > 1 {
        for index in 0..value.byte_len() - 1 {
            if strings::starts_with_at(value, index, "::") {
                result = index;
            } else {
                ()
            }
        }
    } else {
        ()
    };
    result
}

pub fn artifact_json_constructor(writer: wire::ArtifactJsonWriter, value: tast::Constructor) -> unit {
    wire::artifact_json_begin_object(writer);
    if value.is_struct {
        wire::artifact_json_name(writer, "Struct");
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "type_name");
        wire::artifact_json_string(writer, value.name);
        wire::artifact_json_end_object(writer)
    } else {
        let separator = artifact_constructor_separator(value.name);
        if separator < 0 {
            fail("error[compile]: invalid enum constructor in compiler artifact")
        } else {
            ()
        };
        wire::artifact_json_name(writer, "Enum");
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "type_name");
        wire::artifact_json_string(writer, value.name.byte_slice(0, separator));
        wire::artifact_json_name(writer, "variant");
        wire::artifact_json_string(writer, value.name.byte_slice(separator + 2, value.name.byte_len()));
        wire::artifact_json_name(writer, "index");
        wire::artifact_json_number(
            writer,
            match value.tag {
                Some(value) => value.to_string(),
                None => {
                    fail("error[compile]: missing enum tag in compiler artifact");
                    "0"
                },
            },
        );
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_object(writer)
}

pub struct ArtifactCallable {
    pub name: string,
    pub kind: string,
    pub id: Option[string],
}

pub fn artifact_intrinsic_source_name(value: string) -> string {
    if value == "eq.primitive" {
        "__goml_primitive_eq"
    } else if value == "array.get" {
        "array_get"
    } else if value == "array.set" {
        "array_set"
    } else if value == "ref.new" {
        "ref"
    } else if value == "ref.get" {
        "ref_get"
    } else if value == "ref.set" {
        "ref_set"
    } else if value == "ref.ptr_eq" {
        "ptr_eq"
    } else if value == "ref.ptr_hash" {
        "ptr_hash"
    } else if value == "vec.new" {
        "vec_new"
    } else if value == "vec.with_capacity" {
        "vec_with_capacity"
    } else if value == "vec.push" {
        "vec_push"
    } else if value == "vec.get" {
        "vec_get"
    } else if value == "vec.set" {
        "vec_set"
    } else if value == "vec.len" {
        "vec_len"
    } else if value == "vec.capacity" {
        "vec_capacity"
    } else if value == "vec.reserve" {
        "vec_reserve"
    } else if value == "vec.truncate" {
        "vec_truncate"
    } else if value == "slice.new" {
        "slice"
    } else if value == "slice.get" {
        "slice_get"
    } else if value == "slice.len" {
        "slice_len"
    } else if value == "slice.sub" {
        "slice_sub"
    } else if value == "hashmap.new" {
        "hashmap_new"
    } else if value == "hashmap.get" {
        "hashmap_get"
    } else if value == "hashmap.set" {
        "hashmap_set"
    } else if value == "hashmap.remove" {
        "hashmap_remove"
    } else if value == "hashmap.len" {
        "hashmap_len"
    } else if value == "hashmap.contains" {
        "hashmap_contains"
    } else if value == "hashmap.entries" {
        "hashmap_entries"
    } else if value == "channel.new" {
        "channel_new"
    } else if value == "channel.send" {
        "channel_send"
    } else if value == "channel.recv" {
        "channel_recv"
    } else if value == "channel.close" {
        "channel_close"
    } else if value == "compiler.missing" {
        "missing"
    } else {
        fail("error[compile]: invalid intrinsic in compiler artifact");
        value
    }
}

pub fn artifact_replace_dots(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '.' {
            builder.write_char('_')
        } else {
            builder.write_char(character)
        }
    };
    builder.finish()
}

pub fn artifact_runtime_source_name(value: string) -> string {
    if strings::starts_with(value, "core.") {
        let name = value.byte_slice(5, value.byte_len());
        if name == "char_from_uint32" {
            name + "_raw"
        } else {
            name
        }
    } else {
        "std::internal::host::"
            + match value {
                "std.env.args" => "args",
                "std.env.current_dir" => "current_dir",
                "std.env.current_exe" => "current_exe",
                "std.env.var" => "env_var",
                "std.fs.read_file" => "read_file",
                "std.fs.write_file" => "write_file",
                "std.fs.read_bytes" => "read_bytes",
                "std.fs.write_bytes" => "write_bytes",
                "std.fs.create_dir_all" => "create_dir_all",
                "std.fs.remove_file" => "remove_file",
                "std.fs.remove_dir_all" => "remove_dir_all",
                "std.fs.file_exists" => "file_exists",
                "std.fs.is_file" => "is_file",
                "std.fs.is_dir" => "is_dir",
                "std.fs.canonicalize" => "canonicalize",
                "std.fs.read_dir" => "read_dir",
                "std.fs.sha256_file" => "sha256_file",
                "std.io.print" => "print",
                "std.io.println" => "println",
                "std.io.eprint" => "eprint",
                "std.io.read_stdin" => "read_stdin",
                "std.io.read_stdin_exact" => "read_stdin_exact",
                "std.io.write_stdout" => "write_stdout",
                "std.io.write_stderr" => "write_stderr",
                "std.path.join" => "path_join",
                "std.path.clean" => "path_clean",
                "std.path.is_absolute" => "path_is_absolute",
                "std.path.parent" => "path_parent",
                "std.path.file_name" => "path_file_name",
                "std.path.extension" => "path_extension",
                "std.path.file_stem" => "path_file_stem",
                "std.path.with_extension" => "path_with_extension",
                "std.path.absolute" => "path_absolute",
                "std.process.exit" => "exit",
                "std.process.look_path" => "process_look_path",
                "std.process.output" => "process_output",
                "std.process.output_timeout" => "process_output_timeout",
                "std.process.status" => "process_status",
                "std.process.status_timeout" => "process_status_timeout",
                "std.testing.fail" => "test_fail",
                "std.num.parse_int" => "parse_int",
                "std.num.parse_uint" => "parse_uint",
                "std.num.parse_float32" => "parse_float32",
                "std.num.parse_float64" => "parse_float64",
                "std.time.monotonic_nanoseconds" => "monotonic_nanoseconds",
                "std.time.unix_nanoseconds" => "unix_nanoseconds",
                "std.time.sleep_nanoseconds" => "sleep_nanoseconds",
                _ => {
                    fail("error[compile]: invalid runtime hook in compiler artifact");
                    value
                },
            }
    }
}

pub fn artifact_callable_id(kind: string, value: string) -> string {
    if kind == "intrinsic" {
        if value == "eq.primitive" {
            "primitive_eq"
        } else if value == "compiler.missing" {
            "missing"
        } else if value == "hashmap.new" {
            "hash_map_new"
        } else if value == "hashmap.get" {
            "hash_map_get"
        } else if value == "hashmap.set" {
            "hash_map_set"
        } else if value == "hashmap.remove" {
            "hash_map_remove"
        } else if value == "hashmap.len" {
            "hash_map_len"
        } else if value == "hashmap.contains" {
            "hash_map_contains"
        } else if value == "hashmap.entries" {
            "hash_map_entries"
        } else {
            artifact_replace_dots(value)
        }
    } else if strings::starts_with(value, "core.") {
        value.byte_slice(5, value.byte_len())
    } else {
        artifact_replace_dots(value)
    }
}

pub fn artifact_callable(value: tast::Callable) -> ArtifactCallable {
    match value {
        Function(value) => ArtifactCallable { name: value, kind: "goml", id: Option::None },
        Runtime(value) => ArtifactCallable {
            name: artifact_runtime_source_name(value),
            kind: "runtime",
            id: Option::Some(artifact_callable_id("runtime", value)),
        },
        Intrinsic(value) => ArtifactCallable {
            name: artifact_intrinsic_source_name(value),
            kind: "intrinsic",
            id: Option::Some(artifact_callable_id("intrinsic", value)),
        },
        TraitMethod { trait_ref: _, method_name: _ } | DynTraitMethod {
            trait_name: _,
            dispatch_name: _,
            method_name: _,
        } | InherentMethod { receiver_ty: _, method_name: _ } => {
            fail("error[compile]: unresolved callable in compiler artifact");
            ArtifactCallable { name: "", kind: "goml", id: Option::None }
        },
    }
}

pub fn artifact_json_callable_body(writer: wire::ArtifactJsonWriter, value: ArtifactCallable) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "kind");
    wire::artifact_json_string(writer, value.kind);
    match value.id {
        Some(value) => {
            wire::artifact_json_name(writer, "id");
            wire::artifact_json_string(writer, value)
        },
        None => (),
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_unary_name(value: ast::UnaryOp) -> string {
    match value {
        Neg => "Neg",
        Not => "Not",
        BitNot => "BitNot",
    }
}

pub fn artifact_binary_name(value: ast::BinaryOp) -> string {
    match value {
        Add => "Add",
        Sub => "Sub",
        Mul => "Mul",
        Div => "Div",
        Rem => "Rem",
        BitAnd => "BitAnd",
        BitOr => "BitOr",
        BitXor => "BitXor",
        Shl => "Shl",
        Shr => "Shr",
        And => "And",
        Or => "Or",
        Less => "Less",
        Greater => "Greater",
        LessEq => "LessEq",
        GreaterEq => "GreaterEq",
        Eq => "Eq",
        NotEq => "NotEq",
    }
}

pub fn artifact_json_core_expr_array(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[core::Expr],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_core_expr(writer, context, value)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_optional_core_expr(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: Option[core::Expr],
) -> unit {
    match value {
        Some(value) => artifact_json_core_expr(writer, context, value),
        None => wire::artifact_json_null(writer),
    }
}

pub fn artifact_json_closure_params(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[tast::ClosureParam],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, value.name);
        wire::artifact_json_name(writer, "ty");
        artifact_json_type(writer, context, value.ty);
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_core_arms(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[core::Arm],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "lhs");
        artifact_json_core_expr(writer, context, value.lhs);
        wire::artifact_json_name(writer, "body");
        artifact_json_core_expr(writer, context, value.body);
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_core_expr(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: core::Expr,
) -> unit {
    wire::artifact_json_begin_object(writer);
    match value {
        Var { name, ty } => {
            wire::artifact_json_name(writer, "EVar");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Callable { callable, ty } => {
            wire::artifact_json_name(writer, "ECallable");
            wire::artifact_json_begin_object(writer);
            let callable = artifact_callable(callable);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, callable.name);
            wire::artifact_json_name(writer, "body");
            artifact_json_callable_body(writer, callable);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Prim { value, ty } => {
            wire::artifact_json_name(writer, "EPrim");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            artifact_json_primitive(writer, value, ty);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Constr { constructor, args, ty } => {
            wire::artifact_json_name(writer, "EConstr");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "constructor");
            artifact_json_constructor(writer, constructor);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Tuple { items, ty } => {
            wire::artifact_json_name(writer, "ETuple");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "items");
            artifact_json_core_expr_array(writer, context, items);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Array { items, ty } => {
            wire::artifact_json_name(writer, "EArray");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "items");
            artifact_json_core_expr_array(writer, context, items);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Closure { params, body, ty } => {
            wire::artifact_json_name(writer, "EClosure");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "params");
            artifact_json_closure_params(writer, context, params);
            wire::artifact_json_name(writer, "body");
            artifact_json_core_expr(writer, context, body);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Block { block, ty } => {
            wire::artifact_json_name(writer, "EBlock");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "block");
            artifact_json_core_block(writer, context, block);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Match { expr, arms, default, ty } => {
            wire::artifact_json_name(writer, "EMatch");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "arms");
            artifact_json_core_arms(writer, context, arms);
            wire::artifact_json_name(writer, "default");
            artifact_json_optional_core_expr(writer, context, default);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        If { cond, then_branch, else_branch, ty } => {
            wire::artifact_json_name(writer, "EIf");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "cond");
            artifact_json_core_expr(writer, context, cond);
            wire::artifact_json_name(writer, "then_branch");
            artifact_json_core_expr(writer, context, then_branch);
            wire::artifact_json_name(writer, "else_branch");
            artifact_json_core_expr(writer, context, else_branch);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        While { cond, body, ty } => {
            wire::artifact_json_name(writer, "EWhile");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "cond");
            artifact_json_core_expr(writer, context, cond);
            wire::artifact_json_name(writer, "body");
            artifact_json_core_expr(writer, context, body);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Loop { body, ty } => {
            wire::artifact_json_name(writer, "ELoop");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "body");
            artifact_json_core_expr(writer, context, body);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Break { value, ty } => {
            wire::artifact_json_name(writer, "EBreak");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            artifact_json_optional_core_expr(writer, context, value);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Continue { ty } => {
            wire::artifact_json_name(writer, "EContinue");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Return { expr, ty } => {
            wire::artifact_json_name(writer, "EReturn");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_optional_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Go { expr, ty } => {
            wire::artifact_json_name(writer, "EGo");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        ConstrGet { expr, constructor, field_index, ty } => {
            wire::artifact_json_name(writer, "EConstrGet");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "constructor");
            artifact_json_constructor(writer, constructor);
            wire::artifact_json_name(writer, "field_index");
            wire::artifact_json_number(writer, field_index.to_string());
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Unary { op, expr, ty } => {
            wire::artifact_json_name(writer, "EUnary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_unary_name(op));
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Cast { expr, ty } => {
            wire::artifact_json_name(writer, "ECast");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Binary { op, lhs, rhs, ty } => {
            wire::artifact_json_name(writer, "EBinary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_binary_name(op));
            wire::artifact_json_name(writer, "lhs");
            artifact_json_core_expr(writer, context, lhs);
            wire::artifact_json_name(writer, "rhs");
            artifact_json_core_expr(writer, context, rhs);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Assign { name, value, target_ty, ty } => {
            wire::artifact_json_name(writer, "EAssign");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "value");
            artifact_json_core_expr(writer, context, value);
            wire::artifact_json_name(writer, "target_ty");
            artifact_json_type(writer, context, target_ty);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Call { func, args, ty } => {
            wire::artifact_json_name(writer, "ECall");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "func");
            artifact_json_core_expr(writer, context, func);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        ToDyn { trait_name, for_ty, expr, ty } => {
            wire::artifact_json_name(writer, "EToDyn");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_name");
            wire::artifact_json_string(writer, trait_name);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_type(writer, context, for_ty);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        DynCall { trait_name, method_name, receiver, args, ty } => {
            wire::artifact_json_name(writer, "EDynCall");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_name");
            wire::artifact_json_string(writer, trait_name);
            wire::artifact_json_name(writer, "method_name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_name(writer, "receiver");
            artifact_json_core_expr(writer, context, receiver);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        TraitCall { trait_ref, method_name, receiver, args, ty, .. } => {
            wire::artifact_json_name(writer, "ETraitCall");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_ref");
            artifact_json_trait_ref(writer, context, trait_ref);
            wire::artifact_json_name(writer, "method_name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_name(writer, "receiver");
            artifact_json_core_expr(writer, context, receiver);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Proj { tuple, index, ty } => {
            wire::artifact_json_name(writer, "EProj");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "tuple");
            artifact_json_core_expr(writer, context, tuple);
            wire::artifact_json_name(writer, "index");
            wire::artifact_json_number(writer, index.to_string());
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_core_block(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: core::Block,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "stmts");
    wire::artifact_json_begin_array(writer);
    for statement in value.stmts {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, statement.name);
        wire::artifact_json_name(writer, "value");
        artifact_json_core_expr(writer, context, statement.value);
        wire::artifact_json_name(writer, "ty");
        artifact_json_type(writer, context, statement.ty);
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "tail");
    artifact_json_optional_core_expr(writer, context, value.tail);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_core_trait_impl(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: Option[core::TraitImpl],
) -> unit {
    match value {
        Some(value) => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_ref");
            artifact_json_trait_ref(writer, context, value.trait_ref);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_type(writer, context, value.for_ty);
            wire::artifact_json_name(writer, "generic_count");
            wire::artifact_json_number(writer, value.generic_count.to_string());
            wire::artifact_json_name(writer, "predicate_count");
            wire::artifact_json_number(writer, value.predicate_count.to_string());
            wire::artifact_json_end_object(writer)
        },
        None => wire::artifact_json_null(writer),
    }
}

pub fn artifact_json_core_params(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[(string, tast::Type)],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_array(writer);
        wire::artifact_json_string(writer, value.0);
        artifact_json_type(writer, context, value.1);
        wire::artifact_json_end_array(writer)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_core_function(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: core::Function,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "root");
    wire::artifact_json_bool(writer, value.root);
    wire::artifact_json_name(writer, "generics");
    artifact_json_string_array(writer, value.generics);
    wire::artifact_json_name(writer, "trait_impl");
    artifact_json_core_trait_impl(writer, context, value.trait_impl);
    wire::artifact_json_name(writer, "params");
    artifact_json_core_params(writer, context, value.params);
    wire::artifact_json_name(writer, "ret_ty");
    artifact_json_type(writer, context, value.ret_ty);
    wire::artifact_json_name(writer, "body");
    artifact_json_core_block(writer, context, value.body);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_const_expr(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::ConstExpr,
) -> unit {
    wire::artifact_json_begin_object(writer);
    match value {
        Prim { value, ty } => {
            wire::artifact_json_name(writer, "CPrim");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            artifact_json_primitive(writer, value, ty);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Ref { name, ty } => {
            wire::artifact_json_name(writer, "CRef");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Unary { op, expr, ty } => {
            wire::artifact_json_name(writer, "CUnary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_unary_name(op));
            wire::artifact_json_name(writer, "expr");
            artifact_json_const_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Cast { expr, ty } => {
            wire::artifact_json_name(writer, "CCast");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_const_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Binary { op, lhs, rhs, ty } => {
            wire::artifact_json_name(writer, "CBinary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_binary_name(op));
            wire::artifact_json_name(writer, "lhs");
            artifact_json_const_expr(writer, context, lhs);
            wire::artifact_json_name(writer, "rhs");
            artifact_json_const_expr(writer, context, rhs);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Error { ty } => {
            wire::artifact_json_name(writer, "CError");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_constant(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::Constant,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "ty");
    artifact_json_type(writer, context, value.ty);
    wire::artifact_json_name(writer, "value");
    artifact_json_const_expr(writer, context, value.value);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_core_file(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: core::File,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "toplevels");
    wire::artifact_json_begin_array(writer);
    for function in value.functions {
        artifact_json_core_function(writer, context, function)
    };
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "constants");
    wire::artifact_json_begin_array(writer);
    for value in value.constants {
        artifact_json_constant(writer, context, value)
    };
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer)
}
