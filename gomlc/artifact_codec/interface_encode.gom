package codec;

use gomlc::artifact_wire as wire;

use gomlc::artifact_model;

use gomlc::hash;
use gomlc::tast;

pub fn empty_artifact_package_exports() -> artifact_model::ArtifactPackageExports {
    artifact_model::ArtifactPackageExports {
        enum_type_names: Vec::[],
        struct_type_names: Vec::[],
        type_aliases: Vec::[],
        enums: Vec::[],
        structs: Vec::[],
        traits: Vec::[],
        trait_impls: Vec::[],
        inherent_impls: Vec::[],
        functions: Vec::[],
        constants: Vec::[],
    }
}

pub fn artifact_exports_type_context(value: artifact_model::ArtifactPackageExports) -> ArtifactTypeContext {
    let enum_names = value.enum_type_names;
    let struct_names = value.struct_type_names;
    for definition in value.enums {
        enum_names.push(definition.name)
    };
    for definition in value.structs {
        struct_names.push(definition.name)
    };
    artifact_type_context(enum_names, struct_names)
}

pub fn artifact_json_type_pairs(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[(string, tast::Type)],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_array(writer);
        wire::artifact_json_string(writer, value.0);
        artifact_json_type(writer, context, value.1);
        wire::artifact_json_end_array(writer)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_enum_def(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::EnumDef,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "generics");
    artifact_json_string_array(writer, value.generics);
    wire::artifact_json_name(writer, "variants");
    wire::artifact_json_begin_array(writer);
    for variant in value.variants {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, variant.name);
        wire::artifact_json_name(writer, "fields");
        match variant.fields {
            Unit => wire::artifact_json_string(writer, "Unit"),
            Tuple(fields) => {
                wire::artifact_json_begin_object(writer);
                wire::artifact_json_name(writer, "Tuple");
                artifact_json_type_array(writer, context, fields);
                wire::artifact_json_end_object(writer)
            },
            Struct(fields) => {
                wire::artifact_json_begin_object(writer);
                wire::artifact_json_name(writer, "Struct");
                artifact_json_type_pairs(writer, context, fields);
                wire::artifact_json_end_object(writer)
            },
        };
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_struct_def(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::StructDef,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "generics");
    artifact_json_string_array(writer, value.generics);
    wire::artifact_json_name(writer, "fields");
    artifact_json_type_pairs(writer, context, value.fields);
    wire::artifact_json_name(writer, "has_hidden_fields");
    wire::artifact_json_bool(writer, value.has_hidden_fields);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_predicates(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[tast::TypePredicate],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_type_predicate(writer, context, value)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_trait_refs(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[tast::TraitRef],
) -> unit {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_trait_ref(writer, context, value)
    };
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_fn_scheme(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactFnScheme,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "type_params");
    artifact_json_string_array(writer, value.type_params);
    wire::artifact_json_name(writer, "constraints");
    artifact_json_predicates(writer, context, value.constraints);
    wire::artifact_json_name(writer, "ty");
    artifact_json_type(writer, context, value.ty);
    wire::artifact_json_name(writer, "body");
    artifact_json_callable_body(writer, artifact_callable(value.body));
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_methods(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[artifact_model::ArtifactFnScheme],
) -> unit {
    wire::artifact_json_begin_object(writer);
    for value in values {
        wire::artifact_json_name(writer, value.name);
        artifact_json_fn_scheme(writer, context, value)
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_trait_def(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactTraitDef,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "params");
    artifact_json_string_array(writer, value.params);
    wire::artifact_json_name(writer, "predicates");
    artifact_json_predicates(writer, context, value.predicates);
    wire::artifact_json_name(writer, "supertraits");
    artifact_json_trait_refs(writer, context, value.supertraits);
    wire::artifact_json_name(writer, "associated_types");
    wire::artifact_json_begin_object(writer);
    for associated in value.associated_types {
        wire::artifact_json_name(writer, associated.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "bounds");
        artifact_json_trait_refs(writer, context, associated.bounds);
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "methods");
    artifact_json_methods(writer, context, value.methods);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_impl_def(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactImplDef,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "params");
    artifact_json_string_array(writer, value.params);
    wire::artifact_json_name(writer, "constraints");
    artifact_json_predicates(writer, context, value.constraints);
    wire::artifact_json_name(writer, "associated_types");
    wire::artifact_json_begin_object(writer);
    for associated in value.associated_types {
        wire::artifact_json_name(writer, associated.0);
        artifact_json_type(writer, context, associated.1)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "methods");
    artifact_json_methods(writer, context, value.methods);
    wire::artifact_json_name(writer, "valid");
    wire::artifact_json_bool(writer, value.valid);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_trait_impl_key(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactTraitImpl,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "trait_ref");
    artifact_json_trait_ref(writer, context, value.trait_ref);
    wire::artifact_json_name(writer, "for_ty");
    artifact_json_type(writer, context, value.for_ty);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_inherent_impl_key(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactInherentImplKey,
) -> unit {
    wire::artifact_json_begin_object(writer);
    match value {
        Exact(value) => {
            wire::artifact_json_name(writer, "Exact");
            artifact_json_type(writer, context, value)
        },
        Constr(value) => {
            wire::artifact_json_name(writer, "Constr");
            wire::artifact_json_string(writer, value)
        },
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_package_exports(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactPackageExports,
) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "type_env");
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "enums");
    wire::artifact_json_begin_object(writer);
    for definition in value.enums {
        wire::artifact_json_name(writer, definition.name);
        artifact_json_enum_def(writer, context, definition)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "structs");
    wire::artifact_json_begin_object(writer);
    for definition in value.structs {
        wire::artifact_json_name(writer, definition.name);
        artifact_json_struct_def(writer, context, definition)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "aliases");
    wire::artifact_json_begin_object(writer);
    for alias in value.type_aliases {
        wire::artifact_json_name(writer, alias.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "generics");
        artifact_json_string_array(writer, alias.generics);
        wire::artifact_json_name(writer, "ty");
        artifact_json_type(writer, context, alias.ty);
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "trait_env");
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "trait_defs");
    wire::artifact_json_begin_object(writer);
    for definition in value.traits {
        wire::artifact_json_name(writer, definition.name);
        artifact_json_trait_def(writer, context, definition)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "trait_impls");
    wire::artifact_json_begin_array(writer);
    for implementation in value.trait_impls {
        wire::artifact_json_begin_array(writer);
        artifact_json_trait_impl_key(writer, context, implementation);
        artifact_json_impl_def(writer, context, implementation.definition);
        wire::artifact_json_end_array(writer)
    };
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "inherent_impls");
    wire::artifact_json_begin_array(writer);
    for implementation in value.inherent_impls {
        wire::artifact_json_begin_array(writer);
        artifact_json_inherent_impl_key(writer, context, implementation.key);
        artifact_json_impl_def(writer, context, implementation.definition);
        wire::artifact_json_end_array(writer)
    };
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "value_env");
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "funcs");
    wire::artifact_json_begin_object(writer);
    for function in value.functions {
        wire::artifact_json_name(writer, function.name);
        artifact_json_fn_scheme(writer, context, function)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "consts");
    wire::artifact_json_begin_object(writer);
    for value in value.constants {
        wire::artifact_json_name(writer, value.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "ty");
        artifact_json_type(writer, context, value.ty);
        wire::artifact_json_end_object(writer)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_string_map(writer: wire::ArtifactJsonWriter, values: Vec[(string, string)]) -> unit {
    for index in 1..values.len() {
        let current = values[index];
        let mut destination = index;
        while destination > 0
            && wire::artifact_string_less(current.0, values[destination - 1].0) {
            values[destination] = values[destination - 1];
            destination = destination - 1;
        };
        values[destination] = current;
    };
    wire::artifact_json_begin_object(writer);
    for value in values {
        wire::artifact_json_name(writer, value.0);
        wire::artifact_json_string(writer, value.1)
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_package_interface(writer: wire::ArtifactJsonWriter, value: artifact_model::ArtifactPackageInterface) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "value_exports");
    wire::artifact_json_begin_object(writer);
    for export in value.value_exports {
        wire::artifact_json_name(writer, export.0);
        wire::artifact_json_number(writer, export.1.to_string())
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "enum_variants");
    wire::artifact_json_begin_object(writer);
    for definition in value.enum_variants {
        wire::artifact_json_name(writer, definition.0);
        artifact_json_string_array(writer, definition.1)
    };
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_interface_hash_view(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: artifact_model::ArtifactInterfaceUnit,
) -> unit {
    wire::artifact_json_begin_object(writer);
    if wire::artifact_json_binary_mode(writer) < 2 {
        wire::artifact_json_name(writer, "format_version");
        wire::artifact_json_number(writer, "17");
        wire::artifact_json_name(writer, "compiler_abi");
        wire::artifact_json_number(writer, "3")
    } else {
        ()
    };
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "exports");
    artifact_json_package_exports(writer, context, value.exports);
    wire::artifact_json_name(writer, "interface");
    artifact_json_package_interface(writer, value.package_interface);
    wire::artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_interface_hash(value: artifact_model::ArtifactInterfaceUnit) -> string {
    let writer = wire::new_artifact_json_writer(false);
    artifact_json_interface_hash_view(writer, artifact_exports_type_context(value.exports), value);
    hash::sha256_hex(wire::artifact_json_finish(writer))
}

pub fn new_artifact_interface_unit(
    package_name: string,
    exports: artifact_model::ArtifactPackageExports,
    package_interface: artifact_model::ArtifactPackageInterface,
    deps: Vec[(string, string)],
) -> artifact_model::ArtifactInterfaceUnit {
    let value = artifact_model::ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash: "",
    };
    let interface_hash = artifact_interface_hash(value);
    artifact_model::ArtifactInterfaceUnit {
        package_name: value.package_name,
        exports: value.exports,
        package_interface: value.package_interface,
        deps: value.deps,
        interface_hash,
    }
}

pub fn artifact_json_interface_unit(writer: wire::ArtifactJsonWriter, value: artifact_model::ArtifactInterfaceUnit) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "format_version");
    wire::artifact_json_number(writer, "17");
    wire::artifact_json_name(writer, "compiler_abi");
    wire::artifact_json_number(writer, "3");
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "exports");
    artifact_json_package_exports(
        writer,
        artifact_exports_type_context(value.exports),
        value.exports,
    );
    wire::artifact_json_name(writer, "interface");
    artifact_json_package_interface(writer, value.package_interface);
    wire::artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    wire::artifact_json_name(writer, "interface_hash");
    wire::artifact_json_string(writer, value.interface_hash);
    wire::artifact_json_end_object(writer)
}

pub fn encode_artifact_interface_unit(value: artifact_model::ArtifactInterfaceUnit, pretty: bool) -> string {
    let writer = wire::new_artifact_json_writer(pretty);
    artifact_json_interface_unit(writer, value);
    wire::artifact_json_finish(writer)
}
