package main;

use tests::comptime_derive::macros;
use macros::Label;

#[derive(macros::derive_label)]
struct Box[T] {
    #[field_label]
    value: T,
}

#[derive(macros::derive_label)]
enum State {
    #[variant_label]
    Ready(
        #[payload_label]
        int,
    ),
}

fn main() -> unit {
    let value = Box { value: 1 };
    println(value.label());
    println(State::Ready(1).label())
}
