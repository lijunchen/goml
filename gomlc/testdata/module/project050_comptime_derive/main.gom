package main;

use tests::comptime_derive::macros;
use tests::comptime_derive::json;
use json::Serialize;
use macros::Label;
use macros::Label as RenamedLabel;

#[derive(Label)]
struct Box[T] {
    #[field_label]
    value: T,
}

#[derive(macros::Label)]
enum State {
    #[variant_label]
    Ready(
        #[payload_label]
        int,
    ),
}

#[derive(RenamedLabel)]
struct Alias {
    value: int,
}

#[derive(Serialize)]
struct Record {
    value: int,
}

fn main() -> unit {
    let value = Box { value: 1 };
    println(value.label());
    println(State::Ready(1).label());
    println(Alias { value: 1 }.label());
    println(Record { value: 1 }.serialize())
}
