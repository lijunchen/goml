package main;

use std::json;
use tests::comptime_derive::macros;
use json::Serialize;
use macros::Label;
use macros::Label as RenamedLabel;

#[derive(Label)]
struct Box[T] {
    #[field_label]
    value: T,
}

#[derive(macros::Label)]
enum State {
    #[variant_label]
    Ready(
        #[payload_label]
        int,
    ),
}

#[derive(RenamedLabel)]
struct Alias {
    value: int,
}

#[derive(Serialize)]
struct Record {
    value: int,
    label: string,
}

#[derive(Serialize)]
enum Event {
    Ready,
    Tuple(int, bool),
    Named { value: int },
}

#[derive(Serialize)]
struct Envelope[T] {
    value: T,
}

fn main() -> unit {
    let value = Box { value: 1 };
    println(value.label());
    println(State::Ready(1).label());
    println(Alias { value: 1 }.label());
    println(json::stringify(Record { value: 1, label: "ok" }));
    println(json::stringify(Event::Ready));
    println(json::stringify(Event::Tuple(2, true)));
    println(json::stringify(Event::Named { value: 3 }));
    println(json::stringify(Envelope { value: Vec::[1, 2] }))
}
