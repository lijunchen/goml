package main;

use std::collections;
use std::num;
use std::testing;
use std::text;
use std::time;

fn compare_int(left: int, right: int) -> int {
    if left < right {
        -1
    } else if left > right {
        1
    } else {
        0
    }
}

fn unwrap_int(value: Result[int, string]) -> int {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error);
            0
        },
    }
}

fn unwrap_uint(value: Result[uint, string]) -> uint {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error);
            0
        },
    }
}

fn unwrap_float32(value: Result[float32, string]) -> float32 {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error);
            0.0
        },
    }
}

fn unwrap_float64(value: Result[float64, string]) -> float64 {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error);
            0.0
        },
    }
}

fn assert_text() -> unit {
    testing::assert_eq(text::trim(" \tvalue\r\n"), "value");
    testing::assert_eq(text::trim_start("  left"), "left");
    testing::assert_eq(text::trim_end("right  "), "right");
    let parts = text::split("a::b::", "::");
    testing::assert_eq(parts.len(), 3);
    testing::assert_eq(parts.get(0), "a");
    testing::assert_eq(parts.get(1), "b");
    testing::assert_eq(parts.get(2), "");
    match text::split_once("key=value=tail", "=") {
        Option::Some((left, right)) => {
            testing::assert_eq(left, "key");
            testing::assert_eq(right, "value=tail")
        },
        Option::None => testing::fail("split_once failed"),
    };
    let lines = text::lines("first\r\nsecond\n");
    testing::assert_eq(lines.len(), 2);
    testing::assert_eq(lines.get(0), "first");
    testing::assert_eq(lines.get(1), "second");
    testing::assert_eq(text::find("éclair", "c").unwrap_or(-1), 2);
    testing::assert_eq(text::replace("a-b-a", "a", "xy"), "xy-b-xy");
    testing::assert_eq(text::join(Vec::["a", "b", "c"], ","), "a,b,c");
    testing::assert_eq(text::repeat("ab", 3), "ababab");
    testing::assert(text::is_ascii("ascii"));
    testing::assert(text::is_ascii("é") == false);
    testing::assert_eq(text::to_ascii_lowercase("A-É-Z"), "a-É-z");
    testing::assert_eq(text::to_ascii_uppercase("a-é-z"), "A-é-Z")
}

fn assert_num() -> unit {
    testing::assert_eq(unwrap_int(num::parse_int("-42")), -42);
    testing::assert_eq(unwrap_int(num::parse_int_radix("ff", 16)), 255);
    testing::assert_eq(unwrap_uint(num::parse_uint("42")), 42);
    testing::assert_eq(unwrap_uint(num::parse_uint_radix("101", 2)), 5);
    testing::assert_eq(unwrap_float32(num::parse_float32("1.5")), 1.5);
    testing::assert_eq(unwrap_float64(num::parse_float64("-2.25e2")), -225.0);
    testing::assert(num::parse_int("bad").is_err());
    testing::assert(num::parse_int_radix("10", 1).is_err())
}

fn assert_option_result() -> unit {
    let some: Option[int] = Option::Some(3);
    let none: Option[int] = Option::None;
    testing::assert(some.is_some());
    testing::assert(none.is_none());
    testing::assert_eq(some.unwrap_or(0), 3);
    testing::assert_eq(none.unwrap_or_else(|| 7), 7);
    testing::assert_eq(option_map(some, |value: int| value + 1).unwrap_or(0), 4);
    testing::assert_eq(
        option_and_then(some, |value: int| Option::Some(value * 2)).unwrap_or(0),
        6,
    );
    let converted: Result[int, string] = option_ok_or(none, "missing");
    testing::assert(converted.is_err());
    let ok: Result[int, string] = Result::Ok(5);
    testing::assert(ok.is_ok());
    testing::assert_eq(ok.unwrap_or(0), 5);
    testing::assert_eq(
        result_map(ok, |value: int| value + 2).unwrap_or(0),
        7,
    );
    let failed: Result[int, string] = Result::Err("bad");
    testing::assert_eq(
        result_map_err(failed, |error: string| error + "!").unwrap_or_else(
            |error: string| if error == "bad!" { 9 } else { 0 },
        ),
        9,
    );
    testing::assert_eq(
        result_and_then(
            ok,
            |value: int| Result::Ok(value * 3),
        ).unwrap_or(0),
        15,
    )
}

fn assert_iterators() -> unit {
    let values = Vec::[10, 20, 30, 40];
    let enumerated = iterator_enumerate(values.iter());
    match enumerated.next() {
        Option::Some((index, value)) => {
            testing::assert_eq(index, 0);
            testing::assert_eq(value, 10)
        },
        Option::None => testing::fail("enumerate failed"),
    };
    let zipped = iterator_zip(Vec::[1, 2].iter(), Vec::[3, 4].iter());
    match zipped.next() {
        Option::Some((left, right)) => {
            testing::assert_eq(left, 1);
            testing::assert_eq(right, 3)
        },
        Option::None => testing::fail("zip failed"),
    };
    testing::assert_eq(iterator_skip(values.iter(), 2).next().unwrap_or(0), 30);
    let chained: Vec[int] = iterator_collect(iterator_chain(
        Vec::[1, 2].iter(),
        Vec::[3, 4].iter(),
    ));
    testing::assert_eq(chained.len(), 4);
    testing::assert_eq(chained.get(3), 4);
    testing::assert_eq(
        iterator_find(values.iter(), |value: int| value > 20).unwrap_or(0),
        30,
    );
    testing::assert(iterator_any(values.iter(), |value: int| value == 20));
    testing::assert(iterator_all(values.iter(), |value: int| value >= 10));
    testing::assert_eq(iterator_count(values.iter()), 4)
}

fn assert_collections() -> unit {
    let values = Vec::[4, 1, 3, 2, 2];
    collections::stable_sort_by(values, compare_int);
    testing::assert_eq(values.get(0), 1);
    testing::assert_eq(values.get(4), 4);
    match collections::binary_search_by(
        values,
        |value: int| compare_int(value, 3),
    ) {
        Option::Some(index) => testing::assert_eq(values.get(index), 3),
        Option::None => testing::fail("binary search failed"),
    };
    testing::assert(collections::contains(values, 4));
    testing::assert_eq(
        collections::position_by(values, |value: int| value == 2).unwrap_or(-1),
        1,
    );
    testing::assert_eq(collections::min_by(values, compare_int).unwrap_or(0), 1);
    testing::assert_eq(collections::max_by(values, compare_int).unwrap_or(0), 4);
    collections::dedup(values);
    testing::assert_eq(values.len(), 4);
    testing::assert_eq(values.get(0), 1);
    testing::assert_eq(values.get(3), 4)
}

fn assert_time() -> unit {
    let one_millisecond = time::Duration::from_milliseconds(1);
    testing::assert_eq(one_millisecond.as_microseconds(), 1000);
    testing::assert_eq(
        one_millisecond.add(one_millisecond).as_milliseconds(),
        2,
    );
    testing::assert_eq(
        one_millisecond.subtract(time::Duration::from_seconds(1))
            .as_nanoseconds(),
        0,
    );
    let started = time::Instant::now();
    time::sleep(one_millisecond);
    testing::assert(started.elapsed().as_nanoseconds() >= 0);
    testing::assert(time::SystemTime::now().unix_seconds() > 0)
}

fn main() -> unit {
    assert_text();
    assert_num();
    assert_option_result();
    assert_iterators();
    assert_collections();
    assert_time();
    println("stdlib practical ok")
}
