package iterables;

pub struct Numbers {
    values: Vec[int32],
}

impl IntoIterator for Numbers {
    type Item = int32;

    type IntoIter = FnIterator[int32];

    fn into_iter(self: Numbers) -> FnIterator[int32] {
        self.values.iter()
    }
}

pub fn numbers() -> Numbers {
    let values: Vec[int32] = Vec::new();
    values.push(1);
    values.push(2);
    values.push(3);
    Numbers { values }
}
