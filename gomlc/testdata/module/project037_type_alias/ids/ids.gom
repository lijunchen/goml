package ids;

type RawId = uint64;
type PairStorage[T] = (T, T);

pub type Id = RawId;
pub type Pair[T] = PairStorage[T];

const OFFSET: int32 = 2;
pub const ANSWER: int32 = 40 + OFFSET;
pub const NEWLINE: byte = b'\n';

pub fn make_id(value: Id) -> Id {
    value
}

pub fn add_pair(value: Pair[int32]) -> int32 {
    value.0 + value.1
}
