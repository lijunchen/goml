package main
file main.gom
  trait Show {
      fn show(Self) -> string;
    }

    struct Wrap {
        value: string,
    }

    impl Show for int32 {
      fn show(local/1/0: int32) -> string {
          self/0.to_string()
      }
    }

    impl Show for Wrap {
      fn show(local/1/1: Wrap) -> string {
          self/1.value
      }
    }

    fn main() -> unit {
        let local/1/2: Vec[dyn Show] = Vec::new();
        let local/1/3: int32 = 10;
        values/2.push(value/3);
        values/2.push(Wrap {
              value: "ok"
          });
        println(Show::show(values/2[0]));
        println(Show::show(values/2[1]))
    }