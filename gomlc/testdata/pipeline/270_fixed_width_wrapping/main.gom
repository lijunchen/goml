const WRAPPED_I8: i8 = 127 + 1;

const WRAPPED_U8: u8 = 0 - 1;

const WRAPPED_PRODUCT: u8 = 128 * 2;

const WRAPPED_DIVISION: i8 = -128 / -1;

const WRAPPED_NEGATION: i8 = -(-128);

const FORWARD_WRAPPED: i8 = MAX_I8 + 1;

const MAX_I8: i8 = 127;

fn show_i8(value: i8) -> unit {
    println(value)
}

fn show_u8(value: u8) -> unit {
    println(value)
}

fn show_i64(value: i64) -> unit {
    println(value)
}

fn show_u64(value: u64) -> unit {
    println(value)
}

fn main() -> unit {
    show_i8(127 + 1);
    show_u8(0 - 1);
    show_u8(128 * 2);
    show_i8(-128 / -1);
    show_i8(-(-128));
    show_i64(9223372036854775807 + 1);
    show_u64(18446744073709551615 + 1);
    show_i8(WRAPPED_I8);
    show_u8(WRAPPED_U8);
    show_u8(WRAPPED_PRODUCT);
    show_i8(WRAPPED_DIVISION);
    show_i8(WRAPPED_NEGATION);
    show_i8(FORWARD_WRAPPED)
}
