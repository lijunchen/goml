fn std::ascii::is_ascii(value/0: uint8) -> bool {
  (value/0 <= 127)
}

fn std::ascii::is_uppercase(value/1: uint8) -> bool {
  if (value/1 >= 65) {
      (value/1 <= 90)
  } else {
      false
  }
}

fn std::ascii::is_lowercase(value/2: uint8) -> bool {
  if (value/2 >= 97) {
      (value/2 <= 122)
  } else {
      false
  }
}

fn std::ascii::is_alphabetic(value/3: uint8) -> bool {
  if std::ascii::is_uppercase(value/3) {
      true
  } else {
      std::ascii::is_lowercase(value/3)
  }
}

fn std::ascii::is_digit(value/4: uint8) -> bool {
  if (value/4 >= 48) {
      (value/4 <= 57)
  } else {
      false
  }
}

fn std::ascii::is_hexdigit(value/5: uint8) -> bool {
  if if std::ascii::is_digit(value/5) {
      true
  } else {
      if (value/5 >= 65) {
          (value/5 <= 70)
      } else {
          false
      }
  } {
      true
  } else {
      if (value/5 >= 97) {
          (value/5 <= 102)
      } else {
          false
      }
  }
}

fn std::ascii::is_alphanumeric(value/6: uint8) -> bool {
  if std::ascii::is_alphabetic(value/6) {
      true
  } else {
      std::ascii::is_digit(value/6)
  }
}

fn std::ascii::is_whitespace(value/7: uint8) -> bool {
  if if if if if trait_call[PartialEq::eq](value/7, 9) {
      true
  } else {
      trait_call[PartialEq::eq](value/7, 10)
  } {
      true
  } else {
      trait_call[PartialEq::eq](value/7, 11)
  } {
      true
  } else {
      trait_call[PartialEq::eq](value/7, 12)
  } {
      true
  } else {
      trait_call[PartialEq::eq](value/7, 13)
  } {
      true
  } else {
      trait_call[PartialEq::eq](value/7, 32)
  }
}

fn std::ascii::is_control(value/8: uint8) -> bool {
  if (value/8 <= 31) {
      true
  } else {
      trait_call[PartialEq::eq](value/8, 127)
  }
}

fn std::ascii::is_graphic(value/9: uint8) -> bool {
  if (value/9 >= 33) {
      (value/9 <= 126)
  } else {
      false
  }
}

fn std::ascii::is_punctuation(value/10: uint8) -> bool {
  if std::ascii::is_graphic(value/10) {
      (!std::ascii::is_alphanumeric(value/10))
  } else {
      false
  }
}

fn std::ascii::to_lowercase(value/11: uint8) -> uint8 {
  if std::ascii::is_uppercase(value/11) {
      {
        (value/11 + (97 - 65))
      }
  } else {
      {
        value/11
      }
  }
}

fn std::ascii::to_uppercase(value/12: uint8) -> uint8 {
  if std::ascii::is_lowercase(value/12) {
      {
        (value/12 - (97 - 65))
      }
  } else {
      {
        value/12
      }
  }
}

fn std::ascii::eq_ignore_case(left/13: uint8, right/14: uint8) -> bool {
  trait_call[PartialEq::eq](std::ascii::to_lowercase(left/13), std::ascii::to_lowercase(right/14))
