impl ToString for Key {
  fn to_string(self/0: Key) -> string {
      match (self/0 : Key) {
          Key::Empty => "Key::Empty",
          Key::Point(__field0/1: int32, __field1/2: int32) =>
            "Key::Point { " + "x: " + (int32::to_string : (int32) -> string)((__field0/1 : int32)) +
              ", " +
              "y: " +
              (int32::to_string : (int32) -> string)((__field1/2 : int32)) +
              " }",
      }
  }
}

impl Eq for Key {
  fn eq(self/3: Key, other/4: Key) -> bool {
      match ((self/3 : Key), (other/4 : Key)) {
          (Key::Empty, Key::Empty) => true,
          (
            Key::Point(__l1_0/5: int32, __l1_1/6: int32),
            Key::Point(__r1_0/7: int32, __r1_1/8: int32)
          ) =>
            true && (Eq::eq : (int32, int32) -> bool)((__l1_0/5 : int32), (__r1_0/7 : int32)) &&
              (Eq::eq : (int32, int32) -> bool)((__l1_1/6 : int32), (__r1_1/8 : int32)),
          _ : (Key, Key) => false,
      }
  }
}

impl Hash for Key {
  fn hash(self/9: Key) -> uint64 {
      match (self/9 : Key) {
          Key::Empty =>
            {
                let h/10: uint64 = 14695981039346656037 + 1;
                (h/10 : uint64)
            },
          Key::Point(__field1_0/11: int32, __field1_1/12: int32) =>
            {
                let h/13: uint64 = 14695981039346656037 + 2;
                let h/14: uint64 =
                  (h/13 : uint64) * 1099511628211 +
                    (Hash::hash : (int32) -> uint64)((__field1_0/11 : int32));
                let h/15: uint64 =
                  (h/14 : uint64) * 1099511628211 +
                    (Hash::hash : (int32) -> uint64)((__field1_1/12 : int32));
                (h/15 : uint64)
            },
      }
  }
}

fn score(value/16: Message[string]) -> int32 {
    match (value/16 : Message[string]) {
        Message::Quit => 0,
        Message::Write(_ : string) => 1,
        Message::Move(x/17: int32, vertical/18: int32, _ : string) =>
          (x/17 : int32) + (vertical/18 : int32),
    }
}

fn label(value/19: Message[string]) -> string {
    match (value/19 : Message[string]) {
        Message::Move(_ : int32, _ : int32, label/20: string) => (label/20 : string),
        Message::Write(text/21: string) => (text/21 : string),
        Message::Quit => "quit",
    }
}

fn main() -> unit {
    let x/22: int32 = 3;
    let direction/23: string = "north";
    let first/24: Message[string] = Message::Move((x/22 : int32), 4, (direction/23 : string));
    let second/25: Message[string] = Message::Move(3, 4, "north");
    (println : (int32) -> unit)((score : (Message[string]) -> int32)((first/24 : Message[string])));
    (println : (string) -> unit)(
      (label : (Message[string]) -> string)((second/25 : Message[string]))
    );
    (println : (string) -> unit)((ToString::to_string : (Key) -> string)(Key::Point(1, 2)));
    (println : (bool) -> unit)((Eq::eq : (Key, Key) -> bool)(Key::Point(1, 2), Key::Point(1, 2)));
}