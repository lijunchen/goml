fn record(log/0: Ref[string], label/1: string, value/2: int) -> int {
    (Ref[string]::set : (Ref[string], string) -> unit)(
      (log/0 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/0 : Ref[string])) + (label/1 : string)
    );
    (value/2 : int)
}

fn record_point(log/3: Ref[string], label/4: string, value/5: Point) -> Point {
    (Ref[string]::set : (Ref[string], string) -> unit)(
      (log/3 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/3 : Ref[string])) + (label/4 : string)
    );
    (value/5 : Point)
}

fn record_vec(log/6: Ref[string], label/7: string, value/8: Vec[int]) -> Vec[int] {
    (Ref[string]::set : (Ref[string], string) -> unit)(
      (log/6 : Ref[string]),
      (Ref[string]::get : (Ref[string]) -> string)((log/6 : Ref[string])) + (label/7 : string)
    );
    (value/8 : Vec[int])
}

fn main() -> unit {
    let mut number/9: int = 5;
    (number/9 : int) += 3;
    (number/9 : int) *= 2;
    (number/9 : int) >>= 1;
    (println : (string) -> unit)((int::to_string : (int) -> string)((number/9 : int)));
    let mut direct/10: Point = Point { x: 3, y: 4 };
    (direct/10 : Point).x += 5;
    (println : (string) -> unit)(
      "" + (int::to_string : (int) -> string)((direct/10 : Point).x) + "," +
        (int::to_string : (int) -> string)((direct/10 : Point).y)
    );
    let mut pair/11: (int, int) = (2, 9);
    (pair/11 : (int, int)).0 *= 3;
    (println : (string) -> unit)(
      "" + (int::to_string : (int) -> string)((pair/11 : (int, int)).0) + "," +
        (int::to_string : (int) -> string)((pair/11 : (int, int)).1)
    );
    let log/12: Ref[string] = (Ref[string]::new : (string) -> Ref[string])("");
    let base/13: Point = Point { x: 1, y: 2 };
    let updated/14: Point =
      {
          let struct_update_field/777/0: int =
            (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "F", 7);
          let struct_update_base/777: Point =
            (record_point : (Ref[string], string, Point) -> Point)(
              (log/12 : Ref[string]),
              "B",
              (base/13 : Point)
            );
          Point { x: (struct_update_field/777/0 : int), y: (struct_update_base/777 : Point).y }
      };
    (println : (string) -> unit)(
      (Ref[string]::get : (Ref[string]) -> string)((log/12 : Ref[string]))
    );
    (println : (string) -> unit)(
      "" + (int::to_string : (int) -> string)((updated/14 : Point).x) + "," +
        (int::to_string : (int) -> string)((updated/14 : Point).y)
    );
    (Ref[string]::set : (Ref[string], string) -> unit)((log/12 : Ref[string]), "");
    let values/15: Vec[int] =
      (@intrinsic(vec.from_array) : ([int; 2]) -> Vec[int])(
        [
          (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "A", 10),
          (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "B", 20)
        ]
      );
    (record_vec : (Ref[string], string, Vec[int]) -> Vec[int])(
      (log/12 : Ref[string]),
      "R",
      (values/15 : Vec[int])
    )[(record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "I", 1)] +=
      (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "V", 5);
    (println : (string) -> unit)(
      (Ref[string]::get : (Ref[string]) -> string)((log/12 : Ref[string]))
    );
    (println : (string) -> unit)(
      "" +
        (int::to_string : (int) -> string)(
          (Vec[int]::get : (Vec[int], int) -> int)((values/15 : Vec[int]), 0)
        ) +
        "," +
        (int::to_string : (int) -> string)(
          (Vec[int]::get : (Vec[int], int) -> int)((values/15 : Vec[int]), 1)
        )
    );
    (Ref[string]::set : (Ref[string], string) -> unit)((log/12 : Ref[string]), "");
    let table/16: HashMap[string, int] =
      (@intrinsic(hashmap.from_array) : ([(string, int); 3]) -> HashMap[string, int])(
        [
          (
            "" + "k" +
              (int::to_string : (int) -> string)(
                (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "K", 1)
              ),
            (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "V", 11)
          ),
          ("same", (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "A", 1)),
          ("same", (record : (Ref[string], string, int) -> int)((log/12 : Ref[string]), "B", 2))
        ]
      );
    (println : (string) -> unit)(
      (Ref[string]::get : (Ref[string]) -> string)((log/12 : Ref[string]))
    );
    (println : (string) -> unit)(
      match (HashMap[string, int]::get : (HashMap[string, int], string) -> Option[int])(
        (table/16 : HashMap[string, int]),
        "same"
      ) {
          Option::Some(value/17: int) => (int::to_string : (int) -> string)((value/17 : int)),
          Option::None => "missing",
      }
    );
    let empty_values/18: Vec[int] = (@intrinsic(vec.from_array) : ([int; 0]) -> Vec[int])([]);
    let empty_table/19: HashMap[string, int] =
      (@intrinsic(hashmap.from_array) : ([(string, int); 0]) -> HashMap[string, int])([]);
    (println : (string) -> unit)(
      "" + "empty=" +
        (int::to_string : (int) -> string)(
          (Vec[int]::len : (Vec[int]) -> int)((empty_values/18 : Vec[int])) +
            (HashMap[string, int]::len : (HashMap[string, int]) -> int)(
              (empty_table/19 : HashMap[string, int])
            )
        ) +
        " {ok}"
    );
}