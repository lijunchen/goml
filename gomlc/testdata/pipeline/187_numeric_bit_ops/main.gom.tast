fn show_u8(value/0: uint8) -> unit {
    (println : (uint8) -> unit)((value/0 : uint8))
}

fn show_u16(value/1: uint16) -> unit {
    (println : (uint16) -> unit)((value/1 : uint16))
}

fn show_u32(value/2: uint32) -> unit {
    (println : (uint32) -> unit)((value/2 : uint32))
}

fn show_u64(value/3: uint64) -> unit {
    (println : (uint64) -> unit)((value/3 : uint64))
}

fn show_i8(value/4: int8) -> unit {
    (println : (int8) -> unit)((value/4 : int8))
}

fn show_i16(value/5: int16) -> unit {
    (println : (int16) -> unit)((value/5 : int16))
}

fn show_i32(value/6: int32) -> unit {
    (println : (int32) -> unit)((value/6 : int32))
}

fn show_i64(value/7: int64) -> unit {
    (println : (int64) -> unit)((value/7 : int64))
}

fn unsigned_ops() -> unit {
    (show_u8 : (uint8) -> unit)(13 % 5);
    (show_u8 : (uint8) -> unit)(12 & 10);
    (show_u8 : (uint8) -> unit)(12 | 3);
    (show_u8 : (uint8) -> unit)(12 ^ 10);
    (show_u8 : (uint8) -> unit)(1 << 7);
    (show_u8 : (uint8) -> unit)(128 >> 7);
    (show_u8 : (uint8) -> unit)(~0);
    (show_u8 : (uint8) -> unit)(1 << 8);
    (show_u16 : (uint16) -> unit)(513 % 256);
    (show_u16 : (uint16) -> unit)(3855 & 255);
    (show_u16 : (uint16) -> unit)(3840 | 15);
    (show_u16 : (uint16) -> unit)(43690 ^ 3855);
    (show_u16 : (uint16) -> unit)(1 << 15);
    (show_u16 : (uint16) -> unit)(32768 >> 15);
    (show_u16 : (uint16) -> unit)(~0);
    (show_u32 : (uint32) -> unit)(1000000001 % 1000);
    (show_u32 : (uint32) -> unit)(4042322160 & 252645135);
    (show_u32 : (uint32) -> unit)(4042322160 | 252645135);
    (show_u32 : (uint32) -> unit)(4042322160 ^ 252645135);
    (show_u32 : (uint32) -> unit)(1 << 31);
    (show_u32 : (uint32) -> unit)(2147483648 >> 31);
    (show_u32 : (uint32) -> unit)(~0);
    (show_u64 : (uint64) -> unit)(1000000000001 % 1000);
    (show_u64 : (uint64) -> unit)(17361641481138401520 & 1085102592571150095);
    (show_u64 : (uint64) -> unit)(17361641481138401520 | 1085102592571150095);
    (show_u64 : (uint64) -> unit)(17361641481138401520 ^ 1085102592571150095);
    (show_u64 : (uint64) -> unit)(1 << 63);
    (show_u64 : (uint64) -> unit)(9223372036854775808 >> 63);
    (show_u64 : (uint64) -> unit)(~0)
}

fn signed_ops() -> unit {
    (show_i8 : (int8) -> unit)(-13 % 5);
    (show_i8 : (int8) -> unit)(-8 >> 2);
    (show_i8 : (int8) -> unit)(1 << 6);
    (show_i8 : (int8) -> unit)(~0);
    (show_i8 : (int8) -> unit)(-1 >> 7);
    (show_i16 : (int16) -> unit)(-513 % 256);
    (show_i16 : (int16) -> unit)(-32767 - 1 >> 15);
    (show_i16 : (int16) -> unit)(1 << 14);
    (show_i16 : (int16) -> unit)(~255);
    (show_i32 : (int32) -> unit)(-1000000001 % 1000);
    (show_i32 : (int32) -> unit)(-2147483647 - 1 >> 31);
    (show_i32 : (int32) -> unit)(1 << 30);
    (show_i32 : (int32) -> unit)(~65535);
    (show_i64 : (int64) -> unit)(-1000000000001 % 1000);
    (show_i64 : (int64) -> unit)(-9223372036854775807 >> 62);
    (show_i64 : (int64) -> unit)(1 << 62);
    (show_i64 : (int64) -> unit)(~4294967295)
}

fn precedence() -> unit {
    (show_u8 : (uint8) -> unit)(1 | 2 ^ 3 & 1);
    (show_u8 : (uint8) -> unit)(1 << 2 + 1);
    (println : (string) -> unit)((ToString::to_string : (bool) -> string)(1 | 2 == 3));
    (println : (string) -> unit)((ToString::to_string : (bool) -> string)(8 >> 1 < 5));
    (show_u8 : (uint8) -> unit)(~1 & 15)
}

fn casts() -> unit {
    let five_eleven/8: uint16 = 511;
    let two_fifty_six/9: uint16 = 256;
    let negative_one_i16/10: int16 = -1;
    let two_fifty_five/11: uint8 = 255;
    let one_twenty_eight/12: uint8 = 128;
    let negative_one_twenty_nine/13: int16 = -129;
    let max_u16/14: uint16 = 65535;
    let negative_one_i32/15: int32 = -1;
    let negative_one_i8/16: int8 = -1;
    let max_u64/17: uint64 = 18446744073709551615;
    let sixty_five/18: uint8 = 65;
    let max_u32/19: uint32 = 4294967295;
    let three_hundred/20: uint16 = 300;
    (show_u8 : (uint8) -> unit)((uint16::to_uint8 : (uint16) -> uint8)((five_eleven/8 : uint16)));
    (show_u8 : (uint8) -> unit)((uint16::to_uint8 : (uint16) -> uint8)((two_fifty_six/9 : uint16)));
    (show_u8 : (uint8) -> unit)(
      (int16::to_uint8 : (int16) -> uint8)((negative_one_i16/10 : int16))
    );
    (show_i8 : (int8) -> unit)((uint8::to_int8 : (uint8) -> int8)((two_fifty_five/11 : uint8)));
    (show_i8 : (int8) -> unit)((uint8::to_int8 : (uint8) -> int8)((one_twenty_eight/12 : uint8)));
    (show_i8 : (int8) -> unit)(
      (int16::to_int8 : (int16) -> int8)((negative_one_twenty_nine/13 : int16))
    );
    (show_i16 : (int16) -> unit)((uint16::to_int16 : (uint16) -> int16)((max_u16/14 : uint16)));
    (show_u16 : (uint16) -> unit)(
      (int32::to_uint16 : (int32) -> uint16)((negative_one_i32/15 : int32))
    );
    (show_u64 : (uint64) -> unit)(
      (int8::to_uint64 : (int8) -> uint64)((negative_one_i8/16 : int8))
    );
    (show_i32 : (int32) -> unit)((uint64::to_int32 : (uint64) -> int32)((max_u64/17 : uint64)));
    (show_u32 : (uint32) -> unit)((uint8::to_uint32 : (uint8) -> uint32)((sixty_five/18 : uint8)));
    (show_i64 : (int64) -> unit)((uint32::to_int64 : (uint32) -> int64)((max_u32/19 : uint32)));
    (show_u32 : (uint32) -> unit)((char::to_uint32 : (char) -> uint32)('A'));
    match (char_from_uint32 : (uint32) -> Option[char])(128512) {
        Option::Some(value/21: char) =>
          (println : (string) -> unit)((char::to_string : (char) -> string)((value/21 : char))),
        Option::None => (println : (string) -> unit)("invalid"),
    };
    (show_u32 : (uint32) -> unit)(
      (uint8::to_uint32 : (uint8) -> uint32)(
        (uint16::to_uint8 : (uint16) -> uint8)((three_hundred/20 : uint16))
      )
    )
}

fn contextual(value/22: uint8) -> uint8 {
    ~(value/22 : uint8) & 15 | 1 << 4 % 31
}

fn main() -> unit {
    (unsigned_ops : () -> unit)();
    (signed_ops : () -> unit)();
    (precedence : () -> unit)();
    (casts : () -> unit)();
    (show_u8 : (uint8) -> unit)((contextual : (uint8) -> uint8)(10))
}