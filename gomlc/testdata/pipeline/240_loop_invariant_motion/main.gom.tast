fn optimized(base/0: int, count/1: int) -> int {
    let mut index/2: int = 0;
    let mut result/3: int = 0;
    while (index/2 : int) < (count/1 : int) {
        {
            let square/4: int = (base/0 : int) * (base/0 : int);
            let scaled/5: int = (square/4 : int) * 17;
            let offset/6: int = (scaled/5 : int) + (base/0 : int);
            (result/3 : int) = (result/3 : int) + (offset/6 : int);
            (index/2 : int) = (index/2 : int) + 1;
        }
    };
    (result/3 : int)
}

fn guarded(divisor/7: int, count/8: int) -> int {
    let mut index/9: int = 0;
    let mut result/10: int = 0;
    while (index/9 : int) < (count/8 : int) {
        {
            let quotient/11: int = 100 / (divisor/7 : int);
            (result/10 : int) = (result/10 : int) + (quotient/11 : int);
            (index/9 : int) = (index/9 : int) + 1;
        }
    };
    (result/10 : int)
}

fn changing(count/12: int) -> int {
    let mut index/13: int = 0;
    let mut value/14: int = 1;
    let mut result/15: int = 0;
    while (index/13 : int) < (count/12 : int) {
        {
            let derived/16: int = (value/14 : int) + 1;
            (result/15 : int) = (result/15 : int) + (derived/16 : int);
            (value/14 : int) = (value/14 : int) + 1;
            (index/13 : int) = (index/13 : int) + 1;
        }
    };
    (result/15 : int)
}

fn main() -> unit {
    (println : (int) -> unit)((optimized : (int, int) -> int)(3, 4));
    (println : (int) -> unit)((guarded : (int, int) -> int)(0, 0));
    (println : (int) -> unit)((changing : (int) -> int)(3));
}