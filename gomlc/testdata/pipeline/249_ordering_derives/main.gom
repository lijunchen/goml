use std::cmp;

#[derive(PartialEq, Eq, PartialOrd, Ord, Debug)]
struct Version {
    major: int,
    minor: int,
}

#[derive(PartialEq, Eq, PartialOrd, Ord, Debug)]
enum Level {
    Low,
    Medium(int, int),
    High {
        rank: int,
        detail: int,
    },
}

#[derive(PartialEq, PartialOrd)]
struct MaybeNumber {
    value: float64,
}

#[derive(PartialEq, Eq, PartialOrd, Ord, Debug)]
struct GenericPair[T] {
    first: T,
    second: T,
    nested: Vec[T],
}

struct NoTraits {}

#[derive(PartialEq, Eq, PartialOrd, Ord)]
enum Phantom[T] {
    First,
    Second,
}

#[derive(PartialEq, PartialOrd)]
enum PartialLevel {
    Value(float64),
    Empty,
}

fn ordering_name(value: cmp::Ordering) -> string {
    match value {
        cmp::Ordering::Less => "less",
        cmp::Ordering::Equal => "equal",
        cmp::Ordering::Greater => "greater",
    }
}

fn main() -> unit {
    let first = Version { major: 1, minor: 9 };
    let second = Version { major: 2, minor: 0 };
    println((first < second).to_string());
    println(ordering_name(cmp::Ord::cmp(first, second)));
    println((Level::Low < Level::Medium(0, 0)).to_string());
    println((Level::Medium(1, 9) < Level::Medium(2, 0)).to_string());
    println(
        ordering_name(
            cmp::Ord::cmp(Level::High { rank: 3, detail: 1 }, Level::High { rank: 3, detail: 1 }),
        ),
    );
    let zero = 0.0;
    let nan = MaybeNumber { value: zero / zero };
    println((nan == nan).to_string());
    println(cmp::PartialOrd::partial_cmp(nan, nan).is_none().to_string());
    let generic_first = GenericPair { first: 1, second: 2, nested: Vec::[3] };
    let generic_second = GenericPair { first: 1, second: 3, nested: Vec::[0] };
    println((generic_first < generic_second).to_string());
    let phantom_first: Phantom[NoTraits] = Phantom::First;
    let phantom_second: Phantom[NoTraits] = Phantom::Second;
    println((phantom_first < phantom_second).to_string());
    let partial_nan = PartialLevel::Value(zero / zero);
    println(cmp::PartialOrd::partial_cmp(partial_nan, partial_nan).is_none().to_string());
    let first_values: Vec[int] = Vec::[1, 2];
    let second_values: Vec[int] = Vec::[1, 3];
    println((first_values < second_values).to_string());
    println((Option::Some(2) < Option::Some(3)).to_string());
    let ok: Result[int, string] = Result::Ok(1);
    let error: Result[int, string] = Result::Err("error");
    println((ok < error).to_string());
    println((first_values.slice(0, 2) < second_values.slice(0, 2)).to_string());
    let values: HashMap[Vec[int], string] = HashMap::new();
    values.set(first_values, "vector");
    println(values.get(Vec::[1, 2]).unwrap_or("missing"));
    let default_tuple: (int, string) = Default::default();
    println((default_tuple == (0, "")).to_string());
    let default_array: [int; 3] = Default::default();
    println((default_array == [0, 0, 0]).to_string());
    println(((1, 2) < (1, 3)).to_string());
    println(ordering_name(cmp::Ord::cmp([1, 2], [1, 3])));
    let tuple_nan = (0.0, zero / zero);
    println(cmp::PartialOrd::partial_cmp(tuple_nan, tuple_nan).is_none().to_string());
    let tuple_values: HashMap[(int, string), string] = HashMap::new();
    tuple_values.set((1, "one"), "tuple");
    println(tuple_values.get((1, "one")).unwrap_or("missing"));
    let array_values: HashMap[[int; 2], string] = HashMap::new();
    array_values.set([1, 2], "array");
    println(array_values.get([1, 2]).unwrap_or("missing"))
}
