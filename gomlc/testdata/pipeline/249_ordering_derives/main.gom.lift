      trait_impl#Hash#int#hash(@intrinsic(array.get)(self, 1))) in
  _structural_hash_2
}

fn trait_impl#Hash#int#hash(self/127: int) -> uint64 {
  @runtime(core.int_hash)(self/127)
}

fn trait_impl#Hash#string#hash(self/125: string) -> uint64 {
  @runtime(core.string_hash)(self/125)
