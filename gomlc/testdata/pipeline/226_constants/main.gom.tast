const BASE: int = 16;
const ANSWER: int = ((BASE * 2) + 10);
const MASK: uint8 = 240;
const GREETING: string = ("constant" + " value");
const ENABLED: bool = true;

fn main() -> unit {
    (println : (string) -> unit)((int::to_string : (int) -> string)((ANSWER : int)));
    (println : (string) -> unit)((ToString::to_string : (uint8) -> string)((MASK : uint8)));
    (println : (string) -> unit)((GREETING : string));
    (println : (string) -> unit)((ToString::to_string : (bool) -> string)((ENABLED : bool)))
}