const base: int = 0x10;
const answer: int = base * 2 + 10;
const mask: byte = b'\xF0';
const greeting: string = "constant" + " value";
const enabled: bool = true;

fn main() -> unit {
    string_println(answer.to_string());
    string_println(mask.to_string());
    string_println(greeting);
    string_println(enabled.to_string())
}
