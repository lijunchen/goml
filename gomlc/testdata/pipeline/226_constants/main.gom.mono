const base: int = 16;
const answer: int = ((base * 2) + 10);
const mask: uint8 = 240;
const greeting: string = ("constant" + " value");
const enabled: bool = true;

fn main() -> unit {
  let _wild152 = @runtime(core.string_println)(inherent#int#int#to_string(answer)) in
  let _wild153 = @runtime(core.string_println)(trait_impl#ToString#uint8#to_string(mask)) in
  let _wild154 = @runtime(core.string_println)(greeting) in
  @runtime(core.string_println)(trait_impl#ToString#bool#to_string(enabled))
}

fn inherent#int#int#to_string(self/5: int) -> string {
  @runtime(core.int_to_string)(self/5)
}

fn trait_impl#ToString#uint8#to_string(self/45: uint8) -> string {
  @runtime(core.uint8_to_string)(self/45)
}

fn trait_impl#ToString#bool#to_string(self/37: bool) -> string {
  @runtime(core.bool_to_string)(self/37)
}