fn test_int_comparisons() -> unit {
  let a/0 = 10 in
  let b/1 = 20 in
  let c/2 = 10 in
  let less/3 = (a/0 < b/1) in
  let mtmp172 = println__T_string(("10 < 20: " + trait_impl#ToString#bool#to_string(less/3))) in
  let greater/4 = (b/1 > a/0) in
  let mtmp173 = println__T_string(("20 > 10: " + trait_impl#ToString#bool#to_string(greater/4))) in
  let less_eq1/5 = (a/0 <= b/1) in
  let mtmp174 =
    println__T_string(("10 <= 20: " + trait_impl#ToString#bool#to_string(less_eq1/5))) in
  let less_eq2/6 = (a/0 <= c/2) in
  let mtmp175 =
    println__T_string(("10 <= 10: " + trait_impl#ToString#bool#to_string(less_eq2/6))) in
  let greater_eq1/7 = (b/1 >= a/0) in
  let mtmp176 =
    println__T_string(("20 >= 10: " + trait_impl#ToString#bool#to_string(greater_eq1/7))) in
  let greater_eq2/8 = (c/2 >= a/0) in
  let mtmp177 =
    println__T_string(("10 >= 10: " + trait_impl#ToString#bool#to_string(greater_eq2/8))) in
  let eq1/9 = (a/0 == c/2) in
  let mtmp178 = println__T_string(("10 == 10: " + trait_impl#ToString#bool#to_string(eq1/9))) in
  let eq2/10 = (a/0 == b/1) in
  let mtmp179 = println__T_string(("10 == 20: " + trait_impl#ToString#bool#to_string(eq2/10))) in
  let neq1/11 = (a/0 != b/1) in
  let mtmp180 = println__T_string(("10 != 20: " + trait_impl#ToString#bool#to_string(neq1/11))) in
  let neq2/12 = (a/0 != c/2) in
  let mtmp181 = println__T_string(("10 != 10: " + trait_impl#ToString#bool#to_string(neq2/12))) in
  ()
}

fn test_float_comparisons() -> unit {
  let x/13 = 3.14 in
  let y/14 = 2.71 in
  let z/15 = 3.14 in
  let less/16 = (y/14 < x/13) in
  let mtmp182 =
    println__T_string(("2.71 < 3.14: " + trait_impl#ToString#bool#to_string(less/16))) in
  let greater/17 = (x/13 > y/14) in
  let mtmp183 =
    println__T_string(("3.14 > 2.71: " + trait_impl#ToString#bool#to_string(greater/17))) in
  let less_eq1/18 = (y/14 <= x/13) in
  let mtmp184 =
    println__T_string(("2.71 <= 3.14: " + trait_impl#ToString#bool#to_string(less_eq1/18))) in
  let less_eq2/19 = (x/13 <= z/15) in
  let mtmp185 =
    println__T_string(("3.14 <= 3.14: " + trait_impl#ToString#bool#to_string(less_eq2/19))) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let mtmp186 =
    println__T_string(("3.14 >= 2.71: " + trait_impl#ToString#bool#to_string(greater_eq1/20))) in
  let greater_eq2/21 = (z/15 >= x/13) in
  let mtmp187 =
    println__T_string(("3.14 >= 3.14: " + trait_impl#ToString#bool#to_string(greater_eq2/21))) in
  let eq1/22 = (x/13 == z/15) in
  let mtmp188 =
    println__T_string(("3.14 == 3.14: " + trait_impl#ToString#bool#to_string(eq1/22))) in
  let eq2/23 = (x/13 == y/14) in
  let mtmp189 =
    println__T_string(("3.14 == 2.71: " + trait_impl#ToString#bool#to_string(eq2/23))) in
  let neq1/24 = (x/13 != y/14) in
  let mtmp190 =
    println__T_string(("3.14 != 2.71: " + trait_impl#ToString#bool#to_string(neq1/24))) in
  let neq2/25 = (x/13 != z/15) in
  let mtmp191 =
    println__T_string(("3.14 != 3.14: " + trait_impl#ToString#bool#to_string(neq2/25))) in
  ()
}

fn main() -> unit {
  let mtmp192 = println__T_string("=== Integer Comparisons ===") in
  let mtmp193 = test_int_comparisons() in
  let mtmp194 = println__T_string("") in
  let mtmp195 = println__T_string("=== Float Comparisons ===") in
  let mtmp196 = test_float_comparisons() in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#bool#to_string(self/64: bool) -> string {
  @runtime(core.bool_to_string)(self/64)
}

fn trait_impl#ToString#string#to_string(self/65: string) -> string {
  self/65
}