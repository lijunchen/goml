fn test_int_comparisons() -> unit {
  let a/0 = 10 in
  let b/1 = 20 in
  let c/2 = 10 in
  let less/3 = (a/0 < b/1) in
  let mtmp108 = println__T_string(("10 < 20: " + trait_impl#ToString#bool#to_string(less/3))) in
  let greater/4 = (b/1 > a/0) in
  let mtmp109 = println__T_string(("20 > 10: " + trait_impl#ToString#bool#to_string(greater/4))) in
  let less_eq1/5 = (a/0 <= b/1) in
  let mtmp110 = println__T_string(("10 <= 20: " + trait_impl#ToString#bool#to_string(less_eq1/5))) in
  let less_eq2/6 = (a/0 <= c/2) in
  let mtmp111 = println__T_string(("10 <= 10: " + trait_impl#ToString#bool#to_string(less_eq2/6))) in
  let greater_eq1/7 = (b/1 >= a/0) in
  let mtmp112 = println__T_string(("20 >= 10: " + trait_impl#ToString#bool#to_string(greater_eq1/7))) in
  let greater_eq2/8 = (c/2 >= a/0) in
  let mtmp113 = println__T_string(("10 >= 10: " + trait_impl#ToString#bool#to_string(greater_eq2/8))) in
  let eq1/9 = trait_impl#Eq#int32#eq(a/0, c/2) in
  let mtmp114 = println__T_string(("10 == 10: " + trait_impl#ToString#bool#to_string(eq1/9))) in
  let eq2/10 = trait_impl#Eq#int32#eq(a/0, b/1) in
  let mtmp115 = println__T_string(("10 == 20: " + trait_impl#ToString#bool#to_string(eq2/10))) in
  let neq1/11 = (!trait_impl#Eq#int32#eq(a/0, b/1)) in
  let mtmp116 = println__T_string(("10 != 20: " + trait_impl#ToString#bool#to_string(neq1/11))) in
  let neq2/12 = (!trait_impl#Eq#int32#eq(a/0, c/2)) in
  let mtmp117 = println__T_string(("10 != 10: " + trait_impl#ToString#bool#to_string(neq2/12))) in
  ()
}

fn test_float_comparisons() -> unit {
  let x/13 = 3.14 in
  let y/14 = 2.71 in
  let z/15 = 3.14 in
  let less/16 = (y/14 < x/13) in
  let mtmp118 = println__T_string(("2.71 < 3.14: " + trait_impl#ToString#bool#to_string(less/16))) in
  let greater/17 = (x/13 > y/14) in
  let mtmp119 = println__T_string(("3.14 > 2.71: " + trait_impl#ToString#bool#to_string(greater/17))) in
  let less_eq1/18 = (y/14 <= x/13) in
  let mtmp120 = println__T_string(("2.71 <= 3.14: " + trait_impl#ToString#bool#to_string(less_eq1/18))) in
  let less_eq2/19 = (x/13 <= z/15) in
  let mtmp121 = println__T_string(("3.14 <= 3.14: " + trait_impl#ToString#bool#to_string(less_eq2/19))) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let mtmp122 = println__T_string(("3.14 >= 2.71: " + trait_impl#ToString#bool#to_string(greater_eq1/20))) in
  let greater_eq2/21 = (z/15 >= x/13) in
  let mtmp123 = println__T_string(("3.14 >= 3.14: " + trait_impl#ToString#bool#to_string(greater_eq2/21))) in
  let eq1/22 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let mtmp124 = println__T_string(("3.14 == 3.14: " + trait_impl#ToString#bool#to_string(eq1/22))) in
  let eq2/23 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let mtmp125 = println__T_string(("3.14 == 2.71: " + trait_impl#ToString#bool#to_string(eq2/23))) in
  let neq1/24 = (!trait_impl#Eq#float64#eq(x/13, y/14)) in
  let mtmp126 = println__T_string(("3.14 != 2.71: " + trait_impl#ToString#bool#to_string(neq1/24))) in
  let neq2/25 = (!trait_impl#Eq#float64#eq(x/13, z/15)) in
  let mtmp127 = println__T_string(("3.14 != 3.14: " + trait_impl#ToString#bool#to_string(neq2/25))) in
  ()
}

fn main() -> unit {
  let mtmp128 = println__T_string("=== Integer Comparisons ===") in
  let mtmp129 = test_int_comparisons() in
  let mtmp130 = println__T_string("") in
  let mtmp131 = println__T_string("=== Float Comparisons ===") in
  let mtmp132 = test_float_comparisons() in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#bool#to_string(self/37: bool) -> string {
  @runtime(core.bool_to_string)(self/37)
}

fn trait_impl#Eq#int32#eq(self/65: int32, other/66: int32) -> bool {
  @intrinsic(eq.primitive)(self/65, other/66)
}

fn trait_impl#Eq#float64#eq(self/79: float64, other/80: float64) -> bool {
  @intrinsic(eq.primitive)(self/79, other/80)
}

fn trait_impl#ToString#string#to_string(self/38: string) -> string {
  self/38
}