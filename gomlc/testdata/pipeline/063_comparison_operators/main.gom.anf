  let less_eq1/18 = (y/14 <= x/13) in
  let t161 = trait_impl#ToString#bool#to_string(less_eq1/18) in
  let t162 = ("2.71 <= 3.14: " + t161) in
  let mtmp120 = println__T_string(t162) in
  let less_eq2/19 = (x/13 <= z/15) in
  let t163 = trait_impl#ToString#bool#to_string(less_eq2/19) in
  let t164 = ("3.14 <= 3.14: " + t163) in
  let mtmp121 = println__T_string(t164) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let t165 = trait_impl#ToString#bool#to_string(greater_eq1/20) in
  let t166 = ("3.14 >= 2.71: " + t165) in
  let mtmp122 = println__T_string(t166) in
  let greater_eq2/21 = (z/15 >= x/13) in
  let t167 = trait_impl#ToString#bool#to_string(greater_eq2/21) in
  let t168 = ("3.14 >= 3.14: " + t167) in
  let mtmp123 = println__T_string(t168) in
  let eq1/22 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let t169 = trait_impl#ToString#bool#to_string(eq1/22) in
  let t170 = ("3.14 == 3.14: " + t169) in
  let mtmp124 = println__T_string(t170) in
  let eq2/23 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let t171 = trait_impl#ToString#bool#to_string(eq2/23) in
  let t172 = ("3.14 == 2.71: " + t171) in
  let mtmp125 = println__T_string(t172) in
  let t173 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let neq1/24 = (!t173) in
  let t174 = trait_impl#ToString#bool#to_string(neq1/24) in
  let t175 = ("3.14 != 2.71: " + t174) in
  let mtmp126 = println__T_string(t175) in
  let t176 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let neq2/25 = (!t176) in
  let t177 = trait_impl#ToString#bool#to_string(neq2/25) in
  let t178 = ("3.14 != 3.14: " + t177) in
  let mtmp127 = println__T_string(t178) in
  jump ret156()
}

