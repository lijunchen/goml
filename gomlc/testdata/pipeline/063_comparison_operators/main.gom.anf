  let t199 = ("10 != 20: " + t198) in
  let mtmp163 = println__T_string(t199) in
  let t200 = trait_impl#Eq#int32#eq(a/0, c/2) in
  let neq2/12 = (!t200) in
  let t201 = trait_impl#ToString#bool#to_string(neq2/12) in
  let t202 = ("10 != 10: " + t201) in
  let mtmp164 = println__T_string(t202) in
  ()
}

fn test_float_comparisons() -> unit {
  let x/13 = 3.14 in
  let y/14 = 2.71 in
  let z/15 = 3.14 in
  let less/16 = (y/14 < x/13) in
  let t204 = trait_impl#ToString#bool#to_string(less/16) in
  let t205 = ("2.71 < 3.14: " + t204) in
  let mtmp165 = println__T_string(t205) in
  let greater/17 = (x/13 > y/14) in
  let t206 = trait_impl#ToString#bool#to_string(greater/17) in
  let t207 = ("3.14 > 2.71: " + t206) in
  let mtmp166 = println__T_string(t207) in
  let less_eq1/18 = (y/14 <= x/13) in
  let t208 = trait_impl#ToString#bool#to_string(less_eq1/18) in
  let t209 = ("2.71 <= 3.14: " + t208) in
  let mtmp167 = println__T_string(t209) in
  let less_eq2/19 = (x/13 <= z/15) in
  let t210 = trait_impl#ToString#bool#to_string(less_eq2/19) in
  let t211 = ("3.14 <= 3.14: " + t210) in
  let mtmp168 = println__T_string(t211) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let t212 = trait_impl#ToString#bool#to_string(greater_eq1/20) in
  let t213 = ("3.14 >= 2.71: " + t212) in
  let mtmp169 = println__T_string(t213) in
  let greater_eq2/21 = (z/15 >= x/13) in
  let t214 = trait_impl#ToString#bool#to_string(greater_eq2/21) in
  let t215 = ("3.14 >= 3.14: " + t214) in
  let mtmp170 = println__T_string(t215) in
  let eq1/22 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let t216 = trait_impl#ToString#bool#to_string(eq1/22) in
  let t217 = ("3.14 == 3.14: " + t216) in
  let mtmp171 = println__T_string(t217) in
  let eq2/23 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let t218 = trait_impl#ToString#bool#to_string(eq2/23) in
  let t219 = ("3.14 == 2.71: " + t218) in
  let mtmp172 = println__T_string(t219) in
  let t220 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let neq1/24 = (!t220) in
  let t221 = trait_impl#ToString#bool#to_string(neq1/24) in
  let t222 = ("3.14 != 2.71: " + t221) in
  let mtmp173 = println__T_string(t222) in
  let t223 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let neq2/25 = (!t223) in
  let t224 = trait_impl#ToString#bool#to_string(neq2/25) in
  let t225 = ("3.14 != 3.14: " + t224) in
  let mtmp174 = println__T_string(t225) in
  ()
}

fn main() -> unit {
  let mtmp175 = println__T_string("=== Integer Comparisons ===") in
  let mtmp176 = test_int_comparisons() in
  let mtmp177 = println__T_string("") in
  let mtmp178 = println__T_string("=== Float Comparisons ===") in
  let mtmp179 = test_float_comparisons() in
  ()
}

