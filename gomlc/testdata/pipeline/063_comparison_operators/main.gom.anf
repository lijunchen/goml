  let t154 = trait_impl#ToString#bool#to_string(neq2/12) in
  let t155 = ("10 != 10: " + t154) in
  let mtmp117 = println__T_string(t155) in
  jump ret133()
}

fn test_float_comparisons() -> unit {
  join ret156() -> unit {
    ()
  } in
  let x/13 = 3.14 in
  let y/14 = 2.71 in
  let z/15 = 3.14 in
  let less/16 = (y/14 < x/13) in
  let t157 = trait_impl#ToString#bool#to_string(less/16) in
  let t158 = ("2.71 < 3.14: " + t157) in
