  let t144 = trait_impl#ToString#bool#to_string(greater_eq2/8) in
  let t145 = ("10 >= 10: " + t144) in
  let mtmp113 = println__T_string(t145) in
  let eq1/9 = trait_impl#Eq#int32#eq(a/0, c/2) in
  let t146 = trait_impl#ToString#bool#to_string(eq1/9) in
  let t147 = ("10 == 10: " + t146) in
  let mtmp114 = println__T_string(t147) in
  let eq2/10 = trait_impl#Eq#int32#eq(a/0, b/1) in
