  let t207 = trait_impl#ToString#bool#to_string(less_eq2/19) in
  let t208 = ("3.14 <= 3.14: " + t207) in
  let mtmp165 = println__T_string(t208) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let t209 = trait_impl#ToString#bool#to_string(greater_eq1/20) in
  let t210 = ("3.14 >= 2.71: " + t209) in
