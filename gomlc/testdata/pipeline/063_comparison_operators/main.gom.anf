  let greater/4 = (b/1 > a/0) in
  let t183 = trait_impl#ToString#bool#to_string(greater/4) in
  let t184 = ("20 > 10: " + t183) in
  let mtmp156 = println__T_string(t184) in
  let less_eq1/5 = (a/0 <= b/1) in
  let t185 = trait_impl#ToString#bool#to_string(less_eq1/5) in
  let t186 = ("10 <= 20: " + t185) in
  let mtmp157 = println__T_string(t186) in
  let less_eq2/6 = (a/0 <= c/2) in
  let t187 = trait_impl#ToString#bool#to_string(less_eq2/6) in
  let t188 = ("10 <= 10: " + t187) in
  let mtmp158 = println__T_string(t188) in
  let greater_eq1/7 = (b/1 >= a/0) in
  let t189 = trait_impl#ToString#bool#to_string(greater_eq1/7) in
  let t190 = ("20 >= 10: " + t189) in
  let mtmp159 = println__T_string(t190) in
  let greater_eq2/8 = (c/2 >= a/0) in
  let t191 = trait_impl#ToString#bool#to_string(greater_eq2/8) in
  let t192 = ("10 >= 10: " + t191) in
  let mtmp160 = println__T_string(t192) in
  let eq1/9 = trait_impl#Eq#int32#eq(a/0, c/2) in
  let t193 = trait_impl#ToString#bool#to_string(eq1/9) in
  let t194 = ("10 == 10: " + t193) in
  let mtmp161 = println__T_string(t194) in
  let eq2/10 = trait_impl#Eq#int32#eq(a/0, b/1) in
  let t195 = trait_impl#ToString#bool#to_string(eq2/10) in
  let t196 = ("10 == 20: " + t195) in
  let mtmp162 = println__T_string(t196) in
  let t197 = trait_impl#Eq#int32#eq(a/0, b/1) in
  let neq1/11 = (!t197) in
