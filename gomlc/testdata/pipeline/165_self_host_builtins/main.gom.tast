fn show_unit(result/0: Result[(), string]) -> string {
    match (result/0 : Result[(), string]) {
        Result::Ok(_ : ()) => "ok",
        Result::Err(err/1: string) => "err " + (err/1 : string),
    }
}

fn show_string(result/2: Result[string, string]) -> string {
    match (result/2 : Result[string, string]) {
        Result::Ok(value/3: string) => (value/3 : string),
        Result::Err(err/4: string) => "err " + (err/4 : string),
    }
}

fn main() -> () {
    (std::io::println : (string) -> ())(
      (string_byte_slice : (string, isize, isize) -> string)("a你好z", 1, 7)
    );
    (std::io::eprint : (string) -> ())("");
    (std::io::eprintln : (string) -> ())("");
    (std::io::println : (string) -> ())(
      (show_unit : (Result[(), string]) -> string)(
        (std::fs::create_dir_all : (string) -> Result[(), string])("goml-self-host/nested")
      )
    );
    (std::io::println : (string) -> ())(
      (show_unit : (Result[(), string]) -> string)(
        (std::fs::write_file : (string, string) -> Result[(), string])(
          "goml-self-host/nested/output.txt",
          "boot"
        )
      )
    );
    (std::io::println : (string) -> ())(
      (show_string : (Result[string, string]) -> string)(
        (std::fs::read_file : (string) -> Result[string, string])(
          "goml-self-host/nested/output.txt"
        )
      )
    )
}