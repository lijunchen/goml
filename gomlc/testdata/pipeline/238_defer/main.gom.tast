fn loop_cleanup() -> unit {
    let index/2: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while (Ref[int]::get : (Ref[int]) -> int)((index/2 : Ref[int])) < 3 {
        {
            let current/3: int = (Ref[int]::get : (Ref[int]) -> int)((index/2 : Ref[int]));
            defer (println : (string) -> unit)("loop:" + (int::to_string : (int) -> string)((current/3 : int)));
            (Ref[int]::set : (Ref[int], int) -> unit)((index/2 : Ref[int]), (current/3 : int) + 1);
            if (current/3 : int) == 0 {
                {
                    continue;
                }
            } else {
                if (current/3 : int) == 1 {
                    {
                        break;
                    }
                } else {
                    {
                        ()
                    }
                }
