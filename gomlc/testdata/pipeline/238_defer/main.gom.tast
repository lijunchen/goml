}

fn observed_at_exit() -> unit {
    let value/4: Ref[string] = (Ref[string]::new : (string) -> Ref[string])("before");
    defer (println : (string) -> unit)("observed:" + (Ref[string]::get : (Ref[string]) -> string)((value/4 : Ref[string])));
    (Ref[string]::set : (Ref[string], string) -> unit)((value/4 : Ref[string]), "after")
}

fn pattern_cleanup(value/5: Option[int]) -> int {
    defer (println : (string) -> unit)("pattern:cleanup");
    let Option::Some(number/6: int) = (value/5 : Option[int]) else {
        return 0;
    };
    let (left/7: int, right/8: int) = ((number/6 : int), 2);
    (left/7 : int) + (right/8 : int)
}

fn closure_cleanup() -> unit {
    defer (println : (string) -> unit)("closure:outer");
    let run/9: () -> unit = || => {
        defer (println : (string) -> unit)("closure:inner");
        (println : (string) -> unit)("closure:body")
    };
    (run/9 : () -> unit)();
    (println : (string) -> unit)("closure:after")
}

fn main() -> unit {
    defer (println : (string) -> unit)("main:first");
    defer (println : (string) -> unit)("main:second");
    {
        defer (println : (string) -> unit)("block");
        (println : (string) -> unit)("body")
    };
    (println : (string) -> unit)((int::to_string : (int) -> string)((early_return : () -> int)()));
    let _ : Option[int] = (maybe : (Option[int]) -> Option[int])(Option::None);
    (loop_cleanup : () -> unit)();
    (observed_at_exit : () -> unit)();
    (println : (string) -> unit)((int::to_string : (int) -> string)((pattern_cleanup : (Option[int]) -> int)(Option::Some(3))));
    (println : (string) -> unit)((int::to_string : (int) -> string)((pattern_cleanup : (Option[int]) -> int)(Option::None)));
    (closure_cleanup : () -> unit)()
}