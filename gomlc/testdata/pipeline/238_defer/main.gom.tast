fn early_return() -> isize {
    defer (println : (string) -> unit)("return:outer");
    {
        defer (println : (string) -> unit)("return:inner");
        return 7;
    };
    0
}

fn maybe(value/0: Option[isize]) -> Option[isize] {
    defer (println : (string) -> unit)("try:cleanup");
    let number/1: isize =
      match (value/0 : Option[isize]) {
          Option::Some(try_value/15: isize) => (try_value/15 : isize),
          Option::None => return Option::None,
      };
    Option::Some((number/1 : isize))
}

fn loop_cleanup() -> unit {
    let index/2: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((index/2 : Ref[isize])) < 3 {
        {
            let current/3: isize =
              (Ref[isize]::get : (Ref[isize]) -> isize)((index/2 : Ref[isize]));
            defer
              (println : (string) -> unit)(
                "loop:" + (isize::to_string : (isize) -> string)((current/3 : isize))
              );
            (Ref[isize]::set : (Ref[isize], isize) -> unit)(
              (index/2 : Ref[isize]),
              (current/3 : isize) + 1
            );
            if (current/3 : isize) == 0 {
                {
                    continue;
                }
            } else {
                if (current/3 : isize) == 1 {
                    {
                        break;
                    }
                } else {
                    {}
                }
            }
        }
    }
}

fn observed_at_exit() -> unit {
    let value/4: Ref[string] = (Ref[string]::new : (string) -> Ref[string])("before");
    defer
      (println : (string) -> unit)(
        "observed:" + (Ref[string]::get : (Ref[string]) -> string)((value/4 : Ref[string]))
      );
    (Ref[string]::set : (Ref[string], string) -> unit)((value/4 : Ref[string]), "after")
}

fn pattern_cleanup(value/5: Option[isize]) -> isize {
    defer (println : (string) -> unit)("pattern:cleanup");
    let Option::Some(number/6: isize) =
      (value/5 : Option[isize]) else
      {
          return 0;
      };
    let (left/7: isize, right/8: isize) = ((number/6 : isize), 2);
    (left/7 : isize) + (right/8 : isize)
}

fn closure_cleanup() -> unit {
    defer (println : (string) -> unit)("closure:outer");
    let run/9: () -> unit =
      || =>
        {
            defer (println : (string) -> unit)("closure:inner");
            (println : (string) -> unit)("closure:body")
        };
    (run/9 : () -> unit)();
    (println : (string) -> unit)("closure:after")
}

fn main() -> unit {
    defer (println : (string) -> unit)("main:first");
    defer (println : (string) -> unit)("main:second");
    {
        defer (println : (string) -> unit)("block");
        (println : (string) -> unit)("body")
    };
    (println : (string) -> unit)(
      (isize::to_string : (isize) -> string)((early_return : () -> isize)())
    );
    let _ : Option[isize] = (maybe : (Option[isize]) -> Option[isize])(Option::None);
    (loop_cleanup : () -> unit)();
    (observed_at_exit : () -> unit)();
    (println : (string) -> unit)(
      (isize::to_string : (isize) -> string)(
        (pattern_cleanup : (Option[isize]) -> isize)(Option::Some(3))
      )
    );
    (println : (string) -> unit)(
      (isize::to_string : (isize) -> string)(
        (pattern_cleanup : (Option[isize]) -> isize)(Option::None)
      )
    );
    (closure_cleanup : () -> unit)()
}