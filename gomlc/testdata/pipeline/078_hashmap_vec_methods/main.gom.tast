impl Hash for Key {
  fn hash(self/0: Key) -> uint64 {
      match (self/0 : Key) {
          Key::A =>
            {
                let h/1: uint64 = 0 as uint64 + 14695981039346656037 + 1;
                (h/1 : uint64)
            },
          Key::B(#derive0_field/2: int32) =>
            {
                let h/3: uint64 = 0 as uint64 + 14695981039346656037 + 2;
                let h/4: uint64 =
                  (h/3 : uint64) * 0 as uint64 + 1099511628211 +
                    (Hash::hash : (int32) -> uint64)((#derive0_field/2 : int32));
                (h/4 : uint64)
            },
      }
  }
}

impl PartialEq for Key {
  fn eq(self/5: Key, other/6: Key) -> bool {
      match ((self/5 : Key), (other/6 : Key)) {
          (Key::A, Key::A) => true,
          (Key::B(#derive0_left/7: int32), Key::B(#derive1_right/8: int32)) =>
            true &&
              (PartialEq::eq : (int32, int32) -> bool)(
                (#derive0_left/7 : int32),
                (#derive1_right/8 : int32)
              ),
          _ : (Key, Key) => false,
      }
  }
}

impl Eq for Key where int32: Eq, int32: PartialEq {}

fn print_opt_int(x/9: Option[int32]) -> unit {
    match (x/9 : Option[int32]) {
        Option::Some(v/10: int32) => (println : (int32) -> unit)((v/10 : int32)),
        Option::None => (println : (string) -> unit)("none"),
    }
}

fn main() -> unit {
    let v/11: Vec[int] = (Vec[int]::new : () -> Vec[int])();
    (Vec[int]::push : (Vec[int], int) -> unit)((v/11 : Vec[int]), 10);
    (Vec[int]::push : (Vec[int], int) -> unit)((v/11 : Vec[int]), 20);
    (Vec[int]::push : (Vec[int], int) -> unit)((v/11 : Vec[int]), 30);
    (println : (int) -> unit)((Vec[int]::get : (Vec[int], int) -> int)((v/11 : Vec[int]), 0));
    (println : (int) -> unit)((Vec[int]::get : (Vec[int], int) -> int)((v/11 : Vec[int]), 1));
    (println : (int) -> unit)((Vec[int]::get : (Vec[int], int) -> int)((v/11 : Vec[int]), 2));
    (println : (int) -> unit)((Vec[int]::len : (Vec[int]) -> int)((v/11 : Vec[int])));
    let m/12: HashMap[Key, int32] = (HashMap[Key, int32]::new : () -> HashMap[Key, int32])();
    (HashMap[Key, int32]::set : (HashMap[Key, int32], Key, int32) -> unit)(
      (m/12 : HashMap[Key, int32]),
      Key::A,
      10
    );
    (HashMap[Key, int32]::set : (HashMap[Key, int32], Key, int32) -> unit)(
      (m/12 : HashMap[Key, int32]),
      Key::B(1),
      20
    );
    (println : (int) -> unit)(
      (HashMap[Key, int32]::len : (HashMap[Key, int32]) -> int)((m/12 : HashMap[Key, int32]))
    );
    (print_opt_int : (Option[int32]) -> unit)(
      (HashMap[Key, int32]::get : (HashMap[Key, int32], Key) -> Option[int32])(
        (m/12 : HashMap[Key, int32]),
        Key::A
      )
    );
    (println : (bool) -> unit)(
      (HashMap[Key, int32]::contains : (HashMap[Key, int32], Key) -> bool)(
        (m/12 : HashMap[Key, int32]),
        Key::B(1)
      )
    );
    (HashMap[Key, int32]::remove : (HashMap[Key, int32], Key) -> unit)(
      (m/12 : HashMap[Key, int32]),
      Key::B(1)
    );
    (println : (bool) -> unit)(
      (HashMap[Key, int32]::contains : (HashMap[Key, int32], Key) -> bool)(
        (m/12 : HashMap[Key, int32]),
        Key::B(1)
      )
    );
    (println : (int) -> unit)(
      (HashMap[Key, int32]::len : (HashMap[Key, int32]) -> int)((m/12 : HashMap[Key, int32]))
    );
}