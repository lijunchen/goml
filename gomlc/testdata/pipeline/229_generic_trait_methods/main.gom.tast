impl RenderValue for Prefix {
  fn render[V](self/0: Prefix, value/1: V) -> string where V: ToString {
      (self/0 : Prefix).value + (ToString::to_string : (V) -> string)((value/1 : V))
  }
}

fn render_generic[T](renderer/2: T) -> string where T: RenderValue {
    (RenderValue::render : (T, isize) -> string)((renderer/2 : T), 11)
}

fn main() -> unit {
    let direct/3: string =
      (RenderValue::render : (Prefix, string) -> string)(Prefix { value: "direct:" }, "ok");
    (println : (string) -> unit)((direct/3 : string));
    let generic/4: string = (render_generic : (Prefix) -> string)(Prefix { value: "generic:" });
    (println : (string) -> unit)((generic/4 : string));
    let ufcs/5: string =
      (RenderValue::render : (Prefix, isize) -> string)(Prefix { value: "ufcs:" }, 12);
    (println : (string) -> unit)((ufcs/5 : string));
}