      let local/1/1 = S { value: 9 };
      println(s/1);
      let local/1/2: dyn ToString = s/1 as dyn ToString;
      println(d/2);
      let local/1/3 = Ref::new(5);
      println(r/3);
      print("no-newline");
      println("!");
  }