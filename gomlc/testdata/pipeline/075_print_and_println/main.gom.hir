package main
file main.gom
  struct S {
      value: int32,
  }

  impl ToString for S {
    fn to_string(local/1/0: S) -> string {
        "S(" + self/0.value.to_string() + ")"
    }
  }

  fn main() -> unit {
      println(1);
      println(true);
      println("hi");
      println(());
