package main;
fn tuple_case() -> int32 {
    let _: (int32, int32) = (return 1, 2);
    0
}

fn array_case() -> int32 {
    let _: [int32; 2] = [return 1, 2];
    0
}

fn proj_case() -> int32 {
    let _: int32 = return 1.0;
    0
}

fn index_case() -> int32 {
    let _: int32 = return 1[0];
    0
}

fn field_case() -> int32 {
    let _: int32 = return 1.value;
    0
}

fn main() -> unit {}

