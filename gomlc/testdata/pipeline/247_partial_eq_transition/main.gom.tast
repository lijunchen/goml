impl PartialEq for LegacyKey {
  fn eq(self/0: LegacyKey, other/1: LegacyKey) -> bool {
      true &&
        (PartialEq::eq : (isize, isize) -> bool)(
          (self/0 : LegacyKey).value,
          (other/1 : LegacyKey).value
        )
  }
}

impl Eq for LegacyKey where isize: Eq, isize: PartialEq {}

impl Hash for LegacyKey {
  fn hash(self/2: LegacyKey) -> u64 {
      {
          let h/3: u64 = (isize::to_u64 : (isize) -> u64)(0) + 14695981039346656037;
          let h/4: u64 =
            (h/3 : u64) * (isize::to_u64 : (isize) -> u64)(0) + 1099511628211 +
              (Hash::hash : (isize) -> u64)((self/2 : LegacyKey).value);
          (h/4 : u64)
      }
  }
}

impl PartialEq for ModernKey {
  fn eq(self/5: ModernKey, other/6: ModernKey) -> bool {
      (self/5 : ModernKey).value % 10 == (other/6 : ModernKey).value % 10
  }
}

impl Eq for ModernKey {}

impl Hash for ModernKey {
  fn hash(self/7: ModernKey) -> u64 {
      (isize::to_uint64 : (isize) -> u64)((self/7 : ModernKey).value % 10)
  }
}

impl PartialEq for Rank {
  fn eq(self/8: Rank, other/9: Rank) -> bool {
      (self/8 : Rank).value == (other/9 : Rank).value
  }
}

impl std::cmp::PartialOrd for Rank {
  fn partial_cmp(self/10: Rank, other/11: Rank) -> Option[Ordering] {
      Option::Some(
        if (self/10 : Rank).value > (other/11 : Rank).value {
            {
                Ordering::Less
            }
        } else {
            if (self/10 : Rank).value < (other/11 : Rank).value {
                {
                    Ordering::Greater
                }
            } else {
                {
                    Ordering::Equal
                }
            }
        }
      )
  }
  fn lt(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#lt : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
  fn le(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#le : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
  fn gt(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#gt : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
  fn ge(default_arg0: Rank, default_arg1: Rank) -> bool {
      (std::cmp::trait_default#PartialOrd#ge : (Rank, Rank) -> bool)(
        (default_arg0 : Rank),
        (default_arg1 : Rank)
      )
  }
}

fn equal[T](left/12: T, right/13: T) -> bool where T: Eq, T: PartialEq {
    (left/12 : T) == (right/13 : T)
}

fn main() -> unit {
    let legacy/14: LegacyKey = LegacyKey { value: 7 };
    let modern/15: ModernKey = ModernKey { value: 9 };
    (println : (bool) -> unit)(
      (equal : (LegacyKey, LegacyKey) -> bool)((legacy/14 : LegacyKey), LegacyKey { value: 7 })
    );
    (println : (bool) -> unit)(
      (PartialEq::eq : (LegacyKey, LegacyKey) -> bool)(
        (legacy/14 : LegacyKey),
        LegacyKey { value: 8 }
      )
    );
    (println : (bool) -> unit)(
      (equal : (ModernKey, ModernKey) -> bool)((modern/15 : ModernKey), ModernKey { value: 19 })
    );
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((modern/15 : ModernKey) != ModernKey { value: 20 })
    );
    let legacy_map/16: HashMap[LegacyKey, string] =
      (HashMap[LegacyKey, string]::new : () -> HashMap[LegacyKey, string])();
    (HashMap[LegacyKey, string]::set : (HashMap[LegacyKey, string], LegacyKey, string) -> unit)(
      (legacy_map/16 : HashMap[LegacyKey, string]),
      (legacy/14 : LegacyKey),
      "legacy"
    );
    (println : (string) -> unit)(
      (Option[string]::unwrap_or : (Option[string], string) -> string)(
        (HashMap[LegacyKey, string]::get : (HashMap[LegacyKey, string], LegacyKey) -> Option[
          string
        ])((legacy_map/16 : HashMap[LegacyKey, string]), LegacyKey { value: 7 }),
        "missing"
      )
    );
    let modern_map/17: HashMap[ModernKey, string] =
      (HashMap[ModernKey, string]::new : () -> HashMap[ModernKey, string])();
    (HashMap[ModernKey, string]::set : (HashMap[ModernKey, string], ModernKey, string) -> unit)(
      (modern_map/17 : HashMap[ModernKey, string]),
      (modern/15 : ModernKey),
      "modern"
    );
    (println : (string) -> unit)(
      (Option[string]::unwrap_or : (Option[string], string) -> string)(
        (HashMap[ModernKey, string]::get : (HashMap[ModernKey, string], ModernKey) -> Option[
          string
        ])((modern_map/17 : HashMap[ModernKey, string]), ModernKey { value: 19 }),
        "missing"
      )
    );
    let high/18: Rank = Rank { value: 2 };
    let low/19: Rank = Rank { value: 1 };
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((high/18 : Rank) < (low/19 : Rank))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((high/18 : Rank) <= (high/18 : Rank))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((low/19 : Rank) > (high/18 : Rank))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((low/19 : Rank) >= (low/19 : Rank))
    )
}