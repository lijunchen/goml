fn gen(st/73: CheckerState, ty/74: Typ) -> Typ {
  match ty/74 {
    Typ::TVar(x272) => {
      {
        let x272 = Typ::TVar._0(ty/74) in
        {
          let tvref/75 = x272 in
          {
            let mtmp276 = inherent#Ref#Ref[Tv]#get(tvref/75) in
            match mtmp276 {
              Tv::Unbound(x277, x278) => {
                {
                  let x277 = Tv::Unbound._0(mtmp276) in
                  let x278 = Tv::Unbound._1(mtmp276) in
                  {
                    let l/77 = x278 in
                    {
                      let name/76 = x277 in
                      {
                        let cur/78 =
                          inherent#Ref#Ref[int32]#get(CheckerState.current_level(st/73)) in
                        if (l/77 > cur/78) {
                            {
                              Typ::QVar(name/76)
                            }
                        } else {
                            {
                              Typ::TVar(tvref/75)
                            }
                        }
                      }
                    }
                  }
                }
              },
              Tv::Link(x279) => {
                {
                  let x279 = Tv::Link._0(mtmp276) in
                  {
                    let inner/79 = x279 in
                    gen(st/73, inner/79)
                  }
                }
              },
            }
          }
        }
      }
    },
    Typ::TArrow(x274, x275) => {
      {
        let x274 = Typ::TArrow._0(ty/74) in
        let x275 = Typ::TArrow._1(ty/74) in
        {
          let t2/81 = x275 in
          {
            let t1/80 = x274 in
            Typ::TArrow(gen(st/73, t1/80), gen(st/73, t2/81))
          }
        }
      }
    },
    _ =>
      {
        let other/82 = ty/74 in
        other/82
      },
  }
}

fn inst_loop(st/83: CheckerState, subst/84: Vec[SubstEntry], ty/85: Typ) -> (Typ, Vec[SubstEntry]) {
  match ty/85 {
    Typ::TVar(x280) => {
      {
        let x280 = Typ::TVar._0(ty/85) in
