fn gen(st/73: CheckerState, ty/74: Typ) -> Typ {
  match ty/74 {
    Typ::TVar(x277) => {
      {
        let x277 = Typ::TVar._0(ty/74) in
        {
          let tvref/75 = x277 in
          {
            let mtmp281 = inherent#Ref#Ref[Tv]#get(tvref/75) in
            match mtmp281 {
              Tv::Unbound(x282, x283) => {
                {
                  let x282 = Tv::Unbound._0(mtmp281) in
                  let x283 = Tv::Unbound._1(mtmp281) in
                  {
                    let l/77 = x283 in
                    {
                      let name/76 = x282 in
                      {
                        let cur/78 =
                          inherent#Ref#Ref[int32]#get(CheckerState.current_level(st/73)) in
                        if (l/77 > cur/78) {
                            {
                              Typ::QVar(name/76)
                            }
                        } else {
                            {
                              Typ::TVar(tvref/75)
                            }
                        }
                      }
                    }
                  }
                }
              },
              Tv::Link(x284) => {
                {
                  let x284 = Tv::Link._0(mtmp281) in
                  {
                    let inner/79 = x284 in
                    gen(st/73, inner/79)
                  }
                }
              },
            }
          }
        }
      }
    },
    Typ::TArrow(x279, x280) => {
      {
        let x279 = Typ::TArrow._0(ty/74) in
        let x280 = Typ::TArrow._1(ty/74) in
        {
          let t2/81 = x280 in
          {
            let t1/80 = x279 in
            Typ::TArrow(gen(st/73, t1/80), gen(st/73, t2/81))
          }
        }
      }
    },
    _ =>
      {
        let other/82 = ty/74 in
        other/82
      },
  }
}

fn inst_loop(st/83: CheckerState, subst/84: Vec[SubstEntry], ty/85: Typ) -> (Typ, Vec[SubstEntry]) {
  match ty/85 {
    Typ::TVar(x285) => {
      {
        let x285 = Typ::TVar._0(ty/85) in
