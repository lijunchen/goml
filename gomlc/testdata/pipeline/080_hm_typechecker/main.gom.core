                }
              },
              _ => (Typ::TVar(tvref/90), subst/84),
            }
          }
        }
      }
    },
    Typ::QVar(x281) => {
      {
        let x281 = Typ::QVar._0(ty/85) in
        {
          let name/86 = x281 in
          {
            let mtmp288 = subst_lookup(subst/84, name/86) in
            match mtmp288 {
              Option::None => {
                {
                  let tv/88 = newvar(st/83) in
                  let new_subst/89 =
                    inherent#Vec#Vec[SubstEntry]#pushed(
                      subst/84,
                      SubstEntry { name: name/86, ty: tv/88 }
                    ) in
                  (tv/88, new_subst/89)
                }
              },
              Option::Some(x289) => {
                {
                  let x289 = Option::Some._0(mtmp288) in
                  {
                    let t/87 = x289 in
                    (t/87, subst/84)
                  }
                }
              },
            }
          }
        }
      }
    },
    Typ::TArrow(x282, x283) => {
      {
        let x282 = Typ::TArrow._0(ty/85) in
        let x283 = Typ::TArrow._1(ty/85) in
        {
          let t2/93 = x283 in
          {
            let t1/92 = x282 in
            {
              let mtmp290 = inst_loop(st/83, subst/84, t1/92) in
              {
                let x291 = mtmp290.0 in
                let x292 = mtmp290.1 in
                {
                  let subst1/95 = x292 in
                  {
                    let ty1/94 = x291 in
                    {
                      let mtmp293 = inst_loop(st/83, subst1/95, t2/93) in
                      {
                        let x294 = mtmp293.0 in
                        let x295 = mtmp293.1 in
                        {
                          let subst2/97 = x295 in
                          {
                            let ty2/96 = x294 in
                            {
                              (Typ::TArrow(ty1/94, ty2/96), subst2/97)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
  }
}

