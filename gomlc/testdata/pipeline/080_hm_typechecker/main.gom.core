          ("'" + name/19)
        }
      }
    },
    Typ::TArrow(x152, x153) => {
      {
        let x152 = Typ::TArrow._0(ty/18) in
        let x153 = Typ::TArrow._1(ty/18) in
        {
          let t2/24 = x153 in
          {
            let t1/23 = x152 in
            {
              let s1/25 =
                if typ_is_arrow(t1/23) {
                    {
                      (("(" + typ_to_string(t1/23)) + ")")
