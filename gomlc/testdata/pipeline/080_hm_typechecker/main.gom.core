fn typ_to_string(ty/18: Typ) -> string {
  match ty/18 {
    Typ::TVar(x122) => {
      {
        let x122 = Typ::TVar._0(ty/18) in
        {
          let tvref/20 = x122 in
          {
            let mtmp126 = inherent#Ref#Ref[Tv]#get(tvref/20) in
            match mtmp126 {
              Tv::Unbound(x127, x128) => {
                {
                  let x127 = Tv::Unbound._0(mtmp126) in
                  let x128 = Tv::Unbound._1(mtmp126) in
                  {
                    let name/21 = x127 in
                    ("'" + name/21)
                  }
                }
              },
              Tv::Link(x129) => {
                {
                  let x129 = Tv::Link._0(mtmp126) in
                  {
                    let inner/22 = x129 in
                    typ_to_string(inner/22)
                  }
                }
              },
            }
          }
