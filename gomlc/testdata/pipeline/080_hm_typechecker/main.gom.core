      }
    },
    Typ::QVar(x123) => {
      {
        let x123 = Typ::QVar._0(ty/18) in
        {
          let name/19 = x123 in
          ("'" + name/19)
        }
      }
    },
    Typ::TArrow(x124, x125) => {
      {
        let x124 = Typ::TArrow._0(ty/18) in
        let x125 = Typ::TArrow._1(ty/18) in
        {
          let t2/24 = x125 in
          {
            let t1/23 = x124 in
            {
              let s1/25 = if typ_is_arrow(t1/23) {
                  {
                    (("(" + typ_to_string(t1/23)) + ")")
                  }
              } else {
                  {
                    typ_to_string(t1/23)
                  }
              } in
              let s2/26 = typ_to_string(t2/24) in
              ((s1/25 + " -> ") + s2/26)
            }
          }
        }
      }
    },
  }
}

