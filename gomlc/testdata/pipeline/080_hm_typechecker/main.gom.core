fn exp_var(name/129: string) -> Exp {
  Exp::Var(name/129)
}

fn exp_lam(name/130: string, body/131: Exp) -> Exp {
  Exp::Lam(name/130, body/131)
}

fn exp_app(a/132: Exp, b/133: Exp) -> Exp {
  Exp::App(a/132, b/133)
}

fn exp_let(name/134: string, a/135: Exp, b/136: Exp) -> Exp {
  Exp::Let(name/134, a/135, b/136)
}

