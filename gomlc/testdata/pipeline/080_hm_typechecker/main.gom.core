    Typ::QVar(x286) => {
      {
        let x286 = Typ::QVar._0(ty/85) in
        {
          let name/86 = x286 in
          {
            let mtmp293 = subst_lookup(subst/84, name/86) in
            match mtmp293 {
              Option::None => {
                {
                  let tv/88 = newvar(st/83) in
                  let new_subst/89 =
                    inherent#Vec#Vec[SubstEntry]#pushed(
                      subst/84,
                      SubstEntry { name: name/86, ty: tv/88 }
                    ) in
                  (tv/88, new_subst/89)
                }
              },
              Option::Some(x294) => {
                {
                  let x294 = Option::Some._0(mtmp293) in
                  {
                    let t/87 = x294 in
                    (t/87, subst/84)
                  }
                }
              },
            }
          }
        }
      }
    },
    Typ::TArrow(x287, x288) => {
      {
        let x287 = Typ::TArrow._0(ty/85) in
        let x288 = Typ::TArrow._1(ty/85) in
        {
          let t2/93 = x288 in
          {
            let t1/92 = x287 in
            {
              let mtmp295 = inst_loop(st/83, subst/84, t1/92) in
              {
                let x296 = mtmp295.0 in
                let x297 = mtmp295.1 in
                {
                  let subst1/95 = x297 in
                  {
                    let ty1/94 = x296 in
                    {
                      let mtmp298 = inst_loop(st/83, subst1/95, t2/93) in
                      {
                        let x299 = mtmp298.0 in
                        let x300 = mtmp298.1 in
                        {
                          let subst2/97 = x300 in
                          {
                            let ty2/96 = x299 in
                            {
                              (Typ::TArrow(ty1/94, ty2/96), subst2/97)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
  }
}

fn inst(st/98: CheckerState, ty/99: Typ) -> Typ {
