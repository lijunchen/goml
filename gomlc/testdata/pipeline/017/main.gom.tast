impl ToString for (isize, isize) {
  fn to_string(self/0: (isize, isize)) -> string {
      "(?, ?)"
  }
}

fn main() -> unit {
    let x/1: isize = 123;
    let _ : unit =
      (println : (string) -> unit)((ToString::to_string : (isize) -> string)((x/1 : isize)));
    let x/2: bool = true;
    let _ : unit =
      (println : (string) -> unit)((ToString::to_string : (bool) -> string)((x/2 : bool)));
    let x/3: (isize, isize) = (3, 4);
    let _ : unit =
      (println : (string) -> unit)(
        (ToString::to_string : ((isize, isize)) -> string)((x/3 : (isize, isize)))
      );
}