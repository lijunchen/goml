fn classify(x/0: f64) -> string {
    match (x/0 : f64) {
        0 => "zero",
        1 => "one",
        -1 => "minus one",
        3.14 => "pi",
        _ : f64 => "other",
    }
}

fn main() -> unit {
    (println : (string) -> unit)((classify : (f64) -> string)(0));
    (println : (string) -> unit)((classify : (f64) -> string)(1));
    (println : (string) -> unit)((classify : (f64) -> string)(-1));
    (println : (string) -> unit)((classify : (f64) -> string)(3.14));
    (println : (string) -> unit)((classify : (f64) -> string)(42));
}