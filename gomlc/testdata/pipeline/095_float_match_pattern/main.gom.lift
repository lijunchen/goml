fn classify(x/0: float64) -> string {
  match x/0 {
    0 => {
      "zero"
    },
    1 => {
      "one"
    },
    -1 => {
      "minus one"
    },
    3.14 => {
      "pi"
    },
    _ => "other",
  }
}

