  let _wild182 = println__T_string(classify(0)) in
  let _wild183 = println__T_string(classify(1)) in
  let _wild184 = println__T_string(classify((-1))) in
  let _wild185 = println__T_string(classify(3.14)) in
  let _wild186 = println__T_string(classify(42)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/65: string) -> string {
  self/65
}