impl ToString for Point {
  fn to_string(self/0: Point) -> string {
      {
          let Point { x: #derive0_field/1: int32, y: #derive1_field/2: int32 } = (self/0 : Point);
          "Point { " + "x: " +
            (ToString::to_string : (int32) -> string)((#derive0_field/1 : int32)) +
            ", " +
            "y: " +
            (ToString::to_string : (int32) -> string)((#derive1_field/2 : int32)) +
            " }"
      }
  }
}

impl ToString for Message {
  fn to_string(self/3: Message) -> string {
      match (self/3 : Message) {
          Message::Quit => "Message::Quit",
          Message::Move(#derive0_field/4: int32, #derive1_field/5: int32) =>
            "Message::Move(" +
              (ToString::to_string : (int32) -> string)((#derive0_field/4 : int32)) +
              ", " +
              (ToString::to_string : (int32) -> string)((#derive1_field/5 : int32)) +
              ")",
          Message::Write(#derive2_field/6: string) =>
            "Message::Write(" + (#derive2_field/6 : string) + ")",
      }
  }
}

fn main() -> unit {
    let point/7: Point = Point { x: 4, y: 7 };
    let summary/8: string = (ToString::to_string : (Point) -> string)((point/7 : Point));
    let mv/9: string = (ToString::to_string : (Message) -> string)(Message::Move(1, 2));
    let text/10: string = (ToString::to_string : (Message) -> string)(Message::Write("done"));
    let exit/11: string = (ToString::to_string : (Message) -> string)(Message::Quit);
    (println : (string) -> unit)((summary/8 : string));
    (println : (string) -> unit)((mv/9 : string));
    (println : (string) -> unit)((text/10 : string));
    (println : (string) -> unit)((exit/11 : string));
}