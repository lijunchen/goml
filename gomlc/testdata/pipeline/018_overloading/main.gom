trait Arith {
    fn add(self: Self, arg1: Self) -> int32;
    fn less(self: Self, arg1: Self) -> bool;
}

impl Arith for int32 {
    fn add(self: int32, other: int32) -> int32 {
        self + other
    }

    fn less(self: int32, other: int32) -> bool {
        self < other
    }
}

trait Output {
    fn output(self: Self) -> unit;
}

impl Output for int32 {
    fn output(self: int32) -> unit {
        println(ToString::to_string(self))
    }
}

impl Output for bool {
    fn output(self: bool) -> unit {
        println(ToString::to_string(self))
    }
}

fn id[T](x: T) -> T {
    x
}

fn main() {
    let a: int32 = id(1);
    let b: int32 = id(2);
    let c = Arith::add(a, b);
    let _ = Output::output(c);
    let a: int32 = id(3);
    let b: int32 = id(4);
    let c = Arith::less(a, b);
    let _ = Output::output(c);
    let _ = id("abc");
    let _ = id(true);
}
