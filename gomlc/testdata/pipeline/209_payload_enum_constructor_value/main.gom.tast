fn prepend_with(
  make/0: (int32, List[int32]) -> List[int32],
  value/1: int32,
  values/2: List[int32]
) -> List[int32] {
    (make/0 : (int32, List[int32]) -> List[int32])((value/1 : int32), (values/2 : List[int32]))
}

fn sum(values/3: List[int32]) -> int32 {
    match (values/3 : List[int32]) {
        List::Nil => 0,
        List::Cons(value/4: int32, rest/5: List[int32]) =>
          (value/4 : int32) + (sum : (List[int32]) -> int32)((rest/5 : List[int32])),
    }
}

fn main() -> unit {
    let cons/6: (int32, List[int32]) -> List[int32] =
      |ctor_arg_0: int32, ctor_arg_1: List[int32]| =>
        List::Cons((ctor_arg_0 : int32), (ctor_arg_1 : List[int32]));
    let values/7: List[int32] =
      (prepend_with : ((int32, List[int32]) -> List[int32], int32, List[int32]) -> List[int32])(
        (cons/6 : (int32, List[int32]) -> List[int32]),
        1,
        (prepend_with : ((int32, List[int32]) -> List[int32], int32, List[int32]) -> List[int32])(
          (cons/6 : (int32, List[int32]) -> List[int32]),
          2,
          List::Nil
        )
      );
    (println : (string) -> unit)(
      (int32::to_string : (int32) -> string)(
        (sum : (List[int32]) -> int32)((values/7 : List[int32]))
      )
    )
}