fn main() -> unit {
    let i/0: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let sum/1: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) < 7 {
        {
            let cur/2: int = (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int]));
            (Ref[int]::set : (Ref[int], int) -> unit)((i/0 : Ref[int]), (cur/2 : int) + 1);
            let _ : unit =
              if (cur/2 : int) < 5 {
                  {
                      match (cur/2 : int) {
                          1 => continue,
                          3 => continue,
                          _ : int => (),
                      }
                  }
              } else {
                  {
                      match (cur/2 : int) {
                          5 => break,
                          _ : int => (),
                      }
                  }
              };
            (Ref[int]::set : (Ref[int], int) -> unit)(
              (sum/1 : Ref[int]),
              (Ref[int]::get : (Ref[int]) -> int)((sum/1 : Ref[int])) + (cur/2 : int)
            );
        }
    };
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((sum/1 : Ref[int])));
}