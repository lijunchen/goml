package main;
trait Convert[T] {
  type Output;
  fn convert(self: Self) -> Self::Output;
}

struct Value {}

impl Convert[int32] for Value {
  type Output = string;
  fn convert(self: Value) -> string {
      "int"
  }
}

impl Convert[string] for Value {
  type Output = int32;
  fn convert(self: Value) -> int32 {
      7
  }
}

fn main() -> unit {
    let text: string = Convert::[int32]::convert(Value {});
    let number: int32 = Convert::[string]::convert(Value {});
    println(text);
    println(number);
}

