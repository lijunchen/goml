package main
file main.gom
  trait Convert[T] {
      type Output;
      fn convert(Self) -> Self::Output;
    }

    struct Value {
    }

    impl Convert[int32] for Value {
      type Output = string;
      fn convert(local/1/0: Value) -> string {
          "int"
      }
    }

    impl Convert[string] for Value {
      type Output = int32;
      fn convert(local/1/1: Value) -> int32 {
          7
      }
    }

    fn main() -> unit {
        let local/1/2: string = Convert[int32]::convert(Value {});
        let local/1/3: int32 = Convert[string]::convert(Value {});
        println(text/2);
        println(number/3);
    }