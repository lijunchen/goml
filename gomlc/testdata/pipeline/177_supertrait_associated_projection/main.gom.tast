impl Parent for Count{
  fn get(self/0: Count) -> int32 {
      (self/0 : Count).value
  }
}

impl Child for Count{
  fn child(self/1: Count) -> unit {
      ()
  }
}

fn get_from_child[C](value/2: C) -> C::Item where C: Child, C: Parent {
    (Parent::get : (C) -> C::Item)((value/2 : C))
}

fn main() -> unit {
    (println : (int32) -> unit)((get_from_child : (Count) -> int32)(Count { value: 42 }));
}