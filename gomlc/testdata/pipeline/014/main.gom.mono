fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  {
    let x155 = x/0.0 in
    let x156 = x/0.1 in
    match x156 {
      true => {
        {
          let x157 = y/1.0 in
          let x158 = y/1.1 in
          match x158 {
            true => {
              match x157 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        }
      },
      false => {
        match x155 {
          true => {
            {
              let x159 = y/1.0 in
              let x160 = y/1.1 in
              match x160 {
                true => {
                  match x159 {
