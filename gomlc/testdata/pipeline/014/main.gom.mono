fn main() -> unit {
  let mtmp163 = test_nested_match((true, false), (false, true)) in
  {
    let mtmp164 = test_nested_match((true, false), (true, false)) in
    {
      let mtmp165 = test_nested_match((false, true), (false, true)) in
      {
        let mtmp166 = test_nested_match((false, true), (true, false)) in
        {
          ()
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/38: string) -> string {
  self/38
}