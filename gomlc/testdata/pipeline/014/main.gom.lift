fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x408 = x/0.0 in
  let x409 = x/0.1 in
  match x409 {
    true => {
      let x410 = y/1.0 in
      let x411 = y/1.1 in
      match x411 {
        true => {
          match x410 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x408 {
        true => {
          let x412 = y/1.0 in
          let x413 = y/1.1 in
          match x413 {
            true => {
              match x412 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x414 = y/1.0 in
          let x415 = y/1.1 in
          match x415 {
            true => {
              match x414 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp416 = test_nested_match((true, false), (false, true)) in
  let mtmp417 = test_nested_match((true, false), (true, false)) in
  let mtmp418 = test_nested_match((false, true), (false, true)) in
  let mtmp419 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

