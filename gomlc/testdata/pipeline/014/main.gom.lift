fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x187 = x/0.0 in
  let x188 = x/0.1 in
  match x188 {
    true => {
      let x189 = y/1.0 in
      let x190 = y/1.1 in
      match x190 {
        true => {
          match x189 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x187 {
        true => {
          let x191 = y/1.0 in
          let x192 = y/1.1 in
          match x192 {
            true => {
              match x191 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x193 = y/1.0 in
          let x194 = y/1.1 in
          match x194 {
            true => {
              match x193 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp195 = test_nested_match((true, false), (false, true)) in
  let mtmp196 = test_nested_match((true, false), (true, false)) in
  let mtmp197 = test_nested_match((false, true), (false, true)) in
  let mtmp198 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/65: string) -> string {
  self/65
}