}

fn main() -> unit {
  let mtmp144 = test_nested_match((true, false), (false, true)) in
  let mtmp145 = test_nested_match((true, false), (true, false)) in
  let mtmp146 = test_nested_match((false, true), (false, true)) in
  let mtmp147 = test_nested_match((false, true), (true, false)) in
  ()
}

