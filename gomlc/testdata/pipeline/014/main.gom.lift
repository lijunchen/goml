fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x152 = x/0.0 in
  let x153 = x/0.1 in
  match x153 {
    true => {
      let x154 = y/1.0 in
      let x155 = y/1.1 in
      match x155 {
        true => {
          match x154 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x152 {
        true => {
          let x156 = y/1.0 in
          let x157 = y/1.1 in
          match x157 {
            true => {
              match x156 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x158 = y/1.0 in
          let x159 = y/1.1 in
          match x159 {
            true => {
              match x158 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp160 = test_nested_match((true, false), (false, true)) in
  let mtmp161 = test_nested_match((true, false), (true, false)) in
  let mtmp162 = test_nested_match((false, true), (false, true)) in
  let mtmp163 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/38: string) -> string {
  self/38
}