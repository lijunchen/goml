fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x108 = x/0.0 in
  let x109 = x/0.1 in
  match x109 {
    true => {
      let x110 = y/1.0 in
      let x111 = y/1.1 in
      match x111 {
        true => {
          match x110 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x108 {
        true => {
          let x112 = y/1.0 in
          let x113 = y/1.1 in
          match x113 {
            true => {
              match x112 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x114 = y/1.0 in
          let x115 = y/1.1 in
          match x115 {
            true => {
              match x114 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp116 = test_nested_match((true, false), (false, true)) in
  let mtmp117 = test_nested_match((true, false), (true, false)) in
  let mtmp118 = test_nested_match((false, true), (false, true)) in
  let mtmp119 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/38: string) -> string {
  self/38
}