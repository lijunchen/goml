fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x136 = x/0.0 in
  let x137 = x/0.1 in
  match x137 {
    true => {
      let x138 = y/1.0 in
      let x139 = y/1.1 in
      match x139 {
        true => {
          match x138 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x136 {
        true => {
          let x140 = y/1.0 in
          let x141 = y/1.1 in
          match x141 {
            true => {
              match x140 {
                true => {
                  println__T_string("case2")
                },
