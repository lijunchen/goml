                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp180 = test_nested_match((true, false), (false, true)) in
  let mtmp181 = test_nested_match((true, false), (true, false)) in
  let mtmp182 = test_nested_match((false, true), (false, true)) in
  let mtmp183 = test_nested_match((false, true), (true, false)) in
  ()
}

