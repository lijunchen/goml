fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x172 = x/0.0 in
  let x173 = x/0.1 in
  match x173 {
    true => {
      let x174 = y/1.0 in
      let x175 = y/1.1 in
      match x175 {
        true => {
          match x174 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x172 {
        true => {
          let x176 = y/1.0 in
          let x177 = y/1.1 in
          match x177 {
            true => {
              match x176 {
                true => {
                  println__T_string("case2")
                },
