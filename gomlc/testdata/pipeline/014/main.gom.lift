fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x64 = x/0.0 in
  let x65 = x/0.1 in
  match x65 {
    true => {
      let x66 = y/1.0 in
      let x67 = y/1.1 in
      match x67 {
        true => {
          match x66 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x64 {
        true => {
          let x68 = y/1.0 in
          let x69 = y/1.1 in
          match x69 {
            true => {
              match x68 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x70 = y/1.0 in
          let x71 = y/1.1 in
          match x71 {
            true => {
              match x70 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp72 = test_nested_match((true, false), (false, true)) in
  let mtmp73 = test_nested_match((true, false), (true, false)) in
  let mtmp74 = test_nested_match((false, true), (false, true)) in
  let mtmp75 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/38: string) -> string {
  self/38
}