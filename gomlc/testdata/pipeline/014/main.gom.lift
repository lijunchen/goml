fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  let x796 = x/0.0 in
  let x797 = x/0.1 in
  match x797 {
    true => {
      let x798 = y/1.0 in
      let x799 = y/1.1 in
      match x799 {
        true => {
          match x798 {
            true => {
              println__T_string("case4")
            },
            false => {
              println__T_string("case3")
            },
          }
        },
        false => {
          println__T_string("case4")
        },
      }
    },
    false => {
      match x796 {
        true => {
          let x800 = y/1.0 in
          let x801 = y/1.1 in
          match x801 {
            true => {
              match x800 {
                true => {
                  println__T_string("case2")
                },
                false => {
                  println__T_string("case1")
                },
              }
            },
            false => {
              println__T_string("case2")
            },
          }
        },
        false => {
          let x802 = y/1.0 in
          let x803 = y/1.1 in
          match x803 {
            true => {
              match x802 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        },
      }
    },
  }
}

fn main() -> unit {
  let mtmp804 = test_nested_match((true, false), (false, true)) in
  let mtmp805 = test_nested_match((true, false), (true, false)) in
  let mtmp806 = test_nested_match((false, true), (false, true)) in
  let mtmp807 = test_nested_match((false, true), (true, false)) in
  ()
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/402: string) -> string {
  self/402
}