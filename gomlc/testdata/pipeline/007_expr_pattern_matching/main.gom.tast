fn main() -> unit {
    let a/0: Expr = Expr::Mul(Expr::Add(Expr::Zero, Expr::Zero), Expr::Zero);
    match (a/0 : Expr) {
        Expr::Add(Expr::Zero, Expr::Zero) => (print : (isize) -> unit)(0),
        Expr::Mul(Expr::Zero, x/1: Expr) => (print : (isize) -> unit)(1),
        Expr::Add(Expr::Succ(x/2: Expr), y/3: Expr) => (print : (isize) -> unit)(2),
        Expr::Mul(x/4: Expr, Expr::Zero) => (print : (isize) -> unit)(3),
        Expr::Mul(Expr::Add(x/5: Expr, y/6: Expr), z/7: Expr) => (print : (isize) -> unit)(4),
        Expr::Add(x/8: Expr, Expr::Zero) => (print : (isize) -> unit)(5),
        x/9: Expr => (print : (isize) -> unit)(6),
    }
}