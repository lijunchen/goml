fn main() -> unit {
    let i/0: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let sum/1: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) < 5 {
        {
            (Ref[int]::set : (Ref[int], int) -> unit)((i/0 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) + 1);
            let cur/2: int = if (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) == 3 {
                {
                    continue
                }
            } else {
                {
                    (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int]))
                }
            };
            (Ref[int]::set : (Ref[int], int) -> unit)((sum/1 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((sum/1 : Ref[int])) + (cur/2 : int));
        }
    };
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((sum/1 : Ref[int])));
    let j/3: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let total/4: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while true {
        {
            (Ref[int]::set : (Ref[int], int) -> unit)((j/3 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((j/3 : Ref[int])) + 1);
            let cur/5: int = match (Ref[int]::get : (Ref[int]) -> int)((j/3 : Ref[int])) {
                5 => break,
                _ : int => (Ref[int]::get : (Ref[int]) -> int)((j/3 : Ref[int])),
            };
            (Ref[int]::set : (Ref[int], int) -> unit)((total/4 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((total/4 : Ref[int])) + (cur/5 : int));
        }
    };
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((total/4 : Ref[int])));
}