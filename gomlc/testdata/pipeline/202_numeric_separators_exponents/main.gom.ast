package main;
fn accepts_array_length(value: [i32; 10]) -> unit {
    let _ = value;
}

fn main() -> unit {
    let integer: i32 = 1000;
    let unsigned: u64 = 4294967296;
    let float: f64 = 125;
    let small: f32 = 2.5;
    println(integer);
    println(unsigned);
    println(float);
    println(small);
    match integer {
        1000 => println("matched"),
        _ => println("missed"),
    }
}

