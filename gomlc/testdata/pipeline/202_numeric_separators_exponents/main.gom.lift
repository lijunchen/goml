fn main() -> unit {
  let integer/1 = 1000 in
  let unsigned/2 = 4294967296 in
  let float/3 = 125 in
  let small/4 = 2.5 in
  let _wild173 = println__T_int32(integer/1) in
  let _wild174 = println__T_uint64(unsigned/2) in
  let _wild175 = println__T_float64(float/3) in
