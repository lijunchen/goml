fn test(t/0: T) -> unit {
    match (t/0 : T) {
        T::A => (println : (string) -> unit)((isize::to_string : (isize) -> string)(1)),
        T::B(false, false) =>
          (println : (string) -> unit)((isize::to_string : (isize) -> string)(2)),
        T::B(false, true) =>
          (println : (string) -> unit)((isize::to_string : (isize) -> string)(3)),
        _ : T => (println : (string) -> unit)((isize::to_string : (isize) -> string)(4)),
    }
}

fn main() -> unit {
    let _ : unit = (test : (T) -> unit)(T::B(true, true));
    let _ : unit = (test : (T) -> unit)(T::B(false, true));
    let _ : unit = (test : (T) -> unit)(T::B(false, false));
    let _ : unit = (test : (T) -> unit)(T::A);
}