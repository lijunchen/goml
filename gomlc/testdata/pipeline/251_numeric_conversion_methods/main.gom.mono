fn main() -> unit {
  let _wild262 = exercise_int(1) in
  let _wild263 = exercise_int8(1) in
  let _wild264 = exercise_int16(1) in
  let _wild265 = exercise_int32(1) in
  let _wild266 = exercise_int64(1) in
  let _wild267 = exercise_uint(1) in
  let _wild268 = exercise_uint8(1) in
  let _wild269 = exercise_uint16(1) in
  let _wild270 = exercise_uint32(1) in
  let _wild271 = exercise_uint64(1) in
  let value/11 = 511 in
  let _wild272 = println__T_uint8((value/11 as uint8)) in
  let _wild273 = println__T_uint8(WRAPPED) in
  let _wild274 = println__T_uint32(LETTER) in
  let _wild275 = println__T_uint8(narrow_at_compile_time(-1)) in
  let octet/12 = 255 in
  println__T_int16((octet/12 as int16))
}

fn println__T_uint8(value/31: uint8) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#uint8#to_string(value/31))
}

fn println__T_uint32(value/31: uint32) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#uint32#to_string(value/31))
}

fn println__T_int16(value/31: int16) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#int16#to_string(value/31))
}

fn trait_impl#ToString#uint8#to_string(self/74: uint8) -> string {
  @runtime(core.uint8_to_string)(self/74)
}

fn trait_impl#ToString#uint32#to_string(self/76: uint32) -> string {
  @runtime(core.uint32_to_string)(self/76)
}

fn trait_impl#ToString#int16#to_string(self/71: int16) -> string {
  @runtime(core.int16_to_string)(self/71)
}