fn main() -> unit {
  let _wild501 = exercise_int(1) in
  let _wild502 = exercise_int8(1) in
  let _wild503 = exercise_int16(1) in
  let _wild504 = exercise_int32(1) in
  let _wild505 = exercise_int64(1) in
  let _wild506 = exercise_uint(1) in
  let _wild507 = exercise_uint8(1) in
  let _wild508 = exercise_uint16(1) in
  let _wild509 = exercise_uint32(1) in
  let _wild510 = exercise_uint64(1) in
  let value/11 = 511 in
  let _wild511 = println__T_uint8((value/11 as uint8)) in
  let _wild512 = println__T_uint8(WRAPPED) in
  let _wild513 = println__T_uint32(LETTER) in
  let _wild514 = println__T_uint8(narrow_at_compile_time(-1)) in
  let octet/12 = 255 in
  println__T_int16((octet/12 as int16))
}

fn println__T_uint8(value/1: uint8) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#uint8#to_string(value/1))
}

fn println__T_uint32(value/1: uint32) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#uint32#to_string(value/1))
}

fn println__T_int16(value/1: int16) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#int16#to_string(value/1))
}

fn trait_impl#ToString#uint8#to_string(self/156: uint8) -> string {
  @runtime(core.uint8_to_string)(self/156)
}

fn trait_impl#ToString#uint32#to_string(self/158: uint32) -> string {
  @runtime(core.uint32_to_string)(self/158)
}

fn trait_impl#ToString#int16#to_string(self/153: int16) -> string {
  @runtime(core.int16_to_string)(self/153)
}