    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_int64(value: i64) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_uint(value: usize) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_uint8(value: u8) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_uint16(value: u16) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_uint32(value: u32) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u64 = value.to_uint64();
}

fn exercise_uint64(value: u64) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
}

fn main() -> unit {
    exercise_int(1);
    exercise_int8(1);
    exercise_int16(1);
    exercise_int32(1);
    exercise_int64(1);
    exercise_uint(1);
    exercise_uint8(1);
    exercise_uint16(1);
    exercise_uint32(1);
    exercise_uint64(1);
    let value: i16 = 511;
    println(value.to_uint8());
    println(WRAPPED);
    println(LETTER);
    println(narrow_at_compile_time(-1));
    let octet: byte = b'\xff';
    println(octet.to_int16())
}

