package main;
const NEGATIVE_ONE: i16 = -1;

const WRAPPED: u8 = NEGATIVE_ONE.to_uint8();

const LETTER: u32 = 'A'.to_uint32();

#[comptime]
fn narrow_at_compile_time(value: i16) -> u8 {
    value.to_uint8()
}

fn exercise_int(value: isize) -> unit {
    let _: i8 = value.to_int8();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_int8(value: i8) -> unit {
    let _: isize = value.to_int();
    let _: i16 = value.to_int16();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

fn exercise_int16(value: i16) -> unit {
    let _: isize = value.to_int();
    let _: i8 = value.to_int8();
    let _: i32 = value.to_int32();
    let _: i64 = value.to_int64();
    let _: usize = value.to_uint();
    let _: u8 = value.to_uint8();
    let _: u16 = value.to_uint16();
    let _: u32 = value.to_uint32();
    let _: u64 = value.to_uint64();
}

