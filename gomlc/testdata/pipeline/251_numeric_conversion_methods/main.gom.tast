    let _ : u16 = (i8::to_uint16 : (i8) -> u16)((value/2 : i8));
    let _ : u32 = (i8::to_uint32 : (i8) -> u32)((value/2 : i8));
    let _ : u64 = (i8::to_uint64 : (i8) -> u64)((value/2 : i8));
}

