const NEGATIVE_ONE: i16 = -(1);
const WRAPPED: u8 = 255;
const LETTER: u32 = 65;

fn narrow_at_compile_time(value/0: i16) -> u8 {
    (i16::to_uint8 : (i16) -> u8)((value/0 : i16))
}

fn exercise_int(value/1: isize) -> unit {
    let _ : i8 = (isize::to_int8 : (isize) -> i8)((value/1 : isize));
    let _ : i16 = (isize::to_int16 : (isize) -> i16)((value/1 : isize));
    let _ : i32 = (isize::to_int32 : (isize) -> i32)((value/1 : isize));
    let _ : i64 = (isize::to_int64 : (isize) -> i64)((value/1 : isize));
    let _ : usize = (isize::to_uint : (isize) -> usize)((value/1 : isize));
    let _ : u8 = (isize::to_uint8 : (isize) -> u8)((value/1 : isize));
    let _ : u16 = (isize::to_uint16 : (isize) -> u16)((value/1 : isize));
    let _ : u32 = (isize::to_uint32 : (isize) -> u32)((value/1 : isize));
    let _ : u64 = (isize::to_uint64 : (isize) -> u64)((value/1 : isize));
}

