fn main() -> unit {
    (exercise_int : (isize) -> unit)(1);
    (exercise_int8 : (i8) -> unit)(1);
    (exercise_int16 : (i16) -> unit)(1);
    (exercise_int32 : (i32) -> unit)(1);
    (exercise_int64 : (i64) -> unit)(1);
    (exercise_uint : (usize) -> unit)(1);
    (exercise_uint8 : (u8) -> unit)(1);
    (exercise_uint16 : (u16) -> unit)(1);
    (exercise_uint32 : (u32) -> unit)(1);
    (exercise_uint64 : (u64) -> unit)(1);
    let value/11: i16 = 511;
    (println : (u8) -> unit)((i16::to_uint8 : (i16) -> u8)((value/11 : i16)));
    (println : (u8) -> unit)((WRAPPED : u8));
    (println : (u32) -> unit)((LETTER : u32));
    (println : (u8) -> unit)((narrow_at_compile_time : (i16) -> u8)(-1));
    let octet/12: u8 = 255;
    (println : (i16) -> unit)((u8::to_int16 : (u8) -> i16)((octet/12 : u8)))
}