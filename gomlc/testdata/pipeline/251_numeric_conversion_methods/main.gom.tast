fn main() -> unit {
    (exercise_int : (int) -> unit)(1);
    (exercise_int8 : (int8) -> unit)(1);
    (exercise_int16 : (int16) -> unit)(1);
    (exercise_int32 : (int32) -> unit)(1);
    (exercise_int64 : (int64) -> unit)(1);
    (exercise_uint : (uint) -> unit)(1);
    (exercise_uint8 : (uint8) -> unit)(1);
    (exercise_uint16 : (uint16) -> unit)(1);
    (exercise_uint32 : (uint32) -> unit)(1);
    (exercise_uint64 : (uint64) -> unit)(1);
    let value/11: int16 = 511;
    (println : (uint8) -> unit)((int16::to_uint8 : (int16) -> uint8)((value/11 : int16)));
    (println : (uint8) -> unit)((WRAPPED : uint8));
    (println : (uint32) -> unit)((LETTER : uint32));
    (println : (uint8) -> unit)((narrow_at_compile_time : (int16) -> uint8)(-1));
    let octet/12: uint8 = 255;
    (println : (int16) -> unit)((uint8::to_int16 : (uint8) -> int16)((octet/12 : uint8)))
}