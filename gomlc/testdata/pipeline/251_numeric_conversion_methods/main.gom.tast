const NEGATIVE_ONE: int16 = -(1);
const WRAPPED: uint8 = 255;
const LETTER: uint32 = 65;

fn narrow_at_compile_time(value/0: int16) -> uint8 {
    (int16::to_uint8 : (int16) -> uint8)((value/0 : int16))
}

fn exercise_int(value/1: int) -> unit {
    let _ : int8 = (int::to_int8 : (int) -> int8)((value/1 : int));
    let _ : int16 = (int::to_int16 : (int) -> int16)((value/1 : int));
    let _ : int32 = (int::to_int32 : (int) -> int32)((value/1 : int));
    let _ : int64 = (int::to_int64 : (int) -> int64)((value/1 : int));
    let _ : uint = (int::to_uint : (int) -> uint)((value/1 : int));
    let _ : uint8 = (int::to_uint8 : (int) -> uint8)((value/1 : int));
    let _ : uint16 = (int::to_uint16 : (int) -> uint16)((value/1 : int));
    let _ : uint32 = (int::to_uint32 : (int) -> uint32)((value/1 : int));
    let _ : uint64 = (int::to_uint64 : (int) -> uint64)((value/1 : int));
}

