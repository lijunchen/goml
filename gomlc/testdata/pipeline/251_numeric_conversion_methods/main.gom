const NEGATIVE_ONE: int16 = -1;

const WRAPPED: uint8 = NEGATIVE_ONE.to_uint8();

const LETTER: uint32 = 'A'.to_uint32();

#[comptime]
fn narrow_at_compile_time(value: int16) -> uint8 {
    value.to_uint8()
}

fn exercise_int(value: int) -> unit {
    let _: int8 = value.to_int8();
    let _: int16 = value.to_int16();
    let _: int32 = value.to_int32();
    let _: int64 = value.to_int64();
    let _: uint = value.to_uint();
    let _: uint8 = value.to_uint8();
    let _: uint16 = value.to_uint16();
    let _: uint32 = value.to_uint32();
    let _: uint64 = value.to_uint64();
}

fn exercise_int8(value: int8) -> unit {
    let _: int = value.to_int();
    let _: int16 = value.to_int16();
    let _: int32 = value.to_int32();
    let _: int64 = value.to_int64();
    let _: uint = value.to_uint();
    let _: uint8 = value.to_uint8();
    let _: uint16 = value.to_uint16();
    let _: uint32 = value.to_uint32();
    let _: uint64 = value.to_uint64();
}

