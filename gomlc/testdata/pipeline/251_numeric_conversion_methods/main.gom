    let _: uint16 = value.to_uint16();
    let _: uint32 = value.to_uint32();
}

fn main() -> unit {
    exercise_int(1);
    exercise_int8(1);
    exercise_int16(1);
    exercise_int32(1);
    exercise_int64(1);
    exercise_uint(1);
    exercise_uint8(1);
    exercise_uint16(1);
    exercise_uint32(1);
    exercise_uint64(1);
    let value: int16 = 511;
    println(value.to_uint8());
    println(WRAPPED);
    println(LETTER);
    println(narrow_at_compile_time(-1));
    let octet: byte = b'\xFF';
    println(octet.to_int16())
}
