    }

    impl[T, Marker] Eq for Generic[T, Marker] where Wrapper[T]: Eq {
      fn eq(local/1/7: Generic[T, Marker], local/1/8: Generic[T, Marker]) -> bool {
          true && Eq::eq(self/7.first, other/8.first) && Eq::eq(self/7.second, other/8.second)
      }
    }

    impl[T, Marker] Hash for Generic[T, Marker] where Wrapper[T]: Hash {
      fn hash(local/1/9: Generic[T, Marker]) -> uint64 {
          let local/1/10: uint64 = 14695981039346656037;
          let local/1/11 = h/10 * 1099511628211 + Hash::hash(self/9.first);
          let local/1/12 = h/11 * 1099511628211 + Hash::hash(self/9.second);
          h/12
      }
    }

    #[derive(ToString, Eq, Hash)]
enum GenericChoice[T, Marker] {
        Empty,
        Value(Wrapper[T])
    }

    impl[T, Marker] ToString for GenericChoice[T, Marker] where Wrapper[T]: ToString {
      fn to_string(local/1/13: GenericChoice[T, Marker]) -> string {
          match self/13 {
              ctor(def/1/9::v0) => "GenericChoice::Empty",
              ctor(def/1/9::v1)(local/1/14) => "GenericChoice::Value(" + __field0/14.to_string() + ")",
          }
      }
    }

    impl[T, Marker] Eq for GenericChoice[T, Marker] where Wrapper[T]: Eq {
      fn eq(local/1/15: GenericChoice[T, Marker], local/1/16: GenericChoice[T, Marker]) -> bool {
          match (self/15, other/16) {
              (ctor(def/1/9::v0), ctor(def/1/9::v0)) => true,
              (ctor(def/1/9::v1)(local/1/17), ctor(def/1/9::v1)(local/1/18)) => true && Eq::eq(__l1_0/17, __r1_0/18),
              _ => false,
          }
      }
    }

    impl[T, Marker] Hash for GenericChoice[T, Marker] where Wrapper[T]: Hash {
      fn hash(local/1/19: GenericChoice[T, Marker]) -> uint64 {
          match self/19 {
              ctor(def/1/9::v0) => {
                    let local/1/20: uint64 = 14695981039346656037 + 1;
                    h/20
                },
              ctor(def/1/9::v1)(local/1/21) => {
                    let local/1/22: uint64 = 14695981039346656037 + 2;
                    let local/1/23 = h/22 * 1099511628211 + Hash::hash(__field1_0/21);
                    h/23
                },
          }
      }
    }

    fn main() -> unit {
        let local/1/24 = Wrapper {
            value: NoTraits {
                value: 1
            }
        };
        let local/1/25: Generic[NoTraits, NoTraits] = Generic {
            first: wrapped/24,
            second: wrapped/24
        };
        let local/1/26: Generic[NoTraits, NoTraits] = Generic {
            first: wrapped/24,
            second: wrapped/24
        };
        println(left/25.to_string());
        println(left/25 == right/26);
        println(left/25.hash() == right/26.hash());
        let local/1/27: GenericChoice[NoTraits, NoTraits] = ctor(def/1/9::v0);
        let local/1/28: GenericChoice[NoTraits, NoTraits] = ctor(def/1/9::v1)(wrapped/24);
        println(empty/27.to_string());
        println(value/28.to_string());
        println(empty/27 != value/28);
        println(value/28.hash() == value/28.hash())
    }