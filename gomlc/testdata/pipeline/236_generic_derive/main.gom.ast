package main;
struct NoTraits {
    value: int,
}

struct Wrapper[T] {
    value: T,
}

impl[T] ToString for Wrapper[T] {
  fn to_string(self: Wrapper[T]) -> string {
      "wrapped"
  }
}

impl[T] Eq for Wrapper[T] {
  fn eq(self: Wrapper[T], other: Wrapper[T]) -> bool {
      true
  }
}

impl[T] Hash for Wrapper[T] {
  fn hash(self: Wrapper[T]) -> uint64 {
      7
  }
}

#[derive(ToString, Eq, Hash)]
struct Generic[T, Marker] {
    first: Wrapper[T],
    second: Wrapper[T],
}

impl[T, Marker] ToString for Generic[T, Marker] where Wrapper[T]: ToString {
  fn to_string(self: Generic[T, Marker]) -> string {
      {
          let Generic { first: #derive0_field, second: #derive1_field } = self;
          "Generic { " + "first: " + ToString::to_string(#derive0_field) + ", " + "second: " +
            ToString::to_string(#derive1_field) +
            " }"
      }
  }
}

impl[T, Marker] Eq for Generic[T, Marker] where Wrapper[T]: Eq {
  fn eq(self: Generic[T, Marker], other: Generic[T, Marker]) -> bool {
      true && Eq::eq(self.first, other.first) && Eq::eq(self.second, other.second)
  }
}

impl[T, Marker] Hash for Generic[T, Marker] where Wrapper[T]: Hash {
  fn hash(self: Generic[T, Marker]) -> uint64 {
      {
          let h = 0 as uint64 + 14695981039346656037;
          let h = h * 0 as uint64 + 1099511628211 + Hash::hash(self.first);
          let h = h * 0 as uint64 + 1099511628211 + Hash::hash(self.second);
          h
      }
  }
}

#[derive(ToString, Eq, Hash)]
enum GenericChoice[T, Marker] {
    Empty,
    Value(Wrapper[T])
}

impl[T, Marker] ToString for GenericChoice[T, Marker] where Wrapper[T]: ToString {
  fn to_string(self: GenericChoice[T, Marker]) -> string {
      match self {
          GenericChoice::Empty => "GenericChoice::Empty",
          GenericChoice::Value(#derive0_field) =>
            "GenericChoice::Value(" + ToString::to_string(#derive0_field) + ")",
      }
  }
}

impl[T, Marker] Eq for GenericChoice[T, Marker] where Wrapper[T]: Eq {
  fn eq(self: GenericChoice[T, Marker], other: GenericChoice[T, Marker]) -> bool {
      match (self, other) {
          (GenericChoice::Empty, GenericChoice::Empty) => true,
          (GenericChoice::Value(#derive0_left), GenericChoice::Value(#derive1_right)) =>
            true && Eq::eq(#derive0_left, #derive1_right),
          _ => false,
      }
  }
}

impl[T, Marker] Hash for GenericChoice[T, Marker] where Wrapper[T]: Hash {
  fn hash(self: GenericChoice[T, Marker]) -> uint64 {
      match self {
          GenericChoice::Empty =>
            {
                let h = 0 as uint64 + 14695981039346656037 + 1;
                h
            },
          GenericChoice::Value(#derive0_field) =>
            {
                let h = 0 as uint64 + 14695981039346656037 + 2;
                let h = h * 0 as uint64 + 1099511628211 + Hash::hash(#derive0_field);
                h
            },
      }
  }
}

fn main() -> unit {
    let wrapped = Wrapper { value: NoTraits { value: 1 } };
    let left: Generic[NoTraits, NoTraits] = Generic { first: wrapped, second: wrapped };
    let right: Generic[NoTraits, NoTraits] = Generic { first: wrapped, second: wrapped };
    println(left.to_string());
    println(left == right);
    println(left.hash() == right.hash());
    let empty: GenericChoice[NoTraits, NoTraits] = GenericChoice::Empty;
    let value: GenericChoice[NoTraits, NoTraits] = GenericChoice::Value(wrapped);
    println(empty.to_string());
    println(value.to_string());
    println(empty != value);
    println(value.hash() == value.hash())
}

