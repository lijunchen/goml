fn match_mixed_pair(pair/0: (int32, string)) -> int32 {
  let x155 = pair/0.0 in
  let x156 = pair/0.1 in
  match x156 {
    "zero" => {
      match x155 {
        0 => {
          1
        },
        _ => 4,
      }
    },
    "one" => {
      match x155 {
        0 => {
          2
        },
        1 => {
          3
        },
        _ => 5,
      }
    },
    _ => match x155 {
      0 => {
        2
      },
      _ => 5,
    },
  }
}

fn match_mixed_enum(value/1: Mixed) -> int32 {
  match value/1 {
    Mixed::OnlyInt(x157) => {
