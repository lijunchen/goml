        },
        _ => 9,
      }
    },
    Mixed::Both(x112, x113) => {
      let x112 = Mixed::Both._0(value/1) in
      let x113 = Mixed::Both._1(value/1) in
      match x113 {
        "zero" => {
          match x112 {
            0 => {
              10
            },
            _ => 12,
          }
        },
        _ => match x112 {
          0 => {
            11
          },
          _ => 13,
        },
      }
    },
  }
}

