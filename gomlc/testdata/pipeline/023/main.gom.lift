fn match_mixed_pair(pair/0: (int32, string)) -> int32 {
  let x108 = pair/0.0 in
  let x109 = pair/0.1 in
  match x109 {
    "zero" => {
      match x108 {
        0 => {
          1
        },
        _ => 4,
      }
    },
    "one" => {
      match x108 {
        0 => {
          2
        },
        1 => {
          3
        },
        _ => 5,
      }
    },
    _ => match x108 {
      0 => {
        2
      },
      _ => 5,
    },
  }
}

fn match_mixed_enum(value/1: Mixed) -> int32 {
  match value/1 {
    Mixed::OnlyInt(x110) => {
