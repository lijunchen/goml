        _ => 4,
      }
    },
    "one" => {
      match x182 {
        0 => {
          2
        },
        1 => {
          3
        },
        _ => 5,
      }
    },
    _ =>
      match x182 {
        0 => {
          2
        },
        _ => 5,
      },
  }
}

