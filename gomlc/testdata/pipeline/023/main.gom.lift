fn match_mixed_pair(pair/0: (int32, string)) -> int32 {
  let x172 = pair/0.0 in
  let x173 = pair/0.1 in
  match x173 {
    "zero" => {
      match x172 {
        0 => {
          1
        },
        _ => 4,
      }
    },
    "one" => {
      match x172 {
        0 => {
          2
        },
        1 => {
          3
        },
        _ => 5,
      }
    },
    _ =>
      match x172 {
        0 => {
          2
        },
        _ => 5,
      },
  }
}

fn match_mixed_enum(value/1: Mixed) -> int32 {
