      }
    },
    Mixed::Both(x159, x160) => {
      let x159 = Mixed::Both._0(value/1) in
      let x160 = Mixed::Both._1(value/1) in
      match x160 {
        "zero" => {
          match x159 {
            0 => {
              10
            },
            _ => 12,
          }
        },
        _ => match x159 {
          0 => {
            11
          },
          _ => 13,
        },
      }
    },
  }
}

