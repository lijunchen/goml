package main
file main.gom
  trait Show {
      fn show(Self) -> string;
    }

    enum Boxed[T] {
        One(T)
    }

    impl Show for Boxed[int32] {
      fn show(local/1/0: Boxed[int32]) -> string {
          match self/0 {
              ctor(def/1/1::v0)(local/1/1) => value/1.to_string(),
          }
      }
    }

    fn render(local/1/2: dyn Show) -> string {
        Show::show(value/2)
    }

    fn main() -> unit {
        let local/1/3: int32 = 42;
        println(def/1/3(ctor(def/1/1::v0)(value/3)))
    }