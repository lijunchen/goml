impl Show for Boxed[int32] {
  fn show(self/0: Boxed[int32]) -> string {
      match (self/0 : Boxed[int32]) {
          Boxed::One(value/1: int32) => (int32::to_string : (int32) -> string)((value/1 : int32)),
      }
  }
}

fn render(value/2: dyn Show) -> string {
    (dyn Show::show : (dyn Show) -> string)((value/2 : dyn Show))
}

fn main() -> unit {
    let value/3: int32 = 42;
    (println : (string) -> unit)(
      (render : (dyn Show) -> string)(to_dyn[Show]{Boxed[int32]}(Boxed::One((value/3 : int32))))
    )
}