package main;
trait Mark {
  fn mark(self: Self) -> string;
}

trait Container[T: Mark] {
  fn value(self: Self) -> T;
}

struct NumberBox {
    value: int32,
}

impl Mark for int32 {
  fn mark(self: int32) -> string {
      "marked:" + self.to_string()
  }
}

impl Container[int32] for NumberBox {
  fn value(self: NumberBox) -> int32 {
      self.value
  }
}

fn describe[T, C: Container[T]](container: C) -> string {
    Container::[T]::value(container).mark()
}

fn main() -> unit {
    println(describe(NumberBox {
            value: 7
        }));
}

