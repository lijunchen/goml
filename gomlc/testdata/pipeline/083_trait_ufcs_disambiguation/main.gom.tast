impl A for S{
  fn pick(self/0: S) -> int32 {
      10
  }
}

impl B for S{
  fn pick(self/1: S) -> int32 {
      20
  }
}

fn pick_a[T](x/2: T) -> int32 where T: A, T: B {
    (A::pick : (T) -> int32)((x/2 : T))
}

fn pick_b[T](x/3: T) -> int32 where T: A, T: B {
    (B::pick : (T) -> int32)((x/3 : T))
}

fn main() -> unit {
    (println : (string) -> unit)((int32::to_string : (int32) -> string)((pick_a : (S) -> int32)(S {})));
    (println : (string) -> unit)((int32::to_string : (int32) -> string)((pick_b : (S) -> int32)(S {})));
}