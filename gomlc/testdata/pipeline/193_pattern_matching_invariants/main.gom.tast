fn absurd(value/0: Never) -> int32 {
    match (value/0 : Never) {}
}

fn absurd_loop(value/1: Loop) -> int32 {
    match (value/1 : Loop) {}
}

fn maybe_never(value/2: MaybeNever) -> int32 {
    match (value/2 : MaybeNever) {
        MaybeNever::Empty => 0,
    }
}

fn empty_never_vec(value/3: Vec[Never]) -> int32 {
    match (value/3 : Vec[Never]) {
        [] => 0,
    }
}

fn sequence_coverage(value/4: Vec[bool]) -> int32 {
    match (value/4 : Vec[bool]) {
        [] => 0,
        [_ : bool] => 1,
        [true, .., _ : bool] => 2,
        [false, .., _ : bool] => 3,
    }
}

fn unwrap(value/5: Single) -> int32 {
    let Single::Only(inner/6: int32) = (value/5 : Single);
    (inner/6 : int32)
}

fn decide(flag/7: bool) -> int32 {
    match (flag/7 : bool) {
        true => return 1,
        false => return 2,
    }
}

fn signed_zero(value/8: float64) -> string {
    match (value/8 : float64) {
        -0 => "zero",
        _ : float64 => "other",
    }
}

fn main() -> unit {
    let (single/9: Single) = (Single::Only(12));
    (println : (int32) -> unit)((unwrap : (Single) -> int32)((single/9 : Single)));
    (println : (int32) -> unit)((decide : (bool) -> int32)(true));
    (println : (string) -> unit)((signed_zero : (float64) -> string)(0));
}