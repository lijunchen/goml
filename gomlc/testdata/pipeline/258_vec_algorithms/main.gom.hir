package main
file main.gom
  fn main() -> unit {
      let local/1/0 = Vec::[3, 1, 4, 1, 5, 9, 2, 6];
      println(values/0.position(|local/1/1: int| value/1 == 5).unwrap_or(-1).to_string());
      println(values/0.position(|local/1/2: int| value/2 == 99).unwrap_or(-1).to_string());
      values/0.sort_by(|local/1/3: int, local/1/4: int| left/3 - right/4);
      println(values/0.join(","));
      values/0.dedup();
      println(values/0.join(","));
      let local/1/5 = Vec::[1, 2, 4, 4, 5];
      println(ordered/5.binary_search_by(|local/1/6: int| value/6 - 4).unwrap_or(-1).to_string());
      println(ordered/5.binary_search_by(|local/1/7: int| value/7 - 3).unwrap_or(-1).to_string());
      println(
        ordered/5.min_by(|local/1/8: int, local/1/9: int| left/8 - right/9).unwrap_or(0).to_string()
      );
      println(
        ordered/5.max_by(|local/1/10: int, local/1/11: int| left/10 - right/11).unwrap_or(
          0
        ).to_string()
      );
      let local/1/12 = Vec::["beta", "alpha", "gamma"];
      names/12.sort_by_ordering(
        |local/1/13: string, local/1/14: string| cmp::compare(left/13, right/14)
      );
      println(names/12.join("|"));
      let local/1/15 = Vec::[(1, 2), (1, 1), (0, 9)];
      pairs/15.sort_by_ordering(
        |local/1/16: (int, int), local/1/17: (int, int)| cmp::compare(left/16.0, right/17.0)
      );
      println(pairs/15.len().to_string());
      let local/1/18 = Vec::[7, 8, 9].slice(0, 2);
      println(view/18.contains(8).to_string());
      println(view/18.contains(9).to_string());
      let local/1/19 = Vec::[1, 2].freeze();
      println(frozen/19.contains(1).to_string());
      println(frozen/19.contains(3).to_string());
      let local/1/20: Vec[int] = Vec::[];
      println(empty/20.join(","));
      println(
        empty/20.min_by(|local/1/21: int, local/1/22: int| left/21 - right/22).is_none().to_string()
      )
  }