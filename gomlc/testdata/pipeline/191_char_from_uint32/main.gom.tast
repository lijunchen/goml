fn show_scalar(value/0: u32) -> unit {
    match (char_from_uint32 : (u32) -> Option[char])((value/0 : u32)) {
        Option::Some(result/1: char) =>
          (println : (u32) -> unit)((char::to_uint32 : (char) -> u32)((result/1 : char))),
        Option::None => (println : (string) -> unit)("none"),
    }
}

fn main() -> unit {
    (show_scalar : (u32) -> unit)(0);
    (show_scalar : (u32) -> unit)(65);
    (show_scalar : (u32) -> unit)(55295);
    (show_scalar : (u32) -> unit)(55296);
    (show_scalar : (u32) -> unit)(57343);
    (show_scalar : (u32) -> unit)(57344);
    (show_scalar : (u32) -> unit)(1114111);
    (show_scalar : (u32) -> unit)(1114112);
    match (char_from_uint32 : (u32) -> Option[char])(128512) {
        Option::Some(result/2: char) =>
          (println : (string) -> unit)((char::to_string : (char) -> string)((result/2 : char))),
        Option::None => (println : (string) -> unit)("none"),
    }
}