package main
file main.gom
  fn show_scalar(local/1/0: uint32) -> unit {
        match char_from_uint32(value/0) {
            Option::Some(local/1/1) => println(result/1 as uint32),
            Option::None => println("none"),
        }
    }
    
    fn main() -> unit {
        def/1/0(0);
        def/1/0(65);
        def/1/0(55295);
        def/1/0(55296);
        def/1/0(57343);
        def/1/0(57344);
        def/1/0(1114111);
        def/1/0(1114112);
        match char_from_uint32(128512) {
            Option::Some(local/1/2) => println(result/2.to_string()),
            Option::None => println("none"),
        }
    }