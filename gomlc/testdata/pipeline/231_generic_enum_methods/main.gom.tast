impl[T] Maybe[T] {
  fn map[U](self/0: Maybe[T], map_fn/1: (T) -> U) -> Maybe[U] {
      match (self/0 : Maybe[T]) {
          Maybe::Some(value/2: T) => Maybe::Some((map_fn/1 : (T) -> U)((value/2 : T))),
          Maybe::None => Maybe::None,
      }
  }
}

fn main() -> unit {
    let value/3: Maybe[int] = Maybe::Some(3);
    match (Maybe[int]::map : (Maybe[int], (int) -> string) -> Maybe[string])(
      (value/3 : Maybe[int]),
      |item/4: int| => (int::to_string : (int) -> string)((item/4 : int))
    ) {
        Maybe::Some(text/5: string) => (println : (string) -> unit)((text/5 : string)),
        Maybe::None => (println : (string) -> unit)("none"),
    }
}