fn check_utf8(bytes/0: Vec[uint8], expected/1: bool) -> unit {
    let expected_length/2: int = (Vec[uint8]::len : (Vec[uint8]) -> int)((bytes/0 : Vec[uint8]));
    let (valid/3: bool, value/4: string) =
      (string_from_utf8 : (Vec[uint8]) -> (bool, string))((bytes/0 : Vec[uint8]));
    (println : (bool) -> unit)((valid/3 : bool) == (expected/1 : bool));
    if (valid/3 : bool) {
        {
            (println : (bool) -> unit)(
              (string::byte_len : (string) -> int)((value/4 : string)) == (expected_length/2 : int)
            )
        }
    } else {
        {
            (println : (bool) -> unit)((value/4 : string) == "")
        }
    }
}

fn check_scalar(bytes/5: Vec[uint8], expected/6: uint32, expected_width/7: int) -> unit {
    let (valid/8: bool, value/9: string) =
      (string_from_utf8 : (Vec[uint8]) -> (bool, string))((bytes/5 : Vec[uint8]));
    (println : (bool) -> unit)((valid/8 : bool));
    match (string::decode_at : (string, int) -> Option[(char, int)])((value/9 : string), 0) {
        Option::Some(decoded/10: (char, int)) =>
          {
              let (character/11: char, width/12: int) = (decoded/10 : (char, int));
              (println : (bool) -> unit)((character/11 : char) as uint32 == (expected/6 : uint32));
              (println : (bool) -> unit)((width/12 : int) == (expected_width/7 : int))
          },
        Option::None =>
          {
              (println : (bool) -> unit)(false);
              (println : (bool) -> unit)(false)
          },
    }
}

