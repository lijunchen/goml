fn check_utf8(bytes/0: Vec[uint8], expected/1: bool) -> unit {
    let expected_length/2: int = (Vec[uint8]::len : (Vec[uint8]) -> int)((bytes/0 : Vec[uint8]));
    let (valid/3: bool, value/4: string) =
      (string_from_utf8 : (Vec[uint8]) -> (bool, string))((bytes/0 : Vec[uint8]));
    (println : (bool) -> unit)((valid/3 : bool) == (expected/1 : bool));
    if (valid/3 : bool) {
        {
            (println : (bool) -> unit)(
              (string::byte_len : (string) -> int)((value/4 : string)) == (expected_length/2 : int)
            )
        }
    } else {
        {
            (println : (bool) -> unit)((value/4 : string) == "")
        }
    }
}

fn check_scalar(bytes/5: Vec[uint8], expected/6: uint32, expected_width/7: int) -> unit {
    let (valid/8: bool, value/9: string) =
      (string_from_utf8 : (Vec[uint8]) -> (bool, string))((bytes/5 : Vec[uint8]));
    (println : (bool) -> unit)((valid/8 : bool));
    match (string::decode_at : (string, int) -> Option[(char, int)])((value/9 : string), 0) {
        Option::Some(decoded/10: (char, int)) =>
          {
              let (character/11: char, width/12: int) = (decoded/10 : (char, int));
              (println : (bool) -> unit)(
                (char::to_uint32 : (char) -> uint32)((character/11 : char)) == (expected/6 : uint32)
              );
              (println : (bool) -> unit)((width/12 : int) == (expected_width/7 : int))
          },
        Option::None =>
          {
              (println : (bool) -> unit)(false);
              (println : (bool) -> unit)(false)
          },
    }
}

fn main() -> unit {
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 0]) -> Vec[uint8])([]),
      true
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 1]) -> Vec[uint8])([0]),
      true
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 1]) -> Vec[uint8])([127]),
      true
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 2]) -> Vec[uint8])([194, 128]),
      128,
      2
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 2]) -> Vec[uint8])([223, 191]),
      2047,
      2
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([224, 160, 128]),
      2048,
      3
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([237, 159, 191]),
      55295,
      3
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([238, 128, 128]),
      57344,
      3
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([239, 191, 189]),
      65533,
      3
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([239, 191, 191]),
      65535,
      3
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 4]) -> Vec[uint8])([240, 144, 128, 128]),
      65536,
      4
    );
    (check_scalar : (Vec[uint8], uint32, int) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 4]) -> Vec[uint8])([244, 143, 191, 191]),
      1114111,
      4
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 1]) -> Vec[uint8])([128]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 1]) -> Vec[uint8])([191]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 2]) -> Vec[uint8])([192, 128]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 2]) -> Vec[uint8])([193, 191]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 1]) -> Vec[uint8])([194]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 2]) -> Vec[uint8])([194, 127]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([224, 159, 191]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 2]) -> Vec[uint8])([225, 128]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([225, 128, 127]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([237, 160, 128]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 4]) -> Vec[uint8])([240, 143, 191, 191]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 3]) -> Vec[uint8])([240, 144, 128]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 4]) -> Vec[uint8])([244, 144, 128, 128]),
      false
    );
    (check_utf8 : (Vec[uint8], bool) -> unit)(
      (@intrinsic(vec.from_array) : ([uint8; 4]) -> Vec[uint8])([245, 128, 128, 128]),
      false
    )
}