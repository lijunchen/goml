fn main() -> unit {
    let sum/0: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let i/1: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(1);
    while (Ref[int]::get : (Ref[int]) -> int)((i/1 : Ref[int])) <= 100 {
        {
            if (Ref[int]::get : (Ref[int]) -> int)((i/1 : Ref[int])) == 50 {
                {
                    break
                }
            } else {
                {
                    ()
                }
            };
            (Ref[int]::set : (Ref[int], int) -> unit)(
              (sum/0 : Ref[int]),
              (Ref[int]::get : (Ref[int]) -> int)((sum/0 : Ref[int])) +
                (Ref[int]::get : (Ref[int]) -> int)((i/1 : Ref[int]))
            );
            (Ref[int]::set : (Ref[int], int) -> unit)(
              (i/1 : Ref[int]),
              (Ref[int]::get : (Ref[int]) -> int)((i/1 : Ref[int])) + 1
            );
        }
    };
    let _ : unit = (print : (string) -> unit)("sum up to break: ");
    let _ : unit =
      (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((sum/0 : Ref[int])));
    let even_sum/2: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let j/3: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(1);
    while (Ref[int]::get : (Ref[int]) -> int)((j/3 : Ref[int])) <= 10 {
        {
            let cur/4: int = (Ref[int]::get : (Ref[int]) -> int)((j/3 : Ref[int]));
            (Ref[int]::set : (Ref[int], int) -> unit)((j/3 : Ref[int]), (cur/4 : int) + 1);
            if (cur/4 : int) == (cur/4 : int) / 2 * 2 {
                {
                    (Ref[int]::set : (Ref[int], int) -> unit)(
                      (even_sum/2 : Ref[int]),
                      (Ref[int]::get : (Ref[int]) -> int)((even_sum/2 : Ref[int])) + (cur/4 : int)
                    );
                    continue
                }
            } else {
                {
                    ()
                }
            };
        }
    };
    let _ : unit = (print : (string) -> unit)("even sum: ");
    let _ : unit =
      (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((even_sum/2 : Ref[int])));
}