fn main() -> unit {
    let sum/0: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let i/1: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(1);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])) <= 100 {
        {
            if (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])) == 50 {
                {
                    break
                }
            } else {
                {}
            };
            (Ref[isize]::set : (Ref[isize], isize) -> unit)(
              (sum/0 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((sum/0 : Ref[isize])) +
                (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize]))
            );
            (Ref[isize]::set : (Ref[isize], isize) -> unit)(
              (i/1 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((i/1 : Ref[isize])) + 1
            );
        }
    };
    let _ : unit = (print : (string) -> unit)("sum up to break: ");
    let _ : unit =
      (println : (isize) -> unit)((Ref[isize]::get : (Ref[isize]) -> isize)((sum/0 : Ref[isize])));
    let even_sum/2: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    let j/3: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(1);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((j/3 : Ref[isize])) <= 10 {
        {
            let cur/4: isize = (Ref[isize]::get : (Ref[isize]) -> isize)((j/3 : Ref[isize]));
            (Ref[isize]::set : (Ref[isize], isize) -> unit)(
              (j/3 : Ref[isize]),
              (cur/4 : isize) + 1
            );
            if (cur/4 : isize) == (cur/4 : isize) / 2 * 2 {
                {
                    (Ref[isize]::set : (Ref[isize], isize) -> unit)(
                      (even_sum/2 : Ref[isize]),
                      (Ref[isize]::get : (Ref[isize]) -> isize)((even_sum/2 : Ref[isize])) +
                        (cur/4 : isize)
                    );
                    continue
                }
            } else {
                {}
            };
        }
    };
    let _ : unit = (print : (string) -> unit)("even sum: ");
    let _ : unit =
      (println : (isize) -> unit)(
        (Ref[isize]::get : (Ref[isize]) -> isize)((even_sum/2 : Ref[isize]))
      );
}