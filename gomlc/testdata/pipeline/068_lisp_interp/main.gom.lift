          let mtmp862 = @intrinsic(vec.get)(items/87, 1) in
          match mtmp862 {
            SExpr::List(x866) => {
              let x866 = SExpr::List._0(mtmp862) in
              let params_exprs/95 = x866 in
              let params/96 = params_from_sexprs(params_exprs/95) in
              let body/97 = @intrinsic(vec.get)(items/87, 2) in
              Value::Func(
                Lambda { params: params/96, body: body/97, env: local/88, global: global/89 }
              )
