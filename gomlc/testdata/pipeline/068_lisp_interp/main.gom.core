fn apply_lambda(lambda/141: Lambda, args/142: Vec[Value]) -> Value {
  let env/143 = inherent#Ref#Ref[Vec[Binding]]#new(Lambda.env(lambda/141)) in
  let i/144 = inherent#Ref#Ref[int]#new(0) in
  let mtmp310 =
    while if (inherent#Ref#Ref[int]#get(i/144) <
      inherent#Vec#Vec[string]#len(Lambda.params(lambda/141))) {
        (inherent#Ref#Ref[int]#get(i/144) < inherent#Vec#Vec[Value]#len(args/142))
    } else {
