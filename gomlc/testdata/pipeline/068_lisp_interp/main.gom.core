                        {
                          let value/91 = eval(@intrinsic(vec.get)(items/87, 2), local/88, global/89) in
                          let env/92 = inherent#Ref#Ref[Vec[Binding]]#get(global/89) in
                          let updated/93 = inherent#Vec#Vec[Binding]#pushed(env/92, Binding { name: var/90, value: value/91 }) in
                          let mtmp133 = inherent#Ref#Ref[Vec[Binding]]#set(global/89, updated/93) in
                          {
                            value/91
                          }
                        }
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "if" => {
      {
        if trait_impl#Eq#int#eq(inherent#Vec#Vec[SExpr]#len(items/87), 4) {
            {
              let cond/94 = eval(@intrinsic(vec.get)(items/87, 1), local/88, global/89) in
              if truthy(cond/94) {
                  {
                    eval(@intrinsic(vec.get)(items/87, 2), local/88, global/89)
                  }
              } else {
                  {
                    eval(@intrinsic(vec.get)(items/87, 3), local/88, global/89)
                  }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "lambda" => {
      {
        if trait_impl#Eq#int#eq(inherent#Vec#Vec[SExpr]#len(items/87), 3) {
            {
              {
                let mtmp134 = @intrinsic(vec.get)(items/87, 1) in
                match mtmp134 {
                  SExpr::List(x138) => {
                    {
                      let x138 = SExpr::List._0(mtmp134) in
                      {
                        let params_exprs/95 = x138 in
                        {
                          let params/96 = params_from_sexprs(params_exprs/95) in
                          let body/97 = @intrinsic(vec.get)(items/87, 2) in
                          Value::Func(Lambda { params: params/96, body: body/97, env: local/88, global: global/89 })
                        }
                      }
