  }
}

fn eval_list_sym(
  name/86: string,
  items/87: Vec[SExpr],
  local/88: Vec[Binding],
  global/89: Ref[Vec[Binding]]
) -> Value {
  match name/86 {
    "begin" => {
      eval_begin(items/87, 1, local/88, global/89)
    },
    "define" => {
      {
        if trait_call[Eq::eq](inherent#Vec#Vec[SExpr]#len(items/87), 3) {
            {
              {
                let mtmp237 = @intrinsic(vec.get)(items/87, 1) in
                match mtmp237 {
                  SExpr::Sym(x240) => {
                    {
                      let x240 = SExpr::Sym._0(mtmp237) in
                      {
                        let var/90 = x240 in
                        {
                          let value/91 =
                            eval(@intrinsic(vec.get)(items/87, 2), local/88, global/89) in
                          let env/92 = inherent#Ref#Ref[Vec[Binding]]#get(global/89) in
                          let updated/93 =
                            inherent#Vec#Vec[Binding]#pushed(
                              env/92,
                              Binding { name: var/90, value: value/91 }
                            ) in
                          let mtmp242 = inherent#Ref#Ref[Vec[Binding]]#set(global/89, updated/93) in
                          {
                            value/91
                          }
                        }
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "if" => {
      {
        if trait_call[Eq::eq](inherent#Vec#Vec[SExpr]#len(items/87), 4) {
            {
              let cond/94 = eval(@intrinsic(vec.get)(items/87, 1), local/88, global/89) in
              if truthy(cond/94) {
                  {
                    eval(@intrinsic(vec.get)(items/87, 2), local/88, global/89)
                  }
              } else {
                  {
                    eval(@intrinsic(vec.get)(items/87, 3), local/88, global/89)
                  }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "lambda" => {
      {
        if trait_call[Eq::eq](inherent#Vec#Vec[SExpr]#len(items/87), 3) {
            {
              {
                let mtmp243 = @intrinsic(vec.get)(items/87, 1) in
                match mtmp243 {
                  SExpr::List(x247) => {
                    {
                      let x247 = SExpr::List._0(mtmp243) in
                      {
                        let params_exprs/95 = x247 in
                        {
                          let params/96 = params_from_sexprs(params_exprs/95) in
                          let body/97 = @intrinsic(vec.get)(items/87, 2) in
                          Value::Func(
                            Lambda {
                              params: params/96,
                              body: body/97,
                              env: local/88,
                              global: global/89
                            }
                          )
                        }
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "+" => {
      apply_builtin("+", eval_args(items/87, 1, local/88, global/89))
    },
    "-" => {
      apply_builtin("-", eval_args(items/87, 1, local/88, global/89))
    },
    "*" => {
      apply_builtin("*", eval_args(items/87, 1, local/88, global/89))
    },
    "/" => {
      apply_builtin("/", eval_args(items/87, 1, local/88, global/89))
    },
    "=" => {
      apply_builtin("=", eval_args(items/87, 1, local/88, global/89))
    },
    _ =>
      {
        let f/98 = eval(SExpr::Sym(name/86), local/88, global/89) in
        let args/99 = eval_args(items/87, 1, local/88, global/89) in
        apply(f/98, args/99, global/89)
      },
  }
}

