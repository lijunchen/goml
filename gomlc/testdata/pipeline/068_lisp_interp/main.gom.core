fn eval_list_sym(name/86: string, items/87: Vec[SExpr], local/88: Vec[Binding], global/89: Ref[Vec[Binding]]) -> Value {
  match name/86 {
    "begin" => {
      eval_begin(items/87, 1, local/88, global/89)
    },
    "define" => {
      {
        if trait_impl#Eq#int#eq(inherent#Vec#Vec[SExpr]#len(items/87), 3) {
            {
              {
                let mtmp128 = @intrinsic(vec.get)(items/87, 1) in
                match mtmp128 {
                  SExpr::Sym(x131) => {
                    {
                      let x131 = SExpr::Sym._0(mtmp128) in
                      {
