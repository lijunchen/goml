fn apply_builtin(name/120: string, args/121: Vec[Value]) -> Value {
  match name/120 {
    "=" => {
      if trait_call[Eq::eq](inherent#Vec#Vec[Value]#len(args/121), 2) {
          {
            {
              let mtmp218 = (@intrinsic(vec.get)(args/121, 0), @intrinsic(vec.get)(args/121, 1)) in
              {
                let x219 = mtmp218.0 in
                let x220 = mtmp218.1 in
                match x220 {
                  Value::Int(x221) => {
                    {
                      let x221 = Value::Int._0(x220) in
                      match x219 {
                        Value::Int(x224) => {
                          {
                            let x224 = Value::Int._0(x219) in
                            {
                              let a/122 = x224 in
                              {
                                let b/123 = x221 in
                                Value::Bool(trait_call[Eq::eq](a/122, b/123))
                              }
                            }
                          }
                        },
                        _ => Value::Bool(false),
                      }
                    }
                  },
                  Value::Bool(x222) => {
                    {
                      let x222 = Value::Bool._0(x220) in
                      match x219 {
                        Value::Bool(x228) => {
                          {
                            let x228 = Value::Bool._0(x219) in
                            {
                              let a/124 = x228 in
                              {
                                let b/125 = x222 in
                                Value::Bool(trait_call[Eq::eq](a/124, b/125))
                              }
                            }
                          }
                        },
                        _ => Value::Bool(false),
                      }
                    }
                  },
                  _ => Value::Bool(false),
                }
              }
            }
          }
      } else {
          {
            Value::Bool(false)
          }
      }
    },
    "+" => {
      {
        let i/126 = inherent#Ref#Ref[int]#new(0) in
        let acc/127 = inherent#Ref#Ref[int32]#new(0) in
        let mtmp235 =
          while (inherent#Ref#Ref[int]#get(i/126) < inherent#Vec#Vec[Value]#len(args/121)) {
              {
                {
                  let mtmp230 = @intrinsic(vec.get)(args/121, inherent#Ref#Ref[int]#get(i/126)) in
                  match mtmp230 {
                    Value::Int(x231) => {
                      {
                        let x231 = Value::Int._0(mtmp230) in
                        {
                          let n/128 = x231 in
                          {
                            let mtmp234 =
                              inherent#Ref#Ref[int32]#set(
                                acc/127,
                                (inherent#Ref#Ref[int32]#get(acc/127) + n/128)
                              ) in
                            {
                              inherent#Ref#Ref[int]#set(
                                i/126,
                                (inherent#Ref#Ref[int]#get(i/126) + 1)
                              )
                            }
                          }
                        }
                      }
                    },
                    _ => inherent#Ref#Ref[int]#set(i/126, (inherent#Ref#Ref[int]#get(i/126) + 1)),
                  }
                }
              }
          } in
        {
          Value::Int(inherent#Ref#Ref[int32]#get(acc/127))
        }
      }
    },
    "*" => {
      {
        let i/129 = inherent#Ref#Ref[int]#new(0) in
        let acc/130 = inherent#Ref#Ref[int32]#new(1) in
        let mtmp241 =
          while (inherent#Ref#Ref[int]#get(i/129) < inherent#Vec#Vec[Value]#len(args/121)) {
              {
                {
                  let mtmp236 = @intrinsic(vec.get)(args/121, inherent#Ref#Ref[int]#get(i/129)) in
                  match mtmp236 {
                    Value::Int(x237) => {
                      {
                        let x237 = Value::Int._0(mtmp236) in
                        {
                          let n/131 = x237 in
                          {
                            let mtmp240 =
                              inherent#Ref#Ref[int32]#set(
                                acc/130,
                                (inherent#Ref#Ref[int32]#get(acc/130) * n/131)
                              ) in
                            {
                              inherent#Ref#Ref[int]#set(
                                i/129,
                                (inherent#Ref#Ref[int]#get(i/129) + 1)
                              )
                            }
                          }
                        }
                      }
                    },
                    _ => inherent#Ref#Ref[int]#set(i/129, (inherent#Ref#Ref[int]#get(i/129) + 1)),
                  }
                }
              }
          } in
        {
          Value::Int(inherent#Ref#Ref[int32]#get(acc/130))
        }
      }
    },
    "-" => {
      {
        let mtmp242 = inherent#Vec#Vec[Value]#len(args/121) in
        match mtmp242 {
          1 => {
            {
              let mtmp243 = @intrinsic(vec.get)(args/121, 0) in
              match mtmp243 {
                Value::Int(x244) => {
                  {
                    let x244 = Value::Int._0(mtmp243) in
                    {
                      let n/132 = x244 in
                      Value::Int((0 - n/132))
                    }
                  }
                },
                _ => Value::Nil,
              }
            }
          },
          2 => {
            {
              let mtmp247 = (@intrinsic(vec.get)(args/121, 0), @intrinsic(vec.get)(args/121, 1)) in
              {
                let x248 = mtmp247.0 in
                let x249 = mtmp247.1 in
                match x249 {
                  Value::Int(x250) => {
                    {
                      let x250 = Value::Int._0(x249) in
                      match x248 {
                        Value::Int(x253) => {
                          {
                            let x253 = Value::Int._0(x248) in
                            {
                              let a/133 = x253 in
                              {
                                let b/134 = x250 in
                                Value::Int((a/133 - b/134))
                              }
                            }
                          }
                        },
                        _ => Value::Nil,
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
          },
          _ => Value::Nil,
        }
      }
    },
    "/" => {
      if trait_call[Eq::eq](inherent#Vec#Vec[Value]#len(args/121), 2) {
          {
            {
              let mtmp256 = (@intrinsic(vec.get)(args/121, 0), @intrinsic(vec.get)(args/121, 1)) in
              {
                let x257 = mtmp256.0 in
                let x258 = mtmp256.1 in
                match x258 {
                  Value::Int(x259) => {
                    {
                      let x259 = Value::Int._0(x258) in
                      match x257 {
                        Value::Int(x262) => {
                          {
                            let x262 = Value::Int._0(x257) in
                            {
                              let a/135 = x262 in
                              {
                                let b/136 = x259 in
                                Value::Int((a/135 / b/136))
                              }
                            }
                          }
                        },
                        _ => Value::Nil,
                      }
                    }
                  },
                  _ => Value::Nil,
                }
              }
            }
          }
      } else {
          {
            Value::Nil
          }
      }
    },
    _ => Value::Nil,
  }
}

fn apply(func/137: Value, args/138: Vec[Value], global/139: Ref[Vec[Binding]]) -> Value {
  match func/137 {
    Value::Func(x267) => {
      {
        let x267 = Value::Func._0(func/137) in
        {
          let fun/140 = x267 in
          apply_lambda(fun/140, args/138)
        }
      }
    },
    _ => Value::Nil,
  }
}

fn apply_lambda(lambda/141: Lambda, args/142: Vec[Value]) -> Value {
  let env/143 = inherent#Ref#Ref[Vec[Binding]]#new(Lambda.env(lambda/141)) in
  let i/144 = inherent#Ref#Ref[int]#new(0) in
  let mtmp269 =
    while if (inherent#Ref#Ref[int]#get(i/144) <
      inherent#Vec#Vec[string]#len(Lambda.params(lambda/141))) {
        (inherent#Ref#Ref[int]#get(i/144) < inherent#Vec#Vec[Value]#len(args/142))
    } else {
        false
    } {
        {
          let name/145 =
            @intrinsic(vec.get)(Lambda.params(lambda/141), inherent#Ref#Ref[int]#get(i/144)) in
          let value/146 = @intrinsic(vec.get)(args/142, inherent#Ref#Ref[int]#get(i/144)) in
          let updated/147 =
            inherent#Vec#Vec[Binding]#pushed(
              inherent#Ref#Ref[Vec[Binding]]#get(env/143),
              Binding { name: name/145, value: value/146 }
            ) in
          let mtmp268 = inherent#Ref#Ref[Vec[Binding]]#set(env/143, updated/147) in
          {
            inherent#Ref#Ref[int]#set(i/144, (inherent#Ref#Ref[int]#get(i/144) + 1))
          }
        }
    } in
  {
    eval(
      Lambda.body(lambda/141),
      inherent#Ref#Ref[Vec[Binding]]#get(env/143),
      Lambda.global(lambda/141)
    )
  }
}

