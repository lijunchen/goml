              inherent#Ref#Ref[Vec[Binding]]#get(env/143),
              Binding { name: name/145, value: value/146 }
            ) in
          let mtmp309 = inherent#Ref#Ref[Vec[Binding]]#set(env/143, updated/147) in
          {
            inherent#Ref#Ref[int]#set(i/144, (inherent#Ref#Ref[int]#get(i/144) + 1))
          }
        }
    } in
  {
    eval(
      Lambda.body(lambda/141),
      inherent#Ref#Ref[Vec[Binding]]#get(env/143),
      Lambda.global(lambda/141)
    )
  }
}

fn main() -> unit {
  let global/148 = inherent#Ref#Ref[Vec[Binding]]#new(inherent#Vec#Vec[Binding]#new()) in
  let program/149 =
    "(begin (define fact (lambda (n) (if (= n 0) 1 (* n (fact (- n 1)))))) (define add3 (lambda (a b c) (+ a (+ b c)))) (fact 6))" in
  let exprs/150 = parse_program(lex(program/149)) in
  let result/151 =
    eval(@intrinsic(vec.get)(exprs/150, 0), inherent#Vec#Vec[Binding]#new(), global/148) in
  let mtmp311 = println(value_to_string(result/151)) in
  {
    let exprs2/152 = parse_program(lex("(add3 10 20 30)")) in
    let result2/153 =
      eval(@intrinsic(vec.get)(exprs2/152, 0), inherent#Vec#Vec[Binding]#new(), global/148) in
    let mtmp312 = println(value_to_string(result2/153)) in
    {
      ()
    }
  }
}