fn main() -> unit {
    let (valid/0: bool, value/1: float64) =
      (@runtime(core.string_parse_float64) : (string) -> (bool, float64))("3.125");
    (println : (string) -> unit)((ToString::to_string : (bool) -> string)((valid/0 : bool)));
    (println : (string) -> unit)((ToString::to_string : (float64) -> string)((value/1 : float64)));
    let (rounded_valid/2: bool, rounded/3: float64) =
      (@runtime(core.string_parse_float32) : (string) -> (bool, float64))("3.14");
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((rounded_valid/2 : bool))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (float64) -> string)((rounded/3 : float64))
