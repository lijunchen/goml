const ANSWER: int = (40 + 2);
const ALTERNATE: int = 7;
const ENABLED: bool = true;
const GREETING: string = "hello";
const MARKER: uint8 = 65;
const RATIO: float64 = 1.5;
const COMPUTED_ANSWER: int = 42;
const COMPUTED_ENABLED: bool = true;
const CLASSIFIED_AT_COMPILE_TIME: int = 1;

fn make_answer() -> int {
    42
}

fn make_enabled() -> bool {
    true
}

fn comptime_classify(value/0: int) -> int {
    match (value/0 : int) {
        COMPUTED_ANSWER => 1,
        _ : int => 0,
    }
}

fn classify(value/1: int) -> string {
    match (value/1 : int) {
        42 | 7 => "known",
        _ : int => "other",
    }
}

fn classify_bool(value/2: bool) -> string {
    match (value/2 : bool) {
        true => "enabled",
        false => "disabled",
    }
}

fn classify_computed_bool(value/3: bool) -> string {
    match (value/3 : bool) {
        COMPUTED_ENABLED => "enabled",
        false => "disabled",
    }
}

fn classify_comptime_guard(value/4: bool) -> string {
    let result/5: string =
      match (value/4 : bool) {
          true if true => "enabled",
          false => "disabled",
      };
    (result/5 : string)
}

fn classify_pair(value/6: (int, uint8)) -> bool {
    match (value/6 : (int, uint8)) {
        (42, 65) => true,
        _ : (int, uint8) => false,
    }
}

fn classify_string(value/7: string) -> bool {
    match (value/7 : string) {
        "hello" => true,
        _ : string => false,
    }
}

fn classify_float(value/8: float64) -> bool {
    match (value/8 : float64) {
        RATIO => true,
        _ : float64 => false,
    }
}

fn shadow_constant() -> int {
    let answer/9: int = 9;
    (answer/9 : int)
}

fn explicit_binding(value/10: int) -> int {
    match (value/10 : int) {
        answer/11 @ _ : int => (answer/11 : int),
    }
}

fn matches_if_let(value/12: int) -> bool {
    match (value/12 : int) {
        42 =>
          {
              true
          },
        _ : int =>
          {
              false
          },
    }
}

fn matches_let_else(value/13: int) -> bool {
    let 42 =
      (value/13 : int) else
      {
          return false
      };
    true
}

fn for_binding() -> int {
    let total/14: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    for answer/15: int in
      [1, 2] {
        (Ref[int]::set : (Ref[int], int) -> unit)(
          (total/14 : Ref[int]),
          (Ref[int]::get : (Ref[int]) -> int)((total/14 : Ref[int])) + (answer/15 : int)
        )
    };
    (Ref[int]::get : (Ref[int]) -> int)((total/14 : Ref[int]))
}

fn main() -> unit {
    (println : (string) -> unit)((classify : (int) -> string)(42));
    (println : (string) -> unit)((classify : (int) -> string)(7));
    (println : (string) -> unit)((classify : (int) -> string)(0));
    (println : (string) -> unit)((classify_bool : (bool) -> string)(true));
    (println : (string) -> unit)((classify_bool : (bool) -> string)(false));
    (println : (string) -> unit)((classify_computed_bool : (bool) -> string)(true));
    (println : (string) -> unit)((classify_computed_bool : (bool) -> string)(false));
    (println : (string) -> unit)((classify_comptime_guard : (bool) -> string)(true));
    (println : (string) -> unit)((classify_comptime_guard : (bool) -> string)(false));
    (println : (bool) -> unit)((classify_pair : ((int, uint8)) -> bool)((42, 65)));
    (println : (bool) -> unit)((classify_pair : ((int, uint8)) -> bool)((42, 66)));
    (println : (bool) -> unit)((classify_string : (string) -> bool)("hello"));
    (println : (bool) -> unit)((classify_float : (float64) -> bool)(1.5));
    (println : (int) -> unit)((shadow_constant : () -> int)());
    (println : (int) -> unit)((explicit_binding : (int) -> int)(11));
    (println : (bool) -> unit)((matches_if_let : (int) -> bool)(42));
    (println : (bool) -> unit)((matches_if_let : (int) -> bool)(41));
    (println : (bool) -> unit)((matches_let_else : (int) -> bool)(42));
    (println : (bool) -> unit)((matches_let_else : (int) -> bool)(41));
    (println : (int) -> unit)((for_binding : () -> int)());
    (println : (int) -> unit)((CLASSIFIED_AT_COMPILE_TIME : int))
}