impl Point{
  fn new(x/0: int32, y/1: int32) -> Point {
      Point { x: (x/0 : int32), y: (y/1 : int32) }
  }
  fn copy(self/2: Point, other/3: Point) -> Point {
      Point { x: (self/2 : Point).x + (other/3 : Point).x, y: (self/2 : Point).y + (other/3 : Point).y }
  }
  fn origin() -> Point {
      Point { x: 0, y: 0 }
  }
}

fn wrap[T](value/4: T) -> T {
    let id/6: (T) -> T = |item/5: T| => (item/5 : T);
    (id/6 : (T) -> T)((value/4 : T))
}

fn shape_value(value/7: Shape[int32]) -> int32 {
    match (value/7 : Shape[int32]) {
        Shape::Dot(point/8: Point) => (point/8 : Point).x + (point/8 : Point).y,
        Shape::Wrapped(wrapper/9: Wrapper[int32]) => (wrapper/9 : Wrapper[int32]).value,
        Shape::Origin => 0,
    }
}

fn list_value(value/10: List) -> int32 {
    match (value/10 : List) {
        List::Cons(node/11: Node) => (node/11 : Node).value + (list_value : (List) -> int32)((node/11 : Node).next),
        List::Nil => 0,
    }
}

fn main() -> unit {
    let offset/12: int32 = 1;
    let add/14: (int32) -> int32 = |value/13: int32| => (value/13 : int32) + (offset/12 : int32);
    let point/15: Point = (Point::new : (int32, int32) -> Point)((add/14 : (int32) -> int32)(1), 3);
    let combined/16: Point = (Point::copy : (Point, Point) -> Point)((point/15 : Point), (Point::origin : () -> Point)());
    let wrapped/17: Shape[int32] = Shape::Wrapped(Wrapper { value: (wrap : (int32) -> int32)(4) });
    let list/18: List = List::Cons(Node { value: 5, next: List::Nil });
    (println : (string) -> unit)((int32::to_string : (int32) -> string)((combined/16 : Point).x + (combined/16 : Point).y + (shape_value : (Shape[int32]) -> int32)((wrapped/17 : Shape[int32])) + (list_value : (List) -> int32)((list/18 : List))))
}