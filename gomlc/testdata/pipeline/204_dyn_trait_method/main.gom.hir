package main
file main.gom
  trait Named {
    fn name(Self) -> string;
  }

  trait Display: Named {
    fn show(Self, string) -> string;
  }

  struct Point {
      value: int32,
  }

  impl Named for Point {
    fn name(local/1/0: Point) -> string {
        "point"
    }
  }

  impl Display for Point {
    fn show(local/1/1: Point, local/1/2: string) -> string {
        prefix/2 + self/1.value.to_string()
    }
  }

  fn render(local/1/3: dyn Display) -> unit {
      println(value/3.show("value="));
      println(value/3.name());
      println(Display::show(value/3, "again="));
  }

  fn main() -> unit {
      let local/1/4: dyn Display = Point { value: 7 } as dyn Display;
      def/1/5(value/4);
  }