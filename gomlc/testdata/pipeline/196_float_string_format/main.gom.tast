fn main() -> unit {
    (println : (string) -> unit)((ToString::to_string : (float64) -> string)(18318654708.7));
    (println : (string) -> unit)((ToString::to_string : (float64) -> string)(0.0000001));
    let zero/0: float64 = 0;
    let negative_one/1: float64 = -1;
    (println : (string) -> unit)(
      (ToString::to_string : (float64) -> string)((negative_one/1 : float64) * (zero/0 : float64))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (float64) -> string)(1 / (zero/0 : float64))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (float64) -> string)(-1 / (zero/0 : float64))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (float64) -> string)((zero/0 : float64) / (zero/0 : float64))
    );
    let wide/2: float64 = 12345678;
    (println : (string) -> unit)((ToString::to_string : (float64) -> string)((wide/2 : float64)))
}