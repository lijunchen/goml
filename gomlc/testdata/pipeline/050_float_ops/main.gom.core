  let mtmp801 = println(("less32=" + trait_call[ToString::to_string](less32/20))) in
  {
    let _wild802 = show64("energy=", energy/24) in
    let _wild803 = show64("neg_dx=", neg_dx/25) in
    let _wild804 = show64("adjusted=", adjusted/26) in
    let mtmp805 = println(("less64=" + trait_call[ToString::to_string](less64/28))) in
    {
