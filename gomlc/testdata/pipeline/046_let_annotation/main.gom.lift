fn main() -> unit {
  let x/0 = 1 in
  let y/1 = 1 in
  let mtmp177 = print__T_string("int32: ") in
  let mtmp178 = println__T_int32(x/0) in
  let mtmp179 = print__T_string("int8: ") in
  let mtmp180 = println__T_int8(y/1) in
  ()
}

fn print__T_string(value/30: string) -> unit {
  @runtime(core.string_print)(trait_impl#ToString#string#to_string(value/30))
}

fn println__T_int32(value/31: int32) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#int32#to_string(value/31))
}

fn println__T_int8(value/31: int8) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#int8#to_string(value/31))
}

fn trait_impl#ToString#string#to_string(self/67: string) -> string {
  self/67
}

fn trait_impl#ToString#int32#to_string(self/72: int32) -> string {
  @runtime(core.int32_to_string)(self/72)
}

fn trait_impl#ToString#int8#to_string(self/70: int8) -> string {
