fn classify(x/0: int32) -> string {
  if (x/0 < 0) {
      {
        "negative"
      }
  } else {
      {
        if (0 < x/0) {
            {
              "positive"
            }
        } else {
            {
              "zero"
            }
        }
      }
  }
}

fn triangle_type(a/1: int32, b/2: int32, c/3: int32) -> string {
  if (a/1 < b/2) {
      {
        if (b/2 < c/3) {
            {
              "ascending"
            }
        } else {
            {
              "peak"
            }
        }
      }
  } else {
      {
        if (a/1 < c/3) {
            {
              "valley"
            }
        } else {
            {
              "flat"
            }
        }
      }
  }
}

fn main() -> unit {
  let first/4 = classify(-42) in
  let second/5 = classify(0) in
  let third/6 = classify(17) in
  let shape1/7 = triangle_type(1, 2, 3) in
  let shape2/8 = triangle_type(3, 2, 1) in
  let shape3/9 = triangle_type(2, 3, 2) in
  let mtmp136 = println__T_string(first/4) in
  {
    let mtmp137 = println__T_string(second/5) in
    {
      let mtmp138 = println__T_string(third/6) in
      {
        let mtmp139 = println__T_string(shape1/7) in
        {
          let mtmp140 = println__T_string(shape2/8) in
          {
            let mtmp141 = println__T_string(shape3/9) in
            {
              ()
            }
          }
        }
      }
    }
  }
}

fn println__T_string(value/31: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/31))
}

fn trait_impl#ToString#string#to_string(self/67: string) -> string {
  self/67
}