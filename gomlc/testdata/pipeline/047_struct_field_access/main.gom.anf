fn make_point(base/0: int32) -> Point {
  join ret108(retv109: Point) -> Point {
    retv109
  } in
  let t110 = (base/0 + 1) in
  let t111 = Point { x: base/0, y: t110 } in
  jump ret108(t111)
}

fn sum_point(p/1: Point) -> int32 {
  join ret112(retv113: int32) -> int32 {
    retv113
  } in
  let t114 = Point.x(p/1) in
  let t115 = Point.y(p/1) in
  let t116 = (t114 + t115) in
  jump ret112(t116)
}

fn main() -> int32 {
  join ret117(retv118: int32) -> int32 {
    retv118
  } in
  let p/2 = make_point(5) in
  let t119 = Point.x(p/2) in
  let t120 = (t119 + 1) in
  let t121 = Point.y(p/2) in
  let t122 = (t121 - 2) in
  let shifted/3 = Point { x: t120, y: t122 } in
  let t123 = Point.x(shifted/3) in
  let t124 = sum_point(shifted/3) in
  let t125 = (t123 + t124) in
  jump ret117(t125)
}