fn make_point(base/0: int32) -> Point {
  join ret68(retv69: Point) -> Point {
    retv69
  } in
  let t70 = (base/0 + 1) in
  let t71 = Point { x: base/0, y: t70 } in
  jump ret68(t71)
}

fn sum_point(p/1: Point) -> int32 {
  join ret72(retv73: int32) -> int32 {
    retv73
  } in
  let t74 = Point.x(p/1) in
  let t75 = Point.y(p/1) in
  let t76 = (t74 + t75) in
  jump ret72(t76)
}

fn main() -> int32 {
  join ret77(retv78: int32) -> int32 {
    retv78
  } in
  let p/2 = make_point(5) in
  let t79 = Point.x(p/2) in
  let t80 = (t79 + 1) in
  let t81 = Point.y(p/2) in
  let t82 = (t81 - 2) in
  let shifted/3 = Point { x: t80, y: t82 } in
  let t83 = Point.x(shifted/3) in
  let t84 = sum_point(shifted/3) in
  let t85 = (t83 + t84) in
  jump ret77(t85)
}