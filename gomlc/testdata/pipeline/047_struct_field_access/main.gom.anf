fn make_point(base/0: int32) -> Point {
  join ret152(retv153: Point) -> Point {
    retv153
  } in
  let t154 = (base/0 + 1) in
  let t155 = Point { x: base/0, y: t154 } in
  jump ret152(t155)
}

fn sum_point(p/1: Point) -> int32 {
  join ret156(retv157: int32) -> int32 {
    retv157
  } in
  let t158 = Point.x(p/1) in
  let t159 = Point.y(p/1) in
  let t160 = (t158 + t159) in
  jump ret156(t160)
}

fn main() -> int32 {
  join ret161(retv162: int32) -> int32 {
    retv162
  } in
  let p/2 = make_point(5) in
  let t163 = Point.x(p/2) in
  let t164 = (t163 + 1) in
  let t165 = Point.y(p/2) in
  let t166 = (t165 - 2) in
  let shifted/3 = Point { x: t164, y: t166 } in
  let t167 = Point.x(shifted/3) in
  let t168 = sum_point(shifted/3) in
  let t169 = (t167 + t168) in
  jump ret161(t169)
}