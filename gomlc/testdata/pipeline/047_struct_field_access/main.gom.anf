fn make_point(base/0: int32) -> Point {
  let t410 = (base/0 + 1) in
  let t411 = Point { x: base/0, y: t410 } in
  t411
}

fn sum_point(p/1: Point) -> int32 {
  let t414 = Point.x(p/1) in
  let t415 = Point.y(p/1) in
  let t416 = (t414 + t415) in
  t416
}

