trait Display {
    fn show(self: Self) -> string;
}

impl Display for int32 {
    fn show(self: int32) -> string {
        self.to_string()
    }
}

enum Boxed {
    One(dyn Display),
}

fn build() -> int32 {
    let _: Boxed = Boxed::One(return 9);
    0
}

fn main() -> unit {
    println(build().to_string())
}
