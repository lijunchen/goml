fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp172 = p/3 in
  let x173 = Point.x(mtmp172) in
  let x174 = Point.y(mtmp172) in
  let y/5 = x174 in
  let x/4 = x173 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp175 = make_some(5) in
  match mtmp175 {
    Maybe__int32::Some(x176) => {
      let x176 = Maybe__int32::Some._0(mtmp175) in
      let result/6 = x176 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp177 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp177 {
        Maybe__int32::Some(x178) => {
          let x178 = Maybe__int32::Some._0(mtmp177) in
          let value/8 = x178 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}