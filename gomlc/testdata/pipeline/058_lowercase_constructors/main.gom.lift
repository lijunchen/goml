fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp187 = p/3 in
  let x188 = Point.x(mtmp187) in
  let x189 = Point.y(mtmp187) in
  let y/5 = x189 in
  let x/4 = x188 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp190 = make_some(5) in
  match mtmp190 {
    Maybe__int32::Some(x191) => {
      let x191 = Maybe__int32::Some._0(mtmp190) in
      let result/6 = x191 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp192 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp192 {
        Maybe__int32::Some(x193) => {
          let x193 = Maybe__int32::Some._0(mtmp192) in
          let value/8 = x193 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
