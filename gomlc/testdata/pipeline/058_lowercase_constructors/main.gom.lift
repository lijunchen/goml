fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp155 = p/3 in
  let x156 = Point.x(mtmp155) in
  let x157 = Point.y(mtmp155) in
  let y/5 = x157 in
  let x/4 = x156 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp158 = make_some(5) in
  match mtmp158 {
    Maybe__int32::Some(x159) => {
      let x159 = Maybe__int32::Some._0(mtmp158) in
      let result/6 = x159 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp160 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp160 {
        Maybe__int32::Some(x161) => {
          let x161 = Maybe__int32::Some._0(mtmp160) in
          let value/8 = x161 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}