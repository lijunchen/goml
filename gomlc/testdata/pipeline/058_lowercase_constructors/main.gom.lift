fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp68 = p/3 in
  let x69 = Point.x(mtmp68) in
  let x70 = Point.y(mtmp68) in
  let y/5 = x70 in
  let x/4 = x69 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp71 = make_some(5) in
  match mtmp71 {
    Maybe__int32::Some(x72) => {
      let x72 = Maybe__int32::Some._0(mtmp71) in
      let result/6 = x72 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp73 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp73 {
        Maybe__int32::Some(x74) => {
          let x74 = Maybe__int32::Some._0(mtmp73) in
          let value/8 = x74 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}