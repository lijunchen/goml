fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp408 = p/3 in
  let x409 = Point.x(mtmp408) in
  let x410 = Point.y(mtmp408) in
  let y/5 = x410 in
  let x/4 = x409 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp411 = make_some(5) in
  match mtmp411 {
    Maybe__int32::Some(x412) => {
      let x412 = Maybe__int32::Some._0(mtmp411) in
      let result/6 = x412 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp413 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp413 {
        Maybe__int32::Some(x414) => {
          let x414 = Maybe__int32::Some._0(mtmp413) in
          let value/8 = x414 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}