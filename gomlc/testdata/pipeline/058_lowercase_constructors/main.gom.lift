fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp182 = p/3 in
  let x183 = Point.x(mtmp182) in
  let x184 = Point.y(mtmp182) in
  let y/5 = x184 in
  let x/4 = x183 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp185 = make_some(5) in
  match mtmp185 {
    Maybe__int32::Some(x186) => {
      let x186 = Maybe__int32::Some._0(mtmp185) in
      let result/6 = x186 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp187 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp187 {
        Maybe__int32::Some(x188) => {
          let x188 = Maybe__int32::Some._0(mtmp187) in
          let value/8 = x188 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}