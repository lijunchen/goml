fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp177 = p/3 in
  let x178 = Point.x(mtmp177) in
  let x179 = Point.y(mtmp177) in
  let y/5 = x179 in
  let x/4 = x178 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp180 = make_some(5) in
  match mtmp180 {
    Maybe__int32::Some(x181) => {
      let x181 = Maybe__int32::Some._0(mtmp180) in
      let result/6 = x181 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp182 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp182 {
        Maybe__int32::Some(x183) => {
          let x183 = Maybe__int32::Some._0(mtmp182) in
          let value/8 = x183 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}