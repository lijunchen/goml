fn make_some(value/0: i32) -> Maybe__i32 {
  Maybe__i32::Some(value/0)
}

fn build_point(x/1: i32, y/2: i32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> i32 {
  let mtmp796 = p/3 in
  let x797 = Point.x(mtmp796) in
  let x798 = Point.y(mtmp796) in
  let y/5 = x798 in
  let x/4 = x797 in
  (x/4 + y/5)
}

fn main() -> i32 {
  let mtmp799 = make_some(5) in
  match mtmp799 {
    Maybe__i32::Some(x800) => {
      let x800 = Maybe__i32::Some._0(mtmp799) in
      let result/6 = x800 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp801 = Maybe__i32::Some(Point.x(pt/7)) in
      match mtmp801 {
        Maybe__i32::Some(x802) => {
          let x802 = Maybe__i32::Some._0(mtmp801) in
          let value/8 = x802 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__i32::None => {
          0
        },
      }
    },
    Maybe__i32::None => {
      0
    },
  }
}