fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp411 = p/3 in
  let x412 = Point.x(mtmp411) in
  let x413 = Point.y(mtmp411) in
  let y/5 = x413 in
  let x/4 = x412 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp414 = make_some(5) in
  match mtmp414 {
    Maybe__int32::Some(x415) => {
      let x415 = Maybe__int32::Some._0(mtmp414) in
      let result/6 = x415 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp416 = Maybe__int32::Some(Point.x(pt/7)) in
      match mtmp416 {
        Maybe__int32::Some(x417) => {
          let x417 = Maybe__int32::Some._0(mtmp416) in
          let value/8 = x417 in
          (value/8 + magnitude(pt/7))
        },
        Maybe__int32::None => {
          0
        },
      }
    },
    Maybe__int32::None => {
      0
    },
  }
}