fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp136 = p/3 in
  {
    let x137 = Point.x(mtmp136) in
    let x138 = Point.y(mtmp136) in
    {
      let y/5 = x138 in
      {
        let x/4 = x137 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp139 = make_some(5) in
    match mtmp139 {
      Maybe__int32::Some(x140) => {
        {
          let x140 = Maybe__int32::Some._0(mtmp139) in
          {
            let result/6 = x140 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp141 = Maybe__int32::Some(Point.x(pt/7)) in
                match mtmp141 {
                  Maybe__int32::Some(x142) => {
                    {
                      let x142 = Maybe__int32::Some._0(mtmp141) in
                      {
                        let value/8 = x142 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  Maybe__int32::None => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      Maybe__int32::None => {
        0
      },
    }
  }
}