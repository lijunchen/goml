fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp64 = p/3 in
  {
    let x65 = Point.x(mtmp64) in
    let x66 = Point.y(mtmp64) in
    {
      let y/5 = x66 in
      {
        let x/4 = x65 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp67 = make_some(5) in
    match mtmp67 {
      Maybe__int32::Some(x68) => {
        {
          let x68 = Maybe__int32::Some._0(mtmp67) in
          {
            let result/6 = x68 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp69 = Maybe__int32::Some(Point.x(pt/7)) in
                match mtmp69 {
                  Maybe__int32::Some(x70) => {
                    {
                      let x70 = Maybe__int32::Some._0(mtmp69) in
                      {
                        let value/8 = x70 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  Maybe__int32::None => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      Maybe__int32::None => {
        0
      },
    }
  }
}