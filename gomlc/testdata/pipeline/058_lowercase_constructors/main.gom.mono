fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp108 = p/3 in
  {
    let x109 = Point.x(mtmp108) in
    let x110 = Point.y(mtmp108) in
    {
      let y/5 = x110 in
      {
        let x/4 = x109 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp111 = make_some(5) in
    match mtmp111 {
      Maybe__int32::Some(x112) => {
        {
          let x112 = Maybe__int32::Some._0(mtmp111) in
          {
            let result/6 = x112 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp113 = Maybe__int32::Some(Point.x(pt/7)) in
                match mtmp113 {
                  Maybe__int32::Some(x114) => {
                    {
                      let x114 = Maybe__int32::Some._0(mtmp113) in
                      {
                        let value/8 = x114 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  Maybe__int32::None => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      Maybe__int32::None => {
        0
      },
    }
  }
}