fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp152 = p/3 in
  {
    let x153 = Point.x(mtmp152) in
    let x154 = Point.y(mtmp152) in
    {
      let y/5 = x154 in
      {
        let x/4 = x153 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp155 = make_some(5) in
    match mtmp155 {
      Maybe__int32::Some(x156) => {
        {
          let x156 = Maybe__int32::Some._0(mtmp155) in
          {
            let result/6 = x156 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp157 = Maybe__int32::Some(Point.x(pt/7)) in
                match mtmp157 {
                  Maybe__int32::Some(x158) => {
                    {
                      let x158 = Maybe__int32::Some._0(mtmp157) in
                      {
                        let value/8 = x158 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  Maybe__int32::None => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      Maybe__int32::None => {
        0
      },
    }
  }
}