package main;
enum Maybe[T] {
    Some(T),
    None
}

struct Point {
    x: int32,
    y: int32,
}

fn make_some(value: int32) -> Maybe[int32] {
    Some(value)
}

fn build_point(x: int32, y: int32) -> Point {
    Point { x: x, y: y }
}

fn magnitude(p: Point) -> int32 {
    let Point { x: x, y: y } = p;
    x + y
}

fn main() -> int32 {
    match make_some(5) {
        Some(result) =>
          {
              let pt = build_point(result, 7);
              match Some(pt.x) {
                  Some(value) => value + magnitude(pt),
                  None => 0,
              }
          },
        None => 0,
    }
}

