fn main() -> unit {
  let default_integer/2 = 40 in
  let default_float/3 = 0.5 in
  let small/4 = 41 in
  let inferred/5 = [small/4, 2] in
  let branch/6 =
    if true {
        1
    } else {
        small/4
    } in
  let values/7 = [10, 20] in
  let delayed/8 = inherent#Ref#Ref[T]#new__T_uint32(0) in
  let byte/9 = inherent#string#string#byte_get("A", 0) in
  let _wild172 = println__T_string(inherent#int#int#to_string((default_integer/2 + 2))) in
  let _wild173 = println__T_string(trait_impl#ToString#float64#to_string(default_float/3)) in
  let _wild174 = println__T_string(trait_impl#ToString#uint8#to_string(increment(small/4))) in
  let _wild175 =
    println__T_string(trait_impl#ToString#uint8#to_string(@intrinsic(array.get)(inferred/5, 1))) in
  let _wild176 = println__T_string(trait_impl#ToString#uint8#to_string(branch/6)) in
  let _wild177 =
    println__T_string(trait_impl#ToString#uint16#to_string(@intrinsic(array.get)(values/7, 1))) in
  let _wild178 = println__T_string(trait_impl#ToString#float32#to_string(one_float32())) in
  let _wild179 = println__T_string(trait_impl#ToString#int16#to_string(two_int16())) in
  let _wild180 = println__T_string(trait_impl#ToString#uint32#to_string(read_uint32(delayed/8))) in
  let _wild181 = println__T_string(trait_impl#ToString#bool#to_string((byte/9 == 65))) in
  let _wild182 =
    println__T_string(
      match byte/9 {
        65 => {
          "byte"
        },
        _ => "other",
      }
    ) in
  ()
}

