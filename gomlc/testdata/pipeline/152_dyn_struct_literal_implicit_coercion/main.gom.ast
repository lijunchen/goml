package main;
trait Display {
  fn show(self: Self) -> string;
}

impl Display for int32 {
  fn show(self: int32) -> string {
      self.to_string()
  }
}

struct Holder[T] {
    value: T,
}

fn render(x: dyn Display) -> string {
    Display::show(x)
}

fn main() -> unit {
    let value: int32 = 42;
    let holder: Holder[dyn Display] = Holder { value: value };
    println(render(holder.value));
}

