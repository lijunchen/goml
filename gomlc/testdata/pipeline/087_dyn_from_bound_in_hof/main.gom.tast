impl Display for int32 {
  fn show(self/0: int32) -> string {
      (int32::to_string : (int32) -> string)((self/0 : int32))
  }
}

fn mk_renderer[T](x/1: T) -> () -> string where T: Display {
    let d/2: dyn Display = to_dyn[Display]{T}((x/1 : T));
    || => (dyn Display::show : (dyn Display) -> string)((d/2 : dyn Display))
}

fn main() -> unit {
    let value/3: int32 = 42;
    let f/4: () -> string = (mk_renderer : (int32) -> () -> string)((value/3 : int32));
    (println : (string) -> unit)((f/4 : () -> string)());
}