package main;
trait Display {
  fn show(self: Self) -> string;
}

impl Display for int32 {
  fn show(self: int32) -> string {
      self.to_string()
  }
}

fn mk_renderer(x: T) -> () -> string {
    let d: dyn Display = x;
    || Display::show(d)
}

fn main() {
    let value: int32 = 42;
    let f = mk_renderer(value);
    println(f());
}

