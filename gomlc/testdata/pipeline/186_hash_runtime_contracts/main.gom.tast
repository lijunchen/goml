impl PartialEq for FloatKey {
  fn eq(self/0: FloatKey, other/1: FloatKey) -> bool {
      true &&
        (PartialEq::eq : (float64, float64) -> bool)(
          (self/0 : FloatKey).value,
          (other/1 : FloatKey).value
        )
  }
}

impl std::cmp::PartialOrd for FloatKey {
  fn partial_cmp(self/2: FloatKey, other/3: FloatKey) -> Option[std::cmp::Ordering] {
      match (std::cmp::PartialOrd::partial_cmp : (float64, float64) -> Option[std::cmp::Ordering])(
        (self/2 : FloatKey).value,
        (other/3 : FloatKey).value
      ) {
          Option::None => Option::None,
          Option::Some(std::cmp::Ordering::Equal) => Option::Some(std::cmp::Ordering::Equal),
          Option::Some(#derive0_ordering/4: std::cmp::Ordering) =>
            Option::Some((#derive0_ordering/4 : std::cmp::Ordering)),
      }
  }
  fn lt(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#lt : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
  fn le(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#le : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
  fn gt(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#gt : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
  fn ge(default_arg0: FloatKey, default_arg1: FloatKey) -> bool {
      (std::cmp::trait_default#PartialOrd#ge : (FloatKey, FloatKey) -> bool)(
        (default_arg0 : FloatKey),
        (default_arg1 : FloatKey)
      )
  }
}

impl PartialEq for CollisionKey {
  fn eq(self/5: CollisionKey, other/6: CollisionKey) -> bool {
      (self/5 : CollisionKey).value == (other/6 : CollisionKey).value
  }
}

impl Eq for CollisionKey {}

impl Hash for CollisionKey {
  fn hash(self/7: CollisionKey) -> uint64 {
      1
  }
}

fn print_opt_string(value/8: Option[string]) -> unit {
    match (value/8 : Option[string]) {
        Option::Some(text/9: string) => (println : (string) -> unit)((text/9 : string)),
        Option::None => (println : (string) -> unit)("none"),
    }
}

fn print_opt_int(value/10: Option[int32]) -> unit {
    match (value/10 : Option[int32]) {
        Option::Some(number/11: int32) => (println : (int32) -> unit)((number/11 : int32)),
        Option::None => (println : (string) -> unit)("none"),
    }
}

fn float_comparison_contracts() -> unit {
    let zero32/12: float32 = 0;
    let negative_zero32/13: float32 = -(zero32/12 : float32);
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)(
        (zero32/12 : float32) == (negative_zero32/13 : float32)
      )
    );
    let zero64/14: float64 = 0;
    let negative_zero64/15: float64 = -(zero64/14 : float64);
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)(
        (zero64/14 : float64) == (negative_zero64/15 : float64)
      )
    );
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)(
        FloatKey { value: (zero64/14 : float64) } ==
          FloatKey { value: (negative_zero64/15 : float64) }
      )
    );
    let nan/16: float64 = (zero64/14 : float64) / (zero64/14 : float64);
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)((nan/16 : float64) == (nan/16 : float64))
    );
    (println : (string) -> unit)(
      (ToString::to_string : (bool) -> string)(
        (Option[std::cmp::Ordering]::is_none : (Option[std::cmp::Ordering]) -> bool)(
          (std::cmp::PartialOrd::partial_cmp : (float64, float64) -> Option[std::cmp::Ordering])(
            (nan/16 : float64),
            (nan/16 : float64)
          )
        )
      )
    );
}

fn collision_contracts() -> unit {
    let values/17: HashMap[CollisionKey, int32] =
      (HashMap[CollisionKey, int32]::new : () -> HashMap[CollisionKey, int32])();
    (HashMap[CollisionKey, int32]::set : (
      HashMap[CollisionKey, int32],
      CollisionKey,
      int32
    ) -> unit)((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 1 }, 10);
    (HashMap[CollisionKey, int32]::set : (
      HashMap[CollisionKey, int32],
      CollisionKey,
      int32
    ) -> unit)((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 2 }, 20);
    (HashMap[CollisionKey, int32]::set : (
      HashMap[CollisionKey, int32],
      CollisionKey,
      int32
    ) -> unit)((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 3 }, 30);
    (HashMap[CollisionKey, int32]::remove : (HashMap[CollisionKey, int32], CollisionKey) -> unit)(
      (values/17 : HashMap[CollisionKey, int32]),
      CollisionKey { value: 2 }
    );
    (print_opt_int : (Option[int32]) -> unit)(
      (HashMap[CollisionKey, int32]::get : (HashMap[CollisionKey, int32], CollisionKey) -> Option[
        int32
      ])((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 1 })
    );
    (print_opt_int : (Option[int32]) -> unit)(
      (HashMap[CollisionKey, int32]::get : (HashMap[CollisionKey, int32], CollisionKey) -> Option[
        int32
      ])((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 2 })
    );
    (print_opt_int : (Option[int32]) -> unit)(
      (HashMap[CollisionKey, int32]::get : (HashMap[CollisionKey, int32], CollisionKey) -> Option[
        int32
      ])((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 3 })
    );
    (HashMap[CollisionKey, int32]::set : (
      HashMap[CollisionKey, int32],
      CollisionKey,
      int32
    ) -> unit)((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 4 }, 40);
    (println : (int) -> unit)(
      (HashMap[CollisionKey, int32]::len : (HashMap[CollisionKey, int32]) -> int)(
        (values/17 : HashMap[CollisionKey, int32])
      )
    );
    (print_opt_int : (Option[int32]) -> unit)(
      (HashMap[CollisionKey, int32]::get : (HashMap[CollisionKey, int32], CollisionKey) -> Option[
        int32
      ])((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 4 })
    );
    (HashMap[CollisionKey, int32]::set : (
      HashMap[CollisionKey, int32],
      CollisionKey,
      int32
    ) -> unit)((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 4 }, 41);
    (println : (int) -> unit)(
      (HashMap[CollisionKey, int32]::len : (HashMap[CollisionKey, int32]) -> int)(
        (values/17 : HashMap[CollisionKey, int32])
      )
    );
    (print_opt_int : (Option[int32]) -> unit)(
      (HashMap[CollisionKey, int32]::get : (HashMap[CollisionKey, int32], CollisionKey) -> Option[
        int32
      ])((values/17 : HashMap[CollisionKey, int32]), CollisionKey { value: 4 })
    );
    (HashMap[CollisionKey, int32]::remove : (HashMap[CollisionKey, int32], CollisionKey) -> unit)(
      (values/17 : HashMap[CollisionKey, int32]),
      CollisionKey { value: 99 }
    );
    (HashMap[CollisionKey, int32]::remove : (HashMap[CollisionKey, int32], CollisionKey) -> unit)(
      (values/17 : HashMap[CollisionKey, int32]),
      CollisionKey { value: 99 }
    );
    (println : (int) -> unit)(
      (HashMap[CollisionKey, int32]::len : (HashMap[CollisionKey, int32]) -> int)(
        (values/17 : HashMap[CollisionKey, int32])
      )
    );
    let index/18: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])(0);
    while (Ref[int32]::get : (Ref[int32]) -> int32)((index/18 : Ref[int32])) < 2000 {
        {
            let key/19: CollisionKey =
              CollisionKey {
                value: 1000 + (Ref[int32]::get : (Ref[int32]) -> int32)((index/18 : Ref[int32]))
              };
            (HashMap[CollisionKey, int32]::set : (
              HashMap[CollisionKey, int32],
              CollisionKey,
              int32
            ) -> unit)(
              (values/17 : HashMap[CollisionKey, int32]),
              (key/19 : CollisionKey),
              (Ref[int32]::get : (Ref[int32]) -> int32)((index/18 : Ref[int32]))
            );
            (HashMap[CollisionKey, int32]::remove : (
              HashMap[CollisionKey, int32],
              CollisionKey
            ) -> unit)((values/17 : HashMap[CollisionKey, int32]), (key/19 : CollisionKey));
            (Ref[int32]::set : (Ref[int32], int32) -> unit)(
              (index/18 : Ref[int32]),
              (Ref[int32]::get : (Ref[int32]) -> int32)((index/18 : Ref[int32])) + 1
            );
        }
    };
    (println : (int) -> unit)(
      (HashMap[CollisionKey, int32]::len : (HashMap[CollisionKey, int32]) -> int)(
        (values/17 : HashMap[CollisionKey, int32])
      )
    );
}

fn reference_contracts() -> unit {
    let values/20: HashMap[Ref[CollisionKey], string] =
      (HashMap[Ref[CollisionKey], string]::new : () -> HashMap[Ref[CollisionKey], string])();
    let key/21: Ref[CollisionKey] =
      (Ref[CollisionKey]::new : (CollisionKey) -> Ref[CollisionKey])(CollisionKey { value: 1 });
    let alias/22: Ref[CollisionKey] = (key/21 : Ref[CollisionKey]);
    let equal_value/23: Ref[CollisionKey] =
      (Ref[CollisionKey]::new : (CollisionKey) -> Ref[CollisionKey])(CollisionKey { value: 1 });
    (HashMap[Ref[CollisionKey], string]::set : (
      HashMap[Ref[CollisionKey], string],
      Ref[CollisionKey],
      string
    ) -> unit)(
      (values/20 : HashMap[Ref[CollisionKey], string]),
      (key/21 : Ref[CollisionKey]),
      "identity"
    );
    (println : (bool) -> unit)(
      (PartialEq::eq : (Ref[CollisionKey], Ref[CollisionKey]) -> bool)(
        (key/21 : Ref[CollisionKey]),
        (alias/22 : Ref[CollisionKey])
      )
    );
    (println : (bool) -> unit)(
      (PartialEq::eq : (Ref[CollisionKey], Ref[CollisionKey]) -> bool)(
        (key/21 : Ref[CollisionKey]),
        (equal_value/23 : Ref[CollisionKey])
      )
    );
    (println : (bool) -> unit)(
      (Hash::hash : (Ref[CollisionKey]) -> uint64)((key/21 : Ref[CollisionKey])) ==
        (Hash::hash : (Ref[CollisionKey]) -> uint64)((alias/22 : Ref[CollisionKey]))
    );
    (print_opt_string : (Option[string]) -> unit)(
      (HashMap[Ref[CollisionKey], string]::get : (
        HashMap[Ref[CollisionKey], string],
        Ref[CollisionKey]
      ) -> Option[string])(
        (values/20 : HashMap[Ref[CollisionKey], string]),
        (alias/22 : Ref[CollisionKey])
      )
    );
    (print_opt_string : (Option[string]) -> unit)(
      (HashMap[Ref[CollisionKey], string]::get : (
        HashMap[Ref[CollisionKey], string],
        Ref[CollisionKey]
      ) -> Option[string])(
        (values/20 : HashMap[Ref[CollisionKey], string]),
        (equal_value/23 : Ref[CollisionKey])
      )
    );
    (Ref[CollisionKey]::set : (Ref[CollisionKey], CollisionKey) -> unit)(
      (key/21 : Ref[CollisionKey]),
      CollisionKey { value: 99 }
    );
    (print_opt_string : (Option[string]) -> unit)(
      (HashMap[Ref[CollisionKey], string]::get : (
        HashMap[Ref[CollisionKey], string],
        Ref[CollisionKey]
      ) -> Option[string])(
        (values/20 : HashMap[Ref[CollisionKey], string]),
        (key/21 : Ref[CollisionKey])
      )
    );
}

fn main() -> unit {
    (float_comparison_contracts : () -> unit)();
    (collision_contracts : () -> unit)();
    (reference_contracts : () -> unit)();
}