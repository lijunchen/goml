fn update_array(arr/0: [int32; 3]) -> [int32; 3] {
    let mut arr/1: [int32; 3] = (arr/0 : [int32; 3]);
    (arr/1 : [int32; 3])[1] = 42;
    (arr/1 : [int32; 3])
}

fn read_array(arr/2: [int32; 3]) -> int32 {
    (arr/2 : [int32; 3])[1]
}

fn main() -> unit {
    let arr/3: [int32; 3] = [1, 2, 3];
    let updated/4: [int32; 3] = (update_array : ([int32; 3]) -> [int32; 3])((arr/3 : [int32; 3]));
    let value/5: int32 = (read_array : ([int32; 3]) -> int32)((updated/4 : [int32; 3]));
    let _ : unit =
      (println : (string) -> unit)((int32::to_string : (int32) -> string)((value/5 : int32)));
    ()
}