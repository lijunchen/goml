package main;
trait Mark {
  fn mark(self: Self) -> unit;
}

trait Extra {
  fn extra(self: Self) -> i32;
}

impl Mark for i32 {
  fn mark(self: i32) -> unit {}
}

impl[T: Mark] Extra for T {
  fn extra(self: T) -> i32 {
      42
  }
}

fn apply[T: Extra](value: T) -> i32 {
    value.extra()
}

fn main() -> unit {
    let first: i32 = 1;
    let second: i32 = 2;
    println(apply(first));
    println(second.extra());
}

