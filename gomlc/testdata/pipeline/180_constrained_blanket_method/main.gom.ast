package main;
trait Mark {
  fn mark(self: Self) -> unit;
}

trait Extra {
  fn extra(self: Self) -> int32;
}

impl Mark for int32 {
  fn mark(self: int32) -> unit {}
}

impl[T: Mark] Extra for T {
  fn extra(self: T) -> int32 {
      42
  }
}

fn apply[T: Extra](value: T) -> int32 {
    value.extra()
}

fn main() -> unit {
    let first: int32 = 1;
    let second: int32 = 2;
    println(apply(first));
    println(second.extra());
}

