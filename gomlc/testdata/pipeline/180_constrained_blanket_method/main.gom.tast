impl Mark for int32{
  fn mark(self/0: int32) -> unit {
      ()
  }
}

impl[T] Extra for T where T: Mark{
  fn extra(self/1: T) -> int32 {
      42
  }
}

fn apply[T](value/2: T) -> int32 where T: Extra {
    (Extra::extra : (T) -> int32)((value/2 : T))
}

fn main() -> unit {
    let first/3: int32 = 1;
    let second/4: int32 = 2;
    (println : (int32) -> unit)((apply : (int32) -> int32)((first/3 : int32)));
    (println : (int32) -> unit)((Extra::extra : (int32) -> int32)((second/4 : int32)));
}