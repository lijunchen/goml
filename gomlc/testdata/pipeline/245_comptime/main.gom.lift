const ANSWER: isize = 120;

fn factorial(value/0: isize) -> isize {
  if (value/0 < 2) {
      1
  } else {
      (value/0 * factorial((value/0 - 1)))
  }
}

fn accumulate(limit/1: isize) -> isize {
  let index/2 = 0 in
  let total/3 = 0 in
  let _wild413 =
    while (index/2 < limit/1) {
        let _wild411 = total/3 = (total/3 + index/2) in
        let _wild412 = index/2 = (index/2 + 1) in
        ()
    } in
  total/3
}

fn make_pair(value/4: isize) -> Pair {
  Pair { left: value/4, right: (value/4 + 1) }
}

fn choose(value/5: isize) -> Choice {
  if (value/5 > 0) {
      Choice::Value(value/5)
  } else {
      Choice::Empty
  }
}

fn nonnegative(value/6: isize) -> isize {
  if (value/6 < 0) {
      @intrinsic(compiler.missing)("value must be non-negative")
  } else {
      value/6
  }
}

fn shadow(value/7: isize) -> isize {
  let base/8 = value/7 in
  let nested/10 =
    let base/9 = (base/8 + 1) in
    (base/9 * 2) in
  (base/9 + nested/10)
}

fn widen_negative(value/11: i8) -> u64 {
  (value/11 as u64)
}

fn main() -> unit {
  let values/12 = [6, 10, 4] in
  let pair/13 = Pair { left: 7, right: 8 } in
  let choice/14 = Choice::Value(9) in
  let _wild414 = println__T_isize(ANSWER) in
  let _wild415 = println__T_isize(@intrinsic(array.get)(values/12, 0)) in
  let _wild416 = println__T_isize(@intrinsic(array.get)(values/12, 1)) in
  let _wild417 = println__T_isize(@intrinsic(array.get)(values/12, 2)) in
  let _wild418 = println__T_isize((Pair.left(pair/13) + Pair.right(pair/13))) in
  let _wild420 =
    match choice/14 {
      Choice::Value(x419) => {
        let x419 = Choice::Value._0(choice/14) in
        let value/15 = x419 in
        println__T_isize(value/15)
      },
      Choice::Empty => {
        println__T_isize(0)
      },
    } in
  let _wild421 = println__T_bool((factorial(5) == ANSWER)) in
  let shadowed/16 = 12 in
  let _wild422 = println__T_isize(shadowed/16) in
  let _wild423 = println__T_bool((shadow(3) == shadowed/16)) in
  let widened/17 = 18446744073709551615 in
  let _wild424 = println__T_bool((widened/17 == widen_negative(-1))) in
  println__T_isize(factorial(4))
