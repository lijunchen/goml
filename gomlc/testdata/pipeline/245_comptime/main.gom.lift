  let total/3 = 0 in
  let _wild138 =
    while (index/2 < limit/1) {
        let _wild136 = total/3 = (total/3 + index/2) in
        let _wild137 = index/2 = (index/2 + 1) in
        ()
    } in
  total/3
}

fn make_pair(value/4: int) -> Pair {
  Pair { left: value/4, right: (value/4 + 1) }
}

fn choose(value/5: int) -> Choice {
  if (value/5 > 0) {
      Choice::Value(value/5)
  } else {
      Choice::Empty
  }
}

fn nonnegative(value/6: int) -> int {
  if (value/6 < 0) {
      @intrinsic(compiler.missing)("value must be non-negative")
  } else {
      value/6
  }
}

fn shadow(value/7: int) -> int {
  let base/8 = value/7 in
  let nested/10 =
    let base/9 = (base/8 + 1) in
    (base/9 * 2) in
  (base/9 + nested/10)
}

fn widen_negative(value/11: int8) -> uint64 {
  (value/11 as uint64)
}

