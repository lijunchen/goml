  let values/12 = [6, 10, 4] in
  let pair/13 = Pair { left: 7, right: 8 } in
  let choice/14 = Choice::Value(9) in
  let _wild139 = println__T_int(answer) in
  let _wild140 = println__T_int(@intrinsic(array.get)(values/12, 0)) in
  let _wild141 = println__T_int(@intrinsic(array.get)(values/12, 1)) in
