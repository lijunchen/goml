fn println__T_int(value/31: int) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#int#to_string(value/31))
}

fn println__T_bool(value/31: bool) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#bool#to_string(value/31))
}

fn trait_impl#Eq#int#eq(self/88: int, other/89: int) -> bool {
  @intrinsic(eq.primitive)(self/88, other/89)
}

fn trait_impl#Eq#uint64#eq(self/104: uint64, other/105: uint64) -> bool {
  @intrinsic(eq.primitive)(self/104, other/105)
