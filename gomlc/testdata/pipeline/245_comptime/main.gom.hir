package main
file main.gom
  struct Pair {
      left: int,
      right: int,
  }

  enum Choice {
      Value(int),
      Empty
  }

  #[comptime]
  fn factorial(local/1/0: int) -> int {
      if value/0 < 2 {
          1
      } else {
          value/0 * def/1/2(value/0 - 1)
      }
  }

  #[comptime]
  fn accumulate(local/1/1: int) -> int {
      let mut local/1/2 = 0;
      let mut local/1/3 = 0;
      while index/2 < limit/1 {
          {
              total/3 = total/3 + index/2;
              index/2 = index/2 + 1;
          }
      };
      total/3
  }

  #[comptime]
  fn make_pair(local/1/4: int) -> Pair {
      Pair { left: value/4, right: value/4 + 1 }
  }

  #[comptime]
  fn choose(local/1/5: int) -> Choice {
      if value/5 > 0 {
          ctor(def/1/1::v0)(value/5)
      } else {
          ctor(def/1/1::v1)
      }
  }

  #[comptime]
  fn nonnegative(local/1/6: int) -> int {
      if value/6 < 0 {
          compile_error("value must be non-negative")
      } else {
          value/6
      }
  }

  #[comptime]
  fn shadow(local/1/7: int) -> int {
      let local/1/8 = value/7;
      let local/1/10 =
        {
            let local/1/9 = base/8 + 1;
            base/9 * 2
        };
      base/9 + nested/10
  }

  #[comptime]
  fn widen_negative(local/1/11: int8) -> uint64 {
      value/11 as uint64
  }

  const answer: int = def/1/2(5);

  fn main() -> unit {
      let local/1/12 =
        comptime {
            [def/1/2(3), def/1/3(5), def/1/6(4)]
        };
      let local/1/13 =
        comptime {
            def/1/4(7)
        };
      let local/1/14 =
