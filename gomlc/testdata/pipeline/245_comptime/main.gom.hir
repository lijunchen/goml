        };
      println(def/1/9);
      println(values/12[0]);
      println(values/12[1]);
      println(values/12[2]);
      println(pair/13.left + pair/13.right);
      match choice/14 {
          ctor(def/1/1::v0)(local/1/15) => println(value/15),
          ctor(def/1/1::v1) => println(0),
      };
      println(def/1/2(5) == def/1/9);
      let local/1/16 =
