fn child(signal/0: Ref[i32]) -> unit {
    (Ref[i32]::set : (Ref[i32], i32) -> unit)((signal/0 : Ref[i32]), 1)
}

fn main() -> unit {
    let signal/1: Ref[i32] = (Ref[i32]::new : (i32) -> Ref[i32])(0);
    go || =>
      {
          (child : (Ref[i32]) -> unit)((signal/1 : Ref[i32]))
      };
    while (Ref[i32]::get : (Ref[i32]) -> i32)((signal/1 : Ref[i32])) < 1 {
        {}
    };
    (println : (string) -> unit)("main");
}