package main;
fn combine(left: uint, right: uint) -> uint {
    left + right * 2
}

fn classify(value: uint) -> string {
    match value {
        0 => "zero",
        42 => "answer",
        _ => "other",
    }
}

fn main() -> unit {
    let left: uint = 19;
    let right = 2 as uint;
    let result = combine(left, right);
    println(result);
    println(result.to_string());
    println(classify(result));
    println(result > left);
    println(result & 15 as uint64);
    let values: HashMap[uint, string] = HashMap::new();
    values.set(result, "stored");
    match values.get(42) {
        Option::Some(value) => println(value),
        Option::None => println("missing"),
    }
}

