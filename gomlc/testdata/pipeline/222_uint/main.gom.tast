fn combine(left/0: usize, right/1: usize) -> usize {
    (left/0 : usize) + (right/1 : usize) * 2
}

fn classify(value/2: usize) -> string {
    match (value/2 : usize) {
        0 => "zero",
        42 => "answer",
        _ : usize => "other",
    }
}

fn main() -> unit {
    let left/3: usize = 19;
    let right/4: usize = (isize::to_uint : (isize) -> usize)(2);
    let result/5: usize = (combine : (usize, usize) -> usize)((left/3 : usize), (right/4 : usize));
    (println : (usize) -> unit)((result/5 : usize));
    (println : (string) -> unit)((ToString::to_string : (usize) -> string)((result/5 : usize)));
    (println : (string) -> unit)((classify : (usize) -> string)((result/5 : usize)));
    (println : (bool) -> unit)((result/5 : usize) > (left/3 : usize));
    (println : (u64) -> unit)((usize::to_uint64 : (usize) -> u64)((result/5 : usize) & 15));
    let values/6: HashMap[usize, string] =
      (HashMap[usize, string]::new : () -> HashMap[usize, string])();
    (HashMap[usize, string]::set : (HashMap[usize, string], usize, string) -> unit)(
      (values/6 : HashMap[usize, string]),
      (result/5 : usize),
      "stored"
    );
    match (HashMap[usize, string]::get : (HashMap[usize, string], usize) -> Option[string])(
      (values/6 : HashMap[usize, string]),
      42
    ) {
        Option::Some(value/7: string) => (println : (string) -> unit)((value/7 : string)),
        Option::None => (println : (string) -> unit)("missing"),
    }
}