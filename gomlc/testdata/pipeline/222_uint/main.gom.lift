  let left/3 = 19 in
  let right/4 = (2 as uint) in
  let result/5 = combine(left/3, right/4) in
  let _wild182 = println__T_uint(result/5) in
  let _wild183 = println__T_string(trait_impl#ToString#uint#to_string(result/5)) in
  let _wild184 = println__T_string(classify(result/5)) in
  let _wild185 = println__T_bool((result/5 > left/3)) in
  let _wild186 = println__T_uint64(((result/5 & 15) as uint64)) in
  let values/6 = inherent#HashMap#HashMap[K,V]#new__K_uint__V_string() in
  let _wild187 =
