fn combine(left/0: uint, right/1: uint) -> uint {
  ((left/0 + right/1) * 2)
}

fn classify(value/2: uint) -> string {
  match value/2 {
    0 => {
      "zero"
    },
    42 => {
      "answer"
    },
    _ => "other",
  }
}

fn main() -> unit {
  let left/3 = 19 in
  let right/4 = (2 as uint) in
  let result/5 = combine(left/3, right/4) in
  let _wild136 = println__T_uint(result/5) in
  let _wild137 = println__T_string(trait_impl#ToString#uint#to_string(result/5)) in
  let _wild138 = println__T_string(classify(result/5)) in
  let _wild139 = println__T_bool((result/5 > left/3)) in
  let _wild140 = println__T_uint64(((result/5 & 15) as uint64)) in
  let values/6 = inherent#HashMap#HashMap[K,V]#new__K_uint__V_string() in
  let _wild141 =
    inherent#HashMap#HashMap[K,V]#set__K_uint__V_string(values/6, result/5, "stored") in
  let mtmp142 = inherent#HashMap#HashMap[K,V]#get__K_uint__V_string(values/6, 42) in
  match mtmp142 {
    Option__string::None => {
      println__T_string("missing")
    },
    Option__string::Some(x143) => {
      let x143 = Option__string::Some._0(mtmp142) in
      let value/7 = x143 in
      println__T_string(value/7)
    },
  }
}

