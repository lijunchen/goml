    _ => "other",
  }
}

fn main() -> unit {
  let left/3 = 19 in
  let right/4 = (2 as uint) in
  let result/5 = combine(left/3, right/4) in
  let _wild172 = println__T_uint(result/5) in
  let _wild173 = println__T_string(trait_impl#ToString#uint#to_string(result/5)) in
  let _wild174 = println__T_string(classify(result/5)) in
  let _wild175 = println__T_bool((result/5 > left/3)) in
  let _wild176 = println__T_uint64(((result/5 & 15) as uint64)) in
  let values/6 = inherent#HashMap#HashMap[K,V]#new__K_uint__V_string() in
  let _wild177 =
    inherent#HashMap#HashMap[K,V]#set__K_uint__V_string(values/6, result/5, "stored") in
  {
    let mtmp178 = inherent#HashMap#HashMap[K,V]#get__K_uint__V_string(values/6, 42) in
    match mtmp178 {
      Option__string::None => {
        println__T_string("missing")
