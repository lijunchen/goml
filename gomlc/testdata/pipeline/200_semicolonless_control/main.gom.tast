        {
            (println : (string) -> unit)(
              (int::to_string : (int) -> string)(
                (Ref[int]::get : (Ref[int]) -> int)((index/0 : Ref[int]))
              )
            );
            (Ref[int]::set : (Ref[int], int) -> unit)(
