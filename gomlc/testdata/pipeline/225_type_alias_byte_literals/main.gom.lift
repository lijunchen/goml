fn sum_pair(value/0: (int32, int32)) -> int32 {
  (value/0.0 + value/0.1)
}

fn classify(value/1: uint8) -> string {
  let match187 = value/1 in
  if (match187 == 10) {
      "newline"
  } else {
      if (match187 >= 65) {
          if (match187 <= 90) {
              "uppercase"
          } else {
              "other"
          }
      } else {
          "other"
      }
  }
}

fn main() -> unit {
  let user/2 = 255 in
  let pair/3 = (10, 10) in
  let marker/4 = 65 in
  let _wild188 = println__T_uint64(user/2) in
  let _wild189 = println__T_int32(sum_pair(pair/3)) in
  let _wild190 = println__T_uint8(marker/4) in
  let _wild191 = println__T_string(classify(marker/4)) in
  println__T_string(classify(10))
}

fn println__T_uint64(value/1: uint64) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#uint64#to_string(value/1))
}

fn println__T_int32(value/1: int32) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#int32#to_string(value/1))
