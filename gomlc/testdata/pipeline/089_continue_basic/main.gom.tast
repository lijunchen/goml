fn main() -> unit {
    let i/0: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) < 10 {
        {
            (Ref[int]::set : (Ref[int], int) -> unit)(
              (i/0 : Ref[int]),
              (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) + 1
            );
            if (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) == 5 {
                {
                    continue
                }
            } else {
                {
                    ()
                }
            };
            let _ : unit =
              (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])));
        }
    };
    let _ : unit = (println : (string) -> unit)("done");
}