package main
file main.gom
  trait Show {
      fn show(Self) -> string;
    }
    
    enum Boxed[T] {
        One(T)
    }
    
    impl Show for Boxed[int32] {
      fn show(local/1/0: Boxed[int32]) -> string {
          match self/0 {
              ctor(def/1/1::v0)(local/1/1) => value/1.to_string(),
          }
      }
    }
    
    fn make_boxed[T](local/1/2: T) -> Boxed[T] {
        ctor(def/1/1::v0)(value/2)
    }
    
    fn render(local/1/3: dyn Show) -> string {
        Show::show(value/3)
    }
    
    fn main() -> unit {
        let local/1/4: int32 = 42;
        println(def/1/4(def/1/3(value/4)))
    }