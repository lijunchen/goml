fn main() -> unit {
    let a/0: (bool, bool) = (true, true);
    match (a/0 : (bool, bool)) {
        (true, false) => (println : (string) -> unit)((int::to_string : (int) -> string)(123)),
        (false, true) => (println : (string) -> unit)((int::to_string : (int) -> string)(456)),
        _ : (bool, bool) => (println : (string) -> unit)((int::to_string : (int) -> string)(789)),
    }
}