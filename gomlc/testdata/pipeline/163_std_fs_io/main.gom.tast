fn show_read(res/0: Result[string, string]) -> string {
    match (res/0 : Result[string, string]) {
        Result::Ok(value/1: string) => (value/1 : string),
        Result::Err(err/2: string) => "err " + (err/2 : string),
    }
}

fn show_dir(res/3: Result[Vec[string], string]) -> string {
    match (res/3 : Result[Vec[string], string]) {
        Result::Ok(names/4: Vec[string]) =>
          (ToString::to_string : (bool) -> string)(
            (Vec[string]::len : (Vec[string]) -> isize)((names/4 : Vec[string])) > 0
          ),
        Result::Err(err/5: string) => "err " + (err/5 : string),
    }
}

fn main() -> () {
    let _ : Result[(), string] =
      (std::fs::write_file : (string, string) -> Result[(), string])("goml-std-test.txt", "std-ok");
    (std::io::println : (string) -> ())(
      (show_read : (Result[string, string]) -> string)(
        (std::fs::read_file : (string) -> Result[string, string])("goml-std-test.txt")
      )
    );
    (std::io::println : (string) -> ())(
      (ToString::to_string : (bool) -> string)(
        (std::fs::exists : (string) -> bool)("goml-std-test.txt")
      )
    );
    (std::io::println : (string) -> ())(
      (show_dir : (Result[Vec[string], string]) -> string)(
        (std::fs::read_dir : (string) -> Result[Vec[string], string])(".")
      )
    );
}