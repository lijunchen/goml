fn loop_return_unit(flag/0: bool) -> unit {
    while if (flag/0 : bool) {
        {
            return
        }
    } else {
        {
            return
        }
    } {
        {
            (println : (string) -> unit)("unreachable");
        }
    }
}

fn loop_return() -> i32 {
    while match 0 {
        _ : isize => return 5,
    } {
        {
            (println : (string) -> unit)("unreachable");
        }
    };
    0
}

fn main() -> unit {
    (loop_return_unit : (bool) -> unit)(true);
    (println : (i32) -> unit)((loop_return : () -> i32)());
}