package main
file main.gom
  trait Display {
    fn display(Self) -> string;
  }

  trait Source {
    type Item;
    fn get(Self) -> Self::Item;
  }

  struct Number {
      value: int,
  }

  impl Display for Number {
    fn display(local/1/0: Number) -> string {
        self/0.value.to_string()
    }
  }

  impl Source for Number {
    type Item = int;
    fn get(local/1/1: Number) -> int {
        self/1.value
    }
  }

  fn erase[T: Display](local/1/2: T) -> dyn Display {
      value/2 as dyn Display
  }

  fn main() -> unit {
      let local/1/3 = Number { value: 42 } as dyn Display;
      println(display/3.display());
      let local/1/4 = def/1/5(Number { value: 7 });
      println(erased/4.display());
      let local/1/5 = Number { value: 11 } as dyn Source[Item = int];
      println(source/5.get());
      let local/1/6 = Number { value: 13 } as dyn Display as dyn Display;
      println(same/6.display())
  }