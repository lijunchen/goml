    (legacy/9 : (int, int)).1 += 1;
    (println : (int) -> unit)((legacy/9 : (int, int)).0 + (legacy/9 : (int, int)).1);
    let mut steps/10: int = 0;
    while (steps/10 : int) < 3 {
        {
            (steps/10 : int) += 1;
            loop {
                continue@1;
            }
        }
    };
    (println : (int) -> unit)((steps/10 : int));
    let seen/11: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    for row/12: int in
      (range : (int, int) -> FnIterator[int])(0, 3) {
        for column/13: int in
          (range : (int, int) -> FnIterator[int])(0, 3) {
            (Ref[int]::set : (Ref[int], int) -> unit)(
              (seen/11 : Ref[int]),
              (Ref[int]::get : (Ref[int]) -> int)((seen/11 : Ref[int])) + 1
            );
            if (row/12 : int) == 1 && (column/13 : int) == 1 {
                {
                    break@1;
                }
            } else {
                {
                    ()
                }
            }
        }
    };
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((seen/11 : Ref[int])));
    let answer/14: int =
      loop {
          loop {
              break@1 42;
          }
      };
    (println : (int) -> unit)((answer/14 : int));
    (labeled_cleanup : () -> unit)()
}