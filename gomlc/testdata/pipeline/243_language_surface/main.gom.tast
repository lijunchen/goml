impl Source for NumberSource {
  fn get(self/0: NumberSource) -> isize {
      (self/0 : NumberSource).value
  }
}

fn read(source/1: dyn Source[Item = isize]) -> isize {
    (dyn Source::get : (dyn Source[Item = isize]) -> isize)((source/1 : dyn Source[Item = isize]))
}

fn labeled_cleanup() -> unit {
    loop {
        defer (println : (string) -> unit)("outer cleanup");
        loop {
            defer (println : (string) -> unit)("inner cleanup");
            break@1;
        }
    }
}

