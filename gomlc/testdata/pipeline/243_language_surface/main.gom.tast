impl Source for NumberSource {
  fn get(self/0: NumberSource) -> int {
      (self/0 : NumberSource).value
  }
}

fn read(source/1: dyn Source[Item = int]) -> int {
    (dyn Source::get : (dyn Source[Item = int]) -> int)((source/1 : dyn Source[Item = int]))
}

fn labeled_cleanup() -> unit {
    loop {
        defer (println : (string) -> unit)("outer cleanup");
        loop {
            defer (println : (string) -> unit)("inner cleanup");
            break@1;
        }
    }
}

fn main() -> unit {
    (println : (int) -> unit)(
      (read : (dyn Source[Item = int]) -> int)(
        to_dyn[Source]{NumberSource}(NumberSource { value: 11 })
