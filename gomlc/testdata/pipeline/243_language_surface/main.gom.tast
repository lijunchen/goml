    (println : (isize) -> unit)((steps/10 : isize));
    let seen/11: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    for row/12: isize in
      (range : (isize, isize) -> FnIterator[isize])(0, 3) {
