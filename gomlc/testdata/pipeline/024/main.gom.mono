  let mtmp197 = println__T_string(point_type(p0/10)) in
  {
    let p1/11 = Point { x: 10, y: 10 } in
    let line/12 = Line { from: p0/10, to: p1/11, color: Color::Red } in
    println__T_string(line_to_string(line/12))
