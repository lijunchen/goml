}

fn color_to_string(c/3: Color) -> string {
  match c/3 {
    Color::Red => {
      "Red"
    },
    Color::Green => {
      "Green"
    },
    Color::Blue => {
      "Blue"
    },
  }
}

fn line_to_string(l/4: Line) -> string {
  let mtmp190 = l/4 in
  {
    let x191 = Line.from(mtmp190) in
    let x192 = Line.to(mtmp190) in
    let x193 = Line.color(mtmp190) in
    {
      let color/7 = x193 in
