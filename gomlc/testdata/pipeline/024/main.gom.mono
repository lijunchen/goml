    match x143 {
      0 => {
        match x144 {
          0 => {
            {
              "origin"
            }
          },
          1 => {
            {
              "up"
            }
          },
          _ =>
            {
              let y/9 = x144 in
              {
                {
                  let mtmp145 = (0 < y/9) in
                  match mtmp145 {
                    true => {
                      "above"
                    },
                    false => {
                      "below"
                    },
                  }
                }
              }
            },
        }
      },
      1 => {
        match x144 {
          0 => {
            {
              "right"
            }
          },
          _ => "unknown",
