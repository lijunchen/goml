            (((((("Line { from: " + point32_to_string(from/5)) + ", to: ") +
              point32_to_string(to/6)) +
              ", color: ") +
              color_to_string(color/7)) +
              " }")
          }
        }
      }
    }
  }
}

fn point_type(p/8: Point) -> string {
  {
    let x194 = Point.x(p/8) in
    let x195 = Point.y(p/8) in
    match x194 {
      0 => {
        match x195 {
          0 => {
            {
              "origin"
            }
          },
          1 => {
            {
              "up"
            }
          },
          _ =>
            {
              let y/9 = x195 in
              {
                {
                  let mtmp196 = (0 < y/9) in
                  match mtmp196 {
                    true => {
                      "above"
                    },
                    false => {
                      "below"
                    },
                  }
                }
              }
            },
        }
      },
      1 => {
        match x195 {
          0 => {
            {
              "right"
            }
          },
          _ => "unknown",
        }
      },
      _ => "unknown",
    }
  }
}

fn main() -> unit {
