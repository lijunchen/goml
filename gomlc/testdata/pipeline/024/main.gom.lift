fn point_type(p/8: Point) -> string {
  let x179 = Point.x(p/8) in
  let x180 = Point.y(p/8) in
  match x179 {
    0 => {
      match x180 {
        0 => {
          "origin"
        },
        1 => {
          "up"
        },
        _ =>
          let y/9 = x180 in
          let mtmp181 = (0 < y/9) in
          match mtmp181 {
            true => {
              "above"
            },
            false => {
              "below"
            },
          },
      }
    },
    1 => {
      match x180 {
        0 => {
          "right"
        },
        _ => "unknown",
      }
    },
    _ => "unknown",
  }
}

