fn point_type(p/8: Point) -> string {
  let x415 = Point.x(p/8) in
  let x416 = Point.y(p/8) in
  match x415 {
    0 => {
      match x416 {
        0 => {
          "origin"
        },
        1 => {
          "up"
        },
        _ =>
          let y/9 = x416 in
          let mtmp417 = (0 < y/9) in
          match mtmp417 {
            true => {
              "above"
            },
            false => {
              "below"
            },
          },
      }
    },
    1 => {
      match x416 {
        0 => {
          "right"
        },
        _ => "unknown",
      }
    },
    _ => "unknown",
  }
}

