fn point_type(p/8: Point) -> string {
  let x189 = Point.x(p/8) in
  let x190 = Point.y(p/8) in
  match x189 {
    0 => {
      match x190 {
        0 => {
          "origin"
        },
        1 => {
          "up"
        },
        _ =>
          let y/9 = x190 in
          let mtmp191 = (0 < y/9) in
          match mtmp191 {
            true => {
              "above"
            },
            false => {
              "below"
            },
          },
      }
    },
    1 => {
      match x190 {
        0 => {
          "right"
        },
        _ => "unknown",
      }
    },
    _ => "unknown",
  }
}

