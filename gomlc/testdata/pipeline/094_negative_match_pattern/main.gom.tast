fn classify(n/0: i32) -> string {
    match (n/0 : i32) {
        -1 => "minus one",
        0 => "zero",
        1 => "one",
        _ : i32 => "other",
    }
}

fn main() -> unit {
    (println : (string) -> unit)((classify : (i32) -> string)(-1));
    (println : (string) -> unit)((classify : (i32) -> string)(0));
    (println : (string) -> unit)((classify : (i32) -> string)(1));
    (println : (string) -> unit)((classify : (i32) -> string)(42));
}