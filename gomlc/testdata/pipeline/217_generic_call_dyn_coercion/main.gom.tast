impl Show for Wrap[int32] {
  fn show(self/0: Wrap[int32]) -> string {
      (int32::to_string : (int32) -> string)((self/0 : Wrap[int32]).value)
  }
}

fn make_wrap[T](value/1: T) -> Wrap[T] {
    Wrap { value: (value/1 : T) }
}

fn render(value/2: dyn Show) -> string {
    (dyn Show::show : (dyn Show) -> string)((value/2 : dyn Show))
}

fn main() -> unit {
    let value/3: int32 = 42;
    (println : (string) -> unit)(
      (render : (dyn Show) -> string)(
        to_dyn[Show]{Wrap[int32]}((make_wrap : (int32) -> Wrap[int32])((value/3 : int32)))
      )
    )
}