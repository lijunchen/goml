fn choose(flag/0: bool) -> i32 {
    let value/1: i32 =
      if (flag/0 : bool) {
          {
              return 10
          }
      } else {
          {
              20
          }
      };
    (value/1 : i32) + 1
}

fn continue_branch() -> unit {
    let count/2: Ref[isize] = (Ref[isize]::new : (isize) -> Ref[isize])(0);
    while (Ref[isize]::get : (Ref[isize]) -> isize)((count/2 : Ref[isize])) < 2 {
        {
            (Ref[isize]::set : (Ref[isize], isize) -> unit)(
              (count/2 : Ref[isize]),
              (Ref[isize]::get : (Ref[isize]) -> isize)((count/2 : Ref[isize])) + 1
            );
            let value/3: isize =
              if (Ref[isize]::get : (Ref[isize]) -> isize)((count/2 : Ref[isize])) == 1 {
                  {
                      continue
                  }
              } else {
                  {
                      7
                  }
              };
            (println : (isize) -> unit)((value/3 : isize))
        }
    }
}

fn break_branch(stop/4: bool) -> unit {
    while true {
        {
            let value/5: isize =
              if (stop/4 : bool) {
                  {
                      break
                  }
              } else {
                  {
                      9
                  }
              };
            (println : (isize) -> unit)((value/5 : isize));
            break
        }
    }
}

fn main() -> unit {
    (println : (i32) -> unit)((choose : (bool) -> i32)(false));
    (println : (i32) -> unit)((choose : (bool) -> i32)(true));
    (continue_branch : () -> unit)();
    (break_branch : (bool) -> unit)(false);
    (break_branch : (bool) -> unit)(true)
}