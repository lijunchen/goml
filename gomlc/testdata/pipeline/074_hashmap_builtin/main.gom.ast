package main;
#[derive(Hash, Eq)]
struct Point {
    x: int32,
    y: int32,
}

impl Hash for Point {
  fn hash(self: Point) -> uint64 {
      {
          let h = 0 as uint64 + 14695981039346656037;
          let h = h * 0 as uint64 + 1099511628211 + Hash::hash(self.x);
          let h = h * 0 as uint64 + 1099511628211 + Hash::hash(self.y);
          h
      }
  }
}

impl Eq for Point {
  fn eq(self: Point, other: Point) -> bool {
      true && Eq::eq(self.x, other.x) && Eq::eq(self.y, other.y)
  }
}

#[derive(Hash, Eq)]
enum Key {
    A,
    B(int32),
    P(Point)
}

impl Hash for Key {
  fn hash(self: Key) -> uint64 {
      match self {
          Key::A =>
            {
                let h = 0 as uint64 + 14695981039346656037 + 1;
                h
            },
          Key::B(#derive0_field) =>
            {
                let h = 0 as uint64 + 14695981039346656037 + 2;
                let h = h * 0 as uint64 + 1099511628211 + Hash::hash(#derive0_field);
                h
            },
          Key::P(#derive1_field) =>
            {
                let h = 0 as uint64 + 14695981039346656037 + 3;
                let h = h * 0 as uint64 + 1099511628211 + Hash::hash(#derive1_field);
                h
            },
      }
  }
}

impl Eq for Key {
  fn eq(self: Key, other: Key) -> bool {
      match (self, other) {
          (Key::A, Key::A) => true,
          (Key::B(#derive0_left), Key::B(#derive1_right)) =>
            true && Eq::eq(#derive0_left, #derive1_right),
          (Key::P(#derive2_left), Key::P(#derive3_right)) =>
            true && Eq::eq(#derive2_left, #derive3_right),
          _ => false,
      }
  }
}

fn print_opt_int(x: Option[int32]) -> unit {
    match x {
        Option::Some(v) => println(v),
        Option::None => println("none"),
    }
}

fn main() -> unit {
    let m1 = HashMap::new();
    m1.set(Key::A, 10);
    m1.set(Key::B(1), 20);
    println(m1.len());
    print_opt_int(m1.get(Key::A));
    println(m1.contains(Key::B(1)));
    m1.remove(Key::B(1));
    println(m1.contains(Key::B(1)));
    println(m1.len());
    let m2 = HashMap::new();
    let p1 = Ref::new(Point { x: 1, y: 2 });
    let p2 = Ref::new(Point { x: 1, y: 2 });
    m2.set(p1, 99);
    print_opt_int(m2.get(p1));
    print_opt_int(m2.get(p2));
    p1.set(Point { x: 9, y: 8 });
    print_opt_int(m2.get(p1));
    println(Eq::eq(p1, p2));
    let m3 = HashMap::new();
    let k1 = Ref::new(Key::B(7));
    let k2 = k1;
    m3.set(k1, 123);
    print_opt_int(m3.get(k2));
}

