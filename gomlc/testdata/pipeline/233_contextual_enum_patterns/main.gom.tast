fn classify(value/0: First[int]) -> string {
    match (value/0 : First[int]) {
        First::Shared(number/1: int) => "shared:" + (int::to_string : (int) -> string)((number/1 : int)),
        First::Idle => "idle",
        First::Data(value/2: int, label/3: string) => (label/3 : string) + ":" + (int::to_string : (int) -> string)((value/2 : int)),
    }
}

fn nested(value/4: Option[Result[int, string]]) -> string {
    match (value/4 : Option[Result[int, string]]) {
        Option::Some(Result::Ok(number/5: int)) => "ok:" + (int::to_string : (int) -> string)((number/5 : int)),
        Option::Some(Result::Err(message/6: string)) => "err:" + (message/6 : string),
        Option::None => "none",
    }
}

fn optional_number(value/7: Option[int]) -> int {
    match (value/7 : Option[int]) {
        Option::Some(number/8: int) => {
              (number/8 : int)
          },
        _ : Option[int] => {
              0
          },
    }
}

fn is_non_shared(value/9: First[int]) -> bool {
    match (value/9 : First[int]) {
        First::Idle | First::Data(_ : int, _ : string) => true,
        First::Shared(_ : int) => false,
    }
}

fn take_once(value/10: Option[int]) -> int {
    let current/11: Ref[Option[int]] = (Ref[Option[int]]::new : (Option[int]) -> Ref[Option[int]])((value/10 : Option[int]));
    let result/12: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while true {
        match (Ref[Option[int]]::get : (Ref[Option[int]]) -> Option[int])((current/11 : Ref[Option[int]])) {
            Option::Some(number/13: int) => {
                  (Ref[int]::set : (Ref[int], int) -> unit)((result/12 : Ref[int]), (number/13 : int));
                  (Ref[Option[int]]::set : (Ref[Option[int]], Option[int]) -> unit)((current/11 : Ref[Option[int]]), Option::None);
              },
            _ : Option[int] => break,
        }
    };
    (Ref[int]::get : (Ref[int]) -> int)((result/12 : Ref[int]))
}

fn unbox(value/14: Boxed[int]) -> int {
    let Boxed::Value(number/15: int) = (value/14 : Boxed[int]);
    (number/15 : int)
}

fn sum_boxed(values/16: Vec[Boxed[int]]) -> int {
    let result/17: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    for Boxed::Value(number/18: int) in (values/16 : Vec[Boxed[int]]) {
        (Ref[int]::set : (Ref[int], int) -> unit)((result/17 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((result/17 : Ref[int])) + (number/18 : int));
    };
    (Ref[int]::get : (Ref[int]) -> int)((result/17 : Ref[int]))
}

fn main() -> unit {
    let boxed/19: Vec[Boxed[int]] = {
        let vec_literal/1450: Vec[Boxed[int]] = (Vec[Boxed[int]]::new : () -> Vec[Boxed[int]])();
        (Vec[Boxed[int]]::push : (Vec[Boxed[int]], Boxed[int]) -> unit)((vec_literal/1450 : Vec[Boxed[int]]), Boxed::Value(19));
        (Vec[Boxed[int]]::push : (Vec[Boxed[int]], Boxed[int]) -> unit)((vec_literal/1450 : Vec[Boxed[int]]), Boxed::Value(23));
        (vec_literal/1450 : Vec[Boxed[int]])
    };
    (println : (string) -> unit)((classify : (First[int]) -> string)(First::Shared(7)));
    (println : (string) -> unit)((classify : (First[int]) -> string)(First::Idle));
    (println : (string) -> unit)((classify : (First[int]) -> string)(First::Data(9, "data")));
    (println : (string) -> unit)((nested : (Option[Result[int, string]]) -> string)(Option::Some(Result::Ok(11))));
    (println : (string) -> unit)((nested : (Option[Result[int, string]]) -> string)(Option::Some(Result::Err("bad"))));
    (println : (string) -> unit)((nested : (Option[Result[int, string]]) -> string)(Option::None));
    (println : (int) -> unit)((optional_number : (Option[int]) -> int)(Option::Some(13)));
    (println : (int) -> unit)((optional_number : (Option[int]) -> int)(Option::None));
    (println : (bool) -> unit)((is_non_shared : (First[int]) -> bool)(First::Idle));
    (println : (bool) -> unit)((is_non_shared : (First[int]) -> bool)(First::Shared(1)));
    (println : (int) -> unit)((take_once : (Option[int]) -> int)(Option::Some(15)));
    (println : (int) -> unit)((unbox : (Boxed[int]) -> int)(Boxed::Value(17)));
    (println : (int) -> unit)((sum_boxed : (Vec[Boxed[int]]) -> int)((boxed/19 : Vec[Boxed[int]])))
}