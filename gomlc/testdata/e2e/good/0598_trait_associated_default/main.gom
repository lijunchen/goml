trait Default {
    fn default() -> Self;
}

struct Value {
    number: int32,
}

impl Default for Value {
    fn default() -> Value {
        Value { number: 7 }
    }
}

fn make_default[T: Default]() -> T {
    Default::default()
}

fn main() -> unit {
    let value: Value = make_default();
    println(value.number)
}
