trait Encode {
    fn encode(self: Self) -> string;
}

trait Decode {
    fn decode(input: string) -> Self;
}

struct MyInt {
    value: int32,
}

impl Encode for MyInt {
    fn encode(self: MyInt) -> string {
        "i:" + self.value.to_string()
    }
}

impl Decode for MyInt {
    fn decode(input: string) -> MyInt {
        println(input);
        MyInt { value: 42 }
    }
}

fn round_trip[T: Encode + Decode](value: T) -> T {
    Decode::decode(Encode::encode(value))
}

fn main() -> unit {
    let decoded: MyInt = round_trip(MyInt { value: 99 });
    println(decoded.value)
}
