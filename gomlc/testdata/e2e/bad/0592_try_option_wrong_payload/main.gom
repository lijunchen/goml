enum Option[T] {
    None,
    Some(string),
}

fn maybe(flag: bool) -> Option[int32] {
    if flag {
        Option::Some("x")
    } else {
        Option::None
    }
}

fn compute(flag: bool) -> Option[int32] {
    let value = maybe(flag)?;
    Option::Some(value.to_string())
}

fn main() -> unit {
    match compute(true) {
        Option::Some(value) => println(value),
        Option::None => println("none"),
    };
}
