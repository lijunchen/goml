trait Display {
    fn display(self: Self) -> string;
}

struct DynDisplay {
    value: int32,
}

struct Box {
    text: string,
}

impl Display for Box {
    fn display(self: Self) -> string {
        self.text
    }
}

fn main() -> unit {
    let c = DynDisplay { value: 1 };
    let d: dyn Display = Box { text: "ok" } as dyn Display;
    println(Display::display(d) + c.value.to_string());
}
