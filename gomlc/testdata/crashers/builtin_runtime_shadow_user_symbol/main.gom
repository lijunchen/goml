fn hashmap_new() -> int32 {
    7
}

fn ref(x: int32) -> int32 {
    x + 1
}

fn vec_len() -> int32 {
    9
}

fn int32_to_string() -> string {
    "user"
}

fn main() -> unit {
    let m: HashMap[int32, int32] = HashMap::new();
    m.set(1, 2);
    println(hashmap_new());
    println(m.len());

    let r = Ref::new(2);
    println(ref(3));
    println(r.get());

    let v: Vec[int32] = Vec::new();
    v.push(1);
    println(vec_len());
    println(v.len());

    println(int32_to_string());
    println(3.to_string());
}
