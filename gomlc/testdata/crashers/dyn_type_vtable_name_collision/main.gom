trait A {
    fn f(self: Self) -> int32;
}

trait A_vtable {
    fn g(self: Self) -> int32;
}

struct S {}

impl A for S {
    fn f(self: S) -> int32 {
        3
    }
}

impl A_vtable for S {
    fn g(self: S) -> int32 {
        4
    }
}

fn main() -> unit {
    let left: dyn A = S {} as dyn A;
    let right: dyn A_vtable = S {} as dyn A_vtable;
    println(A::f(left) + A_vtable::g(right));
}
