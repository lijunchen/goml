trait Inner {
    fn inner(self: Self) -> unit;
}

trait Outer {
    fn outer(self: Self) -> unit;
}

impl Inner for i32 {
    fn inner(self: i32) -> unit { () }
}

impl[T: Inner] Outer for Vec[T] {
    fn outer(self: Vec[T]) -> unit { () }
}

fn require_outer[T: Outer](value: T) -> unit {
    ()
}

fn main() -> unit {
    let values = vec_new();
    require_outer(values)
}
