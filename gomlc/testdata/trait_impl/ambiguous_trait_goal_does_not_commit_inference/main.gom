trait Mark {
    fn mark(self: Self) -> unit;
}

impl Mark for i32 {
    fn mark(self: i32) -> unit { () }
}

impl Mark for string {
    fn mark(self: string) -> unit { () }
}

fn require_mark[T: Mark](value: T) -> unit {
    ()
}

fn main() -> unit {
    let consume = |value| require_mark(value);
    ()
}
