package strings;

use std::testing;

#[test]
fn matches_at_byte_offsets_without_boundary_panics() -> unit {
    testing::assert(starts_with_at("éx", 2, "x"));
    testing::assert(!starts_with_at("éx", 1, "x"));
    testing::assert(starts_with_at("语言 goml", 7, "goml"));
    testing::assert(!starts_with_at("语言 goml", -1, "语言"));
    testing::assert(!starts_with_at("语言", 0, "语言 goml"))
}

#[test]
fn finds_reverse_byte_offsets_without_crossing_utf8_boundaries() -> unit {
    match rfind("a::语言::z", "::") {
        Some(index) => testing::assert_eq(index, 9),
        None => testing::fail("expected last separator"),
    };
    match rfind("语言", "") {
        Some(index) => testing::assert_eq(index, 6),
        None => testing::fail("expected trailing empty match"),
    };
    match rfind("语言", "rust") {
        Some(_) => testing::fail("expected no reverse match"),
        None => (),
    }
}
