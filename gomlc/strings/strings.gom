package strings;

fn region_matches(value: string, start: int, expected: string) -> bool {
    if start < 0 || start + expected.byte_len() > value.byte_len() {
        false
    } else {
        for offset in 0..expected.byte_len() {
            if value.byte_get(start + offset) != expected.byte_get(offset) {
                return false
            } else {
                ()
            }
        };
        true
    }
}

pub fn starts_with_at(value: string, start: int, prefix: string) -> bool {
    region_matches(value, start, prefix)
}

pub fn rfind(value: string, expected: string) -> Option[int] {
    if expected.byte_len() > value.byte_len() {
        Option::None
    } else {
        let mut start = value.byte_len() - expected.byte_len();
        while start >= 0 {
            if region_matches(value, start, expected) {
                return Option::Some(start)
            } else {
                start = start - 1;
            }
        };
        Option::None
    }
}
