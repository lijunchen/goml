package numeric;

pub fn parse_float32(value: string) -> Option[float64] {
    let (valid, parsed) = string_parse_float32(value);
    if valid {
        Option::Some(parsed)
    } else {
        Option::None
    }
}

pub fn parse_float64(value: string) -> Option[float64] {
    let (valid, parsed) = string_parse_float64(value);
    if valid {
        Option::Some(parsed)
    } else {
        Option::None
    }
}
