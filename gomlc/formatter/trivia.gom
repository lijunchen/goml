package formatter;

use gomlc::lexer;

fn whitespace_newlines(value: string) -> int {
    let count: Ref[int] = Ref::new(0);
    for index in 0..value.byte_len() {
        if value.byte_get(index) == 10 {
            count.set(count.get() + 1)
        } else {
            ()
        }
    };
    count.get()
}

fn trivia_newlines(values: Vec[LocatedToken]) -> int {
    let count: Ref[int] = Ref::new(0);
    for value in values {
        if token_is(value, lexer::TokenKind::Whitespace) {
            count.set(count.get() + whitespace_newlines(value.token.text))
        } else {
            ()
        }
    };
    count.get()
}

fn trivia_has_comment(values: Vec[LocatedToken]) -> bool {
    for value in values {
        if token_is(value, lexer::TokenKind::Comment) {
            return true
        } else {
            ()
        }
    };
    false
}
