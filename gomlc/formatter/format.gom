package formatter;

use module::cst;
use module::lexer;
use module::parser;
use std::text;

pub struct FormatError {
    pub diagnostics: Vec[cst::Diagnostic],
}

struct FormatOmission {
    start: isize,
    end: isize,
}

struct FormatExpansion {
    start: isize,
    end: isize,
}

fn canonical_file_ending(value: string) -> string {
    let end: Ref[isize] = Ref::new(value.byte_len());
    while end.get() > 0 {
        let byte = value.byte_get(end.get() - 1);
        if byte == b'\n' || byte == b'\r' {
            end.set(end.get() - 1)
        } else {
            break
        }
    }
    if end.get() == 0 {
        ""
    } else {
        value.byte_slice(0, end.get()) + "\n"
    }
}

fn format_next_non_trivia(tokens: Vec[lexer::Token], start: isize) -> Option[lexer::TokenKind] {
    for index in start..tokens.len() {
        if lexer::token_is_trivia(tokens[index].kind) {} else {
            return Option::Some(tokens[index].kind)
        }
    }
    Option::None
}

fn format_closing_delimiter(kind: lexer::TokenKind) -> bool {
    match kind {
        RParen | RBracket | RBrace | Pipe => true,
        _ => false,
    }
}

fn push_format_omission(values: Vec[FormatOmission], start: isize, end: isize) -> () {
    values.push(FormatOmission { start, end })
}

fn collect_statement_omissions(
    node: LocatedNode,
    following: Option[LocatedNode],
    result: Vec[FormatOmission],
) -> () {
    let drop_semicolon = expression_statement_drops_semicolon(node, following);
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => collect_format_omissions(child, result),
            Some(Token(token)) => if drop_semicolon && token_is(token, lexer::TokenKind::Semi) {
                push_format_omission(result, token.start, token.end)
            } else {},
            None => (),
        }
    }
}

fn collect_block_omissions(node: LocatedNode, result: Vec[FormatOmission]) -> () {
    let block_nodes = meaningful_block_nodes(node);
    let node_index: Ref[isize] = Ref::new(0);
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => if omittable_block_node(child) {
                push_format_omission(result, child.start, child.end)
            } else {
                let following = if node_index.get() + 1 < block_nodes.len() {
                    Option::Some(block_nodes[node_index.get() + 1])
                } else {
                    Option::None
                };
                node_index.set(node_index.get() + 1);
                if node_is(child, cst::NodeKind::STMT_EXPR) {
                    collect_statement_omissions(child, following, result)
                } else {
                    collect_format_omissions(child, result)
                }
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::Semi) {
                push_format_omission(result, token.start, token.end)
            } else {},
            None => (),
        }
    }
}

fn collect_format_omissions(node: LocatedNode, result: Vec[FormatOmission]) -> () {
    if node_is(node, cst::NodeKind::BLOCK) {
        collect_block_omissions(node, result)
    } else {
        let cursor = child_cursor(node);
        while cursor.remaining() > 0 {
            match cursor.next() {
                Some(Node(child)) => collect_format_omissions(child, result),
                _ => (),
            }
        }
    }
}

fn collect_format_expansions(node: LocatedNode, result: Vec[FormatExpansion]) -> () {
    if node_is(node, cst::NodeKind::TYPE_FUNC) {
        let children = direct_nodes(node);
        if !children.is_empty() && node_is(children[0], cst::NodeKind::TYPE_UNIT) {
            result.push(FormatExpansion { start: children[0].start, end: children[0].end })
        } else {}
    } else {};
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => collect_format_expansions(child, result),
            _ => (),
        }
    }
}

fn token_is_expanded(token: lexer::Token, expansions: Vec[FormatExpansion]) -> bool {
    for expansion in expansions {
        if token.start >= expansion.start && token.end <= expansion.end {
            return true
        } else {}
    }
    false
}

fn token_is_omitted(token: lexer::Token, omissions: Vec[FormatOmission]) -> bool {
    for omission in omissions {
        if token.start >= omission.start && token.end <= omission.end {
            return true
        } else {}
    }
    false
}

fn format_token_signature(source: string, root: LocatedNode) -> string {
    let tokens = lexer::lex(source);
    let output = text::StringBuilder::new();
    let in_where: Ref[bool] = Ref::new(false);
    let omissions: Vec[FormatOmission] = Vec::new();
    let expansions: Vec[FormatExpansion] = Vec::new();
    collect_format_omissions(root, omissions);
    collect_format_expansions(root, expansions);
    for index in 0..tokens.len() {
        let token = tokens[index];
        let optional_comma = lexer::token_kind_equal(token.kind, lexer::TokenKind::Comma)
            && match format_next_non_trivia(tokens, index + 1) {
                Some(kind) => format_closing_delimiter(kind)
                    || in_where.get()
                        && (lexer::token_kind_equal(kind, lexer::TokenKind::LBrace)
                            || lexer::token_kind_equal(kind, lexer::TokenKind::Semi)),
                None => false,
            };
        if lexer::token_kind_equal(token.kind, lexer::TokenKind::Whitespace) || optional_comma
            || token_is_omitted(token, omissions) {} else {
            if lexer::token_kind_equal(token.kind, lexer::TokenKind::UnitKeyword) {
                output.write_string(lexer::token_kind_name(lexer::TokenKind::LParen));
                output.write_string(":");
                output.write_string(lexer::encode_text_hex("("));
                output.write_string("\n");
                if token_is_expanded(token, expansions) {
                    output.write_string(lexer::token_kind_name(lexer::TokenKind::LParen));
                    output.write_string(":");
                    output.write_string(lexer::encode_text_hex("("));
                    output.write_string("\n");
                    output.write_string(lexer::token_kind_name(lexer::TokenKind::RParen));
                    output.write_string(":");
                    output.write_string(lexer::encode_text_hex(")"));
                    output.write_string("\n")
                } else {};
                output.write_string(lexer::token_kind_name(lexer::TokenKind::RParen));
                output.write_string(":");
                output.write_string(lexer::encode_text_hex(")"));
                output.write_string("\n")
            } else {
                output.write_string(lexer::token_kind_name(token.kind));
                output.write_string(":");
                output.write_string(lexer::encode_text_hex(token.text));
                output.write_string("\n")
            }
        };
        if lexer::token_kind_equal(token.kind, lexer::TokenKind::WhereKeyword) {
            in_where.set(true)
        } else if lexer::token_kind_equal(token.kind, lexer::TokenKind::LBrace)
            || lexer::token_kind_equal(token.kind, lexer::TokenKind::Semi) {
            in_where.set(false)
        } else {}
    }
    output.finish()
}

fn format_source_with_width(source: string, line_width: isize) -> Result[string, FormatError] {
    let parsed = parser::parse(source);
    if !parsed.diagnostics.is_empty() {
        Result::Err(FormatError { diagnostics: parsed.diagnostics })
    } else {
        let root = located_node(parsed.root, 0);
        let formatted = canonical_file_ending(render(format_node(builder(), root).doc, line_width));
        let reparsed = parser::parse(formatted);
        if !reparsed.diagnostics.is_empty() {
            Result::Err(FormatError { diagnostics: reparsed.diagnostics })
        } else if format_token_signature(source, root)
            != format_token_signature(formatted, located_node(reparsed.root, 0)) {
            Result::Err(
                FormatError {
                    diagnostics: Vec::from_array(
                        [cst::diagnostic("formatter changed source tokens", 0, source.byte_len())],
                    ),
                },
            )
        } else {
            Result::Ok(formatted)
        }
    }
}

pub fn format_source(source: string) -> Result[string, FormatError] {
    format_source_with_width(source, 100)
}
