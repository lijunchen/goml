package formatter;

use module::cst;
use module::lexer;
use std::collections;

fn file_node_category(value: LocatedNode) -> isize {
    if node_is(value, cst::NodeKind::PACKAGE) {
        1
    } else if node_is(value, cst::NodeKind::USE) {
        2
    } else if node_is(value, cst::NodeKind::ATTRIBUTE_LIST) {
        4
    } else {
        3
    }
}

fn format_file(value: Builder, node: LocatedNode) -> BuiltDoc {
    let output = parts();
    let previous_category: Ref[isize] = Ref::new(0);
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => {
                let category = file_node_category(child);
                if previous_category.get() == 0 {} else if previous_category.get() == 4 {
                    output.ensure_lines(1)
                } else if category == 2 && previous_category.get() == 2 {
                    output.ensure_lines(1)
                } else {
                    output.ensure_lines(2)
                };
                output.push_syntax(format_node(value, child));
                previous_category.set(category)
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::Whitespace) {
                output.add_pending_newlines(whitespace_newlines(token.token.text))
            } else if token_is(token, lexer::TokenKind::Comment) {
                output.push_comment(token)
            } else {
                output.push_token(token)
            },
            None => (),
        }
    }
    if !output.values.is_empty() {
        output.ensure_lines(1)
    } else {};
    output.finish()
}

fn format_attribute_list(value: Builder, node: LocatedNode) -> BuiltDoc {
    let output = parts();
    for attribute in direct_nodes(node) {
        if !output.values.is_empty() {
            output.ensure_lines(1)
        } else {};
        output.push_syntax(format_node(value, attribute))
    }
    if !output.values.is_empty() {
        output.ensure_lines(1)
    } else {};
    output.finish()
}

fn format_semicolon_item(value: Builder, node: LocatedNode) -> BuiltDoc {
    let output = parts();
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => if node_is(child, cst::NodeKind::WHERE_CLAUSE) {
                output.push_syntax(format_where_clause_signature(value, child))
            } else {
                output.push_syntax(format_node(value, child))
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::Whitespace) {
                output.add_pending_newlines(whitespace_newlines(token.token.text))
            } else if token_is(token, lexer::TokenKind::Comment) {
                output.push_comment(token)
            } else {
                output.push_token(token)
            },
            None => (),
        }
    }
    output.finish()
}

fn direct_node_of_kind(value: LocatedNode, kind: cst::NodeKind) -> Option[LocatedNode] {
    for child in direct_nodes(value) {
        if node_is(child, kind) {
            return Option::Some(child)
        } else {}
    }
    Option::None
}

fn omittable_unit_expression(value: LocatedNode) -> bool {
    node_is(value, cst::NodeKind::EXPR_UNIT) && !node_has_comment(value)
}

fn omittable_unit_statement(value: LocatedNode) -> bool {
    if !node_is(value, cst::NodeKind::STMT_EXPR) || node_has_comment(value) {
        false
    } else {
        match direct_node_of_kind(value, cst::NodeKind::EXPR_UNIT) {
            Some(_) => true,
            None => false,
        }
    }
}

fn omittable_block_node(value: LocatedNode) -> bool {
    omittable_unit_expression(value) || omittable_unit_statement(value)
}

fn meaningful_block_nodes(value: LocatedNode) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    for child in direct_nodes(value) {
        if !omittable_block_node(child) {
            result.push(child)
        } else {}
    }
    result
}

fn expression_statement_kind(value: LocatedNode) -> Option[cst::NodeKind] {
    let children = direct_nodes(value);
    if children.is_empty() {
        Option::None
    } else {
        Option::Some(cst::node_kind(children[0].node))
    }
}

fn token_continues_expression(kind: lexer::TokenKind) -> bool {
    match kind {
        LParen | LBracket | Question | DotDot | DotDotEq | AsKeyword | OrOr | AndAnd | EqEq | NotEq | Less | Greater | LessEq | GreaterEq | Pipe | Caret | Amp | LessLess | GreaterGreater | Plus | Minus | Star | Slash | Percent | Dot => true,
        _ => false,
    }
}

fn node_continues_expression(value: LocatedNode) -> bool {
    match first_significant_token(value) {
        Some(token) => token_continues_expression(token.token.kind),
        None => false,
    }
}

fn expression_statement_drops_semicolon(node: LocatedNode, following: Option[LocatedNode]) -> bool {
    match first_significant_token(node) {
        Some(token) => if token.token.kind == lexer::TokenKind::Label {
            return false
        } else {},
        None => (),
    };
    let following_continues = match following {
        Some(value) => node_continues_expression(value),
        None => false,
    };
    match expression_statement_kind(node) {
        Some(EXPR_WHILE) | Some(EXPR_FOR) => !following_continues,
        Some(EXPR_LOOP) => match following {
            Some(_) => !following_continues,
            None => false,
        },
        _ => false,
    }
}

fn format_expr_statement(value: Builder, node: LocatedNode, following: Option[LocatedNode]) -> BuiltDoc {
    format_generic_with_options(
        value,
        node,
        false,
        expression_statement_drops_semicolon(node, following),
    )
}

fn format_block(value: Builder, node: LocatedNode) -> BuiltDoc {
    let content = parts();
    let meaningful: Ref[bool] = Ref::new(false);
    let block_nodes = meaningful_block_nodes(node);
    let node_index: Ref[isize] = Ref::new(0);
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => if omittable_block_node(child) {} else {
                let following = if node_index.get() + 1 < block_nodes.len() {
                    Option::Some(block_nodes[node_index.get() + 1])
                } else {
                    Option::None
                };
                node_index.set(node_index.get() + 1);
                if meaningful.get() {
                    content.ensure_lines(1)
                } else {};
                if node_is(child, cst::NodeKind::STMT_EXPR) {
                    content.push_syntax(format_expr_statement(value, child, following))
                } else {
                    content.push_syntax(format_node(value, child))
                };
                meaningful.set(true)
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::LBrace)
                || token_is(token, lexer::TokenKind::RBrace)
                || token_is(token, lexer::TokenKind::Semi) {} else if token_is(
                token,
                lexer::TokenKind::Whitespace,
            ) {
                content.add_pending_newlines(whitespace_newlines(token.token.text))
            } else if token_is(token, lexer::TokenKind::Comment) {
                content.push_comment(token);
                meaningful.set(true)
            } else {
                content.push_token(token);
                meaningful.set(true)
            },
            None => (),
        }
    }
    if !(meaningful.get()) {
        built(
            text("{}"),
            Option::Some(lexer::TokenKind::LBrace),
            Option::Some(lexer::TokenKind::RBrace),
        )
    } else {
        let body = content.finish();
        let closing = if body.trailing_lines > 0 {
            text("}")
        } else {
            concat2(Doc::HardLine, text("}"))
        };
        built(
            concat(Vec::from_array([text("{"), Doc::HardLine, indent(body.doc), closing])),
            Option::Some(lexer::TokenKind::LBrace),
            Option::Some(lexer::TokenKind::RBrace),
        )
    }
}

fn format_impl(value: Builder, node: LocatedNode) -> BuiltDoc {
    let header = parts();
    let body = parts();
    let in_body: Ref[bool] = Ref::new(false);
    let item_count: Ref[isize] = Ref::new(0);
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => if in_body.get() {
                if item_count.get() > 0 {
                    body.ensure_lines(2)
                } else {};
                body.push_syntax(format_node(value, child));
                item_count.set(item_count.get() + 1)
            } else {
                header.push_syntax(format_node(value, child))
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::LBrace) {
                in_body.set(true)
            } else if token_is(token, lexer::TokenKind::RBrace) {} else if token_is(
                token,
                lexer::TokenKind::Whitespace,
            ) {
                if in_body.get() {
                    body.add_pending_newlines(whitespace_newlines(token.token.text))
                } else {
                    header.add_pending_newlines(whitespace_newlines(token.token.text))
                }
            } else if token_is(token, lexer::TokenKind::Comment) {
                if in_body.get() {
                    body.push_comment(token)
                } else {
                    header.push_comment(token)
                }
            } else if in_body.get() {
                body.push_token(token)
            } else {
                header.push_token(token)
            },
            None => (),
        }
    }
    let header_doc = header.finish();
    if body.values.is_empty() {
        built(
            concat3(header_doc.doc, text(" "), text("{}")),
            header_doc.first,
            Option::Some(lexer::TokenKind::RBrace),
        )
    } else {
        let body_doc = body.finish();
        let closing = if body_doc.trailing_lines > 0 {
            text("}")
        } else {
            concat2(Doc::HardLine, text("}"))
        };
        built(
            concat(
                Vec::from_array(
                    [header_doc.doc, text(" {"), Doc::HardLine, indent(body_doc.doc), closing],
                ),
            ),
            header_doc.first,
            Option::Some(lexer::TokenKind::RBrace),
        )
    }
}

fn vertical_body_uses_comma(kind: cst::NodeKind) -> bool {
    match kind {
        VARIANT_LIST | STRUCT_FIELD_LIST | MATCH_ARM_LIST | SELECT_ARM_LIST => true,
        _ => false,
    }
}

fn format_inline_variant_field_list(value: Builder, node: LocatedNode) -> BuiltDoc {
    let fields = direct_nodes(node);
    if fields.is_empty() || node_has_comment(node) {
        return format_generic(value, node)
    } else {};
    let docs: Vec[Doc] = Vec::new();
    for field in fields {
        docs.push(format_node(value, field).doc)
    }
    let Some(close) = last_significant_token(node) else {
        return format_generic(value, node)
    };
    let group_id = value.docs.new_group_id();
    let body = join(concat2(text(","), Doc::SoftLine), docs);
    let content = concat(
        Vec::from_array(
            [
                Doc::SoftLine,
                indent(concat2(body, if_break(group_id, text(","), nil()))),
                Doc::SoftLine,
                token_doc(close),
            ],
        ),
    );
    let first = match first_significant_token(node) {
        Some(token) => Option::Some(token.token.kind),
        None => Option::None,
    };
    built(value.docs.group_with_id(group_id, content).doc, first, Option::Some(close.token.kind))
}

fn format_variant(value: Builder, node: LocatedNode, force_vertical_fields: bool) -> BuiltDoc {
    let output = parts();
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => if node_is(child, cst::NodeKind::STRUCT_FIELD_LIST)
                && !force_vertical_fields {
                output.push_syntax(format_inline_variant_field_list(value, child))
            } else {
                output.push_syntax(format_node(value, child))
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::Whitespace) {
                output.add_pending_newlines(whitespace_newlines(token.token.text))
            } else if token_is(token, lexer::TokenKind::Comment) {
                output.push_comment(token)
            } else {
                output.push_token(token)
            },
            None => (),
        }
    }
    output.finish()
}

fn variant_requires_vertical_fields(value: Builder, node: LocatedNode) -> bool {
    let Some(fields) = direct_node_of_kind(node, cst::NodeKind::STRUCT_FIELD_LIST) else {
        return false
    };
    let field_count = direct_nodes(fields).len();
    if field_count == 0 {
        false
    } else if field_count != 1 || node_has_comment(fields) {
        true
    } else {
        flat_width(format_variant(value, node, false).doc, collections::BitSet::new(), 95) > 95
    }
}

fn enum_variants_require_vertical_fields(value: Builder, node: LocatedNode) -> bool {
    for child in direct_nodes(node) {
        if node_is(child, cst::NodeKind::VARIANT) && variant_requires_vertical_fields(value, child) {
            return true
        } else {}
    }
    false
}

fn format_vertical_body(value: Builder, node: LocatedNode) -> BuiltDoc {
    let content = parts();
    let item_count: Ref[isize] = Ref::new(0);
    let kind = cst::node_kind(node.node);
    let owns_open = cst::node_kind_equal(kind, cst::NodeKind::MATCH_ARM_LIST)
        || cst::node_kind_equal(kind, cst::NodeKind::SELECT_ARM_LIST);
    let vertical_variant_fields = cst::node_kind_equal(kind, cst::NodeKind::VARIANT_LIST)
        && enum_variants_require_vertical_fields(value, node);
    let cursor = child_cursor(node);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(child)) => {
                if item_count.get() > 0 {
                    content.ensure_lines(1)
                } else {};
                if cst::node_kind_equal(kind, cst::NodeKind::VARIANT_LIST)
                    && node_is(child, cst::NodeKind::VARIANT) {
                    content.push_syntax(format_variant(value, child, vertical_variant_fields))
                } else {
                    content.push_syntax(format_node(value, child))
                };
                if vertical_body_uses_comma(kind) && content.trailing_lines.get() == 0 {
                    content.push_syntax(
                        built(
                            text(","),
                            Option::Some(lexer::TokenKind::Comma),
                            Option::Some(lexer::TokenKind::Comma),
                        ),
                    )
                } else {};
                item_count.set(item_count.get() + 1)
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::RBrace)
                || owns_open && token_is(token, lexer::TokenKind::LBrace)
                || token_is(token, lexer::TokenKind::Comma) {} else if token_is(
                token,
                lexer::TokenKind::Whitespace,
            ) {
                content.add_pending_newlines(whitespace_newlines(token.token.text))
            } else if token_is(token, lexer::TokenKind::Comment) {
                content.push_comment(token)
            } else {
                content.push_token(token)
            },
            None => (),
        }
    }
    if item_count.get() == 0 && content.values.is_empty() {
        if owns_open {
            built(
                text("{}"),
                Option::Some(lexer::TokenKind::LBrace),
                Option::Some(lexer::TokenKind::RBrace),
            )
        } else {
            built(
                text("}"),
                Option::Some(lexer::TokenKind::RBrace),
                Option::Some(lexer::TokenKind::RBrace),
            )
        }
    } else {
        let body = content.finish();
        let closing = if body.trailing_lines > 0 {
            text("}")
        } else {
            concat2(Doc::HardLine, text("}"))
        };
        BuiltDoc {
            doc: if owns_open {
                concat(Vec::from_array([text("{"), Doc::HardLine, indent(body.doc), closing]))
            } else {
                concat(Vec::from_array([Doc::HardLine, indent(body.doc), closing]))
            },
            first: if owns_open {
                Option::Some(lexer::TokenKind::LBrace)
            } else {
                body.first
            },
            last: Option::Some(lexer::TokenKind::RBrace),
            starts_with_line: !owns_open,
            trailing_lines: 0,
        }
    }
}
