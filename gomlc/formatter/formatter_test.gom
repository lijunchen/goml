package formatter;

use module::lexer;
use module::parser;
use std::env;
use std::fs;
use std::path;
use std::testing;
use std::text;

fn token_signature(source: string) -> string {
    let parsed = parser::parse(source);
    format_token_signature(source, located_node(parsed.root, 0))
}

fn token_kind_signature(source: string, expected: lexer::TokenKind) -> string {
    let output = text::StringBuilder::new();
    for token in lexer::lex(source) {
        if lexer::token_kind_equal(token.kind, expected) {
            output.write_string(lexer::encode_text_hex(token.text));
            output.write_string("\n")
        } else {}
    }
    output.finish()
}

fn literal_token(kind: lexer::TokenKind) -> bool {
    match kind {
        Float | IntLit | Str | RawStr | MultilineStr | FStringStart | FStringText | FStringExprStart | FStringExprEnd | FStringEnd | CharLit | ByteCharLit | ByteStr | RawByteStr => true,
        _ => false,
    }
}

fn literal_signature(source: string) -> string {
    let output = text::StringBuilder::new();
    for token in lexer::lex(source) {
        if literal_token(token.kind) {
            output.write_string(lexer::token_kind_name(token.kind));
            output.write_string(":");
            output.write_string(lexer::encode_text_hex(token.text));
            output.write_string("\n")
        } else {}
    }
    output.finish()
}

fn has_trailing_space(source: string) -> bool {
    for index in range(0, source.byte_len()) {
        let byte = source.byte_get(index);
        if byte == 10 && index > 0 {
            let previous = source.byte_get(index - 1);
            if previous == 32 || previous == 9 {
                return true
            } else {}
        } else {}
    }
    false
}

fn has_carriage_return(source: string) -> bool {
    for index in range(0, source.byte_len()) {
        if source.byte_get(index) == 13 {
            return true
        } else {}
    }
    false
}

fn expect_format(source: string, expected: string) -> unit {
    match format_source(source) {
        Ok(formatted) => {
            testing::assert_eq(formatted, expected);
            testing::assert_eq(parser::parse(formatted).diagnostics.len(), 0);
            match format_source(formatted) {
                Ok(again) => testing::assert_eq(again, formatted),
                Err(_) => testing::fail("second format failed"),
            }
        },
        Err(_) => testing::fail("format failed"),
    }
}

fn repository_root() -> string {
    match env::var("GOML_REPO") {
        Some(value) => value,
        None => "..",
    }
}

fn read_fixture(path_value: string) -> string {
    match fs::read_file(path_value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(path_value + ": " + error);
            ""
        },
    }
}

fn assert_format_invariants(source: string, formatted: string) -> unit {
    testing::assert_eq(parser::parse(formatted).diagnostics.len(), 0);
    match format_source(formatted) {
        Ok(again) => testing::assert_eq(again, formatted),
        Err(_) => testing::fail("second format failed"),
    };
    testing::assert_eq(token_signature(formatted), token_signature(source));
    testing::assert_eq(literal_signature(formatted), literal_signature(source));
    testing::assert_eq(
        token_kind_signature(formatted, lexer::TokenKind::Comment),
        token_kind_signature(source, lexer::TokenKind::Comment),
    );
    testing::assert(!has_trailing_space(formatted))
}

fn formatter_fixture_root() -> string {
    path::join(repository_root(), "gomlc/testdata/formatter")
}

fn formatter_golden_path(name: string) -> string {
    let suffix = ".input.gom";
    name.byte_slice(0, name.byte_len() - suffix.byte_len()) + ".golden.gom"
}

#[test]
fn formatter_goldens_match() -> unit {
    let root = formatter_fixture_root();
    let names = match fs::read_dir(root) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            Vec::new()
        },
    };
    for name in names {
        if name.ends_with(".input.gom") {
            let input_path = path::join(root, name);
            let golden_path = path::join(root, formatter_golden_path(name));
            let source = read_fixture(input_path);
            let formatted = match format_source(source) {
                Ok(value) => value,
                Err(_) => {
                    testing::fail("fixture format failed: " + name);
                    ""
                },
            };
            if env::var("UPDATE_EXPECT").is_some() {
                match fs::write_file(golden_path, formatted) {
                    Ok(_) => (),
                    Err(error) => testing::fail(error),
                }
            } else {
                testing::assert_eq(formatted, read_fixture(golden_path))
            };
            assert_format_invariants(source, formatted)
        } else {}
    }
}

#[test]
fn formats_basic_file() -> unit {
    expect_format(
        "package main;\nuse alpha::beta;\nfn main( )->unit{let x=call(1,2,3);x}\n",
        "package main;\n\nuse alpha::beta;\n\nfn main() -> unit {\n    let x = call(1, 2, 3);\n    x\n}\n",
    )
}

#[test]
fn renders_flat_and_broken_groups() -> unit {
    let docs = doc_builder();
    let document = docs.group(
        concat(
            Vec::from_array(
                [
                    text("call("),
                    Doc::Line,
                    indent(
                        join(
                            concat2(text(","), Doc::SoftLine),
                            Vec::from_array([text("first"), text("second")]),
                        ),
                    ),
                    Doc::Line,
                    text(")"),
                ],
            ),
        ),
    ).doc;
    testing::assert_eq(render(document, 40), "call(first, second)");
    testing::assert_eq(render(document, 10), "call(\n    first,\n    second\n)")
}

#[test]
fn renders_nested_groups_independently() -> unit {
    let docs = doc_builder();
    let inner = docs.group(
        concat(
            Vec::from_array(
                [
                    text("inner("),
                    Doc::Line,
                    indent(
                        join(
                            concat2(text(","), Doc::SoftLine),
                            Vec::from_array([text("one"), text("two")]),
                        ),
                    ),
                    Doc::Line,
                    text(")"),
                ],
            ),
        ),
    ).doc;
    let outer = docs.group(
        concat(Vec::from_array([text("a_very_long_outer_prefix"), Doc::SoftLine, indent(inner)])),
    ).doc;
    testing::assert_eq(render(outer, 28), "a_very_long_outer_prefix\n    inner(one, two)")
}

#[test]
fn measures_unicode_by_codepoint() -> unit {
    let docs = doc_builder();
    let fits = docs.group(concat(Vec::from_array([text("你好"), Doc::SoftLine, text("世界")]))).doc;
    testing::assert_eq(render(fits, 5), "你好 世界");
    let breaks = doc_builder().group(
        concat(Vec::from_array([text("你好"), Doc::SoftLine, text("世界")])),
    ).doc;
    testing::assert_eq(render(breaks, 4), "你好\n世界")
}

#[test]
fn renders_conditional_commas_suffixes_and_verbatim_text() -> unit {
    let docs = doc_builder();
    let id = docs.new_group_id();
    let list = docs.group_with_id(
        id,
        concat(
            Vec::from_array(
                [
                    text("["),
                    Doc::Line,
                    indent(
                        concat(Vec::from_array([text("alphabet"), if_break(id, text(","), nil())])),
                    ),
                    Doc::Line,
                    text("]"),
                    line_suffix(concat2(text(" "), text("// 尾注释"))),
                    Doc::HardLine,
                    verbatim("\\\\raw\n\\\\text"),
                ],
            ),
        ),
    ).doc;
    testing::assert_eq(render(list, 8), "[\n    alphabet,\n] // 尾注释\n\\\\raw\n\\\\text")
}

#[test]
fn normalizes_line_endings_and_empty_input() -> unit {
    match format_source("") {
        Ok(formatted) => testing::assert_eq(formatted, ""),
        Err(_) => testing::fail("empty format failed"),
    };
    match format_source("fn main() -> unit {\r\n    ()\r\n}\r\n\r\n") {
        Ok(formatted) => {
            testing::assert(!has_carriage_return(formatted));
            testing::assert(formatted.ends_with("\n"));
            testing::assert(!formatted.ends_with("\n\n"))
        },
        Err(_) => testing::fail("line ending format failed"),
    }
}

#[test]
fn preserves_tokens_literals_comments_and_ast() -> unit {
    let source = "fn sample() -> unit { // 注释\nlet value = Vec::from_array([0xFF_FF, 1_000]); let ch = '\\u0041'; let byte = b'\\xFF'; let text = f\"值={value.get(0)}\"; () }\n";
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted)
}

#[test]
fn formats_block_and_byte_string_expressions_losslessly() -> unit {
    let source = "fn bytes()->Vec[byte]{let plain=b\"A\\n\\xFF\";let raw=br#\"first\nsecond\"#;{let selected=raw;selected}}\n";
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted)
}

#[test]
fn formats_lexical_task_scope_contextual_forms_losslessly() -> unit {
    let source = "use std::task;fn main()->unit{let task=scope{spawn|cancel|cancel.is_cancelled()};let scope=1;let spawn=|value:int|value;println(spawn(scope));let _=task;}\n";
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted)
}

#[test]
fn formats_comptime_contextually_without_reserving_the_name() -> unit {
    let source = "#[comptime]fn factorial(value:int)->int{if value<2{1}else{value*factorial(value-1)}}fn comptime()->int{1}fn main()->int{let value=comptime{factorial(4)};value+comptime()}\n";
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted);
    testing::assert(formatted.contains("let value = comptime {"));
    testing::assert(formatted.contains("value + comptime()"))
}

#[test]
fn removes_redundant_unit_expressions_and_semicolons() -> unit {
    expect_format(
        "fn empty()->unit{;;;()}fn control(flag:bool,values:Vec[int])->unit{while flag{();};for value in values{let _=value;()};loop{break;};if flag{()}else{();};match flag{true=>(),false=>(),};()}fn retain(flag:bool)->unit{if flag{1}else{2};match flag{true=>1,false=>2,};loop{break 1};}fn boundary(values:Vec[int])->(Vec[int],Vec[int]){for value in values{let _=value;};(values,values)}",
        "fn empty() -> unit {}\n\nfn control(flag: bool, values: Vec[int]) -> unit {\n    while flag {}\n    for value in values {\n        let _ = value;\n    }\n    loop {\n        break;\n    }\n    if flag {} else {};\n    match flag {\n        true => (),\n        false => (),\n    };\n}\n\nfn retain(flag: bool) -> unit {\n    if flag {\n        1\n    } else {\n        2\n    };\n    match flag {\n        true => 1,\n        false => 2,\n    };\n    loop {\n        break 1\n    };\n}\n\nfn boundary(values: Vec[int]) -> (Vec[int], Vec[int]) {\n    for value in values {\n        let _ = value;\n    };\n    (values, values)\n}\n",
    )
}

#[test]
fn formats_enum_variants_like_rustfmt() -> unit {
    expect_format(
        "enum Compact[T]{None,One{value:T},Two(T)}enum Expanded[T]{One{value:T},Pair{left:T,right:T},Other{value:T}}enum Wide{First{value:ExtremelyLongTypeNameThatMakesTheVariantExceedTheConfiguredOneHundredColumnLineWidth},Second{value:int}}",
        "enum Compact[T] {\n    None,\n    One { value: T },\n    Two(T),\n}\n\nenum Expanded[T] {\n    One {\n        value: T,\n    },\n    Pair {\n        left: T,\n        right: T,\n    },\n    Other {\n        value: T,\n    },\n}\n\nenum Wide {\n    First {\n        value: ExtremelyLongTypeNameThatMakesTheVariantExceedTheConfiguredOneHundredColumnLineWidth,\n    },\n    Second {\n        value: int,\n    },\n}\n",
    )
}

#[test]
fn formats_newtype_structs() -> unit {
    expect_format(
        "pub struct Wrapper [ T ] ( pub T , ) ;\nstruct UserId(int32);",
        "pub struct Wrapper[T](pub T,);\n\nstruct UserId(int32);\n",
    )
}

#[test]
fn formats_static_items() -> unit {
    expect_format(
        "static VALUE:OnceCell[int]=OnceCell::new();",
        "static VALUE: OnceCell[int] = OnceCell::new();\n",
    )
}

#[test]
fn rejects_invalid_source() -> unit {
    match format_source("fn main( {") {
        Ok(_) => testing::fail("invalid source formatted"),
        Err(error) => testing::assert(error.diagnostics.len() > 0),
    }
}

#[test]
fn formats_select_arms_vertically() -> unit {
    expect_format(
        "fn choose(input:Channel[int],output:Channel[int])->int{select{recv(input)as value=>value.unwrap_or(0),send(output,1)=>2,default=>{let fallback=3;fallback},}}",
        "fn choose(input: Channel[int], output: Channel[int]) -> int {\n    select {\n        recv(input) as value => value.unwrap_or(0),\n        send(output, 1) => 2,\n        default => {\n            let fallback = 3;\n            fallback\n        },\n    }\n}\n",
    )
}

#[test]
fn formats_advanced_select_arms() -> unit {
    expect_format(
        "fn choose(input:Channel[int],output:Channel[int])->int{select priority{recv(input)when true match{Some(value)=>value,None=>0,},send(output,1)when false=>2,default=>3,}}",
        "fn choose(input: Channel[int], output: Channel[int]) -> int {\n    select priority {\n        recv(input) when true match {\n            Some(value) => value,\n            None => 0,\n        },\n        send(output, 1) when false => 2,\n        default => 3,\n    }\n}\n",
    )
}
