package line_index;

use std::testing;

#[test]
fn indexes_ascii_blocks_newlines_and_wide_characters() -> unit {
    let source = "abcdefghijklmnop\nabcdefg\r\nqrst😀uv\rwx";
    let index = new(source);
    testing::assert_eq(index.line_starts.len(), 4);
    testing::assert_eq(index.line_starts[0], 0);
    testing::assert_eq(index.line_starts[1], 17);
    testing::assert_eq(index.line_starts[2], 26);
    testing::assert_eq(index.line_starts[3], 37);
    testing::assert_eq(index.line_ends[0], 16);
    testing::assert_eq(index.line_ends[1], 24);
    testing::assert_eq(index.line_ends[2], 36);
    testing::assert_eq(index.line_ends[3], 39);
    let emoji_end = offset_to_line_col(index, 34, Encoding::Utf16);
    testing::assert_eq(emoji_end.line, 2);
    testing::assert_eq(emoji_end.column, 6);
    testing::assert_eq(
        line_col_to_offset(index, LineCol { line: 2, column: 6 }, Encoding::Utf16),
        34,
    );
    testing::assert(
        line_col_to_offset_checked(index, LineCol { line: 2, column: 5 }, Encoding::Utf16).is_none(),
    );
    let crlf_middle = offset_to_line_col(index, 25, Encoding::Utf16);
    testing::assert_eq(crlf_middle.line, 1);
    testing::assert_eq(crlf_middle.column, 7)
}

#[test]
fn converts_utf8_utf16_and_utf32_columns() -> unit {
    let source = "a😀中";
    let index = new(source);
    let utf8 = offset_to_line_col(index, source.byte_len(), Encoding::Utf8);
    let utf16 = offset_to_line_col(index, source.byte_len(), Encoding::Utf16);
    let utf32 = offset_to_line_col(index, source.byte_len(), Encoding::Utf32);
    testing::assert_eq(utf8.column, 8);
    testing::assert_eq(utf16.column, 4);
    testing::assert_eq(utf32.column, 3);
    testing::assert_eq(line_col_to_offset(index, utf8, Encoding::Utf8), source.byte_len());
    testing::assert_eq(line_col_to_offset(index, utf16, Encoding::Utf16), source.byte_len());
    testing::assert_eq(line_col_to_offset(index, utf32, Encoding::Utf32), source.byte_len())
}
