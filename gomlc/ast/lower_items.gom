package ast;

use gomlc::cst;
use gomlc::lexer;

fn self_type_occurrences(value: LocatedNode) -> int {
    let mut result = 0;
    for token in direct_tokens(value) {
        if lexer::token_kind_equal(token.token.kind, lexer::TokenKind::Ident)
            && token.token.text == "Self" {
            result = result + 1;
        } else {}
    }
    for child in direct_nodes(value) {
        result = result + self_type_occurrences(child);
    }
    result
}

fn record_disallowed_self_type(ctx: LowerCtx, value: LocatedNode) -> unit {
    for _ in 0..self_type_occurrences(value) {
        ctx.invalid_self_type_spans.push(type_head_span(value))
    }
}

fn record_disallowed_self_types(ctx: LowerCtx, value: LocatedNode) -> unit {
    for child in direct_nodes(value) {
        if cst::node_kind_equal(node_kind(child), cst::NodeKind::BLOCK) {} else if is_type_kind(
            node_kind(child),
        ) {
            record_disallowed_self_type(ctx, child)
        } else {
            record_disallowed_self_types(ctx, child)
        }
    }
}

fn lower_item(ctx: LowerCtx, node: LocatedNode) -> Option[Item] {
    match node_kind(node) {
        ENUM => {
            record_disallowed_self_types(ctx, node);
            match lower_enum(ctx, node) {
                Some(value) => Option::Some(Item::EnumDef(value)),
                None => Option::None,
            }
        },
        STRUCT => {
            record_disallowed_self_types(ctx, node);
            match lower_struct(ctx, node) {
                Some(value) => Option::Some(Item::StructDef(value)),
                None => Option::None,
            }
        },
        TRAIT => match lower_trait(ctx, node) {
            Some(value) => Option::Some(Item::TraitDef(value)),
            None => Option::None,
        },
        IMPL => match lower_impl(ctx, node) {
            Some(value) => Option::Some(Item::ImplBlock(value)),
            None => Option::None,
        },
        FN => {
            record_disallowed_self_types(ctx, node);
            match lower_function(ctx, node, Option::None) {
                Some(value) => Option::Some(Item::Function(value)),
                None => Option::None,
            }
        },
        EXTERN => {
            record_disallowed_self_types(ctx, node);
            lower_extern(ctx, node)
        },
        TYPE_ALIAS => {
            record_disallowed_self_types(ctx, node);
            lower_type_alias(ctx, node)
        },
        CONST => {
            record_disallowed_self_types(ctx, node);
            lower_constant(ctx, node)
        },
        _ => Option::None,
    }
}

fn lower_constant(ctx: LowerCtx, node: LocatedNode) -> Option[Item] {
    let types = type_children(node);
    let values = expr_children(node);
    match (first_token(node, lexer::TokenKind::Ident), types.len(), values.len()) {
        (Some(name), type_count, value_count) => {
            if type_count > 0 && value_count > 0 {
                match lower_ty(ctx, types[0]) {
                    Some(ty) => match lower_expr(ctx, values[0]) {
                        Some(value) => Option::Some(
                            Item::Constant(
                                Constant {
                                    attrs: lower_attributes(node),
                                    visibility: lower_visibility(node),
                                    name: name.token.text,
                                    ty,
                                    ty_span: type_head_span(types[0]),
                                    value,
                                },
                            ),
                        ),
                        None => Option::None,
                    },
                    None => Option::None,
                }
            } else {
                push_error(ctx, node_span(node), "Constant is missing a type or value");
                Option::None
            }
        },
        (None, _, _) => {
            push_error(ctx, node_span(node), "Constant is missing a name");
            Option::None
        },
    }
}

fn lower_type_alias(ctx: LowerCtx, node: LocatedNode) -> Option[Item] {
    let types = type_children(node);
    match (first_token(node, lexer::TokenKind::Ident), types.len()) {
        (Some(name), count) => if count > 0 {
            match lower_ty(ctx, types[0]) {
                Some(ty) => {
                    let (generics, _) = lower_generics(ctx, node);
                    Option::Some(
                        Item::TypeAlias(
                            TypeAlias {
                                attrs: lower_attributes(node),
                                visibility: lower_visibility(node),
                                name: name.token.text,
                                generics,
                                ty,
                                ty_span: type_head_span(types[0]),
                            },
                        ),
                    )
                },
                None => Option::None,
            }
        } else {
            push_error(ctx, node_span(node), "Type alias is missing a target type");
            Option::None
        },
        (None, _) => {
            push_error(ctx, node_span(node), "Type alias is missing a name");
            Option::None
        },
    }
}

fn lower_enum(ctx: LowerCtx, node: LocatedNode) -> Option[EnumDef] {
    match first_token(node, lexer::TokenKind::Ident) {
        Some(name_token) => {
            let name = name_token.token.text;
            let (generics, _) = lower_generics(ctx, node);
            let variants: Vec[EnumVariant] = Vec::[];
            match first_child(node, cst::NodeKind::VARIANT_LIST) {
                Some(list) => for variant in children_of_kind(list, cst::NodeKind::VARIANT) {
                    match first_token(variant, lexer::TokenKind::Ident) {
                        Some(variant_name) => {
                            if variant_name.token.text.byte_len() == 0
                                || variant_name.token.text.byte_get(0) < b'A'
                                || variant_name.token.text.byte_get(0) > b'Z' {
                                push_error(
                                    ctx,
                                    token_span(variant_name),
                                    "Enum variant " + variant_name.token.text
                                        + " must start with an uppercase letter",
                                )
                            } else {};
                            let field_type_spans: Vec[Span] = Vec::[];
                            let field_attrs: Vec[Vec[Attribute]] = Vec::[];
                            let fields = match first_child(variant, cst::NodeKind::TYPE_LIST) {
                                Some(type_list) => {
                                    let lowered: Vec[TypeExpr] = Vec::[];
                                    for field in children_of_kind(
                                        type_list,
                                        cst::NodeKind::ENUM_TUPLE_FIELD,
                                    ) {
                                        let types = type_children(field);
                                        if !types.is_empty() {
                                            let ty = types[0];
                                            field_type_spans.push(type_head_span(ty));
                                            match lower_ty(ctx, ty) {
                                                Some(value) => {
                                                    lowered.push(value);
                                                    field_attrs.push(lower_attributes(field))
                                                },
                                                None => (),
                                            }
                                        } else {}
                                    }
                                    EnumVariantFields::Tuple(lowered)
                                },
                                None => match first_child(variant, cst::NodeKind::STRUCT_FIELD_LIST) {
                                    Some(field_list) => {
                                        let named: Vec[(string, TypeExpr)] = Vec::[];
                                        for field in children_of_kind(
                                            field_list,
                                            cst::NodeKind::STRUCT_FIELD,
                                        ) {
                                            match lower_visibility(field) {
                                                Public => push_error(
                                                    ctx,
                                                    node_span(field),
                                                    "Enum variant fields inherit the enum visibility and must not use `pub`",
                                                ),
                                                Private => (),
                                            };
                                            let field_name = first_token(
                                                field,
                                                lexer::TokenKind::Ident,
                                            );
                                            let types = type_children(field);
                                            match field_name {
                                                Some(name) => if !types.is_empty() {
                                                    match lower_ty(ctx, types[0]) {
                                                        Some(ty) => {
                                                            field_type_spans.push(
                                                                type_head_span(types[0]),
                                                            );
                                                            named.push((name.token.text, ty));
                                                            field_attrs.push(
                                                                lower_attributes(field),
                                                            )
                                                        },
                                                        None => (),
                                                    }
                                                } else {
                                                    push_error(
                                                        ctx,
                                                        node_span(field),
                                                        "Struct-like enum variant field is malformed",
                                                    )
                                                },
                                                None => push_error(
                                                    ctx,
                                                    node_span(field),
                                                    "Struct-like enum variant field is malformed",
                                                ),
                                            }
                                        }
                                        EnumVariantFields::Struct(named)
                                    },
                                    None => EnumVariantFields::Unit,
                                },
                            };
                            variants.push(
                                EnumVariant {
                                    attrs: lower_attributes(variant),
                                    name: variant_name.token.text,
                                    fields,
                                    field_type_spans,
                                    field_attrs,
                                },
                            )
                        },
                        None => push_error(
                            ctx,
                            node_span(variant),
                            "Enum variant is missing a name",
                        ),
                    }
                },
                None => push_error(ctx, node_span(node), "Enum " + name + " has no variants"),
            };
            Option::Some(
                EnumDef {
                    attrs: lower_attributes(node),
                    visibility: lower_visibility(node),
                    name,
                    generics,
                    variants,
                },
            )
        },
        None => {
            push_error(ctx, node_span(node), "Enum is missing a name");
            Option::None
        },
    }
}

fn lower_struct(ctx: LowerCtx, node: LocatedNode) -> Option[StructDef] {
    match first_token(node, lexer::TokenKind::Ident) {
        Some(name_token) => {
            let (generics, _) = lower_generics(ctx, node);
            let fields: Vec[(string, TypeExpr)] = Vec::[];
            let field_type_spans: Vec[Span] = Vec::[];
            let field_attrs: Vec[Vec[Attribute]] = Vec::[];
            let public_fields: Vec[string] = Vec::[];
            match first_child(node, cst::NodeKind::STRUCT_FIELD_LIST) {
                Some(list) => for field in children_of_kind(list, cst::NodeKind::STRUCT_FIELD) {
                    let field_name = first_token(field, lexer::TokenKind::Ident);
                    let types = type_children(field);
                    match field_name {
                        Some(name) => if !types.is_empty() {
                            let type_node = types[0];
                            match lower_ty(ctx, type_node) {
                                Some(ty) => {
                                    field_type_spans.push(type_head_span(type_node));
                                    fields.push((name.token.text, ty));
                                    field_attrs.push(lower_attributes(field));
                                    match lower_visibility(field) {
                                        Public => public_fields.push(name.token.text),
                                        Private => (),
                                    }
                                },
                                None => (),
                            }
                        } else {},
                        None => (),
                    }
                },
                None => (),
            };
            Option::Some(
                StructDef {
                    attrs: lower_attributes(node),
                    visibility: lower_visibility(node),
                    name: name_token.token.text,
                    generics,
                    fields,
                    field_type_spans,
                    field_attrs,
                    public_fields,
                },
            )
        },
        None => Option::None,
    }
}

fn lower_trait_method(ctx: LowerCtx, node: LocatedNode) -> Option[TraitMethodSignature] {
    match first_token(node, lexer::TokenKind::Ident) {
        Some(name_token) => {
            let (generics, generic_bounds) = lower_generics(ctx, node);
            let params = match first_child(node, cst::NodeKind::PARAM_LIST) {
                Some(_) => lower_params(
                    ctx,
                    node,
                    Option::Some(TypeExpr::Con { path: path_from_single_ident("Self") }),
                ),
                None => {
                    push_error(
                        ctx,
                        node_span(node),
                        "TraitMethod " + name_token.token.text + " has no params",
                    );
                    Vec::[]
                },
            };
            if !params.is_empty() {
                let first = params[0];
                if ast_type_is_self(first.1) && first.0 != "self" {
                    push_error(
                        ctx,
                        node_span(node),
                        "Trait method receiver must be written as `self: Self`",
                    )
                } else {}
            } else {};
            for index in 0..params.len() {
                let param = params[index];
                if param.0 == "self" && (index != 0 || !ast_type_is_self(param.1)) {
                    push_error(
                        ctx,
                        node_span(node),
                        "Trait method receiver must be the first parameter with type Self",
                    )
                } else {}
            }
            let returns = type_children(node);
            let ret_ty = if returns.is_empty() {
                Option::Some(TypeExpr::Unit)
            } else {
                lower_ty(ctx, returns[0])
            };
            match ret_ty {
                Some(value) => Option::Some(
                    TraitMethodSignature {
                        name: name_token.token.text,
                        generics,
                        generic_bounds,
                        predicates: lower_where_clause(ctx, node),
                        params,
                        ret_ty: value,
                        body: match first_child(node, cst::NodeKind::BLOCK) {
                            Some(block) => lower_block(ctx, block),
                            None => Option::None,
                        },
                    },
                ),
                None => {
                    push_error(
                        ctx,
                        node_span(node),
                        "TraitMethod " + name_token.token.text + " has no return type",
                    );
                    Option::None
                },
            }
        },
        None => {
            push_error(ctx, node_span(node), "Trait method is missing a name");
            Option::None
        },
    }
}

fn ast_type_is_self(value: TypeExpr) -> bool {
    match value {
        Con { path } => {
            path.segments.len() == 1 && path.segments[0].ident == "Self"
        },
        _ => false,
    }
}

fn lower_trait(ctx: LowerCtx, node: LocatedNode) -> Option[TraitDef] {
    match first_token(node, lexer::TokenKind::Ident) {
        Some(name_token) => {
            let name = name_token.token.text;
            let (generics, generic_bounds) = lower_generics(ctx, node);
            let supertraits = match first_child(node, cst::NodeKind::TRAIT_SET) {
                Some(set) => lower_trait_set(ctx, set),
                None => Vec::[],
            };
            let associated_types: Vec[AssociatedType] = Vec::[];
            let method_sigs: Vec[TraitMethodSignature] = Vec::[];
            match first_child(node, cst::NodeKind::TRAIT_METHOD_SIG_LIST) {
                Some(list) => {
                    for associated in children_of_kind(list, cst::NodeKind::TRAIT_ASSOCIATED_TYPE) {
                        match first_token(associated, lexer::TokenKind::Ident) {
                            Some(associated_name) => {
                                let bounds = match first_child(associated, cst::NodeKind::TRAIT_SET) {
                                    Some(set) => lower_trait_set(ctx, set),
                                    None => Vec::[],
                                };
                                associated_types.push(
                                    AssociatedType { name: associated_name.token.text, bounds },
                                )
                            },
                            None => (),
                        }
                    }
                    for method in children_of_kind(list, cst::NodeKind::TRAIT_METHOD_SIG) {
                        match lower_trait_method(ctx, method) {
                            Some(value) => method_sigs.push(value),
                            None => (),
                        }
                    }
                },
                None => push_error(ctx, node_span(node), "Trait " + name + " has no methods"),
            };
            Option::Some(
                TraitDef {
                    attrs: lower_attributes(node),
                    visibility: lower_visibility(node),
                    name,
                    generics,
                    generic_bounds,
                    predicates: lower_where_clause(ctx, node),
                    supertraits,
                    associated_types,
                    method_sigs,
                },
            )
        },
        None => {
            push_error(ctx, node_span(node), "Trait is missing a name");
            Option::None
        },
    }
}

fn lower_param(ctx: LowerCtx, node: LocatedNode, index: int, shorthand_self_ty: Option[TypeExpr]) -> Option[
    (string, TypeExpr),
] {
    match first_token(node, lexer::TokenKind::Ident) {
        Some(name_token) => {
            let types = type_children(node);
            if types.is_empty() {
                match shorthand_self_ty {
                    Some(ty) => if index == 0 && name_token.token.text == "self" {
                        Option::Some((name_token.token.text, ty))
                    } else {
                        push_error(
                            ctx,
                            node_span(node),
                            "only the first trait or impl parameter may use the `self` shorthand",
                        );
                        Option::None
                    },
                    None => {
                        push_error(
                            ctx,
                            node_span(node),
                            "Param " + name_token.token.text + " has no type",
                        );
                        Option::None
                    },
                }
            } else {
                match lower_ty(ctx, types[0]) {
                    Some(ty) => Option::Some((name_token.token.text, ty)),
                    None => {
                        push_error(
                            ctx,
                            node_span(node),
                            "Param " + name_token.token.text + " has no type",
                        );
                        Option::None
                    },
                }
            }
        },
        None => {
            push_error(ctx, node_span(node), "Parameter is missing a name");
            Option::None
        },
    }
}

fn lower_params(ctx: LowerCtx, node: LocatedNode, shorthand_self_ty: Option[TypeExpr]) -> Vec[
    (string, TypeExpr),
] {
    let result: Vec[(string, TypeExpr)] = Vec::[];
    match first_child(node, cst::NodeKind::PARAM_LIST) {
        Some(list) => {
            let mut index = 0;
            for param in children_of_kind(list, cst::NodeKind::PARAM) {
                match lower_param(ctx, param, index, shorthand_self_ty) {
                    Some(value) => result.push(value),
                    None => (),
                };
                index = index + 1;
            }
        },
        None => (),
    };
    result
}

fn lower_param_type_spans(node: LocatedNode) -> Vec[Span] {
    let result: Vec[Span] = Vec::[];
    match first_child(node, cst::NodeKind::PARAM_LIST) {
        Some(list) => for param in children_of_kind(list, cst::NodeKind::PARAM) {
            let types = type_children(param);
            if !types.is_empty() {
                result.push(type_head_span(types[0]))
            } else {}
        },
        None => (),
    };
    result
}

fn lower_function(ctx: LowerCtx, node: LocatedNode, shorthand_self_ty: Option[TypeExpr]) -> Option[
    Function,
] {
    match first_token(node, lexer::TokenKind::Ident) {
        Some(name_token) => match first_child(node, cst::NodeKind::PARAM_LIST) {
            Some(_) => match first_child(node, cst::NodeKind::BLOCK) {
                Some(block_node) => match lower_block(ctx, block_node) {
                    Some(body) => {
                        let (generics, generic_bounds) = lower_generics(ctx, node);
                        let returns = type_children(node);
                        let ret_ty = if !returns.is_empty() {
                            lower_ty(ctx, returns[0])
                        } else {
                            Option::None
                        };
                        Option::Some(
                            Function {
                                attrs: lower_attributes(node),
                                visibility: lower_visibility(node),
                                name: name_token.token.text,
                                generics,
                                generic_bounds,
                                predicates: lower_where_clause(ctx, node),
                                params: lower_params(ctx, node, shorthand_self_ty),
                                param_type_spans: lower_param_type_spans(node),
                                ret_ty,
                                ret_ty_span: if !returns.is_empty() {
                                    Option::Some(type_head_span(returns[0]))
                                } else {
                                    Option::None
                                },
                                body,
                            },
                        )
                    },
                    None => {
                        push_error(
                            ctx,
                            node_span(node),
                            "Fn " + name_token.token.text + " has no body",
                        );
                        Option::None
                    },
                },
                None => {
                    push_error(ctx, node_span(node), "Fn " + name_token.token.text + " has no body");
                    Option::None
                },
            },
            None => {
                push_error(ctx, node_span(node), "Fn " + name_token.token.text + " has no params");
                Option::None
            },
        },
        None => {
            push_error(ctx, node_span(node), "Function declaration is missing a name");
            Option::None
        },
    }
}

fn lower_impl(ctx: LowerCtx, node: LocatedNode) -> Option[ImplBlock] {
    let (generics, generic_bounds) = lower_generics(ctx, node);
    let types = type_children(node);
    if types.is_empty() {
        push_error(ctx, node_span(node), "Impl block is missing a target type");
        Option::None
    } else {
        let has_for = has_token(node, lexer::TokenKind::ForKeyword);
        let trait_ref = if has_for {
            lower_trait_ref(ctx, types[0])
        } else {
            Option::None
        };
        let target_index = if has_for {
            types.len() - 1
        } else {
            types.len() - 1
        };
        record_disallowed_self_type(ctx, types[target_index]);
        match lower_ty(ctx, types[target_index]) {
            Some(for_type) => {
                let associated_types: Vec[(string, TypeExpr)] = Vec::[];
                for associated in children_of_kind(node, cst::NodeKind::IMPL_ASSOCIATED_TYPE) {
                    let name = first_token(associated, lexer::TokenKind::Ident);
                    let associated_ty = type_children(associated);
                    match name {
                        Some(name_token) => if !associated_ty.is_empty() {
                            match lower_ty(ctx, associated_ty[0]) {
                                Some(ty) => associated_types.push((name_token.token.text, ty)),
                                None => (),
                            }
                        } else {},
                        None => (),
                    }
                }
                let methods: Vec[Function] = Vec::[];
                for method in children_of_kind(node, cst::NodeKind::FN) {
                    match lower_function(ctx, method, Option::Some(for_type)) {
                        Some(value) => {
                            match trait_ref {
                                Some(_) => match value.visibility {
                                    Public => push_error(
                                        ctx,
                                        node_span(node),
                                        "Trait implementation method " + value.name
                                            + " must not use `pub`",
                                    ),
                                    Private => (),
                                },
                                None => (),
                            };
                            methods.push(value)
                        },
                        None => (),
                    }
                }
                Option::Some(
                    ImplBlock {
                        attrs: lower_attributes(node),
                        generics,
                        generic_bounds,
                        predicates: lower_where_clause(ctx, node),
                        associated_types,
                        trait_ref,
                        for_type,
                        for_type_span: type_head_span(types[target_index]),
                        methods,
                    },
                )
            },
            None => {
                push_error(ctx, node_span(node), "Impl block is missing a target type");
                Option::None
            },
        }
    }
}

fn lower_extern(ctx: LowerCtx, node: LocatedNode) -> Option[Item] {
    let attrs = lower_attributes(node);
    let intrinsic = find_attribute(attrs, "intrinsic");
    let runtime = find_attribute(attrs, "runtime");
    let go_ffi = find_attribute(attrs, "go_ffi");
    if option_attribute_is_none(intrinsic) && option_attribute_is_none(runtime)
        && option_attribute_is_none(go_ffi) {
        push_error(
            ctx,
            node_span(node),
            "Extern declarations require `#[intrinsic(...)]`, `#[runtime(...)]`, or `#[go_ffi(...)]`.",
        );
        Option::None
    } else if has_token(node, lexer::TokenKind::TypeKeyword) {
        let attr_span = match intrinsic {
            Some(value) => value.span,
            None => match runtime {
                Some(value) => value.span,
                None => match go_ffi {
                    Some(value) => value.span,
                    None => node_span(node),
                },
            },
        };
        push_error(ctx, attr_span, "Extern function declarations cannot declare types");
        Option::None
    } else {
        let strings = tokens_of_kind(node, lexer::TokenKind::Str);
        if !strings.is_empty() {
            push_error(
                ctx,
                token_span(strings[0]),
                "Extern function declarations should not specify a language string",
            )
        } else {};
        match first_token(node, lexer::TokenKind::Ident) {
            Some(name_token) => {
                let (generics, generic_bounds) = lower_generics(ctx, node);
                let returns = type_children(node);
                let ret_ty = if !returns.is_empty() {
                    lower_ty(ctx, returns[0])
                } else {
                    Option::None
                };
                Option::Some(
                    Item::ExternFunction(
                        ExternFunction {
                            attrs,
                            visibility: lower_visibility(node),
                            name: name_token.token.text,
                            generics,
                            generic_bounds,
                            predicates: lower_where_clause(ctx, node),
                            params: lower_params(ctx, node, Option::None),
                            ret_ty,
                        },
                    ),
                )
            },
            None => {
                push_error(
                    ctx,
                    node_span(node),
                    "Extern function declaration is missing function name",
                );
                Option::None
            },
        }
    }
}

fn option_attribute_is_none(value: Option[Attribute]) -> bool {
    value.is_none()
}
