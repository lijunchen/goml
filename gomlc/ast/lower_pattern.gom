package ast;

use gomlc::cst;
use gomlc::lexer;
use gomlc::numeric;
use gomlc::strings;
use std::text;

fn literal_value(node: LocatedNode, kind: lexer::TokenKind) -> Option[string] {
    match first_token(node, kind) {
        Some(token) => Option::Some(token.token.text),
        None => Option::None,
    }
}

fn strip_suffix(value: string, suffix: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for index in 0..value.byte_len() {
        if value.byte_get(index) != b'_' {
            builder.write_string(value.byte_slice(index, index + 1))
        } else {
            ()
        }
    };
    let normalized = builder.finish();
    if strings::ends_with(normalized, suffix) {
        normalized.byte_slice(0, normalized.byte_len() - suffix.byte_len())
    } else {
        normalized
    }
}

fn strip_delimiters(value: string) -> Option[string] {
    if value.byte_len() >= 2 {
        Option::Some(value.byte_slice(1, value.byte_len() - 1))
    } else {
        Option::None
    }
}

fn raw_string_pattern_value(node: LocatedNode) -> Option[string] {
    match literal_value(node, lexer::TokenKind::RawStr) {
        Some(source) => {
            let mut hash_count = 0;
            while 1 + hash_count < source.byte_len()
                && source.byte_get(1 + hash_count) == b'#' {
                hash_count = hash_count + 1;
            };
            Option::Some(
                source.byte_slice(hash_count + 2, source.byte_len() - hash_count - 1),
            )
        },
        None => Option::None,
    }
}

fn path_from_single_ident(value: string) -> Path {
    let segments: Vec[PathSegment] = Vec::[];
    segments.push(PathSegment { ident: value, span: span(0, 0) });
    Path { segments }
}

fn signed_pattern_value(node: LocatedNode, kind: lexer::TokenKind, suffix: string) -> Option[string] {
    match literal_value(node, kind) {
        Some(value) => {
            let base = strip_suffix(value, suffix);
            if has_token(node, lexer::TokenKind::Minus) {
                Option::Some("-" + base)
            } else {
                Option::Some(base)
            }
        },
        None => Option::None,
    }
}

fn integer_pattern_value(node: LocatedNode) -> Option[string] {
    match literal_value(node, lexer::TokenKind::IntLit) {
        Some(value) => match numeric::normalize_integer(value) {
            Some(base) => if has_token(node, lexer::TokenKind::Minus) {
                Option::Some("-" + base)
            } else {
                Option::Some(base)
            },
            None => Option::None,
        },
        None => Option::None,
    }
}

fn lower_pat_inner(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    if ctx.pattern_depth.get() >= 128 {
        push_error(ctx, node_span(node), "pattern is too deeply nested");
        Option::None
    } else {
        ctx.pattern_depth.set(ctx.pattern_depth.get() + 1);
        let value_span = node_span(node);
        let result = match node_kind(node) {
            PATTERN_VARIABLE => match first_token(node, lexer::TokenKind::Ident) {
                Some(token) => Option::Some(Pat::Var { name: token.token.text, span: value_span }),
                None => {
                    push_error(ctx, value_span, "Variable pattern is missing a name");
                    Option::None
                },
            },
            PATTERN_UNIT => Option::Some(Pat::Unit { span: value_span }),
            PATTERN_BOOL => match first_token(node, lexer::TokenKind::TrueKeyword) {
                Some(_) => Option::Some(Pat::Bool { value: true, span: value_span }),
                None => match first_token(node, lexer::TokenKind::FalseKeyword) {
                    Some(_) => Option::Some(Pat::Bool { value: false, span: value_span }),
                    None => {
                        push_error(ctx, value_span, "Invalid boolean pattern");
                        Option::None
                    },
                },
            },
            PATTERN_INT => match integer_pattern_value(node) {
                Some(value) => Option::Some(Pat::Int { value, span: value_span }),
                None => Option::None,
            },
            PATTERN_FLOAT => match signed_pattern_value(node, lexer::TokenKind::Float, "") {
                Some(value) => Option::Some(Pat::Float { value, span: value_span }),
                None => Option::None,
            },
            PATTERN_STRING => match literal_value(node, lexer::TokenKind::Str) {
                Some(raw) => match strip_delimiters(raw) {
                    Some(value) => Option::Some(Pat::String { value, span: value_span }),
                    None => Option::None,
                },
                None => match raw_string_pattern_value(node) {
                    Some(value) => Option::Some(Pat::String { value, span: value_span }),
                    None => {
                        push_error(ctx, value_span, "StringPat has no value");
                        Option::None
                    },
                },
            },
            PATTERN_CHAR => match literal_value(node, lexer::TokenKind::CharLit) {
                Some(raw) => match strip_delimiters(raw) {
                    Some(value) => Option::Some(Pat::Char { value, span: value_span }),
                    None => Option::None,
                },
                None => {
                    push_error(ctx, value_span, "CharPat has no value");
                    Option::None
                },
            },
            PATTERN_BYTE => match literal_value(node, lexer::TokenKind::ByteCharLit) {
                Some(raw) => match byte_literal_value(raw) {
                    Some(value) => {
                        Option::Some(Pat::Byte { value, span: value_span })
                    },
                    None => Option::None,
                },
                None => {
                    push_error(ctx, value_span, "BytePat has no value");
                    Option::None
                },
            },
            PATTERN_CONSTR => lower_constr_pat(ctx, node),
            PATTERN_TUPLE => {
                let pats: Vec[Pat] = Vec::[];
                for child in pattern_children(node) {
                    match lower_pat_inner(ctx, child) {
                        Some(value) => pats.push(value),
                        None => (),
                    }
                };
                if !has_token(node, lexer::TokenKind::Comma) && pats.len() == 1 {
                    Option::Some(pats[0])
                } else {
                    Option::Some(Pat::Tuple { items: pats, span: value_span })
                }
            },
            PATTERN_ARRAY => lower_array_pat(ctx, node),
            PATTERN_ALIAS => {
                let names = tokens_of_kind(node, lexer::TokenKind::Ident);
                let pats = pattern_children(node);
                if !names.is_empty() && !pats.is_empty() {
                    match lower_pat_inner(ctx, pats[0]) {
                        Some(pat) => Option::Some(
                            Pat::Alias { name: names[0].token.text, pat, span: value_span },
                        ),
                        None => Option::None,
                    }
                } else {
                    Option::None
                }
            },
            PATTERN_OR => {
                let pats: Vec[Pat] = Vec::[];
                let mut valid = true;
                for child in pattern_children(node) {
                    match lower_pat_inner(ctx, child) {
                        Some(value) => pats.push(value),
                        None => {
                            valid = false;
                        },
                    }
                };
                if valid {
                    Option::Some(Pat::Or { pats, span: value_span })
                } else {
                    Option::None
                }
            },
            PATTERN_RANGE => {
                let children = pattern_children(node);
                if children.len() >= 2 {
                    match lower_pat_inner(ctx, children[0]) {
                        Some(start) => match lower_pat_inner(ctx, children[1]) {
                            Some(end) => Option::Some(
                                Pat::Range {
                                    start,
                                    end,
                                    inclusive: has_token(node, lexer::TokenKind::DotDotEq),
                                    span: value_span,
                                },
                            ),
                            None => Option::None,
                        },
                        None => Option::None,
                    }
                } else {
                    Option::None
                }
            },
            PATTERN_REST => {
                push_error(ctx, value_span, "`..` is only allowed inside an array pattern");
                Option::None
            },
            PATTERN_WILDCARD => Option::Some(Pat::Wild { span: value_span }),
            _ => Option::None,
        };
        ctx.pattern_depth.set(ctx.pattern_depth.get() - 1);
        result
    }
}

fn lower_constr_pat(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    match first_child(node, cst::NodeKind::PATH) {
        Some(path_node) => match lower_path(ctx, path_node) {
            Some(path) => match first_child(node, cst::NodeKind::STRUCT_PATTERN_FIELD_LIST) {
                Some(list) => {
                    let fields: Vec[(string, Pat)] = Vec::[];
                    let mut valid = true;
                    for field in children_of_kind(list, cst::NodeKind::STRUCT_PATTERN_FIELD) {
                        match first_token(field, lexer::TokenKind::Ident) {
                            Some(name_token) => {
                                let patterns = pattern_children(field);
                                if !patterns.is_empty() {
                                    match lower_pat_inner(ctx, patterns[0]) {
                                        Some(pat) => fields.push((name_token.token.text, pat)),
                                        None => {
                                            valid = false;
                                        },
                                    }
                                } else if has_token(field, lexer::TokenKind::Colon) {
                                    push_error(
                                        ctx,
                                        node_span(field),
                                        "Struct pattern field missing pattern",
                                    );
                                    valid = false;
                                } else {
                                    fields.push(
                                        (
                                            name_token.token.text,
                                            Pat::Var {
                                                name: name_token.token.text,
                                                span: node_span(field),
                                            },
                                        ),
                                    )
                                }
                            },
                            None => {
                                push_error(
                                    ctx,
                                    node_span(field),
                                    "Struct pattern field missing name",
                                );
                                valid = false;
                            },
                        }
                    };
                    if valid {
                        Option::Some(
                            Pat::Struct {
                                name: path,
                                fields,
                                has_rest: first_child(list, cst::NodeKind::PATTERN_REST).is_some(),
                                span: node_span(node),
                            },
                        )
                    } else {
                        Option::None
                    }
                },
                None => {
                    let pats: Vec[Pat] = Vec::[];
                    for child in pattern_children(node) {
                        match lower_pat_inner(ctx, child) {
                            Some(value) => pats.push(value),
                            None => (),
                        }
                    };
                    Option::Some(
                        Pat::Constr { constructor: path, args: pats, span: node_span(node) },
                    )
                },
            },
            None => Option::None,
        },
        None => {
            push_error(ctx, node_span(node), "Missing constructor name in pattern");
            Option::None
        },
    }
}

fn lower_array_pat(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    let prefix: Vec[Pat] = Vec::[];
    let suffix: Vec[Pat] = Vec::[];
    let mut rest: Option[ArrayPatRest] = Option::None;
    let mut valid = true;
    for child in pattern_children(node) {
        if cst::node_kind_equal(node_kind(child), cst::NodeKind::PATTERN_REST) {
            let binding = match first_token(child, lexer::TokenKind::Ident) {
                Some(token) => Option::Some(token.token.text),
                None => Option::None,
            };
            rest = Option::Some(ArrayPatRest { binding, span: node_span(child) });
        } else {
            match lower_pat_inner(ctx, child) {
                Some(value) => match rest {
                    Some(_) => suffix.push(value),
                    None => prefix.push(value),
                },
                None => {
                    valid = false;
                },
            }
        }
    };
    if valid {
        Option::Some(Pat::Array { prefix, rest, suffix, span: node_span(node) })
    } else {
        Option::None
    }
}

fn lower_pat(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    lower_pat_inner(ctx, node)
}
