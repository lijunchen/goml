package ast;

use std::text;

fn pretty_decimal_byte(value: string) -> uint8 {
    let result = Ref::new(0);
    for index in range(0, value.byte_len()) {
        result.set(result.get() * 10 + (value.byte_get(index) - 48) as int)
    };
    result.get() as uint8
}

fn pretty_write_byte_literal(builder: text::StringBuilder, value: string) -> unit {
    let byte = pretty_decimal_byte(value);
    builder.write_string("b'\\x");
    builder.write_char(pretty_hex_digit(byte / 16));
    builder.write_char(pretty_hex_digit(byte % 16));
    builder.write_char('\'')
}

fn pretty_write_exprs(
    builder: text::StringBuilder,
    values: Vec[Expr],
    separator: string,
    indent: int,
) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        pretty_write_expr(builder, value, indent);
        index.set(index.get() + 1)
    }
}

fn pretty_write_block(builder: text::StringBuilder, value: Block, indent: int) -> unit {
    if value.stmts.len() == 0 {
        match value.tail {
            None => builder.write_string("{}"),
            Some(tail) => {
                builder.write_char('{');
                pretty_newline(builder, indent + 4);
                pretty_write_expr(builder, tail, indent + 4);
                pretty_newline(builder, indent);
                builder.write_char('}')
            },
        }
    } else {
        builder.write_char('{');
        for stmt in value.stmts {
            pretty_newline(builder, indent + 4);
            pretty_write_stmt(builder, stmt, indent + 4);
            builder.write_char(';')
        };
        match value.tail {
            Some(tail) => {
                pretty_newline(builder, indent + 4);
                pretty_write_expr(builder, tail, indent + 4)
            },
            None => (),
        };
        pretty_newline(builder, indent);
        builder.write_char('}')
    }
}

fn pretty_write_stmt(builder: text::StringBuilder, value: Stmt, indent: int) -> unit {
    match value {
        Let { is_mut, pat, annotation, value: expr, span: _ } => {
            builder.write_string("let ");
            if is_mut {
                builder.write_string("mut ")
            } else {
                ()
            };
            pretty_write_pat(builder, pat, indent);
            match annotation {
                Some(ty) => {
                    builder.write_string(": ");
                    pretty_write_type(builder, ty)
                },
                None => (),
            };
            builder.write_string(" = ");
            pretty_write_expr(builder, expr, indent)
        },
        Assign { target, op, value: expr, span: _ } => {
            pretty_write_expr(builder, target, indent);
            builder.write_char(' ');
            match op {
                Compound(value) => builder.write_string(pretty_binary_symbol(value)),
                Plain => (),
            };
            builder.write_string("= ");
            pretty_write_expr(builder, expr, indent)
        },
        Expr { expr, span: _ } => pretty_write_expr(builder, expr, indent),
    }
}

fn pretty_write_path_expr(
    builder: text::StringBuilder,
    path: Path,
    owner_type_args: Vec[TypeExpr],
    member_type_args: Vec[TypeExpr],
) -> unit {
    if owner_type_args.len() == 0 {
        pretty_write_path(builder, path)
    } else {
        let last = path.segments.len() - 1;
        for index in range(0, last) {
            if index > 0 {
                builder.write_string("::")
            } else {
                ()
            };
            builder.write_string(path.segments.get(index).ident)
        };
        builder.write_string("::");
        builder.write_char('[');
        pretty_write_types(builder, owner_type_args, ", ");
        builder.write_char(']');
        if last > 0 {
            builder.write_string("::");
            builder.write_string(path.segments.get(last).ident)
        } else {
            ()
        }
    };
    if member_type_args.len() > 0 {
        builder.write_string("::[");
        pretty_write_types(builder, member_type_args, ", ");
        builder.write_char(']')
    } else {
        ()
    }
}

fn pretty_write_interpolated_text(builder: text::StringBuilder, value: string) -> unit {
    let index = Ref::new(0);
    while index.get() < value.byte_len() {
        let byte = value.byte_get(index.get());
        if byte == 34 {
            builder.write_string("\\\"")
        } else if byte == 92 {
            builder.write_string("\\\\")
        } else if byte == 10 {
            builder.write_string("\\n")
        } else if byte == 13 {
            builder.write_string("\\r")
        } else if byte == 9 {
            builder.write_string("\\t")
        } else if byte == 123 {
            builder.write_string("{{")
        } else if byte == 125 {
            builder.write_string("}}")
        } else {
            let width = pretty_utf8_width(byte);
            builder.write_string(value.byte_slice(index.get(), index.get() + width))
        };
        index.set(index.get() + pretty_utf8_width(byte))
    }
}

fn pretty_write_expr(builder: text::StringBuilder, value: Expr, indent: int) -> unit {
    match value {
        Path {
            path,
            owner_type_args,
            member_type_args,
            span: _,
        } => pretty_write_path_expr(
            builder,
            path,
            owner_type_args,
            member_type_args,
        ),
        Unit { span: _ } => builder.write_string("()"),
        Bool { value, span: _ } => builder.write_string(if value { "true" } else { "false" }),
        Int { value, span: _ } => builder.write_string(value),
        Float { value, span: _ } => builder.write_string(value.to_string()),
        String { value, span: _ } => pretty_write_quoted_string(builder, value),
        InterpolatedString { parts, span: _ } => {
            builder.write_string("f\"");
            for part in parts {
                match part {
                    Text(value) => {
                        pretty_write_interpolated_text(builder, value)
                    },
                    Expr(value) => {
                        builder.write_char('{');
                        pretty_write_expr(builder, value, indent);
                        builder.write_char('}')
                    },
                }
            };
            builder.write_char('"')
        },
        Char { value, span: _ } => {
            builder.write_char('\'');
            builder.write_string(value);
            builder.write_char('\'')
        },
        Byte { value, span: _ } => pretty_write_byte_literal(builder, value),
        ConstructorValue { constructor: path, span: _ } => {
            pretty_write_path(builder, path)
        },
        Constr { constructor: path, args, span: _ } => {
            pretty_write_path(builder, path);
            if args.len() > 0 {
                builder.write_char('(');
                pretty_write_exprs(builder, args, ", ", indent);
                builder.write_char(')')
            } else {
                ()
            }
        },
        StructLiteral { name: path, fields, base, span: _ } => {
            pretty_write_path(builder, path);
            builder.write_string(" {");
            if fields.len() == 0 && match base {
                Some(_) => false,
                None => true,
            } {
                builder.write_char('}')
            } else {
                let index = Ref::new(0);
                for field in fields {
                    if index.get() > 0 {
                        builder.write_char(',')
                    } else {
                        ()
                    };
                    pretty_newline(builder, indent + 4);
                    builder.write_string(field.0);
                    builder.write_string(": ");
                    pretty_write_expr(builder, field.1, indent + 4);
                    index.set(index.get() + 1)
                };
                match base {
                    Some(value) => {
                        if index.get() > 0 {
                            builder.write_char(',')
                        } else {
                            ()
                        };
                        pretty_newline(builder, indent + 4);
                        builder.write_string("..");
                        pretty_write_expr(builder, value, indent + 4)
                    },
                    None => (),
                };
                pretty_newline(builder, indent);
                builder.write_char('}')
            }
        },
        Tuple { items: values, span: _ } => {
            builder.write_char('(');
            pretty_write_exprs(builder, values, ", ", indent);
            builder.write_char(')')
        },
        Array { items: values, span: _ } => {
            builder.write_char('[');
            pretty_write_exprs(builder, values, ", ", indent);
            builder.write_char(']')
        },
        VecLiteral { items: values, span: _ } => {
            builder.write_string("Vec::[");
            pretty_write_exprs(builder, values, ", ", indent);
            builder.write_char(']')
        },
        HashMapLiteral { entries, span: _ } => {
            builder.write_string("HashMap::{");
            let index = Ref::new(0);
            for entry in entries {
                if index.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                pretty_write_expr(builder, entry.0, indent);
                builder.write_string(" => ");
                pretty_write_expr(builder, entry.1, indent);
                index.set(index.get() + 1)
            };
            builder.write_char('}')
        },
        Closure { params, body, span: _ } => {
            builder.write_char('|');
            let index = Ref::new(0);
            for param in params {
                if index.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                builder.write_string(param.name);
                match param.ty {
                    Some(ty) => {
                        builder.write_string(": ");
                        pretty_write_type(builder, ty)
                    },
                    None => (),
                };
                index.set(index.get() + 1)
            };
            builder.write_string("| ");
            pretty_write_expr(builder, body, indent)
        },
        Match { expr, arms, span: _ } => {
            builder.write_string("match ");
            pretty_write_expr(builder, expr, indent);
            builder.write_string(" {");
            for arm in arms {
                pretty_newline(builder, indent + 4);
                pretty_write_arm(builder, arm, indent + 4)
            };
            pretty_newline(builder, indent);
            builder.write_char('}')
        },
        If { cond, then_branch, else_branch, span: _ } => {
            builder.write_string("if ");
            pretty_write_expr(builder, cond, indent);
            builder.write_string(" {");
            pretty_newline(builder, indent + 4);
            pretty_write_expr(builder, then_branch, indent + 4);
            pretty_newline(builder, indent);
            builder.write_string("} else {");
            pretty_newline(builder, indent + 4);
            pretty_write_expr(builder, else_branch, indent + 4);
            pretty_newline(builder, indent);
            builder.write_char('}')
        },
        While { cond, body, span: _ } => {
            builder.write_string("while ");
            pretty_write_expr(builder, cond, indent);
            builder.write_string(" {");
            pretty_newline(builder, indent + 4);
            pretty_write_expr(builder, body, indent + 4);
            pretty_newline(builder, indent);
            builder.write_char('}')
        },
        For { pat, iterator, body, span: _ } => {
            builder.write_string("for ");
            pretty_write_pat(builder, pat, indent);
            builder.write_string(" in ");
            pretty_write_expr(builder, iterator, indent);
            builder.write_char(' ');
            pretty_write_expr(builder, body, indent)
        },
        Break { span: _ } => builder.write_string("break"),
        Continue { span: _ } => builder.write_string("continue"),
        Return { expr, span: _ } => {
            builder.write_string("return");
            match expr {
                Some(value) => {
                    builder.write_char(' ');
                    pretty_write_expr(builder, value, indent)
                },
                None => (),
            }
        },
        Go { expr, span: _ } => {
            builder.write_string("go ");
            pretty_write_expr(builder, expr, indent)
        },
        Call { func, args, span: _ } => {
            pretty_write_expr(builder, func, indent);
            builder.write_char('(');
            pretty_write_exprs(builder, args, ", ", indent + 2);
            builder.write_char(')')
        },
        Unary { op, expr, span: _ } => {
            builder.write_string(pretty_unary_symbol(op));
            pretty_write_expr(builder, expr, indent)
        },
        Cast { expr, ty, span: _ } => {
            pretty_write_expr(builder, expr, indent);
            builder.write_string(" as ");
            pretty_write_type(builder, ty)
        },
        Try { expr, span: _ } => {
            pretty_write_expr(builder, expr, indent);
            builder.write_char('?')
        },
        Range { start, end, span: _ } => {
            pretty_write_expr(builder, start, indent);
            builder.write_string("..");
            pretty_write_expr(builder, end, indent)
        },
        Binary { op, lhs, rhs, span: _ } => {
            pretty_write_expr(builder, lhs, indent);
            builder.write_char(' ');
            builder.write_string(pretty_binary_symbol(op));
            builder.write_char(' ');
            pretty_write_expr(builder, rhs, indent)
        },
        Proj { tuple: expr, index, span: _ } => {
            pretty_write_expr(builder, expr, indent);
            builder.write_char('.');
            builder.write_string(index.to_string())
        },
        Field {
            expr,
            field_name: field,
            method_type_args,
            span: _,
        } => {
            pretty_write_expr(builder, expr, indent);
            builder.write_char('.');
            builder.write_string(field);
            if method_type_args.len() > 0 {
                builder.write_string("::[");
                pretty_write_types(builder, method_type_args, ", ");
                builder.write_char(']')
            } else {
                ()
            }
        },
        Index { base, index, span: _ } => {
            pretty_write_expr(builder, base, indent);
            builder.write_char('[');
            pretty_write_expr(builder, index, indent);
            builder.write_char(']')
        },
        Block { block, span: _ } => pretty_write_block(builder, block, indent),
    }
}

fn pretty_write_arm(builder: text::StringBuilder, value: Arm, indent: int) -> unit {
    pretty_write_pat(builder, value.pat, indent);
    match value.guard {
        Some(guard) => {
            builder.write_string(" if ");
            pretty_write_expr(builder, guard, indent)
        },
        None => (),
    };
    builder.write_string(" => ");
    pretty_write_expr(builder, value.body, indent + 2);
    builder.write_char(',')
}

fn pretty_pat_is_or(value: Pat) -> bool {
    match value {
        Or { pats: _, span: _ } => true,
        _ => false,
    }
}

fn pretty_write_pats(
    builder: text::StringBuilder,
    values: Vec[Pat],
    separator: string,
    indent: int,
) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        pretty_write_pat(builder, value, indent);
        index.set(index.get() + 1)
    }
}

fn pretty_write_pat(builder: text::StringBuilder, value: Pat, indent: int) -> unit {
    match value {
        Var { name, span: _ } => builder.write_string(name),
        Unit { span: _ } => builder.write_string("()"),
        Bool { value, span: _ } => builder.write_string(if value { "true" } else { "false" }),
        Int { value, span: _ } => builder.write_string(value),
        Float { value, span: _ } => builder.write_string(value),
        String { value, span: _ } => pretty_write_quoted_string(builder, value),
        Char { value, span: _ } => {
            builder.write_char('\'');
            builder.write_string(value);
            builder.write_char('\'')
        },
        Byte { value, span: _ } => pretty_write_byte_literal(builder, value),
        Constr { constructor: path, args, span: _ } => {
            pretty_write_path(builder, path);
            if args.len() > 0 {
                builder.write_char('(');
                pretty_write_pats(builder, args, ", ", indent);
                builder.write_char(')')
            } else {
                ()
            }
        },
        Struct { name: path, fields, has_rest, span: _ } => {
            pretty_write_path(builder, path);
            if fields.len() == 0 && !has_rest {
                builder.write_string(" {}")
            } else {
                builder.write_string(" { ");
                let index = Ref::new(0);
                for field in fields {
                    if index.get() > 0 {
                        builder.write_string(", ")
                    } else {
                        ()
                    };
                    builder.write_string(field.0);
                    builder.write_string(": ");
                    pretty_write_pat(builder, field.1, indent);
                    index.set(index.get() + 1)
                };
                if has_rest {
                    if index.get() > 0 {
                        builder.write_string(", ")
                    } else {
                        ()
                    };
                    builder.write_string("..")
                } else {
                    ()
                };
                builder.write_string(" }")
            }
        },
        Tuple { items: values, span: _ } => {
            builder.write_char('(');
            pretty_write_pats(builder, values, ", ", indent);
            builder.write_char(')')
        },
        Array { prefix, rest, suffix, span: _ } => {
            builder.write_char('[');
            let count = Ref::new(0);
            for value in prefix {
                if count.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                pretty_write_pat(builder, value, indent);
                count.set(count.get() + 1)
            };
            match rest {
                Some(value) => {
                    if count.get() > 0 {
                        builder.write_string(", ")
                    } else {
                        ()
                    };
                    match value.binding {
                        Some(name) => {
                            builder.write_string(name);
                            builder.write_string(" @ ..")
                        },
                        None => builder.write_string(".."),
                    };
                    count.set(count.get() + 1)
                },
                None => (),
            };
            for value in suffix {
                if count.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                pretty_write_pat(builder, value, indent);
                count.set(count.get() + 1)
            };
            builder.write_char(']')
        },
        Alias { name, pat, span: _ } => {
            builder.write_string(name);
            builder.write_string(" @ ");
            if pretty_pat_is_or(pat) {
                builder.write_char('(');
                pretty_write_pat(builder, pat, indent);
                builder.write_char(')')
            } else {
                pretty_write_pat(builder, pat, indent)
            }
        },
        Or { pats: values, span: _ } => pretty_write_pats(builder, values, " | ", indent),
        Range { start, end, inclusive, span: _ } => {
            pretty_write_pat(builder, start, indent);
            builder.write_string(if inclusive { "..=" } else { ".." });
            pretty_write_pat(builder, end, indent)
        },
        Wild { span: _ } => builder.write_char('_'),
    }
}
