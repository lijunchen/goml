package ast;

use gomlc::cst;
use gomlc::lexer;
use std::text;

struct LocatedNode {
    node: cst::CstNode,
    start: int,
}

struct LocatedToken {
    token: lexer::Token,
    start: int,
}

fn root_node(result: cst::ParseResult) -> LocatedNode {
    LocatedNode { node: result.root, start: 0 }
}

fn node_kind(value: LocatedNode) -> cst::NodeKind {
    cst::node_kind(value.node)
}

fn node_span(value: LocatedNode) -> Span {
    span(value.start, value.start + cst::node_byte_len(value.node))
}

fn trimmed_node_end(value: LocatedNode) -> int {
    let cursor = Ref::new(value.start);
    let end = Ref::new(value.start);
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => {
                let child_end = trimmed_node_end(LocatedNode {
                    node: child,
                    start: cursor.get(),
                });
                if child_end > end.get() {
                    end.set(child_end)
                } else {
                    ()
                }
            },
            Token(token) => if lexer::token_is_trivia(token.kind) {
                ()
            } else {
                end.set(cursor.get() + token.text.byte_len())
            },
        };
        cursor.set(cursor.get() + cst::element_byte_len(element))
    };
    end.get()
}

fn trimmed_node_span(value: LocatedNode) -> Span {
    span(value.start, trimmed_node_end(value))
}

fn first_significant_token_span(value: LocatedNode) -> Option[Span] {
    let cursor = Ref::new(value.start);
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => {
                match first_significant_token_span(LocatedNode {
                    node: child,
                    start: cursor.get(),
                }) {
                    Some(value) => return Option::Some(value),
                    None => (),
                }
            },
            Token(token) => if lexer::token_is_trivia(token.kind) {
                ()
            } else {
                return Option::Some(span(
                    cursor.get(),
                    cursor.get() + token.text.byte_len(),
                ))
            },
        };
        cursor.set(cursor.get() + cst::element_byte_len(element))
    };
    Option::None
}

fn type_head_span(value: LocatedNode) -> Span {
    match first_significant_token_span(value) {
        Some(value) => value,
        None => trimmed_node_span(value),
    }
}

fn direct_nodes(value: LocatedNode) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    let cursor = Ref::new(value.start);
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => result.push(LocatedNode {
                node: child,
                start: cursor.get(),
            }),
            Token(_) => (),
        };
        cursor.set(cursor.get() + cst::element_byte_len(element))
    };
    result
}

fn direct_tokens(value: LocatedNode) -> Vec[LocatedToken] {
    let result: Vec[LocatedToken] = Vec::new();
    let cursor = Ref::new(value.start);
    for element in cst::node_children(value.node) {
        match element {
            Node(_) => (),
            Token(token) => result.push(LocatedToken {
                token,
                start: cursor.get(),
            }),
        };
        cursor.set(cursor.get() + cst::element_byte_len(element))
    };
    result
}

fn children_of_kind(value: LocatedNode, kind: cst::NodeKind) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    for child in direct_nodes(value) {
        if cst::node_kind_equal(node_kind(child), kind) {
            result.push(child)
        } else {
            ()
        }
    };
    result
}

fn first_child(value: LocatedNode, kind: cst::NodeKind) -> Option[LocatedNode] {
    for child in direct_nodes(value) {
        if cst::node_kind_equal(node_kind(child), kind) {
            return Option::Some(child)
        } else {
            ()
        }
    };
    Option::None
}

fn tokens_of_kind(value: LocatedNode, kind: lexer::TokenKind) -> Vec[LocatedToken] {
    let result: Vec[LocatedToken] = Vec::new();
    for token in direct_tokens(value) {
        if lexer::token_kind_equal(token.token.kind, kind) {
            result.push(token)
        } else {
            ()
        }
    };
    result
}

fn first_token(value: LocatedNode, kind: lexer::TokenKind) -> Option[LocatedToken] {
    for token in direct_tokens(value) {
        if lexer::token_kind_equal(token.token.kind, kind) {
            return Option::Some(token)
        } else {
            ()
        }
    };
    Option::None
}

fn has_token(value: LocatedNode, kind: lexer::TokenKind) -> bool {
    first_token(value, kind).is_some()
}

fn token_span(value: LocatedToken) -> Span {
    span(value.start, value.start + value.token.text.byte_len())
}

fn write_node_text(value: LocatedNode, builder: text::StringBuilder) -> unit {
    let cursor = Ref::new(value.start);
    for element in cst::node_children(value.node) {
        match element {
            Node(child) => write_node_text(
                LocatedNode {
                    node: child,
                    start: cursor.get(),
                },
                builder,
            ),
            Token(token) => builder.write_string(token.text),
        };
        cursor.set(cursor.get() + cst::element_byte_len(element))
    }
}

fn node_text(value: LocatedNode) -> string {
    let builder = text::StringBuilder::with_capacity(cst::node_byte_len(value.node));
    write_node_text(value, builder);
    builder.finish()
}

fn is_item_kind(kind: cst::NodeKind) -> bool {
    match kind {
        ENUM
        | STRUCT
        | TRAIT
        | IMPL
        | FN
        | EXTERN
        | TYPE_ALIAS
        | CONST => true,
        _ => false,
    }
}

fn is_stmt_kind(kind: cst::NodeKind) -> bool {
    match kind {
        STMT_LET
        | STMT_ASSIGN
        | STMT_EXPR => true,
        _ => false,
    }
}

fn is_expr_kind(kind: cst::NodeKind) -> bool {
    match kind {
        EXPR_IDENT
        | EXPR_PAREN
        | EXPR_BINARY
        | EXPR_RANGE
        | EXPR_PREFIX
        | EXPR_CAST
        | EXPR_IF
        | EXPR_WHILE
        | EXPR_FOR
        | EXPR_BREAK
        | EXPR_CONTINUE
        | EXPR_MATCH
        | EXPR_GO
        | EXPR_RETURN
        | EXPR_UNIT
        | EXPR_BOOL
        | EXPR_INT
        | EXPR_FLOAT
        | EXPR_CHAR
        | EXPR_BYTE
        | EXPR_STR
        | EXPR_MULTILINE_STR
        | EXPR_INTERPOLATED_STRING
        | EXPR_ARRAY_LITERAL
        | EXPR_VEC_LITERAL
        | EXPR_HASHMAP_LITERAL
        | EXPR_TUPLE
        | EXPR_CALL
        | EXPR_INDEX
        | EXPR_TRY
        | EXPR_STRUCT_LITERAL
        | EXPR_CLOSURE => true,
        _ => false,
    }
}

fn is_pattern_kind(kind: cst::NodeKind) -> bool {
    match kind {
        PATTERN_UNIT
        | PATTERN_BOOL
        | PATTERN_STRING
        | PATTERN_INT
        | PATTERN_FLOAT
        | PATTERN_CHAR
        | PATTERN_BYTE
        | PATTERN_TUPLE
        | PATTERN_ARRAY
        | PATTERN_CONSTR
        | PATTERN_VARIABLE
        | PATTERN_WILDCARD
        | PATTERN_ALIAS
        | PATTERN_OR
        | PATTERN_RANGE
        | PATTERN_REST => true,
        _ => false,
    }
}

fn is_type_kind(kind: cst::NodeKind) -> bool {
    match kind {
        TYPE_UNIT
        | TYPE_BOOL
        | TYPE_INT
        | TYPE_INT8
        | TYPE_INT16
        | TYPE_INT32
        | TYPE_INT64
        | TYPE_UINT
        | TYPE_UINT8
        | TYPE_UINT16
        | TYPE_UINT32
        | TYPE_UINT64
        | TYPE_FLOAT32
        | TYPE_FLOAT64
        | TYPE_STRING
        | TYPE_CHAR
        | TYPE_TUPLE
        | TYPE_TAPP
        | TYPE_DYN
        | TYPE_ARRAY
        | TYPE_FUNC => true,
        _ => false,
    }
}

fn filtered_children(value: LocatedNode, selector: (cst::NodeKind) -> bool) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    for child in direct_nodes(value) {
        if selector(node_kind(child)) {
            result.push(child)
        } else {
            ()
        }
    };
    result
}

fn expr_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_expr_kind)
}

fn pattern_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_pattern_kind)
}

fn type_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_type_kind)
}

fn item_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_item_kind)
}

fn stmt_children(value: LocatedNode) -> Vec[LocatedNode] {
    filtered_children(value, is_stmt_kind)
}

fn option_node_is_none(value: Option[LocatedNode]) -> bool {
    match value {
        Some(_) => false,
        None => true,
    }
}
