package query;

use gomlc::core;
use std::env;
use std::fs;
use std::path;

fn builtin_source_candidates() -> Vec[string] {
    let result = Vec::new();
    result.push("stdlib/builtin_prelude.gom");
    result.push("../stdlib/builtin_prelude.gom");
    match env::current_exe() {
        Ok(executable) => match path::parent(executable) {
            Some(directory) => result.push(path::join(directory, "builtin_prelude.gom")),
            None => (),
        },
        Err(_) => (),
    };
    match env::var("GOML_HOME") {
        Some(home) => result.push(path::join(path::join(home, "lib"), "builtin_prelude.gom")),
        None => (),
    };
    match env::var("HOME") {
        Some(home) => result.push(
            path::join(path::join(path::join(home, ".goml"), "lib"), "builtin_prelude.gom"),
        ),
        None => (),
    };
    result
}

fn builtin_navigation_source() -> SourceFile {
    for candidate in builtin_source_candidates() {
        if fs::is_file(candidate) {
            match fs::read_file(candidate) {
                Ok(source) => return SourceFile { path: candidate, source, package_name: "builtin" },
                Err(_) => (),
            }
        } else {
            ()
        }
    };
    SourceFile {
        path: "builtin_prelude.gom",
        source: core::builtin_source(),
        package_name: "builtin",
    }
}

fn append_builtin_navigation_source(values: Vec[SourceFile]) -> unit {
    values.push(builtin_navigation_source())
}
