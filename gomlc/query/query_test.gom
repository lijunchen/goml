package query;

use gomlc::ast;
use gomlc::cst;
use gomlc::ctir;
use gomlc::hir;
use gomlc::lexer;
use gomlc::parser;
use gomlc::tast;
use std::fs;
use std::testing;
use std::text;

fn assert_no_diagnostics(value: Analysis) -> unit {
    if value.checked.diagnostics.len() > 0 {
        testing::fail(value.checked.diagnostics.get(0).message)
    } else {}
}

fn last_substring(value: string, expected: string) -> Option[int] {
    let result = Ref::new(Option::None);
    let index = Ref::new(0);
    while index.get() + expected.byte_len() <= value.byte_len() {
        if value.byte_slice(index.get(), index.get() + expected.byte_len()) == expected {
            result.set(Option::Some(index.get()))
        } else {};
        index.set(index.get() + 1)
    }
    result.get()
}

fn has_completion(values: Vec[CompletionItem], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.label == expected {
            found.set(true)
        } else {}
    }
    found.get()
}

fn assert_local_navigation(value: Analysis, source: string, name: string) -> unit {
    match last_substring(source, name) {
        Some(offset) => {
            let definitions = goto_definitions(value, offset);
            testing::assert_eq(definitions.len(), 1);
            testing::assert_eq(
                source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                name,
            );
            match hover(value, offset) {
                Some(result) => testing::assert_eq(result.contents, "int"),
                None => testing::fail("expected local hover for " + name),
            }
        },
        None => testing::fail("expected local use for " + name),
    }
}

fn completion_labels(values: Vec[CompletionItem]) -> string {
    let builder = text::StringBuilder::new();
    let count = Ref::new(0);
    for value in values {
        if count.get() > 0 {
            builder.write_string(", ")
        } else {};
        builder.write_string(value.label);
        count.set(count.get() + 1)
    }
    builder.finish()
}

fn write_query_fixture(path: string, source: string) -> unit {
    match fs::write_file(path, source) {
        Ok(()) => (),
        Err(error) => testing::fail(error),
    }
}

fn required_builtin_comptime_module() -> ctir::CtModule {
    match builtin_comptime_module() {
        Ok(Some(value)) => value,
        Ok(None) => {
            testing::fail("expected builtin comptime derive module");
            ctir::empty_module("builtin")
        },
        Err(error) => {
            testing::fail(error);
            ctir::empty_module("builtin")
        },
    }
}

fn builtin_source_derive_expansion(source: string) -> string {
    let expanded = hir::expand_derives_with_environment(
        ast::lower(parser::parse(source)),
        hir::DeriveEnvironment {
            builtin: Option::Some(required_builtin_comptime_module()),
            dependencies: Vec::[],
            reexports: Vec::[],
        },
    );
    if expanded.diagnostics.is_empty() {} else {
        testing::fail(expanded.diagnostics[0].message)
    };
    let formatted = ast::pretty(expanded);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::[(expanded, "derive_test.gom")];
    let files: Vec[hir::File] = Vec::[];
    for lowered in hir::lower_expanded_package_files(inputs, "derive_test") {
        if lowered.diagnostics.is_empty() {} else {
            testing::fail(lowered.diagnostics[0].message)
        };
        match lowered.hir {
            Some(file) => files.push(file),
            None => testing::fail("expected expanded derive HIR"),
        }
    }
    let checked = tast::check_package_files_for_link_with_dependencies(files, Vec::[]);
    if checked.diagnostics.is_empty() {} else {
        testing::fail(checked.diagnostics[0].message)
    };
    formatted
}

#[test]
fn expands_builtin_derives_from_toolchain_source_handlers() -> unit {
    let expanded = builtin_source_derive_expansion(
        "#[derive(ToString, Debug, PartialEq, Eq, Hash)]\nstruct Pair[T] { left: T, label: string }\n\n#[derive(ToString, Debug, PartialEq, Eq, Hash)]\nenum State[T] { Idle, One(T), Named { value: T, label: string } }",
    );
    testing::assert(expanded.contains("impl[T] ToString for Pair[T]"));
    testing::assert(expanded.contains("impl[T] Debug for Pair[T]"));
    testing::assert(expanded.contains("impl[T] PartialEq for Pair[T]"));
    testing::assert(expanded.contains("impl[T] Eq for Pair[T]"));
    testing::assert(expanded.contains("impl[T] Hash for Pair[T]"));
    testing::assert(expanded.contains("impl[T] ToString for State[T]"));
    testing::assert(expanded.contains("impl[T] Debug for State[T]"));
    testing::assert(expanded.contains("impl[T] PartialEq for State[T]"));
    testing::assert(expanded.contains("impl[T] Eq for State[T]"));
    testing::assert(expanded.contains("impl[T] Hash for State[T]"));
    testing::assert(expanded.contains("14695981039346656037"));
    testing::assert(expanded.contains("1099511628211"))
}

#[test]
fn builtin_derives_require_builtin_source_exports() -> unit {
    let expanded = hir::expand_derives_with_environment(
        ast::lower(parser::parse("#[derive(Eq)] struct Key { value: int }")),
        hir::DeriveEnvironment { builtin: Option::None, dependencies: Vec::[], reexports: Vec::[] },
    );
    testing::assert_eq(expanded.diagnostics.len(), 1);
    testing::assert(expanded.diagnostics[0].message.contains("derive name `Eq` is not in scope"))
}

#[test]
fn parses_module_paths_and_package_names() -> unit {
    match manifest_module_path(
        "[build]\ntarget-dir = \"out\"\n\n[module]\npath = \"alice::tools\"\n",
    ) {
        Some(value) => testing::assert_eq(value, "alice::tools"),
        None => testing::fail("expected module path"),
    };
    match package_name("/workspace/tools", "alice::tools", "/workspace/tools/lsp/server") {
        Ok(value) => {
            testing::assert_eq(value, "alice::tools::lsp::server")
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn analyzes_package_files_with_unsaved_overrides() -> unit {
    let root = "../gomlc/testdata/module/project033_cross_file_pattern_constructor";
    let main_path = root + "/main.gom";
    let types_path = root + "/types.gom";
    let source = "package main; fn answer() -> int32 { helper() }";
    let overrides = Vec::new();
    overrides.push(
        SourceOverride { path: types_path, source: "package main; fn helper() -> int32 { 42 }" },
    );
    let analysis = analyze_with_overrides(main_path, source, overrides);
    testing::assert_eq(analysis.package_name, "test::cross_file_pattern_constructor");
    testing::assert_eq(analysis.checked.diagnostics.len(), 0);
    match fs::read_file(main_path) {
        Ok(on_disk) => testing::assert(on_disk != source),
        Err(error) => testing::fail(error),
    }
}

