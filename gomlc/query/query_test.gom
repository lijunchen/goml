}

#[test]
fn resolves_index_map_standard_library_definitions() -> unit {
    let source = "use std::collections; fn main() -> unit { let values: collections::IndexMap[string, int] = collections::IndexMap::new(); values.insert(\"key\", 1); }";
    match last_substring(source, "insert") {
        Some(offset) => {
            let analysis = analyze("/tmp/index-map-std.gom", source);
            assert_no_diagnostics(analysis);
            let definitions = goto_definitions(analysis, offset);
            testing::assert_eq(definitions.len(), 1);
            match source_by_path(analysis.sources, definitions.get(0).source_path) {
                Some(target) => {
                    testing::assert_eq(target.package_name, "std::collections");
                    testing::assert_eq(
                        target.source.byte_slice(
                            definitions.get(0).span.start,
                            definitions.get(0).span.end,
                        ),
                        "insert",
                    )
                },
                None => testing::fail("expected IndexMap source"),
            }
        },
        None => testing::fail("expected IndexMap insert call"),
    }
}

#[test]
fn returns_signature_help_for_active_arguments() -> unit {
    let source = "fn combine(left: int32, right: string) -> bool { true } fn main() -> bool { combine(1, \"x\") }";
    let analysis = analyze("main.gom", source);
    match last_substring(source, "\"x\"") {
        Some(offset) => match signature_help(analysis, offset + 1) {
            Some(signature) => {
                testing::assert_eq(signature.label, "(left: int32, right: string) -> bool");
                testing::assert_eq(signature.parameters.len(), 2);
                testing::assert_eq(signature.active_parameter, 1)
            },
            None => testing::fail("expected signature help"),
        },
        None => testing::fail("expected second argument"),
    }
}

#[test]
fn hides_method_receivers_in_signature_help() -> unit {
    let source = "fn main() -> string { let value = 1; value.to_string() }";
    match last_substring(source, "to_string()") {
        Some(offset) => match signature_help(
            analyze("main.gom", source),
            offset + "to_string(".byte_len(),
        ) {
            Some(signature) => {
                testing::assert_eq(signature.label, "() -> string");
                testing::assert_eq(signature.parameters.len(), 0)
            },
            None => testing::fail("expected method signature"),
        },
        None => testing::fail("expected method call"),
    }
}

#[test]
fn returns_inlay_hints_for_unannotated_let_bindings() -> unit {
    let source = "fn main() -> int { let value = 42; let named: int = value; named }";
    let analysis = analyze("main.gom", source);
    let hints = inlay_hints(analysis);
    testing::assert_eq(hints.len(), 1);
    testing::assert_eq(hints.get(0).label, ": int");
    testing::assert_eq(source.byte_slice(hints.get(0).span.start, hints.get(0).span.end), "value")
}

#[test]
fn filters_inlay_hints_to_source_ranges() -> unit {
    let source = "fn main() -> unit {\n    let first = 1;\n    let second = 2;\n    ()\n}";
    match last_substring(source, "second") {
        Some(start) => {
            let hints = inlay_hints_in_range(analyze("main.gom", source), start, source.byte_len());
            testing::assert_eq(hints.len(), 1);
            testing::assert_eq(
                source.byte_slice(hints.get(0).span.start, hints.get(0).span.end),
                "second",
            )
        },
        None => testing::fail("expected second binding"),
    }
}

#[test]
fn returns_inlay_hints_for_closure_parameters() -> unit {
    let source = "fn main() -> unit { let f = |value| value + 1; () }";
    let hints = inlay_hints(analyze("main.gom", source));
    let found = Ref::new(false);
    for hint in hints {
        if source.byte_slice(hint.span.start, hint.span.end) == "value" && hint.label == ": int" {
            found.set(true)
        } else {}
    }
    testing::assert(found.get())
}

#[test]
fn completes_scope_and_struct_members() -> unit {
    let scope_source = "fn main() -> int32 { let value = 42; value }";
    let scope_analysis = analyze("main.gom", scope_source);
    testing::assert(
        has_completion(completions(scope_analysis, scope_source.byte_len() - 3), "value"),
    );
    let member_source = "struct Point { x: int32, y: int32 } fn main() -> int32 { let point = Point { x: 1, y: 2 }; point.x }";
    let member_analysis = analyze("main.gom", member_source);
    match last_substring(member_source, "point.x") {
        Some(offset) => testing::assert(
            has_completion(completions(member_analysis, offset + "point.x".byte_len()), "x"),
        ),
        None => testing::fail("expected member expression"),
    }
}

#[test]
fn completes_incomplete_member_and_enum_paths() -> unit {
    let member_source = "struct Point { x: int32 } fn main() -> unit { let point = Point { x: 1 }; let _ = point.; () }";
    testing::assert(
        has_completion(
            completions(analyze("main.gom", member_source), member_source.byte_len() - 6),
            "x",
        ),
    );
    let enum_source = "enum Color { Red, Green } fn main() -> unit { let value = Color::; () }";
    match last_substring(enum_source, "Color::") {
        Some(offset) => {
            let items = completions(analyze("main.gom", enum_source), offset + "Color::".byte_len());
            testing::assert(has_completion(items, "Red"));
            testing::assert(has_completion(items, "Green"))
        },
        None => testing::fail("expected enum path"),
    };
    let argument_source = "struct Point { x: int32 } fn consume(value: int32) -> unit { () } fn main() -> unit { let point = Point { x: 1 }; consume(point.); () }";
    match last_substring(argument_source, "point.") {
        Some(offset) => testing::assert(
            has_completion(
                completions(analyze("main.gom", argument_source), offset + "point.".byte_len()),
                "x",
            ),
        ),
        None => testing::fail("expected argument member expression"),
    }
}

#[test]
fn completes_standard_library_import_paths() -> unit {
    let root_source = "package main;\nuse st";
    testing::assert(
        has_completion(
            completions(analyze("/tmp/import-main.gom", root_source), root_source.byte_len()),
            "std",
        ),
    );
    let child_source = "package main;\nuse std::";
    let children = completions(
        analyze("/tmp/import-main.gom", child_source),
        child_source.byte_len(),
    );
    testing::assert(has_completion(children, "io"));
    testing::assert(has_completion(children, "path"));
    let item_source = "package main;\nuse std::io::pri";
    testing::assert(
        has_completion(
            completions(analyze("/tmp/import-main.gom", item_source), item_source.byte_len()),
            "println",
        ),
    )
}

#[test]
fn completes_builtin_and_dyn_trait_members() -> unit {
    let static_source = "fn main() -> unit { let _ = Vec::with_; () }";
    match last_substring(static_source, "with_") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", static_source), offset + "with_".byte_len()),
            "with_capacity",
        ) {} else {
            testing::fail("expected Vec with_capacity completion")
        },
        None => testing::fail("expected Vec static member"),
    };
    let int_source = "fn main() -> string { let value = 1; value.to_ }";
    match last_substring(int_source, "to_") {
        Some(offset) => {
            let values = completions(analyze("main.gom", int_source), offset + 3);
            if has_completion(values, "to_string") {} else {
                testing::fail("expected int to_string completion")
            };
            if has_completion(values, "to_uint8") {} else {
                testing::fail("expected int to_uint8 completion")
            };
            if has_completion(values, "to_int") {
                testing::fail("unexpected int identity conversion completion")
            } else {}
        },
        None => testing::fail("expected int member"),
    };
    let string_source = "fn main(value: string) -> unit { value.con }";
    match last_substring(string_source, "value.con") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", string_source), offset + "value.con".byte_len()),
            "contains",
        ) {} else {
            testing::fail("expected string contains completion")
        },
        None => testing::fail("expected string member"),
    };
    let vec_source = "fn main() -> unit { let values: Vec[int32] = Vec::new(); values.p }";
    match last_substring(vec_source, "values.p") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", vec_source), offset + "values.p".byte_len()),
            "push",
        ) {} else {
            testing::fail("expected Vec push completion")
        },
        None => testing::fail("expected Vec member"),
    };
    let dyn_source = "trait Showable { fn show(Self) -> string; } fn render(value: dyn Showable) -> string { value.sh }";
    match last_substring(dyn_source, "value.sh") {
        Some(offset) => {
            let analysis = analyze("main.gom", dyn_source);
            match explicit_receiver_type(analysis, offset + "value".byte_len()) {
                Some(name) => testing::assert_eq(name, "Showable"),
                None => testing::fail("expected explicit dyn type"),
            };
            let method_found = Ref::new(false);
            for symbol in build_symbol_index(analysis).symbols {
                if symbol.name == "show" {
                    method_found.set(true)
                } else {}
            }
            testing::assert(method_found.get());
            let items = completions(analysis, offset + "value.sh".byte_len());
            if has_completion(items, "show") {} else {
                testing::fail("expected dyn show completion, got " + completion_labels(items))
            }
        },
        None => testing::fail("expected dyn member"),
    }
}

#[test]
fn completes_only_the_public_prelude_surface() -> unit {
    let print_source = "fn main() -> unit { pri }";
    match last_substring(print_source, "pri") {
        Some(offset) => {
            let items = completions(analyze("main.gom", print_source), offset + 3);
            testing::assert(has_completion(items, "print"));
            testing::assert(has_completion(items, "println"))
        },
        None => testing::fail("expected prelude completion prefix"),
    };
    let string_source = "fn main() -> unit { string_ }";
    match last_substring(string_source, "string_") {
        Some(offset) => {
            let items = completions(analyze("main.gom", string_source), offset + 7);
            testing::assert(has_completion(items, "string_get"));
            testing::assert(!has_completion(items, "string_get_raw"))
        },
        None => testing::fail("expected builtin completion prefix"),
    };
    let derive_source = "fn main() -> unit { derive_ }";
    match last_substring(derive_source, "derive_") {
        Some(offset) => {
            let items = completions(analyze("main.gom", derive_source), offset + 7);
            testing::assert(!has_completion(items, "derive_output_new"))
        },
        None => testing::fail("expected derive completion prefix"),
    }
}

#[test]
fn completes_imported_package_namespaces() -> unit {
    let root = "../gomlc/testdata/module/project001";
    let main_path = root + "/main.gom";
    match fs::read_file(main_path) {
        Ok(source) => match last_substring(source, "sum_point") {
            Some(offset) => {
                let analysis = analyze(main_path, source);
                testing::assert(has_completion(completions(analysis, offset + 2), "sum_point"))
            },
            None => testing::fail("expected sum_point"),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn filters_completion_scope_and_suggests_keywords() -> unit {
    let source = "fn first() -> int32 { let hidden = 1; hidden }\nfn second() -> int32 { let visible = 2; vis }";
    match last_substring(source, "vis") {
        Some(offset) => {
            let items = completions(analyze("main.gom", source), offset + 3);
            testing::assert(has_completion(items, "visible"));
            testing::assert(!has_completion(items, "hidden"))
        },
        None => testing::fail("expected completion prefix"),
    };
    let keyword_source = "fn main() -> unit { ma }";
    match last_substring(keyword_source, "ma") {
        Some(offset) => testing::assert(
            has_completion(completions(analyze("main.gom", keyword_source), offset + 2), "match"),
        ),
        None => testing::fail("expected keyword prefix"),
    };
    let loop_source = "fn main() -> unit { lo }";
    match last_substring(loop_source, "lo") {
        Some(offset) => testing::assert(
            has_completion(completions(analyze("main.gom", loop_source), offset + 2), "loop"),
        ),
        None => testing::fail("expected loop keyword prefix"),
    };
    let call_source = "fn use_value(value: int32) -> unit { () } fn main() -> unit { use_value( }";
    match last_substring(call_source, "use_value(") {
        Some(offset) => testing::assert_eq(
            completions(analyze("main.gom", call_source), offset + "use_value(".byte_len()).len(),
            0,
        ),
        None => testing::fail("expected call"),
    }
}

#[test]
fn indexes_syntax_with_absolute_ranges_and_parents() -> unit {
    let analysis = analyze("main.gom", "fn main() -> int32 { let value = 42; value }");
    testing::assert(analysis.syntax.nodes.len() > 1);
    testing::assert(analysis.syntax.tokens.len() > 1);
    match token_at(analysis.syntax, 3) {
        Some(token) => {
            testing::assert(lexer::token_kind_equal(token.kind, lexer::TokenKind::Ident));
            testing::assert_eq(token.text, "main")
        },
        None => testing::fail("expected token"),
    };
    match node_at(analysis.syntax, 3) {
        Some(node) => {
            testing::assert(!cst::node_kind_equal(node.kind, cst::NodeKind::FILE));
            match parent_node(analysis.syntax, node) {
                Some(_) => (),
                None => testing::fail("expected parent node"),
            }
        },
        None => testing::fail("expected node"),
    }
}

#[test]
fn indexes_attributed_declarations_by_declared_names() -> unit {
    let source = "#[test] fn works() -> unit { () } #[derive(Eq)] struct Key { value: int }";
    let index = build_symbol_index(analyze("main.gom", source));
    let works = Ref::new(false);
    let key = Ref::new(false);
    for symbol in index.symbols {
        if symbol.name == "works" {
            works.set(true)
        } else if symbol.name == "Key" {
            key.set(true)
        } else {
            testing::assert(symbol.name != "test" && symbol.name != "derive")
        }
    }
    testing::assert(works.get());
    testing::assert(key.get())
}

#[test]
fn navigates_bindings_across_pattern_and_closure_syntax() -> unit {
    let source = "struct Pair { left: int, right: int } enum Maybe { Some(Pair), None } fn main() -> int { let Pair { left: left_value, right: right_value } = Pair { left: 1, right: 2 }; let if_result = if let Some(Pair { left: if_value, right: _ }) = Some(Pair { left: 3, right: 4 }) { if_value } else { 0 }; let match_result = match Some(Pair { left: 5, right: 6 }) { Some(Pair { left: match_value, right: _ }) => match_value, None => 0 }; let total = Ref::new(0); for (for_left, for_right) in Vec::[(7, 8)] { total.set(total.get() + for_left + for_right) }; let closure = |closure_value: int| closure_value + left_value; closure(right_value) + if_result + match_result + total.get() }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::[
        "left_value",
        "right_value",
        "if_value",
        "match_value",
        "for_left",
        "for_right",
        "closure_value",
    ] {
        assert_local_navigation(analysis, source, name)
    }
}

#[test]
fn returns_hover_from_typecheck_facts() -> unit {
    let source = "fn main() -> int32 { let value = 42; value }";
    let analysis = analyze("main.gom", source);
    testing::assert_eq(analysis.checked.diagnostics.len(), 0);
    match hover(analysis, source.byte_len() - 3) {
        Some(result) => {
            testing::assert_eq(result.contents, "int32");
            testing::assert_eq(source.byte_slice(result.span.start, result.span.end), "value")
        },
        None => testing::fail("expected hover"),
    }
}

#[test]
fn returns_function_hover_on_declarations_and_calls() -> unit {
    let source = "fn add(x: int32, y: int32) -> int32 { x + y }\nfn main() -> int32 { add(1, 2) }";
    match hover(analyze("main.gom", source), 3) {
        Some(result) => {
            testing::assert_eq(result.contents, "(int32, int32) -> int32")
        },
        None => testing::fail("expected declaration hover"),
    };
    match last_substring(source, "add") {
        Some(offset) => match hover(analyze("main.gom", source), offset) {
            Some(result) => testing::assert_eq(result.contents, "(int32, int32) -> int32"),
            None => testing::fail("expected call hover"),
        },
        None => testing::fail("expected function call"),
    }
}

#[test]
fn shows_comptime_capability_in_function_hover() -> unit {
    let source = "#[comptime] fn value() -> int { 42 } fn main() -> int { value() }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "value") {
        Some(offset) => match hover(analysis, offset) {
            Some(result) => testing::assert_eq(result.contents, "comptime () -> int"),
            None => testing::fail("expected comptime function hover"),
        },
        None => testing::fail("expected comptime function call"),
    }
}

#[test]
fn reports_comptime_evaluation_failures_during_analysis() -> unit {
    let source = "#[comptime] fn fail() -> int { compile_error(\"query failure\") } fn main() -> int { comptime { fail() } }";
    let analysis = analyze("main.gom", source);
    let found = Ref::new(false);
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic.message.contains("query failure") {
            testing::assert_eq(diagnostic.stage, "comptime");
            found.set(true)
        } else {}
    }
    testing::assert(found.get())
}

#[test]
fn navigates_calls_inside_comptime_blocks() -> unit {
    let source = "#[comptime] fn answer() -> int { 42 } fn main() -> int { comptime { answer() } }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "answer") {
        Some(offset) => {
            let definitions = goto_definitions(analysis, offset);
            testing::assert_eq(definitions.len(), 1);
            testing::assert_eq(
                source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                "answer",
            );
            match hover(analysis, offset) {
                Some(result) => testing::assert_eq(result.contents, "comptime () -> int"),
                None => testing::fail("expected comptime call hover"),
            }
        },
        None => testing::fail("expected comptime call"),
    }
}

#[test]
fn shows_generic_method_parameters_in_hover_and_concrete_signature_help() -> unit {
    let source = "struct Box[T] { value: T } impl[T] Box[T] { fn map[U](self: Box[T], convert: (T) -> U) -> Box[U] { Box { value: convert(self.value) } } } struct Other {} impl Other { fn map[V](self: Other, value: V) -> V { let _ = self; value } } fn main() -> Box[string] { let value = Box { value: 1 }; value.map(|item: int| item.to_string()) }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "map[U]") {
        Some(offset) => match hover(analysis, offset) {
            Some(result) => testing::assert_eq(
                result.contents,
                "[U] (gomlc::Box[T], (T) -> U) -> gomlc::Box[U]",
            ),
            None => testing::fail("expected generic method hover"),
        },
        None => testing::fail("expected method declaration"),
    };
    match last_substring(source, "map(") {
        Some(offset) => match signature_help(analysis, offset + "map(".byte_len()) {
            Some(signature) => testing::assert_eq(
                signature.label,
                "(convert: (int) -> string) -> gomlc::Box[string]",
            ),
            None => testing::fail("expected generic method signature"),
        },
        None => testing::fail("expected method call"),
    }
}

#[test]
fn indexes_completes_and_hovers_type_aliases_and_constants() -> unit {
    let source = "type Count = int32; const answer: Count = 42; fn main() -> int32 { answer }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    let alias_found = Ref::new(false);
    let constant_found = Ref::new(false);
    for symbol in build_symbol_index(analysis).symbols {
        match symbol.kind {
            TypeAlias => if symbol.name == "Count" {
                alias_found.set(true)
            } else {},
            Constant => if symbol.name == "answer" {
                constant_found.set(true)
            } else {},
            _ => (),
        }
    }
    testing::assert(alias_found.get());
    testing::assert(constant_found.get());
    match last_substring(source, "ans") {
        Some(offset) => testing::assert(has_completion(completions(analysis, offset + 3), "answer")),
        None => testing::fail("expected constant prefix"),
    };
    match last_substring(source, "answer") {
        Some(offset) => match hover(analysis, offset) {
            Some(value) => testing::assert_eq(value.contents, "int32"),
            None => testing::fail("expected constant hover"),
        },
        None => testing::fail("expected constant declaration"),
    };
    match hover(analysis, "type ".byte_len()) {
        Some(value) => testing::assert_eq(value.contents, "int32"),
        None => testing::fail("expected type alias hover"),
    }
}

#[test]
fn discovers_internal_and_external_test_items() -> unit {
    let source = "package value;\n#[test]\nfn works() -> unit { () }\n";
    let internal = test_items("/tmp/value_test.gom", source);
    testing::assert_eq(internal.len(), 1);
    testing::assert_eq(internal.get(0).name, "works");
    match internal.get(0).kind {
        Internal => (),
        External => testing::fail("expected internal test"),
    };
    let external = test_items("/tmp/project/tests/api_test.gom", source);
    testing::assert_eq(external.len(), 1);
    match external.get(0).kind {
        External => (),
        Internal => testing::fail("expected external test"),
    };
    testing::assert_eq(test_items("/tmp/value.gom", source).len(), 0)
}

#[test]
fn resolves_external_registry_packages_with_mvs() -> unit {
    let root = "/tmp/goml-bootstrap-query-registry";
    let registry = root + "/registry";
    let project = root + "/project";
    let http = registry + "/alice/http/1.0.0";
    let shared_one = registry + "/alice/shared/1.0.0";
    let shared_two = registry + "/alice/shared/2.0.0";
    for directory in Vec::[project, http, shared_one, shared_two] {
        match fs::create_dir_all(directory) {
            Ok(()) => (),
            Err(error) => testing::fail(error),
        }
    }
    write_query_fixture(
        registry + "/index.toml",
        "[modules.\"alice::http\"]\nlatest = \"1.0.0\"\nversions = [\"1.0.0\"]\n\n[modules.\"alice::shared\"]\nlatest = \"2.0.0\"\nversions = [\"1.0.0\", \"2.0.0\"]\n",
    );
    write_query_fixture(
        project + "/goml.toml",
        "[module]\npath = \"test::app\"\n\n[dependencies]\n\"alice::http\" = \"1.0.0\"\n\"alice::shared\" = \"1.0.0\"\n",
    );
    write_query_fixture(
        http + "/goml.toml",
        "[module]\npath = \"alice::http\"\n\n[dependencies]\n\"alice::shared\" = \"2.0.0\"\n",
    );
    write_query_fixture(http + "/http.gom", "package http; pub fn status() -> int32 { 200 }");
    write_query_fixture(shared_one + "/goml.toml", "[module]\npath = \"alice::shared\"\n");
    write_query_fixture(shared_two + "/goml.toml", "[module]\npath = \"alice::shared\"\n");
    write_query_fixture(
        shared_one + "/shared.gom",
        "package shared; pub fn version() -> int32 { 1 }",
    );
    write_query_fixture(
        shared_two + "/shared.gom",
        "package shared; pub fn version() -> int32 { 2 }",
    );
    match external_package_sources_at(registry, project, "alice::http", Vec::new()) {
        Ok(files) => {
            testing::assert_eq(files.len(), 1);
            testing::assert_eq(files.get(0).package_name, "alice::http")
        },
        Err(error) => testing::fail(error),
    };
    match resolve_external_modules_at(project, registry) {
        Ok(modules) => {
            let selected = Ref::new("");
            for module in modules {
                if module.name == "alice::shared" {
                    selected.set(module.version)
                } else {}
            }
            testing::assert_eq(selected.get(), "2.0.0")
        },
        Err(error) => testing::fail(error),
    }
}
