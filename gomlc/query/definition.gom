package query;

use gomlc::ast;
use gomlc::cst;
use gomlc::hir;
use gomlc::lexer;
use gomlc::parser;
use gomlc::strings;
use gomlc::tast;
use std::text;

pub struct DefinitionResult {
    pub source_path: string,
    pub span: ast::Span,
}

fn same_local(left: hir::LocalId, right: hir::LocalId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

fn source_by_path(
    sources: Vec[SourceFile],
    source_path: string,
) -> Option[SourceFile] {
    let index = Ref::new(sources.len() - 1);
    while index.get() >= 0 {
        let source = sources.get(index.get());
        if source.path == source_path {
            return Option::Some(source)
        } else {
            index.set(index.get() - 1)
        }
    };
    Option::None
}

fn same_definition(
    left: DefinitionResult,
    right: DefinitionResult,
) -> bool {
    left.source_path == right.source_path
        && left.span.start == right.span.start
        && left.span.end == right.span.end
}

fn push_definition(
    values: Vec[DefinitionResult],
    value: DefinitionResult,
) -> unit {
    for existing in values {
        if same_definition(existing, value) {
            return
        } else {
            ()
        }
    };
    values.push(value)
}

fn package_definition(
    value: Analysis,
    package_name: string,
) -> Option[DefinitionResult] {
    let index = Ref::new(value.sources.len() - 1);
    while index.get() >= 0 {
        let source = value.sources.get(index.get());
        if source.package_name == package_name {
            return Option::Some(DefinitionResult {
                source_path: source.path,
                span: ast::span(0, 0),
            })
        } else {
            index.set(index.get() - 1)
        }
    };
    Option::None
}

fn path_node_at(value: Analysis, offset: int) -> Option[SyntaxNode] {
    node_at_kind(value.syntax, offset, cst::NodeKind::PATH)
}

fn node_identifiers(
    value: Analysis,
    node: SyntaxNode,
) -> Vec[SyntaxToken] {
    let result = Vec::new();
    for token in value.syntax.tokens {
        if token.start >= node.start
            && token.end <= node.end
            && lexer::token_kind_equal(
                token.kind,
                lexer::TokenKind::Ident,
            )
        {
            result.push(token)
        } else {
            ()
        }
    };
    result
}

fn path_prefix(
    values: Vec[SyntaxToken],
    end: int,
) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, end + 1) {
        if index > 0 {
            builder.write_string("::")
        } else {
            ()
        };
        builder.write_string(values.get(index).text)
    };
    builder.finish()
}

fn containing_use(
    value: Analysis,
    node: SyntaxNode,
) -> bool {
    let current = Ref::new(node.parent);
    while match current.get() {
        Option::Some(_) => true,
        Option::None => false,
    } {
        match current.get() {
            Option::Some(id) => {
                let parent = value.syntax.nodes.get(id);
                if cst::node_kind_equal(parent.kind, cst::NodeKind::USE) {
                    return true
                } else {
                    current.set(parent.parent)
                }
            },
            Option::None => (),
        }
    };
    false
}

fn longest_package_prefix(
    value: Analysis,
    path_value: string,
) -> Option[string] {
    let result = Ref::new(Option::None);
    let length = Ref::new(0);
    for source in value.sources {
        let package_name = source.package_name;
        if (path_value == package_name
            || strings::starts_with(path_value, package_name + "::"))
            && package_name.byte_len() > length.get()
        {
            result.set(Option::Some(package_name));
            length.set(package_name.byte_len())
        } else {
            ()
        }
    };
    result.get()
}

fn canonical_path_at(
    value: Analysis,
    node: SyntaxNode,
    identifiers: Vec[SyntaxToken],
    token_index: int,
) -> string {
    let raw = path_prefix(identifiers, token_index);
    if containing_use(value, node) {
        raw
    } else {
        match namespace_target(value, identifiers.get(0).text) {
            Option::Some(package_name) => if token_index == 0 {
                package_name
            } else {
                package_name
                    + raw.byte_slice(
                        identifiers.get(0).text.byte_len(),
                        raw.byte_len(),
                    )
            },
            Option::None => raw,
        }
    }
}

fn symbol_definitions(
    value: Analysis,
    qualified_name: string,
    short_name: string,
    allow_short_name: bool,
) -> Vec[DefinitionResult] {
    let exact_current = Vec::new();
    let exact_external = Vec::new();
    let relative_current = Vec::new();
    let relative_external = Vec::new();
    let short_current = Vec::new();
    let short_external = Vec::new();
    for symbol in build_symbol_index(value).symbols {
        let definition = DefinitionResult {
            source_path: symbol.source_path,
            span: symbol.span,
        };
        let current = symbol.package_name == value.package_name;
        let visible = current || symbol.public;
        if visible && symbol.qualified_name == qualified_name {
            if current {
                push_definition(exact_current, definition)
            } else {
                push_definition(exact_external, definition)
            }
        } else if visible && strings::ends_with(
            symbol.qualified_name,
            "::" + qualified_name,
        ) {
            if current {
                push_definition(relative_current, definition)
            } else {
                push_definition(relative_external, definition)
            }
        } else if visible
            && allow_short_name
            && symbol.name == short_name
        {
            if current {
                push_definition(short_current, definition)
            } else {
                push_definition(short_external, definition)
            }
        } else {
            ()
        }
    };
    if exact_current.len() > 0 {
        exact_current
    } else if exact_external.len() > 0 {
        exact_external
    } else if relative_current.len() > 0 {
        relative_current
    } else if relative_external.len() > 0 {
        relative_external
    } else if short_current.len() > 0 {
        short_current
    } else {
        short_external
    }
}

fn identifier_index_at(
    identifiers: Vec[SyntaxToken],
    offset: int,
) -> Option[int] {
    for distance in range(0, identifiers.len()) {
        let index = identifiers.len() - 1 - distance;
        let token = identifiers.get(index);
        if token.start <= offset && offset < token.end {
            return Option::Some(index)
        } else {
            ()
        }
    };
    Option::None
}

fn path_definitions(value: Analysis, offset: int) -> Vec[DefinitionResult] {
    let result = Vec::new();
    match path_node_at(value, offset) {
        Option::Some(node) => {
            let identifiers = node_identifiers(value, node);
            match identifier_index_at(identifiers, offset) {
                Option::Some(index) => {
                    let canonical = canonical_path_at(
                        value,
                        node,
                        identifiers,
                        index,
                    );
                    match longest_package_prefix(value, canonical) {
                        Option::Some(package_name) => if canonical
                            == package_name
                        {
                            match package_definition(value, package_name) {
                                Option::Some(definition) => {
                                    result.push(definition)
                                },
                                Option::None => (),
                            }
                        } else {
                            for definition in symbol_definitions(
                                value,
                                canonical,
                                identifiers.get(index).text,
                                false,
                            ) {
                                result.push(definition)
                            }
                        },
                        Option::None => for definition in symbol_definitions(
                            value,
                            canonical,
                            identifiers.get(index).text,
                            true,
                        ) {
                            result.push(definition)
                        },
                    }
                },
                Option::None => (),
            }
        },
        Option::None => (),
    };
    result
}

fn symbol_owner_matches(symbol: Symbol, owner: string) -> bool {
    let symbol_owner_name = symbol_owner(symbol.qualified_name);
    symbol_owner_name == owner
        || strings::ends_with(symbol_owner_name, "::" + owner)
        || short_type_name(symbol_owner_name) == short_type_name(owner)
}

fn member_definitions(value: Analysis, offset: int) -> Vec[DefinitionResult] {
    let exact = Vec::new();
    let fallback = Vec::new();
    match token_at(value.syntax, offset) {
        Option::Some(token) => if token.start > 0
            && value.source.byte_get(token.start - 1) == 46
        {
            match receiver_type(value, token.start - 1) {
                Option::Some(receiver) => {
                    let owner = type_owner_name(receiver);
                    for symbol in build_symbol_index(value).symbols {
                        if symbol.name == token.text
                            && match symbol.kind {
                                SymbolKind::Field | SymbolKind::Method => true,
                                _ => false,
                            }
                            && (symbol.package_name == value.package_name
                                || symbol.public)
                        {
                            let definition = DefinitionResult {
                                source_path: symbol.source_path,
                                span: symbol.span,
                            };
                            let owner_name = symbol_owner(
                                symbol.qualified_name,
                            );
                            if owner_name == owner
                                || strings::ends_with(
                                    owner_name,
                                    "::" + owner,
                                )
                            {
                                push_definition(exact, definition)
                            } else if symbol_owner_matches(symbol, owner) {
                                push_definition(fallback, definition)
                            } else {
                                ()
                            }
                        } else {
                            ()
                        }
                    }
                },
                Option::None => (),
            }
        } else {
            ()
        },
        Option::None => (),
    };
    if exact.len() > 0 { exact } else { fallback }
}

fn containing_struct_literal(
    value: Analysis,
    offset: int,
) -> Option[SyntaxNode] {
    node_at_kind(
        value.syntax,
        offset,
        cst::NodeKind::EXPR_STRUCT_LITERAL,
    )
}

fn struct_literal_owner(
    value: Analysis,
    literal: SyntaxNode,
) -> Option[string] {
    let best = Ref::new(-1);
    for candidate in range(0, value.syntax.nodes.len()) {
        let node = value.syntax.nodes.get(candidate);
        if cst::node_kind_equal(node.kind, cst::NodeKind::PATH)
            && node.start >= literal.start
            && node.end <= literal.end
            && (best.get() < 0
                || node.start < value.syntax.nodes.get(best.get()).start)
        {
            let identifiers = node_identifiers(value, node);
            if identifiers.len() > 0 {
                best.set(candidate)
            } else {
                ()
            }
        } else {
            ()
        }
    };
    if best.get() >= 0 {
        let node = value.syntax.nodes.get(best.get());
        let identifiers = node_identifiers(value, node);
        Option::Some(canonical_path_at(
            value,
            node,
            identifiers,
            identifiers.len() - 1,
        ))
    } else {
        Option::None
    }
}

fn struct_field_definitions(
    value: Analysis,
    offset: int,
) -> Vec[DefinitionResult] {
    let exact = Vec::new();
    let fallback = Vec::new();
    match token_at(value.syntax, offset) {
        Option::Some(token) => match containing_struct_literal(value, offset) {
            Option::Some(literal) => match struct_literal_owner(
                value,
                literal,
            ) {
                Option::Some(owner) => for symbol in build_symbol_index(
                    value,
                ).symbols {
                    if symbol.name == token.text
                        && match symbol.kind {
                            SymbolKind::Field => true,
                            _ => false,
                        }
                        && (symbol.package_name == value.package_name
                            || symbol.public)
                    {
                        let definition = DefinitionResult {
                            source_path: symbol.source_path,
                            span: symbol.span,
                        };
                        let owner_name = symbol_owner(
                            symbol.qualified_name,
                        );
                        if owner_name == owner
                            || strings::ends_with(
                                owner_name,
                                "::" + owner,
                            )
                        {
                            push_definition(exact, definition)
                        } else if symbol_owner_matches(symbol, owner) {
                            push_definition(fallback, definition)
                        } else {
                            ()
                        }
                    } else {
                        ()
                    }
                },
                Option::None => (),
            },
            Option::None => (),
        },
        Option::None => (),
    };
    if exact.len() > 0 { exact } else { fallback }
}

fn local_definition_span(
    value: Analysis,
    local: hir::LocalId,
) -> Option[DefinitionResult] {
    let facts = value.checked.typeck_results.locals;
    for distance in range(0, facts.len()) {
        let fact = facts.get(facts.len() - 1 - distance);
        if same_local(fact.local, local) {
            match fact.span {
                Option::Some(span) => match source_by_path(
                    value.sources,
                    fact.source_path,
                ) {
                    Option::Some(source) => {
                        let syntax = syntax_index(parser::parse(source.source).root);
                        let best = Ref::new(Option::None);
                        let width = Ref::new(2147483647);
                        for node in syntax.nodes {
                            let node_width = node.end - node.start;
                            if node.start <= span.start
                                && node.end >= span.end
                                && node_width < width.get()
                            {
                                for token in syntax.tokens {
                                    if token.start >= node.start
                                        && token.end <= node.end
                                        && token.text == local.hint
                                    {
                                        best.set(Option::Some(ast::span(
                                            token.start,
                                            token.end,
                                        )));
                                        width.set(node_width)
                                    } else {
                                        ()
                                    }
                                }
                            } else {
                                ()
                            }
                        };
                        match best.get() {
                            Option::Some(definition_span) => return Option::Some(
                                DefinitionResult {
                                    source_path: fact.source_path,
                                    span: definition_span,
                                },
                            ),
                            Option::None => (),
                        }
                    },
                    Option::None => (),
                },
                Option::None => (),
            }
        } else {
            ()
        }
    };
    Option::None
}

fn type_owner_name(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        tast::Type::Con { name } => name,
        tast::Type::App { ty, args: _ } => type_owner_name(ty),
        tast::Type::VecType { elem: _ } => "Vec",
        tast::Type::RefType { elem: _ } => "Ref",
        tast::Type::Slice { elem: _ } => "Slice",
        tast::Type::HashMap { key: _, value: _ } => "HashMap",
        tast::Type::Channel { elem: _ } => "Channel",
        other => tast::diagnostic_type_text(other),
    }
}

fn callable_name(value: tast::Callable) -> string {
    match value {
        tast::Callable::Function(name)
        | tast::Callable::Runtime(name)
        | tast::Callable::Intrinsic(name) => name,
        tast::Callable::TraitMethod { trait_ref, method_name } => {
            trait_ref.name + "::" + method_name
        },
        tast::Callable::DynTraitMethod {
            trait_name,
            dispatch_name: _,
            method_name,
        } => trait_name + "::" + method_name,
        tast::Callable::InherentMethod {
            receiver_ty,
            method_name,
        } => type_owner_name(receiver_ty) + "::" + method_name,
    }
}

fn token_text(value: Analysis, offset: int) -> Option[string] {
    match token_at(value.syntax, offset) {
        Option::Some(token) => Option::Some(token.text),
        Option::None => Option::None,
    }
}

fn target_symbol_name(
    value: Analysis,
    target: tast::ReferenceTarget,
    offset: int,
) -> Option[string] {
    match target {
        tast::ReferenceTarget::Local(_) => Option::None,
        tast::ReferenceTarget::Definition(_) => match token_text(value, offset) {
            Option::Some(name) => Option::Some(
                value.package_name + "::" + name,
            ),
            Option::None => Option::None,
        },
        tast::ReferenceTarget::Callable(callable) => {
            Option::Some(callable_name(callable))
        },
        tast::ReferenceTarget::Constructor(constructor) => {
            Option::Some(constructor.name)
        },
        tast::ReferenceTarget::Unresolved(_) => Option::None,
    }
}

fn semantic_definition(
    value: Analysis,
    offset: int,
) -> Option[DefinitionResult] {
    let reference = Ref::new(Option::None);
    let width = Ref::new(2147483647);
    for fact in value.checked.typeck_results.references {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path
            && fact.span.start <= offset
            && offset < fact.span.end
            && fact_width <= width.get()
        {
            reference.set(Option::Some(fact));
            width.set(fact_width)
        } else {
            ()
        }
    };
    match reference.get() {
        Option::Some(fact) => match fact.target {
            tast::ReferenceTarget::Local(local) => {
                local_definition_span(value, local)
            },
            target => match target_symbol_name(value, target, offset) {
                Option::Some(name) => match find_symbol(
                    build_symbol_index(value),
                    name,
                ) {
                    Option::Some(symbol) => Option::Some(DefinitionResult {
                        source_path: symbol.source_path,
                        span: symbol.span,
                    }),
                    Option::None => Option::None,
                },
                Option::None => Option::None,
            },
        },
        Option::None => Option::None,
    }
}

pub fn goto_definitions(
    value: Analysis,
    offset: int,
) -> Vec[DefinitionResult] {
    let result = Vec::new();
    let reference = Ref::new(Option::None);
    let width = Ref::new(2147483647);
    for fact in value.checked.typeck_results.references {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path
            && fact.span.start <= offset
            && offset < fact.span.end
            && fact_width <= width.get()
        {
            reference.set(Option::Some(fact));
            width.set(fact_width)
        } else {
            ()
        }
    };
    for definition in member_definitions(value, offset) {
        push_definition(result, definition)
    };
    if result.len() == 0 {
        for definition in struct_field_definitions(value, offset) {
            push_definition(result, definition)
        }
    } else {
        ()
    };
    match reference.get() {
        Option::Some(fact) => match fact.target {
            tast::ReferenceTarget::Local(_)
            | tast::ReferenceTarget::Constructor(_) => if result.len() == 0 {
                match semantic_definition(
                value,
                offset,
            ) {
                Option::Some(definition) => result.push(definition),
                Option::None => (),
                }
            } else {
                ()
            },
            _ => if result.len() == 0 {
                for definition in path_definitions(value, offset) {
                    push_definition(result, definition)
                }
            } else {
                ()
            },
        },
        Option::None => if result.len() == 0 {
            for definition in path_definitions(value, offset) {
                push_definition(result, definition)
            }
        } else {
            ()
        },
    };
    if result.len() == 0 {
        match semantic_definition(value, offset) {
            Option::Some(definition) => result.push(definition),
            Option::None => (),
        }
    } else {
        ()
    };
    result
}

pub fn goto_definition(
    value: Analysis,
    offset: int,
) -> Option[DefinitionResult] {
    let values = goto_definitions(value, offset);
    if values.len() == 0 {
        Option::None
    } else {
        Option::Some(values.get(0))
    }
}
