package query;

use module::ast;
use module::cst;
use module::hir;
use module::lexer;
use module::parser;
use module::tast;
use std::text;

pub struct DefinitionResult {
    pub source_path: string,
    pub span: ast::Span,
}

fn same_local(left: hir::LocalId, right: hir::LocalId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

fn source_by_path(sources: Vec[SourceFile], source_path: string) -> Option[SourceFile] {
    let mut index = sources.len() - 1;
    while index >= 0 {
        let source = sources[index];
        if source.path == source_path {
            return Option::Some(source)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn same_definition(left: DefinitionResult, right: DefinitionResult) -> bool {
    left.source_path == right.source_path && left.span.start == right.span.start
        && left.span.end == right.span.end
}

fn push_definition(values: Vec[DefinitionResult], value: DefinitionResult) -> unit {
    for existing in values {
        if same_definition(existing, value) {
            return
        } else {}
    }
    values.push(value)
}

fn package_definition(value: Analysis, package_name: string) -> Option[DefinitionResult] {
    let mut index = value.sources.len() - 1;
    while index >= 0 {
        let source = value.sources[index];
        if source.package_name == package_name {
            return Option::Some(
                DefinitionResult { source_path: source.path, span: ast::span(0, 0) },
            )
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn path_node_at(value: Analysis, offset: int) -> Option[SyntaxNode] {
    node_at_kind(value.syntax, offset, cst::NodeKind::PATH)
}

fn node_identifiers(value: Analysis, node: SyntaxNode) -> Vec[SyntaxToken] {
    let result: Vec[SyntaxToken] = Vec::from_array([]);
    let mut index = token_index_at_or_after(value.syntax, node.start);
    while index < value.syntax.tokens.len() && value.syntax.tokens[index].start < node.end {
        let token = value.syntax.tokens[index];
        if token.start >= node.start && token.end <= node.end
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::Ident) {
            result.push(token)
        } else {};
        index = index + 1;
    }
    result
}

fn path_prefix(values: Vec[SyntaxToken], end: int) -> string {
    let builder = text::StringBuilder::new();
    for index in 0..end + 1 {
        if index > 0 {
            builder.write_string("::")
        } else {};
        builder.write_string(values[index].text)
    }
    builder.finish()
}

fn containing_use(value: Analysis, node: SyntaxNode) -> bool {
    let mut current = node.parent;
    while current.is_some() {
        match current {
            Some(id) => {
                let parent = value.syntax.nodes[id];
                if cst::node_kind_equal(parent.kind, cst::NodeKind::USE) {
                    return true
                } else {
                    current = parent.parent;
                }
            },
            None => (),
        }
    }
    false
}

fn longest_package_prefix(value: Analysis, path_value: string) -> Option[string] {
    let mut result: Option[string] = Option::None;
    let mut length = 0;
    for source in value.sources {
        let package_name = source.package_name;
        if (path_value == package_name || path_value.starts_with(package_name + "::"))
            && package_name.byte_len() > length {
            result = Option::Some(package_name);
            length = package_name.byte_len();
        } else {}
    }
    result
}

fn canonical_path_at(
    value: Analysis,
    node: SyntaxNode,
    identifiers: Vec[SyntaxToken],
    token_index: int,
) -> string {
    let raw = path_prefix(identifiers, token_index);
    if containing_use(value, node) {
        expand_module_namespace(value.module_path, raw)
    } else {
        match namespace_target(value, identifiers[0].text) {
            Some(package_name) => if token_index == 0 {
                package_name
            } else {
                package_name + raw.byte_slice(identifiers[0].text.byte_len(), raw.byte_len())
            },
            None => raw,
        }
    }
}

fn symbol_definitions(
    value: Analysis,
    qualified_name: string,
    short_name: string,
    allow_short_name: bool,
) -> Vec[DefinitionResult] {
    let exact_current: Vec[DefinitionResult] = Vec::from_array([]);
    let exact_external: Vec[DefinitionResult] = Vec::from_array([]);
    let relative_current: Vec[DefinitionResult] = Vec::from_array([]);
    let relative_external: Vec[DefinitionResult] = Vec::from_array([]);
    let short_current: Vec[DefinitionResult] = Vec::from_array([]);
    let short_external: Vec[DefinitionResult] = Vec::from_array([]);
    for symbol in build_symbol_index(value).symbols {
        let definition = DefinitionResult { source_path: symbol.source_path, span: symbol.span };
        let current = symbol.package_name == value.package_name;
        let visible = current || symbol.public;
        if visible && symbol.qualified_name == qualified_name {
            if current {
                push_definition(exact_current, definition)
            } else {
                push_definition(exact_external, definition)
            }
        } else if visible && symbol.qualified_name.ends_with("::" + qualified_name) {
            if current {
                push_definition(relative_current, definition)
            } else {
                push_definition(relative_external, definition)
            }
        } else if visible && allow_short_name && symbol.name == short_name {
            if current {
                push_definition(short_current, definition)
            } else {
                push_definition(short_external, definition)
            }
        } else {}
    }
    if !exact_current.is_empty() {
        exact_current
    } else if !exact_external.is_empty() {
        exact_external
    } else if !relative_current.is_empty() {
        relative_current
    } else if !relative_external.is_empty() {
        relative_external
    } else if !short_current.is_empty() {
        short_current
    } else {
        short_external
    }
}

fn identifier_index_at(identifiers: Vec[SyntaxToken], offset: int) -> Option[int] {
    for distance in 0..identifiers.len() {
        let index = identifiers.len() - 1 - distance;
        let token = identifiers[index];
        if token.start <= offset && offset < token.end {
            return Option::Some(index)
        } else {}
    }
    Option::None
}

fn path_definitions(value: Analysis, offset: int) -> Vec[DefinitionResult] {
    let result: Vec[DefinitionResult] = Vec::from_array([]);
    match path_node_at(value, offset) {
        Some(node) => {
            let identifiers = node_identifiers(value, node);
            match identifier_index_at(identifiers, offset) {
                Some(index) => {
                    let canonical = canonical_path_at(value, node, identifiers, index);
                    match longest_package_prefix(value, canonical) {
                        Some(package_name) => if canonical == package_name {
                            match package_definition(value, package_name) {
                                Some(definition) => {
                                    result.push(definition)
                                },
                                None => (),
                            }
                        } else {
                            for definition in symbol_definitions(
                                value,
                                canonical,
                                identifiers[index].text,
                                false,
                            ) {
                                result.push(definition)
                            }
                        },
                        None => for definition in symbol_definitions(
                            value,
                            canonical,
                            identifiers[index].text,
                            true,
                        ) {
                            result.push(definition)
                        },
                    }
                },
                None => (),
            }
        },
        None => (),
    };
    result
}

fn symbol_owner_matches(symbol: Symbol, owner: string) -> bool {
    let symbol_owner_name = symbol_owner(symbol.qualified_name);
    symbol_owner_name == owner || symbol_owner_name.ends_with("::" + owner)
        || short_type_name(symbol_owner_name) == short_type_name(owner)
}

fn member_definitions(value: Analysis, offset: int) -> Vec[DefinitionResult] {
    let exact: Vec[DefinitionResult] = Vec::from_array([]);
    let fallback: Vec[DefinitionResult] = Vec::from_array([]);
    match token_at(value.syntax, offset) {
        Some(token) => if token.start > 0 && value.source.byte_get(token.start - 1) == b'.' {
            match receiver_type(value, token.start - 1) {
                Some(receiver) => {
                    let owner = type_owner_name(receiver);
                    for symbol in build_symbol_index(value).symbols {
                        if symbol.name == token.text
                            && match symbol.kind {
                                Field | Method => true,
                                _ => false,
                            }
                            && (symbol.package_name == value.package_name || symbol.public) {
                            let definition = DefinitionResult {
                                source_path: symbol.source_path,
                                span: symbol.span,
                            };
                            let owner_name = symbol_owner(symbol.qualified_name);
                            if owner_name == owner || owner_name.ends_with("::" + owner) {
                                push_definition(exact, definition)
                            } else if symbol_owner_matches(symbol, owner) {
                                push_definition(fallback, definition)
                            } else {}
                        } else {}
                    }
                },
                None => (),
            }
        } else {},
        None => (),
    };
    if !exact.is_empty() {
        exact
    } else {
        fallback
    }
}

fn containing_struct_literal(value: Analysis, offset: int) -> Option[SyntaxNode] {
    node_at_kind(value.syntax, offset, cst::NodeKind::EXPR_STRUCT_LITERAL)
}

fn struct_literal_owner(value: Analysis, literal: SyntaxNode) -> Option[string] {
    let mut best = -1;
    for candidate in 0..value.syntax.nodes.len() {
        let node = value.syntax.nodes[candidate];
        if cst::node_kind_equal(node.kind, cst::NodeKind::PATH) && node.start >= literal.start
            && node.end <= literal.end
            && (best < 0 || node.start < value.syntax.nodes[best].start) {
            let identifiers = node_identifiers(value, node);
            if !identifiers.is_empty() {
                best = candidate;
            } else {}
        } else {}
    }
    if best >= 0 {
        let node = value.syntax.nodes[best];
        let identifiers = node_identifiers(value, node);
        Option::Some(canonical_path_at(value, node, identifiers, identifiers.len() - 1))
    } else {
        Option::None
    }
}

fn struct_field_definitions(value: Analysis, offset: int) -> Vec[DefinitionResult] {
    let exact: Vec[DefinitionResult] = Vec::from_array([]);
    let fallback: Vec[DefinitionResult] = Vec::from_array([]);
    match token_at(value.syntax, offset) {
        Some(token) => match containing_struct_literal(value, offset) {
            Some(literal) => match struct_literal_owner(value, literal) {
                Some(owner) => for symbol in build_symbol_index(value).symbols {
                    if symbol.name == token.text
                        && match symbol.kind {
                            Field => true,
                            _ => false,
                        }
                        && (symbol.package_name == value.package_name || symbol.public) {
                        let definition = DefinitionResult {
                            source_path: symbol.source_path,
                            span: symbol.span,
                        };
                        let owner_name = symbol_owner(symbol.qualified_name);
                        if owner_name == owner || owner_name.ends_with("::" + owner) {
                            push_definition(exact, definition)
                        } else if symbol_owner_matches(symbol, owner) {
                            push_definition(fallback, definition)
                        } else {}
                    } else {}
                },
                None => (),
            },
            None => (),
        },
        None => (),
    };
    if !exact.is_empty() {
        exact
    } else {
        fallback
    }
}

fn local_name_token(syntax: SyntaxIndex, start: int, end: int, name: string) -> Option[SyntaxToken] {
    let mut index = token_index_at_or_after(syntax, start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < end {
        let token = syntax.tokens[index];
        if token.end <= end && token.text == name {
            return Option::Some(token)
        } else {
            index = index + 1;
        }
    }
    Option::None
}

fn local_definition_syntax(value: Analysis, fact: tast::LocalFact) -> Option[SyntaxIndex] {
    if fact.source_path == value.source_path {
        Option::Some(value.syntax)
    } else {
        match source_by_path(value.sources, fact.source_path) {
            Some(source) => Option::Some(syntax_index(parser::parse(source.source).root)),
            None => Option::None,
        }
    }
}

fn local_definition_span_from_fact(value: Analysis, fact: tast::LocalFact) -> Option[
    DefinitionResult,
] {
    let Some(span) = fact.span else {
        return Option::None
    };
    let Some(syntax) = local_definition_syntax(value, fact) else {
        return Option::None
    };
    match local_name_token(syntax, span.start, span.end, fact.local.hint) {
        Some(token) => Option::Some(
            DefinitionResult {
                source_path: fact.source_path,
                span: ast::span(token.start, token.end),
            },
        ),
        None => {
            let mut current = match token_at(syntax, span.start) {
                Some(token) => Option::Some(token.parent),
                None => Option::None,
            };
            while current.is_some() {
                match current {
                    Some(id) => {
                        let node = syntax.nodes[id];
                        if node.start <= span.start && node.end >= span.end {
                            match local_name_token(syntax, node.start, node.end, fact.local.hint) {
                                Some(token) => return Option::Some(
                                    DefinitionResult {
                                        source_path: fact.source_path,
                                        span: ast::span(token.start, token.end),
                                    },
                                ),
                                None => (),
                            }
                        } else {};
                        current = node.parent;
                    },
                    None => (),
                }
            }
            Option::None
        },
    }
}

fn local_definition_span(value: Analysis, local: hir::LocalId) -> Option[DefinitionResult] {
    let facts = value.checked.typeck_results.locals;
    for distance in 0..facts.len() {
        let fact = facts[facts.len() - 1 - distance];
        if same_local(fact.local, local) {
            match local_definition_span_from_fact(value, fact) {
                Some(definition) => return Option::Some(definition),
                None => (),
            }
        } else {}
    }
    Option::None
}

fn type_owner_name(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        Con { name } => name,
        App { ty, args: _ } => type_owner_name(ty),
        VecType { elem: _ } => "Vec",
        RefType { elem: _ } => "Ref",
        Slice { elem: _ } => "Slice",
        HashMap { key: _, value: _ } => "HashMap",
        Channel { elem: _, direction } => match direction {
            ast::ChannelDirection::Both => "Channel",
            ast::ChannelDirection::Send => "Sender",
            ast::ChannelDirection::Receive => "Receiver",
        },
        other => tast::diagnostic_type_text(other),
    }
}

fn callable_name(value: tast::Callable) -> string {
    match value {
        Intrinsic(name) => if name == "vec.from_array" {
            "builtin::Vec::from_array"
        } else if name == "hashmap.from_array" {
            "builtin::HashMap::from_array"
        } else {
            name
        },
        Function(name) | Runtime(name) => name,
        LangItem { item: _, function_name } => function_name,
        GoForeign { import_path: _, symbol } => symbol,
        TraitMethod { trait_ref, method_name, .. } => {
            trait_ref.name + "::" + method_name
        },
        DynTraitMethod { trait_name, dispatch_name: _, method_name } => trait_name + "::"
            + method_name,
        InherentMethod { receiver_ty, method_name } => type_owner_name(receiver_ty) + "::"
            + method_name,
    }
}

fn token_text(value: Analysis, offset: int) -> Option[string] {
    match token_at(value.syntax, offset) {
        Some(token) => Option::Some(token.text),
        None => Option::None,
    }
}

fn target_symbol_name(value: Analysis, target: tast::ReferenceTarget, offset: int) -> Option[string] {
    match target {
        Local(_) => Option::None,
        Definition(_) => match token_text(value, offset) {
            Some(name) => Option::Some(value.package_name + "::" + name),
            None => Option::None,
        },
        Callable(callable) => {
            Option::Some(callable_name(callable))
        },
        Constructor(constructor) => {
            Option::Some(constructor.name)
        },
        Unresolved(_) => Option::None,
    }
}

fn semantic_definition(value: Analysis, offset: int) -> Option[DefinitionResult] {
    let mut reference: Option[tast::ReferenceFact] = Option::None;
    let mut width = 2147483647;
    for fact in value.checked.typeck_results.references {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact.span.start <= offset
            && offset < fact.span.end
            && fact_width <= width {
            reference = Option::Some(fact);
            width = fact_width;
        } else {}
    }
    match reference {
        Some(fact) => match fact.target {
            Local(local) => {
                local_definition_span(value, local)
            },
            target => match target_symbol_name(value, target, offset) {
                Some(name) => match find_symbol(build_symbol_index(value), name) {
                    Some(symbol) => Option::Some(
                        DefinitionResult { source_path: symbol.source_path, span: symbol.span },
                    ),
                    None => Option::None,
                },
                None => Option::None,
            },
        },
        None => Option::None,
    }
}

pub fn goto_definitions(value: Analysis, offset: int) -> Vec[DefinitionResult] {
    let result: Vec[DefinitionResult] = Vec::from_array([]);
    for definition in comptime_derive_definitions(value, offset) {
        push_definition(result, definition)
    }
    if !result.is_empty() {
        return result
    } else {};
    let mut reference: Option[tast::ReferenceFact] = Option::None;
    let mut width = 2147483647;
    for fact in value.checked.typeck_results.references {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact.span.start <= offset
            && offset < fact.span.end
            && fact_width <= width {
            reference = Option::Some(fact);
            width = fact_width;
        } else {}
    }
    for definition in member_definitions(value, offset) {
        push_definition(result, definition)
    }
    if result.is_empty() {
        for definition in struct_field_definitions(value, offset) {
            push_definition(result, definition)
        }
    } else {};
    match reference {
        Some(fact) => match fact.target {
            Local(_) | Constructor(_) => if result.is_empty() {
                match semantic_definition(value, offset) {
                    Some(definition) => result.push(definition),
                    None => (),
                }
            } else {},
            _ => if result.is_empty() {
                for definition in path_definitions(value, offset) {
                    push_definition(result, definition)
                }
            } else {},
        },
        None => if result.is_empty() {
            for definition in path_definitions(value, offset) {
                push_definition(result, definition)
            }
        } else {},
    };
    if result.is_empty() {
        match semantic_definition(value, offset) {
            Some(definition) => result.push(definition),
            None => (),
        }
    } else {};
    result
}

pub fn goto_definition(value: Analysis, offset: int) -> Option[DefinitionResult] {
    let values = goto_definitions(value, offset);
    if values.is_empty() {
        Option::None
    } else {
        Option::Some(values[0])
    }
}
