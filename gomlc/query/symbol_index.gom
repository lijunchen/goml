package query;

use gomlc::ast;
use gomlc::cst;
use gomlc::lexer;
use gomlc::parser;
use gomlc::strings;

pub enum SymbolKind {
    Function,
    Struct,
    Enum,
    Trait,
    TypeAlias,
    Constant,
    Variant,
    Method,
    Field,
}

pub struct Symbol {
    pub name: string,
    pub qualified_name: string,
    pub package_name: string,
    pub source_path: string,
    pub span: ast::Span,
    pub kind: SymbolKind,
    pub public: bool,
}

pub struct SymbolIndex {
    pub symbols: Vec[Symbol],
}

fn token_is_inside_node(token: SyntaxToken, node: SyntaxNode) -> bool {
    token.start >= node.start && token.end <= node.end
}

fn first_identifier(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    for token in syntax.tokens {
        if token_is_inside_node(token, node)
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::Ident) {
            return Option::Some(token)
        } else {
            ()
        }
    };
    Option::None
}

fn type_node_kind(value: cst::NodeKind) -> bool {
    cst::node_kind_equal(value, cst::NodeKind::TYPE_UNIT)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_BOOL)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT8)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT16)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT32)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT64)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT8)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT16)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT32)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT64)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_FLOAT32)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_FLOAT64)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_STRING)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_CHAR)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_TUPLE)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_TAPP)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_DYN)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_ARRAY)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_FUNC)
}

fn first_type_name_token(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    for token in syntax.tokens {
        if token_is_inside_node(token, node) && !lexer::token_is_trivia(token.kind)
            && token.text.byte_len() > 0
            && ((token.text.byte_get(0) >= 65 && token.text.byte_get(0) <= 90)
                || (token.text.byte_get(0) >= 97 && token.text.byte_get(0) <= 122)
                || token.text.byte_get(0) == 95)
            && token.text != "dyn" {
            return Option::Some(token)
        } else {
            ()
        }
    };
    Option::None
}

fn owner_name_token(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    if cst::node_kind_equal(node.kind, cst::NodeKind::IMPL) {
        let index = Ref::new(syntax.nodes.len() - 1);
        while index.get() >= 0 {
            let candidate = syntax.nodes[index.get()];
            if match candidate.parent {
                Some(parent) => parent == node.id,
                None => false,
            }
                && type_node_kind(candidate.kind) {
                return first_type_name_token(syntax, candidate)
            } else {
                index.set(index.get() - 1)
            }
        };
        first_identifier(syntax, node)
    } else {
        first_identifier(syntax, node)
    }
}

fn symbol_kind(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SymbolKind] {
    if cst::node_kind_equal(node.kind, cst::NodeKind::FN) {
        match parent_with_kind(syntax, node, cst::NodeKind::IMPL, cst::NodeKind::TRAIT) {
            Some(_) => Option::Some(SymbolKind::Method),
            None => Option::Some(SymbolKind::Function),
        }
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::STRUCT) {
        Option::Some(SymbolKind::Struct)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::ENUM) {
        Option::Some(SymbolKind::Enum)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::TRAIT) {
        Option::Some(SymbolKind::Trait)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::TYPE_ALIAS) {
        Option::Some(SymbolKind::TypeAlias)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::CONST) {
        Option::Some(SymbolKind::Constant)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::VARIANT) {
        Option::Some(SymbolKind::Variant)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::TRAIT_METHOD_SIG) {
        Option::Some(SymbolKind::Method)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::STRUCT_FIELD) {
        Option::Some(SymbolKind::Field)
    } else {
        Option::None
    }
}

fn parent_with_kind(
    syntax: SyntaxIndex,
    node: SyntaxNode,
    first: cst::NodeKind,
    second: cst::NodeKind,
) -> Option[SyntaxNode] {
    let current = Ref::new(node.parent);
    while current.get().is_some() {
        match current.get() {
            Some(id) => {
                let parent = syntax.nodes[id];
                if cst::node_kind_equal(parent.kind, first)
                    || cst::node_kind_equal(parent.kind, second) {
                    return Option::Some(parent)
                } else {
                    current.set(parent.parent)
                }
            },
            None => (),
        }
    };
    Option::None
}

fn qualified_symbol_name(
    source: SourceFile,
    syntax: SyntaxIndex,
    node: SyntaxNode,
    name: string,
    kind: SymbolKind,
) -> string {
    let owner = match kind {
        Variant => parent_with_kind(syntax, node, cst::NodeKind::ENUM, cst::NodeKind::ENUM),
        Method => parent_with_kind(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::IMPL),
        Field => parent_with_kind(syntax, node, cst::NodeKind::STRUCT, cst::NodeKind::VARIANT),
        TypeAlias | Constant => Option::None,
        _ => Option::None,
    };
    match owner {
        Some(owner_node) => match owner_name_token(syntax, owner_node) {
            Some(owner_token) => {
                source.package_name + "::" + owner_token.text + "::" + name
            },
            None => source.package_name + "::" + name,
        },
        None => source.package_name + "::" + name,
    }
}

fn node_has_token(syntax: SyntaxIndex, node: SyntaxNode, kind: lexer::TokenKind) -> bool {
    for token in syntax.tokens {
        if token_is_inside_node(token, node) && lexer::token_kind_equal(token.kind, kind) {
            return true
        } else {
            ()
        }
    };
    false
}

fn owner_public(syntax: SyntaxIndex, node: SyntaxNode, first: cst::NodeKind, second: cst::NodeKind) -> bool {
    match parent_with_kind(syntax, node, first, second) {
        Some(owner) => node_has_token(syntax, owner, lexer::TokenKind::PubKeyword),
        None => false,
    }
}

fn symbol_public(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> bool {
    match kind {
        Variant => owner_public(syntax, node, cst::NodeKind::ENUM, cst::NodeKind::ENUM),
        Field => node_has_token(syntax, node, lexer::TokenKind::PubKeyword),
        Method => {
            node_has_token(syntax, node, lexer::TokenKind::PubKeyword)
                || owner_public(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::TRAIT)
        },
        _ => node_has_token(syntax, node, lexer::TokenKind::PubKeyword),
    }
}

fn index_source(source: SourceFile, symbols: Vec[Symbol]) -> unit {
    let parsed = parser::parse(source.source);
    let syntax = syntax_index(parsed.root);
    for node in syntax.nodes {
        match symbol_kind(syntax, node) {
            Some(kind) => match first_identifier(syntax, node) {
                Some(token) => symbols.push(
                    Symbol {
                        name: token.text,
                        qualified_name: qualified_symbol_name(
                            source,
                            syntax,
                            node,
                            token.text,
                            kind,
                        ),
                        package_name: source.package_name,
                        source_path: source.path,
                        span: ast::span(token.start, token.end),
                        kind,
                        public: source.package_name == "builtin"
                            || symbol_public(syntax, node, kind),
                    },
                ),
                None => (),
            },
            None => (),
        }
    }
}

pub fn build_symbol_index(value: Analysis) -> SymbolIndex {
    build_symbol_index_from_sources(value.sources)
}

pub fn build_symbol_index_from_sources(sources: Vec[SourceFile]) -> SymbolIndex {
    let symbols = Vec::new();
    for source in sources {
        index_source(source, symbols)
    };
    SymbolIndex { symbols }
}

fn symbol_name_ends_with(value: string, expected: string) -> bool {
    strings::ends_with(value, "::" + expected)
}

pub fn find_symbol(index: SymbolIndex, qualified_name: string) -> Option[Symbol] {
    for offset in range(0, index.symbols.len()) {
        let symbol = index.symbols[index.symbols.len() - 1 - offset];
        if symbol.qualified_name == qualified_name {
            return Option::Some(symbol)
        } else {
            ()
        }
    };
    let suffixes = Vec::new();
    for symbol in index.symbols {
        if symbol_name_ends_with(qualified_name, symbol.qualified_name)
            || symbol_name_ends_with(symbol.qualified_name, qualified_name) {
            suffixes.push(symbol)
        } else {
            ()
        }
    };
    if suffixes.len() == 1 {
        Option::Some(suffixes[0])
    } else {
        Option::None
    }
}
