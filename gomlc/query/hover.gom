package query;

use gomlc::ast;
use gomlc::strings;
use gomlc::tast;
use std::text;

pub struct HoverResult {
    pub contents: string,
    pub span: ast::Span,
}

fn fact_contains(span: ast::Span, offset: int) -> bool {
    span.start <= offset && offset < span.end
}

fn hover_text(value: tast::Type) -> Option[string] {
    match tast::resolve_type(value) {
        Error => Option::None,
        ty => Option::Some(tast::diagnostic_type_text(ty)),
    }
}

fn hover_function_text(generics: Vec[string], params: Vec[tast::Type], ret_ty: tast::Type) -> Option[
    string,
] {
    match hover_text(tast::Type::Func { params, ret_ty }) {
        Some(signature) => if generics.len() == 0 {
            Option::Some(signature)
        } else {
            let builder = text::StringBuilder::new();
            builder.write_char('[');
            let index = Ref::new(0);
            for generic in generics {
                if index.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                builder.write_string(short_type_name(generic));
                index.set(index.get() + 1)
            };
            builder.write_string("] ");
            builder.write_string(signature);
            Option::Some(builder.finish())
        },
        None => Option::None,
    }
}

fn hover_span(value: Analysis, span: ast::Span, offset: int) -> ast::Span {
    match token_at(value.syntax, offset) {
        Some(token) => if token.start >= span.start && token.end <= span.end {
            ast::span(token.start, token.end)
        } else {
            span
        },
        None => span,
    }
}

fn symbol_owner(value: string) -> string {
    match strings::rfind(value, "::") {
        Some(end) => value.byte_slice(0, end),
        None => "",
    }
}

fn method_owner(value: tast::MethodInfo) -> string {
    match value.trait_ref {
        Some(reference) => reference.name,
        None => type_owner_name(value.for_type),
    }
}

fn method_matches_symbol(value: tast::MethodInfo, symbol: Symbol) -> bool {
    let expected_owner = symbol_owner(symbol.qualified_name);
    let actual_owner = method_owner(value);
    (value.function.name == symbol.qualified_name
        || short_type_name(value.function.name) == symbol.name)
        && (actual_owner == expected_owner
            || short_type_name(actual_owner) == short_type_name(expected_owner))
}

fn symbol_hover_type(value: Analysis, symbol: Symbol) -> Option[string] {
    match symbol.kind {
        Function => {
            let environment_index = Ref::new(value.environments.len() - 1);
            while environment_index.get() >= 0 {
                let environment = value.environments[environment_index.get()];
                let function_index = Ref::new(environment.functions.len() - 1);
                while function_index.get() >= 0 {
                    let function = environment.functions[function_index.get()];
                    if function.name == symbol.qualified_name
                        || short_type_name(function.name) == symbol.name {
                        return hover_function_text(
                            function.generics,
                            function.params,
                            function.ret_ty,
                        )
                    } else {
                        function_index.set(function_index.get() - 1)
                    }
                };
                environment_index.set(environment_index.get() - 1)
            };
            Option::None
        },
        Method => {
            let environment_index = Ref::new(value.environments.len() - 1);
            while environment_index.get() >= 0 {
                let environment = value.environments[environment_index.get()];
                let method_index = Ref::new(environment.methods.len() - 1);
                while method_index.get() >= 0 {
                    let method = environment.methods[method_index.get()];
                    if method_matches_symbol(method, symbol) {
                        return hover_function_text(
                            method.method_generics,
                            method.function.params,
                            method.function.ret_ty,
                        )
                    } else {
                        method_index.set(method_index.get() - 1)
                    }
                };
                environment_index.set(environment_index.get() - 1)
            };
            Option::None
        },
        Field => {
            let owner = symbol_owner(symbol.qualified_name);
            let environment_index = Ref::new(value.environments.len() - 1);
            while environment_index.get() >= 0 {
                let environment = value.environments[environment_index.get()];
                let definition_index = Ref::new(environment.structs.len() - 1);
                while definition_index.get() >= 0 {
                    let definition = environment.structs[definition_index.get()];
                    if definition.name == owner
                        || short_type_name(definition.name) == short_type_name(owner) {
                        let field_index = Ref::new(definition.fields.len() - 1);
                        while field_index.get() >= 0 {
                            let field = definition.fields[field_index.get()];
                            if field.0 == symbol.name {
                                return hover_text(field.1)
                            } else {
                                field_index.set(field_index.get() - 1)
                            }
                        };
                        definition_index.set(definition_index.get() - 1)
                    } else {
                        definition_index.set(definition_index.get() - 1)
                    }
                };
                environment_index.set(environment_index.get() - 1)
            };
            Option::None
        },
        Variant => Option::Some(short_type_name(symbol_owner(symbol.qualified_name))),
        Constant => {
            let environment_index = Ref::new(value.environments.len() - 1);
            while environment_index.get() >= 0 {
                let environment = value.environments[environment_index.get()];
                let constant_index = Ref::new(environment.constants.len() - 1);
                while constant_index.get() >= 0 {
                    let constant = environment.constants[constant_index.get()];
                    if constant.name == symbol.qualified_name
                        || short_type_name(constant.name) == symbol.name {
                        return hover_text(constant.ty)
                    } else {
                        constant_index.set(constant_index.get() - 1)
                    }
                };
                environment_index.set(environment_index.get() - 1)
            };
            Option::None
        },
        TypeAlias => {
            let environment_index = Ref::new(value.environments.len() - 1);
            while environment_index.get() >= 0 {
                let environment = value.environments[environment_index.get()];
                let alias_index = Ref::new(environment.type_aliases.len() - 1);
                while alias_index.get() >= 0 {
                    let alias = environment.type_aliases[alias_index.get()];
                    if alias.name == symbol.qualified_name
                        || short_type_name(alias.name) == symbol.name {
                        return hover_text(alias.ty)
                    } else {
                        alias_index.set(alias_index.get() - 1)
                    }
                };
                environment_index.set(environment_index.get() - 1)
            };
            Option::None
        },
        Struct | Enum | Trait => {
            Option::Some(short_type_name(symbol.qualified_name))
        },
    }
}

fn symbol_at_offset(value: Analysis, offset: int) -> Option[Symbol] {
    let symbols = build_symbol_index(value).symbols;
    let index = Ref::new(symbols.len() - 1);
    while index.get() >= 0 {
        let symbol = symbols[index.get()];
        if symbol.source_path == value.source_path && symbol.span.start <= offset
            && offset < symbol.span.end {
            return Option::Some(symbol)
        } else {
            index.set(index.get() - 1)
        }
    };
    Option::None
}

pub fn hover(value: Analysis, offset: int) -> Option[HoverResult] {
    let result = Ref::new(Option::None);
    let width = Ref::new(2147483647);
    for fact in value.checked.typeck_results.references {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact_contains(fact.span, offset)
            && fact_width <= width.get() {
            match hover_text(fact.ty) {
                Some(contents) => {
                    result.set(
                        Option::Some(
                            HoverResult { contents, span: hover_span(value, fact.span, offset) },
                        ),
                    );
                    width.set(fact_width)
                },
                None => (),
            }
        } else {
            ()
        }
    };
    for fact in value.checked.typeck_results.exprs {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact_contains(fact.span, offset)
            && fact_width <= width.get() {
            match hover_text(fact.ty) {
                Some(contents) => {
                    result.set(
                        Option::Some(
                            HoverResult { contents, span: hover_span(value, fact.span, offset) },
                        ),
                    );
                    width.set(fact_width)
                },
                None => (),
            }
        } else {
            ()
        }
    };
    for fact in value.checked.typeck_results.pats {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact_contains(fact.span, offset)
            && fact_width < width.get() {
            match hover_text(fact.ty) {
                Some(contents) => {
                    result.set(
                        Option::Some(
                            HoverResult { contents, span: hover_span(value, fact.span, offset) },
                        ),
                    );
                    width.set(fact_width)
                },
                None => (),
            }
        } else {
            ()
        }
    };
    match result.get() {
        Some(result) => Option::Some(result),
        None => match symbol_at_offset(value, offset) {
            Some(symbol) => match symbol_hover_type(value, symbol) {
                Some(contents) => Option::Some(HoverResult { contents, span: symbol.span }),
                None => Option::None,
            },
            None => Option::None,
        },
    }
}
