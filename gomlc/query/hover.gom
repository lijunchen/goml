package query;

use module::ast;
use module::hir;
use module::tast;
use std::text;

pub struct HoverResult {
    pub contents: string,
    pub span: ast::Span,
}

fn fact_contains(span: ast::Span, offset: isize) -> bool {
    span.start <= offset && offset < span.end
}

fn hover_text(value: tast::Type) -> Option[string] {
    match tast::resolve_type(value) {
        Error => Option::None,
        ty => Option::Some(tast::diagnostic_type_text(ty)),
    }
}

fn hover_function_text(
    capability: tast::ComptimeCapability,
    generics: Vec[string],
    params: Vec[tast::Type],
    ret_ty: tast::Type,
) -> Option[string] {
    match hover_text(tast::Type::Func { params, ret_ty }) {
        Some(signature) => {
            let builder = text::StringBuilder::new();
            match capability {
                tast::ComptimeCapability::Capable => builder.write_string("comptime "),
                tast::ComptimeCapability::Derive => builder.write_string("comptime derive "),
                tast::ComptimeCapability::RuntimeOnly => (),
            };
            if !generics.is_empty() {
                builder.write_char('[');
                let mut index = 0;
                for generic in generics {
                    if index > 0 {
                        builder.write_string(", ")
                    } else {};
                    builder.write_string(short_type_name(generic));
                    index = index + 1;
                }
                builder.write_string("] ")
            } else {};
            builder.write_string(signature);
            Option::Some(builder.finish())
        },
        None => Option::None,
    }
}

fn hover_call_text(capability: tast::ComptimeCapability, ty: tast::Type) -> Option[string] {
    match hover_text(ty) {
        Some(signature) => match capability {
            tast::ComptimeCapability::Capable => Option::Some("comptime " + signature),
            tast::ComptimeCapability::Derive => Option::Some("comptime derive " + signature),
            tast::ComptimeCapability::RuntimeOnly => Option::Some(signature),
        },
        None => Option::None,
    }
}

fn hover_span(value: Analysis, span: ast::Span, offset: isize) -> ast::Span {
    match token_at(value.syntax, offset) {
        Some(token) => if token.start >= span.start && token.end <= span.end {
            ast::span(token.start, token.end)
        } else {
            span
        },
        None => span,
    }
}

fn symbol_owner(value: string) -> string {
    match text::rfind(value, "::") {
        Some(end) => value.byte_slice(0, end),
        None => "",
    }
}

fn method_owner(value: tast::MethodInfo) -> string {
    match value.trait_ref {
        Some(reference) => reference.name,
        None => type_owner_name(value.for_type),
    }
}

fn method_matches_symbol(value: tast::MethodInfo, symbol: Symbol) -> bool {
    let expected_owner = symbol_owner(symbol.qualified_name);
    let actual_owner = method_owner(value);
    (value.function.name == symbol.qualified_name
        || short_type_name(value.function.name) == symbol.name)
        && (actual_owner == expected_owner
            || short_type_name(actual_owner) == short_type_name(expected_owner))
}

fn function_hover_by_name(value: Analysis, name: string) -> Option[string] {
    let mut environment_index = value.environments.len() - 1;
    while environment_index >= 0 {
        let environment = value.environments[environment_index];
        let mut function_index = environment.functions.len() - 1;
        while function_index >= 0 {
            let function = environment.functions[function_index];
            if function.name == name || short_type_name(function.name) == short_type_name(name) {
                return hover_function_text(
                    function.comptime,
                    function.generics,
                    function.params,
                    function.ret_ty,
                )
            } else {
                function_index = function_index - 1;
            }
        }
        environment_index = environment_index - 1;
    }
    Option::None
}

fn function_hover_by_def(value: Analysis, expected: hir::DefId) -> Option[string] {
    for environment in value.environments {
        for function in environment.functions {
            match function.def_id {
                Some(actual) => if actual.pkg == expected.pkg && actual.index == expected.index {
                    return hover_function_text(
                        function.comptime,
                        function.generics,
                        function.params,
                        function.ret_ty,
                    )
                } else {},
                None => (),
            }
        }
    }
    Option::None
}

fn reference_hover_text(value: Analysis, target: tast::ReferenceTarget, ty: tast::Type) -> Option[
    string,
] {
    match target {
        tast::ReferenceTarget::Definition(id) => match function_hover_by_def(value, id) {
            Some(result) => Option::Some(result),
            None => hover_text(ty),
        },
        tast::ReferenceTarget::Callable(tast::Callable::Function(name)) => match function_hover_by_name(
            value,
            name,
        ) {
            Some(result) => Option::Some(result),
            None => hover_text(ty),
        },
        _ => hover_text(ty),
    }
}

fn symbol_hover_type(value: Analysis, symbol: Symbol) -> Option[string] {
    match symbol.kind {
        Function => function_hover_by_name(value, symbol.qualified_name),
        Method => {
            let mut environment_index = value.environments.len() - 1;
            while environment_index >= 0 {
                let environment = value.environments[environment_index];
                let mut method_index = environment.methods.len() - 1;
                while method_index >= 0 {
                    let method = environment.methods[method_index];
                    if method_matches_symbol(method, symbol) {
                        return hover_function_text(
                            tast::ComptimeCapability::RuntimeOnly,
                            method.method_generics,
                            method.function.params,
                            method.function.ret_ty,
                        )
                    } else {
                        method_index = method_index - 1;
                    }
                }
                environment_index = environment_index - 1;
            }
            Option::None
        },
        Field => {
            let owner = symbol_owner(symbol.qualified_name);
            let mut environment_index = value.environments.len() - 1;
            while environment_index >= 0 {
                let environment = value.environments[environment_index];
                let mut definition_index = environment.structs.len() - 1;
                while definition_index >= 0 {
                    let definition = environment.structs[definition_index];
                    if definition.name == owner
                        || short_type_name(definition.name) == short_type_name(owner) {
                        let mut field_index = definition.fields.len() - 1;
                        while field_index >= 0 {
                            let field = definition.fields[field_index];
                            if field.0 == symbol.name {
                                return hover_text(field.1)
                            } else {
                                field_index = field_index - 1;
                            }
                        }
                    } else {}
                    definition_index = definition_index - 1;
                }
                environment_index = environment_index - 1;
            }
            Option::None
        },
        Variant => Option::Some(short_type_name(symbol_owner(symbol.qualified_name))),
        Constant => {
            let mut environment_index = value.environments.len() - 1;
            while environment_index >= 0 {
                let environment = value.environments[environment_index];
                let mut constant_index = environment.constants.len() - 1;
                while constant_index >= 0 {
                    let constant = environment.constants[constant_index];
                    if constant.name == symbol.qualified_name
                        || short_type_name(constant.name) == symbol.name {
                        return hover_text(constant.ty)
                    } else {
                        constant_index = constant_index - 1;
                    }
                }
                environment_index = environment_index - 1;
            }
            Option::None
        },
        TypeAlias => {
            let mut environment_index = value.environments.len() - 1;
            while environment_index >= 0 {
                let environment = value.environments[environment_index];
                let mut alias_index = environment.type_aliases.len() - 1;
                while alias_index >= 0 {
                    let alias = environment.type_aliases[alias_index];
                    if alias.name == symbol.qualified_name
                        || short_type_name(alias.name) == symbol.name {
                        return hover_text(alias.ty)
                    } else {
                        alias_index = alias_index - 1;
                    }
                }
                environment_index = environment_index - 1;
            }
            Option::None
        },
        Struct | Enum | Trait => {
            Option::Some(short_type_name(symbol.qualified_name))
        },
    }
}

fn symbol_at_offset(value: Analysis, offset: isize) -> Option[Symbol] {
    let symbols = build_symbol_index(value).symbols;
    let mut index = symbols.len() - 1;
    while index >= 0 {
        let symbol = symbols[index];
        if symbol.source_path == value.source_path && symbol.span.start <= offset
            && offset < symbol.span.end {
            return Option::Some(symbol)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

pub fn hover(value: Analysis, offset: isize) -> Option[HoverResult] {
    match comptime_derive_hover(value, offset) {
        Some(contents) => match token_at(value.syntax, offset) {
            Some(token) => return Option::Some(
                HoverResult { contents, span: ast::span(token.start, token.end) },
            ),
            None => (),
        },
        None => (),
    };
    match symbol_at_offset(value, offset) {
        Some(symbol) => match symbol.kind {
            Function => match symbol_hover_type(value, symbol) {
                Some(contents) => {
                    return Option::Some(HoverResult { contents, span: symbol.span })
                },
                None => (),
            },
            _ => (),
        },
        None => (),
    };
    let mut result: Option[HoverResult] = Option::None;
    let mut width = 2147483647;
    for fact in value.checked.typeck_results.calls {
        let fact_width = fact.callee_span.end - fact.callee_span.start;
        if fact.source_path == value.source_path && fact_contains(fact.callee_span, offset)
            && fact_width <= width {
            match hover_call_text(fact.comptime, fact.callee_ty) {
                Some(contents) => {
                    result = Option::Some(
                        HoverResult { contents, span: hover_span(value, fact.callee_span, offset) },
                    );
                    width = fact_width;
                },
                None => (),
            }
        } else {}
    }
    for fact in value.checked.typeck_results.references {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact_contains(fact.span, offset)
            && fact_width < width {
            match reference_hover_text(value, fact.target, fact.ty) {
                Some(contents) => {
                    result = Option::Some(
                        HoverResult { contents, span: hover_span(value, fact.span, offset) },
                    );
                    width = fact_width;
                },
                None => (),
            }
        } else {}
    }
    for fact in value.checked.typeck_results.exprs {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact_contains(fact.span, offset)
            && fact_width < width {
            match hover_text(fact.ty) {
                Some(contents) => {
                    result = Option::Some(
                        HoverResult { contents, span: hover_span(value, fact.span, offset) },
                    );
                    width = fact_width;
                },
                None => (),
            }
        } else {}
    }
    for fact in value.checked.typeck_results.pats {
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact_contains(fact.span, offset)
            && fact_width < width {
            match hover_text(fact.ty) {
                Some(contents) => {
                    result = Option::Some(
                        HoverResult { contents, span: hover_span(value, fact.span, offset) },
                    );
                    width = fact_width;
                },
                None => (),
            }
        } else {}
    }
    match result {
        Some(result) => Option::Some(result),
        None => match symbol_at_offset(value, offset) {
            Some(symbol) => match symbol_hover_type(value, symbol) {
                Some(contents) => Option::Some(HoverResult { contents, span: symbol.span }),
                None => Option::None,
            },
            None => Option::None,
        },
    }
}
