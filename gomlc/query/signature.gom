package query;

use gomlc::ast;
use gomlc::parser;
use gomlc::tast;
use std::text;

pub struct SignatureResult {
    pub label: string,
    pub parameters: Vec[string],
    pub active_parameter: int,
    pub span: ast::Span,
}

fn call_target_name(
    value: Analysis,
    fact: tast::CallFact,
) -> string {
    match fact.target {
        Local(local) => local.hint,
        Definition(_) => match token_text(
            value,
            fact.callee_span.start,
        ) {
            Some(name) => name,
            None => "<function>",
        },
        Callable(callable) => callable_name(callable),
        Constructor(constructor) => constructor.name,
        Unresolved(name) => name,
    }
}

fn signature_label(
    parameters: Vec[string],
    return_type: string,
) -> string {
    let builder = text::StringBuilder::new();
    builder.write_char('(');
    let index = Ref::new(0);
    for parameter in parameters {
        if index.get() > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        builder.write_string(parameter);
        index.set(index.get() + 1)
    };
    builder.write_string(") -> ");
    builder.write_string(return_type);
    builder.finish()
}

fn method_call_target(value: tast::ReferenceTarget) -> bool {
    match value {
        Callable(
            TraitMethod { .. },
        )
        | Callable(
            DynTraitMethod { .. },
        )
        | Callable(
            InherentMethod { .. },
        ) => true,
        _ => false,
    }
}

fn function_parameter_names(value: ast::Function) -> Vec[string] {
    let result = Vec::new();
    for parameter in value.params {
        result.push(parameter.0)
    };
    result
}

fn extern_parameter_names(value: ast::ExternFunction) -> Vec[string] {
    let result = Vec::new();
    for parameter in value.params {
        result.push(parameter.0)
    };
    result
}

fn item_parameter_names(
    value: ast::Item,
    expected: string,
    expected_owner: Option[string],
) -> Option[Vec[string]] {
    match value {
        Function(function) => if function.name == expected {
            Option::Some(function_parameter_names(function))
        } else {
            Option::None
        },
        ExternFunction(function) => if function.name == expected {
            Option::Some(extern_parameter_names(function))
        } else {
            Option::None
        },
        ImplBlock(block) => {
            match expected_owner {
                Some(owner) => match explicit_type_name(block.for_type) {
                    Some(actual) => if short_type_name(actual)
                        != short_type_name(owner)
                    {
                        return Option::None
                    } else {
                        ()
                    },
                    None => return Option::None,
                },
                None => (),
            };
            let index = Ref::new(block.methods.len() - 1);
            while index.get() >= 0 {
                let method = block.methods.get(index.get());
                if method.name == expected {
                    return Option::Some(function_parameter_names(method))
                } else {
                    index.set(index.get() - 1)
                }
            };
            Option::None
        },
        TraitDef(definition) => {
            match expected_owner {
                Some(owner) => if short_type_name(definition.name)
                    != short_type_name(owner)
                {
                    return Option::None
                } else {
                    ()
                },
                None => (),
            };
            let index = Ref::new(definition.method_sigs.len() - 1);
            while index.get() >= 0 {
                let method = definition.method_sigs.get(index.get());
                if method.name == expected {
                    let names = Vec::new();
                    for parameter in method.params {
                        names.push(parameter.0)
                    };
                    return Option::Some(names)
                } else {
                    index.set(index.get() - 1)
                }
            };
            Option::None
        },
        _ => Option::None,
    }
}

fn signature_target_owner(value: tast::ReferenceTarget) -> Option[string] {
    match value {
        Callable(
            TraitMethod { trait_ref, method_name: _ },
        ) => Option::Some(trait_ref.name),
        Callable(
            DynTraitMethod {
                trait_name,
                dispatch_name: _,
                method_name: _,
            },
        ) => Option::Some(trait_name),
        Callable(
            InherentMethod {
                receiver_ty,
                method_name: _,
            },
        ) => Option::Some(type_owner_name(receiver_ty)),
        _ => Option::None,
    }
}

fn signature_parameter_names(
    value: Analysis,
    fact: tast::CallFact,
) -> Option[Vec[string]] {
    let expected = short_type_name(call_target_name(value, fact));
    let expected_owner = signature_target_owner(fact.target);
    let source_index = Ref::new(value.sources.len() - 1);
    while source_index.get() >= 0 {
        let source = value.sources.get(source_index.get());
        let lowered = ast::lower(parser::parse(source.source));
        match lowered.ast {
            Some(file) => {
                let item_index = Ref::new(file.items.len() - 1);
                while item_index.get() >= 0 {
                    match item_parameter_names(
                        file.items.get(item_index.get()),
                        expected,
                        expected_owner,
                    ) {
                        Some(names) => return Option::Some(names),
                        None => item_index.set(item_index.get() - 1),
                    }
                }
            },
            None => (),
        };
        source_index.set(source_index.get() - 1)
    };
    Option::None
}

fn signature_parameters(
    value: Analysis,
    fact: tast::CallFact,
    types: Vec[tast::Type],
) -> Vec[string] {
    let is_method = method_call_target(fact.target);
    let type_start = if is_method
        && types.len() > fact.argument_spans.len()
    {
        1
    } else {
        0
    };
    let names = signature_parameter_names(value, fact);
    let name_start = match names {
        Some(values) => if is_method
            && values.len() > fact.argument_spans.len()
        {
            1
        } else {
            0
        },
        None => 0,
    };
    let result = Vec::new();
    for index in range(type_start, types.len()) {
        let type_text = tast::diagnostic_type_text(types.get(index));
        let name = match names {
            Some(values) => {
                let name_index = index - type_start + name_start;
                if name_index < values.len() {
                    values.get(name_index)
                } else {
                    ""
                }
            },
            None => "",
        };
        result.push(if name == "" {
            type_text
        } else {
            name + ": " + type_text
        })
    };
    result
}

fn active_parameter(fact: tast::CallFact, offset: int) -> int {
    let active = Ref::new(0);
    let index = Ref::new(0);
    for span in fact.argument_spans {
        if offset > span.end {
            active.set(index.get() + 1)
        } else if offset >= span.start {
            active.set(index.get())
        } else {
            ()
        };
        index.set(index.get() + 1)
    };
    active.get()
}

pub fn signature_help(
    value: Analysis,
    offset: int,
) -> Option[SignatureResult] {
    let calls = value.checked.typeck_results.calls;
    let best = Ref::new(-1);
    for candidate in range(0, calls.len()) {
        let fact = calls.get(candidate);
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path
            && fact.span.start <= offset
            && offset < fact.span.end
            && (best.get() < 0
                || fact_width
                    <= calls.get(best.get()).span.end
                        - calls.get(best.get()).span.start)
        {
            best.set(candidate)
        } else {
            ()
        }
    };
    match if best.get() >= 0 {
        Option::Some(calls.get(best.get()))
    } else {
        Option::None
    } {
        Some(fact) => match tast::resolve_type(fact.callee_ty) {
            Func { params, ret_ty } => {
                let parameters = signature_parameters(value, fact, params);
                let return_type = tast::diagnostic_type_text(ret_ty);
                Option::Some(SignatureResult {
                    label: signature_label(
                        parameters,
                        return_type,
                    ),
                    parameters,
                    active_parameter: active_parameter(fact, offset),
                    span: fact.span,
                })
            },
            _ => Option::None,
        },
        None => Option::None,
    }
}
