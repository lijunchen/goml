package query;

use gomlc::ast;
use gomlc::parser;
use gomlc::tast;
use std::text;

pub struct SignatureResult {
    pub label: string,
    pub parameters: Vec[string],
    pub active_parameter: int,
    pub span: ast::Span,
}

fn call_target_name(value: Analysis, fact: tast::CallFact) -> string {
    match fact.target {
        Local(local) => local.hint,
        Definition(_) => match token_text(value, fact.callee_span.start) {
            Some(name) => name,
            None => "<function>",
        },
        Callable(callable) => callable_name(callable),
        Constructor(constructor) => constructor.name,
        Unresolved(name) => name,
    }
}

fn signature_label(parameters: Vec[string], return_type: string) -> string {
    let builder = text::StringBuilder::new();
    builder.write_char('(');
    let mut index = 0;
    for parameter in parameters {
        if index > 0 {
            builder.write_string(", ")
        } else {};
        builder.write_string(parameter);
        index = index + 1;
    }
    builder.write_string(") -> ");
    builder.write_string(return_type);
    builder.finish()
}

fn method_call_target(value: tast::ReferenceTarget) -> bool {
    match value {
        Callable(TraitMethod { .. },) | Callable(DynTraitMethod { .. },) | Callable(InherentMethod {
            ..,
        },) => true,
        _ => false,
    }
}

fn function_parameter_names(value: ast::Function) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for parameter in value.params {
        result.push(parameter.0)
    }
    result
}

fn extern_parameter_names(value: ast::ExternFunction) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for parameter in value.params {
        result.push(parameter.0)
    }
    result
}

fn item_parameter_names(value: ast::Item, expected: string, expected_owner: Option[string]) -> Option[
    Vec[string],
] {
    match value {
        Function(function) => if function.name == expected {
            Option::Some(function_parameter_names(function))
        } else {
            Option::None
        },
        ExternFunction(function) => if function.name == expected {
            Option::Some(extern_parameter_names(function))
        } else {
            Option::None
        },
        ImplBlock(block) => {
            match expected_owner {
                Some(owner) => match explicit_type_name(block.for_type) {
                    Some(actual) => if short_type_name(actual) != short_type_name(owner) {
                        return Option::None
                    } else {},
                    None => return Option::None,
                },
                None => (),
            };
            let mut index = block.methods.len() - 1;
            while index >= 0 {
                let method = block.methods[index];
                if method.name == expected {
                    return Option::Some(function_parameter_names(method))
                } else {
                    index = index - 1;
                }
            }
            Option::None
        },
        TraitDef(definition) => {
            match expected_owner {
                Some(owner) => if short_type_name(definition.name) != short_type_name(owner) {
                    return Option::None
                } else {},
                None => (),
            };
            let mut index = definition.method_sigs.len() - 1;
            while index >= 0 {
                let method = definition.method_sigs[index];
                if method.name == expected {
                    let names: Vec[string] = Vec::[];
                    for parameter in method.params {
                        names.push(parameter.0)
                    }
                    return Option::Some(names)
                } else {
                    index = index - 1;
                }
            }
            Option::None
        },
        _ => Option::None,
    }
}

fn signature_target_owner(value: tast::ReferenceTarget) -> Option[string] {
    match value {
        Callable(TraitMethod { trait_ref, .. },) => Option::Some(trait_ref.name),
        Callable(DynTraitMethod { trait_name, dispatch_name: _, method_name: _ },) => Option::Some(
            trait_name,
        ),
        Callable(InherentMethod { receiver_ty, method_name: _ },) => Option::Some(
            type_owner_name(receiver_ty),
        ),
        _ => Option::None,
    }
}

fn signature_parameter_names(value: Analysis, fact: tast::CallFact) -> Option[Vec[string]] {
    let expected = short_type_name(call_target_name(value, fact));
    let expected_owner = signature_target_owner(fact.target);
    let mut source_index = value.sources.len() - 1;
    while source_index >= 0 {
        let source = value.sources[source_index];
        let lowered = ast::lower(parser::parse(source.source));
        match lowered.ast {
            Some(file) => {
                let mut item_index = file.items.len() - 1;
                while item_index >= 0 {
                    match item_parameter_names(file.items[item_index], expected, expected_owner) {
                        Some(names) => return Option::Some(names),
                        None => {
                            item_index = item_index - 1;
                        },
                    }
                }
            },
            None => (),
        };
        source_index = source_index - 1;
    }
    Option::None
}

fn signature_parameters(value: Analysis, fact: tast::CallFact, types: Vec[tast::Type]) -> Vec[
    string,
] {
    let is_method = method_call_target(fact.target);
    let type_start = if is_method && types.len() > fact.argument_spans.len() {
        1
    } else {
        0
    };
    let names = signature_parameter_names(value, fact);
    let name_start = match names {
        Some(values) => if is_method && values.len() > fact.argument_spans.len() {
            1
        } else {
            0
        },
        None => 0,
    };
    let result: Vec[string] = Vec::[];
    for index in type_start..types.len() {
        let type_text = tast::diagnostic_type_text(types[index]);
        let name = match names {
            Some(values) => {
                let name_index = index - type_start + name_start;
                if name_index < values.len() {
                    values[name_index]
                } else {
                    ""
                }
            },
            None => "",
        };
        result.push(
            if name == "" {
                type_text
            } else {
                name + ": " + type_text
            },
        )
    }
    result
}

fn active_parameter(fact: tast::CallFact, offset: int) -> int {
    let mut active = 0;
    let mut index = 0;
    for span in fact.argument_spans {
        if offset > span.end {
            active = index + 1;
        } else if offset >= span.start {
            active = index;
        } else {};
        index = index + 1;
    }
    active
}

pub fn signature_help(value: Analysis, offset: int) -> Option[SignatureResult] {
    let calls = value.checked.typeck_results.calls;
    let mut best = -1;
    for candidate in 0..calls.len() {
        let fact = calls[candidate];
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact.span.start <= offset
            && offset < fact.span.end
            && (best < 0 || fact_width <= calls[best].span.end - calls[best].span.start) {
            best = candidate;
        } else {}
    }
    match if best >= 0 {
        Option::Some(calls[best])
    } else {
        Option::None
    } {
        Some(fact) => match tast::resolve_type(fact.callee_ty) {
            Func { params, ret_ty } => {
                let parameters = signature_parameters(value, fact, params);
                let return_type = tast::diagnostic_type_text(ret_ty);
                Option::Some(
                    SignatureResult {
                        label: signature_label(parameters, return_type),
                        parameters,
                        active_parameter: active_parameter(fact, offset),
                        span: fact.span,
                    },
                )
            },
            _ => Option::None,
        },
        None => Option::None,
    }
}
