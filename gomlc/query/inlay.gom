package query;

use gomlc::ast;
use gomlc::cst;
use gomlc::lexer;
use gomlc::tast;

pub struct InlayHint {
    pub position: int,
    pub label: string,
    pub span: ast::Span,
}

fn smallest_node_containing_span(syntax: SyntaxIndex, span: ast::Span, kind: cst::NodeKind) -> Option[
    SyntaxNode,
] {
    let mut best = -1;
    for candidate in 0..syntax.nodes.len() {
        let node = syntax.nodes[candidate];
        let node_width = node.end - node.start;
        if cst::node_kind_equal(node.kind, kind) && node.start <= span.start && node.end >= span.end
            && (best < 0 || node_width < syntax.nodes[best].end - syntax.nodes[best].start) {
            best = candidate;
        } else {
            ()
        }
    };
    if best >= 0 {
        Option::Some(syntax.nodes[best])
    } else {
        Option::None
    }
}

fn containing_let(syntax: SyntaxIndex, span: ast::Span) -> Option[SyntaxNode] {
    smallest_node_containing_span(syntax, span, cst::NodeKind::STMT_LET)
}

fn containing_closure_parameter(syntax: SyntaxIndex, span: ast::Span) -> Option[SyntaxNode] {
    smallest_node_containing_span(syntax, span, cst::NodeKind::CLOSURE_PARAM)
}

fn let_has_annotation(syntax: SyntaxIndex, statement: SyntaxNode) -> bool {
    for token in syntax.tokens {
        if token.parent == statement.id
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::Colon) {
            return true
        } else {
            ()
        }
    };
    false
}

pub fn inlay_hints(value: Analysis) -> Vec[InlayHint] {
    let hints: Vec[InlayHint] = Vec::[];
    for fact in value.checked.typeck_results.locals {
        if fact.source_path == value.source_path {
            match local_definition_span(value, fact.local) {
                Some(definition) => match containing_let(value.syntax, definition.span) {
                    Some(statement) => if let_has_annotation(value.syntax, statement) {
                        ()
                    } else {
                        match tast::resolve_type(fact.ty) {
                            Error => (),
                            ty => hints.push(
                                InlayHint {
                                    position: definition.span.end,
                                    label: ": " + tast::diagnostic_type_text(ty),
                                    span: definition.span,
                                },
                            ),
                        }
                    },
                    None => match containing_closure_parameter(value.syntax, definition.span) {
                        Some(parameter) => if let_has_annotation(value.syntax, parameter) {
                            ()
                        } else {
                            match tast::resolve_type(fact.ty) {
                                Error => (),
                                ty => hints.push(
                                    InlayHint {
                                        position: definition.span.end,
                                        label: ": " + tast::diagnostic_type_text(ty),
                                        span: definition.span,
                                    },
                                ),
                            }
                        },
                        None => (),
                    },
                },
                None => (),
            }
        } else {
            ()
        }
    };
    hints
}
