package query;

use gomlc::ast;
use gomlc::hir;
use gomlc::parser;
use gomlc::resources;

fn append_prelude_navigation_sources(values: Vec[SourceFile]) -> Result[unit, string] {
    for value in resources::prelude_sources()? {
        values.push(SourceFile { path: value.path, source: value.source, package_name: "prelude" })
    }
    Result::Ok(())
}

fn prelude_hir_files() -> Result[Vec[hir::File], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::[];
    for source in resources::prelude_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::[];
    for lowered in hir::lower_package_files(inputs, "prelude") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err("failed to lower prelude source " + lowered.source_path),
        }
    }
    Result::Ok(files)
}
