package query;

use gomlc::ast;
use gomlc::hir;
use gomlc::parser;
use gomlc::resources;

fn prelude_navigation_sources() -> Result[Vec[SourceFile], string] {
    let result: Vec[SourceFile] = Vec::from_array([]);
    for value in resources::prelude_sources()? {
        result.push(SourceFile { path: value.path, source: value.source, package_name: "prelude" })
    }
    Result::Ok(result)
}

fn prelude_hir_files() -> Result[Vec[hir::File], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array([]);
    for source in resources::prelude_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::from_array([]);
    for lowered in hir::lower_package_files(inputs, "prelude") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err("failed to lower prelude source " + lowered.source_path),
        }
    }
    Result::Ok(files)
}
