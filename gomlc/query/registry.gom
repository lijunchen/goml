package query;

use std::text;
use std::env;
use std::fs;
use std::path;

struct DependencyRequirement {
    name: string,
    version: string,
}

struct SemVersion {
    major: int,
    minor: int,
    patch: int,
}

struct ResolvedModule {
    name: string,
    version: string,
    root: string,
}

fn quoted_values(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    let mut start: Option[int] = Option::None;
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'"' {
            match start {
                Some(offset) => {
                    result.push(value.byte_slice(offset, index));
                    start = Option::None;
                },
                None => {
                    start = Option::Some(index + 1);
                },
            }
        } else {
            ()
        }
    };
    result
}

fn manifest_dependencies(source: string) -> Vec[DependencyRequirement] {
    let result: Vec[DependencyRequirement] = Vec::[];
    let mut cursor = 0;
    let mut in_dependencies = false;
    while cursor <= source.byte_len() {
        let mut end = cursor;
        while end < source.byte_len() && source.byte_get(end) != b'\n' {
            end = end + 1;
        };
        let line = trim_ascii(source.byte_slice(cursor, end));
        if line.starts_with("[") {
            in_dependencies = line == "[dependencies]";
        } else if in_dependencies {
            let values = quoted_values(line);
            if values.len() >= 2 {
                result.push(DependencyRequirement { name: values[0], version: values[1] })
            } else {
                ()
            }
        } else {
            ()
        };
        if end == source.byte_len() {
            cursor = source.byte_len() + 1;
        } else {
            cursor = end + 1;
        }
    };
    result
}

fn decimal_number(value: string) -> Option[int] {
    let length = value.byte_len();
    if length == 0 {
        Option::None
    } else {
        let mut result = 0;
        for index in 0..length {
            let byte = value.byte_get(index);
            if byte < b'0' || byte > b'9' {
                return Option::None
            } else {
                result = result * 10 + (byte - b'0') as int;
            }
        };
        Option::Some(result)
    }
}

fn parse_sem_version(value: string) -> Option[SemVersion] {
    let parts: Vec[string] = Vec::[];
    let mut start = 0;
    for index in 0..value.byte_len() + 1 {
        if index == value.byte_len() || value.byte_get(index) == b'.' {
            parts.push(value.byte_slice(start, index));
            start = index + 1;
        } else {
            ()
        }
    };
    if parts.len() != 3 {
        Option::None
    } else {
        match decimal_number(parts[0]) {
            Some(major) => match decimal_number(parts[1]) {
                Some(minor) => match decimal_number(parts[2]) {
                    Some(patch) => Option::Some(SemVersion { major, minor, patch }),
                    None => Option::None,
                },
                None => Option::None,
            },
            None => Option::None,
        }
    }
}

fn sem_version_less(left: SemVersion, right: SemVersion) -> bool {
    left.major < right.major
        || (left.major == right.major
            && (left.minor < right.minor || (left.minor == right.minor && left.patch < right.patch)))
}

fn sem_version_at_least(left: SemVersion, right: SemVersion) -> bool {
    !sem_version_less(left, right)
}

fn registry_home() -> Result[string, string] {
    match env::var("GOML_HOME") {
        Some(value) => if value != "" {
            Result::Ok(value)
        } else {
            Result::Err("GOML_HOME is empty")
        },
        None => match env::var("HOME") {
            Some(value) => if value != "" {
                Result::Ok(path::join(value, ".goml"))
            } else {
                Result::Err("HOME is empty")
            },
            None => match env::var("USERPROFILE") {
                Some(value) => if value != "" {
                    Result::Ok(path::join(value, ".goml"))
                } else {
                    Result::Err("USERPROFILE is empty")
                },
                None => {
                    Result::Err("failed to determine GoML home directory")
                },
            },
        },
    }
}

fn registry_root() -> Result[string, string] {
    match registry_home() {
        Ok(home) => Result::Ok(path::join(path::join(home, "cache"), "registry")),
        Err(error) => Result::Err(error),
    }
}

fn registry_versions(root: string, module_name: string) -> Result[Vec[string], string] {
    let index_path = path::join(root, "index.toml");
    let source = fs::read_file(index_path)?;
    let result: Vec[string] = Vec::[];
    let mut cursor = 0;
    let mut selected = false;
    while cursor <= source.byte_len() {
        let mut end = cursor;
        while end < source.byte_len() && source.byte_get(end) != b'\n' {
            end = end + 1;
        };
        let line = trim_ascii(source.byte_slice(cursor, end));
        if line.starts_with("[") {
            let names = quoted_values(line);
            selected = line.starts_with("[modules.") && !names.is_empty() && names[0] == module_name;
        } else if selected && line.starts_with("versions") {
            for version in quoted_values(line) {
                result.push(version)
            }
        } else {
            ()
        };
        if end == source.byte_len() {
            cursor = source.byte_len() + 1;
        } else {
            cursor = end + 1;
        }
    };
    if result.is_empty() {
        Result::Err("module " + module_name + " not found in registry index")
    } else {
        Result::Ok(result)
    }
}

fn select_registry_version(root: string, requirement: DependencyRequirement) -> Result[
    string,
    string,
] {
    let Some(minimum) = parse_sem_version(requirement.version) else {
        return Result::Err("invalid semver `" + requirement.version + "`")
    };
    let versions = registry_versions(root, requirement.name)?;
    let mut selected: Option[string] = Option::None;
    let mut selected_version: Option[SemVersion] = Option::None;
    for version in versions {
        match parse_sem_version(version) {
            Some(parsed) => if sem_version_at_least(parsed, minimum)
                && match selected_version {
                    Some(current) => sem_version_less(parsed, current),
                    None => true,
                } {
                selected = Option::Some(version);
                selected_version = Option::Some(parsed);
            } else {
                ()
            },
            None => return Result::Err("invalid registry semver `" + version + "`"),
        }
    };
    match selected {
        Some(version) => Result::Ok(version),
        None => Result::Err(
            "registry has no version for " + requirement.name + " satisfying >= "
                + requirement.version,
        ),
    }
}

fn module_segments(value: string) -> Option[(string, string)] {
    match text::find(value, "::") {
        Some(separator) => Option::Some(
            (value.byte_slice(0, separator), value.byte_slice(separator + 2, value.byte_len())),
        ),
        None => Option::None,
    }
}

fn module_directory(registry: string, module_name: string, version: string) -> Result[
    string,
    string,
] {
    match module_segments(module_name) {
        Some((owner, module)) => Result::Ok(
            path::join(path::join(path::join(registry, owner), module), version),
        ),
        None => Result::Err("invalid module coordinate `" + module_name + "`"),
    }
}

fn selected_module_index(values: Vec[ResolvedModule], name: string) -> Option[int] {
    let mut index = values.len() - 1;
    while index >= 0 {
        if values[index].name == name {
            return Option::Some(index)
        } else {
            index = index - 1;
        }
    };
    Option::None
}

fn resolve_external_modules_at(module_root: string, registry: string) -> Result[
    Vec[ResolvedModule],
    string,
] {
    let manifest = fs::read_file(path::join(module_root, "goml.toml"))?;
    let queue = manifest_dependencies(manifest);
    let mut cursor = 0;
    let selected: Vec[ResolvedModule] = Vec::[];
    while cursor < queue.len() {
        let requirement = queue[cursor];
        cursor = cursor + 1;
        let version = select_registry_version(registry, requirement)?;
        let Some(parsed) = parse_sem_version(version) else {
            return Result::Err("invalid registry semver `" + version + "`")
        };
        let update = match selected_module_index(selected, requirement.name) {
            Some(index) => match parse_sem_version(selected[index].version) {
                Some(current) => sem_version_less(current, parsed),
                None => true,
            },
            None => true,
        };
        if update {
            let root = module_directory(registry, requirement.name, version)?;
            let module_manifest = fs::read_file(path::join(root, "goml.toml"))?;
            match manifest_module_path(module_manifest) {
                Some(name) => if name != requirement.name {
                    return Result::Err(
                        "registry module " + requirement.name + " declares module path " + name,
                    )
                } else {
                    ()
                },
                None => return Result::Err(
                    "registry module " + requirement.name + " has no module path",
                ),
            };
            match selected_module_index(selected, requirement.name) {
                Some(index) => selected.set(
                    index,
                    ResolvedModule { name: requirement.name, version, root },
                ),
                None => selected.push(ResolvedModule { name: requirement.name, version, root }),
            };
            for dependency in manifest_dependencies(module_manifest) {
                queue.push(dependency)
            }
        } else {
            ()
        }
    };
    Result::Ok(selected)
}

fn resolve_external_modules(module_root: string) -> Result[Vec[ResolvedModule], string] {
    match registry_root() {
        Ok(registry) => resolve_external_modules_at(module_root, registry),
        Err(error) => Result::Err(error),
    }
}

fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}

fn external_package_directory(module: ResolvedModule, package_name: string) -> Option[string] {
    if package_name == module.name {
        Option::Some(module.root)
    } else if module_matches_package(module.name, package_name) {
        let suffix = package_name.byte_slice(module.name.byte_len() + 2, package_name.byte_len());
        let mut directory = module.root;
        let mut start = 0;
        for index in 0..suffix.byte_len() + 1 {
            let separator = index == suffix.byte_len()
                || (index + 1 < suffix.byte_len() && suffix.byte_get(index) == b':'
                    && suffix.byte_get(index + 1) == b':');
            if separator {
                directory = path::join(directory, suffix.byte_slice(start, index));
                start = index + 2;
            } else {
                ()
            }
        };
        Option::Some(directory)
    } else {
        Option::None
    }
}

fn external_package_sources(
    module_root: string,
    package_name: string,
    overrides: Vec[SourceOverride],
) -> Result[Vec[SourceFile], string] {
    let modules = resolve_external_modules(module_root)?;
    for module in modules {
        match external_package_directory(module, package_name) {
            Some(directory) => match collect_dependency_files(directory, overrides) {
                Ok(files) => return Result::Ok(source_files_with_package(files, package_name)),
                Err(error) => return Result::Err(error),
            },
            None => (),
        }
    };
    Result::Err("package " + package_name + " is not provided by a resolved dependency")
}

fn external_package_sources_at(
    registry: string,
    module_root: string,
    package_name: string,
    overrides: Vec[SourceOverride],
) -> Result[Vec[SourceFile], string] {
    let modules = resolve_external_modules_at(module_root, registry)?;
    for module in modules {
        match external_package_directory(module, package_name) {
            Some(directory) => match collect_dependency_files(directory, overrides) {
                Ok(files) => return Result::Ok(source_files_with_package(files, package_name)),
                Err(error) => return Result::Err(error),
            },
            None => (),
        }
    };
    Result::Err("package " + package_name + " is not provided by a resolved dependency")
}
