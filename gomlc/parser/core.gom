package parser;

use gomlc::cst;
use gomlc::lexer;

enum Event {
    Open {
        kind: cst::NodeKind,
        forward_parent: Option[int],
    },
    Close,
    Advance,
    Error {
        message: string,
        start: int,
        end: int,
    },
}

struct MarkerOpened {
    index: int,
}

struct MarkerClosed {
    index: int,
}

struct Parser {
    tokens: Vec[lexer::Token],
    source_len: int,
    cursor: Ref[int],
    fuel: Ref[int],
    events: Vec[Event],
    diagnostics: Vec[cst::Diagnostic],
    stuck_reported: Ref[bool],
    depth_limit_hit: Ref[bool],
    expr_depth: Ref[int],
    pattern_depth: Ref[int],
    type_depth: Ref[int],
    struct_literals_allowed: Ref[bool],
    contextual_blocks_allowed: Ref[bool],
    select_guard_depth: Ref[int],
}

fn event_tombstone() -> Event {
    Event::Open { kind: cst::NodeKind::TombStone, forward_parent: Option::None }
}

fn token_is(left: lexer::TokenKind, right: lexer::TokenKind) -> bool {
    lexer::token_kind_equal(left, right)
}

fn marker_is_none(value: Option[MarkerClosed]) -> bool {
    value.is_none()
}

fn input_peek_raw(parser: Parser) -> lexer::TokenKind {
    if parser.cursor.get() < parser.tokens.len() {
        parser.tokens[parser.cursor.get()].kind
    } else {
        lexer::TokenKind::Eof
    }
}

fn input_eat_trivia(parser: Parser) -> unit {
    while parser.cursor.get() < parser.tokens.len()
        && lexer::token_is_trivia(input_peek_raw(parser)) {
        parser.cursor.set(parser.cursor.get() + 1)
    }
}

fn input_eof(parser: Parser) -> bool {
    input_eat_trivia(parser);
    parser.cursor.get() == parser.tokens.len()
}

fn input_skip(parser: Parser) -> unit {
    if !input_eof(parser) {
        parser.cursor.set(parser.cursor.get() + 1)
    } else {}
}

fn input_peek(parser: Parser) -> lexer::TokenKind {
    input_eat_trivia(parser);
    input_peek_raw(parser)
}

fn input_nth(parser: Parser, offset: int) -> lexer::TokenKind {
    let mut index = parser.cursor.get();
    let mut remaining = offset;
    while index < parser.tokens.len() {
        let kind = parser.tokens[index].kind;
        if lexer::token_is_trivia(kind) {} else if remaining == 0 {
            return kind
        } else {
            remaining = remaining - 1;
        };
        index = index + 1;
    }
    lexer::TokenKind::Eof
}

fn input_nth_text(parser: Parser, offset: int) -> string {
    let mut index = parser.cursor.get();
    let mut remaining = offset;
    while index < parser.tokens.len() {
        let token = parser.tokens[index];
        if lexer::token_is_trivia(token.kind) {} else if remaining == 0 {
            return token.text
        } else {
            remaining = remaining - 1;
        };
        index = index + 1;
    }
    ""
}

fn input_current_text(parser: Parser) -> string {
    input_eat_trivia(parser);
    if parser.cursor.get() < parser.tokens.len() {
        parser.tokens[parser.cursor.get()].text
    } else {
        ""
    }
}

fn current_token_index(parser: Parser) -> Option[int] {
    let mut index = parser.cursor.get();
    while index < parser.tokens.len() && lexer::token_is_trivia(parser.tokens[index].kind) {
        index = index + 1;
    }
    if index < parser.tokens.len() {
        Option::Some(index)
    } else {
        Option::None
    }
}

fn current_range(parser: Parser) -> (int, int) {
    match current_token_index(parser) {
        Some(index) => {
            let token = parser.tokens[index];
            (token.start, token.end)
        },
        None => (parser.source_len, parser.source_len),
    }
}

fn current_lex_error(parser: Parser) -> Option[lexer::LexError] {
    match current_token_index(parser) {
        Some(index) => parser.tokens[index].error,
        None => Option::None,
    }
}

fn missing_range(parser: Parser) -> (int, int) {
    let current = match current_token_index(parser) {
        Some(index) => index,
        None => parser.tokens.len(),
    };
    let mut index = current - 1;
    while index >= 0 {
        let token = parser.tokens[index];
        if !lexer::token_is_trivia(token.kind) {
            return (token.end, token.end)
        } else {};
        index = index - 1;
    }
    match current_token_index(parser) {
        Some(index) => {
            let start = parser.tokens[index].start;
            (start, start)
        },
        None => (parser.source_len, parser.source_len),
    }
}

fn new_parser(tokens: Vec[lexer::Token], source_len: int) -> Parser {
    let event_capacity = tokens.len() * 2;
    Parser {
        tokens,
        source_len,
        cursor: Ref::new(0),
        fuel: Ref::new(256),
        events: Vec::with_capacity(event_capacity),
        diagnostics: Vec::from_array([]),
        stuck_reported: Ref::new(false),
        depth_limit_hit: Ref::new(false),
        expr_depth: Ref::new(0),
        pattern_depth: Ref::new(0),
        type_depth: Ref::new(0),
        struct_literals_allowed: Ref::new(true),
        contextual_blocks_allowed: Ref::new(true),
        select_guard_depth: Ref::new(-1),
    }
}

impl Parser {
    pub fn report_stuck(self: Parser) -> unit {
        if !self.stuck_reported.get() {
            let (start, end) = current_range(self);
            self.diagnostics.push(
                cst::diagnostic("parser did not consume input while parsing", start, end),
            );
            self.stuck_reported.set(true)
        } else {}
    }

    pub fn peek(self: Parser) -> lexer::TokenKind {
        if self.depth_limit_hit.get() {
            lexer::TokenKind::Eof
        } else if self.fuel.get() == 0 {
            self.report_stuck();
            lexer::TokenKind::Eof
        } else {
            self.fuel.set(self.fuel.get() - 1);
            input_peek(self)
        }
    }

    pub fn nth(self: Parser, offset: int) -> lexer::TokenKind {
        if self.depth_limit_hit.get() {
            lexer::TokenKind::Eof
        } else if self.fuel.get() == 0 {
            self.report_stuck();
            lexer::TokenKind::Eof
        } else {
            self.fuel.set(self.fuel.get() - 1);
            input_nth(self, offset)
        }
    }

    pub fn nth_text(self: Parser, offset: int) -> string {
        if self.depth_limit_hit.get() || self.fuel.get() == 0 {
            ""
        } else {
            self.fuel.set(self.fuel.get() - 1);
            input_nth_text(self, offset)
        }
    }

    pub fn eof(self: Parser) -> bool {
        self.depth_limit_hit.get() || input_eof(self)
    }

    pub fn at(self: Parser, kind: lexer::TokenKind) -> bool {
        lexer::token_kind_equal(self.peek(), kind)
    }

    pub fn at_contextual(self: Parser, expected: string) -> bool {
        self.at(lexer::TokenKind::Ident) && input_current_text(self) == expected
    }

    pub fn at_lower_ident(self: Parser) -> bool {
        if self.at(lexer::TokenKind::Ident) {
            let text_value = input_current_text(self);
            if text_value.byte_len() == 0 {
                false
            } else {
                let first = text_value.byte_get(0);
                (first >= b'a' && first <= b'z') || first == b'_'
            }
        } else {
            false
        }
    }

    pub fn at_upper_ident(self: Parser) -> bool {
        if self.at(lexer::TokenKind::Ident) {
            let text_value = input_current_text(self);
            if text_value.byte_len() == 0 {
                false
            } else {
                let first = text_value.byte_get(0);
                first >= b'A' && first <= b'Z'
            }
        } else {
            false
        }
    }

    pub fn expect_lower_ident(self: Parser, role: string) -> unit {
        if self.at_lower_ident() {
            self.advance()
        } else if self.at(lexer::TokenKind::Ident) {
            self.error(role + " must start with a lowercase letter or `_`");
            self.advance()
        } else {
            self.error("expected " + role)
        }
    }

    pub fn expect_upper_ident(self: Parser, role: string) -> unit {
        if self.at_upper_ident() {
            self.advance()
        } else if self.at(lexer::TokenKind::Ident) {
            self.error(role + " must start with an uppercase letter");
            self.advance()
        } else {
            self.error("expected " + role)
        }
    }

    pub fn eat(self: Parser, kind: lexer::TokenKind) -> bool {
        if self.at(kind) {
            self.advance();
            true
        } else {
            false
        }
    }

    pub fn expect(self: Parser, kind: lexer::TokenKind) -> unit {
        if self.depth_limit_hit.get() {} else if self.eat(kind) {} else {
            let actual = self.peek();
            let message = "expect \"" + lexer::token_kind_display(kind) + "\", actual \""
                + lexer::token_kind_display(actual)
                + "\"";
            if token_is(actual, lexer::TokenKind::Error) {
                self.advance_with_error(message)
            } else {
                self.missing(message)
            }
        }
    }

    pub fn advance(self: Parser) -> unit {
        match current_lex_error(self) {
            Some(value) => self.events.push(
                Event::Error { message: value.message, start: value.start, end: value.end },
            ),
            None => (),
        };
        self.fuel.set(256);
        input_skip(self);
        self.stuck_reported.set(false);
        self.events.push(Event::Advance)
    }

    pub fn error(self: Parser, message: string) -> unit {
        let (start, end) = current_range(self);
        self.events.push(Event::Error { message, start, end })
    }

    pub fn missing(self: Parser, message: string) -> unit {
        let (start, end) = missing_range(self);
        self.events.push(Event::Error { message, start, end })
    }

    pub fn error_after_current(self: Parser, message: string) -> unit {
        let (_, end) = current_range(self);
        self.events.push(Event::Error { message, start: end, end })
    }

    pub fn advance_with_error(self: Parser, message: string) -> unit {
        if self.depth_limit_hit.get() {} else {
            let marker = self.open();
            match current_lex_error(self) {
                Some(_) => (),
                None => {
                    let (start, end) = current_range(self);
                    self.events.push(Event::Error { message, start, end })
                },
            };
            self.advance();
            let _ = self.close(marker, cst::NodeKind::ErrorTree);
        }
    }

    pub fn open(self: Parser) -> MarkerOpened {
        let index = self.events.len();
        self.events.push(event_tombstone());
        MarkerOpened { index }
    }

    pub fn close(self: Parser, marker: MarkerOpened, kind: cst::NodeKind) -> MarkerClosed {
        self.events[marker.index] = Event::Open { kind, forward_parent: Option::None };
        self.events.push(Event::Close);
        MarkerClosed { index: marker.index }
    }

    pub fn enter_expr(self: Parser) -> bool {
        self.enter_depth(self.expr_depth, "expression is too deeply nested")
    }

    pub fn leave_expr(self: Parser) -> unit {
        self.expr_depth.set(self.expr_depth.get() - 1)
    }

    pub fn enter_select_guard(self: Parser) -> int {
        let previous = self.select_guard_depth.get();
        self.select_guard_depth.set(self.expr_depth.get() + 1);
        previous
    }

    pub fn leave_select_guard(self: Parser, previous: int) -> unit {
        self.select_guard_depth.set(previous)
    }

    pub fn at_select_guard_delimiter(self: Parser) -> bool {
        self.select_guard_depth.get() == self.expr_depth.get()
    }

    pub fn enter_pattern(self: Parser) -> bool {
        self.enter_depth(self.pattern_depth, "pattern is too deeply nested")
    }

    pub fn leave_pattern(self: Parser) -> unit {
        self.pattern_depth.set(self.pattern_depth.get() - 1)
    }

    pub fn enter_type(self: Parser) -> bool {
        self.enter_depth(self.type_depth, "type is too deeply nested")
    }

    pub fn leave_type(self: Parser) -> unit {
        self.type_depth.set(self.type_depth.get() - 1)
    }

    pub fn enter_depth(self: Parser, depth: Ref[int], message: string) -> bool {
        if depth.get() >= 512 {
            if !self.depth_limit_hit.get() {
                self.error(message);
                self.depth_limit_hit.set(true)
            } else {};
            false
        } else {
            depth.set(depth.get() + 1);
            true
        }
    }

    pub fn set_struct_literals_allowed(self: Parser, allowed: bool) -> bool {
        let previous = self.struct_literals_allowed.get();
        self.struct_literals_allowed.set(allowed);
        previous
    }

    pub fn set_contextual_blocks_allowed(self: Parser, allowed: bool) -> bool {
        let previous = self.contextual_blocks_allowed.get();
        self.contextual_blocks_allowed.set(allowed);
        previous
    }
}

impl MarkerClosed {
    pub fn precede(self: MarkerClosed, parser: Parser) -> MarkerOpened {
        let marker = parser.open();
        match parser.events[self.index] {
            Open { kind, forward_parent: _ } => parser.events.set(
                self.index,
                Event::Open { kind, forward_parent: Option::Some(marker.index - self.index) },
            ),
            _ => (),
        };
        marker
    }
}

impl MarkerOpened {
    pub fn completed(self: MarkerOpened, parser: Parser, kind: cst::NodeKind) -> MarkerClosed {
        parser.close(self, kind)
    }
}

fn element_byte_len(element: cst::CstElement) -> int {
    match element {
        Node(value) => value.byte_len,
        Token(value) => value.text.byte_len(),
    }
}

fn finish_node(stack: Vec[cst::CstNode], roots: Vec[cst::CstNode]) -> unit {
    match stack.pop() {
        Some(value) => {
            let mut byte_len = 0;
            for child in value.children {
                byte_len = byte_len + element_byte_len(child);
            }
            let complete = cst::node(value.kind, value.children, byte_len);
            if !stack.is_empty() {
                stack[stack.len() - 1].children.push(cst::CstElement::Node(complete))
            } else {
                roots.push(complete)
            }
        },
        None => (),
    }
}

fn push_token(stack: Vec[cst::CstNode], token: lexer::Token) -> unit {
    if !stack.is_empty() {
        stack[stack.len() - 1].children.push(cst::CstElement::Token(token))
    } else {}
}

fn event_open(event: Event) -> Option[(cst::NodeKind, Option[int])] {
    match event {
        Open { kind, forward_parent: parent } => Option::Some((kind, parent)),
        _ => Option::None,
    }
}

fn build_tree(parser: Parser) -> cst::ParseResult {
    let mut cursor = 0;
    let stack: Vec[cst::CstNode] = Vec::from_array([]);
    let roots: Vec[cst::CstNode] = Vec::from_array([]);
    let mut index = 0;
    while index < parser.events.len() {
        let event = parser.events[index];
        parser.events[index] = event_tombstone();
        match event {
            Open { kind, forward_parent } => {
                let kinds: Vec[cst::NodeKind] = Vec::from_array([]);
                kinds.push(kind);
                let mut event_index = index;
                let mut parent = forward_parent;
                loop {
                    match parent {
                        Some(distance) => {
                            event_index = event_index + distance;
                            let parent_event = parser.events[event_index];
                            parser.events[event_index] = event_tombstone();
                            match event_open(parent_event) {
                                Some((parent_kind, next)) => {
                                    kinds.push(parent_kind);
                                    parent = next;
                                },
                                None => break,
                            }
                        },
                        None => break,
                    }
                }
                let mut kind_index = kinds.len() - 1;
                while kind_index >= 0 {
                    let current = kinds[kind_index];
                    if !cst::node_kind_equal(current, cst::NodeKind::TombStone) {
                        stack.push(cst::node(current, Vec::from_array([]), 0))
                    } else {};
                    kind_index = kind_index - 1;
                }
            },
            Close => finish_node(stack, roots),
            Advance => {
                if cursor < parser.tokens.len() {
                    push_token(stack, parser.tokens[cursor]);
                    cursor = cursor + 1;
                } else {}
            },
            Error { message, start, end } => {
                parser.diagnostics.push(cst::diagnostic(message, start, end))
            },
        };
        while cursor < parser.tokens.len() && lexer::token_is_trivia(parser.tokens[cursor].kind) {
            push_token(stack, parser.tokens[cursor]);
            cursor = cursor + 1;
        }
        index = index + 1;
    }
    let root = if !roots.is_empty() {
        roots[0]
    } else {
        cst::node(cst::NodeKind::FILE, Vec::from_array([]), 0)
    };
    cst::parse_result(root, parser.diagnostics)
}

pub fn parse(source: string) -> cst::ParseResult {
    let parser = new_parser(lexer::lex(source), source.byte_len());
    parse_file(parser);
    build_tree(parser)
}
