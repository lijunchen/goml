package parser;

use gomlc::cst;
use std::testing;
use std::text;

fn append_source(node: cst::CstNode, builder: text::StringBuilder) -> unit {
    for child in cst::node_children(node) {
        match child {
            Node(inner) => append_source(inner, builder),
            Token(token) => builder.write_string(token.text),
        }
    }
}

fn count_nodes(node: cst::CstNode, kind: cst::NodeKind) -> int {
    let count = Ref::new(if cst::node_kind_equal(cst::node_kind(node), kind) { 1 } else { 0 });
    for child in cst::node_children(node) {
        match child {
            Node(inner) => count.set(count.get() + count_nodes(inner, kind)),
            Token(_) => (),
        }
    };
    count.get()
}

#[test]
fn parses_lossless_precedence_tree() -> unit {
    let source = "fn main() -> int32 {\n    1 + 2 * 3 // keep\n}\n";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert(cst::node_kind_equal(cst::node_kind(result.root), cst::NodeKind::FILE));
    testing::assert_eq(cst::node_byte_len(result.root), source.byte_len());
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BINARY), 2);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn reports_recoverable_syntax_errors() -> unit {
    let source = "fn main( { let value = ; } trailing";
    let result = parse(source);
    testing::assert(result.diagnostics.len() > 0);
    testing::assert(cst::node_kind_equal(cst::node_kind(result.root), cst::NodeKind::FILE));
    testing::assert_eq(cst::node_byte_len(result.root), source.byte_len())
}

#[test]
fn parses_control_flow_patterns_and_types() -> unit {
    let source = "fn map[T: Eq](value: T, f: (T) -> T) -> T where T: Hash { match value { item if true => f(item), _ => value } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::GENERIC_LIST), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::WHERE_CLAUSE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::TYPE_FUNC), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::MATCH_ARM), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::MATCH_ARM_GUARD), 1)
}

#[test]
fn parses_type_aliases_constants_and_byte_patterns() -> unit {
    let source = "pub type Pair[T] = (T, T); pub const marker: byte = b'\\x41'; fn classify(value: byte) -> bool { match value { b'A' => true, _ => false } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::TYPE_ALIAS), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::CONST), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BYTE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::PATTERN_BYTE), 1)
}

#[test]
fn parses_practical_expression_syntax() -> unit {
    let source = "fn main() -> unit { let a = Vec::[1, 2,]; let b = HashMap::{ \"x\" => 1, }; let c: Vec[int] = Vec::[]; let d = Vec::[int]::new(); let p = Point { x: 3, ..base, }; a[0] += 2; let text = f\"value={a.get(0)} {{ok}}\"; }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_VEC_LITERAL), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_HASHMAP_LITERAL), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::HASHMAP_LITERAL_ENTRY), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STRUCT_LITERAL_UPDATE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_INTERPOLATED_STRING), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::INTERPOLATED_STRING_EXPR), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STMT_ASSIGN), 1);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn recovers_legacy_extern_type_declarations() -> unit {
    let source = "extern \"go\" \"time\" \"Duration\" type Duration\nfn main() -> unit { () }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(
        result.diagnostics.get(0).message,
        "only `extern fn` declarations are supported",
    );
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::FN), 1)
}
