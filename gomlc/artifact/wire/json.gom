package wire;

use std::bytes;
use std::text;

pub enum ArtifactValue {
    Null,
    Bool(bool),
    Number(string),
    String(string),
    Array(Vec[ArtifactValue]),
    Object(Vec[(string, ArtifactValue)]),
}

enum ArtifactCapturedContainer {
    Object {
        fields: Vec[(string, ArtifactValue)],
        name: Ref[Option[string]],
    },
    Array(Vec[ArtifactValue]),
}

struct ArtifactBinaryValueScope {
    object: bool,
    count: Ref[int],
    count_offset: int,
}

pub struct ArtifactJsonWriter {
    builder: text::StringBuilder,
    pretty: bool,
    capture: bool,
    depth: Ref[int],
    object_scopes: Vec[bool],
    first_values: Vec[bool],
    after_name: Ref[bool],
    captured_containers: Vec[ArtifactCapturedContainer],
    captured_values: Vec[ArtifactValue],
    binary_mode: uint8,
    binary_seen: HashMap[string, unit],
    binary_strings: Vec[string],
    binary_writer: ArtifactBinaryWriter,
    binary_table: ArtifactBinaryStringTable,
    binary_scopes: Vec[ArtifactBinaryValueScope],
    binary_error: Ref[Option[string]],
}

pub fn new_artifact_json_writer(pretty: bool) -> ArtifactJsonWriter {
    ArtifactJsonWriter {
        builder: text::StringBuilder::new(),
        pretty,
        capture: false,
        depth: Ref::new(0),
        object_scopes: Vec::[],
        first_values: Vec::[],
        after_name: Ref::new(false),
        captured_containers: Vec::[],
        captured_values: Vec::[],
        binary_mode: 0,
        binary_seen: HashMap::{},
        binary_strings: Vec::[],
        binary_writer: new_artifact_binary_writer(),
        binary_table: empty_artifact_binary_string_table(),
        binary_scopes: Vec::[],
        binary_error: Ref::new(Option::None),
    }
}

pub fn new_artifact_value_writer() -> ArtifactJsonWriter {
    ArtifactJsonWriter {
        builder: text::StringBuilder::new(),
        pretty: false,
        capture: true,
        depth: Ref::new(0),
        object_scopes: Vec::[],
        first_values: Vec::[],
        after_name: Ref::new(false),
        captured_containers: Vec::[],
        captured_values: Vec::[],
        binary_mode: 1,
        binary_seen: HashMap::{},
        binary_strings: Vec::[],
        binary_writer: new_artifact_binary_writer(),
        binary_table: empty_artifact_binary_string_table(),
        binary_scopes: Vec::[],
        binary_error: Ref::new(Option::None),
    }
}

pub fn new_artifact_binary_string_collector() -> ArtifactJsonWriter {
    ArtifactJsonWriter {
        builder: text::StringBuilder::new(),
        pretty: false,
        capture: false,
        depth: Ref::new(0),
        object_scopes: Vec::[],
        first_values: Vec::[],
        after_name: Ref::new(false),
        captured_containers: Vec::[],
        captured_values: Vec::[],
        binary_mode: 2,
        binary_seen: HashMap::{},
        binary_strings: Vec::[],
        binary_writer: new_artifact_binary_writer(),
        binary_table: empty_artifact_binary_string_table(),
        binary_scopes: Vec::[],
        binary_error: Ref::new(Option::None),
    }
}

pub fn new_artifact_binary_value_stream(table: ArtifactBinaryStringTable) -> ArtifactJsonWriter {
    ArtifactJsonWriter {
        builder: text::StringBuilder::new(),
        pretty: false,
        capture: false,
        depth: Ref::new(0),
        object_scopes: Vec::[],
        first_values: Vec::[],
        after_name: Ref::new(false),
        captured_containers: Vec::[],
        captured_values: Vec::[],
        binary_mode: 3,
        binary_seen: HashMap::{},
        binary_strings: Vec::[],
        binary_writer: new_artifact_binary_writer(),
        binary_table: table,
        binary_scopes: Vec::[],
        binary_error: Ref::new(Option::None),
    }
}

fn artifact_binary_stream_before_value(value: ArtifactJsonWriter) -> unit {
    if value.binary_scopes.is_empty() {} else {
        let scope = value.binary_scopes[value.binary_scopes.len() - 1];
        if scope.object {} else {
            scope.count.set(scope.count.get() + 1)
        }
    }
}

fn artifact_binary_stream_error(value: ArtifactJsonWriter, result: Result[unit, string]) -> unit {
    match result {
        Ok(()) => (),
        Err(error) => value.binary_error.set(Option::Some(error)),
    }
}

fn artifact_binary_stream_begin_container(value: ArtifactJsonWriter, tag: uint8, object: bool) -> unit {
    artifact_binary_stream_before_value(value);
    artifact_binary_write_u8(value.binary_writer, tag);
    let offset = artifact_binary_writer_len(value.binary_writer);
    artifact_binary_write_u32(value.binary_writer, 0);
    value.binary_scopes.push(
        ArtifactBinaryValueScope { object, count: Ref::new(0), count_offset: offset },
    )
}

fn artifact_binary_stream_end_container(value: ArtifactJsonWriter) -> unit {
    let scope = value.binary_scopes.remove(value.binary_scopes.len() - 1);
    artifact_binary_stream_error(
        value,
        artifact_binary_patch_u32(
            value.binary_writer,
            scope.count_offset,
            scope.count.get().to_uint32(),
        ),
    )
}

pub fn artifact_binary_collected_string_table(value: ArtifactJsonWriter) -> ArtifactBinaryStringTable {
    artifact_binary_string_table_from_values(value.binary_strings)
}

pub fn artifact_binary_stream_finish(value: ArtifactJsonWriter) -> Result[bytes::Bytes, string] {
    match value.binary_error.get() {
        Some(error) => Result::Err(error),
        None => if value.binary_scopes.is_empty() {
            Result::Ok(artifact_binary_writer_finish(value.binary_writer))
        } else {
            Result::Err("unfinished binary artifact value")
        },
    }
}

fn artifact_captured_push(writer: ArtifactJsonWriter, value: ArtifactValue) -> unit {
    if writer.captured_containers.is_empty() {
        writer.captured_values.push(value)
    } else {
        match writer.captured_containers[writer.captured_containers.len() - 1] {
            Object { fields, name } => {
                match name.get() {
                    Some(name_value) => {
                        fields.push((name_value, value));
                        name.set(Option::None)
                    },
                    None => (),
                }
            },
            Array(values) => values.push(value),
        }
    }
}

pub fn artifact_value_finish(writer: ArtifactJsonWriter) -> Result[ArtifactValue, string] {
    if !writer.captured_containers.is_empty() {
        Result::Err("unfinished captured artifact value")
    } else if writer.captured_values.len() != 1 {
        Result::Err("captured artifact must contain one value")
    } else {
        Result::Ok(writer.captured_values[0])
    }
}

fn artifact_json_indent(value: ArtifactJsonWriter) -> unit {
    if value.pretty {
        for _ in 0..value.depth.get() {
            value.builder.write_string("  ")
        }
    } else {}
}

fn artifact_json_line(value: ArtifactJsonWriter) -> unit {
    if value.pretty {
        value.builder.write_char('\n');
        artifact_json_indent(value)
    } else {}
}

fn artifact_json_before_value(value: ArtifactJsonWriter) -> unit {
    if value.after_name.get() {
        value.after_name.set(false)
    } else if !value.first_values.is_empty() {
        let index = value.first_values.len() - 1;
        if value.first_values[index] {
            value.first_values[index] = false;
        } else {
            value.builder.write_char(',')
        };
        artifact_json_line(value)
    } else {}
}

fn artifact_json_write_hex(value: ArtifactJsonWriter, byte: uint8) -> unit {
    let digits = "0123456789abcdef";
    value.builder.write_char(digits.get((byte / 16).to_int()));
    value.builder.write_char(digits.get((byte % 16).to_int()))
}

fn artifact_json_write_string_body(value: ArtifactJsonWriter, input: string) -> unit {
    let mut start = 0;
    for index in 0..input.byte_len() {
        let byte = input.byte_get(index);
        if byte == b'"' || byte == b'\\' || byte == b'\b' || byte == b'\t' || byte == b'\n'
            || byte == b'\f'
            || byte == b'\r'
            || byte < b' ' {
            if start < index {
                value.builder.write_string(input.byte_slice(start, index))
            } else {};
            if byte == b'"' {
                value.builder.write_string("\\\"")
            } else if byte == b'\\' {
                value.builder.write_string("\\\\")
            } else if byte == b'\b' {
                value.builder.write_string("\\b")
            } else if byte == b'\t' {
                value.builder.write_string("\\t")
            } else if byte == b'\n' {
                value.builder.write_string("\\n")
            } else if byte == b'\f' {
                value.builder.write_string("\\f")
            } else if byte == b'\r' {
                value.builder.write_string("\\r")
            } else {
                value.builder.write_string("\\u00");
                artifact_json_write_hex(value, byte)
            };
            start = index + 1;
        } else {}
    }
    if start < input.byte_len() {
        value.builder.write_string(input.byte_slice(start, input.byte_len()))
    } else {}
}

fn artifact_json_write_quoted(value: ArtifactJsonWriter, input: string) -> unit {
    value.builder.write_char('"');
    artifact_json_write_string_body(value, input);
    value.builder.write_char('"')
}

pub fn artifact_json_begin_object(value: ArtifactJsonWriter) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_begin_container(value, 6, true)
    } else if value.capture {
        value.captured_containers.push(
            ArtifactCapturedContainer::Object { fields: Vec::[], name: Ref::new(Option::None) },
        )
    } else {
        artifact_json_before_value(value);
        value.builder.write_char('{');
        value.object_scopes.push(true);
        value.first_values.push(true);
        value.depth.set(value.depth.get() + 1)
    }
}

pub fn artifact_json_end_object(value: ArtifactJsonWriter) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_end_container(value)
    } else if value.capture {
        match value.captured_containers.remove(value.captured_containers.len() - 1) {
            Object { fields, .. } => {
                artifact_captured_push(value, ArtifactValue::Object(fields))
            },
            Array(_) => (),
        }
    } else {
        value.depth.set(value.depth.get() - 1);
        let first = value.first_values.remove(value.first_values.len() - 1);
        let _ = value.object_scopes.remove(value.object_scopes.len() - 1);
        if !first {
            artifact_json_line(value)
        } else {};
        value.builder.write_char('}')
    }
}

pub fn artifact_json_begin_array(value: ArtifactJsonWriter) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_begin_container(value, 5, false)
    } else if value.capture {
        value.captured_containers.push(ArtifactCapturedContainer::Array(Vec::[]))
    } else {
        artifact_json_before_value(value);
        value.builder.write_char('[');
        value.object_scopes.push(false);
        value.first_values.push(true);
        value.depth.set(value.depth.get() + 1)
    }
}

pub fn artifact_json_end_array(value: ArtifactJsonWriter) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_end_container(value)
    } else if value.capture {
        match value.captured_containers.remove(value.captured_containers.len() - 1) {
            Array(values) => {
                artifact_captured_push(value, ArtifactValue::Array(values))
            },
            Object { .. } => (),
        }
    } else {
        value.depth.set(value.depth.get() - 1);
        let first = value.first_values.remove(value.first_values.len() - 1);
        let _ = value.object_scopes.remove(value.object_scopes.len() - 1);
        if !first {
            artifact_json_line(value)
        } else {};
        value.builder.write_char(']')
    }
}

pub fn artifact_json_name(value: ArtifactJsonWriter, name: string) -> unit {
    if value.binary_mode == 2 {
        artifact_binary_collect_string(value.binary_seen, value.binary_strings, name)
    } else if value.binary_mode == 3 {
        let scope = value.binary_scopes[value.binary_scopes.len() - 1];
        scope.count.set(scope.count.get() + 1);
        artifact_binary_stream_error(
            value,
            artifact_binary_encode_string_id(value.binary_writer, value.binary_table, name),
        )
    } else if value.capture {
        match value.captured_containers[value.captured_containers.len() - 1] {
            Object { name: captured, .. } => {
                captured.set(Option::Some(name))
            },
            Array(_) => (),
        }
    } else {
        let index = value.first_values.len() - 1;
        if value.first_values[index] {
            value.first_values[index] = false;
        } else {
            value.builder.write_char(',')
        };
        artifact_json_line(value);
        artifact_json_write_quoted(value, name);
        if value.pretty {
            value.builder.write_string(": ")
        } else {
            value.builder.write_char(':')
        };
        value.after_name.set(true)
    }
}

pub fn artifact_json_string(value: ArtifactJsonWriter, input: string) -> unit {
    if value.binary_mode == 2 {
        artifact_binary_collect_string(value.binary_seen, value.binary_strings, input)
    } else if value.binary_mode == 3 {
        artifact_binary_stream_before_value(value);
        artifact_binary_write_u8(value.binary_writer, 4);
        artifact_binary_stream_error(
            value,
            artifact_binary_encode_string_id(value.binary_writer, value.binary_table, input),
        )
    } else if value.capture {
        artifact_captured_push(value, ArtifactValue::String(input))
    } else {
        artifact_json_before_value(value);
        artifact_json_write_quoted(value, input)
    }
}

pub fn artifact_json_number(value: ArtifactJsonWriter, input: string) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_before_value(value);
        artifact_binary_write_u8(value.binary_writer, 3);
        artifact_binary_write_string(value.binary_writer, input)
    } else if value.capture {
        artifact_captured_push(value, ArtifactValue::Number(input))
    } else {
        artifact_json_before_value(value);
        value.builder.write_string(input)
    }
}

pub fn artifact_json_bool(value: ArtifactJsonWriter, input: bool) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_before_value(value);
        artifact_binary_write_u8(
            value.binary_writer,
            if input {
                2
            } else {
                1
            },
        )
    } else if value.capture {
        artifact_captured_push(value, ArtifactValue::Bool(input))
    } else {
        artifact_json_before_value(value);
        value.builder.write_string(
            if input {
                "true"
            } else {
                "false"
            },
        )
    }
}

pub fn artifact_json_null(value: ArtifactJsonWriter) -> unit {
    if value.binary_mode == 2 {} else if value.binary_mode == 3 {
        artifact_binary_stream_before_value(value);
        artifact_binary_write_u8(value.binary_writer, 0)
    } else if value.capture {
        artifact_captured_push(value, ArtifactValue::Null)
    } else {
        artifact_json_before_value(value);
        value.builder.write_string("null")
    }
}

pub fn artifact_json_binary_mode(value: ArtifactJsonWriter) -> uint8 {
    value.binary_mode
}

pub fn artifact_json_finish(value: ArtifactJsonWriter) -> string {
    value.builder.finish()
}
