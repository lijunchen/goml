package wire;

use std::bytes;
use std::testing;

fn artifact_binary_test_bytes(values: Vec[uint8]) -> bytes::Bytes {
    bytes::Bytes::from_vec(values)
}

fn artifact_binary_expect_ok[T: PartialEq + Debug](value: Result[T, string], expected: T) -> unit {
    match value {
        Ok(actual) => testing::assert_eq(actual, expected),
        Err(error) => testing::fail(error),
    }
}

fn artifact_binary_expect_unit(value: Result[unit, string]) -> unit {
    match value {
        Ok(()) => (),
        Err(error) => testing::fail(error),
    }
}

fn artifact_binary_expect_err[T](value: Result[T, string]) -> unit {
    match value {
        Ok(_) => testing::fail("expected binary artifact error"),
        Err(_) => (),
    }
}

#[test]
fn binary_artifact_round_trips_fixed_width_values() -> unit {
    let writer = new_artifact_binary_writer();
    artifact_binary_write_u8(writer, 255);
    artifact_binary_write_u16(writer, 65535);
    artifact_binary_write_u32(writer, 4294967295);
    artifact_binary_write_u64(writer, 18446744073709551615);
    artifact_binary_write_bool(writer, true);
    artifact_binary_write_bool(writer, false);
    artifact_binary_write_string(writer, "GoML λ");
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    artifact_binary_expect_ok(artifact_binary_read_u8(reader), 255);
    artifact_binary_expect_ok(artifact_binary_read_u16(reader), 65535);
    artifact_binary_expect_ok(artifact_binary_read_u32(reader), 4294967295);
    artifact_binary_expect_ok(artifact_binary_read_u64(reader), 18446744073709551615);
    artifact_binary_expect_ok(artifact_binary_read_bool(reader), true);
    artifact_binary_expect_ok(artifact_binary_read_bool(reader), false);
    artifact_binary_expect_ok(artifact_binary_read_string(reader), "GoML λ");
    testing::assert_eq(artifact_binary_reader_remaining(reader), 0)
}

#[test]
fn binary_artifact_round_trips_varints() -> unit {
    let unsigned: Vec[uint64] = Vec::new();
    unsigned.push(0);
    unsigned.push(1);
    unsigned.push(127);
    unsigned.push(128);
    unsigned.push(255);
    unsigned.push(256);
    unsigned.push(4294967295);
    unsigned.push(~(0.to_uint64()));
    let signed: Vec[int64] = Vec::new();
    signed.push(-9223372036854775807 - 1);
    signed.push(-2147483648);
    signed.push(-1);
    signed.push(0);
    signed.push(1);
    signed.push(2147483647);
    signed.push(9223372036854775807);
    let writer = new_artifact_binary_writer();
    for value in unsigned {
        artifact_binary_write_uleb128(writer, value)
    }
    for value in signed {
        artifact_binary_write_zigzag(writer, value)
    }
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    for value in unsigned {
        artifact_binary_expect_ok(artifact_binary_read_uleb128(reader), value)
    }
    for value in signed {
        artifact_binary_expect_ok(artifact_binary_read_zigzag(reader), value)
    }
    testing::assert_eq(artifact_binary_reader_remaining(reader), 0)
}

#[test]
fn binary_artifact_patches_offsets() -> unit {
    let writer = new_artifact_binary_writer();
    artifact_binary_write_u32(writer, 0);
    artifact_binary_write_u64(writer, 0);
    artifact_binary_expect_unit(artifact_binary_patch_u32(writer, 0, 305419896));
    artifact_binary_expect_unit(artifact_binary_patch_u64(writer, 4, 81985529216486895));
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    artifact_binary_expect_ok(artifact_binary_read_u32(reader), 305419896);
    artifact_binary_expect_ok(artifact_binary_read_u64(reader), 81985529216486895)
}

#[test]
fn binary_artifact_rejects_invalid_input() -> unit {
    let truncated = new_artifact_binary_reader(artifact_binary_test_bytes(Vec::[1, 2, 3]));
    artifact_binary_expect_err(artifact_binary_read_u32(truncated));
    let overflow_values = Vec::new();
    for _ in range(0, 10) {
        overflow_values.push(255)
    }
    let overflow = new_artifact_binary_reader(artifact_binary_test_bytes(overflow_values));
    artifact_binary_expect_err(artifact_binary_read_uleb128(overflow));
    let invalid_bool = new_artifact_binary_reader(artifact_binary_test_bytes(Vec::[2]));
    artifact_binary_expect_err(artifact_binary_read_bool(invalid_bool));
    let invalid_utf8 = new_artifact_binary_reader(artifact_binary_test_bytes(Vec::[1, 255]));
    artifact_binary_expect_err(artifact_binary_read_string(invalid_utf8));
    let invalid_length = new_artifact_binary_reader(artifact_binary_test_bytes(Vec::[4, 1]));
    artifact_binary_expect_err(artifact_binary_read_bytes(invalid_length))
}
