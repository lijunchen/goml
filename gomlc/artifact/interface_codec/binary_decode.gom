package interface_codec;

use gomlc::artifact::wire as wire;
use gomlc::artifact;
use gomlc::artifact::tast_codec as tast_codec;
use gomlc::tast;
use std::bytes;

struct ArtifactInterfaceBinaryReader {
    pub reader: wire::ArtifactBinaryReader,
    pub table: wire::ArtifactBinaryStringTable,
}

fn new_artifact_interface_binary_reader(data: bytes::Bytes, table: wire::ArtifactBinaryStringTable) -> ArtifactInterfaceBinaryReader {
    ArtifactInterfaceBinaryReader { reader: wire::new_artifact_binary_reader(data), table }
}

fn artifact_interface_binary_error(expected: string) -> string {
    wire::artifact_decode_error(expected)
}

fn artifact_interface_binary_read_tag(reader: ArtifactInterfaceBinaryReader) -> Result[
    uint8,
    string,
] {
    wire::artifact_binary_read_u8(reader.reader)
}

fn artifact_interface_binary_expect_tag(
    reader: ArtifactInterfaceBinaryReader,
    expected_tag: uint8,
    expected: string,
) -> Result[unit, string] {
    match artifact_interface_binary_read_tag(reader) {
        Ok(value) => if value == expected_tag {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error(expected))
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_read_count(
    reader: ArtifactInterfaceBinaryReader,
    tag: uint8,
    expected: string,
) -> Result[int, string] {
    artifact_interface_binary_expect_tag(reader, tag, expected)?;
    let count = wire::artifact_binary_read_u32(reader.reader)? as int;
    if count > 10000000 {
        Result::Err(artifact_interface_binary_error(expected))
    } else {
        Result::Ok(count)
    }
}

fn artifact_interface_binary_object(
    reader: ArtifactInterfaceBinaryReader,
    expected_count: int,
    expected: string,
) -> Result[unit, string] {
    match artifact_interface_binary_read_count(reader, 6, expected) {
        Ok(value) => if value == expected_count {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error(expected))
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_array(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    int,
    string,
] {
    artifact_interface_binary_read_count(reader, 5, expected)
}

fn artifact_interface_binary_field(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    unit,
    string,
] {
    match wire::artifact_binary_decode_string_id(reader.reader, reader.table) {
        Ok(value) => if value == expected {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error("field " + expected))
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_string(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    string,
    string,
] {
    match artifact_interface_binary_expect_tag(reader, 4, expected) {
        Ok(()) => wire::artifact_binary_decode_string_id(reader.reader, reader.table),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_number(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    string,
    string,
] {
    match artifact_interface_binary_expect_tag(reader, 3, expected) {
        Ok(()) => wire::artifact_binary_read_string(reader.reader),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_bool(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    bool,
    string,
] {
    match artifact_interface_binary_read_tag(reader) {
        Ok(1) => Result::Ok(false),
        Ok(2) => Result::Ok(true),
        Ok(_) => Result::Err(artifact_interface_binary_error(expected)),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_named_string(
    reader: ArtifactInterfaceBinaryReader,
    field: string,
    expected: string,
) -> Result[string, string] {
    artifact_interface_binary_object(reader, 1, expected)?;
    match artifact_interface_binary_field(reader, field) {
        Ok(()) => artifact_interface_binary_string(reader, expected),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_string_array(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    Vec[string],
    string,
] {
    let count = artifact_interface_binary_array(reader, expected)?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(artifact_interface_binary_string(reader, expected)?)
    }
    Result::Ok(result)
}

fn artifact_interface_binary_type_array(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    expected: string,
) -> Result[Vec[tast::Type], string] {
    let count = artifact_interface_binary_array(reader, expected)?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(artifact_interface_binary_type(reader, context)?)
    }
    Result::Ok(result)
}

fn artifact_interface_binary_trait_ref(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[tast::TraitRef, string] {
    artifact_interface_binary_object(reader, 2, "trait reference")?;
    artifact_interface_binary_field(reader, "name")?;
    let name = artifact_interface_binary_string(reader, "trait name")?;
    artifact_interface_binary_field(reader, "args")?;
    let args = artifact_interface_binary_type_array(reader, context, "trait arguments")?;
    Result::Ok(tast::TraitRef { name, args })
}

fn artifact_interface_binary_optional_trait_ref(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Option[tast::TraitRef], string] {
    let offset = wire::artifact_binary_reader_offset(reader.reader);
    let tag = artifact_interface_binary_read_tag(reader)?;
    if tag == 0 {
        Result::Ok(Option::None)
    } else {
        wire::artifact_binary_reader_set_offset(reader.reader, offset);
        match artifact_interface_binary_trait_ref(reader, context) {
            Ok(value) => Result::Ok(Option::Some(value)),
            Err(error) => Result::Err(error),
        }
    }
}

fn artifact_interface_binary_element_type(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    expected: string,
) -> Result[tast::Type, string] {
    artifact_interface_binary_object(reader, 1, expected)?;
    match artifact_interface_binary_field(reader, "elem") {
        Ok(()) => artifact_interface_binary_type(reader, context),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_simple_type(name: string) -> Result[tast::Type, string] {
    match name {
        "TUnit" => Result::Ok(tast::Type::Unit),
        "TNever" => Result::Ok(tast::Type::Never),
        "TBool" => Result::Ok(tast::Type::Bool),
        "TInt" => Result::Ok(tast::Type::Int),
        "TInt8" => Result::Ok(tast::Type::Int8),
        "TInt16" => Result::Ok(tast::Type::Int16),
        "TInt32" => Result::Ok(tast::Type::Int32),
        "TInt64" => Result::Ok(tast::Type::Int64),
        "TUint" => Result::Ok(tast::Type::Uint),
        "TUint8" => Result::Ok(tast::Type::Uint8),
        "TUint16" => Result::Ok(tast::Type::Uint16),
        "TUint32" => Result::Ok(tast::Type::Uint32),
        "TUint64" => Result::Ok(tast::Type::Uint64),
        "TFloat32" => Result::Ok(tast::Type::Float32),
        "TFloat64" => Result::Ok(tast::Type::Float64),
        "TString" => Result::Ok(tast::Type::String),
        "TChar" => Result::Ok(tast::Type::Char),
        _ => Result::Err(artifact_interface_binary_error("type")),
    }
}

fn artifact_interface_binary_type(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[tast::Type, string] {
    let tag = artifact_interface_binary_read_tag(reader)?;
    if tag == 4 {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        return artifact_interface_binary_simple_type(name)
    } else if tag != 6 {
        return Result::Err(artifact_interface_binary_error("type"))
    } else {};
    let count = wire::artifact_binary_read_u32(reader.reader)?;
    if count != 1 {
        return Result::Err(artifact_interface_binary_error("type variant"))
    } else {};
    let kind = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
    if kind == "TEnum" || kind == "TStruct" {
        let name = artifact_interface_binary_named_string(reader, "name", "named type")?;
        if kind == "TEnum" {
            tast_codec::artifact_add_type_name(context.enum_names, name)
        } else {
            tast_codec::artifact_add_type_name(context.struct_names, name)
        };
        Result::Ok(tast::Type::Con { name })
    } else if kind == "TDyn" {
        let decoded = artifact_interface_binary_dyn_bound(reader, context)?;
        Result::Ok(
            tast::Type::Dyn {
                trait_name: decoded.0.trait_name,
                args: decoded.0.args,
                associated_types: decoded.0.associated_types,
                additional_bounds: decoded.1,
            },
        )
    } else if kind == "TParam" {
        match artifact_interface_binary_named_string(reader, "name", "type parameter") {
            Ok(value) => Result::Ok(tast::Type::Param { name: value }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TTuple" {
        artifact_interface_binary_object(reader, 1, "tuple type")?;
        artifact_interface_binary_field(reader, "typs")?;
        match artifact_interface_binary_type_array(reader, context, "tuple elements") {
            Ok(value) => Result::Ok(tast::Type::Tuple { items: value }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TProjection" {
        artifact_interface_binary_object(reader, 3, "projection type")?;
        artifact_interface_binary_field(reader, "trait_ref")?;
        let trait_ref = artifact_interface_binary_optional_trait_ref(reader, context)?;
        artifact_interface_binary_field(reader, "for_ty")?;
        let for_ty = artifact_interface_binary_type(reader, context)?;
        artifact_interface_binary_field(reader, "name")?;
        match artifact_interface_binary_string(reader, "projection name") {
            Ok(name) => Result::Ok(tast::Type::Projection { for_ty, name, trait_ref }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TApp" {
        artifact_interface_binary_object(reader, 2, "type application")?;
        artifact_interface_binary_field(reader, "ty")?;
        let ty = artifact_interface_binary_type(reader, context)?;
        artifact_interface_binary_field(reader, "args")?;
        match artifact_interface_binary_type_array(reader, context, "type arguments") {
            Ok(args) => Result::Ok(tast::Type::App { ty, args }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TArray" {
        artifact_interface_binary_object(reader, 2, "array type")?;
        artifact_interface_binary_field(reader, "len")?;
        let number = artifact_interface_binary_number(reader, "array length")?;
        let len = if number == "18446744073709551615" {
            -1
        } else {
            wire::artifact_parse_nonnegative_int(number)?
        };
        artifact_interface_binary_field(reader, "elem")?;
        match artifact_interface_binary_type(reader, context) {
            Ok(elem) => Result::Ok(tast::Type::Array { len, elem }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TSlice" || kind == "TVec" || kind == "TRef" || kind == "TChannel" {
        let elem = artifact_interface_binary_element_type(reader, context, "element type")?;
        if kind == "TSlice" {
            Result::Ok(tast::Type::Slice { elem })
        } else if kind == "TVec" {
            Result::Ok(tast::Type::VecType { elem })
        } else if kind == "TRef" {
            Result::Ok(tast::Type::RefType { elem })
        } else {
            Result::Ok(tast::Type::Channel { elem })
        }
    } else if kind == "THashMap" {
        artifact_interface_binary_object(reader, 2, "hash map type")?;
        artifact_interface_binary_field(reader, "key")?;
        let key = artifact_interface_binary_type(reader, context)?;
        artifact_interface_binary_field(reader, "value")?;
        let value = artifact_interface_binary_type(reader, context)?;
        Result::Ok(tast::Type::HashMap { key, value })
    } else if kind == "TFunc" {
        artifact_interface_binary_object(reader, 2, "function type")?;
        artifact_interface_binary_field(reader, "params")?;
        let params = artifact_interface_binary_type_array(reader, context, "function parameters")?;
        artifact_interface_binary_field(reader, "ret_ty")?;
        let ret_ty = artifact_interface_binary_type(reader, context)?;
        Result::Ok(tast::Type::Func { params, ret_ty })
    } else {
        Result::Err(artifact_interface_binary_error("supported type variant"))
    }
}

fn artifact_interface_binary_trait_refs(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[tast::TraitRef], string] {
    let count = artifact_interface_binary_array(reader, "trait references")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(artifact_interface_binary_trait_ref(reader, context)?)
    }
    Result::Ok(result)
}

fn artifact_interface_binary_predicate(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[tast::TypePredicate, string] {
    artifact_interface_binary_object(reader, 1, "type predicate")?;
    let kind = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
    artifact_interface_binary_object(reader, 2, "type predicate payload")?;
    if kind == "Trait" {
        artifact_interface_binary_field(reader, "for_ty")?;
        let for_ty = artifact_interface_binary_type(reader, context)?;
        artifact_interface_binary_field(reader, "trait_ref")?;
        let trait_ref = artifact_interface_binary_trait_ref(reader, context)?;
        Result::Ok(tast::TypePredicate::Trait { for_ty, trait_ref })
    } else if kind == "Equality" {
        artifact_interface_binary_field(reader, "lhs")?;
        let lhs = artifact_interface_binary_type(reader, context)?;
        artifact_interface_binary_field(reader, "rhs")?;
        let rhs = artifact_interface_binary_type(reader, context)?;
        Result::Ok(tast::TypePredicate::Equality { lhs, rhs })
    } else {
        Result::Err(artifact_interface_binary_error("supported type predicate"))
    }
}

fn artifact_interface_binary_predicates(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[tast::TypePredicate], string] {
    let count = artifact_interface_binary_array(reader, "type predicates")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        result.push(artifact_interface_binary_predicate(reader, context)?)
    }
    Result::Ok(result)
}

fn artifact_interface_binary_type_pairs(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    expected: string,
) -> Result[Vec[(string, tast::Type)], string] {
    let count = artifact_interface_binary_array(reader, expected)?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let pair_count = artifact_interface_binary_array(reader, expected)?;
        if pair_count != 2 {
            return Result::Err(artifact_interface_binary_error(expected))
        } else {};
        let name = artifact_interface_binary_string(reader, expected)?;
        result.push((name, artifact_interface_binary_type(reader, context)?))
    }
    Result::Ok(result)
}

fn artifact_interface_binary_dyn_bound(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[(tast::DynTraitBound, Vec[tast::DynTraitBound]), string] {
    artifact_interface_binary_object(reader, 4, "dyn bound")?;
    artifact_interface_binary_field(reader, "trait_name")?;
    let trait_name = artifact_interface_binary_string(reader, "dyn trait name")?;
    artifact_interface_binary_field(reader, "args")?;
    let args = artifact_interface_binary_type_array(reader, context, "dyn arguments")?;
    artifact_interface_binary_field(reader, "associated_types")?;
    let associated_types = artifact_interface_binary_type_pairs(
        reader,
        context,
        "dyn associated type bindings",
    )?;
    artifact_interface_binary_field(reader, "additional_bounds")?;
    let count = artifact_interface_binary_array(reader, "additional dyn bounds")?;
    let additional_bounds = Vec::with_capacity(count);
    for _ in 0..count {
        let decoded = artifact_interface_binary_dyn_bound(reader, context)?;
        additional_bounds.push(decoded.0);
        for nested in decoded.1 {
            additional_bounds.push(nested)
        }
    }
    Result::Ok((tast::DynTraitBound { trait_name, args, associated_types }, additional_bounds))
}

fn artifact_interface_binary_enum_fields(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[tast::EnumVariantFields, string] {
    let offset = wire::artifact_binary_reader_offset(reader.reader);
    let tag = artifact_interface_binary_read_tag(reader)?;
    if tag == 4 {
        let value = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        if value == "Unit" {
            Result::Ok(tast::EnumVariantFields::Unit)
        } else {
            Result::Err(artifact_interface_binary_error("enum variant fields"))
        }
    } else {
        wire::artifact_binary_reader_set_offset(reader.reader, offset);
        artifact_interface_binary_object(reader, 1, "enum variant fields")?;
        let kind = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        if kind == "Tuple" {
            match artifact_interface_binary_type_array(reader, context, "enum tuple fields") {
                Ok(value) => {
                    Result::Ok(tast::EnumVariantFields::Tuple(value))
                },
                Err(error) => Result::Err(error),
            }
        } else if kind == "Struct" {
            match artifact_interface_binary_type_pairs(reader, context, "enum struct fields") {
                Ok(value) => {
                    Result::Ok(tast::EnumVariantFields::Struct(value))
                },
                Err(error) => Result::Err(error),
            }
        } else {
            Result::Err(artifact_interface_binary_error("enum variant fields"))
        }
    }
}

fn artifact_interface_binary_enum_def(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    map_name: string,
) -> Result[tast::EnumDef, string] {
    artifact_interface_binary_object(reader, 4, "enum definition")?;
    artifact_interface_binary_field(reader, "name")?;
    let name = artifact_interface_binary_string(reader, "enum name")?;
    if name != map_name {
        return Result::Err(artifact_interface_binary_error("matching enum name"))
    } else {
        tast_codec::artifact_add_type_name(context.enum_names, name)
    };
    artifact_interface_binary_field(reader, "generics")?;
    let generics = artifact_interface_binary_string_array(reader, "enum generics")?;
    artifact_interface_binary_field(reader, "option_variants")?;
    let option_offset = wire::artifact_binary_reader_offset(reader.reader);
    let option_tag = artifact_interface_binary_read_tag(reader)?;
    let option_variants = if option_tag == 0 {
        Option::None
    } else {
        wire::artifact_binary_reader_set_offset(reader.reader, option_offset);
        let names = artifact_interface_binary_string_array(reader, "Option variant names")?;
        if names.len() == 2 {
            Option::Some((names[0], names[1]))
        } else {
            return Result::Err(artifact_interface_binary_error("Option variant names"))
        }
    };
    artifact_interface_binary_field(reader, "variants")?;
    let count = artifact_interface_binary_array(reader, "enum variants")?;
    let variants = Vec::with_capacity(count);
    for _ in 0..count {
        artifact_interface_binary_object(reader, 2, "enum variant")?;
        artifact_interface_binary_field(reader, "name")?;
        let variant_name = artifact_interface_binary_string(reader, "enum variant name")?;
        artifact_interface_binary_field(reader, "fields")?;
        let fields = artifact_interface_binary_enum_fields(reader, context)?;
        variants.push(tast::EnumVariantDef { name: variant_name, fields })
    }
    Result::Ok(tast::EnumDef { name, generics, variants, option_variants })
}

fn artifact_interface_binary_struct_def(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    map_name: string,
) -> Result[tast::StructDef, string] {
    artifact_interface_binary_object(reader, 4, "struct definition")?;
    artifact_interface_binary_field(reader, "name")?;
    let name = artifact_interface_binary_string(reader, "struct name")?;
    if name != map_name {
        return Result::Err(artifact_interface_binary_error("matching struct name"))
    } else {
        tast_codec::artifact_add_type_name(context.struct_names, name)
    };
    artifact_interface_binary_field(reader, "generics")?;
    let generics = artifact_interface_binary_string_array(reader, "struct generics")?;
    artifact_interface_binary_field(reader, "fields")?;
    let fields = artifact_interface_binary_type_pairs(reader, context, "struct fields")?;
    let public_fields = Vec::with_capacity(fields.len());
    for field in fields {
        public_fields.push(field.0)
    }
    artifact_interface_binary_field(reader, "has_hidden_fields")?;
    let has_hidden_fields = artifact_interface_binary_bool(reader, "struct hidden fields flag")?;
    Result::Ok(tast::StructDef { name, generics, fields, public_fields, has_hidden_fields })
}

fn artifact_interface_binary_type_alias(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    name: string,
) -> Result[tast::TypeAliasInfo, string] {
    artifact_interface_binary_object(reader, 2, "type alias")?;
    artifact_interface_binary_field(reader, "generics")?;
    let generics = artifact_interface_binary_string_array(reader, "type alias generics")?;
    artifact_interface_binary_field(reader, "ty")?;
    match artifact_interface_binary_type(reader, context) {
        Ok(ty) => Result::Ok(tast::TypeAliasInfo { name, generics, ty }),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_callable(reader: ArtifactInterfaceBinaryReader, name: string) -> Result[
    tast::Callable,
    string,
] {
    let count = artifact_interface_binary_read_count(reader, 6, "callable body")?;
    artifact_interface_binary_field(reader, "kind")?;
    let kind = artifact_interface_binary_string(reader, "callable kind")?;
    if kind == "goml" {
        if count == 1 {
            Result::Ok(tast::Callable::Function(name))
        } else if count == 2 {
            artifact_interface_binary_field(reader, "id")?;
            Result::Ok(
                tast::Callable::Function(artifact_interface_binary_string(reader, "callable id")?),
            )
        } else {
            Result::Err(artifact_interface_binary_error("callable body"))
        }
    } else if kind == "go" {
        if count != 3 {
            return Result::Err(artifact_interface_binary_error("callable body"))
        } else {};
        artifact_interface_binary_field(reader, "import_path")?;
        let import_path = artifact_interface_binary_string(reader, "Go import path")?;
        artifact_interface_binary_field(reader, "symbol")?;
        let symbol = artifact_interface_binary_string(reader, "Go symbol")?;
        Result::Ok(tast::Callable::GoForeign { import_path, symbol })
    } else if count != 2 {
        Result::Err(artifact_interface_binary_error("callable body"))
    } else {
        artifact_interface_binary_field(reader, "id")?;
        let id = artifact_interface_binary_string(reader, "callable id")?;
        if kind == "intrinsic" {
            match tast_codec::artifact_intrinsic_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Intrinsic(value)),
                None => Result::Err(artifact_interface_binary_error("intrinsic id")),
            }
        } else if kind == "runtime" {
            match tast_codec::artifact_runtime_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Runtime(value)),
                None => Result::Err(artifact_interface_binary_error("runtime hook id")),
            }
        } else {
            Result::Err(artifact_interface_binary_error("callable kind"))
        }
    }
}

fn artifact_interface_binary_fn_scheme(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    name: string,
) -> Result[artifact::ArtifactFnScheme, string] {
    artifact_interface_binary_object(reader, 5, "function scheme")?;
    artifact_interface_binary_field(reader, "comptime")?;
    let comptime = if artifact_interface_binary_bool(reader, "comptime capability")? {
        tast::ComptimeCapability::Capable
    } else {
        tast::ComptimeCapability::RuntimeOnly
    };
    artifact_interface_binary_field(reader, "type_params")?;
    let type_params = artifact_interface_binary_string_array(reader, "type parameters")?;
    artifact_interface_binary_field(reader, "constraints")?;
    let constraints = artifact_interface_binary_predicates(reader, context)?;
    artifact_interface_binary_field(reader, "ty")?;
    let ty = artifact_interface_binary_type(reader, context)?;
    artifact_interface_binary_field(reader, "body")?;
    let body = artifact_interface_binary_callable(reader, name)?;
    Result::Ok(artifact::ArtifactFnScheme { name, comptime, type_params, constraints, ty, body })
}

fn artifact_interface_binary_fn_map(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[artifact::ArtifactFnScheme], string] {
    let count = artifact_interface_binary_read_count(reader, 6, "function map")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        result.push(artifact_interface_binary_fn_scheme(reader, context, name)?)
    }
    Result::Ok(result)
}

fn artifact_interface_binary_associated_type_defs(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[artifact::ArtifactAssociatedTypeDef], string] {
    let count = artifact_interface_binary_read_count(reader, 6, "associated type definitions")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        artifact_interface_binary_object(reader, 1, "associated type definition")?;
        artifact_interface_binary_field(reader, "bounds")?;
        let bounds = artifact_interface_binary_trait_refs(reader, context)?;
        result.push(artifact::ArtifactAssociatedTypeDef { name, bounds })
    }
    Result::Ok(result)
}

fn artifact_interface_binary_trait_def(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
    name: string,
) -> Result[artifact::ArtifactTraitDef, string] {
    artifact_interface_binary_object(reader, 5, "trait definition")?;
    artifact_interface_binary_field(reader, "params")?;
    let params = artifact_interface_binary_string_array(reader, "trait parameters")?;
    artifact_interface_binary_field(reader, "predicates")?;
    let predicates = artifact_interface_binary_predicates(reader, context)?;
    artifact_interface_binary_field(reader, "supertraits")?;
    let supertraits = artifact_interface_binary_trait_refs(reader, context)?;
    artifact_interface_binary_field(reader, "associated_types")?;
    let associated_types = artifact_interface_binary_associated_type_defs(reader, context)?;
    artifact_interface_binary_field(reader, "methods")?;
    let methods = artifact_interface_binary_fn_map(reader, context)?;
    Result::Ok(
        artifact::ArtifactTraitDef {
            name,
            params,
            predicates,
            supertraits,
            associated_types,
            methods,
        },
    )
}

fn artifact_interface_binary_associated_types(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[(string, tast::Type)], string] {
    let count = artifact_interface_binary_read_count(reader, 6, "associated types")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        result.push((name, artifact_interface_binary_type(reader, context)?))
    }
    Result::Ok(result)
}

fn artifact_interface_binary_impl_def(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[artifact::ArtifactImplDef, string] {
    artifact_interface_binary_object(reader, 5, "implementation definition")?;
    artifact_interface_binary_field(reader, "params")?;
    let params = artifact_interface_binary_string_array(reader, "implementation parameters")?;
    artifact_interface_binary_field(reader, "constraints")?;
    let constraints = artifact_interface_binary_predicates(reader, context)?;
    artifact_interface_binary_field(reader, "associated_types")?;
    let associated_types = artifact_interface_binary_associated_types(reader, context)?;
    artifact_interface_binary_field(reader, "methods")?;
    let methods = artifact_interface_binary_fn_map(reader, context)?;
    artifact_interface_binary_field(reader, "valid")?;
    let valid = artifact_interface_binary_bool(reader, "implementation validity")?;
    Result::Ok(artifact::ArtifactImplDef { params, constraints, associated_types, methods, valid })
}

fn artifact_interface_binary_trait_impls(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[artifact::ArtifactTraitImpl], string] {
    let count = artifact_interface_binary_array(reader, "trait implementations")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let pair_count = artifact_interface_binary_array(reader, "trait implementation")?;
        if pair_count != 2 {
            return Result::Err(artifact_interface_binary_error("trait implementation pair"))
        } else {};
        artifact_interface_binary_object(reader, 2, "trait implementation key")?;
        artifact_interface_binary_field(reader, "trait_ref")?;
        let trait_ref = artifact_interface_binary_trait_ref(reader, context)?;
        artifact_interface_binary_field(reader, "for_ty")?;
        let for_ty = artifact_interface_binary_type(reader, context)?;
        let definition = artifact_interface_binary_impl_def(reader, context)?;
        result.push(artifact::ArtifactTraitImpl { trait_ref, for_ty, definition })
    }
    Result::Ok(result)
}

fn artifact_interface_binary_inherent_key(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[artifact::ArtifactInherentImplKey, string] {
    artifact_interface_binary_object(reader, 1, "inherent implementation key")?;
    let kind = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
    if kind == "Exact" {
        match artifact_interface_binary_type(reader, context) {
            Ok(value) => {
                Result::Ok(artifact::ArtifactInherentImplKey::Exact(value))
            },
            Err(error) => Result::Err(error),
        }
    } else if kind == "Constr" {
        match artifact_interface_binary_string(reader, "inherent constructor") {
            Ok(value) => {
                Result::Ok(artifact::ArtifactInherentImplKey::Constr(value))
            },
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_interface_binary_error("inherent implementation key"))
    }
}

fn artifact_interface_binary_inherent_impls(
    reader: ArtifactInterfaceBinaryReader,
    context: tast_codec::ArtifactDecodeContext,
) -> Result[Vec[artifact::ArtifactInherentImpl], string] {
    let count = artifact_interface_binary_array(reader, "inherent implementations")?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let pair_count = artifact_interface_binary_array(reader, "inherent implementation")?;
        if pair_count != 2 {
            return Result::Err(artifact_interface_binary_error("inherent implementation pair"))
        } else {};
        let key = artifact_interface_binary_inherent_key(reader, context)?;
        let definition = artifact_interface_binary_impl_def(reader, context)?;
        result.push(artifact::ArtifactInherentImpl { key, definition })
    }
    Result::Ok(result)
}

fn artifact_interface_binary_package_exports(reader: ArtifactInterfaceBinaryReader) -> Result[
    artifact::ArtifactPackageExports,
    string,
] {
    let context = tast_codec::new_artifact_decode_context();
    artifact_interface_binary_object(reader, 4, "package exports")?;
    artifact_interface_binary_field(reader, "reexports")?;
    let reexport_count = artifact_interface_binary_read_count(reader, 6, "re-export map")?;
    let reexports = Vec::with_capacity(reexport_count);
    for _ in 0..reexport_count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        let target = artifact_interface_binary_string(reader, "re-export target")?;
        reexports.push((name, target))
    }
    artifact_interface_binary_field(reader, "type_env")?;
    artifact_interface_binary_object(reader, 3, "type environment")?;
    artifact_interface_binary_field(reader, "enums")?;
    let enum_count = artifact_interface_binary_read_count(reader, 6, "enum map")?;
    let enums = Vec::with_capacity(enum_count);
    for _ in 0..enum_count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        enums.push(artifact_interface_binary_enum_def(reader, context, name)?)
    }
    artifact_interface_binary_field(reader, "structs")?;
    let struct_count = artifact_interface_binary_read_count(reader, 6, "struct map")?;
    let structs = Vec::with_capacity(struct_count);
    for _ in 0..struct_count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        structs.push(artifact_interface_binary_struct_def(reader, context, name)?)
    }
    artifact_interface_binary_field(reader, "aliases")?;
    let alias_count = artifact_interface_binary_read_count(reader, 6, "type alias map")?;
    let type_aliases = Vec::with_capacity(alias_count);
    for _ in 0..alias_count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        type_aliases.push(artifact_interface_binary_type_alias(reader, context, name)?)
    }
    artifact_interface_binary_field(reader, "trait_env")?;
    artifact_interface_binary_object(reader, 3, "trait environment")?;
    artifact_interface_binary_field(reader, "trait_defs")?;
    let trait_count = artifact_interface_binary_read_count(reader, 6, "trait definitions")?;
    let traits = Vec::with_capacity(trait_count);
    for _ in 0..trait_count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        traits.push(artifact_interface_binary_trait_def(reader, context, name)?)
    }
    artifact_interface_binary_field(reader, "trait_impls")?;
    let trait_impls = artifact_interface_binary_trait_impls(reader, context)?;
    artifact_interface_binary_field(reader, "inherent_impls")?;
    let inherent_impls = artifact_interface_binary_inherent_impls(reader, context)?;
    artifact_interface_binary_field(reader, "value_env")?;
    artifact_interface_binary_object(reader, 2, "value environment")?;
    artifact_interface_binary_field(reader, "funcs")?;
    let functions = artifact_interface_binary_fn_map(reader, context)?;
    artifact_interface_binary_field(reader, "consts")?;
    let constant_count = artifact_interface_binary_read_count(reader, 6, "constant map")?;
    let constants = Vec::with_capacity(constant_count);
    for _ in 0..constant_count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        artifact_interface_binary_object(reader, 1, "constant scheme")?;
        artifact_interface_binary_field(reader, "ty")?;
        let ty = artifact_interface_binary_type(reader, context)?;
        constants.push(tast::ConstantScheme { def_id: Option::None, name, ty })
    }
    Result::Ok(
        artifact::ArtifactPackageExports {
            reexports,
            enum_type_names: context.enum_names,
            struct_type_names: context.struct_names,
            type_aliases,
            enums,
            structs,
            traits,
            trait_impls,
            inherent_impls,
            functions,
            constants,
        },
    )
}

fn artifact_interface_binary_package_interface(reader: ArtifactInterfaceBinaryReader) -> Result[
    artifact::ArtifactPackageInterface,
    string,
] {
    artifact_interface_binary_object(reader, 4, "package interface")?;
    artifact_interface_binary_field(reader, "package")?;
    let package_name = artifact_interface_binary_string(reader, "package name")?;
    artifact_interface_binary_field(reader, "name")?;
    let name = artifact_interface_binary_string(reader, "interface name")?;
    artifact_interface_binary_field(reader, "value_exports")?;
    let value_count = artifact_interface_binary_read_count(reader, 6, "value exports")?;
    let value_exports = Vec::with_capacity(value_count);
    for _ in 0..value_count {
        let export_name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        let number = artifact_interface_binary_number(reader, "value export index")?;
        value_exports.push((export_name, wire::artifact_parse_nonnegative_int(number)?))
    }
    artifact_interface_binary_field(reader, "enum_variants")?;
    let enum_count = artifact_interface_binary_read_count(reader, 6, "enum variants")?;
    let enum_variants = Vec::with_capacity(enum_count);
    for _ in 0..enum_count {
        let enum_name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        enum_variants.push(
            (enum_name, artifact_interface_binary_string_array(reader, "enum variant names")?),
        )
    }
    Result::Ok(
        artifact::ArtifactPackageInterface { package_name, name, value_exports, enum_variants },
    )
}

fn artifact_interface_binary_string_map(reader: ArtifactInterfaceBinaryReader, expected: string) -> Result[
    Vec[(string, string)],
    string,
] {
    let count = artifact_interface_binary_read_count(reader, 6, expected)?;
    let result = Vec::with_capacity(count);
    for _ in 0..count {
        let name = wire::artifact_binary_decode_string_id(reader.reader, reader.table)?;
        result.push((name, artifact_interface_binary_string(reader, expected)?))
    }
    Result::Ok(result)
}

fn artifact_interface_binary_version_field(
    reader: ArtifactInterfaceBinaryReader,
    name: string,
    expected: string,
) -> Result[unit, string] {
    artifact_interface_binary_field(reader, name)?;
    match artifact_interface_binary_number(reader, name) {
        Ok(value) => if value == expected {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error(name))
        },
        Err(error) => Result::Err(error),
    }
}

fn decode_artifact_interface_binary_value(
    table: wire::ArtifactBinaryStringTable,
    data: bytes::Bytes,
) -> Result[artifact::ArtifactInterfaceUnit, string] {
    let reader = new_artifact_interface_binary_reader(data, table);
    artifact_interface_binary_object(reader, 7, "interface unit")?;
    artifact_interface_binary_version_field(reader, "format_version", "20")?;
    artifact_interface_binary_version_field(reader, "compiler_abi", "4")?;
    artifact_interface_binary_field(reader, "package")?;
    let package_name = artifact_interface_binary_string(reader, "package name")?;
    artifact_interface_binary_field(reader, "exports")?;
    let exports = artifact_interface_binary_package_exports(reader)?;
    artifact_interface_binary_field(reader, "interface")?;
    let package_interface = artifact_interface_binary_package_interface(reader)?;
    artifact_interface_binary_field(reader, "deps")?;
    let deps = artifact_interface_binary_string_map(reader, "dependency hashes")?;
    artifact_interface_binary_field(reader, "interface_hash")?;
    let interface_hash = artifact_interface_binary_string(reader, "interface hash")?;
    if wire::artifact_binary_reader_remaining(reader.reader) != 0 {
        return Result::Err("trailing bytes in binary artifact value")
    } else {};
    let result = artifact::ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        comptime: Option::None,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(artifact_interface_binary_error("matching interface package"))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(artifact_interface_binary_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}
