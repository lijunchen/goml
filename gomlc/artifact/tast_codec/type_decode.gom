package tast_codec;

use gomlc::artifact::wire as wire;
use gomlc::tast;

pub struct ArtifactDecodeContext {
    pub enum_names: Vec[string],
    pub struct_names: Vec[string],
}

pub fn new_artifact_decode_context() -> ArtifactDecodeContext {
    ArtifactDecodeContext { enum_names: Vec::[], struct_names: Vec::[] }
}

pub fn artifact_decode_type_array(
    context: ArtifactDecodeContext,
    value: wire::ArtifactValue,
    expected: string,
) -> Result[Vec[tast::Type], string] {
    let values = wire::artifact_json_array(value, expected)?;
    let result: Vec[tast::Type] = Vec::[];
    for value in values {
        result.push(artifact_decode_type(context, value)?)
    }
    Result::Ok(result)
}

fn artifact_decode_dyn_bound(context: ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::DynTraitBound,
    string,
] {
    let object = wire::artifact_json_object(value, "dyn bound")?;
    let trait_name = wire::artifact_json_field_string(object, "trait_name")?;
    let args = artifact_decode_type_array(
        context,
        wire::artifact_json_required_field(object, "args")?,
        "dyn arguments",
    )?;
    let values = wire::artifact_json_array(
        wire::artifact_json_required_field(object, "associated_types")?,
        "dyn associated type bindings",
    )?;
    let associated_types: Vec[(string, tast::Type)] = Vec::[];
    for value in values {
        let pair = wire::artifact_json_array(value, "dyn associated type binding")?;
        if pair.len() != 2 {
            return Result::Err(wire::artifact_decode_error("dyn associated type binding"))
        } else {};
        associated_types.push(
            (
                wire::artifact_json_string_value(pair[0], "associated type name")?,
                artifact_decode_type(context, pair[1])?,
            ),
        )
    }
    Result::Ok(tast::DynTraitBound { trait_name, args, associated_types })
}

fn artifact_decode_dyn_type(context: ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::Type,
    string,
] {
    let primary = artifact_decode_dyn_bound(context, value)?;
    let object = wire::artifact_json_object(value, "dynamic type")?;
    let values = wire::artifact_json_array(
        wire::artifact_json_required_field(object, "additional_bounds")?,
        "additional dyn bounds",
    )?;
    let additional_bounds: Vec[tast::DynTraitBound] = Vec::[];
    for value in values {
        additional_bounds.push(artifact_decode_dyn_bound(context, value)?)
    }
    Result::Ok(
        tast::Type::Dyn {
            trait_name: primary.trait_name,
            args: primary.args,
            associated_types: primary.associated_types,
            additional_bounds,
        },
    )
}

pub fn artifact_decode_trait_ref(context: ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::TraitRef,
    string,
] {
    let object = wire::artifact_json_object(value, "trait reference")?;
    let name = wire::artifact_json_field_string(object, "name")?;
    let args = artifact_decode_type_array(
        context,
        wire::artifact_json_required_field(object, "args")?,
        "trait arguments",
    )?;
    Result::Ok(tast::TraitRef { name, args })
}

fn artifact_decode_optional_trait_ref(context: ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Option[tast::TraitRef],
    string,
] {
    match value {
        Null => Result::Ok(Option::None),
        other => match artifact_decode_trait_ref(context, other) {
            Ok(value) => Result::Ok(Option::Some(value)),
            Err(error) => Result::Err(error),
        },
    }
}

fn artifact_decode_named_type(
    context: ArtifactDecodeContext,
    value: wire::ArtifactValue,
    field: string,
    enum_type: bool,
) -> Result[tast::Type, string] {
    let object = wire::artifact_json_object(value, "named type")?;
    let name = wire::artifact_json_field_string(object, field)?;
    if enum_type {
        artifact_add_type_name(context.enum_names, name)
    } else {
        artifact_add_type_name(context.struct_names, name)
    };
    Result::Ok(tast::Type::Con { name })
}

fn artifact_decode_element_type(
    context: ArtifactDecodeContext,
    value: wire::ArtifactValue,
    expected: string,
) -> Result[tast::Type, string] {
    let object = wire::artifact_json_object(value, expected)?;
    match wire::artifact_json_required_field(object, "elem") {
        Ok(value) => artifact_decode_type(context, value),
        Err(error) => Result::Err(error),
    }
}

pub fn artifact_decode_type(context: ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::Type,
    string,
] {
    match value {
        String(name) => match name {
            "TUnit" => Result::Ok(tast::Type::Unit),
            "TNever" => Result::Ok(tast::Type::Never),
            "TBool" => Result::Ok(tast::Type::Bool),
            "TInt" => Result::Ok(tast::Type::Int),
            "TInt8" => Result::Ok(tast::Type::Int8),
            "TInt16" => Result::Ok(tast::Type::Int16),
            "TInt32" => Result::Ok(tast::Type::Int32),
            "TInt64" => Result::Ok(tast::Type::Int64),
            "TUint" => Result::Ok(tast::Type::Uint),
            "TUint8" => Result::Ok(tast::Type::Uint8),
            "TUint16" => Result::Ok(tast::Type::Uint16),
            "TUint32" => Result::Ok(tast::Type::Uint32),
            "TUint64" => Result::Ok(tast::Type::Uint64),
            "TFloat32" => Result::Ok(tast::Type::Float32),
            "TFloat64" => Result::Ok(tast::Type::Float64),
            "TString" => Result::Ok(tast::Type::String),
            "TChar" => Result::Ok(tast::Type::Char),
            _ => Result::Err(wire::artifact_decode_error("type")),
        },
        Object(fields) => {
            if fields.len() != 1 {
                return Result::Err(wire::artifact_decode_error("type variant"))
            } else {};
            let kind = fields[0].0;
            let payload = fields[0].1;
            if kind == "TEnum" {
                artifact_decode_named_type(context, payload, "name", true)
            } else if kind == "TStruct" {
                artifact_decode_named_type(context, payload, "name", false)
            } else if kind == "TDyn" {
                artifact_decode_dyn_type(context, payload)
            } else if kind == "TParam" {
                let object = wire::artifact_json_object(payload, "type parameter")?;
                match wire::artifact_json_field_string(object, "name") {
                    Ok(value) => Result::Ok(tast::Type::Param { name: value }),
                    Err(error) => Result::Err(error),
                }
            } else if kind == "TTuple" {
                let object = wire::artifact_json_object(payload, "tuple type")?;
                match wire::artifact_json_required_field(object, "typs") {
                    Ok(value) => match artifact_decode_type_array(context, value, "tuple elements") {
                        Ok(value) => Result::Ok(tast::Type::Tuple { items: value }),
                        Err(error) => Result::Err(error),
                    },
                    Err(error) => Result::Err(error),
                }
            } else if kind == "TProjection" {
                let object = wire::artifact_json_object(payload, "projection type")?;
                let trait_ref = artifact_decode_optional_trait_ref(
                    context,
                    wire::artifact_json_required_field(object, "trait_ref")?,
                )?;
                let for_ty = artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "for_ty")?,
                )?;
                match wire::artifact_json_field_string(object, "name") {
                    Ok(name) => Result::Ok(tast::Type::Projection { for_ty, name, trait_ref }),
                    Err(error) => Result::Err(error),
                }
            } else if kind == "TApp" {
                let object = wire::artifact_json_object(payload, "type application")?;
                let base = artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "ty")?,
                )?;
                let args = artifact_decode_type_array(
                    context,
                    wire::artifact_json_required_field(object, "args")?,
                    "type arguments",
                )?;
                Result::Ok(tast::Type::App { ty: base, args })
            } else if kind == "TArray" {
                let object = wire::artifact_json_object(payload, "array type")?;
                let length_value = wire::artifact_json_number_value(
                    wire::artifact_json_required_field(object, "len")?,
                    "array length",
                )?;
                let length = if length_value == "18446744073709551615" {
                    -1
                } else {
                    wire::artifact_parse_nonnegative_int(length_value)?
                };
                let elem = artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "elem")?,
                )?;
                Result::Ok(tast::Type::Array { len: length, elem })
            } else if kind == "TSlice" {
                match artifact_decode_element_type(context, payload, "slice type") {
                    Ok(value) => Result::Ok(tast::Type::Slice { elem: value }),
                    Err(error) => Result::Err(error),
                }
            } else if kind == "TVec" {
                match artifact_decode_element_type(context, payload, "vector type") {
                    Ok(value) => Result::Ok(tast::Type::VecType { elem: value }),
                    Err(error) => Result::Err(error),
                }
            } else if kind == "TRef" {
                match artifact_decode_element_type(context, payload, "reference type") {
                    Ok(value) => Result::Ok(tast::Type::RefType { elem: value }),
                    Err(error) => Result::Err(error),
                }
            } else if kind == "TChannel" {
                match artifact_decode_element_type(context, payload, "channel type") {
                    Ok(value) => Result::Ok(tast::Type::Channel { elem: value }),
                    Err(error) => Result::Err(error),
                }
            } else if kind == "THashMap" {
                let object = wire::artifact_json_object(payload, "hash map type")?;
                let key = artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "key")?,
                )?;
                let value = artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "value")?,
                )?;
                Result::Ok(tast::Type::HashMap { key, value })
            } else if kind == "TFunc" {
                let object = wire::artifact_json_object(payload, "function type")?;
                let params = artifact_decode_type_array(
                    context,
                    wire::artifact_json_required_field(object, "params")?,
                    "function parameters",
                )?;
                let ret_ty = artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "ret_ty")?,
                )?;
                Result::Ok(tast::Type::Func { params, ret_ty })
            } else {
                Result::Err(wire::artifact_decode_error("supported type variant"))
            }
        },
        _ => Result::Err(wire::artifact_decode_error("type")),
    }
}

pub fn artifact_decode_predicate(context: ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::TypePredicate,
    string,
] {
    let fields = wire::artifact_json_object(value, "type predicate")?;
    if fields.len() != 1 {
        Result::Err(wire::artifact_decode_error("type predicate variant"))
    } else if fields[0].0 == "Trait" {
        let payload = wire::artifact_json_object(fields[0].1, "trait predicate")?;
        let for_ty = artifact_decode_type(
            context,
            wire::artifact_json_required_field(payload, "for_ty")?,
        )?;
        let trait_ref = artifact_decode_trait_ref(
            context,
            wire::artifact_json_required_field(payload, "trait_ref")?,
        )?;
        Result::Ok(tast::TypePredicate::Trait { for_ty, trait_ref })
    } else if fields[0].0 == "Equality" {
        let payload = wire::artifact_json_object(fields[0].1, "equality predicate")?;
        let left = artifact_decode_type(
            context,
            wire::artifact_json_required_field(payload, "lhs")?,
        )?;
        let right = artifact_decode_type(
            context,
            wire::artifact_json_required_field(payload, "rhs")?,
        )?;
        Result::Ok(tast::TypePredicate::Equality { lhs: left, rhs: right })
    } else {
        Result::Err(wire::artifact_decode_error("supported type predicate"))
    }
}
