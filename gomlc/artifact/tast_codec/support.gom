package tast_codec;

use std::io;
use std::process;

fn fail(message: string) -> unit {
    io::eprintln(message);
    process::exit(1)
}

pub fn artifact_add_type_name(values: Vec[string], name: string) -> unit {
    for value in values {
        if value == name {
            return ()
        } else {
            ()
        }
    };
    values.push(name)
}

pub fn option_string_present(value: Option[string]) -> bool {
    match value {
        Some(_) => true,
        None => false,
    }
}
