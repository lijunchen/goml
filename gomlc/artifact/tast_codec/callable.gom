package tast_codec;

use module::artifact::wire as wire;
use module::resources;
use module::tast;

pub struct ArtifactCallable {
    pub name: string,
    pub kind: string,
    pub id: Option[string],
    pub import_path: Option[string],
    pub symbol: Option[string],
}

fn invalid_artifact_callable(value: string) -> ArtifactCallable {
    ArtifactCallable {
        name: value,
        kind: CALLABLE_INVALID_KIND,
        id: Option::None,
        import_path: Option::None,
        symbol: Option::None,
    }
}

pub fn artifact_callable(value: tast::Callable) -> ArtifactCallable {
    match value {
        Function(value) => ArtifactCallable {
            name: value,
            kind: CALLABLE_GOML_KIND,
            id: Option::Some(value),
            import_path: Option::None,
            symbol: Option::None,
        },
        LangItem { item: _, function_name } => {
            ArtifactCallable {
                name: function_name,
                kind: CALLABLE_GOML_KIND,
                id: Option::Some(function_name),
                import_path: Option::None,
                symbol: Option::None,
            }
        },
        Runtime(value) => match resources::runtime_abi_by_key(value) {
            Some(spec) => ArtifactCallable {
                name: if value.byte_len() >= 4 && value.byte_slice(0, 4) == "std." {
                    "std::internal::host::" + spec.source_name
                } else {
                    spec.source_name
                },
                kind: CALLABLE_RUNTIME_KIND,
                id: Option::Some(spec.artifact_id),
                import_path: Option::None,
                symbol: Option::None,
            },
            None => invalid_artifact_callable(value),
        },
        Intrinsic(value) => match resources::intrinsic_abi_by_key(value) {
            Some(spec) => ArtifactCallable {
                name: spec.source_name,
                kind: CALLABLE_INTRINSIC_KIND,
                id: Option::Some(spec.artifact_id),
                import_path: Option::None,
                symbol: Option::None,
            },
            None => invalid_artifact_callable(value),
        },
        GoForeign { import_path, symbol } => ArtifactCallable {
            name: symbol,
            kind: CALLABLE_GO_KIND,
            id: Option::None,
            import_path: Option::Some(import_path),
            symbol: Option::Some(symbol),
        },
        TraitMethod { .. } | DynTraitMethod { trait_name: _, dispatch_name: _, method_name: _ } | InherentMethod {
            receiver_ty: _,
            method_name: _,
        } => {
            invalid_artifact_callable("unresolved callable")
        },
    }
}

pub fn artifact_json_callable_body(writer: wire::ArtifactJsonWriter, value: ArtifactCallable) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "kind");
    wire::artifact_json_string(writer, value.kind);
    if let Some(value) = value.id {
        wire::artifact_json_name(writer, "id");
        wire::artifact_json_string(writer, value)
    }
    if let Some(value) = value.import_path {
        wire::artifact_json_name(writer, "import_path");
        wire::artifact_json_string(writer, value)
    }
    if let Some(value) = value.symbol {
        wire::artifact_json_name(writer, "symbol");
        wire::artifact_json_string(writer, value)
    }
    wire::artifact_json_end_object(writer)
}

pub fn artifact_intrinsic_key_from_id(value: string) -> Option[string] {
    resources::intrinsic_abi_by_id(value).map(|spec| spec.key)
}

pub fn artifact_runtime_key_from_id(value: string) -> Option[string] {
    resources::runtime_abi_by_id(value).map(|spec| spec.key)
}

pub fn artifact_decode_callable_body(name: string, value: wire::ArtifactValue) -> Result[
    tast::Callable,
    string,
] {
    let object = wire::artifact_json_object(value, "callable body")?;
    let kind = wire::artifact_json_field_string(object, "kind")?;
    match kind {
        CALLABLE_GOML_KIND => match wire::artifact_json_optional_field(object, "id")? {
            Some(value) => Result::Ok(
                tast::Callable::Function(wire::artifact_json_string_value(value, "callable id")?),
            ),
            None => Result::Ok(tast::Callable::Function(name)),
        },
        CALLABLE_GO_KIND => Result::Ok(
            tast::Callable::GoForeign {
                import_path: wire::artifact_json_field_string(object, "import_path")?,
                symbol: wire::artifact_json_field_string(object, "symbol")?,
            },
        ),
        CALLABLE_INTRINSIC_KIND => {
            let id = wire::artifact_json_field_string(object, "id")?;
            match artifact_intrinsic_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Intrinsic(value)),
                None => Result::Err(wire::artifact_decode_error("intrinsic id")),
            }
        },
        CALLABLE_RUNTIME_KIND => {
            let id = wire::artifact_json_field_string(object, "id")?;
            match artifact_runtime_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Runtime(value)),
                None => Result::Err(wire::artifact_decode_error("runtime hook id")),
            }
        },
        _ => Result::Err(wire::artifact_decode_error("callable kind")),
    }
}
