package hash;

use std::bytes;
use std::text;

fn sha256_constants() -> Vec[u32] {
    Vec::from_array(
        [
            1116352408,
            1899447441,
            3049323471,
            3921009573,
            961987163,
            1508970993,
            2453635748,
            2870763221,
            3624381080,
            310598401,
            607225278,
            1426881987,
            1925078388,
            2162078206,
            2614888103,
            3248222580,
            3835390401,
            4022224774,
            264347078,
            604807628,
            770255983,
            1249150122,
            1555081692,
            1996064986,
            2554220882,
            2821834349,
            2952996808,
            3210313671,
            3336571891,
            3584528711,
            113926993,
            338241895,
            666307205,
            773529912,
            1294757372,
            1396182291,
            1695183700,
            1986661051,
            2177026350,
            2456956037,
            2730485921,
            2820302411,
            3259730800,
            3345764771,
            3516065817,
            3600352804,
            4094571909,
            275423344,
            430227734,
            506948616,
            659060556,
            883997877,
            958139571,
            1322822218,
            1537002063,
            1747873779,
            1955562222,
            2024104815,
            2227730452,
            2361852424,
            2428436474,
            2756734187,
            3204031479,
            3329325298,
        ],
    )
}

fn rotate_right(value: u32, count: u32) -> u32 {
    (value >> count) | (value << (32 - count))
}

fn padded_byte(value: bytes::Bytes, index: isize, padded_len: isize, bit_len: u64) -> byte {
    if index < value.len() {
        value.get(index)
    } else if index == value.len() {
        128
    } else if index >= padded_len - 8 {
        let shift = ((padded_len - 1 - index) * 8).to_u64();
        ((bit_len >> shift) & 255).to_u8()
    } else {
        0
    }
}

fn message_word(value: bytes::Bytes, offset: isize, padded_len: isize, bit_len: u64) -> u32 {
    ((padded_byte(value, offset, padded_len, bit_len).to_u32()) << 24)
        | ((padded_byte(value, offset + 1, padded_len, bit_len).to_u32()) << 16)
        | ((padded_byte(value, offset + 2, padded_len, bit_len).to_u32()) << 8)
        | (padded_byte(value, offset + 3, padded_len, bit_len).to_u32())
}

fn write_hex_word(builder: text::StringBuilder, value: u32) -> unit {
    let digits = "0123456789abcdef";
    for index in 0..8 {
        let shift = ((7 - index) * 4).to_u32();
        builder.write_char(digits.get(((value >> shift) & 15).to_isize()))
    }
}

pub fn sha256_bytes_hex(value: bytes::Bytes) -> string {
    let constants = sha256_constants();
    let mut padded_len = value.len() + 9;
    while padded_len % 64 != 0 {
        padded_len += 1;
    }
    let bit_len = (value.len().to_u64()) * 8;
    let mut h0 = 1779033703;
    let mut h1 = 3144134277;
    let mut h2 = 1013904242;
    let mut h3 = 2773480762;
    let mut h4 = 1359893119;
    let mut h5 = 2600822924;
    let mut h6 = 528734635;
    let mut h7 = 1541459225;
    let words: Vec[u32] = Vec::with_capacity(64);
    for _ in 0..64 {
        words.push(0)
    }
    for chunk in 0..padded_len / 64 {
        for index in 0..16 {
            words[index] = message_word(value, chunk * 64 + index * 4, padded_len, bit_len);
        }
        for index in 16..64 {
            let first = words[index - 15];
            let second = words[index - 2];
            let sigma0 = rotate_right(first, 7) ^ rotate_right(first, 18) ^ (first >> 3);
            let sigma1 = rotate_right(second, 17) ^ rotate_right(second, 19) ^ (second >> 10);
            words[index] = words[index - 16] + sigma0 + words[index - 7] + sigma1;
        }
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        let mut f = h5;
        let mut g = h6;
        let mut h = h7;
        for index in 0..64 {
            let sigma1 = rotate_right(e, 6) ^ rotate_right(e, 11) ^ rotate_right(e, 25);
            let choice = (e & f) ^ (~e & g);
            let temp1 = h + sigma1 + choice + constants[index] + words[index];
            let sigma0 = rotate_right(a, 2) ^ rotate_right(a, 13) ^ rotate_right(a, 22);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = sigma0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 + temp2;
        }
        h0 += a;
        h1 += b;
        h2 += c;
        h3 += d;
        h4 += e;
        h5 += f;
        h6 += g;
        h7 += h;
    }
    let builder = text::StringBuilder::with_capacity(64);
    write_hex_word(builder, h0);
    write_hex_word(builder, h1);
    write_hex_word(builder, h2);
    write_hex_word(builder, h3);
    write_hex_word(builder, h4);
    write_hex_word(builder, h5);
    write_hex_word(builder, h6);
    write_hex_word(builder, h7);
    builder.finish()
}

pub fn sha256_hex(value: string) -> string {
    sha256_bytes_hex(bytes::Bytes::from_string(value))
}

pub fn sha256_prefix(value: string) -> string {
    sha256_hex(value).byte_slice(0, 32)
}
