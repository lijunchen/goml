package go_backend;

use gomlc::tast;

fn core_function_item(key: string, params: Vec[(string, Type)], ret_ty: Type, stmts: Vec[Stmt]) -> Item {
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn core_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Var { name }, args }
}

fn core_len(value: Expr) -> Expr {
    let args: Vec[Expr] = Vec::[];
    args.push(value);
    core_call("len", args)
}

fn core_int(value: Expr) -> Expr {
    Expr::Convert { ty: Type::Int, expr: value }
}

fn core_tuple_type2(first: tast::Type, second: tast::Type) -> Type {
    let values: Vec[tast::Type] = Vec::[];
    values.push(first);
    values.push(second);
    lower_type(tast::Type::Tuple { items: values })
}

fn core_tuple_expr(ty: Type, values: Vec[Expr]) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::[];
    for index in 0..values.len() {
        fields.push(("_" + index.to_string(), values[index]))
    }
    Expr::StructLiteral { ty, fields }
}

fn string_len_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Return { expr: Option::Some(core_int(core_len(Expr::Var { name: "s" }))) });
    core_function_item(CORE_STRING_LEN_RUNTIME_KEY, params, Type::Int, stmts)
}

fn string_get_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Convert {
                    ty: Type::Char,
                    expr: Expr::Index {
                        base: Expr::Var { name: "s" },
                        index: Expr::Var { name: "i" },
                    },
                },
            ),
        },
    );
    core_function_item(CORE_STRING_GET_RUNTIME_KEY, params, Type::Char, stmts)
}

fn string_byte_get_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Index { base: Expr::Var { name: "s" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    core_function_item(CORE_STRING_BYTE_GET_RUNTIME_KEY, params, Type::Uint8, stmts)
}

fn string_byte_slice_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    params.push(("start", Type::Int));
    params.push(("end", Type::Int));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Slice {
                    base: Expr::Var { name: "s" },
                    start: Expr::Var { name: "start" },
                    end: Expr::Var { name: "end" },
                },
            ),
        },
    );
    core_function_item(CORE_STRING_BYTE_SLICE_RUNTIME_KEY, params, Type::String, stmts)
}

fn string_to_bytes_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    let elem = tast::Type::Uint8;
    let vec_ty = tast::Type::VecType { elem };
    let fields: Vec[(string, Expr)] = Vec::[];
    fields.push(
        (
            "items",
            Expr::Convert { ty: Type::Named { name: "[]byte" }, expr: Expr::Var { name: "s" } },
        ),
    );
    let value = Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))) },
            fields,
        },
    };
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Return { expr: Option::Some(value) });
    core_function_item(CORE_STRING_TO_BYTES_RUNTIME_KEY, params, lower_type(vec_ty), stmts)
}

fn char_to_string_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", Type::Char));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Convert { ty: Type::String, expr: Expr::Var { name: "x" } }),
        },
    );
    core_function_item(CORE_CHAR_TO_STRING_RUNTIME_KEY, params, Type::String, stmts)
}

fn char_from_uint32_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("value", Type::Uint32));
    let ret_ty = core_tuple_type2(tast::Type::Bool, tast::Type::Char);
    let stmts: Vec[Stmt] = Vec::[];
    let values: Vec[Expr] = Vec::[];
    values.push(Expr::Bool { value: true });
    values.push(Expr::Convert { ty: Type::Char, expr: Expr::Var { name: "value" } });
    stmts.push(Stmt::Return { expr: Option::Some(core_tuple_expr(ret_ty, values)) });
    core_function_item(CORE_CHAR_FROM_UINT32_RUNTIME_KEY, params, ret_ty, stmts)
}

fn float_to_string_hook_item(key: string, ty: Type, bit_size: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", ty));
    let args: Vec[Expr] = Vec::[];
    args.push(
        match key {
            CORE_FLOAT32_TO_STRING_RUNTIME_KEY => {
                Expr::Convert { ty: Type::Float64, expr: Expr::Var { name: "x" } }
            },
            _ => Expr::Var { name: "x" },
        },
    );
    args.push(Expr::Int { value: "102" });
    args.push(Expr::Int { value: "-1" });
    args.push(Expr::Int { value: bit_size });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Var {
            name: "formatted",
            ty: Type::String,
            value: Option::Some(core_call("_goml_strconv.FormatFloat", args)),
        },
    );
    let positive_stmts: Vec[Stmt] = Vec::[];
    positive_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "inf" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "formatted" },
                rhs: Expr::String { value: "+Inf" },
            },
            then_: Block { stmts: positive_stmts },
            else_: Option::None,
        },
    );
    let negative_stmts: Vec[Stmt] = Vec::[];
    negative_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "-inf" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "formatted" },
                rhs: Expr::String { value: "-Inf" },
            },
            then_: Block { stmts: negative_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "formatted" }) });
    core_function_item(key, params, Type::String, stmts)
}

fn integer_hash_hook_type(key: string) -> Option[Type] {
    match key {
        CORE_INT_HASH_RUNTIME_KEY => Option::Some(Type::Int),
        CORE_INT8_HASH_RUNTIME_KEY => Option::Some(Type::Int8),
        CORE_INT16_HASH_RUNTIME_KEY => Option::Some(Type::Int16),
        CORE_INT32_HASH_RUNTIME_KEY => Option::Some(Type::Int32),
        CORE_INT64_HASH_RUNTIME_KEY => Option::Some(Type::Int64),
        CORE_UINT_HASH_RUNTIME_KEY => Option::Some(Type::Uint),
        CORE_UINT8_HASH_RUNTIME_KEY => Option::Some(Type::Uint8),
        CORE_UINT16_HASH_RUNTIME_KEY => Option::Some(Type::Uint16),
        CORE_UINT32_HASH_RUNTIME_KEY => Option::Some(Type::Uint32),
        CORE_CHAR_HASH_RUNTIME_KEY => Option::Some(Type::Char),
        _ => Option::None,
    }
}

fn integer_hash_hook_item(key: string, ty: Type) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", ty));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Convert { ty: Type::Uint64, expr: Expr::Var { name: "x" } }),
        },
    );
    core_function_item(key, params, Type::Uint64, stmts)
}

fn float_hash_hook_item(key: string, ty: Type, go_name: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", ty));
    let zero_stmts: Vec[Stmt] = Vec::[];
    zero_stmts.push(Stmt::Return { expr: Option::Some(Expr::Int { value: "0" }) });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "x" },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: zero_stmts },
            else_: Option::None,
        },
    );
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::Var { name: "x" });
    let bits = core_call(go_name, args);
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                match key {
                    CORE_FLOAT32_HASH_RUNTIME_KEY => Expr::Convert { ty: Type::Uint64, expr: bits },
                    _ => bits,
                },
            ),
        },
    );
    core_function_item(key, params, Type::Uint64, stmts)
}

fn string_hash_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(Expr::Int { value: "14695981039346656037" }),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::[];
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: core_int(core_len(Expr::Var { name: "s" })),
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "h",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Binary {
                    op: BinaryOp::Mul,
                    lhs: Expr::Var { name: "h" },
                    rhs: Expr::Int { value: "1099511628211" },
                },
                rhs: Expr::Convert {
                    ty: Type::Uint64,
                    expr: Expr::Index {
                        base: Expr::Var { name: "s" },
                        index: Expr::Var { name: "i" },
                    },
                },
            },
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "h" }) });
    core_function_item(CORE_STRING_HASH_RUNTIME_KEY, params, Type::Uint64, stmts)
}

fn extra_core_runtime_hook_item(key: string) -> Option[Item] {
    match integer_hash_hook_type(key) {
        Some(ty) => Option::Some(integer_hash_hook_item(key, ty)),
        None => match key {
            CORE_STRING_LEN_RUNTIME_KEY => Option::Some(string_len_hook_item()),
            CORE_STRING_GET_RUNTIME_KEY => Option::Some(string_get_hook_item()),
            CORE_STRING_BYTE_GET_RUNTIME_KEY => Option::Some(string_byte_get_hook_item()),
            CORE_STRING_BYTE_SLICE_RUNTIME_KEY => Option::Some(string_byte_slice_hook_item()),
            CORE_STRING_TO_BYTES_RUNTIME_KEY => Option::Some(string_to_bytes_hook_item()),
            CORE_CHAR_TO_STRING_RUNTIME_KEY => Option::Some(char_to_string_hook_item()),
            CORE_CHAR_FROM_UINT32_RUNTIME_KEY => Option::Some(char_from_uint32_hook_item()),
            CORE_FLOAT32_TO_STRING_RUNTIME_KEY => {
                Option::Some(float_to_string_hook_item(key, Type::Float32, "32"))
            },
            CORE_FLOAT64_TO_STRING_RUNTIME_KEY => {
                Option::Some(float_to_string_hook_item(key, Type::Float64, "64"))
            },
            CORE_FLOAT32_HASH_RUNTIME_KEY => Option::Some(
                float_hash_hook_item(key, Type::Float32, "_goml_math.Float32bits"),
            ),
            CORE_FLOAT64_HASH_RUNTIME_KEY => Option::Some(
                float_hash_hook_item(key, Type::Float64, "_goml_math.Float64bits"),
            ),
            CORE_STRING_HASH_RUNTIME_KEY => Option::Some(string_hash_hook_item()),
            _ => Option::None,
        },
    }
}
