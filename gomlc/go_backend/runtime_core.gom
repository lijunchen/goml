package go_backend;

use gomlc::tast;

fn core_function_item(key: string, params: Vec[(string, Type)], ret_ty: Type, stmts: Vec[Stmt]) -> Item {
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn core_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Var { name }, args }
}

fn core_len(value: Expr) -> Expr {
    let args: Vec[Expr] = Vec::new();
    args.push(value);
    core_call("len", args)
}

fn core_int(value: Expr) -> Expr {
    Expr::Convert { ty: Type::Int, expr: value }
}

fn core_tuple_type2(first: tast::Type, second: tast::Type) -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(first);
    values.push(second);
    lower_type(tast::Type::Tuple { items: values })
}

fn core_tuple_type3(first: tast::Type, second: tast::Type, third: tast::Type) -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(first);
    values.push(second);
    values.push(third);
    lower_type(tast::Type::Tuple { items: values })
}

fn core_tuple_expr(ty: Type, values: Vec[Expr]) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in range(0, values.len()) {
        fields.push(("_" + index.to_string(), values[index]))
    };
    Expr::StructLiteral { ty, fields }
}

fn string_len_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return { expr: Option::Some(core_int(core_len(Expr::Var { name: "s" }))) });
    core_function_item("core.string_len", params, Type::Int, stmts)
}

fn string_decode_utf8_at_native_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let returns: Vec[Type] = Vec::new();
    returns.push(Type::Bool);
    returns.push(Type::Char);
    returns.push(Type::Int);
    let invalid: Vec[Expr] = Vec::new();
    invalid.push(Expr::Bool { value: false });
    invalid.push(Expr::Int { value: "0" });
    invalid.push(Expr::Int { value: "0" });
    let invalid_index_stmts: Vec[Stmt] = Vec::new();
    invalid_index_stmts.push(Stmt::ReturnMulti { exprs: invalid });
    let length = core_int(core_len(Expr::Var { name: "s" }));
    let invalid_index = Expr::Binary {
        op: BinaryOp::Or,
        lhs: Expr::Binary {
            op: BinaryOp::Less,
            lhs: Expr::Var { name: "i" },
            rhs: Expr::Int { value: "0" },
        },
        rhs: Expr::Binary { op: BinaryOp::GreaterEq, lhs: Expr::Var { name: "i" }, rhs: length },
    };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: invalid_index,
            then_: Block { stmts: invalid_index_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "value", ty: Type::Char, value: Option::None });
    stmts.push(Stmt::Var { name: "width", ty: Type::Named { name: "int" }, value: Option::None });
    let decode_args: Vec[Expr] = Vec::new();
    decode_args.push(
        Expr::Slice {
            base: Expr::Var { name: "s" },
            start: Expr::Var { name: "i" },
            end: core_int(core_len(Expr::Var { name: "s" })),
        },
    );
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("width");
    stmts.push(
        Stmt::MultiAssign { names, value: core_call("_goml_utf8.DecodeRuneInString", decode_args) },
    );
    let invalid_rune_stmts: Vec[Stmt] = Vec::new();
    let invalid_rune: Vec[Expr] = Vec::new();
    invalid_rune.push(Expr::Bool { value: false });
    invalid_rune.push(Expr::Int { value: "0" });
    invalid_rune.push(Expr::Int { value: "0" });
    invalid_rune_stmts.push(Stmt::ReturnMulti { exprs: invalid_rune });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Binary {
                    op: BinaryOp::Eq,
                    lhs: Expr::Var { name: "value" },
                    rhs: Expr::Var { name: "_goml_utf8.RuneError" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::Eq,
                    lhs: Expr::Var { name: "width" },
                    rhs: Expr::Int { value: "1" },
                },
            },
            then_: Block { stmts: invalid_rune_stmts },
            else_: Option::None,
        },
    );
    let valid: Vec[Expr] = Vec::new();
    valid.push(Expr::Bool { value: true });
    valid.push(Expr::Var { name: "value" });
    valid.push(core_int(Expr::Var { name: "width" }));
    stmts.push(Stmt::ReturnMulti { exprs: valid });
    Item::Function(
        Function {
            name: go_generated_ident("_goml_runtime_string_decode_utf8_at_native"),
            params,
            ret_ty: Option::Some(Type::Multi { items: returns }),
            body: Block { stmts },
        },
    )
}

fn string_get_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "valid", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "value", ty: Type::Char, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("valid");
    names.push("value");
    names.push("_");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "s" });
    args.push(Expr::Var { name: "i" });
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: core_call(go_generated_ident("_goml_runtime_string_decode_utf8_at_native"), args),
        },
    );
    let invalid_stmts: Vec[Stmt] = Vec::new();
    invalid_stmts.push(Stmt::Panic { message: "invalid string byte index" });
    stmts.push(
        Stmt::If {
            cond: Expr::Unary { op: UnaryOp::Not, expr: Expr::Var { name: "valid" } },
            then_: Block { stmts: invalid_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "value" }) });
    core_function_item("core.string_get", params, Type::Char, stmts)
}

fn string_byte_get_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Index { base: Expr::Var { name: "s" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    core_function_item("core.string_byte_get", params, Type::Uint8, stmts)
}

fn string_boundary_call(index: string) -> Expr {
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "s" });
    args.push(Expr::Var { name: index });
    core_call(runtime_hook_name("core.string_is_char_boundary"), args)
}

fn string_byte_slice_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("start", Type::Int));
    params.push(("end", Type::Int));
    let invalid_stmts: Vec[Stmt] = Vec::new();
    invalid_stmts.push(Stmt::Panic { message: "invalid string byte slice" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Unary {
                op: UnaryOp::Not,
                expr: Expr::Binary {
                    op: BinaryOp::And,
                    lhs: string_boundary_call("start"),
                    rhs: string_boundary_call("end"),
                },
            },
            then_: Block { stmts: invalid_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Slice {
                    base: Expr::Var { name: "s" },
                    start: Expr::Var { name: "start" },
                    end: Expr::Var { name: "end" },
                },
            ),
        },
    );
    core_function_item("core.string_byte_slice", params, Type::String, stmts)
}

fn string_is_char_boundary_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let out_of_range_stmts: Vec[Stmt] = Vec::new();
    out_of_range_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
    let at_end_stmts: Vec[Stmt] = Vec::new();
    at_end_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: true }) });
    let length = core_int(core_len(Expr::Var { name: "s" }));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Or,
                lhs: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "i" },
                    rhs: Expr::Int { value: "0" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::Greater,
                    lhs: Expr::Var { name: "i" },
                    rhs: length,
                },
            },
            then_: Block { stmts: out_of_range_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "i" },
                rhs: core_int(core_len(Expr::Var { name: "s" })),
            },
            then_: Block { stmts: at_end_stmts },
            else_: Option::None,
        },
    );
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Index { base: Expr::Var { name: "s" }, index: Expr::Var { name: "i" } });
    stmts.push(Stmt::Return { expr: Option::Some(core_call("_goml_utf8.RuneStart", args)) });
    core_function_item("core.string_is_char_boundary", params, Type::Bool, stmts)
}

fn string_decode_utf8_at_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "valid", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "value", ty: Type::Char, value: Option::None });
    stmts.push(Stmt::Var { name: "width", ty: Type::Int, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("valid");
    names.push("value");
    names.push("width");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "s" });
    args.push(Expr::Var { name: "i" });
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: core_call(go_generated_ident("_goml_runtime_string_decode_utf8_at_native"), args),
        },
    );
    let ret_ty = core_tuple_type3(tast::Type::Bool, tast::Type::Char, tast::Type::Int);
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Var { name: "valid" });
    values.push(Expr::Var { name: "value" });
    values.push(Expr::Var { name: "width" });
    stmts.push(Stmt::Return { expr: Option::Some(core_tuple_expr(ret_ty, values)) });
    core_function_item("core.string_decode_utf8_at", params, ret_ty, stmts)
}

fn string_to_bytes_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let elem = tast::Type::Uint8;
    let vec_ty = tast::Type::VecType { elem };
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(
        (
            "items",
            Expr::Convert { ty: Type::Named { name: "[]byte" }, expr: Expr::Var { name: "s" } },
        ),
    );
    let value = Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))) },
            fields,
        },
    };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return { expr: Option::Some(value) });
    core_function_item("core.string_to_bytes", params, lower_type(vec_ty), stmts)
}

fn char_to_string_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", Type::Char));
    let valid_args: Vec[Expr] = Vec::new();
    valid_args.push(Expr::Var { name: "x" });
    let invalid_stmts: Vec[Stmt] = Vec::new();
    invalid_stmts.push(Stmt::Panic { message: "invalid char" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Unary {
                op: UnaryOp::Not,
                expr: core_call("_goml_utf8.ValidRune", valid_args),
            },
            then_: Block { stmts: invalid_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Convert { ty: Type::String, expr: Expr::Var { name: "x" } }),
        },
    );
    core_function_item("core.char_to_string", params, Type::String, stmts)
}

fn char_from_uint32_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("value", Type::Uint32));
    let ret_ty = core_tuple_type2(tast::Type::Bool, tast::Type::Char);
    let invalid_values: Vec[Expr] = Vec::new();
    invalid_values.push(Expr::Bool { value: false });
    invalid_values.push(Expr::Int { value: "0" });
    let invalid_stmts: Vec[Stmt] = Vec::new();
    invalid_stmts.push(Stmt::Return { expr: Option::Some(core_tuple_expr(ret_ty, invalid_values)) });
    let invalid = Expr::Binary {
        op: BinaryOp::Or,
        lhs: Expr::Binary {
            op: BinaryOp::Greater,
            lhs: Expr::Var { name: "value" },
            rhs: Expr::Int { value: "1114111" },
        },
        rhs: Expr::Binary {
            op: BinaryOp::And,
            lhs: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "value" },
                rhs: Expr::Int { value: "55296" },
            },
            rhs: Expr::Binary {
                op: BinaryOp::LessEq,
                lhs: Expr::Var { name: "value" },
                rhs: Expr::Int { value: "57343" },
            },
        },
    };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If { cond: invalid, then_: Block { stmts: invalid_stmts }, else_: Option::None },
    );
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: true });
    values.push(Expr::Convert { ty: Type::Char, expr: Expr::Var { name: "value" } });
    stmts.push(Stmt::Return { expr: Option::Some(core_tuple_expr(ret_ty, values)) });
    core_function_item("core.char_from_uint32", params, ret_ty, stmts)
}

fn float_to_string_hook_item(key: string, ty: Type, bit_size: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", ty));
    let args: Vec[Expr] = Vec::new();
    args.push(
        if key == "core.float32_to_string" {
            Expr::Convert { ty: Type::Float64, expr: Expr::Var { name: "x" } }
        } else {
            Expr::Var { name: "x" }
        },
    );
    args.push(Expr::Int { value: "102" });
    args.push(Expr::Int { value: "-1" });
    args.push(Expr::Int { value: bit_size });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "formatted",
            ty: Type::String,
            value: Option::Some(core_call("_goml_strconv.FormatFloat", args)),
        },
    );
    let positive_stmts: Vec[Stmt] = Vec::new();
    positive_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "inf" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "formatted" },
                rhs: Expr::String { value: "+Inf" },
            },
            then_: Block { stmts: positive_stmts },
            else_: Option::None,
        },
    );
    let negative_stmts: Vec[Stmt] = Vec::new();
    negative_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "-inf" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "formatted" },
                rhs: Expr::String { value: "-Inf" },
            },
            then_: Block { stmts: negative_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "formatted" }) });
    core_function_item(key, params, Type::String, stmts)
}

fn integer_hash_hook_type(key: string) -> Option[Type] {
    if key == "core.int_hash" {
        Option::Some(Type::Int)
    } else if key == "core.int8_hash" {
        Option::Some(Type::Int8)
    } else if key == "core.int16_hash" {
        Option::Some(Type::Int16)
    } else if key == "core.int32_hash" {
        Option::Some(Type::Int32)
    } else if key == "core.int64_hash" {
        Option::Some(Type::Int64)
    } else if key == "core.uint_hash" {
        Option::Some(Type::Uint)
    } else if key == "core.uint8_hash" {
        Option::Some(Type::Uint8)
    } else if key == "core.uint16_hash" {
        Option::Some(Type::Uint16)
    } else if key == "core.uint32_hash" {
        Option::Some(Type::Uint32)
    } else if key == "core.char_hash" {
        Option::Some(Type::Char)
    } else {
        Option::None
    }
}

fn integer_hash_hook_item(key: string, ty: Type) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", ty));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Convert { ty: Type::Uint64, expr: Expr::Var { name: "x" } }),
        },
    );
    core_function_item(key, params, Type::Uint64, stmts)
}

fn float_hash_hook_item(key: string, ty: Type, go_name: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", ty));
    let zero_stmts: Vec[Stmt] = Vec::new();
    zero_stmts.push(Stmt::Return { expr: Option::Some(Expr::Int { value: "0" }) });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "x" },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: zero_stmts },
            else_: Option::None,
        },
    );
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "x" });
    let bits = core_call(go_name, args);
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                if key == "core.float32_hash" {
                    Expr::Convert { ty: Type::Uint64, expr: bits }
                } else {
                    bits
                },
            ),
        },
    );
    core_function_item(key, params, Type::Uint64, stmts)
}

fn string_hash_hook_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(Expr::Int { value: "14695981039346656037" }),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: core_int(core_len(Expr::Var { name: "s" })),
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "h",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Binary {
                    op: BinaryOp::Mul,
                    lhs: Expr::Var { name: "h" },
                    rhs: Expr::Int { value: "1099511628211" },
                },
                rhs: Expr::Convert {
                    ty: Type::Uint64,
                    expr: Expr::Index {
                        base: Expr::Var { name: "s" },
                        index: Expr::Var { name: "i" },
                    },
                },
            },
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "h" }) });
    core_function_item("core.string_hash", params, Type::Uint64, stmts)
}

fn extra_core_runtime_hook_item(key: string) -> Option[Item] {
    match integer_hash_hook_type(key) {
        Some(ty) => Option::Some(integer_hash_hook_item(key, ty)),
        None => if key == "core.string_len" {
            Option::Some(string_len_hook_item())
        } else if key == "core.string_get" {
            Option::Some(string_get_hook_item())
        } else if key == "core.string_byte_get" {
            Option::Some(string_byte_get_hook_item())
        } else if key == "core.string_byte_slice" {
            Option::Some(string_byte_slice_hook_item())
        } else if key == "core.string_is_char_boundary" {
            Option::Some(string_is_char_boundary_hook_item())
        } else if key == "core.string_decode_utf8_at" {
            Option::Some(string_decode_utf8_at_hook_item())
        } else if key == "core.string_to_bytes" {
            Option::Some(string_to_bytes_hook_item())
        } else if key == "core.char_to_string" {
            Option::Some(char_to_string_hook_item())
        } else if key == "core.char_from_uint32" {
            Option::Some(char_from_uint32_hook_item())
        } else if key == "core.float32_to_string" {
            Option::Some(float_to_string_hook_item(key, Type::Float32, "32"))
        } else if key == "core.float64_to_string" {
            Option::Some(float_to_string_hook_item(key, Type::Float64, "64"))
        } else if key == "core.float32_hash" {
            Option::Some(float_hash_hook_item(key, Type::Float32, "_goml_math.Float32bits"))
        } else if key == "core.float64_hash" {
            Option::Some(float_hash_hook_item(key, Type::Float64, "_goml_math.Float64bits"))
        } else if key == "core.string_hash" {
            Option::Some(string_hash_hook_item())
        } else {
            Option::None
        },
    }
}
