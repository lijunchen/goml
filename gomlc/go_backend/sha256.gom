fn rotate_right(value: uint32, count: uint32) -> uint32 {
    (value >> count) | (value << (32 - count))
}

fn padded_byte(
    value: bytes::Bytes,
    index: int,
    padded_len: int,
    bit_len: uint64,
) -> byte {
    if index < value.len() {
        value.get(index)
    } else if index == value.len() {
        128
    } else if index >= padded_len - 8 {
        let shift = ((padded_len - 1 - index) * 8) as uint64;
        ((bit_len >> shift) & 255) as byte
    } else {
        0
    }
}

fn message_word(
    value: bytes::Bytes,
    offset: int,
    padded_len: int,
    bit_len: uint64,
) -> uint32 {
    ((padded_byte(value, offset, padded_len, bit_len) as uint32) << 24)
        | ((padded_byte(value, offset + 1, padded_len, bit_len) as uint32) << 16)
        | ((padded_byte(value, offset + 2, padded_len, bit_len) as uint32) << 8)
        | (padded_byte(value, offset + 3, padded_len, bit_len) as uint32)
}

fn write_hex_word(builder: text::StringBuilder, value: uint32) -> unit {
    let digits = "0123456789abcdef";
    for index in range(0, 8) {
        let shift = ((7 - index) * 4) as uint32;
        builder.write_char(digits.get(((value >> shift) & 15) as int))
    }
}

pub fn sha256_bytes_hex(value: bytes::Bytes) -> string {
    let constants = sha256_constants();
    let mut padded_len = value.len() + 9;
    while padded_len % 64 != 0 {
        padded_len += 1;
    };
    let bit_len = (value.len() as uint64) * 8;
    let mut h0 = 1779033703;
    let mut h1 = 3144134277;
    let mut h2 = 1013904242;
    let mut h3 = 2773480762;
    let mut h4 = 1359893119;
    let mut h5 = 2600822924;
    let mut h6 = 528734635;
    let mut h7 = 1541459225;
    let words: Vec[uint32] = Vec::with_capacity(64);
    for _ in range(0, 64) {
        words.push(0)
    };
    for chunk in range(0, padded_len / 64) {
        for index in range(0, 16) {
            words.set(
                index,
                message_word(
                    value,
                    chunk * 64 + index * 4,
                    padded_len,
                    bit_len,
                ),
            )
        };
        for index in range(16, 64) {
            let first = words.get(index - 15);
            let second = words.get(index - 2);
            let sigma0 = rotate_right(first, 7)
                ^ rotate_right(first, 18)
                ^ (first >> 3);
            let sigma1 = rotate_right(second, 17)
                ^ rotate_right(second, 19)
                ^ (second >> 10);
            words.set(
                index,
                words.get(index - 16)
                    + sigma0
                    + words.get(index - 7)
                    + sigma1,
            )
        };
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        let mut f = h5;
        let mut g = h6;
        let mut h = h7;
        for index in range(0, 64) {
            let sigma1 = rotate_right(e, 6)
                ^ rotate_right(e, 11)
                ^ rotate_right(e, 25);
            let choice = (e & f) ^ (~e & g);
            let temp1 = h
                + sigma1
                + choice
                + constants.get(index)
                + words.get(index);
            let sigma0 = rotate_right(a, 2)
                ^ rotate_right(a, 13)
                ^ rotate_right(a, 22);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = sigma0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 + temp2;
        };
        h0 += a;
        h1 += b;
        h2 += c;
        h3 += d;
        h4 += e;
        h5 += f;
        h6 += g;
        h7 += h;
    };
    let builder = text::StringBuilder::with_capacity(64);
    write_hex_word(builder, h0);
    write_hex_word(builder, h1);
    write_hex_word(builder, h2);
    write_hex_word(builder, h3);
    write_hex_word(builder, h4);
    write_hex_word(builder, h5);
    write_hex_word(builder, h6);
    write_hex_word(builder, h7);
    builder.finish()
}

pub fn sha256_hex(value: string) -> string {
    sha256_bytes_hex(bytes::Bytes::from_string(value))
}

pub fn sha256_prefix(value: string) -> string {
    sha256_hex(value).byte_slice(0, 32)
}
