package go_backend;

use gomlc::anf;
use gomlc::resources;
use gomlc::repr;
use std::cmp;
use std::collections;
use std::text;

struct DynMethod {
    name: string,
    dispatch_trait: string,
    params: Vec[repr::Type],
    ret_ty: repr::Type,
}

fn hashmap_name(key: repr::Type, value: repr::Type) -> string {
    go_generated_ident("hashmap_" + go_ident(encode_type(key) + "_" + encode_type(value)) + "_x")
}

fn ref_struct_name(elem: repr::Type) -> string {
    go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x")
}

pub fn runtime_helper_name(prefix: string, ty: repr::Type) -> string {
    go_generated_ident(prefix + "__" + go_ident(encode_type(ty)))
}

pub fn runtime_hook_name(key: string) -> string {
    let builder = text::StringBuilder::with_capacity("_goml_runtime_".byte_len() + key.byte_len());
    builder.write_string("_goml_runtime_");
    for character in key.chars() {
        if character == '.' {
            builder.write_char('_')
        } else {
            builder.write_char(character)
        }
    }
    go_generated_ident(builder.finish())
}

fn missing_base_item() -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    let print_args: Vec[Expr] = Vec::[];
    print_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::String { value: "missing: " },
            rhs: Expr::Var { name: "s" },
        },
    );
    let panic_args: Vec[Expr] = Vec::[];
    panic_args.push(Expr::String { value: "" });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "println" }, args: print_args } },
    );
    stmts.push(
        Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "panic" }, args: panic_args } },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: go_generated_ident("_goml_intrinsic_missing"),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn missing_runtime_item(ty: repr::Type) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::Var { name: "s" });
    let ret_ty = lower_type(ty);
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Expr {
            expr: Expr::Call {
                func: Expr::Var { name: go_generated_ident("_goml_intrinsic_missing") },
                args,
            },
        },
    );
    stmts.push(Stmt::Var { name: "ret", ty: ret_ty, value: Option::None });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "ret" }) });
    Item::Function(
        Function {
            name: runtime_helper_name("missing", ty),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn once_cell_field(name: string) -> Expr {
    Expr::Field { expr: Expr::Var { name: "cell" }, field_name: name }
}

fn once_cell_method(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Field { expr: Expr::Var { name: "cell" }, field_name: name }, args }
}

fn once_cell_lock_stmt(method: string) -> Stmt {
    Stmt::Expr { expr: once_cell_method("mutex." + method, Vec::[]) }
}

fn once_cell_new_item(instance: repr::TypeInstance) -> Item {
    let owner = repr::Type::Named { name: instance.name };
    let fields: Vec[(string, Expr)] = Vec::[];
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Var {
            name: "cell",
            ty: lower_type(owner),
            value: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: Type::Named { name: go_user_type_name(instance.name) },
                        fields,
                    },
                },
            ),
        },
    );
    let cond_args: Vec[Expr] = Vec::[];
    cond_args.push(Expr::Unary { op: UnaryOp::Address, expr: once_cell_field("mutex") });
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "cond",
            value: Expr::Call { func: Expr::Var { name: "_goml_sync.NewCond" }, args: cond_args },
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "cell" }) });
    Item::Function(
        Function {
            name: runtime_helper_name("once_cell_new", owner),
            params: Vec::[],
            ret_ty: Option::Some(lower_type(owner)),
            body: Block { stmts },
        },
    )
}

fn once_cell_get_or_init_item(instance: repr::TypeInstance) -> Item {
    let owner = repr::Type::Named { name: instance.name };
    let value_ty = instance.args[0];
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("cell", lower_type(owner)));
    params.push(("init", Type::Func { params: Vec::[], ret_ty: lower_type(value_ty) }));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Var {
            name: "goroutine",
            ty: Type::Uint64,
            value: Option::Some(
                Expr::Call {
                    func: Expr::Var { name: go_generated_ident("_goml_once_cell_goroutine_id") },
                    args: Vec::[],
                },
            ),
        },
    );
    stmts.push(once_cell_lock_stmt("Lock"));
    let loop_stmts: Vec[Stmt] = Vec::[];
    let ready_stmts: Vec[Stmt] = Vec::[];
    ready_stmts.push(once_cell_lock_stmt("Unlock"));
    ready_stmts.push(Stmt::Return { expr: Option::Some(once_cell_field("value")) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: once_cell_field("state"),
                rhs: Expr::Int { value: "2" },
            },
            then_: Block { stmts: ready_stmts },
            else_: Option::None,
        },
    );
    let initializing_stmts: Vec[Stmt] = Vec::[];
    let recursive_stmts: Vec[Stmt] = Vec::[];
    recursive_stmts.push(once_cell_lock_stmt("Unlock"));
    let panic_args: Vec[Expr] = Vec::[];
    panic_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::String { value: "recursive OnceCell initialization: " },
            rhs: once_cell_field("name"),
        },
    );
    recursive_stmts.push(
        Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "panic" }, args: panic_args } },
    );
    initializing_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: once_cell_field("owner"),
                rhs: Expr::Var { name: "goroutine" },
            },
            then_: Block { stmts: recursive_stmts },
            else_: Option::None,
        },
    );
    initializing_stmts.push(Stmt::Expr { expr: once_cell_method("cond.Wait", Vec::[]) });
    initializing_stmts.push(Stmt::Continue);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: once_cell_field("state"),
                rhs: Expr::Int { value: "1" },
            },
            then_: Block { stmts: initializing_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "state",
            value: Expr::Int { value: "1" },
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "owner",
            value: Expr::Var { name: "goroutine" },
        },
    );
    loop_stmts.push(once_cell_lock_stmt("Unlock"));
    loop_stmts.push(
        Stmt::Var {
            name: "initialized",
            ty: lower_type(value_ty),
            value: Option::Some(Expr::Call { func: Expr::Var { name: "init" }, args: Vec::[] }),
        },
    );
    loop_stmts.push(once_cell_lock_stmt("Lock"));
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "value",
            value: Expr::Var { name: "initialized" },
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "state",
            value: Expr::Int { value: "2" },
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "owner",
            value: Expr::Int { value: "0" },
        },
    );
    loop_stmts.push(Stmt::Expr { expr: once_cell_method("cond.Broadcast", Vec::[]) });
    loop_stmts.push(once_cell_lock_stmt("Unlock"));
    loop_stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "initialized" }) });
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    Item::Function(
        Function {
            name: runtime_helper_name("once_cell_get_or_init", owner),
            params,
            ret_ty: Option::Some(lower_type(value_ty)),
            body: Block { stmts },
        },
    )
}

pub fn emit_missing_base_item(items: Vec[Item], missing_types: Vec[repr::Type]) -> unit {
    if !missing_types.is_empty() {
        items.push(missing_base_item())
    } else {}
}

fn unit_to_string_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", Type::Unit));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "()" }) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn bool_to_string_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", Type::Bool));
    let then_stmts: Vec[Stmt] = Vec::[];
    then_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "true" }) });
    let else_stmts: Vec[Stmt] = Vec::[];
    else_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "false" }) });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "x" },
            then_: Block { stmts: then_stmts },
            else_: Option::Some(Block { stmts: else_stmts }),
        },
    );
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn integer_to_string_hook_item(key: string, ty: Type) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("x", ty));
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::String { value: "%d" });
    args.push(Expr::Var { name: "x" });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Call { func: Expr::Var { name: "_goml_fmt.Sprintf" }, args }),
        },
    );
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn string_output_hook_item(key: string, go_name: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("s", Type::String));
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::Var { name: "s" });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: go_name }, args } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn string_from_utf8_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    let byte_vec = repr::Type::VecType { elem: repr::Type::Uint8 };
    params.push(("bytes", lower_type(byte_vec)));
    let tuple_items: Vec[repr::Type] = Vec::[];
    tuple_items.push(repr::Type::Bool);
    tuple_items.push(repr::Type::String);
    let tuple_ty = lower_type(repr::Type::Tuple { items: tuple_items });
    let fields: Vec[(string, Expr)] = Vec::[];
    fields.push(("_0", Expr::Bool { value: true }));
    fields.push(
        (
            "_1",
            Expr::Convert {
                ty: Type::String,
                expr: Expr::Field { expr: Expr::Var { name: "bytes" }, field_name: "items" },
            },
        ),
    );
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Return { expr: Option::Some(Expr::StructLiteral { ty: tuple_ty, fields }) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(tuple_ty),
            body: Block { stmts },
        },
    )
}

fn string_concat_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("values", lower_type(repr::Type::VecType { elem: repr::Type::String })));
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::Field { expr: Expr::Var { name: "values" }, field_name: "items" });
    args.push(Expr::String { value: "" });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Call { func: Expr::Var { name: "_goml_strings.Join" }, args }),
        },
    );
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn string_parse_float_hook_item(key: string, bit_size: string) -> Item {
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("value", Type::String));
    let tuple_items: Vec[repr::Type] = Vec::[];
    tuple_items.push(repr::Type::Bool);
    tuple_items.push(repr::Type::Float64);
    let tuple_ty = lower_type(repr::Type::Tuple { items: tuple_items });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Var { name: "parsed", ty: Type::Float64, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::[];
    names.push("parsed");
    names.push("err");
    let args: Vec[Expr] = Vec::[];
    args.push(Expr::Var { name: "value" });
    args.push(Expr::Int { value: bit_size });
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: Expr::Call { func: Expr::Var { name: "_goml_strconv.ParseFloat" }, args },
        },
    );
    let fields: Vec[(string, Expr)] = Vec::[];
    fields.push(
        ("_0", Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "err" }, rhs: Expr::Nil }),
    );
    fields.push(("_1", Expr::Var { name: "parsed" }));
    stmts.push(Stmt::Return { expr: Option::Some(Expr::StructLiteral { ty: tuple_ty, fields }) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(tuple_ty),
            body: Block { stmts },
        },
    )
}

#[derive(PartialEq, Eq)]
enum RuntimeImport {
    Bytes,
    Context,
    CryptoRand,
    Fmt,
    Errors,
    Hash,
    Io,
    Math,
    Os,
    Exec,
    Filepath,
    Reflect,
    Sha256,
    Slices,
    Strconv,
    Strings,
    Sync,
    Runtime,
    Syscall,
    Time,
}

fn require_runtime_import(imports: Vec[RuntimeImport], value: RuntimeImport) -> unit {
    if !imports.contains(value) {
        imports.push(value)
    } else {}
}

fn collect_core_runtime_imports(imports: Vec[RuntimeImport], hook: resources::CoreRuntimeHook) -> unit {
    match hook {
        IntToString | Int8ToString | Int16ToString | Int32ToString | Int64ToString | UintToString | Uint8ToString | Uint16ToString | Uint32ToString | Uint64ToString | StringPrint | StringPrintln => require_runtime_import(
            imports,
            RuntimeImport::Fmt,
        ),
        StringParseFloat32 | StringParseFloat64 | Float32ToString | Float64ToString => {
            require_runtime_import(imports, RuntimeImport::Strconv)
        },
        Float32Hash | Float64Hash => require_runtime_import(imports, RuntimeImport::Math),
        StringConcat => require_runtime_import(imports, RuntimeImport::Strings),
        UnitToString | BoolToString | StringLen | StringGet | StringByteGet | StringByteSlice | StringToBytes | StringFromUtf8 | CharToString | CharFromUint32 | IntHash | Int8Hash | Int16Hash | Int32Hash | Int64Hash | CharHash | UintHash | Uint8Hash | Uint16Hash | Uint32Hash | StringHash => (),
    }
}

fn collect_fs_runtime_imports(imports: Vec[RuntimeImport], hook: resources::FsRuntimeHook) -> unit {
    match hook {
        Canonicalize => require_runtime_import(imports, RuntimeImport::Filepath),
        Sha256File => {
            require_runtime_import(imports, RuntimeImport::Fmt);
            require_runtime_import(imports, RuntimeImport::Hash);
            require_runtime_import(imports, RuntimeImport::Io);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Sha256)
        },
        ReadBytesV2 | WriteBytesV2 | PathOperationV2 | MetadataV2 => {
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
        AtomicWriteV2 => {
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall);
            require_runtime_import(imports, RuntimeImport::Filepath)
        },
        ReadFile | WriteFile | ReadBytes | WriteBytes | CreateDirAll | RemoveFile | RemoveDirAll | FileExists | IsFile | IsDir | ReadDir | ReadDirV2 => {
            require_runtime_import(imports, RuntimeImport::Os)
        },
    }
}

fn collect_io_runtime_imports(imports: Vec[RuntimeImport], hook: resources::IoRuntimeHook) -> unit {
    match hook {
        Print | Println => require_runtime_import(imports, RuntimeImport::Fmt),
        Eprint => {
            require_runtime_import(imports, RuntimeImport::Fmt);
            require_runtime_import(imports, RuntimeImport::Os)
        },
        ReadStdin | ReadStdinExact => {
            require_runtime_import(imports, RuntimeImport::Io);
            require_runtime_import(imports, RuntimeImport::Os)
        },
        ReadStdinV2 | ReadStdinExactV2 => {
            require_runtime_import(imports, RuntimeImport::Io);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
        WriteStdout | WriteStderr => require_runtime_import(imports, RuntimeImport::Os),
        WriteStdoutV2 | WriteStderrV2 => {
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
    }
}

fn collect_path_runtime_imports(imports: Vec[RuntimeImport], hook: resources::PathRuntimeHook) -> unit {
    require_runtime_import(imports, RuntimeImport::Filepath);
    match hook {
        Extension | FileStem | WithExtension => {
            require_runtime_import(imports, RuntimeImport::Strings)
        },
        Separator => require_runtime_import(imports, RuntimeImport::Os),
        Join | Clean | IsAbsolute | Parent | FileName | Absolute | Relative => (),
    }
}

fn collect_process_runtime_imports(imports: Vec[RuntimeImport], hook: resources::ProcessRuntimeHook) -> unit {
    match hook {
        Exit => require_runtime_import(imports, RuntimeImport::Os),
        LookPath => require_runtime_import(imports, RuntimeImport::Exec),
        Output | Status => {
            require_runtime_import(imports, RuntimeImport::Bytes);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Exec)
        },
        OutputTimeout | StatusTimeout => {
            require_runtime_import(imports, RuntimeImport::Bytes);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Exec);
            require_runtime_import(imports, RuntimeImport::Context);
            require_runtime_import(imports, RuntimeImport::Time)
        },
        OutputCancel | StatusCancel => {
            require_runtime_import(imports, RuntimeImport::Bytes);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Exec);
            require_runtime_import(imports, RuntimeImport::Context);
            require_runtime_import(imports, RuntimeImport::Sync);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
    }
}

fn collect_task_runtime_imports(imports: Vec[RuntimeImport], hook: resources::TaskRuntimeHook) -> unit {
    require_runtime_import(imports, RuntimeImport::Context);
    require_runtime_import(imports, RuntimeImport::Sync);
    match hook {
        Sleep => require_runtime_import(imports, RuntimeImport::Time),
        ScopeNew | ScopeRun | ScopeSpawn | ScopeTrySpawn | ScopeCancel | ScopeFinish | ScopeCancelled | ActiveScopeCount => (),
    }
}

fn collect_standard_runtime_imports(
    imports: Vec[RuntimeImport],
    hook: resources::StandardRuntimeHook,
) -> unit {
    match hook {
        Env(Args | CurrentDir | CurrentExe | Var | Vars) => {
            require_runtime_import(imports, RuntimeImport::Os)
        },
        Fs(hook) => collect_fs_runtime_imports(imports, hook),
        Io(hook) => collect_io_runtime_imports(imports, hook),
        Path(hook) => collect_path_runtime_imports(imports, hook),
        Process(hook) => collect_process_runtime_imports(imports, hook),
        TestingFail => {
            require_runtime_import(imports, RuntimeImport::Fmt);
            require_runtime_import(imports, RuntimeImport::Os)
        },
        Num(ParseInt | ParseUint | ParseFloat32 | ParseFloat64) => {
            require_runtime_import(imports, RuntimeImport::Strconv)
        },
        Math(Float32Unary | Float32Pow) => {
            require_runtime_import(imports, RuntimeImport::Math)
        },
        Crypto(RandomBytes) => require_runtime_import(imports, RuntimeImport::CryptoRand),
        Time(MonotonicNanoseconds | UnixNanoseconds | SleepNanoseconds) => {
            require_runtime_import(imports, RuntimeImport::Time)
        },
        Task(hook) => collect_task_runtime_imports(imports, hook),
    }
}

fn collect_runtime_hook_imports(imports: Vec[RuntimeImport], hook: resources::RuntimeHook) -> unit {
    match hook {
        Core(hook) => collect_core_runtime_imports(imports, hook),
        Standard(hook) => collect_standard_runtime_imports(imports, hook),
    }
}

fn runtime_hook_uses_structured_error(hook: resources::RuntimeHook) -> bool {
    match hook {
        Standard(Fs(ReadBytesV2 | WriteBytesV2 | PathOperationV2 | MetadataV2 | AtomicWriteV2)) | Standard(Io(ReadStdinV2 | ReadStdinExactV2 | WriteStdoutV2 | WriteStderrV2)) => true,
        Core(_) | Standard(_) => false,
    }
}

fn needs_structured_runtime_error(hooks: Vec[resources::RuntimeHook]) -> bool {
    for hook in hooks {
        if runtime_hook_uses_structured_error(hook) {
            return true
        } else {}
    }
    false
}

fn runtime_hook_needs_task_support(hook: resources::RuntimeHook) -> bool {
    match hook {
        Core(_) => false,
        Standard(Task(_)) => true,
        Standard(Process(process)) => match process {
            OutputCancel | StatusCancel => true,
            Exit | LookPath | Output | OutputTimeout | Status | StatusTimeout => false,
        },
        Standard(Env(_) | Fs(_) | Io(_) | Path(_) | TestingFail | Num(_) | Math(_) | Crypto(_) | Time(_)) => false,
    }
}

fn emit_runtime_import_items(items: Vec[Item], required: Vec[RuntimeImport]) -> unit {
    if required.is_empty() {
        return
    } else {};
    let imports: Vec[(string, string)] = Vec::[];
    if required.contains(RuntimeImport::Bytes) {
        imports.push(("_goml_bytes", "bytes"))
    } else {};
    if required.contains(RuntimeImport::Context) {
        imports.push(("_goml_context", "context"))
    } else {};
    if required.contains(RuntimeImport::CryptoRand) {
        imports.push(("_goml_cryptorand", "crypto/rand"))
    } else {};
    if required.contains(RuntimeImport::Fmt) {
        imports.push(("_goml_fmt", "fmt"))
    } else {};
    if required.contains(RuntimeImport::Errors) {
        imports.push(("_goml_errors", "errors"))
    } else {};
    if required.contains(RuntimeImport::Hash) {
        imports.push(("_goml_hash", "hash"))
    } else {};
    if required.contains(RuntimeImport::Io) {
        imports.push(("_goml_io", "io"))
    } else {};
    if required.contains(RuntimeImport::Math) {
        imports.push(("_goml_math", "math"))
    } else {};
    if required.contains(RuntimeImport::Os) {
        imports.push(("_goml_os", "os"))
    } else {};
    if required.contains(RuntimeImport::Exec) {
        imports.push(("_goml_exec", "os/exec"))
    } else {};
    if required.contains(RuntimeImport::Filepath) {
        imports.push(("_goml_filepath", "path/filepath"))
    } else {};
    if required.contains(RuntimeImport::Reflect) {
        imports.push(("_goml_reflect", "reflect"))
    } else {};
    if required.contains(RuntimeImport::Sha256) {
        imports.push(("_goml_sha256", "crypto/sha256"))
    } else {};
    if required.contains(RuntimeImport::Slices) {
        imports.push(("_goml_slices", "slices"))
    } else {};
    if required.contains(RuntimeImport::Strconv) {
        imports.push(("_goml_strconv", "strconv"))
    } else {};
    if required.contains(RuntimeImport::Strings) {
        imports.push(("_goml_strings", "strings"))
    } else {};
    if required.contains(RuntimeImport::Sync) {
        imports.push(("_goml_sync", "sync"))
    } else {};
    if required.contains(RuntimeImport::Runtime) {
        imports.push(("_goml_runtime_pkg", "runtime"))
    } else {};
    if required.contains(RuntimeImport::Syscall) {
        imports.push(("_goml_syscall", "syscall"))
    } else {};
    if required.contains(RuntimeImport::Time) {
        imports.push(("_goml_time", "time"))
    } else {};
    items.push(Item::ImportGroup(imports))
}

fn once_cell_goroutine_id_item() -> Item {
    let bytes_ty = Type::Slice { elem: Type::Uint8 };
    let make_args: Vec[Expr] = Vec::[];
    make_args.push(Expr::Int { value: "64" });
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Var {
            name: "buffer",
            ty: bytes_ty,
            value: Option::Some(Expr::Make { ty: bytes_ty, args: make_args }),
        },
    );
    let stack_args: Vec[Expr] = Vec::[];
    stack_args.push(Expr::Var { name: "buffer" });
    stack_args.push(Expr::Bool { value: false });
    stmts.push(
        Stmt::Var {
            name: "length",
            ty: Type::Int,
            value: Option::Some(
                Expr::Call { func: Expr::Var { name: "_goml_runtime_pkg.Stack" }, args: stack_args },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "index", ty: Type::Int, value: Option::Some(Expr::Int { value: "10" }) },
    );
    stmts.push(
        Stmt::Var {
            name: "result",
            ty: Type::Uint64,
            value: Option::Some(Expr::Int { value: "0" }),
        },
    );
    let digit = Expr::Index {
        base: Expr::Var { name: "buffer" },
        index: Expr::Var { name: "index" },
    };
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    let loop_stmts: Vec[Stmt] = Vec::[];
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "index" },
                rhs: Expr::Var { name: "length" },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    let invalid_stmts: Vec[Stmt] = Vec::[];
    invalid_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Or,
                lhs: Expr::Binary { op: BinaryOp::Less, lhs: digit, rhs: Expr::Int { value: "48" } },
                rhs: Expr::Binary {
                    op: BinaryOp::Greater,
                    lhs: digit,
                    rhs: Expr::Int { value: "57" },
                },
            },
            then_: Block { stmts: invalid_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "result",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Binary {
                    op: BinaryOp::Mul,
                    lhs: Expr::Var { name: "result" },
                    rhs: Expr::Int { value: "10" },
                },
                rhs: Expr::Convert {
                    ty: Type::Uint64,
                    expr: Expr::Binary {
                        op: BinaryOp::Sub,
                        lhs: digit,
                        rhs: Expr::Int { value: "48" },
                    },
                },
            },
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "index",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "index" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "result" }) });
    Item::Function(
        Function {
            name: go_generated_ident("_goml_once_cell_goroutine_id"),
            params: Vec::[],
            ret_ty: Option::Some(Type::Uint64),
            body: Block { stmts },
        },
    )
}

pub fn emit_runtime_hook_items(
    items: Vec[Item],
    hooks: Vec[resources::RuntimeHook],
    intrinsics: Vec[string],
) -> unit {
    let required_imports: Vec[RuntimeImport] = Vec::[];
    for hook in hooks {
        collect_runtime_hook_imports(required_imports, hook)
    }
    for intrinsic in intrinsics {
        if intrinsic == "ref.ptr_hash" {
            require_runtime_import(required_imports, RuntimeImport::Reflect)
        } else if intrinsic == "vec.with_capacity" || intrinsic == "vec.reserve" {
            require_runtime_import(required_imports, RuntimeImport::Slices)
        } else if intrinsic == "channel.send_cancel" || intrinsic == "channel.recv_cancel" {
            require_runtime_import(required_imports, RuntimeImport::Context);
            require_runtime_import(required_imports, RuntimeImport::Sync)
        } else if intrinsic == "once_cell.new" || intrinsic == "once_cell.get_or_init" {
            require_runtime_import(required_imports, RuntimeImport::Sync);
            require_runtime_import(required_imports, RuntimeImport::Runtime)
        } else {}
    }
    let uses_structured_error = needs_structured_runtime_error(hooks);
    if uses_structured_error {
        require_runtime_import(required_imports, RuntimeImport::Errors);
        require_runtime_import(required_imports, RuntimeImport::Io);
        require_runtime_import(required_imports, RuntimeImport::Os);
        require_runtime_import(required_imports, RuntimeImport::Syscall)
    } else {};
    emit_runtime_import_items(items, required_imports);
    if intrinsics.contains("once_cell.new")
        || intrinsics.contains("once_cell.get_or_init") {
        items.push(once_cell_goroutine_id_item())
    } else {};
    let mut needs_task_support = false;
    for hook in hooks {
        if runtime_hook_needs_task_support(hook) {
            needs_task_support = true;
        } else {}
    }
    for intrinsic in intrinsics {
        if intrinsic == "channel.send_cancel" || intrinsic == "channel.recv_cancel" {
            needs_task_support = true;
        } else {}
    }
    if needs_task_support {
        for item in task_runtime_support_items() {
            items.push(item)
        }
    } else {};
    if uses_structured_error {
        items.push(std_runtime_error_kind_item());
        items.push(std_runtime_error_raw_code_item())
    } else {};
    for spec in resources::runtime_abi_specs() {
        if hooks.contains(spec.hook) {
            match spec.hook {
                Core(hook) => items.push(core_runtime_hook_item(hook, spec.key)),
                Standard(hook) => {
                    match hook {
                        Time(MonotonicNanoseconds) => {
                            items.push(std_time_monotonic_origin_item())
                        },
                        Env(_) | Fs(_) | Io(_) | Path(_) | Process(_) | TestingFail | Num(_) | Math(_) | Crypto(_) | Time(UnixNanoseconds | SleepNanoseconds) | Task(_) => (),
                    };
                    items.push(standard_runtime_hook_item(hook, spec.key))
                },
            }
        } else {}
    }
}

pub fn ref_helper_name(prefix: string, ref_ty: repr::Type) -> string {
    runtime_helper_name(prefix, ref_ty)
}

fn array_runtime_items(array_ty: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    match repr::resolve_type(array_ty) {
        Array { len: _, elem } => {
            let lowered_array = lower_type(array_ty);
            let lowered_elem = lower_type(elem);
            let get_params: Vec[(string, Type)] = Vec::[];
            get_params.push(("arr", lowered_array));
            get_params.push(("index", Type::Int));
            let get_stmts: Vec[Stmt] = Vec::[];
            get_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Index {
                            base: Expr::Var { name: "arr" },
                            index: Expr::Var { name: "index" },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("array_get", array_ty),
                        params: get_params,
                        ret_ty: Option::Some(lowered_elem),
                        body: Block { stmts: get_stmts },
                    },
                ),
            );
            let set_params: Vec[(string, Type)] = Vec::[];
            set_params.push(("arr", lowered_array));
            set_params.push(("index", Type::Int));
            set_params.push(("value", lowered_elem));
            let set_stmts: Vec[Stmt] = Vec::[];
            set_stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Var { name: "arr" },
                    index: Expr::Var { name: "index" },
                    value: Expr::Var { name: "value" },
                },
            );
            set_stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "arr" }) });
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("array_set", array_ty),
                        params: set_params,
                        ret_ty: Option::Some(lowered_array),
                        body: Block { stmts: set_stmts },
                    },
                ),
            )
        },
        _ => (),
    };
    result
}

fn vec_runtime_items(vec_ty: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    match repr::resolve_type(vec_ty) {
        VecType { elem } => {
            let lowered_vec = lower_type(vec_ty);
            let lowered_elem = lower_type(elem);
            let new_fields: Vec[(string, Expr)] = Vec::[];
            new_fields.push(("items", Expr::Nil));
            let new_stmts: Vec[Stmt] = Vec::[];
            new_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Unary {
                            op: UnaryOp::Address,
                            expr: Expr::StructLiteral {
                                ty: Type::Named {
                                    name: go_generated_ident(
                                        "_goml_vec_" + go_ident(encode_type(elem)),
                                    ),
                                },
                                fields: new_fields,
                            },
                        },
                    ),
                },
            );
            let new_params: Vec[(string, Type)] = Vec::[];
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_new", vec_ty),
                        params: new_params,
                        ret_ty: Option::Some(lowered_vec),
                        body: Block { stmts: new_stmts },
                    },
                ),
            );
            let with_capacity_params: Vec[(string, Type)] = Vec::[];
            with_capacity_params.push(("capacity", Type::Int));
            let grow_args: Vec[Expr] = Vec::[];
            grow_args.push(
                Expr::ArrayLiteral { ty: Type::Slice { elem: lowered_elem }, items: Vec::[] },
            );
            grow_args.push(
                Expr::Convert {
                    ty: Type::Named { name: "int" },
                    expr: Expr::Var { name: "capacity" },
                },
            );
            let with_capacity_fields: Vec[(string, Expr)] = Vec::[];
            with_capacity_fields.push(
                (
                    "items",
                    Expr::Call { func: Expr::Var { name: "_goml_slices.Grow" }, args: grow_args },
                ),
            );
            let with_capacity_stmts: Vec[Stmt] = Vec::[];
            with_capacity_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Unary {
                            op: UnaryOp::Address,
                            expr: Expr::StructLiteral {
                                ty: Type::Named {
                                    name: go_generated_ident(
                                        "_goml_vec_" + go_ident(encode_type(elem)),
                                    ),
                                },
                                fields: with_capacity_fields,
                            },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_with_capacity", vec_ty),
                        params: with_capacity_params,
                        ret_ty: Option::Some(lowered_vec),
                        body: Block { stmts: with_capacity_stmts },
                    },
                ),
            );
            let push_params: Vec[(string, Type)] = Vec::[];
            push_params.push(("vec", lowered_vec));
            push_params.push(("elem", lowered_elem));
            let append_args: Vec[Expr] = Vec::[];
            append_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
            append_args.push(Expr::Var { name: "elem" });
            let push_stmts: Vec[Stmt] = Vec::[];
            push_stmts.push(
                Stmt::FieldAssign {
                    target: Expr::Var { name: "vec" },
                    field_name: "items",
                    value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
                },
            );
            push_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_push", vec_ty),
                        params: push_params,
                        ret_ty: Option::Some(Type::Unit),
                        body: Block { stmts: push_stmts },
                    },
                ),
            );
            let get_params: Vec[(string, Type)] = Vec::[];
            get_params.push(("vec", lowered_vec));
            get_params.push(("index", Type::Int));
            let get_stmts: Vec[Stmt] = Vec::[];
            get_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Index {
                            base: Expr::Field {
                                expr: Expr::Var { name: "vec" },
                                field_name: "items",
                            },
                            index: Expr::Var { name: "index" },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_get", vec_ty),
                        params: get_params,
                        ret_ty: Option::Some(lowered_elem),
                        body: Block { stmts: get_stmts },
                    },
                ),
            );
            let set_params: Vec[(string, Type)] = Vec::[];
            set_params.push(("vec", lowered_vec));
            set_params.push(("index", Type::Int));
            set_params.push(("value", lowered_elem));
            let set_stmts: Vec[Stmt] = Vec::[];
            set_stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                    index: Expr::Var { name: "index" },
                    value: Expr::Var { name: "value" },
                },
            );
            set_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_set", vec_ty),
                        params: set_params,
                        ret_ty: Option::Some(Type::Unit),
                        body: Block { stmts: set_stmts },
                    },
                ),
            );
            let len_params: Vec[(string, Type)] = Vec::[];
            len_params.push(("vec", lowered_vec));
            let len_args: Vec[Expr] = Vec::[];
            len_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
            let len_stmts: Vec[Stmt] = Vec::[];
            len_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Convert {
                            ty: Type::Int,
                            expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_len", vec_ty),
                        params: len_params,
                        ret_ty: Option::Some(Type::Int),
                        body: Block { stmts: len_stmts },
                    },
                ),
            );
            let capacity_params: Vec[(string, Type)] = Vec::[];
            capacity_params.push(("vec", lowered_vec));
            let capacity_args: Vec[Expr] = Vec::[];
            capacity_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
            let capacity_stmts: Vec[Stmt] = Vec::[];
            capacity_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Convert {
                            ty: Type::Int,
                            expr: Expr::Call {
                                func: Expr::Var { name: "cap" },
                                args: capacity_args,
                            },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_capacity", vec_ty),
                        params: capacity_params,
                        ret_ty: Option::Some(Type::Int),
                        body: Block { stmts: capacity_stmts },
                    },
                ),
            );
            let reserve_params: Vec[(string, Type)] = Vec::[];
            reserve_params.push(("vec", lowered_vec));
            reserve_params.push(("additional", Type::Int));
            let reserve_args: Vec[Expr] = Vec::[];
            reserve_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
            reserve_args.push(
                Expr::Convert {
                    ty: Type::Named { name: "int" },
                    expr: Expr::Var { name: "additional" },
                },
            );
            let reserve_stmts: Vec[Stmt] = Vec::[];
            reserve_stmts.push(
                Stmt::FieldAssign {
                    target: Expr::Var { name: "vec" },
                    field_name: "items",
                    value: Expr::Call {
                        func: Expr::Var { name: "_goml_slices.Grow" },
                        args: reserve_args,
                    },
                },
            );
            reserve_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_reserve", vec_ty),
                        params: reserve_params,
                        ret_ty: Option::Some(Type::Unit),
                        body: Block { stmts: reserve_stmts },
                    },
                ),
            );
            let truncate_params: Vec[(string, Type)] = Vec::[];
            truncate_params.push(("vec", lowered_vec));
            truncate_params.push(("new_len", Type::Int));
            let truncate_stmts: Vec[Stmt] = Vec::[];
            let negative_stmts: Vec[Stmt] = Vec::[];
            negative_stmts.push(Stmt::Panic { message: "negative vector length" });
            truncate_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Less,
                        lhs: Expr::Var { name: "new_len" },
                        rhs: Expr::Int { value: "0" },
                    },
                    then_: Block { stmts: negative_stmts },
                    else_: Option::None,
                },
            );
            let current_len_args: Vec[Expr] = Vec::[];
            current_len_args.push(
                Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
            );
            let current_len = Expr::Convert {
                ty: Type::Int,
                expr: Expr::Call { func: Expr::Var { name: "len" }, args: current_len_args },
            };
            let shorten_stmts: Vec[Stmt] = Vec::[];
            let clear_len_args: Vec[Expr] = Vec::[];
            clear_len_args.push(
                Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
            );
            let clear_args: Vec[Expr] = Vec::[];
            clear_args.push(
                Expr::Slice {
                    base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                    start: Expr::Var { name: "new_len" },
                    end: Expr::Convert {
                        ty: Type::Int,
                        expr: Expr::Call { func: Expr::Var { name: "len" }, args: clear_len_args },
                    },
                },
            );
            shorten_stmts.push(
                Stmt::Expr {
                    expr: Expr::Call { func: Expr::Var { name: "clear" }, args: clear_args },
                },
            );
            shorten_stmts.push(
                Stmt::FieldAssign {
                    target: Expr::Var { name: "vec" },
                    field_name: "items",
                    value: Expr::Slice {
                        base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                        start: Expr::Int { value: "0" },
                        end: Expr::Var { name: "new_len" },
                    },
                },
            );
            truncate_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Less,
                        lhs: Expr::Var { name: "new_len" },
                        rhs: current_len,
                    },
                    then_: Block { stmts: shorten_stmts },
                    else_: Option::None,
                },
            );
            truncate_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
            result.push(
                Item::Function(
                    Function {
                        name: runtime_helper_name("vec_truncate", vec_ty),
                        params: truncate_params,
                        ret_ty: Option::Some(Type::Unit),
                        body: Block { stmts: truncate_stmts },
                    },
                ),
            )
        },
        _ => (),
    };
    result
}

fn ref_runtime_items(ref_ty: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    match repr::resolve_type(ref_ty) {
        RefType { elem } => {
            let elem_ty = lower_type(elem);
            let lowered_ref_ty = lower_type(ref_ty);
            let struct_ty = Type::Named { name: ref_struct_name(elem) };
            let new_fields: Vec[(string, Expr)] = Vec::[];
            new_fields.push(("value", Expr::Var { name: "value" }));
            let new_stmts: Vec[Stmt] = Vec::[];
            new_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Unary {
                            op: UnaryOp::Address,
                            expr: Expr::StructLiteral { ty: struct_ty, fields: new_fields },
                        },
                    ),
                },
            );
            let new_params: Vec[(string, Type)] = Vec::[];
            new_params.push(("value", elem_ty));
            result.push(
                Item::Function(
                    Function {
                        name: ref_helper_name("ref", ref_ty),
                        params: new_params,
                        ret_ty: Option::Some(lowered_ref_ty),
                        body: Block { stmts: new_stmts },
                    },
                ),
            );
            let get_params: Vec[(string, Type)] = Vec::[];
            get_params.push(("reference", lowered_ref_ty));
            let get_stmts: Vec[Stmt] = Vec::[];
            get_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Field { expr: Expr::Var { name: "reference" }, field_name: "value" },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: ref_helper_name("ref_get", ref_ty),
                        params: get_params,
                        ret_ty: Option::Some(elem_ty),
                        body: Block { stmts: get_stmts },
                    },
                ),
            );
            let set_params: Vec[(string, Type)] = Vec::[];
            set_params.push(("reference", lowered_ref_ty));
            set_params.push(("value", elem_ty));
            let set_stmts: Vec[Stmt] = Vec::[];
            set_stmts.push(
                Stmt::FieldAssign {
                    target: Expr::Var { name: "reference" },
                    field_name: "value",
                    value: Expr::Var { name: "value" },
                },
            );
            set_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
            result.push(
                Item::Function(
                    Function {
                        name: ref_helper_name("ref_set", ref_ty),
                        params: set_params,
                        ret_ty: Option::Some(Type::Unit),
                        body: Block { stmts: set_stmts },
                    },
                ),
            );
            let ptr_eq_params: Vec[(string, Type)] = Vec::[];
            ptr_eq_params.push(("a", lowered_ref_ty));
            ptr_eq_params.push(("b", lowered_ref_ty));
            let ptr_eq_stmts: Vec[Stmt] = Vec::[];
            ptr_eq_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Binary {
                            op: BinaryOp::Eq,
                            lhs: Expr::Var { name: "a" },
                            rhs: Expr::Var { name: "b" },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: ref_helper_name("ptr_eq", ref_ty),
                        params: ptr_eq_params,
                        ret_ty: Option::Some(Type::Bool),
                        body: Block { stmts: ptr_eq_stmts },
                    },
                ),
            );
            let ptr_hash_params: Vec[(string, Type)] = Vec::[];
            ptr_hash_params.push(("reference", lowered_ref_ty));
            let value_of_args: Vec[Expr] = Vec::[];
            value_of_args.push(Expr::Var { name: "reference" });
            let pointer_args: Vec[Expr] = Vec::[];
            let ptr_hash_stmts: Vec[Stmt] = Vec::[];
            ptr_hash_stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Convert {
                            ty: Type::Uint64,
                            expr: Expr::Call {
                                func: Expr::Field {
                                    expr: Expr::Call {
                                        func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                        args: value_of_args,
                                    },
                                    field_name: "Pointer",
                                },
                                args: pointer_args,
                            },
                        },
                    ),
                },
            );
            result.push(
                Item::Function(
                    Function {
                        name: ref_helper_name("ptr_hash", ref_ty),
                        params: ptr_hash_params,
                        ret_ty: Option::Some(Type::Uint64),
                        body: Block { stmts: ptr_hash_stmts },
                    },
                ),
            )
        },
        _ => (),
    };
    result
}

fn synthetic_option_base(value: repr::Type) -> string {
    "_goml_option__" + compact_type(value)
}

fn synthetic_option_items(value: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    let option_name = go_generated_ident("_goml_synthetic_" + synthetic_option_base(value));
    let method_name = go_generated_ident("is" + option_name);
    let some_name = go_generated_ident(option_name + "_Some");
    let none_name = go_generated_ident(option_name + "_None");
    let methods: Vec[InterfaceMethod] = Vec::[];
    methods.push(InterfaceMethod { name: method_name, params: Vec::[], ret_ty: Option::None });
    result.push(Item::Interface(InterfaceDef { name: option_name, methods }));
    let some_fields: Vec[(string, Type)] = Vec::[];
    some_fields.push(("_0", lower_type(value)));
    result.push(Item::Struct(StructDef { name: some_name, fields: some_fields }));
    result.push(
        Item::Method(
            Method {
                receiver: ("_", Type::Named { name: some_name }),
                name: method_name,
                params: Vec::[],
                ret_ty: Option::None,
                body: Block { stmts: Vec::[] },
            },
        ),
    );
    result.push(Item::Struct(StructDef { name: none_name, fields: Vec::[] }));
    result.push(
        Item::Method(
            Method {
                receiver: ("_", Type::Named { name: none_name }),
                name: method_name,
                params: Vec::[],
                ret_ty: Option::None,
                body: Block { stmts: Vec::[] },
            },
        ),
    );
    result
}

fn hashmap_option_info(
    value: repr::Type,
    instances: Vec[repr::TypeInstance],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    function_names: FunctionNames,
) -> (Type, Type, Type, bool) {
    let args: Vec[repr::Type] = Vec::[];
    args.push(value);
    match find_instance(instances, "Option", args) {
        Some(instance) => {
            let variants = match find_enum(enums, instance.name) {
                Some(definition) => definition.option_variants,
                None => Option::None,
            };
            let variants = match variants {
                Some(value) => value,
                None => ("Some", "None"),
            };
            (
                Type::Named { name: go_user_type_name(instance.name) },
                Type::Named {
                    name: variant_go_name(
                        instance.name,
                        variants.0,
                        enums,
                        structs,
                        instances,
                        function_names,
                    ),
                },
                Type::Named {
                    name: variant_go_name(
                        instance.name,
                        variants.1,
                        enums,
                        structs,
                        instances,
                        function_names,
                    ),
                },
                false,
            )
        },
        None => {
            let option_name = go_generated_ident("_goml_synthetic_" + synthetic_option_base(value));
            (
                Type::Named { name: option_name },
                Type::Named { name: go_generated_ident(option_name + "_Some") },
                Type::Named { name: go_generated_ident(option_name + "_None") },
                true,
            )
        },
    }
}

fn hashmap_trait_impl_name(trait_name: string, key: repr::Type, method: string) -> string {
    go_ident("trait_impl#" + trait_name + "#" + compact_type(key) + "#" + method)
}

fn hashmap_hash_expr(key: repr::Type, value: Expr) -> Expr {
    match repr::resolve_type(key) {
        Dyn { trait_name: name, .. } => if name == "Hash" || name.ends_with("::Hash") {
            Expr::Call {
                func: Expr::Field {
                    expr: Expr::Field { expr: value, field_name: "vtable" },
                    field_name: "hash",
                },
                args: Vec::[Expr::Field { expr: value, field_name: "data" }],
            }
        } else {
            Expr::Call {
                func: Expr::Var { name: hashmap_trait_impl_name("Hash", key, "hash") },
                args: Vec::[value],
            }
        },
        _ => Expr::Call {
            func: Expr::Var { name: hashmap_trait_impl_name("Hash", key, "hash") },
            args: Vec::[value],
        },
    }
}

fn hashmap_new_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let name = hashmap_name(key, value);
    let entry_ty = Type::Named { name: go_generated_ident(name + "_entry") };
    let buckets_ty = Type::Map { key: Type::Uint64, value: Type::Slice { elem: entry_ty } };
    let fields: Vec[(string, Expr)] = Vec::[];
    fields.push(("buckets", Expr::Make { ty: buckets_ty, args: Vec::[] }));
    fields.push(("len", Expr::Int { value: "0" }));
    fields.push(("hashes", Expr::Nil));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral { ty: Type::Named { name }, fields },
                },
            ),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_new", map_ty),
            params: Vec::[],
            ret_ty: Option::Some(lower_type(map_ty)),
            body: Block { stmts },
        },
    )
}

fn hashmap_len_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lower_type(map_ty)));
    let stmts: Vec[Stmt] = Vec::[];
    let nil_stmts: Vec[Stmt] = Vec::[];
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Int { value: "0" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" }),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_len", map_ty),
            params,
            ret_ty: Option::Some(Type::Int),
            body: Block { stmts },
        },
    )
}

fn hashmap_lookup_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::[];
    let nil_stmts: Vec[Stmt] = Vec::[];
    nil_stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let nil_values: Vec[Expr] = Vec::[];
    nil_values.push(Expr::Var { name: "zero" });
    nil_values.push(Expr::Bool { value: false });
    nil_stmts.push(Stmt::ReturnMulti { exprs: nil_values });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::[];
    let len_args: Vec[Expr] = Vec::[];
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::[];
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let found_stmts: Vec[Stmt] = Vec::[];
    let found_values: Vec[Expr] = Vec::[];
    found_values.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "value" });
    found_values.push(Expr::Bool { value: true });
    found_stmts.push(Stmt::ReturnMulti { exprs: found_values });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var { name: hashmap_trait_impl_name("PartialEq", key, "eq") },
                    args: eq_args,
                },
            },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let missing_values: Vec[Expr] = Vec::[];
    missing_values.push(Expr::Var { name: "zero" });
    missing_values.push(Expr::Bool { value: false });
    stmts.push(Stmt::ReturnMulti { exprs: missing_values });
    let returns: Vec[Type] = Vec::[];
    returns.push(lowered_value);
    returns.push(Type::Bool);
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_lookup", map_ty),
            params,
            ret_ty: Option::Some(Type::Multi { items: returns }),
            body: Block { stmts },
        },
    )
}

fn hashmap_get_item(
    key: repr::Type,
    value: repr::Type,
    option_ty: Type,
    some_ty: Type,
    none_ty: Type,
) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lower_type(map_ty)));
    params.push(("key", lower_type(key)));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Var { name: "value", ty: lower_type(value), value: Option::None });
    stmts.push(Stmt::Var { name: "ok", ty: Type::Bool, value: Option::None });
    let names: Vec[string] = Vec::[];
    names.push("value");
    names.push("ok");
    let lookup_args: Vec[Expr] = Vec::[];
    lookup_args.push(Expr::Var { name: "m" });
    lookup_args.push(Expr::Var { name: "key" });
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: Expr::Call {
                func: Expr::Var { name: runtime_helper_name("hashmap_lookup", map_ty) },
                args: lookup_args,
            },
        },
    );
    let some_fields: Vec[(string, Expr)] = Vec::[];
    some_fields.push(("_0", Expr::Var { name: "value" }));
    let some_stmts: Vec[Stmt] = Vec::[];
    some_stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::StructLiteral { ty: some_ty, fields: some_fields }),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "ok" },
            then_: Block { stmts: some_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return { expr: Option::Some(Expr::StructLiteral { ty: none_ty, fields: Vec::[] }) },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_get", map_ty),
            params,
            ret_ty: Option::Some(option_ty),
            body: Block { stmts },
        },
    )
}

fn hashmap_entry_expr(entry_ty: Type) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::[];
    fields.push(("active", Expr::Bool { value: true }));
    fields.push(("key", Expr::Var { name: "key" }));
    fields.push(("value", Expr::Var { name: "value" }));
    Expr::StructLiteral { ty: entry_ty, fields }
}

fn hashmap_increment_len() -> Stmt {
    Stmt::FieldAssign {
        target: Expr::Var { name: "m" },
        field_name: "len",
        value: Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" },
            rhs: Expr::Int { value: "1" },
        },
    }
}

fn hashmap_set_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    params.push(("value", lowered_value));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(
        Stmt::Var {
            name: "reuse_index",
            ty: Type::Int,
            value: Option::Some(Expr::Int { value: "-1" }),
        },
    );
    let nil_stmts: Vec[Stmt] = Vec::[];
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    let len_args: Vec[Expr] = Vec::[];
    len_args.push(Expr::Var { name: "bucket" });
    let empty_stmts: Vec[Stmt] = Vec::[];
    let append_hash_args: Vec[Expr] = Vec::[];
    append_hash_args.push(Expr::Field { expr: Expr::Var { name: "m" }, field_name: "hashes" });
    append_hash_args.push(Expr::Var { name: "h" });
    empty_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "hashes",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_hash_args },
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: empty_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::[];
    let loop_len_args: Vec[Expr] = Vec::[];
    loop_len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: loop_len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::[];
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let update_stmts: Vec[Stmt] = Vec::[];
    update_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Index {
                base: Expr::Var { name: "bucket" },
                index: Expr::Var { name: "i" },
            },
            field_name: "value",
            value: Expr::Var { name: "value" },
        },
    );
    update_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var { name: hashmap_trait_impl_name("PartialEq", key, "eq") },
                    args: eq_args,
                },
            },
            then_: Block { stmts: update_stmts },
            else_: Option::None,
        },
    );
    let reuse_stmts: Vec[Stmt] = Vec::[];
    reuse_stmts.push(Stmt::Assign { name: "reuse_index", value: Expr::Var { name: "i" } });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Unary {
                    op: UnaryOp::Not,
                    expr: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "reuse_index" },
                    rhs: Expr::Int { value: "0" },
                },
            },
            then_: Block { stmts: reuse_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    let replace_stmts: Vec[Stmt] = Vec::[];
    replace_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "bucket" },
            index: Expr::Var { name: "reuse_index" },
            value: hashmap_entry_expr(entry_ty),
        },
    );
    replace_stmts.push(hashmap_increment_len());
    replace_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "reuse_index" },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: replace_stmts },
            else_: Option::None,
        },
    );
    let append_entry_args: Vec[Expr] = Vec::[];
    append_entry_args.push(Expr::Var { name: "bucket" });
    append_entry_args.push(hashmap_entry_expr(entry_ty));
    stmts.push(
        Stmt::Assign {
            name: "bucket",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_entry_args },
        },
    );
    stmts.push(
        Stmt::IndexAssign {
            base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
            index: Expr::Var { name: "h" },
            value: Expr::Var { name: "bucket" },
        },
    );
    stmts.push(hashmap_increment_len());
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_set", map_ty),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn hashmap_remove_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::[];
    let nil_stmts: Vec[Stmt] = Vec::[];
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::[];
    let len_args: Vec[Expr] = Vec::[];
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::[];
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let found_stmts: Vec[Stmt] = Vec::[];
    found_stmts.push(Stmt::Var { name: "zero", ty: entry_ty, value: Option::None });
    found_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "bucket" },
            index: Expr::Var { name: "i" },
            value: Expr::Var { name: "zero" },
        },
    );
    found_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "len",
            value: Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    found_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var { name: hashmap_trait_impl_name("PartialEq", key, "eq") },
                    args: eq_args,
                },
            },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_remove", map_ty),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn hashmap_contains_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::[];
    let nil_stmts: Vec[Stmt] = Vec::[];
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::[];
    let len_args: Vec[Expr] = Vec::[];
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::[];
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let found_stmts: Vec[Stmt] = Vec::[];
    found_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: true }) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var { name: hashmap_trait_impl_name("PartialEq", key, "eq") },
                    args: eq_args,
                },
            },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_contains", map_ty),
            params,
            ret_ty: Option::Some(Type::Bool),
            body: Block { stmts },
        },
    )
}

fn hashmap_entries_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let pair_types: Vec[repr::Type] = Vec::[];
    pair_types.push(key);
    pair_types.push(value);
    let pair_ty = repr::Type::Tuple { items: pair_types };
    let lowered_pair = lower_type(pair_ty);
    let result_slice_ty = Type::Slice { elem: lowered_pair };
    let result_vec_ty = repr::Type::VecType { elem: pair_ty };
    let result_vec_struct = Type::Named {
        name: go_generated_ident("_goml_vec_" + go_ident(encode_type(pair_ty))),
    };
    let params: Vec[(string, Type)] = Vec::[];
    params.push(("m", lower_type(map_ty)));
    let stmts: Vec[Stmt] = Vec::[];
    stmts.push(Stmt::Var { name: "result", ty: result_slice_ty, value: Option::None });
    let nil_fields: Vec[(string, Expr)] = Vec::[];
    nil_fields.push(("items", Expr::Var { name: "result" }));
    let nil_stmts: Vec[Stmt] = Vec::[];
    nil_stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral { ty: result_vec_struct, fields: nil_fields },
                },
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    let range_stmts: Vec[Stmt] = Vec::[];
    range_stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    range_stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::[];
    let len_args: Vec[Expr] = Vec::[];
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::[];
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let pair_fields: Vec[(string, Expr)] = Vec::[];
    pair_fields.push(("_0", Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" }));
    pair_fields.push(("_1", Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "value" }));
    let append_args: Vec[Expr] = Vec::[];
    append_args.push(Expr::Var { name: "result" });
    append_args.push(Expr::StructLiteral { ty: lowered_pair, fields: pair_fields });
    let active_stmts: Vec[Stmt] = Vec::[];
    active_stmts.push(
        Stmt::Assign {
            name: "result",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
        },
    );
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
            then_: Block { stmts: active_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    range_stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    let range_names: Vec[string] = Vec::[];
    range_names.push("_");
    range_names.push("h");
    stmts.push(
        Stmt::Range {
            names: range_names,
            expr: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "hashes" },
            body: Block { stmts: range_stmts },
        },
    );
    let result_fields: Vec[(string, Expr)] = Vec::[];
    result_fields.push(("items", Expr::Var { name: "result" }));
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral { ty: result_vec_struct, fields: result_fields },
                },
            ),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_entries", map_ty),
            params,
            ret_ty: Option::Some(lower_type(result_vec_ty)),
            body: Block { stmts },
        },
    )
}

fn hashmap_items(
    key: repr::Type,
    value: repr::Type,
    instances: Vec[repr::TypeInstance],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    function_names: FunctionNames,
    include_option: bool,
) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    let name = hashmap_name(key, value);
    let entry_name = go_generated_ident(name + "_entry");
    let entry_fields: Vec[(string, Type)] = Vec::[];
    entry_fields.push(("active", Type::Bool));
    entry_fields.push(("key", lower_type(key)));
    entry_fields.push(("value", lower_type(value)));
    result.push(Item::Struct(StructDef { name: entry_name, fields: entry_fields }));
    let fields: Vec[(string, Type)] = Vec::[];
    fields.push(
        (
            "buckets",
            Type::Map {
                key: Type::Uint64,
                value: Type::Slice { elem: Type::Named { name: entry_name } },
            },
        ),
    );
    fields.push(("hashes", Type::Slice { elem: Type::Uint64 }));
    fields.push(("len", Type::Int));
    result.push(Item::Struct(StructDef { name, fields }));
    let option = hashmap_option_info(value, instances, enums, structs, function_names);
    if include_option && option.3 {
        for item in synthetic_option_items(value) {
            result.push(item)
        }
    } else {};
    result.push(hashmap_new_item(key, value));
    result.push(hashmap_len_item(key, value));
    result.push(hashmap_lookup_item(key, value));
    result.push(hashmap_get_item(key, value, option.0, option.1, option.2));
    result.push(hashmap_set_item(key, value));
    result.push(hashmap_remove_item(key, value));
    result.push(hashmap_contains_item(key, value));
    result.push(hashmap_entries_item(key, value));
    result
}

fn option_available(instances: Vec[repr::TypeInstance], value: repr::Type) -> bool {
    let args: Vec[repr::Type] = Vec::[];
    args.push(value);
    find_instance(instances, "Option", args).is_some()
}

fn dyn_vtable_name(trait_name: string) -> string {
    go_generated_ident("dyn__" + trait_name + "_vtable")
}

fn dyn_object_name(trait_name: string) -> string {
    go_dyn_struct_name(trait_name)
}

fn raw_dyn_wrapper_name(trait_name: string, for_ty: repr::Type, method: string) -> string {
    go_generated_ident("dyn__" + trait_name + "__wrap__" + encode_type(for_ty) + "__" + method)
}

fn dyn_wrapper_name(names: DynHelperNames, trait_name: string, for_ty: repr::Type, method: string) -> string {
    let key = compact_type(for_ty);
    let mut result = raw_dyn_wrapper_name(trait_name, for_ty, method);
    for entry in names.wrappers {
        if entry.0 == trait_name && entry.1 == key && entry.2 == method {
            result = entry.3;
        } else {}
    }
    result
}

fn raw_dyn_factory_name(trait_name: string, for_ty: repr::Type) -> string {
    go_generated_ident("dyn__" + trait_name + "__vtable__" + encode_type(for_ty))
}

pub fn dyn_factory_name(names: DynHelperNames, trait_name: string, for_ty: repr::Type) -> string {
    let key = compact_type(for_ty);
    let mut result = raw_dyn_factory_name(trait_name, for_ty);
    for entry in names.factories {
        if entry.0 == trait_name && entry.1 == key {
            result = entry.2;
        } else {}
    }
    result
}

fn trait_impl_method_name(value: anf::Function) -> Option[string] {
    match value.origin {
        anf::FunctionOrigin::TraitImplementation { method_name } => Option::Some(method_name),
        _ => Option::None,
    }
}

fn contains_method(values: Vec[DynMethod], expected: string) -> bool {
    for value in values {
        if value.name == expected {
            return true
        } else {}
    }
    false
}

fn dyn_method_parts(value: string, fallback: string) -> (string, string) {
    let mut separator = -1;
    for index in 0..value.byte_len() {
        if separator < 0 && value.byte_get(index) == b'#' {
            separator = index;
        } else {}
    }
    if separator < 0 {
        (fallback, value)
    } else {
        (value.byte_slice(0, separator), value.byte_slice(separator + 1, value.byte_len()))
    }
}

fn collect_dyn_call_method(result: Vec[DynMethod], trait_name: string, value: anf::Value) -> unit {
    match value {
        DynCall { trait_name: owner, method_name: encoded, receiver: _, args, ty: ret_ty } => if owner
            == trait_name {
            let parts = dyn_method_parts(encoded, owner);
            if !contains_method(result, parts.1) {
                let params: Vec[repr::Type] = Vec::[];
                for arg in args {
                    params.push(anf::imm_type(arg))
                }
                result.push(DynMethod { name: parts.1, dispatch_trait: parts.0, params, ret_ty })
            } else {}
        } else {},
        _ => (),
    }
}

fn collect_dyn_call_methods(result: Vec[DynMethod], trait_name: string, block: anf::Block) -> unit {
    for bind in block.binds {
        match bind {
            Let(value) => {
                collect_dyn_call_method(result, trait_name, value.value)
            },
            Join(value) => {
                collect_dyn_call_methods(result, trait_name, value.body)
            },
            JoinRec(values) => for value in values {
                collect_dyn_call_methods(result, trait_name, value.body)
            },
        }
    }
    match block.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_dyn_call_methods(result, trait_name, then_);
            collect_dyn_call_methods(result, trait_name, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_dyn_call_methods(result, trait_name, arm.body)
            }
            match default {
                Some(body) => collect_dyn_call_methods(result, trait_name, body),
                None => (),
            }
        },
        _ => (),
    }
}

fn dyn_methods(functions: Vec[anf::Function], trait_name: string) -> Vec[DynMethod] {
    let result: Vec[DynMethod] = Vec::[];
    for function in functions {
        match (function.trait_impl, trait_impl_method_name(function)) {
            (Some(metadata), Some(method_name)) => {
                if metadata.trait_ref.name == trait_name && !contains_method(result, method_name) {
                    let params: Vec[repr::Type] = Vec::[];
                    for index in 1..function.params.len() {
                        params.push(function.params[index].1)
                    }
                    result.push(
                        DynMethod {
                            name: method_name,
                            dispatch_trait: trait_name,
                            params,
                            ret_ty: function.ret_ty,
                        },
                    )
                } else {}
            },
            _ => (),
        }
    }
    for function in functions {
        collect_dyn_call_methods(result, trait_name, function.body)
    }
    if trait_name == "Hash" && !contains_method(result, "hash") {
        result.push(
            DynMethod {
                name: "hash",
                dispatch_trait: trait_name,
                params: Vec::[],
                ret_ty: repr::Type::Uint64,
            },
        )
    } else if trait_name == "ToString" && !contains_method(result, "to_string") {
        result.push(
            DynMethod {
                name: "to_string",
                dispatch_trait: trait_name,
                params: Vec::[],
                ret_ty: repr::Type::String,
            },
        )
    } else if trait_name == "Debug" && !contains_method(result, "debug") {
        result.push(
            DynMethod {
                name: "debug",
                dispatch_trait: trait_name,
                params: Vec::[],
                ret_ty: repr::Type::String,
            },
        )
    } else {};
    result
}

fn dyn_factory_name_count(coercions: Vec[DynCoercion], expected: string) -> int {
    let mut count = 0;
    for coercion in coercions {
        if raw_dyn_factory_name(coercion.trait_name, coercion.for_ty) == expected {
            count = count + 1;
        } else {}
    }
    count
}

fn dyn_wrapper_name_count(
    coercions: Vec[DynCoercion],
    functions: Vec[anf::Function],
    expected: string,
) -> int {
    let mut count = 0;
    for coercion in coercions {
        for method in dyn_methods(functions, coercion.trait_name) {
            if raw_dyn_wrapper_name(coercion.trait_name, coercion.for_ty, method.name) == expected {
                count = count + 1;
            } else {}
        }
    }
    count
}

pub fn build_dyn_helper_names(coercions: Vec[DynCoercion], functions: Vec[anf::Function]) -> DynHelperNames {
    let factories: Vec[(string, string, string)] = Vec::[];
    let wrappers: Vec[(string, string, string, string)] = Vec::[];
    for coercion in coercions {
        let key = compact_type(coercion.for_ty);
        let raw_factory = raw_dyn_factory_name(coercion.trait_name, coercion.for_ty);
        if dyn_factory_name_count(coercions, raw_factory) > 1 {
            factories.push(
                (
                    coercion.trait_name,
                    key,
                    go_hashed_ident("fn", "dyn_vtable#" + coercion.trait_name + "#" + key),
                ),
            )
        } else {};
        for method in dyn_methods(functions, coercion.trait_name) {
            let raw_wrapper = raw_dyn_wrapper_name(
                coercion.trait_name,
                coercion.for_ty,
                method.name,
            );
            if dyn_wrapper_name_count(coercions, functions, raw_wrapper) > 1 {
                wrappers.push(
                    (
                        coercion.trait_name,
                        key,
                        method.name,
                        go_hashed_ident(
                            "fn",
                            "dyn_wrap#" + coercion.trait_name + "#" + key + "#" + method.name,
                        ),
                    ),
                )
            } else {}
        }
    }
    DynHelperNames { factories, wrappers }
}

fn dyn_type_items(trait_name: string, methods: Vec[DynMethod]) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    let fields: Vec[(string, Type)] = Vec::[];
    for method in methods {
        let params: Vec[Type] = Vec::[];
        params.push(Type::Any);
        for param in method.params {
            params.push(lower_type(param))
        }
        fields.push(
            (go_ident(method.name), Type::Func { params, ret_ty: lower_type(method.ret_ty) }),
        )
    }
    result.push(Item::Struct(StructDef { name: dyn_vtable_name(trait_name), fields }));
    let object_fields: Vec[(string, Type)] = Vec::[];
    object_fields.push(("data", Type::Any));
    object_fields.push(
        ("vtable", Type::Pointer { elem: Type::Named { name: dyn_vtable_name(trait_name) } }),
    );
    result.push(
        Item::Struct(StructDef { name: dyn_object_name(trait_name), fields: object_fields }),
    );
    result
}

fn find_dyn_impl_name(
    functions: Vec[anf::Function],
    trait_name: string,
    for_ty: repr::Type,
    method_name: string,
) -> string {
    let mut index = functions.len() - 1;
    while index >= 0 {
        let function = functions[index];
        match (function.trait_impl, trait_impl_method_name(function)) {
            (Some(metadata), Some(candidate_method)) => {
                if metadata.trait_ref.name == trait_name
                    && encode_type(metadata.for_ty) == encode_type(for_ty)
                    && candidate_method == method_name {
                    return go_ident(function.name)
                } else {
                    index = index - 1;
                }
            },
            _ => {
                index = index - 1;
            },
        }
    }
    go_ident("trait_impl#" + trait_name + "#" + compact_type(for_ty) + "#" + method_name)
}

fn dyn_coercion_compare(left: DynCoercion, right: DynCoercion) -> cmp::Ordering {
    if left.trait_name == right.trait_name {
        cmp::compare(encode_type(left.for_ty), encode_type(right.for_ty))
    } else {
        cmp::compare(left.trait_name, right.trait_name)
    }
}

fn sorted_dyn_coercions(values: Vec[DynCoercion]) -> Vec[DynCoercion] {
    collections::sort_by_ordering(values, dyn_coercion_compare);
    values
}

fn is_enum_dyn_receiver(
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    value: repr::Type,
) -> bool {
    match repr::resolve_type(value) {
        Named { name } => find_enum(enums, name).is_some(),
        _ => false,
    }
}

fn dyn_coercion_items(
    functions: Vec[anf::Function],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    coercion: DynCoercion,
    methods: Vec[DynMethod],
    names: DynHelperNames,
) -> Vec[Item] {
    let result: Vec[Item] = Vec::[];
    let enum_receiver = is_enum_dyn_receiver(enums, instances, coercion.for_ty);
    for method in methods {
        let wrapper = dyn_wrapper_name(names, coercion.trait_name, coercion.for_ty, method.name);
        let wrapper_params: Vec[(string, Type)] = Vec::[];
        wrapper_params.push(("self", Type::Any));
        let wrapper_args: Vec[Expr] = Vec::[];
        wrapper_args.push(
            if enum_receiver {
                Expr::Var { name: "v" }
            } else {
                Expr::Cast { expr: Expr::Var { name: "self" }, ty: lower_type(coercion.for_ty) }
            },
        );
        for index in 0..method.params.len() {
            let name = "p" + index.to_string();
            wrapper_params.push((name, lower_type(method.params[index])));
            wrapper_args.push(Expr::Var { name })
        }
        let wrapper_stmts: Vec[Stmt] = Vec::[];
        let wrapper_call = Expr::Call {
            func: Expr::Var {
                name: find_dyn_impl_name(
                    functions,
                    method.dispatch_trait,
                    coercion.for_ty,
                    method.name,
                ),
            },
            args: wrapper_args,
        };
        if enum_receiver {
            let cases: Vec[TypeSwitchCase] = Vec::[];
            let case_stmts: Vec[Stmt] = Vec::[];
            case_stmts.push(Stmt::Return { expr: Option::Some(wrapper_call) });
            cases.push(
                TypeSwitchCase {
                    ty: lower_type(coercion.for_ty),
                    body: Block { stmts: case_stmts },
                },
            );
            let default_stmts: Vec[Stmt] = Vec::[];
            default_stmts.push(Stmt::Panic { message: "unexpected type" });
            wrapper_stmts.push(
                Stmt::TypeSwitch {
                    binding: Option::Some("v"),
                    expr: Expr::Var { name: "self" },
                    cases,
                    default: Option::Some(Block { stmts: default_stmts }),
                },
            )
        } else {
            wrapper_stmts.push(Stmt::Return { expr: Option::Some(wrapper_call) })
        };
        result.push(
            Item::Function(
                Function {
                    name: wrapper,
                    params: wrapper_params,
                    ret_ty: Option::Some(lower_type(method.ret_ty)),
                    body: Block { stmts: wrapper_stmts },
                },
            ),
        )
    }
    let factory_stmts: Vec[Stmt] = Vec::[];
    let factory_fields: Vec[(string, Expr)] = Vec::[];
    for method in methods {
        factory_fields.push(
            (
                go_ident(method.name),
                Expr::Var {
                    name: dyn_wrapper_name(names, coercion.trait_name, coercion.for_ty, method.name),
                },
            ),
        )
    }
    factory_stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: Type::Named { name: dyn_vtable_name(coercion.trait_name) },
                        fields: factory_fields,
                    },
                },
            ),
        },
    );
    result.push(
        Item::Function(
            Function {
                name: dyn_factory_name(names, coercion.trait_name, coercion.for_ty),
                params: Vec::[],
                ret_ty: Option::Some(
                    Type::Pointer {
                        elem: Type::Named { name: dyn_vtable_name(coercion.trait_name) },
                    },
                ),
                body: Block { stmts: factory_stmts },
            },
        ),
    );
    result
}

pub fn emit_builtin_runtime_items(
    items: Vec[Item],
    types: Vec[repr::Type],
    missing_types: Vec[repr::Type],
    instances: Vec[repr::TypeInstance],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    function_names: FunctionNames,
) -> unit {
    for instance in instances {
        if instance.base_name == "OnceCell" && instance.args.len() == 1 {
            items.push(once_cell_new_item(instance));
            items.push(once_cell_get_or_init_item(instance))
        } else {}
    }
    for ty in types {
        match repr::resolve_type(ty) {
            Array { len: _, elem: _ } => {
                for item in array_runtime_items(ty) {
                    items.push(item)
                }
            },
            _ => (),
        }
    }
    for ty in types {
        match repr::resolve_type(ty) {
            VecType { elem: _ } => {
                items.push(Item::Struct(runtime_struct(ty)));
                for item in vec_runtime_items(ty) {
                    items.push(item)
                }
            },
            _ => (),
        }
    }
    for ty in types {
        match repr::resolve_type(ty) {
            RefType { elem: _ } => {
                items.push(Item::Struct(runtime_struct(ty)));
                for item in ref_runtime_items(ty) {
                    items.push(item)
                }
            },
            _ => (),
        }
    }
    let options: Vec[string] = Vec::[];
    for ty in types {
        match repr::resolve_type(ty) {
            HashMap { key, value } => {
                let option = synthetic_option_base(value);
                let include_option = !options.contains(option)
                    && !option_available(instances, value);
                for item in hashmap_items(
                    key,
                    value,
                    instances,
                    enums,
                    structs,
                    function_names,
                    include_option,
                ) {
                    items.push(item)
                }
                if include_option {
                    options.push(option)
                } else {}
            },
            _ => (),
        }
    }
    for ty in missing_types {
        items.push(missing_runtime_item(ty))
    }
    for ty in types {
        match repr::resolve_type(ty) {
            Tuple { items: _ } => items.push(Item::Struct(runtime_struct(ty))),
            _ => (),
        }
    }
}

pub fn emit_dyn_runtime_items(
    items: Vec[Item],
    types: Vec[repr::Type],
    coercions: Vec[DynCoercion],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    functions: Vec[anf::Function],
    names: DynHelperNames,
) -> unit {
    let dyn_traits: Vec[string] = Vec::[];
    for ty in types {
        match repr::resolve_type(ty) {
            Dyn { trait_name: name, .. } => {
                if !dyn_traits.contains(name) {
                    for item in dyn_type_items(name, dyn_methods(functions, name)) {
                        items.push(item)
                    }
                    dyn_traits.push(name)
                } else {}
            },
            _ => (),
        }
    }
    for coercion in sorted_dyn_coercions(coercions) {
        for item in dyn_coercion_items(
            functions,
            enums,
            instances,
            coercion,
            dyn_methods(functions, coercion.trait_name),
            names,
        ) {
            items.push(item)
        }
    }
}
