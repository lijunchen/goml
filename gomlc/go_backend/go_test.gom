#[test]
fn dispatches_dyn_hashmap_keys_through_vtables() -> unit {
    let source = "impl PartialEq for dyn Hash { fn eq(self: dyn Hash, other: dyn Hash) -> bool { Hash::hash(self) == Hash::hash(other) } } impl Eq for dyn Hash {} fn main() -> unit { let values: HashMap[dyn Hash, string] = HashMap::new(); let key: dyn Hash = 1 as dyn Hash; values.set(key, \"one\"); println(values.contains(key).to_string()); }";
    let output = encode(lower_linked_source(source));
    testing::assert_eq(string_contains(output, "key.vtable.hash(key.data)"), true);
    testing::assert_eq(
        string_contains(output, "_goml_m_trait__impl_i_Hash_i_dynHash_i_hash"),
        false,
    )
}

#[test]
fn emits_generic_enum_instances_and_type_switches() -> unit {
    let source = "enum Weird[T] { Next(Ref[Weird[(int32) -> int32]]), Done(T), } fn main() -> unit { let x: Weird[int32] = Weird::Done(1); match x { Weird::Done(v) => println(v.to_string()), Weird::Next(_) => println(\"next\"), } }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Weird__int32 interface"));
    testing::assert(string_contains(output, "type Weird__int32_Next struct"));
    testing::assert(string_contains(output, "type Weird__int32_Done struct"));
    testing::assert(
        string_contains(output, "type _goml_m_Weird_____o_int32_q__m__z_int32 interface"),
    );
    testing::assert(string_contains(output, "_0 func(int32) int32"))
}

#[test]
fn dispatches_trait_objects_for_enum_receivers() -> unit {
    let source = "trait Area { fn area(self: Self) -> int32; } enum Shape { Circle(int32), } impl Area for Shape { fn area(self: Shape) -> int32 { match self { Shape::Circle(radius) => radius * radius, } } } fn main() -> unit { let shape: dyn Area = Shape::Circle(3) as dyn Area; println(Area::area(shape)); }";
    testing::assert(
        string_contains(
            encode(lower_source(source)),
            "func dyn__Area__wrap__Shape__area(self any) int32 {\n    switch v := self.(type) {\n    case Shape:\n        return _goml_m_trait__impl_i_Area_i_Shape_i_area(v)\n    default:\n        panic(\"unexpected type\")\n    }\n}",
        ),
    )
}

#[test]
fn adapts_closures_for_dynamic_call_function_parameters() -> unit {
    let source = "trait Mapper { fn map(self: Self, arg1: (int32) -> int32) -> int32; } struct Boxed { value: int32, } impl Mapper for Boxed { fn map(self: Boxed, f: (int32) -> int32) -> int32 { f(self.value) } } fn main() -> unit { let x: dyn Mapper = (Boxed { value: 1 }) as dyn Mapper; println(Mapper::map(x, |n| n + 1)); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "var t9 func(int32) int32 = func(p0 int32) int32 {"));
    testing::assert(string_contains(output, "vtable._goml_m_map(x__2.data, t9)"));
    testing::assert(
        string_contains(
            output,
            "return _goml_m_inherent_i_closure__env__main__0_i_closure__env__main__0_i_apply(t8, p0)",
        ),
    );
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__main__0_i_closure__env__main__0_i_apply(",
        ),
    )
}

#[test]
fn emits_user_trait_objects_without_name_collisions() -> unit {
    let source = "trait Display { fn display(self: Self) -> string; } fn dyn__Display() -> int32 { 1 } struct Box { text: string, } impl Display for Box { fn display(self: Self) -> string { self.text } } fn main() -> unit { let d: dyn Display = (Box { text: \"ok\" }) as dyn Display; println(Display::display(d) + dyn__Display().to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Box struct {\n    text string\n}\n\ntype dyn__Display_vtable struct {\n    display func(any) string\n}\n\ntype dyn__Display struct {\n    data any\n    vtable *dyn__Display_vtable\n}\n\nfunc dyn__Display__wrap__Box__display(self any) string {\n    return _goml_m_trait__impl_i_Display_i_Box_i_display(self.(Box))\n}\n\nfunc dyn__Display__vtable__Box() *dyn__Display_vtable {\n    return &dyn__Display_vtable{\n        display: dyn__Display__wrap__Box__display,\n    }\n}\n\nfunc _goml_m_trait__impl_i_Display_i_Box_i_display(self__0 Box) string {\n    var t5 string = self__0.text\n    return t5\n}\n\nfunc main0() struct{} {\n    var t7 Box = Box{\n        text: \"ok\",\n    }\n    var d__1 dyn__Display = dyn__Display{\n        data: t7,\n        vtable: dyn__Display__vtable__Box(),\n    }\n    var t8 string = d__1.vtable.display(d__1.data)\n    var t9 int32\n    t9 = 1\n    var t10 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t9)\n    var t11 string = t8 + t10\n    _goml_m_println(t11)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_non_repeating_joinrec_as_straight_line_control_flow() -> unit {
    let source = "fn f(flag: int32) -> int32 { while true { if flag == 0 { return 1 } else { break }; }; 2 } fn main() -> unit { println(f(0).to_string()); println(f(1).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc f(flag__0 int32) int32 {\n    var t9 bool = flag__0 == 0\n    if t9 {\n        return 1\n    } else {\n        return 2\n    }\n}\n\nfunc main0() struct{} {\n    var t11 int32 = f(0)\n    var t12 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t11)\n    _goml_m_println(t12)\n    var t13 int32 = f(1)\n    var t14 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t13)\n    _goml_m_println(t14)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_closures_inside_enum_payloads() -> unit {
    let source = "enum MaybeFn { Some((int32) -> int32), None, } fn next(flag: bool) -> MaybeFn { if flag { MaybeFn::Some(|x| x + 1) } else { MaybeFn::None } } fn main() -> unit { match next(true) { MaybeFn::Some(f) => println(f(41).to_string()), MaybeFn::None => println(\"none\"), } }";
    let output = encode(lower_source(source));
