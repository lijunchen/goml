    testing::assert(string_contains(output, "transform: t8"));
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__main__0_i_closure__env__main__0_i_apply(",
        ),
    );
    testing::assert(!string_contains(output, "transform: closure_env_"))
}

