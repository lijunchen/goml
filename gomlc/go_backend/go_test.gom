    )
}

#[test]
fn emits_while_conditions_with_try_matches() -> unit {
    let source = "fn step(i: int32) -> Option[bool] { match i { 0 => Option::Some(true), 1 => Option::Some(true), 2 => Option::Some(false), _ => Option::None, } } fn main() -> Option[unit] { let i = Ref::new(0); while match step(i.get())? { true => { i.set(i.get() + 1); true }, false => false, } { () }; Option::Some(()) }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_int32_x struct {\n    value int32\n}\n\ntype Option__bool interface {\n    isOption__bool()\n}\n\ntype Option__bool_None struct {}\n\nfunc (_ Option__bool_None) isOption__bool() {}\n\ntype Option__bool_Some struct {\n    _0 bool\n}\n\nfunc (_ Option__bool_Some) isOption__bool() {}\n\ntype Option__unit interface {\n    isOption__unit()\n}\n\ntype Option__unit_None struct {}\n\nfunc (_ Option__unit_None) isOption__unit() {}\n\ntype Option__unit_Some struct {\n    _0 struct{}\n}\n\nfunc (_ Option__unit_Some) isOption__unit() {}\n\nfunc main0() Option__unit {\n    var i__1 *ref_int32_x = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_new(0)\n    Loop_loop16:\n    for {\n        var t17 int32 = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_get(i__1)\n        var mtmp1 Option__bool\n        switch t17 {\n        case 0:\n            var inline25 Option__bool = Option__bool_Some{\n                _0: true,\n            }\n            mtmp1 = inline25\n        case 1:\n            var inline26 Option__bool = Option__bool_Some{\n                _0: true,\n            }\n            mtmp1 = inline26\n        case 2:\n            var inline27 Option__bool = Option__bool_Some{\n                _0: false,\n            }\n            mtmp1 = inline27\n        default:\n            mtmp1 = Option__bool_None{}\n        }\n        var jp19 bool\n        switch mtmp1.(type) {\n        case Option__bool_None:\n            return Option__unit_None{}\n        case Option__bool_Some:\n            var x2 bool = mtmp1.(Option__bool_Some)._0\n            jp19 = x2\n            var jp21 bool\n            switch jp19 {\n            case true:\n                var t22 int32 = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_get(i__1)\n                var t23 int32 = t22 + 1\n                _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_set(i__1, t23)\n                jp21 = true\n            case false:\n                jp21 = false\n            default:\n                panic(\"non-exhaustive match\")\n            }\n            if jp21 {\n                continue\n            } else {\n                break Loop_loop16\n            }\n        default:\n            panic(\"non-exhaustive match\")\n        }\n    }\n    var t15 Option__unit = Option__unit_Some{\n        _0: struct{}{},\n    }\n    return t15\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

