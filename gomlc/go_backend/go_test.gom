package go_backend;

use gomlc::anf;
use gomlc::ast;
use gomlc::core;
use gomlc::hash;
use gomlc::hir;
use gomlc::lift;
use gomlc::mono;
use gomlc::parser;
use gomlc::repr;
use gomlc::resources;
use gomlc::tast;
use std::text;
use std::testing;

fn test_builtins(counter: Ref[int]) -> core::File {
    match core::lower_builtins(counter) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            core::File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn test_prelude(builtins: core::File, counter: Ref[int]) -> core::File {
    match core::lower_prelude(builtins, counter) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            core::File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn required_lower(value: Result[File, string]) -> File {
    match value {
        Ok(file) => file,
        Err(error) => {
            testing::fail(error);
            File { items: Vec::from_array([]) }
        },
    }
}

fn lower_source(source: string) -> File {
    required_lower(
        lower(
            anf::lower(
                lift::lower(
                    mono::lower(
                        core::lower(
                            tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
                        ),
                    ),
                ),
            ),
        ),
    )
}

fn lower_linked_source(source: string) -> File {
    let counter = Ref::new(0);
    let builtins = test_builtins(counter);
    let prelude = test_prelude(builtins, counter);
    let user = core::lower_with_counter_and_types(
        tast::check_for_link(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
        counter,
        core::enum_defs_to_tast(builtins.enums),
        core::struct_defs_to_tast(builtins.structs),
    );
    required_lower(
        lower(
            anf::lower(
                lift::lower(
                    mono::lower(
                        core::link_with_dependencies(builtins, Vec::from_array([prelude]), user),
                    ),
                ),
            ),
        ),
    )
}

fn lower_test_source(source: string, test_cases: Vec[(string, string, Vec[(string, string)])]) -> File {
    required_lower(
        lower_tests(
            anf::lower(
                lift::lower(
                    mono::lower(
                        core::lower(
                            tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
                        ),
                    ),
                ),
            ),
            test_cases,
        ),
    )
}

fn string_contains(value: string, expected: string) -> bool {
    value.contains(expected)
}

fn required_text_position(value: string, expected: string) -> int {
    match text::find(value, expected) {
        Some(position) => position,
        None => {
            testing::fail("missing " + expected);
            -1
        },
    }
}

fn assert_appears_before(value: string, before: string, after: string) -> unit {
    testing::assert(required_text_position(value, before) < required_text_position(value, after))
}

#[test]
fn bounds_qualified_variant_names_after_qualification() -> unit {
    let owner = "Option__(gomlc::ast::Path,Vec[gomlc::ast::TypeExpr])";
    testing::assert_eq(
        qualified_variant_go_name(owner, "None"),
        "_goml_m_Option_____o_gomlc_p_a_h6cc0136a7bfc53a6682c48309b51a455_Expr_r__q__None",
    );
    testing::assert_eq(
        qualified_variant_go_name(owner, "Some"),
        "_goml_m_Option_____o_gomlc_p_a_h820f68a828634622d946b6231c7d0ba1_Expr_r__q__Some",
    )
}

#[test]
fn emits_test_runner_entrypoint() -> unit {
    let test_cases = Vec::new();
    test_cases.push(("example::alpha", "alpha", Vec::from_array([])));
    test_cases.push(("example::beta", "beta", Vec::from_array([])));
    let output = encode(
        lower_test_source(
            "fn beta() -> unit {} fn alpha() -> unit {} fn unused() -> unit {}",
            test_cases,
        ),
    );
    testing::assert(string_contains(output, "_goml_os \"os\""));
    testing::assert(string_contains(output, "switch _goml_os.Args[1]"));
    testing::assert(string_contains(output, "case \"example::alpha\":\n        alpha()"));
    testing::assert(string_contains(output, "case \"example::beta\":\n        beta()"));
    testing::assert(
        string_contains(
            output,
            "default:\n        _goml_runtime_std_testing_fail(\"unknown test id\")",
        ),
    );
    testing::assert(!string_contains(output, "func unused("))
}

#[test]
fn emits_parameterized_test_arguments() -> unit {
    let test_cases = Vec::new();
    test_cases.push(
        (
            "example::parameterized::case_123",
            "parameterized",
            Vec::from_array([("string", "left"), ("bool", "true")]),
        ),
    );
    let output = encode(
        lower_test_source("fn parameterized(value: string, expected: bool) -> unit {}", test_cases),
    );
    testing::assert(
        string_contains(
            output,
            "case \"example::parameterized::case_123\":\n        parameterized(\"left\", true)",
        ),
    )
}

#[test]
fn emits_if_continuations() -> unit {
    let source = "fn choose(flag: bool, x: int32, y: int32) -> int32 { if flag { x } else { y } } fn main() { let yes = choose(true, 10, 99); let no = choose(false, 10, 99); let _ = println(\"yes=\" + yes.to_string()); let _ = println(\"no=\" + no.to_string()); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc main0() struct{} {\n    var yes__3 int32\n    var inline16 bool = true\n    var inline17 int32 = 10\n    var inline18 int32 = 99\n    if inline16 {\n        yes__3 = inline17\n    } else {\n        yes__3 = inline18\n    }\n    var no__4 int32\n    var inline12 bool = false\n    var inline13 int32 = 10\n    var inline14 int32 = 99\n    if inline12 {\n        no__4 = inline13\n    } else {\n        no__4 = inline14\n    }\n    var t7 string = _goml_m_inherent_i_int32_i_int32_i_to__string(yes__3)\n    var t8 string = \"yes=\" + t7\n    _goml_m_println(t8)\n    var t9 string = _goml_m_inherent_i_int32_i_int32_i_to__string(no__4)\n    var t10 string = \"no=\" + t9\n    _goml_m_println(t10)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_linked_bool_to_string_runtime() -> unit {
    let output = encode(lower_linked_source("fn main() -> unit { print(true) }"));
    testing::assert(
        string_contains(
            output,
            "func _goml_runtime_core_bool_to_string(x bool) string {\n    if x {\n        return \"true\"\n    } else {\n        return \"false\"\n    }\n}",
        ),
    );
    testing::assert(
        string_contains(output, "func _goml_m_trait__impl_i_ToString_i_bool_i_to__string"),
    )
}

fn required_runtime_key(hook: resources::RuntimeHook) -> string {
    match resources::runtime_abi_by_hook(hook) {
        Some(spec) => spec.key,
        None => {
            testing::fail("expected runtime ABI entry");
            ""
        },
    }
}

fn all_core_runtime_hooks() -> Vec[resources::RuntimeHook] {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    for spec in resources::runtime_abi_specs() {
        match spec.hook {
            Core(_) => hooks.push(spec.hook),
            Standard(_) => (),
        }
    }
    hooks
}

#[test]
fn emits_every_core_runtime_hook() -> unit {
    let hooks = all_core_runtime_hooks();
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(
        string_contains(
            output,
            "import (\n" + "    _goml_fmt \"fmt\"\n" + "    _goml_math \"math\"\n"
                + "    _goml_strconv \"strconv\"\n"
                + "    _goml_strings \"strings\"\n"
                + ")",
        ),
    );
    for hook in hooks {
        testing::assert(
            string_contains(output, "func " + runtime_hook_name(required_runtime_key(hook)) + "("),
        )
    }
    testing::assert(!string_contains(output, "unicode/utf8"));
    testing::assert(string_contains(output, "return rune(s[i])"));
    testing::assert(string_contains(output, "return s[start:end]"));
    testing::assert(string_contains(output, "items: []byte(s),"));
    testing::assert(
        string_contains(
            output,
            "var formatted string = _goml_strconv.FormatFloat(float64(x), 102, -1, 32)",
        ),
    );
    testing::assert(string_contains(output, "return uint64(_goml_math.Float32bits(x))"));
    testing::assert(string_contains(output, "h = h * 1099511628211 + uint64(s[i])"))
}

fn all_standard_runtime_hooks() -> Vec[resources::RuntimeHook] {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    for spec in resources::runtime_abi_specs() {
        match spec.hook {
            Core(_) => (),
            Standard(_) => hooks.push(spec.hook),
        }
    }
    hooks
}

#[test]
fn emits_every_standard_runtime_hook() -> unit {
    let hooks = all_standard_runtime_hooks();
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(
        string_contains(
            output,
            "import (\n" + "    _goml_bytes \"bytes\"\n" + "    _goml_context \"context\"\n"
                + "    _goml_cryptorand \"crypto/rand\"\n"
                + "    _goml_fmt \"fmt\"\n"
                + "    _goml_errors \"errors\"\n"
                + "    _goml_hash \"hash\"\n"
                + "    _goml_io \"io\"\n"
                + "    _goml_math \"math\"\n"
                + "    _goml_os \"os\"\n"
                + "    _goml_exec \"os/exec\"\n"
                + "    _goml_filepath \"path/filepath\"\n"
                + "    _goml_sha256 \"crypto/sha256\"\n"
                + "    _goml_strconv \"strconv\"\n"
                + "    _goml_strings \"strings\"\n"
                + "    _goml_sync \"sync\"\n"
                + "    _goml_syscall \"syscall\"\n"
                + "    _goml_time \"time\"\n"
                + ")",
        ),
    );
    for hook in hooks {
        testing::assert(
            string_contains(output, "func " + runtime_hook_name(required_runtime_key(hook)) + "("),
        )
    }
    testing::assert(string_contains(output, "data, err = _goml_os.ReadFile(path)"));
    testing::assert(string_contains(output, "func _goml_runtime_error_kind(err error) int"));
    testing::assert(
        string_contains(output, "func _goml_runtime_error_raw_code(err error) (bool, int)"),
    );
    testing::assert(string_contains(output, "case _goml_syscall.Errno:"));
    testing::assert(string_contains(output, "if _goml_os.IsNotExist(err)"));
    testing::assert(string_contains(output, "if _goml_os.IsPermission(err)"));
    testing::assert(string_contains(output, "func _goml_runtime_std_fs_read_bytes_v2("));
    testing::assert(
        string_contains(output, "var err error = _goml_os.WriteFile(path, data.items, 0644)"),
    );
    testing::assert(string_contains(output, "var err error = _goml_os.MkdirAll(path, 0755)"));
    testing::assert(string_contains(output, "result, err = _goml_filepath.EvalSymlinks(absolute)"));
    testing::assert(string_contains(output, "names = append(names, entry.Name())"));
    testing::assert(string_contains(output, "file, err = _goml_os.Open(path)"));
    testing::assert(string_contains(output, "var digest _goml_hash.Hash = _goml_sha256.New()"));
    testing::assert(string_contains(output, "_, err = _goml_io.Copy(digest, file)"));
    testing::assert(string_contains(output, "_goml_fmt.Sprintf(\"%x\", digest.Sum(nil))"));
    testing::assert(string_contains(output, "_goml_fmt.Fprint(_goml_os.Stderr, value)"));
    testing::assert(string_contains(output, "data, err = _goml_io.ReadAll(_goml_os.Stdin)"));
    testing::assert(string_contains(output, "_, err = _goml_io.ReadFull(_goml_os.Stdin, data)"));
    testing::assert(string_contains(output, "return _goml_filepath.Join(base, child)"));
    testing::assert(string_contains(output, "_goml_strings.TrimSuffix(base, extension)"));
    testing::assert(
        string_contains(
            output,
            "var cmd *_goml_exec.Cmd = _goml_exec.Command(program, arguments.items...)",
        ),
    );
    testing::assert(string_contains(output, "result, err = _goml_exec.LookPath(program)"));
    testing::assert(string_contains(output, "for _, entry := range environment.items"));
    testing::assert(string_contains(output, "_goml_fmt.Fprintln(_goml_os.Stderr, message)"))
}

#[test]
fn closes_string_runtime_dependencies() -> unit {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    hooks.push(resources::RuntimeHook::Core(resources::CoreRuntimeHook::StringGet));
    hooks.push(resources::RuntimeHook::Core(resources::CoreRuntimeHook::StringByteSlice));
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(string_contains(output, "func _goml_runtime_core_string_get("));
    testing::assert(string_contains(output, "func _goml_runtime_core_string_byte_slice("));
    testing::assert(!string_contains(output, "unicode/utf8"))
}

#[test]
fn imports_intrinsic_runtime_dependencies() -> unit {
    let intrinsics: Vec[string] = Vec::new();
    intrinsics.push("ref.ptr_hash");
    intrinsics.push("vec.reserve");
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, Vec::new(), intrinsics);
    let output = encode(File { items });
    testing::assert(
        string_contains(
            output,
            "import (\n" + "    _goml_reflect \"reflect\"\n" + "    _goml_slices \"slices\"\n" + ")",
        ),
    )
}

#[test]
fn prunes_imports_used_only_by_dead_helpers() -> unit {
    let output = encode(
        lower_linked_source(
            "fn main() -> unit { let cell = Ref::new(1); cell.set(cell.get() + 1); let values: Vec[int32] = Vec::new(); values.push(cell.get()); println(values.len()); }",
        ),
    );
    testing::assert(!string_contains(output, "_goml_reflect \"reflect\""));
    testing::assert(!string_contains(output, "_goml_slices \"slices\""))
}

#[test]
fn keeps_imports_used_by_reachable_types() -> unit {
    let imports: Vec[(string, string)] = Vec::new();
    imports.push(("_goml_bytes", "bytes"));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "buffer",
            ty: Type::Named { name: "_goml_bytes.Buffer" },
            value: Option::None,
        },
    );
    let items: Vec[Item] = Vec::new();
    items.push(Item::ImportGroup(imports));
    items.push(
        Item::Function(
            Function {
                name: "main",
                params: Vec::new(),
                ret_ty: Option::None,
                body: Block { stmts },
            },
        ),
    );
    let output = encode(prune_functions(File { items }));
    testing::assert(string_contains(output, "_goml_bytes \"bytes\""))
}

#[test]
fn emits_complete_vec_runtime_helpers() -> unit {
    let ty = repr::Type::VecType { elem: repr::Type::Int32 };
    let output = encode(File { items: vec_runtime_items(ty) });
    testing::assert(
        string_contains(output, "func vec_with_capacity__Vec_5int32(capacity int) *_goml_vec_int32"),
    );
    testing::assert(string_contains(output, "items: _goml_slices.Grow([]int32{}, int(capacity)),"));
    testing::assert(
        string_contains(
            output,
            "func vec_reserve__Vec_5int32(vec *_goml_vec_int32, additional int) struct{}",
        ),
    );
    testing::assert(string_contains(output, "clear(vec.items[new_len:int(len(vec.items))])"));
    testing::assert(string_contains(output, "vec.items = vec.items[0:new_len]"))
}

#[test]
fn emits_complete_hashmap_and_ref_runtime_helpers() -> unit {
    let Ok(builtin) = tast::builtin_contract() else {
        testing::fail("expected builtin contract");
        return
    };
    let key = repr::Type::String;
    let value = repr::Type::Int32;
    let map_output = encode(
        File {
            items: hashmap_items(
                builtin,
                key,
                value,
                Vec::new(),
                Vec::new(),
                Vec::new(),
                new_function_names(),
                true,
            ),
        },
    );
    testing::assert(
        string_contains(
            map_output,
            "func hashmap_new__HashMap_6string_5int32() *hashmap_string_int32_x",
        ),
    );
    testing::assert(
        string_contains(map_output, "buckets: make(map[uint64][]hashmap_string_int32_x_entry),"),
    );
    testing::assert(string_contains(map_output, "func hashmap_len__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "func hashmap_remove__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "func hashmap_contains__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "func hashmap_entries__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "for _, h := range m.hashes {"));
    let ref_output = encode(
        File { items: ref_runtime_items(repr::Type::RefType { elem: repr::Type::Int32 }) },
    );
    testing::assert(
        string_contains(ref_output, "return uint64(_goml_reflect.ValueOf(reference).Pointer())"),
    )
}

#[test]
fn emits_tuple_types_and_prunes_dead_bindings() -> unit {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Tuple2_4bool_4bool struct {\n    _0 bool\n    _1 bool\n}\n\ntype Tuple3_4bool_4bool_18Tuple2_4bool_4bool struct {\n    _0 bool\n    _1 bool\n    _2 Tuple2_4bool_4bool\n}\n\nfunc main0() struct{} {\n    var x5 bool = false\n    _goml_m_print(x5)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn preserves_nested_tuple_discovery_order() -> unit {
    let source = "fn classify(p: ((int32, int32), string)) -> string { p.1 } fn main() -> unit { println(classify(((1, 2), \"value\"))); }";
    testing::assert(
        string_contains(
            encode(lower_source(source)),
            "type Tuple2_20Tuple2_5int32_5int32_6string struct {\n    _0 Tuple2_5int32_5int32\n    _1 string\n}\n\ntype Tuple2_5int32_5int32 struct",
        ),
    )
}

#[test]
fn emits_primitive_matches() -> unit {
    let source = "fn main() { let x: uint8 = 5; let y: string = match x { 0 => \"zero\", 1 => \"one\", _ => \"other\", }; println(y); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc main0() struct{} {\n    var x__0 uint8 = 5\n    var jp3 string\n    switch x__0 {\n    case 0:\n        jp3 = \"zero\"\n    case 1:\n        jp3 = \"one\"\n    default:\n        jp3 = \"other\"\n    }\n    _goml_m_println(jp3)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_breaking_while_loops() -> unit {
    let source = "fn main() { let i = Ref::new(0); while i.get() < 10 { if i.get() == 5 { break } else { () }; let _ = println(i.get()); i.set(i.get() + 1); }; let _ = println(\"done\"); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_int_x struct {\n    value int\n}\n\nfunc main0() struct{} {\n    var i__0 *ref_int_x = _goml_m_inherent_i_Ref_i_Ref_l_int_r__i_new(0)\n    Loop_loop7:\n    for {\n        var t8 int = _goml_m_inherent_i_Ref_i_Ref_l_int_r__i_get(i__0)\n        var t9 bool = t8 < 10\n        if t9 {\n            var t14 int = _goml_m_inherent_i_Ref_i_Ref_l_int_r__i_get(i__0)\n            var t15 bool = t14 == 5\n            if t15 {\n                break Loop_loop7\n            } else {\n                var t11 int = _goml_m_inherent_i_Ref_i_Ref_l_int_r__i_get(i__0)\n                _goml_m_println(t11)\n                var t12 int = _goml_m_inherent_i_Ref_i_Ref_l_int_r__i_get(i__0)\n                var t13 int = t12 + 1\n                _goml_m_inherent_i_Ref_i_Ref_l_int_r__i_set(i__0, t13)\n                continue\n            }\n        } else {\n            break Loop_loop7\n        }\n    }\n    _goml_m_println(\"done\")\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_value_and_infinite_loops_without_expanding_continuations() -> unit {
    let source = "fn choose(flag: bool) -> int { loop { if flag { break 7; } else { continue; }; } } fn spin() -> int { loop {} } fn main() -> unit { let flag = Ref::new(false); println(choose(!flag.get())); if flag.get() { println(spin()); }; }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func choose(flag__0 bool) int {"));
    testing::assert(string_contains(output, "Loop_loop_expr"));
    testing::assert(string_contains(output, " = 7\n            break Loop_loop_expr"));
    testing::assert(string_contains(output, "func spin() int {\n    for {"));
    testing::assert(!string_contains(output, "panic(\"unreachable\")"))
}

#[test]
fn recognizes_recursive_joins_independently_of_their_names() -> unit {
    let ty = repr::Type::Unit;
    let recursive = anf::JoinBind {
        name: "renamed_control_node",
        role: anf::JoinRole::Continuation,
        params: Vec::from_array([]),
        ret_ty: ty,
        body: anf::Block {
            binds: Vec::from_array([]),
            term: anf::Term::Jump {
                target: "renamed_control_node",
                args: Vec::from_array([]),
                ret_ty: ty,
            },
        },
    };
    let recursive_group: Vec[anf::JoinBind] = Vec::from_array([]);
    recursive_group.push(recursive);
    let binds: Vec[anf::Bind] = Vec::from_array([]);
    binds.push(anf::Bind::JoinRec(recursive_group));
    let functions: Vec[anf::Function] = Vec::from_array([]);
    functions.push(
        anf::Function {
            name: "main",
            origin: anf::FunctionOrigin::Source,
            root: true,
            trait_impl: Option::None,
            params: Vec::from_array([]),
            ret_ty: ty,
            body: anf::Block {
                binds,
                term: anf::Term::Jump {
                    target: "renamed_control_node",
                    args: Vec::from_array([]),
                    ret_ty: ty,
                },
            },
        },
    );
    let output = encode(
        required_lower(
            lower(
                anf::File {
                    functions,
                    enums: Vec::from_array([]),
                    structs: Vec::from_array([]),
                    type_instances: Vec::from_array([]),
                    constants: Vec::from_array([]),
                    statics: Vec::from_array([]),
                    closure_defs: Vec::from_array([]),
                },
            ),
        ),
    );
    testing::assert(string_contains(output, "func main0() struct{} {\n    for {"));
    testing::assert(!string_contains(output, "panic(\"unreachable\")"))
}

#[test]
fn rejects_unsupported_mutually_recursive_join_groups_before_emission() -> unit {
    let ty = repr::Type::Unit;
    let joins: Vec[anf::JoinBind] = Vec::from_array([]);
    joins.push(
        anf::JoinBind {
            name: "first",
            role: anf::JoinRole::Continuation,
            params: Vec::from_array([]),
            ret_ty: ty,
            body: anf::Block {
                binds: Vec::from_array([]),
                term: anf::Term::Jump { target: "second", args: Vec::from_array([]), ret_ty: ty },
            },
        },
    );
    joins.push(
        anf::JoinBind {
            name: "second",
            role: anf::JoinRole::Continuation,
            params: Vec::from_array([]),
            ret_ty: ty,
            body: anf::Block {
                binds: Vec::from_array([]),
                term: anf::Term::Jump { target: "first", args: Vec::from_array([]), ret_ty: ty },
            },
        },
    );
    let functions: Vec[anf::Function] = Vec::from_array([]);
    functions.push(
        anf::Function {
            name: "cycle",
            origin: anf::FunctionOrigin::Source,
            root: true,
            trait_impl: Option::None,
            params: Vec::from_array([]),
            ret_ty: ty,
            body: anf::Block {
                binds: Vec::from_array([anf::Bind::JoinRec(joins)]),
                term: anf::Term::Jump { target: "first", args: Vec::from_array([]), ret_ty: ty },
            },
        },
    );
    match lower(
        anf::File {
            functions,
            enums: Vec::from_array([]),
            structs: Vec::from_array([]),
            type_instances: Vec::from_array([]),
            constants: Vec::from_array([]),
            statics: Vec::from_array([]),
            closure_defs: Vec::from_array([]),
        },
    ) {
        Err(error) => testing::assert_eq(
            error,
            "in function cycle: Go backend requires each recursive join group to contain exactly one join",
        ),
        Ok(_) => testing::fail("expected recursive join validation error"),
    }
}

fn callable_file(callable: repr::Callable) -> anf::File {
    let ty = repr::Type::Func { params: Vec::from_array([]), ret_ty: repr::Type::Unit };
    anf::File {
        functions: Vec::from_array(
            [
                anf::Function {
                    name: "invalid_callable",
                    origin: anf::FunctionOrigin::Source,
                    root: true,
                    trait_impl: Option::None,
                    params: Vec::from_array([]),
                    ret_ty: ty,
                    body: anf::Block {
                        binds: Vec::from_array([]),
                        term: anf::Term::Return(anf::Imm::Callable { callable, ty }),
                    },
                },
            ],
        ),
        enums: Vec::from_array([]),
        structs: Vec::from_array([]),
        type_instances: Vec::from_array([]),
        constants: Vec::from_array([]),
        statics: Vec::from_array([]),
        closure_defs: Vec::from_array([]),
    }
}

#[test]
fn rejects_unknown_runtime_hooks_before_emission() -> unit {
    match lower(callable_file(repr::Callable::Runtime("vendor.unknown"))) {
        Err(error) => testing::assert_eq(error, "unknown runtime hook vendor.unknown"),
        Ok(_) => testing::fail("expected runtime hook validation error"),
    }
}

#[test]
fn rejects_unknown_intrinsics_before_emission() -> unit {
    match lower(callable_file(repr::Callable::Intrinsic("vendor.unknown"))) {
        Err(error) => testing::assert_eq(error, "unknown intrinsic vendor.unknown"),
        Ok(_) => testing::fail("expected intrinsic validation error"),
    }
}

#[test]
fn lowers_go_ffi_calls_through_abi_wrappers() -> unit {
    let output = encode(
        lower_source(
            "#[go_ffi(\"strings\", \"Cut\")] extern fn cut(value: string, separator: string) -> (string, string, bool); #[go_ffi(\"runtime\", \"Gosched\")] extern fn gosched() -> unit; fn main() -> unit { let _ = cut(\"a:b\", \":\"); gosched() }",
        ),
    );
    testing::assert(string_contains(output, "\"strings\""));
    testing::assert(string_contains(output, "\"runtime\""));
    testing::assert(string_contains(output, ".Cut(arg0, arg1)"));
    testing::assert(string_contains(output, "result0, result1, result2 ="));
    testing::assert(string_contains(output, ".Gosched()\n    return struct{}{}"))
}

#[test]
fn lowers_empty_marker_dyn_go_ffi_values_through_data() -> unit {
    let output = encode(
        lower_source(
            "trait NativeValue {} struct Box {} impl NativeValue for Box {} #[go_ffi(\"example.com/ffi\", \"Echo\")] extern fn echo(value: dyn NativeValue) -> dyn NativeValue; fn main() -> unit { let value: dyn NativeValue = Box {} as dyn NativeValue; let _ = echo(value); }",
        ),
    );
    if !string_contains(output, ".Echo(arg0.data)")
        || !string_contains(output, "return dyn__NativeValue{")
        || !string_contains(output, "data: _goml_ffi_import_") {
        testing::fail(output)
    } else {}
}

#[test]
fn preserves_loop_carried_assignments() -> unit {
    let source = "fn main() -> unit { let mut i = 0; while i < 3 { println(i); i = i + 1; } }";
    testing::assert(string_contains(encode(lower_source(source)), "\n            i__0 = "))
}

#[test]
fn preserves_all_exit_while_conditions() -> unit {
    let source = "fn loop_return_unit(flag: bool) -> unit { while if flag { return } else { return } { println(\"unreachable\"); }; } fn main() -> unit { loop_return_unit(true) }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            "func loop_return_unit(flag__0 bool) struct{} {\n    if flag__0 {\n        return struct{}{}\n    } else {\n        return struct{}{}\n    }\n}",
        ),
    )
}

#[test]
fn preserves_reused_loop_labels() -> unit {
    let source = "enum Event { Open, Close, Advance, Error, } fn main() -> unit { let running = Ref::new(true); while running.get() { let event = Event::Open; match event { Event::Open => { let scanning = Ref::new(false); while scanning.get() {} }, Event::Close => (), Event::Advance => (), Event::Error => (), }; let scanning = Ref::new(false); while scanning.get() {}; running.set(false) }; println(\"ok\") }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "Loop_loop6:\n    for {"));
    testing::assert(string_contains(output, "Loop_loop11__2:"));
    testing::assert(string_contains(output, "Loop_loop11__3:"));
    testing::assert(string_contains(output, "Loop_loop11__4:"));
    testing::assert(!string_contains(output, "panic(\"unreachable\")"))
}

#[test]
fn emits_vec_runtime_structs() -> unit {
    let source = "fn one() -> Vec[int32] { let v: Vec[int32] = Vec::new(); v.push(1); v } fn main() -> unit { let xs: Vec[int32] = one(); xs.push(2); println(xs.len()); }";
