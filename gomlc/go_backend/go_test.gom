#[test]
fn resolves_generic_types_in_struct_fields() -> unit {
    let source = "struct Container { value: Option[int32], label: string, } fn main() -> unit { let c = Container { value: Option::Some(42), label: \"test\" }; match c.value { Option::Some(value) => println(value), Option::None => (), } }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            "type Container struct {\n    value Option__int32\n    label string\n}",
        ),
    );
    testing::assert(!string_contains(output, "value Option_5int32"))
}

#[test]
fn resolves_runtime_types_in_recursive_struct_fields() -> unit {
    let source = "enum Maybe[T] { None, Some(T), } struct Node { next: Ref[Maybe[Node]], } fn main() -> unit { let node: Node = Node { next: Ref::new(Maybe::None) }; let _ = node; }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(output, "type ref_Maybe__Node_x struct {\n    value Maybe__Node\n}"),
    );
    testing::assert(!string_contains(output, "type ref_App_"))
}

#[test]
fn compacts_dyn_names_in_synthetic_options() -> unit {
    let source = "trait Display { fn show(self: Self) -> string; } impl Display for int { fn show(self: int) -> string { self.to_string() } } fn build() -> int32 { let m: HashMap[int32, dyn Display] = HashMap::new(); m.set(1, if true { return 7 } else { 1 }); 0 } fn main() -> unit { println(build().to_string()) }";
