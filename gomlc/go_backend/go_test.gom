#[test]
fn emits_every_core_runtime_hook() -> unit {
    let hooks = all_core_runtime_hooks();
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(
        string_contains(
            output,
            "import (\n" + "    _goml_fmt \"fmt\"\n" + "    _goml_math \"math\"\n"
                + "    _goml_strconv \"strconv\"\n"
                + "    _goml_strings \"strings\"\n"
                + "    _goml_utf8 \"unicode/utf8\"\n"
                + ")",
        ),
    );
    for key in hooks {
        testing::assert(string_contains(output, "func " + runtime_hook_name(key) + "("))
    };
    testing::assert(string_contains(output, "func _goml_runtime_string_decode_utf8_at_native("));
    testing::assert(
        string_contains(
            output,
            "if !_goml_runtime_core_string_is_char_boundary(s, start) && _goml_runtime_core_string_is_char_boundary(s, end) {\n        panic(\"invalid string byte slice\")\n    }",
        ),
    );
    testing::assert(string_contains(output, "items: []byte(s),"));
    testing::assert(
        string_contains(
            output,
            "var formatted string = _goml_strconv.FormatFloat(float64(x), 102, -1, 32)",
        ),
    );
    testing::assert(string_contains(output, "return uint64(_goml_math.Float32bits(x))"));
    testing::assert(string_contains(output, "h = h * 1099511628211 + uint64(s[i])"))
}

