#[test]
fn sorts_dyn_helpers_and_compacts_builtin_impl_names() -> unit {
    let source = "fn main() { let inner: dyn Hash = 1 as dyn Hash; let r = Ref::new(inner); let alias = r; let value: dyn Hash = r as dyn Hash; println((Hash::hash(value) == Hash::hash(alias)).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_Dyn_Hash_x struct {\n    value dyn__Hash\n}\n\ntype dyn__Hash_vtable struct {\n    hash func(any) uint64\n}\n\ntype dyn__Hash struct {\n    data any\n    vtable *dyn__Hash_vtable\n}\n\nfunc dyn__Hash__wrap__Ref_8Dyn_Hash__hash(self any) uint64 {\n    return _goml_m_trait__impl_i_Hash_i_Ref_l_dynHash_r__i_hash(self.(*ref_Dyn_Hash_x))\n}\n\nfunc dyn__Hash__vtable__Ref_8Dyn_Hash() *dyn__Hash_vtable {\n    return &dyn__Hash_vtable{\n        hash: dyn__Hash__wrap__Ref_8Dyn_Hash__hash,\n    }\n}\n\nfunc dyn__Hash__wrap__int__hash(self any) uint64 {\n    return _goml_m_trait__impl_i_Hash_i_int_i_hash(self.(int))\n}\n\nfunc dyn__Hash__vtable__int() *dyn__Hash_vtable {\n    return &dyn__Hash_vtable{\n        hash: dyn__Hash__wrap__int__hash,\n    }\n}\n\nfunc main0() struct{} {\n    var inner__0 dyn__Hash = dyn__Hash{\n        data: int(1),\n        vtable: dyn__Hash__vtable__int(),\n    }\n    var r__1 *ref_Dyn_Hash_x = _goml_m_inherent_i_Ref_i_Ref_l_dynHash_r__i_new(inner__0)\n    var value__3 dyn__Hash = dyn__Hash{\n        data: r__1,\n        vtable: dyn__Hash__vtable__Ref_8Dyn_Hash(),\n    }\n    var t2 uint64 = value__3.vtable.hash(value__3.data)\n    var t3 uint64 = _goml_m_trait__impl_i_Hash_i_Ref_l_dynHash_r__i_hash(r__1)\n    var t4 bool = t2 == t3\n    var t5 string = _goml_m_trait__impl_i_ToString_i_bool_i_to__string(t4)\n    _goml_m_println(t5)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn uses_synthetic_hashmap_options_when_unmaterialized() -> unit {
    let source = "fn main() -> unit { let map: HashMap[int32, string] = HashMap::new(); map[1] = \"ok\"; println(\"ok\"); }";
