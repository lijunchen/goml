    testing::assert(!string_contains(output, "type Option__string interface"))
}

#[test]
fn uses_user_hashmap_option_variants() -> unit {
    let source = "enum Option[T] { Nada, Just(T) } fn main() -> unit { let map: HashMap[int32, int32] = HashMap::new(); map.set(1, 2); match map.get(1) { Option::Just(value) => println(value), Option::Nada => println(0), } }";
    let output = encode(lower_linked_source(source));
    testing::assert(string_contains(output, "return Just{"));
    testing::assert(string_contains(output, "return Nada{}"))
}

#[test]
fn reuses_materialized_hashmap_option_types() -> unit {
    let source = "struct HashmapInt32Int32X { value: int32, } fn main() -> unit { let c = HashmapInt32Int32X { value: 4 }; let m: HashMap[int32, int32] = HashMap::new(); m.set(1, 5); match m.get(1) { Option::Some(v) => println(c.value + v), Option::None => println(0), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype hashmap_int32_int32_x_entry struct {\n    active bool\n    key int32\n    value int32\n}\n\ntype hashmap_int32_int32_x struct {\n    buckets map[uint64][]hashmap_int32_int32_x_entry\n    hashes []uint64\n    len int\n}\n\ntype HashmapInt32Int32X struct {\n    value int32\n}\n\ntype Option__int32 interface {\n    isOption__int32()\n}\n\ntype None struct {}\n\nfunc (_ None) isOption__int32() {}\n\ntype Some struct {\n    _0 int32\n}\n\nfunc (_ Some) isOption__int32() {}\n\nfunc main0() struct{} {\n    var m__1 *hashmap_int32_int32_x = _goml_m_inherent_i_HashMap_i_HashMap_l_int32_c_int32_r__i_new()\n    _goml_m_inherent_i_HashMap_i_HashMap_l_int32_c_int32_r__i_set(m__1, 1, 5)\n    var mtmp1 Option__int32 = _goml_m_inherent_i_HashMap_i_HashMap_l_int32_c_int32_r__i_get(m__1, 1)\n    switch mtmp1.(type) {\n    case None:\n        _goml_m_println(0)\n        return struct{}{}\n    case Some:\n        var x2 int32 = mtmp1.(Some)._0\n        var t6 int32 = 4\n        var t7 int32 = t6 + x2\n        _goml_m_println(t7)\n        return struct{}{}\n    default:\n        panic(\"non-exhaustive match\")\n    }\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_builtin_tostring_vtables() -> unit {
    let source = "fn main() { let inner: dyn ToString = 1 as dyn ToString; let r = Ref::new(inner); let value: dyn ToString = r as dyn ToString; println(ToString::to_string(value)); }";
    testing::assert_eq(
