#[test]
fn preserves_user_struct_order_before_closure_environments() -> unit {
    let source = "struct GomlInherentClosureEnvF0ClosureEnvF0Apply { value: int32, } fn main() -> unit { let y = 1; let f = |x: int32| x + y; let c = GomlInherentClosureEnvF0ClosureEnvF0Apply { value: 2 }; println((f(3) + c.value).to_string()) }";
