#[test]
fn emits_missing_runtime_helpers() -> unit {
    let source = "enum Never {} fn never() -> Never { never() } fn missing_int(value: Never) -> int32 { match value {} } fn missing_string(value: Never) -> string { match value {} } fn main() -> unit { println(missing_int(never())); println(missing_string(never())); }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            "func _goml_intrinsic_missing(s string) struct{} {\n    println(\"missing: \" + s)\n    panic(\"\")\n    return struct{}{}\n}",
        ),
    );
    testing::assert(
        string_contains(
            output,
            "func missing__int32(s string) int32 {\n    _goml_intrinsic_missing(s)\n    var ret int32\n    return ret\n}",
        ),
    );
    testing::assert(
        string_contains(
            output,
            "func missing__string(s string) string {\n    _goml_intrinsic_missing(s)\n    var ret string\n    return ret\n}",
        ),
    )
}

