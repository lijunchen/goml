#[test]
fn sorts_dyn_helpers_and_compacts_builtin_impl_names() -> unit {
    let source = "fn main() { let inner: dyn Hash = 1; let r = Ref::new(inner); let alias = r; let value: dyn Hash = r; println((Hash::hash(value) == Hash::hash(alias)).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_Dyn_Hash_x struct {\n    value dyn__Hash\n}\n\ntype dyn__Hash_vtable struct {\n    hash func(any) uint64\n}\n\ntype dyn__Hash struct {\n    data any\n    vtable *dyn__Hash_vtable\n}\n\nfunc dyn__Hash__wrap__Ref_8Dyn_Hash__hash(self any) uint64 {\n    return _goml_m_trait__impl_i_Hash_i_Ref_l_dynHash_r__i_hash(self.(*ref_Dyn_Hash_x))\n}\n\nfunc dyn__Hash__vtable__Ref_8Dyn_Hash() *dyn__Hash_vtable {\n    return &dyn__Hash_vtable{\n        hash: dyn__Hash__wrap__Ref_8Dyn_Hash__hash,\n    }\n}\n\nfunc dyn__Hash__wrap__int__hash(self any) uint64 {\n    return _goml_m_trait__impl_i_Hash_i_int_i_hash(self.(int))\n}\n\nfunc dyn__Hash__vtable__int() *dyn__Hash_vtable {\n    return &dyn__Hash_vtable{\n        hash: dyn__Hash__wrap__int__hash,\n    }\n}\n\nfunc main0() struct{} {\n    var inner__0 dyn__Hash = dyn__Hash{\n        data: int(1),\n        vtable: dyn__Hash__vtable__int(),\n    }\n    var r__1 *ref_Dyn_Hash_x = _goml_m_inherent_i_Ref_i_Ref_l_dynHash_r__i_new(inner__0)\n    var alias__2 *ref_Dyn_Hash_x = r__1\n    var value__3 dyn__Hash = dyn__Hash{\n        data: r__1,\n        vtable: dyn__Hash__vtable__Ref_8Dyn_Hash(),\n    }\n    var t2 uint64 = value__3.vtable.hash(value__3.data)\n    var t3 uint64 = _goml_m_trait__impl_i_Hash_i_Ref_l_dynHash_r__i_hash(alias__2)\n    var t4 bool = _goml_m_trait__impl_i_Eq_i_uint64_i_eq(t2, t3)\n    var t5 string = _goml_m_trait__impl_i_ToString_i_bool_i_to__string(t4)\n    _goml_m_println(t5)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn uses_synthetic_hashmap_options_when_unmaterialized() -> unit {
    let source = "fn main() -> unit { let map: HashMap[int32, string] = HashMap::new(); map[1] = \"ok\"; println(\"ok\"); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type _goml_synthetic__goml_option__string interface"));
    testing::assert(
        string_contains(
            output,
            "func hashmap_get__HashMap_5int32_6string(m *hashmap_int32_string_x, key int32) _goml_synthetic__goml_option__string",
        ),
    );
    testing::assert(!string_contains(output, "type Option__string interface"))
}

#[test]
fn uses_user_hashmap_option_variants() -> unit {
    let source = "enum Option[T] { Nada, Just(T) } fn main() -> unit { let map: HashMap[int32, int32] = HashMap::new(); map.set(1, 2); match map.get(1) { Option::Just(value) => println(value), Option::Nada => println(0), } }";
    let output = encode(lower_linked_source(source));
    testing::assert(string_contains(output, "return Just{"));
    testing::assert(string_contains(output, "return Nada{}"))
}

#[test]
fn reuses_materialized_hashmap_option_types() -> unit {
    let source = "struct HashmapInt32Int32X { value: int32, } fn main() -> unit { let c = HashmapInt32Int32X { value: 4 }; let m: HashMap[int32, int32] = HashMap::new(); m.set(1, 5); match m.get(1) { Option::Some(v) => println(c.value + v), Option::None => println(0), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype hashmap_int32_int32_x_entry struct {\n    active bool\n    key int32\n    value int32\n}\n\ntype hashmap_int32_int32_x struct {\n    buckets map[uint64][]hashmap_int32_int32_x_entry\n    hashes []uint64\n    len int\n}\n\ntype HashmapInt32Int32X struct {\n    value int32\n}\n\ntype Option__int32 interface {\n    isOption__int32()\n}\n\ntype None struct {}\n\nfunc (_ None) isOption__int32() {}\n\ntype Some struct {\n    _0 int32\n}\n\nfunc (_ Some) isOption__int32() {}\n\nfunc main0() struct{} {\n    var c__0 HashmapInt32Int32X = HashmapInt32Int32X{\n        value: 4,\n    }\n    var m__1 *hashmap_int32_int32_x = _goml_m_inherent_i_HashMap_i_HashMap_l_int32_c_int32_r__i_new()\n    _goml_m_inherent_i_HashMap_i_HashMap_l_int32_c_int32_r__i_set(m__1, 1, 5)\n    var mtmp1 Option__int32 = _goml_m_inherent_i_HashMap_i_HashMap_l_int32_c_int32_r__i_get(m__1, 1)\n    switch mtmp1.(type) {\n    case None:\n        _goml_m_println(0)\n    case Some:\n        var x2 int32 = mtmp1.(Some)._0\n        var v__2 int32 = x2\n        var t6 int32 = c__0.value\n        var t7 int32 = t6 + v__2\n        _goml_m_println(t7)\n    default:\n        panic(\"non-exhaustive match\")\n    }\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
