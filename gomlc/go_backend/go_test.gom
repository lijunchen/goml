        output,
        "type GomlInherentClosureEnvF0ClosureEnvF0Apply struct",
        "type closure_env_f_0 struct",
    );
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__f__0_i_closure__env__f__0_i_apply(",
        ),
    )
}

#[test]
fn hashes_and_compacts_long_go_identifiers() -> unit {
    testing::assert_eq(hash::sha256_prefix("abc"), "ba7816bf8f01cfea414140de5dae2223");
    testing::assert_eq(
        hash::sha256_hex("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    );
    testing::assert_eq(
        go_ident("inherent#closure_env_grow_T_int32_0#closure_env_grow_T_int32_0#apply"),
        "_goml_m_inherent_i_closure__en_hc8c2267ce73456d4efdb3aa5198c65a2_nt32__0_i_apply",
    )
}

#[test]
fn mangles_unicode_identifiers_without_byte_indexing() -> unit {
    testing::assert(!is_valid_ident("变量"));
    testing::assert_eq(go_ident("a::b"), "_goml_m_a_p_b");
    testing::assert_eq(go_local_ident("包/变量"), go_ident("包__变量"))
}

#[test]
fn emits_structs_before_generic_enums() -> unit {
    let source = "fn build() -> Option[() -> int32] { let _: Option[int32] = Option::Some(1); Option::Some(|| 1) } fn main() -> unit { match build() { Option::Some(f) => println(f()), Option::None => println(0), } }";
    let output = encode(lower_source(source));
    assert_appears_before(
        output,
        "type closure_env_build_0 struct",
        "type _goml_m_Option_____o__q__m__z_int32 interface",
    );
    testing::assert(string_contains(output, "type Option__int32 interface"));
    testing::assert(string_contains(output, "var inline19 func() int32 = func() int32"))
}

#[test]
fn preserves_enums_before_field_instances() -> unit {
    let output = encode(
        lower_source(
            "enum Expr { Num(int32), Add(Option[Expr]), } fn main() -> unit { let value: Option[Expr] = Option::None; match value { Option::Some(_) => (), Option::None => (), }; }",
        ),
    );
    let prefix = "package main\n\ntype Expr interface {\n    isExpr()\n}";
    testing::assert_eq(output.byte_slice(0, prefix.byte_len()), prefix);
    testing::assert(string_contains(output, "type Option__Expr interface"))
}

#[test]
fn protects_dyn_object_names_from_vtable_collisions() -> unit {
    let source = "trait A { fn f(self: Self) -> int32; } trait A_vtable { fn g(self: Self) -> int32; } struct S {} impl A for S { fn f(self: S) -> int32 { 3 } } impl A_vtable for S { fn g(self: S) -> int32 { 4 } } fn main() -> unit { let left: dyn A = (S {}) as dyn A; let right: dyn A_vtable = (S {}) as dyn A_vtable; println(A::f(left) + A_vtable::g(right)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype S struct {}\n\ntype dyn__A_vtable struct {\n    f func(any) int32\n}\n\ntype dyn__A struct {\n    data any\n    vtable *dyn__A_vtable\n}\n\ntype dyn__A_vtable_vtable struct {\n    g func(any) int32\n}\n\ntype _goml_dyn_object_A_vtable struct {\n    data any\n    vtable *dyn__A_vtable_vtable\n}\n\nfunc dyn__A__wrap__S__f(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_S_i_f(self.(S))\n}\n\nfunc dyn__A__vtable__S() *dyn__A_vtable {\n    return &dyn__A_vtable{\n        f: dyn__A__wrap__S__f,\n    }\n}\n\nfunc dyn__A_vtable__wrap__S__g(self any) int32 {\n    return _goml_m_trait__impl_i_A__vtable_i_S_i_g(self.(S))\n}\n\nfunc dyn__A_vtable__vtable__S() *dyn__A_vtable_vtable {\n    return &dyn__A_vtable_vtable{\n        g: dyn__A_vtable__wrap__S__g,\n    }\n}\n\nfunc _goml_m_trait__impl_i_A_i_S_i_f(self__0 S) int32 {\n    return 3\n}\n\nfunc _goml_m_trait__impl_i_A__vtable_i_S_i_g(self__1 S) int32 {\n    return 4\n}\n\nfunc main0() struct{} {\n    var t6 S = S{}\n    var left__2 dyn__A = dyn__A{\n        data: t6,\n        vtable: dyn__A__vtable__S(),\n    }\n    var t7 S = S{}\n    var right__3 _goml_dyn_object_A_vtable = _goml_dyn_object_A_vtable{\n        data: t7,\n        vtable: dyn__A_vtable__vtable__S(),\n    }\n    var t8 int32 = left__2.vtable.f(left__2.data)\n    var t9 int32 = right__3.vtable.g(right__3.data)\n    var t10 int32 = t8 + t9\n    _goml_m_println(t10)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_pointer_equality_helpers() -> unit {
    let source = "fn main() -> unit { let a: Ref[int32] = Ref::new(1); let b = a; let c = Ref::new(1); println(ptr_eq(a, b)); println(ptr_eq(a, c)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_int32_x struct {\n    value int32\n}\n\nfunc ptr_eq__Ref_5int32(a *ref_int32_x, b *ref_int32_x) bool {\n    return a == b\n}\n\nfunc main0() struct{} {\n    var a__0 *ref_int32_x = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_new(1)\n    var c__2 *ref_int32_x = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_new(1)\n    var t3 bool = ptr_eq__Ref_5int32(a__0, a__0)\n    _goml_m_println(t3)\n    var t4 bool = ptr_eq__Ref_5int32(a__0, c__2)\n    _goml_m_println(t4)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_missing_runtime_helpers() -> unit {
    let source = "enum Never {} fn never() -> Never { never() } fn missing_int(value: Never) -> int32 { match value {} } fn missing_string(value: Never) -> string { match value {} } fn main() -> unit { println(missing_int(never())); println(missing_string(never())); }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            "func _goml_intrinsic_missing(s string) struct{} {\n    println(\"missing: \" + s)\n    panic(\"\")\n    return struct{}{}\n}",
        ),
    );
    testing::assert(
        string_contains(
            output,
            "func missing__int32(s string) int32 {\n    _goml_intrinsic_missing(s)\n    var ret int32\n    return ret\n}",
        ),
    );
    testing::assert(
        string_contains(
            output,
            "func missing__string(s string) string {\n    _goml_intrinsic_missing(s)\n    var ret string\n    return ret\n}",
        ),
    )
}

#[test]
fn emits_hidden_ref_intrinsic_helpers() -> unit {
    let source = "fn ref(x: int32) -> Ref[int32] { println(\"user ref \" + x.to_string()); Ref::new(x + 10) } fn ref_get(r: Ref[int32]) -> int32 { println(\"user get\"); 100 } fn ref_set(r: Ref[int32], x: int32) -> unit { println(\"user set \" + x.to_string()); } fn main() -> unit { let mut x: int32 = 0; let inc = || { x = x + 1; x }; println(inc().to_string()); println(x.to_string()); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func ref__Ref_5int32(value int32) *ref_int32_x"));
    testing::assert(
        string_contains(output, "func ref_get__Ref_5int32(reference *ref_int32_x) int32"),
    );
    testing::assert(
        string_contains(
            output,
            "func ref_set__Ref_5int32(reference *ref_int32_x, value int32) struct{}",
        ),
    );
    testing::assert(string_contains(output, "type closure_env_inc_0 struct"));
    testing::assert(string_contains(output, "var inc__5 func() int32 = func() int32"));
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__inc__0_i_closure__env__inc__0_i_apply(",
        ),
    )
}

#[test]
fn protects_go_init_from_user_functions() -> unit {
