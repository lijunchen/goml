#[test]
fn preserves_enums_before_field_instances() -> unit {
    let output = encode(
        lower_source(
            "enum Expr { Num(int32), Add(Option[Expr]), } fn main() -> unit { let value: Option[Expr] = Option::None; match value { Option::Some(_) => (), Option::None => (), }; }",
        ),
    );
    let prefix = "package main\n\ntype Expr interface {\n    isExpr()\n}";
    testing::assert_eq(output.byte_slice(0, prefix.byte_len()), prefix);
    testing::assert(string_contains(output, "type Option__Expr interface"))
}

#[test]
fn protects_dyn_object_names_from_vtable_collisions() -> unit {
    let source = "trait A { fn f(self: Self) -> int32; } trait A_vtable { fn g(self: Self) -> int32; } struct S {} impl A for S { fn f(self: S) -> int32 { 3 } } impl A_vtable for S { fn g(self: S) -> int32 { 4 } } fn main() -> unit { let left: dyn A = S {}; let right: dyn A_vtable = S {}; println(A::f(left) + A_vtable::g(right)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype S struct {}\n\ntype dyn__A_vtable struct {\n    f func(any) int32\n}\n\ntype dyn__A struct {\n    data any\n    vtable *dyn__A_vtable\n}\n\ntype dyn__A_vtable_vtable struct {\n    g func(any) int32\n}\n\ntype _goml_dyn_object_A_vtable struct {\n    data any\n    vtable *dyn__A_vtable_vtable\n}\n\nfunc dyn__A__wrap__S__f(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_S_i_f(self.(S))\n}\n\nfunc dyn__A__vtable__S() *dyn__A_vtable {\n    return &dyn__A_vtable{\n        f: dyn__A__wrap__S__f,\n    }\n}\n\nfunc dyn__A_vtable__wrap__S__g(self any) int32 {\n    return _goml_m_trait__impl_i_A__vtable_i_S_i_g(self.(S))\n}\n\nfunc dyn__A_vtable__vtable__S() *dyn__A_vtable_vtable {\n    return &dyn__A_vtable_vtable{\n        g: dyn__A_vtable__wrap__S__g,\n    }\n}\n\nfunc _goml_m_trait__impl_i_A_i_S_i_f(self__0 S) int32 {\n    var retv2 int32\n    retv2 = 3\n    return retv2\n}\n\nfunc _goml_m_trait__impl_i_A__vtable_i_S_i_g(self__1 S) int32 {\n    var retv4 int32\n    retv4 = 4\n    return retv4\n}\n\nfunc main0() struct{} {\n    var t6 S = S{}\n    var left__2 dyn__A = dyn__A{\n        data: t6,\n        vtable: dyn__A__vtable__S(),\n    }\n    var t7 S = S{}\n    var right__3 _goml_dyn_object_A_vtable = _goml_dyn_object_A_vtable{\n        data: t7,\n        vtable: dyn__A_vtable__vtable__S(),\n    }\n    var t8 int32 = left__2.vtable.f(left__2.data)\n    var t9 int32 = right__3.vtable.g(right__3.data)\n    var t10 int32 = t8 + t9\n    _goml_m_println(t10)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_pointer_equality_helpers() -> unit {
    let source = "fn main() -> unit { let a: Ref[int32] = Ref::new(1); let b = a; let c = Ref::new(1); println(ptr_eq(a, b)); println(ptr_eq(a, c)); }";
