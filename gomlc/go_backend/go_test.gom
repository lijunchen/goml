    )
}

#[test]
fn disambiguates_enum_variants_from_user_types() -> unit {
    let source = "struct E__int32_A { value: int32, } enum E[T] { A(T), B, } fn main() -> unit { let c = E__int32_A { value: 3 }; let _: E[string] = E::A(\"x\"); let y: E[int32] = E::A(4); match y { E::A(v) => println(v + c.value), E::B => println(0), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype E__int32_A struct {\n    value int32\n}\n\ntype E__string interface {\n    isE__string()\n}\n\ntype E__string_A struct {\n    _0 string\n}\n\nfunc (_ E__string_A) isE__string() {}\n\ntype E__string_B struct {}\n\nfunc (_ E__string_B) isE__string() {}\n\ntype E__int32 interface {\n    isE__int32()\n}\n\ntype E__int32_A__variant1 struct {\n    _0 int32\n}\n\nfunc (_ E__int32_A__variant1) isE__int32() {}\n\ntype E__int32_B struct {}\n\nfunc (_ E__int32_B) isE__int32() {}\n\nfunc main0() struct{} {\n    var x1 int32 = 4\n    var t4 int32 = 3\n    var t5 int32 = x1 + t4\n    _goml_m_println(t5)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn deduplicates_shadowed_enum_variant_owners() -> unit {
    let source = "enum Option[T] { Some(T), None, } fn main() -> unit { let x: Option[uint8] = Option::Some(42); match x { Option::Some(v) => println(v.to_string()), Option::None => println(\"none\"), }; }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Option__uint8 interface {\n    isOption__uint8()\n}\n\ntype Some struct {\n    _0 uint8\n}\n\nfunc (_ Some) isOption__uint8() {}\n\ntype None struct {}\n\nfunc (_ None) isOption__uint8() {}\n\nfunc main0() struct{} {\n    var x0 uint8 = 42\n    var t4 string = _goml_m_trait__impl_i_ToString_i_uint8_i_to__string(x0)\n    _goml_m_println(t4)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn materializes_numeric_runtime_operands() -> unit {
    let source = "fn main() -> unit { let a: uint8 = 13 % 5; let b: uint8 = 1 << 7; let c: uint8 = ~0; let d: uint8 = 511.to_uint8(); println(a); println(b); println(c); println(d); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc main0() struct{} {\n    var a__0_lhs uint8 = 13\n    var a__0_rhs uint8 = 5\n    var a__0 uint8 = a__0_lhs % a__0_rhs\n    var b__1_lhs uint8 = 1\n    var b__1_rhs int = 7\n    var b__1 uint8 = b__1_lhs << b__1_rhs\n    var c__2_operand uint8 = 0\n    var c__2 uint8 = ^c__2_operand\n    var d__3_source int = 511\n    var d__3 uint8 = uint8(int(d__3_source))\n    _goml_m_println(a__0)\n    _goml_m_println(b__1)\n    _goml_m_println(c__2)\n    _goml_m_println(d__3)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn lowers_uint_and_runtime_traits() -> unit {
    let output = encode(
        lower_linked_source(
            "fn main() -> unit { let value: uint = 40 + 2; println(value.to_string()); let values: HashMap[uint, string] = HashMap::new(); values.set(value, \"stored\"); match values.get(42) { Option::Some(item) => println(item), Option::None => println(\"missing\"), }; }",
        ),
    );
    testing::assert(string_contains(output, "var value__0 uint"));
    testing::assert(string_contains(output, "core_uint_to_string"));
    testing::assert(string_contains(output, "key uint"))
}

#[test]
fn emits_rounded_float32_literals() -> unit {
    let source = "fn identity[T](x: T) -> T { x } fn main() -> unit { let value: float32 = identity(3.14); println(value.to_string()) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "3.140000104904175"))
}

#[test]
fn canonicalizes_float64_literals() -> unit {
    let source = "fn main() -> unit { let value: float64 = 0.0; println(value.to_string()) }";
    testing::assert(string_contains(encode(lower_source(source)), "var value__0 float64 = 0\n"))
}

#[test]
fn disambiguates_dyn_helper_names() -> unit {
    let source = "trait A { fn foo(self: Self) -> int32; fn b__foo(self: Self) -> int32; } struct C {} struct C__B {} impl A for C { fn foo(self: C) -> int32 { 1 } fn b__foo(self: C) -> int32 { 2 } } impl A for C__B { fn foo(self: C__B) -> int32 { 10 } fn b__foo(self: C__B) -> int32 { 20 } } fn main() -> unit { let left: dyn A = (C {}) as dyn A; let right: dyn A = (C__B {}) as dyn A; println(A::b__foo(left)); println(A::foo(right)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype C struct {}\n\ntype C__B struct {}\n\ntype dyn__A_vtable struct {\n    foo func(any) int32\n    b__foo func(any) int32\n}\n\ntype dyn__A struct {\n    data any\n    vtable *dyn__A_vtable\n}\n\nfunc dyn__A__wrap__C__foo(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C_i_foo(self.(C))\n}\n\nfunc dyn__A__wrap__C__b__foo(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C_i_b____foo(self.(C))\n}\n\nfunc dyn__A__vtable__C() *dyn__A_vtable {\n    return &dyn__A_vtable{\n        foo: dyn__A__wrap__C__foo,\n        b__foo: dyn__A__wrap__C__b__foo,\n    }\n}\n\nfunc dyn__A__wrap__C__B__foo(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C____B_i_foo(self.(C__B))\n}\n\nfunc dyn__A__wrap__C__B__b__foo(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C____B_i_b____foo(self.(C__B))\n}\n\nfunc dyn__A__vtable__C__B() *dyn__A_vtable {\n    return &dyn__A_vtable{\n        foo: dyn__A__wrap__C__B__foo,\n        b__foo: dyn__A__wrap__C__B__b__foo,\n    }\n}\n\nfunc _goml_m_trait__impl_i_A_i_C_i_foo(self__0 C) int32 {\n    return 1\n}\n\nfunc _goml_m_trait__impl_i_A_i_C_i_b____foo(self__1 C) int32 {\n    return 2\n}\n\nfunc _goml_m_trait__impl_i_A_i_C____B_i_foo(self__2 C__B) int32 {\n    return 10\n}\n\nfunc _goml_m_trait__impl_i_A_i_C____B_i_b____foo(self__3 C__B) int32 {\n    return 20\n}\n\nfunc main0() struct{} {\n    var t11 C = C{}\n    var left__4 dyn__A = dyn__A{\n        data: t11,\n        vtable: dyn__A__vtable__C(),\n    }\n    var t12 C__B = C__B{}\n    var right__5 dyn__A = dyn__A{\n        data: t12,\n        vtable: dyn__A__vtable__C__B(),\n    }\n    var t13 int32 = left__4.vtable.b__foo(left__4.data)\n    _goml_m_println(t13)\n    var t14 int32 = right__5.vtable.foo(right__5.data)\n    _goml_m_println(t14)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_blank_assignment_for_discarded_non_call_side_effects() -> unit {
    let source = "struct S {} impl ToString for S { fn to_string(self: S) -> string { \"S\" } } fn main() -> unit { let value = S {}; let dynamic: dyn ToString = value as dyn ToString; let _ = dynamic; }";
    testing::assert(string_contains(encode(lower_source(source)), "_ = dyn__ToString{"))
}

#[test]
fn protects_index_intrinsics_from_user_functions() -> unit {
    let source = "fn array_get(arr: [int32; 2], index: int32) -> int32 { 90 + index } fn array_set(arr: [int32; 2], index: int32, value: int32) -> [int32; 2] { [77, 88] } fn vec_get(v: Vec[int32], index: int32) -> int32 { 70 + index } fn vec_set(v: Vec[int32], index: int32, value: int32) -> unit { () } fn slice_get(s: Slice[int32], index: int32) -> int32 { 60 + index } fn hashmap_get(m: HashMap[string, int32], key: string) -> Option[int32] { Option::Some(55) } fn hashmap_set(m: HashMap[string, int32], key: string, value: int32) -> unit { () } fn main() -> unit { let a = [4, 5]; println(array_get(a, 1)); println(a[1]); let c: [int32; 2] = array_set(a, 0, 9); println(c[0]); let mut b = [1, 2]; b[0] = 9; println(array_get(b, 0)); println(b[0]); let v: Vec[int32] = Vec::new().pushed(8).pushed(9); println(vec_get(v, 1)); println(v[1]); let mut v2: Vec[int32] = Vec::new().pushed(1).pushed(2); vec_set(v2, 0, 99); println(v2[0]); v2[1] = 99; println(v2[1]); let s = v.slice(0, 2); println(slice_get(s, 1)); println(s[1]); let text = \"ab\"; println(string_get(text, 0)); println(text[1]); let m: HashMap[string, int32] = HashMap::new(); hashmap_set(m, \"b\", 11); match m[\"b\"] { Option::Some(x) => println(x), Option::None => println(0), }; m[\"a\"] = 42; match hashmap_get(m, \"a\") { Option::Some(x) => println(x), Option::None => println(0), }; match m[\"a\"] { Option::Some(x) => println(x), Option::None => println(0), }; } fn string_get(s: string, index: int32) -> char { 'x' }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func array_get__Array_2_5int32("));
    testing::assert(string_contains(output, "func array_set__Array_2_5int32("));
    testing::assert(string_contains(output, "func vec_get__Vec_5int32("));
    testing::assert(string_contains(output, "func vec_set__Vec_5int32("));
    testing::assert(string_contains(output, "func hashmap_lookup__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func hashmap_get__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func hashmap_set__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "var inline115 int32 = 90 + inline114"));
    testing::assert(string_contains(output, "var inline105 int32 = 70 + inline104"));
    testing::assert(string_contains(output, "t75 = 120"));
    testing::assert(string_contains(output, "var inline91 Option__int32 = Some"));
    testing::assert(string_contains(output, "array_get__Array_2_5int32(a__17, 1)"));
    testing::assert(string_contains(output, "s__22[1]"));
    testing::assert(string_contains(output, "_goml_runtime_core_string_get("));
    testing::assert(string_contains(output, "hashmap_get__HashMap_6string_5int32(m__"));
    testing::assert(!string_contains(output, "_goml_m_array_t_get"));
    testing::assert(!string_contains(output, "_goml_m_vec_t_get"));
    testing::assert(!string_contains(output, "_goml_m_hashmap_t_get"))
}

#[test]
fn emits_unused_non_generic_enums() -> unit {
    testing::assert_eq(
        encode(lower_source("enum Status { Idle, Busy(int32), }")),
        "package main\n\ntype Status interface {\n    isStatus()\n}\n\ntype Idle struct {}\n\nfunc (_ Idle) isStatus() {}\n\ntype Busy struct {\n    _0 int32\n}\n\nfunc (_ Busy) isStatus() {}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn orders_runtime_types_before_tuples() -> unit {
    let source = "fn make_counter() -> (() -> int32, () -> unit) { let cell = Ref::new(0); let next = || cell.get(); let reset = || cell.set(0); (next, reset) } fn main() -> unit { let _ = make_counter(); }";
    testing::assert(
        string_contains(
            encode(lower_source(source)),
            "type ref_int32_x struct {\n    value int32\n}\n\ntype Tuple2_17TFunc0_ret_5int32_16TFunc0_ret_4unit struct",
        ),
    )
}

#[test]
fn lowers_callable_intrinsics() -> unit {
    let source = "fn main() -> unit { let to_text: (int32) -> string = int32_to_string; println(to_text(7)); let get: (Vec[int32], int) -> int32 = vec_get; let push: (Vec[int32], int32) -> unit = vec_push; let values: Vec[int32] = Vec::new(); push(values, 11); push(values, 22); println(get(values, 1)); let make_slice: (Vec[int32], int, int) -> Slice[int32] = slice; let slice_get_value: (Slice[int32], int) -> int32 = slice_get; let view = make_slice(values, 0, 2); println(slice_get_value(view, 0)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nimport (\n    _goml_fmt \"fmt\"\n)\n\nfunc _goml_runtime_core_int32_to_string(x int32) string {\n    return _goml_fmt.Sprintf(\"%d\", x)\n}\n\ntype _goml_vec_int32 struct {\n    items []int32\n}\n\nfunc vec_push__Vec_5int32(vec *_goml_vec_int32, elem int32) struct{} {\n    vec.items = append(vec.items, elem)\n    return struct{}{}\n}\n\nfunc vec_get__Vec_5int32(vec *_goml_vec_int32, index int) int32 {\n    return vec.items[index]\n}\n\nfunc main0() struct{} {\n    var to_text__0 func(int32) string = _goml_runtime_core_int32_to_string\n    var t6 string = to_text__0(7)\n    _goml_m_println(t6)\n    var get__1 func(*_goml_vec_int32, int) int32 = vec_get__Vec_5int32\n    var push__2 func(*_goml_vec_int32, int32) struct{} = vec_push__Vec_5int32\n    var values__3 *_goml_vec_int32 = _goml_m_inherent_i_Vec_i_Vec_l_int32_r__i_new()\n    push__2(values__3, 11)\n    push__2(values__3, 22)\n    var t7 int32 = get__1(values__3, 1)\n    _goml_m_println(t7)\n    var make_slice__4 func(*_goml_vec_int32, int, int) []int32 = func(p0 *_goml_vec_int32, p1 int, p2 int) []int32 {\n        return p0.items[p1:p2]\n    }\n    var slice_get_value__5 func([]int32, int) int32 = func(p0 []int32, p1 int) int32 {\n        return p0[p1]\n    }\n    var view__6 []int32 = make_slice__4(values__3, 0, 2)\n    var t8 int32 = slice_get_value__5(view__6, 0)\n    _goml_m_println(t8)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn hoists_continuations_through_nested_matches() -> unit {
    let source = "enum T { A, B(bool, bool), } fn test(t: T) -> unit { match t { A => println((1).to_string()), B(false, false) => println((2).to_string()), B(false, true) => println((3).to_string()), _ => println((4).to_string()), } } fn main() { let _ = test(B(true, true)); let _ = test(B(false, true)); let _ = test(B(false, false)); let _ = test(A); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype T interface {\n    isT()\n}\n\ntype A struct {}\n\nfunc (_ A) isT() {}\n\ntype B struct {\n    _0 bool\n    _1 bool\n}\n\nfunc (_ B) isT() {}\n\nfunc test(t__0 T) struct{} {\n    switch t__0.(type) {\n    case A:\n        var t8 string = _goml_m_inherent_i_int_i_int_i_to__string(1)\n        _goml_m_println(t8)\n        return struct{}{}\n    case B:\n        var x0 bool = t__0.(B)._0\n        var x1 bool = t__0.(B)._1\n        switch x1 {\n        case true:\n            switch x0 {\n            case true:\n                var t12 string = _goml_m_inherent_i_int_i_int_i_to__string(4)\n                _goml_m_println(t12)\n                return struct{}{}\n            case false:\n                var t14 string = _goml_m_inherent_i_int_i_int_i_to__string(3)\n                _goml_m_println(t14)\n                return struct{}{}\n            default:\n                panic(\"non-exhaustive match\")\n            }\n        case false:\n            switch x0 {\n            case true:\n                var t17 string = _goml_m_inherent_i_int_i_int_i_to__string(4)\n                _goml_m_println(t17)\n                return struct{}{}\n            case false:\n                var t19 string = _goml_m_inherent_i_int_i_int_i_to__string(2)\n                _goml_m_println(t19)\n                return struct{}{}\n            default:\n                panic(\"non-exhaustive match\")\n            }\n        default:\n            panic(\"non-exhaustive match\")\n        }\n    default:\n        panic(\"non-exhaustive match\")\n    }\n}\n\nfunc main0() struct{} {\n    var t22 T = B{\n        _0: true,\n        _1: true,\n    }\n    test(t22)\n    var t23 T = B{\n        _0: false,\n        _1: true,\n    }\n    test(t23)\n    var t24 T = B{\n        _0: false,\n        _1: false,\n    }\n    test(t24)\n    test(A{})\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn keeps_mixed_match_continuations_in_branches() -> unit {
    let source = "enum Choice { Early, Keep(int32), } fn choose(choice: Choice) -> int32 { let value = match choice { Choice::Early => return 1, Choice::Keep(value) => value, }; value + 1 } fn main() -> unit { println(choose(Choice::Keep(2))); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Choice interface {\n    isChoice()\n}\n\ntype Early struct {}\n\nfunc (_ Early) isChoice() {}\n\ntype Keep struct {\n    _0 int32\n}\n\nfunc (_ Keep) isChoice() {}\n\nfunc main0() struct{} {\n    var t9 int32\n    var inline12 int32\n    var inline15 int32 = 2\n    inline12 = inline15\n    var inline14 int32 = inline12 + 1\n    t9 = inline14\n    _goml_m_println(t9)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_string_hooks_and_vec_new_helpers() -> unit {
    let source = "fn main() -> unit { let values: Vec[int32] = vec_new(); string_print(values.len().to_string()); string_println(\"!\"); let bytes: Vec[uint8] = Vec::new(); let (_, text) = string_from_utf8(bytes); string_print(text); let parts: Vec[string] = Vec::new(); string_println(string_concat(parts)); }";
    let output = encode(lower_linked_source(source));
    testing::assert(
        string_contains(output, "import (\n    _goml_fmt \"fmt\"\n    _goml_strings \"strings\"\n)"),
    );
    testing::assert(string_contains(output, "func _goml_runtime_core_string_from_utf8("));
    testing::assert(string_contains(output, "func _goml_runtime_core_string_concat("));
    testing::assert(string_contains(output, "func _goml_runtime_core_string_print("));
    testing::assert(string_contains(output, "func _goml_runtime_core_string_println("));
    testing::assert(string_contains(output, "func vec_new__Vec_5int32()"))
}
