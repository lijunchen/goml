#[test]
fn dispatches_dyn_hashmap_keys_through_vtables() -> unit {
    let source = "impl Eq for dyn Hash { fn eq(self: dyn Hash, other: dyn Hash) -> bool { Hash::hash(self) == Hash::hash(other) } } fn main() -> unit { let values: HashMap[dyn Hash, string] = HashMap::new(); let key: dyn Hash = 1; values.set(key, \"one\"); println(values.contains(key).to_string()); }";
    let output = encode(lower_linked_source(source));
    testing::assert_eq(string_contains(output, "key.vtable.hash(key.data)"), true);
    testing::assert_eq(
        string_contains(output, "_goml_m_trait__impl_i_Hash_i_dynHash_i_hash"),
        false,
    )
}

