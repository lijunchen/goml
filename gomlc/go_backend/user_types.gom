package go_backend;

use gomlc::repr;
use std::collections;
use std::text;

fn find_enum(values: Vec[repr::EnumDef], name: string) -> Option[repr::EnumDef] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn find_struct(values: Vec[repr::StructDef], name: string) -> Option[repr::StructDef] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn instance_by_name(values: Vec[repr::TypeInstance], name: string) -> Option[repr::TypeInstance] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn find_instance(values: Vec[repr::TypeInstance], base_name: string, args: Vec[repr::Type]) -> Option[
    repr::TypeInstance,
] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.base_name == base_name && type_lists_match(value.args, args) {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn type_lists_match(left: Vec[repr::Type], right: Vec[repr::Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if !repr::types_equal(left[index], right[index]) {
                return false
            } else {}
        }
        true
    }
}

fn builtin_struct_instance(value: repr::TypeInstance, instances: Vec[repr::TypeInstance]) -> Option[
    StructDef,
] {
    if value.base_name == "FnIterator" && value.args.len() == 1 {
        let result_ty = match find_instance(instances, "Option", value.args) {
            Some(instance) => Type::Named { name: go_user_type_name(instance.name) },
            None => {
                Type::Named { name: go_user_type_name("Option__" + compact_type(value.args[0])) }
            },
        };
        let fields: Vec[(string, Type)] = Vec::[];
        fields.push(("next_fn", Type::Func { params: Vec::[], ret_ty: result_ty }));
        Option::Some(StructDef { name: go_user_type_name(value.name), fields })
    } else if value.base_name == "OnceCell" && value.args.len() == 1 {
        let fields: Vec[(string, Type)] = Vec::[];
        fields.push(("mutex", Type::Named { name: "_goml_sync.Mutex" }));
        fields.push(("cond", Type::Pointer { elem: Type::Named { name: "_goml_sync.Cond" } }));
        fields.push(("state", Type::Int));
        fields.push(("owner", Type::Uint64));
        fields.push(("value", lower_type(value.args[0])));
        fields.push(("name", Type::String));
        Option::Some(StructDef { name: go_user_type_name(value.name), fields })
    } else if value.base_name == "FrozenVec" && value.args.len() == 1 {
        let fields: Vec[(string, Type)] = Vec::[];
        fields.push(("values", lower_type(repr::Type::VecType { elem: value.args[0] })));
        Option::Some(StructDef { name: go_user_type_name(value.name), fields })
    } else {
        Option::None
    }
}

fn enum_marker_name(go_name: string) -> string {
    go_generated_ident("is" + go_name)
}

fn qualified_variant_go_name(owner_name: string, variant_name: string) -> string {
    go_generated_ident(go_user_type_name(owner_name) + "_" + go_ident(variant_name))
}

fn enum_has_variant(value: repr::EnumDef, variant_name: string) -> bool {
    for variant in value.variants {
        if variant.name == variant_name {
            return true
        } else {}
    }
    false
}

fn variant_definition_count(enums: Vec[repr::EnumDef], variant_name: string) -> int {
    let result = Ref::new(0);
    for definition in enums {
        if enum_has_variant(definition, variant_name) {
            result.set(result.get() + 1)
        } else {}
    }
    result.get()
}

fn concrete_variant_go_name(
    owner_name: string,
    variant_name: string,
    enums: Vec[repr::EnumDef],
    function_names: FunctionNames,
) -> string {
    let key = owner_name.byte_len().to_string() + ":" + owner_name + variant_name;
    match function_names.variant_names[key] {
        Some(name) => name,
        None => {
            let candidate = if variant_definition_count(enums, variant_name) > 1 {
                qualified_variant_go_name(owner_name, variant_name)
            } else {
                go_ident(variant_name)
            };
            let name = unique_variant_go_name(candidate, function_names);
            function_names.variant_names[key] = name;
            name
        },
    }
}

fn variant_go_name(
    owner_name: string,
    variant_name: string,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> string {
    let _ = structs;
    let _ = instances;
    concrete_variant_go_name(owner_name, variant_name, enums, function_names)
}

fn variant_name_reserved(candidate: string, function_names: FunctionNames) -> bool {
    candidate == "main" || candidate == "init" || is_generated_tuple_type_name(candidate)
        || function_names.reserved.contains(candidate)
}

fn unique_variant_go_name(candidate: string, function_names: FunctionNames) -> string {
    if !variant_name_reserved(candidate, function_names) {
        candidate
    } else {
        let base = if is_generated_tuple_type_name(candidate) {
            go_generated_ident("_goml_user_" + candidate)
        } else {
            candidate
        };
        if !variant_name_reserved(base, function_names) {
            base
        } else {
            let mut index = 1;
            let mut result = go_generated_ident(base + "__variant" + index.to_string());
            while variant_name_reserved(result, function_names) {
                index = index + 1;
                result = go_generated_ident(base + "__variant" + index.to_string());
            }
            result
        }
    }
}

fn tag_only_variant_fields(values: Vec[Vec[repr::Type]]) -> bool {
    for fields in values {
        if !fields.is_empty() {
            return false
        } else {}
    }
    true
}

fn new_variant_infos() -> VariantInfos {
    VariantInfos { by_owner: HashMap::{} }
}

fn add_variant_info(variants: VariantInfos, value: VariantInfo) -> unit {
    match variants.by_owner[value.owner_name] {
        Some(owner_variants) => owner_variants.push(value),
        None => {
            let owner_variants: Vec[VariantInfo] = Vec::[];
            owner_variants.push(value);
            variants.by_owner[value.owner_name] = owner_variants;
        },
    }
}

fn enum_field_types(value: repr::EnumVariantFields) -> Vec[repr::Type] {
    match value {
        Unit => Vec::[],
        Tuple(values) => values,
        Struct(values) => {
            let result: Vec[repr::Type] = Vec::with_capacity(values.len());
            for value in values {
                result.push(value.1)
            }
            result
        },
    }
}

fn tag_only_const_specs(
    variants: VariantInfos,
    definition: repr::EnumDef,
    fields_by_variant: Vec[Vec[repr::Type]],
    enums: Vec[repr::EnumDef],
    function_names: FunctionNames,
) -> Vec[ConstSpec] {
    let specs: Vec[ConstSpec] = Vec::[];
    let owner_go_name = go_user_type_name(definition.name);
    for index in 0..definition.variants.len() {
        let variant = definition.variants[index];
        let variant_name = concrete_variant_go_name(
            definition.name,
            variant.name,
            enums,
            function_names,
        );
        specs.push(
            ConstSpec {
                name: variant_name,
                ty: Type::Named { name: owner_go_name },
                value: Expr::Int { value: index.to_string() },
            },
        );
        add_variant_info(
            variants,
            VariantInfo {
                owner_name: definition.name,
                tag: index,
                variant_name,
                field_types: fields_by_variant[index],
                tag_only: true,
            },
        )
    }
    specs
}

fn emit_enum_definition(
    items: Vec[Item],
    variants: VariantInfos,
    definition: repr::EnumDef,
    enums: Vec[repr::EnumDef],
    function_names: FunctionNames,
) -> unit {
    let fields_by_variant: Vec[Vec[repr::Type]] = Vec::with_capacity(definition.variants.len());
    for variant in definition.variants {
        fields_by_variant.push(enum_field_types(variant.fields))
    }
    let owner_go_name = go_user_type_name(definition.name);
    if tag_only_variant_fields(fields_by_variant) {
        items.push(Item::TypeDef(TypeDef { name: owner_go_name, ty: Type::Int32 }));
        items.push(
            Item::ConstGroup(
                ConstGroup {
                    specs: tag_only_const_specs(
                        variants,
                        definition,
                        fields_by_variant,
                        enums,
                        function_names,
                    ),
                },
            ),
        )
    } else {
        let marker = enum_marker_name(owner_go_name);
        let methods: Vec[InterfaceMethod] = Vec::[];
        methods.push(InterfaceMethod { name: marker, params: Vec::[], ret_ty: Option::None });
        items.push(Item::Interface(InterfaceDef { name: owner_go_name, methods }));
        for index in 0..definition.variants.len() {
            let variant = definition.variants[index];
            let field_types = fields_by_variant[index];
            let fields: Vec[(string, Type)] = Vec::with_capacity(field_types.len());
            for field_index in 0..field_types.len() {
                fields.push(("_" + field_index.to_string(), lower_type(field_types[field_index])))
            }
            let variant_name = concrete_variant_go_name(
                definition.name,
                variant.name,
                enums,
                function_names,
            );
            items.push(Item::Struct(StructDef { name: variant_name, fields }));
            items.push(
                Item::Method(
                    Method {
                        receiver: ("_", Type::Named { name: variant_name }),
                        name: marker,
                        params: Vec::[],
                        ret_ty: Option::None,
                        body: Block { stmts: Vec::[] },
                    },
                ),
            );
            add_variant_info(
                variants,
                VariantInfo {
                    owner_name: definition.name,
                    tag: index,
                    variant_name,
                    field_types,
                    tag_only: false,
                },
            )
        }
    }
}

pub fn emit_user_type_items(
    items: Vec[Item],
    variants: VariantInfos,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> unit {
    let emitted: Vec[string] = Vec::[];
    for definition in structs {
        let instance = instance_by_name(instances, definition.name);
        let custom = match instance {
            Some(value) => value.base_name == "OnceCell" || value.base_name == "FrozenVec",
            None => false,
        };
        if collections::contains(emitted, definition.name) || custom {} else {
            let fields: Vec[(string, Type)] = Vec::with_capacity(definition.fields.len());
            for field in definition.fields {
                fields.push((go_ident(field.0), lower_type(field.1)))
            }
            items.push(Item::Struct(StructDef { name: go_user_type_name(definition.name), fields }));
            emitted.push(definition.name)
        }
    }
    for instance in instances {
        if collections::contains(emitted, instance.name) {} else {
            match builtin_struct_instance(instance, instances) {
                Some(definition) => {
                    items.push(Item::Struct(definition));
                    emitted.push(instance.name)
                },
                None => (),
            }
        }
    }
    for definition in enums {
        emit_enum_definition(items, variants, definition, enums, function_names)
    }
}

pub fn variant_type(variants: VariantInfos, owner_ty: repr::Type, tag: int) -> Option[Type] {
    match find_variant_info(variants, owner_ty, tag) {
        Some(value) => if value.tag_only {
            Option::None
        } else {
            Option::Some(Type::Named { name: value.variant_name })
        },
        None => Option::None,
    }
}

pub fn find_variant_info(variants: VariantInfos, owner_ty: repr::Type, tag: int) -> Option[
    VariantInfo,
] {
    match repr::resolve_type(owner_ty) {
        Named { name: owner_name } => match variants.by_owner[owner_name] {
            Some(owner_variants) => if tag >= 0 && tag < owner_variants.len() {
                Option::Some(owner_variants[tag])
            } else {
                Option::None
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn last_separator(value: string) -> int {
    let mut result = -1;
    if value.byte_len() > 1 {
        for index in 0..value.byte_len() - 1 {
            if text::starts_with_at(value, index, "::") {
                result = index;
            } else {}
        }
    } else {};
    result
}

pub fn constructor_type(value: repr::Constructor) -> Type {
    let separator = last_separator(value.name);
    if value.is_struct || separator < 0 {
        Type::Named { name: go_user_type_name(value.name) }
    } else {
        Type::Named {
            name: qualified_variant_go_name(
                value.name.byte_slice(0, separator),
                value.name.byte_slice(separator + 2, value.name.byte_len()),
            ),
        }
    }
}
