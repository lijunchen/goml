package go_backend;

use module::repr;
use module::tast;
use std::collections;
use std::text;

fn find_enum(values: Vec[repr::EnumDef], name: string) -> Option[repr::EnumDef] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn find_struct(values: Vec[repr::StructDef], name: string) -> Option[repr::StructDef] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn instance_by_name(values: Vec[repr::TypeInstance], name: string) -> Option[repr::TypeInstance] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn find_instance(values: Vec[repr::TypeInstance], base_name: string, args: Vec[repr::Type]) -> Option[
    repr::TypeInstance,
] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.base_name == base_name && type_lists_match(value.args, args) {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn type_lists_match(left: Vec[repr::Type], right: Vec[repr::Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if !repr::types_equal(left[index], right[index]) {
                return false
            }
        }
        true
    }
}

fn builtin_struct_instance(
    builtin: tast::BuiltinContract,
    value: repr::TypeInstance,
    instances: Vec[repr::TypeInstance],
) -> Option[StructDef] {
    if backend_names_match(value.base_name, builtin.fn_iterator.name) && value.args.len() == 1 {
        let result_ty = match find_instance(instances, builtin.option.name, value.args) {
            Some(instance) => Type::Named { name: go_user_type_name(instance.name) },
            None => {
                Type::Named {
                    name: go_user_type_name(
                        builtin.option.name + "__" + compact_type(value.args[0]),
                    ),
                }
            },
        };
        let fields: Vec[(string, Type)] = Vec::new();
        fields.push(("next_fn", Type::Func { params: Vec::new(), ret_ty: result_ty }));
        Option::Some(StructDef { name: go_user_type_name(value.name), fields })
    } else if backend_names_match(value.base_name, builtin.static_cell.name)
        && value.args.len() == 1 {
        let fields: Vec[(string, Type)] = Vec::new();
        fields.push(("mutex", Type::Named { name: "_goml_sync.Mutex" }));
        fields.push(("cond", Type::Pointer { elem: Type::Named { name: "_goml_sync.Cond" } }));
        fields.push(("state", Type::Int));
        fields.push(("owner", Type::Uint64));
        fields.push(("value", lower_type(value.args[0])));
        fields.push(("name", Type::String));
        Option::Some(StructDef { name: go_user_type_name(value.name), fields })
    } else if backend_names_match(value.base_name, builtin.frozen_vec.name) && value.args.len() == 1 {
        let fields: Vec[(string, Type)] = Vec::new();
        fields.push(("values", lower_type(repr::Type::VecType { elem: value.args[0] })));
        Option::Some(StructDef { name: go_user_type_name(value.name), fields })
    } else {
        Option::None
    }
}

fn enum_marker_name(go_name: string) -> string {
    go_generated_ident("is" + go_name)
}

fn qualified_variant_go_name(owner_name: string, variant_name: string) -> string {
    go_generated_ident(go_user_type_name(owner_name) + "_" + go_ident(variant_name))
}

fn enum_has_variant(value: repr::EnumDef, variant_name: string) -> bool {
    for variant in value.variants {
        if variant.name == variant_name {
            return true
        }
    }
    false
}

fn variant_definition_count(enums: Vec[repr::EnumDef], variant_name: string) -> isize {
    let result = Ref::new(0);
    for definition in enums {
        if enum_has_variant(definition, variant_name) {
            result.set(result.get() + 1)
        }
    }
    result.get()
}

fn concrete_variant_go_name(
    owner_name: string,
    variant_name: string,
    enums: Vec[repr::EnumDef],
    function_names: FunctionNames,
) -> string {
    let key = owner_name.byte_len().to_string() + ":" + owner_name + variant_name;
    match function_names.variant_names[key] {
        Some(name) => name,
        None => {
            let candidate = if variant_definition_count(enums, variant_name) > 1 {
                qualified_variant_go_name(owner_name, variant_name)
            } else {
                go_ident(variant_name)
            };
            let name = unique_variant_go_name(candidate, function_names);
            function_names.variant_names[key] = name;
            name
        },
    }
}

fn variant_go_name(
    owner_name: string,
    variant_name: string,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> string {
    let _ = structs;
    let _ = instances;
    concrete_variant_go_name(owner_name, variant_name, enums, function_names)
}

fn variant_name_reserved(candidate: string, function_names: FunctionNames) -> bool {
    candidate == "main" || candidate == "init" || is_generated_tuple_type_name(candidate)
        || function_names.reserved.contains(candidate)
}

fn unique_variant_go_name(candidate: string, function_names: FunctionNames) -> string {
    if !variant_name_reserved(candidate, function_names) {
        candidate
    } else {
        let base = if is_generated_tuple_type_name(candidate) {
            go_generated_ident("_goml_user_" + candidate)
        } else {
            candidate
        };
        if !variant_name_reserved(base, function_names) {
            base
        } else {
            let mut index = 1;
            let mut result = go_generated_ident(base + "__variant" + index.to_string());
            while variant_name_reserved(result, function_names) {
                index += 1;
                result = go_generated_ident(base + "__variant" + index.to_string());
            }
            result
        }
    }
}

fn tag_only_variant_fields(values: Vec[Vec[repr::Type]]) -> bool {
    for fields in values {
        if !fields.is_empty() {
            return false
        }
    }
    true
}

fn compact_type_size(value: repr::Type, structs: Vec[repr::StructDef], depth: isize) -> isize {
    if depth >= 8 {
        -1
    } else {
        match repr::resolve_type(value) {
            Unit | Never => 0,
            Bool | Int8 | Int16 | Int32 | Uint8 | Uint16 | Uint32 | Float32 | Char => 8,
            Int | Int64 | Uint | Uint64 | Float64 => 8,
            String => 16,
            Tuple { items } => compact_type_list_size(items, structs, depth + 1),
            Named { name } | ClosureEnvironment { name } => match find_struct(structs, name) {
                Some(definition) => {
                    let fields: Vec[repr::Type] = Vec::with_capacity(definition.fields.len());
                    for field in definition.fields {
                        fields.push(field.1)
                    }
                    compact_type_list_size(fields, structs, depth + 1)
                },
                None => -1,
            },
            Dyn { .. } | Slice { elem: _ } | MutSlice { elem: _ } | Func { .. } => -1,
            Array { len, elem } => {
                let item_size = compact_type_size(elem, structs, depth + 1);
                if item_size < 0 || item_size * len > 24 {
                    -1
                } else {
                    item_size * len
                }
            },
            VecType { elem: _ } | RefType { elem: _ } | HashMap { .. } | Channel {
                elem: _,
                direction: _,
            } => 8,
        }
    }
}

fn compact_type_list_size(values: Vec[repr::Type], structs: Vec[repr::StructDef], depth: isize) -> isize {
    let mut result = 0;
    for value in values {
        let size = compact_type_size(value, structs, depth);
        if size < 0 || result + size > 24 {
            return -1
        } else {
            result += size;
        }
    }
    result
}

fn compact_variant_fields(values: Vec[Vec[repr::Type]], structs: Vec[repr::StructDef]) -> bool {
    let fields: Vec[repr::Type] = Vec::new();
    for variant in values {
        for field in variant {
            fields.push(field)
        }
    }
    compact_type_list_size(fields, structs, 0) >= 0
}

fn builtin_compact_type_size(value: repr::Type, structs: Vec[repr::StructDef], depth: isize) -> isize {
    if depth >= 8 {
        -1
    } else {
        match repr::resolve_type(value) {
            Unit | Never => 0,
            Bool | Int8 | Int16 | Int32 | Uint8 | Uint16 | Uint32 | Float32 | Char => 8,
            Int | Int64 | Uint | Uint64 | Float64 => 8,
            String => 16,
            Tuple { items } => builtin_compact_type_list_size(items, structs, depth + 1),
            Named { name } | ClosureEnvironment { name } => match find_struct(structs, name) {
                Some(definition) => {
                    let fields: Vec[repr::Type] = Vec::with_capacity(definition.fields.len());
                    for field in definition.fields {
                        fields.push(field.1)
                    }
                    builtin_compact_type_list_size(fields, structs, depth + 1)
                },
                None => 16,
            },
            Dyn { .. } | Slice { elem: _ } | MutSlice { elem: _ } => 24,
            Func { .. } => 8,
            Array { len, elem } => {
                let item_size = builtin_compact_type_size(elem, structs, depth + 1);
                if item_size < 0 || item_size * len > 48 {
                    -1
                } else {
                    item_size * len
                }
            },
            VecType { elem: _ } | RefType { elem: _ } | HashMap { .. } | Channel {
                elem: _,
                direction: _,
            } => 8,
        }
    }
}

fn builtin_compact_type_list_size(
    values: Vec[repr::Type],
    structs: Vec[repr::StructDef],
    depth: isize,
) -> isize {
    let mut result = 0;
    for value in values {
        let size = builtin_compact_type_size(value, structs, depth);
        if size < 0 || result + size > 48 {
            return -1
        } else {
            result += size;
        }
    }
    result
}

fn compact_builtin_variant_fields(values: Vec[Vec[repr::Type]], structs: Vec[repr::StructDef]) -> bool {
    let fields: Vec[repr::Type] = Vec::new();
    for variant in values {
        for field in variant {
            fields.push(field)
        }
    }
    builtin_compact_type_list_size(fields, structs, 0) >= 0
}

fn builtin_sum_enum(
    builtin: tast::BuiltinContract,
    definition: repr::EnumDef,
    instances: Vec[repr::TypeInstance],
) -> bool {
    let base_name = match instance_by_name(instances, definition.name) {
        Some(instance) => instance.base_name,
        None => definition.name,
    };
    backend_names_match(base_name, builtin.option.name)
        || backend_names_match(base_name, builtin.result.name)
}

pub fn compact_variant_field_name(tag: isize, index: isize) -> string {
    "_v" + tag.to_string() + "_" + index.to_string()
}

fn new_variant_infos() -> VariantInfos {
    VariantInfos { by_owner: HashMap::new() }
}

fn add_variant_info(variants: VariantInfos, value: VariantInfo) -> () {
    variants.by_owner.entry(value.owner_name).or_insert_with(|| Vec::new()).push(value)
}

fn enum_field_types(value: repr::EnumVariantFields) -> Vec[repr::Type] {
    match value {
        Unit => Vec::new(),
        Tuple(values) => values,
        Struct(values) => {
            let result: Vec[repr::Type] = Vec::with_capacity(values.len());
            for value in values {
                result.push(value.1)
            }
            result
        },
    }
}

fn tag_only_const_specs(
    variants: VariantInfos,
    definition: repr::EnumDef,
    fields_by_variant: Vec[Vec[repr::Type]],
    enums: Vec[repr::EnumDef],
    function_names: FunctionNames,
) -> Vec[ConstSpec] {
    let specs: Vec[ConstSpec] = Vec::new();
    let owner_go_name = go_user_type_name(definition.name);
    for index in 0..definition.variants.len() {
        let variant = definition.variants[index];
        let variant_name = concrete_variant_go_name(
            definition.name,
            variant.name,
            enums,
            function_names,
        );
        specs.push(
            ConstSpec {
                name: variant_name,
                ty: Type::Named { name: owner_go_name },
                value: Expr::Int { value: index.to_string() },
            },
        );
        add_variant_info(
            variants,
            VariantInfo {
                owner_name: definition.name,
                tag: index,
                variant_name,
                field_types: fields_by_variant[index],
                tag_only: true,
                compact: false,
            },
        )
    }
    specs
}

fn emit_enum_definition(
    builtin: tast::BuiltinContract,
    items: Vec[Item],
    variants: VariantInfos,
    definition: repr::EnumDef,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> () {
    let fields_by_variant: Vec[Vec[repr::Type]] = Vec::with_capacity(definition.variants.len());
    for variant in definition.variants {
        fields_by_variant.push(enum_field_types(variant.fields))
    }
    let owner_go_name = go_user_type_name(definition.name);
    if tag_only_variant_fields(fields_by_variant) {
        items.push(Item::TypeDef(TypeDef { name: owner_go_name, ty: Type::Int32 }));
        items.push(
            Item::ConstGroup(
                ConstGroup {
                    specs: tag_only_const_specs(
                        variants,
                        definition,
                        fields_by_variant,
                        enums,
                        function_names,
                    ),
                },
            ),
        )
    } else if compact_variant_fields(fields_by_variant, structs)
        || (builtin_sum_enum(builtin, definition, instances)
            && compact_builtin_variant_fields(fields_by_variant, structs)) {
        let fields: Vec[(string, Type)] = Vec::new();
        fields.push(("_tag", Type::Int32));
        for index in 0..definition.variants.len() {
            let field_types = fields_by_variant[index];
            for field_index in 0..field_types.len() {
                fields.push(
                    (
                        compact_variant_field_name(index, field_index),
                        lower_type(field_types[field_index]),
                    ),
                )
            }
        }
        items.push(Item::Struct(StructDef { name: owner_go_name, fields }));
        for index in 0..definition.variants.len() {
            let variant = definition.variants[index];
            add_variant_info(
                variants,
                VariantInfo {
                    owner_name: definition.name,
                    tag: index,
                    variant_name: concrete_variant_go_name(
                        definition.name,
                        variant.name,
                        enums,
                        function_names,
                    ),
                    field_types: fields_by_variant[index],
                    tag_only: false,
                    compact: true,
                },
            )
        }
    } else {
        let marker = enum_marker_name(owner_go_name);
        let methods: Vec[InterfaceMethod] = Vec::new();
        methods.push(InterfaceMethod { name: marker, params: Vec::new(), ret_ty: Option::None });
        items.push(Item::Interface(InterfaceDef { name: owner_go_name, methods }));
        for index in 0..definition.variants.len() {
            let variant = definition.variants[index];
            let field_types = fields_by_variant[index];
            let fields: Vec[(string, Type)] = Vec::with_capacity(field_types.len());
            for field_index in 0..field_types.len() {
                fields.push(("_" + field_index.to_string(), lower_type(field_types[field_index])))
            }
            let variant_name = concrete_variant_go_name(
                definition.name,
                variant.name,
                enums,
                function_names,
            );
            items.push(Item::Struct(StructDef { name: variant_name, fields }));
            items.push(
                Item::Method(
                    Method {
                        receiver: ("_", Type::Named { name: variant_name }),
                        name: marker,
                        params: Vec::new(),
                        ret_ty: Option::None,
                        body: Block { stmts: Vec::new() },
                    },
                ),
            );
            add_variant_info(
                variants,
                VariantInfo {
                    owner_name: definition.name,
                    tag: index,
                    variant_name,
                    field_types,
                    tag_only: false,
                    compact: false,
                },
            )
        }
    }
}

pub fn emit_user_type_items(
    builtin: tast::BuiltinContract,
    items: Vec[Item],
    variants: VariantInfos,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> () {
    let emitted: collections::HashSet[string] = collections::HashSet::new();
    for definition in structs {
        let instance = instance_by_name(instances, definition.name);
        let custom = match instance {
            Some(value) => backend_names_match(value.base_name, builtin.static_cell.name)
                || backend_names_match(value.base_name, builtin.frozen_vec.name),
            None => false,
        };
        if emitted.contains(definition.name) || custom {} else {
            let fields: Vec[(string, Type)] = Vec::with_capacity(definition.fields.len());
            for field in definition.fields {
                fields.push((go_ident(field.0), lower_type(field.1)))
            }
            items.push(Item::Struct(StructDef { name: go_user_type_name(definition.name), fields }));
            let _ = emitted.insert(definition.name);
        }
    }
    for instance in instances {
        if emitted.contains(instance.name) {} else {
            match builtin_struct_instance(builtin, instance, instances) {
                Some(definition) => {
                    items.push(Item::Struct(definition));
                    let _ = emitted.insert(instance.name);
                },
                None => (),
            }
        }
    }
    for definition in enums {
        emit_enum_definition(
            builtin,
            items,
            variants,
            definition,
            enums,
            structs,
            instances,
            function_names,
        )
    }
}

pub fn variant_type(variants: VariantInfos, owner_ty: repr::Type, tag: isize) -> Option[Type] {
    match find_variant_info(variants, owner_ty, tag) {
        Some(value) => if value.tag_only || value.compact {
            Option::None
        } else {
            Option::Some(Type::Named { name: value.variant_name })
        },
        None => Option::None,
    }
}

pub fn find_variant_info(variants: VariantInfos, owner_ty: repr::Type, tag: isize) -> Option[
    VariantInfo,
] {
    match repr::resolve_type(owner_ty) {
        Named { name: owner_name } => match variants.by_owner[owner_name] {
            Some(owner_variants) => if tag >= 0 && tag < owner_variants.len() {
                Option::Some(owner_variants[tag])
            } else {
                Option::None
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn last_separator(value: string) -> isize {
    let mut result = -1;
    if value.byte_len() > 1 {
        for index in 0..value.byte_len() - 1 {
            if text::starts_with_at(value, index, "::") {
                result = index;
            }
        }
    }
    result
}

pub fn constructor_type(value: repr::Constructor) -> Type {
    let separator = last_separator(value.name);
    if value.is_struct || separator < 0 {
        Type::Named { name: go_user_type_name(value.name) }
    } else {
        Type::Named {
            name: qualified_variant_go_name(
                value.name.byte_slice(0, separator),
                value.name.byte_slice(separator + 2, value.name.byte_len()),
            ),
        }
    }
}
