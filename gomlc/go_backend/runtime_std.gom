fn std_num_parse_integer_item(signed: bool) -> Item {
    let key = if signed {
        "std.num.parse_int"
    } else {
        "std.num.parse_uint"
    };
    let value_ty = if signed {
        tast::Type::Int
    } else {
        tast::Type::Uint
    };
    let native_ty = if signed {
        Type::Int64
    } else {
        Type::Uint64
    };
    let function = if signed {
        "_goml_strconv.ParseInt"
    } else {
        "_goml_strconv.ParseUint"
    };
    let params = Vec::[("value", Type::String), ("radix", Type::Int)];
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "parsed", ty: native_ty, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::["parsed", "err"],
            value: std_call(
                function,
                Vec::[
                    Expr::Var { name: "value" },
                    Expr::Var { name: "radix" },
                    Expr::Var { name: "_goml_strconv.IntSize" },
                ],
            ),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_value_string_expr(
                    value_ty,
                    false,
                    Expr::Int { value: "0" },
                    std_error_string(),
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_value_string_expr(
                    value_ty,
                    true,
                    Expr::Convert { ty: lower_type(value_ty), expr: Expr::Var { name: "parsed" } },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_value_string_type(value_ty), stmts)
}

fn std_num_parse_float_item(single: bool) -> Item {
    let key = if single {
        "std.num.parse_float32"
    } else {
        "std.num.parse_float64"
    };
    let value_ty = if single {
        tast::Type::Float32
    } else {
        tast::Type::Float64
    };
    let params = Vec::[("value", Type::String)];
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "parsed", ty: Type::Float64, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::["parsed", "err"],
            value: std_call(
                "_goml_strconv.ParseFloat",
                Vec::[
                    Expr::Var { name: "value" },
                    Expr::Int {
                        value: if single {
                            "32"
                        } else {
                            "64"
                        },
                    },
                ],
            ),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_value_string_expr(
                    value_ty,
                    false,
                    Expr::Float { value: "0" },
                    std_error_string(),
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_value_string_expr(
                    value_ty,
                    true,
                    Expr::Convert { ty: lower_type(value_ty), expr: Expr::Var { name: "parsed" } },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_value_string_type(value_ty), stmts)
}

fn std_time_monotonic_origin_name() -> string {
    go_generated_ident("_goml_runtime_std_time_monotonic_origin")
}

fn std_time_monotonic_origin_item() -> Item {
    Item::Global(
        Global {
            name: std_time_monotonic_origin_name(),
            ty: Option::None,
            value: std_call("_goml_time.Now", Vec::new()),
        },
    )
}

fn std_time_monotonic_nanoseconds_item() -> Item {
    let elapsed = std_call(
        "_goml_time.Since",
        Vec::[Expr::Var { name: std_time_monotonic_origin_name() }],
    );
    let stmts = Vec::[
        Stmt::Return { expr: Option::Some(std_method_call(elapsed, "Nanoseconds", Vec::new())) },
    ];
    std_function_item("std.time.monotonic_nanoseconds", Vec::new(), Type::Int64, stmts)
}

fn std_time_unix_nanoseconds_item() -> Item {
    let now = std_call("_goml_time.Now", Vec::new());
    let stmts = Vec::[
        Stmt::Return { expr: Option::Some(std_method_call(now, "UnixNano", Vec::new())) },
    ];
    std_function_item("std.time.unix_nanoseconds", Vec::new(), Type::Int64, stmts)
}

fn std_time_sleep_nanoseconds_item() -> Item {
    let params = Vec::[("value", Type::Int64)];
    let stmts = Vec::[
        Stmt::Expr {
            expr: std_call(
                "_goml_time.Sleep",
                Vec::[
                    Expr::Convert {
                        ty: Type::Named { name: "_goml_time.Duration" },
                        expr: Expr::Var { name: "value" },
                    },
                ],
            ),
        },
        Stmt::Return { expr: Option::Some(Expr::Unit) },
    ];
    std_function_item("std.time.sleep_nanoseconds", params, Type::Unit, stmts)
}

fn std_process_environment_type() -> tast::Type {
    tast::Type::VecType {
        elem: tast::Type::Tuple { items: Vec::[tast::Type::String, tast::Type::String] },
    }
}

fn std_process_params() -> Vec[(string, Type)] {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("program", Type::String));
    params.push(("arguments", lower_type(std_vec_type(tast::Type::String))));
    params.push(("has_directory", Type::Bool));
    params.push(("directory", Type::String));
    params.push(("environment", lower_type(std_process_environment_type())));
    params
}

fn std_process_output_params() -> Vec[(string, Type)] {
    let params = std_process_params();
    params.push(("has_input", Type::Bool));
    params.push(("input", lower_type(std_vec_type(tast::Type::Uint8))));
    params
}

fn std_process_output_timeout_params() -> Vec[(string, Type)] {
    let params = std_process_output_params();
    params.push(("timeout_ms", Type::Int));
    params
}

fn std_process_output_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::Int);
    values.push(std_vec_type(tast::Type::Uint8));
    values.push(std_vec_type(tast::Type::Uint8));
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_process_output_timeout_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::Int);
    values.push(std_vec_type(tast::Type::Uint8));
    values.push(std_vec_type(tast::Type::Uint8));
    values.push(tast::Type::String);
    values.push(tast::Type::Bool);
    std_tuple_type(values)
}

fn std_process_status_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::Int);
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_process_status_timeout_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::Int);
    values.push(tast::Type::String);
    values.push(tast::Type::Bool);
    std_tuple_type(values)
}

fn std_process_timeout_setup() -> Vec[Stmt] {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "ctx",
            ty: Type::Named { name: "_goml_context.Context" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "cancel",
            ty: Type::Named { name: "_goml_context.CancelFunc" },
            value: Option::None,
        },
    );
    let duration_args = Vec::[Expr::Var { name: "timeout_ms" }];
    let timeout = Expr::Binary {
        op: BinaryOp::Mul,
        lhs: std_call("_goml_time.Duration", duration_args),
        rhs: Expr::Var { name: "_goml_time.Millisecond" },
    };
    let timeout_args = Vec::[std_call("_goml_context.Background", Vec::new()), timeout];
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::["ctx", "cancel"],
            value: std_call("_goml_context.WithTimeout", timeout_args),
        },
    );
    stmts
}

fn std_process_command_setup(command_function: string) -> Vec[Stmt] {
    let stmts: Vec[Stmt] = Vec::new();
    let command_args: Vec[Expr] = Vec::new();
    if command_function == "_goml_exec.CommandContext" {
        command_args.push(Expr::Var { name: "ctx" })
    } else {
        ()
    };
    command_args.push(Expr::Var { name: "program" });
    command_args.push(Expr::Var { name: "arguments.items..." });
    stmts.push(
        Stmt::Var {
            name: "cmd",
            ty: Type::Pointer { elem: Type::Named { name: "_goml_exec.Cmd" } },
            value: Option::Some(std_call(command_function, command_args)),
        },
    );
    let set_directory: Vec[Stmt] = Vec::new();
    set_directory.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Dir",
            value: Expr::Var { name: "directory" },
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "has_directory" },
            then_: Block { stmts: set_directory },
            else_: Option::None,
        },
    );
    let set_environment: Vec[Stmt] = Vec::new();
    set_environment.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Env",
            value: std_call("_goml_os.Environ", Vec::new()),
        },
    );
    let append_args: Vec[Expr] = Vec::new();
    append_args.push(Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "Env" });
    append_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "_0" },
                rhs: Expr::String { value: "=" },
            },
            rhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "_1" },
        },
    );
    let range_body: Vec[Stmt] = Vec::new();
    range_body.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Env",
            value: std_call("append", append_args),
        },
    );
    set_environment.push(
        Stmt::Range {
            names: Vec::["_", "entry"],
            expr: Expr::Field { expr: Expr::Var { name: "environment" }, field_name: "items" },
            body: Block { stmts: range_body },
        },
    );
    let length_args: Vec[Expr] = Vec::new();
    length_args.push(Expr::Field { expr: Expr::Var { name: "environment" }, field_name: "items" });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Greater,
                lhs: std_call("len", length_args),
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: set_environment },
            else_: Option::None,
        },
    );
    stmts
}

fn std_process_buffer(name: string) -> Expr {
    std_vec_expr(tast::Type::Uint8, std_method_call(Expr::Var { name }, "Bytes", Vec::new()))
}

fn std_process_output_expr(valid: bool, code: Expr, error: Expr, timed: bool) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(code);
    values.push(std_process_buffer("stdout"));
    values.push(std_process_buffer("stderr"));
    values.push(error);
    if timed {
        values.push(Expr::Var { name: "timed_out" });
        std_tuple_expr(std_process_output_timeout_type(), values)
    } else {
        std_tuple_expr(std_process_output_type(), values)
    }
}

fn std_process_status_expr(valid: bool, code: Expr, error: Expr, timed: bool) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(code);
    values.push(error);
    if timed {
        values.push(Expr::Var { name: "timed_out" });
        std_tuple_expr(std_process_status_timeout_type(), values)
    } else {
        std_tuple_expr(std_process_status_type(), values)
    }
}

fn std_process_exit_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("code", Type::Int));
    let convert_args: Vec[Expr] = Vec::new();
    convert_args.push(Expr::Var { name: "code" });
    let exit_args: Vec[Expr] = Vec::new();
    exit_args.push(std_call("int", convert_args));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Expr { expr: std_call("_goml_os.Exit", exit_args) });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    std_function_item("std.process.exit", params, Type::Unit, stmts)
}

fn std_process_look_path_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("program", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "result", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::["result", "err"],
            value: std_call("_goml_exec.LookPath", Vec::[Expr::Var { name: "program" }]),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Var { name: "result" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item("std.process.look_path", params, std_bool_string_string_type(), stmts)
}

fn std_process_output_item_for(timed: bool) -> Item {
    let stmts = if timed {
        std_process_timeout_setup()
    } else {
        Vec::new()
    };
    for stmt in std_process_command_setup(
        if timed {
            "_goml_exec.CommandContext"
        } else {
            "_goml_exec.Command"
        },
    ) {
        stmts.push(stmt)
    };
    let set_input: Vec[Stmt] = Vec::new();
    let reader_args: Vec[Expr] = Vec::new();
    reader_args.push(Expr::Field { expr: Expr::Var { name: "input" }, field_name: "items" });
    set_input.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdin",
            value: std_call("_goml_bytes.NewReader", reader_args),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "has_input" },
            then_: Block { stmts: set_input },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "stdout",
            ty: Type::Named { name: "_goml_bytes.Buffer" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "stderr",
            ty: Type::Named { name: "_goml_bytes.Buffer" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdout",
            value: Expr::Unary { op: UnaryOp::Address, expr: Expr::Var { name: "stdout" } },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stderr",
            value: Expr::Unary { op: UnaryOp::Address, expr: Expr::Var { name: "stderr" } },
        },
    );
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_method_call(Expr::Var { name: "cmd" }, "Run", Vec::new())),
        },
    );
    if timed {
        stmts.push(
            Stmt::Var {
                name: "timed_out",
                ty: Type::Bool,
                value: Option::Some(
                    Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: std_method_call(Expr::Var { name: "ctx" }, "Err", Vec::new()),
                        rhs: Expr::Var { name: "_goml_context.DeadlineExceeded" },
                    },
                ),
            },
        );
        stmts.push(Stmt::Expr { expr: std_call("cancel", Vec::new()) })
    } else {
        ()
    };
    stmts.push(
        Stmt::Var { name: "code", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let failed: Vec[Stmt] = Vec::new();
    let missing_state: Vec[Stmt] = Vec::new();
    missing_state.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_output_expr(false, Expr::Int { value: "-1" }, std_error_string(), timed),
            ),
        },
    );
    failed.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
                rhs: Expr::Nil,
            },
            then_: Block { stmts: missing_state },
            else_: Option::None,
        },
    );
    let code_args: Vec[Expr] = Vec::new();
    code_args.push(
        std_method_call(
            Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
            "ExitCode",
            Vec::new(),
        ),
    );
    failed.push(Stmt::Assign { name: "code", value: std_call("int", code_args) });
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_output_expr(
                    true,
                    Expr::Var { name: "code" },
                    Expr::String { value: "" },
                    timed,
                ),
            ),
        },
    );
    std_function_item(
        if timed {
            "std.process.output_timeout"
        } else {
            "std.process.output"
        },
        if timed {
            std_process_output_timeout_params()
        } else {
            std_process_output_params()
        },
        if timed {
            std_process_output_timeout_type()
        } else {
            std_process_output_type()
        },
        stmts,
    )
}

fn std_process_output_item() -> Item {
    std_process_output_item_for(false)
}

fn std_process_output_timeout_item() -> Item {
    std_process_output_item_for(true)
}

fn std_process_status_item_for(timed: bool) -> Item {
    let stmts = if timed {
        std_process_timeout_setup()
    } else {
        Vec::new()
    };
    for stmt in std_process_command_setup(
        if timed {
            "_goml_exec.CommandContext"
        } else {
            "_goml_exec.Command"
        },
    ) {
        stmts.push(stmt)
    };
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdin",
            value: Expr::Var { name: "_goml_os.Stdin" },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdout",
            value: Expr::Var { name: "_goml_os.Stdout" },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stderr",
            value: Expr::Var { name: "_goml_os.Stderr" },
        },
    );
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_method_call(Expr::Var { name: "cmd" }, "Run", Vec::new())),
        },
    );
    if timed {
        stmts.push(
            Stmt::Var {
                name: "timed_out",
                ty: Type::Bool,
                value: Option::Some(
                    Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: std_method_call(Expr::Var { name: "ctx" }, "Err", Vec::new()),
                        rhs: Expr::Var { name: "_goml_context.DeadlineExceeded" },
                    },
                ),
            },
        );
        stmts.push(Stmt::Expr { expr: std_call("cancel", Vec::new()) })
    } else {
        ()
    };
    stmts.push(
        Stmt::Var { name: "code", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let failed: Vec[Stmt] = Vec::new();
    let missing_state: Vec[Stmt] = Vec::new();
    missing_state.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_status_expr(false, Expr::Int { value: "-1" }, std_error_string(), timed),
            ),
        },
    );
    failed.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
                rhs: Expr::Nil,
            },
            then_: Block { stmts: missing_state },
            else_: Option::None,
        },
    );
    let code_args: Vec[Expr] = Vec::new();
    code_args.push(
        std_method_call(
            Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
            "ExitCode",
            Vec::new(),
        ),
    );
    failed.push(Stmt::Assign { name: "code", value: std_call("int", code_args) });
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_status_expr(
                    true,
                    Expr::Var { name: "code" },
                    Expr::String { value: "" },
                    timed,
                ),
            ),
        },
    );
    std_function_item(
        if timed {
            "std.process.status_timeout"
        } else {
            "std.process.status"
        },
        if timed {
            let params = std_process_params();
            params.push(("timeout_ms", Type::Int));
            params
        } else {
            std_process_params()
        },
        if timed {
            std_process_status_timeout_type()
        } else {
            std_process_status_type()
        },
        stmts,
    )
}

fn std_process_status_item() -> Item {
    std_process_status_item_for(false)
}

fn std_process_status_timeout_item() -> Item {
    std_process_status_item_for(true)
}

fn standard_runtime_hook_item(key: string) -> Option[Item] {
    if key == "std.env.args" {
        Option::Some(std_env_args_item())
    } else if key == "std.env.current_dir" {
        Option::Some(std_string_result_item(key, "_goml_os.Getwd"))
    } else if key == "std.env.current_exe" {
        Option::Some(std_string_result_item(key, "_goml_os.Executable"))
    } else if key == "std.env.var" {
        Option::Some(std_env_var_item())
    } else if key == "std.fs.read_file" {
        Option::Some(std_fs_read_file_item())
    } else if key == "std.fs.sha256_file" {
        Option::Some(std_fs_sha256_file_item())
    } else if key == "std.fs.write_file" {
        Option::Some(std_fs_write_file_item())
    } else if key == "std.fs.read_bytes" {
        Option::Some(std_fs_read_bytes_item())
    } else if key == "std.fs.write_bytes" {
        Option::Some(std_fs_write_bytes_item())
    } else if key == "std.fs.create_dir_all" {
        Option::Some(std_fs_create_dir_all_item())
    } else if key == "std.fs.remove_file" {
        Option::Some(std_fs_remove_item(key, "_goml_os.Remove"))
    } else if key == "std.fs.remove_dir_all" {
        Option::Some(std_fs_remove_item(key, "_goml_os.RemoveAll"))
    } else if key == "std.fs.file_exists" {
        Option::Some(std_fs_file_exists_item())
    } else if key == "std.fs.is_file" {
        Option::Some(std_fs_stat_kind_item(key, false))
    } else if key == "std.fs.is_dir" {
        Option::Some(std_fs_stat_kind_item(key, true))
    } else if key == "std.fs.canonicalize" {
        Option::Some(std_fs_canonicalize_item())
    } else if key == "std.fs.read_dir" {
        Option::Some(std_fs_read_dir_item())
    } else if key == "std.io.print" {
        Option::Some(std_io_output_item(key, "_goml_fmt.Print", false))
    } else if key == "std.io.println" {
        Option::Some(std_io_output_item(key, "_goml_fmt.Println", false))
    } else if key == "std.io.eprint" {
