package go_backend;

use gomlc::tast;

fn std_function_item(key: string, params: Vec[(string, Type)], ret_ty: Type, stmts: Vec[Stmt]) -> Item {
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn std_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Var { name }, args }
}

fn std_method_call(value: Expr, name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Field { expr: value, field_name: name }, args }
}

fn std_tuple_type(values: Vec[tast::Type]) -> Type {
    lower_type(tast::Type::Tuple { items: values })
}

fn std_tuple_expr(ty: Type, values: Vec[Expr]) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in range(0, values.len()) {
        fields.push(("_" + index.to_string(), values[index]))
    };
    Expr::StructLiteral { ty, fields }
}

fn std_vec_type(elem: tast::Type) -> tast::Type {
    tast::Type::VecType { elem }
}

fn std_vec_expr(elem: tast::Type, items: Expr) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(("items", items));
    Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))) },
            fields,
        },
    }
}

fn std_error_string() -> Expr {
    std_method_call(Expr::Var { name: "err" }, "Error", Vec::new())
}

fn std_error_condition() -> Expr {
    Expr::Binary { op: BinaryOp::NotEq, lhs: Expr::Var { name: "err" }, rhs: Expr::Nil }
}

fn std_bool_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_string_expr(valid: bool, value: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    std_tuple_expr(std_bool_string_type(), values)
}

fn std_bool_string_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::String);
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_string_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_string_string_type(), values)
}

fn std_bool_bytes_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(std_vec_type(tast::Type::Uint8));
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_bytes_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_bytes_string_type(), values)
}

fn std_bool_strings_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(std_vec_type(tast::Type::String));
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_strings_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_strings_string_type(), values)
}

fn std_bool_value_string_type(value: tast::Type) -> Type {
    std_tuple_type(Vec::[tast::Type::Bool, value, tast::Type::String])
}

fn std_bool_value_string_expr(value_ty: tast::Type, valid: bool, value: Expr, error: Expr) -> Expr {
    std_tuple_expr(
        std_bool_value_string_type(value_ty),
        Vec::[Expr::Bool { value: valid }, value, error],
    )
}

fn std_env_args_item() -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_vec_expr(tast::Type::String, Expr::Var { name: "_goml_os.Args" }),
            ),
        },
    );
    std_function_item(
        "std.env.args",
        Vec::new(),
        lower_type(std_vec_type(tast::Type::String)),
        stmts,
    )
}

fn std_string_result_item(key: string, function: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "value", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("err");
    stmts.push(Stmt::MultiAssign { names, value: std_call(function, Vec::new()) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Var { name: "value" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, Vec::new(), std_bool_string_string_type(), stmts)
}

fn std_env_var_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("name", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "value", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "found", ty: Type::Bool, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("found");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "name" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_os.LookupEnv", args) });
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Var { name: "found" });
    values.push(Expr::Var { name: "value" });
    stmts.push(Stmt::Return { expr: Option::Some(std_tuple_expr(std_bool_string_type(), values)) });
    std_function_item("std.env.var", params, std_bool_string_type(), stmts)
}

fn std_fs_read_file_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let bytes = Type::Slice { elem: Type::Uint8 };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "data", ty: bytes, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("data");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_os.ReadFile", args) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Convert { ty: Type::String, expr: Expr::Var { name: "data" } },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item("std.fs.read_file", params, std_bool_string_string_type(), stmts)
}

fn std_fs_sha256_file_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var { name: "data", ty: Type::Slice { elem: Type::Uint8 }, value: Option::None },
    );
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::["data", "err"],
            value: std_call("_goml_os.ReadFile", Vec::[Expr::Var { name: "path" }]),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "digest",
            ty: Type::Array { len: 32, elem: Type::Uint8 },
            value: Option::Some(std_call("_goml_sha256.Sum256", Vec::[Expr::Var { name: "data" }])),
        },
    );
    let format_args = Vec::[Expr::String { value: "%x" }, Expr::Var { name: "digest" }];
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    std_call("_goml_fmt.Sprintf", format_args),
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item("std.fs.sha256_file", params, std_bool_string_string_type(), stmts)
}

fn std_fs_write_file_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    params.push(("content", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    args.push(
        Expr::Convert { ty: Type::Named { name: "[]byte" }, expr: Expr::Var { name: "content" } },
    );
    args.push(Expr::Int { value: "0644" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_call("_goml_os.WriteFile", args)),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(false, std_error_string())) },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(true, Expr::String { value: "" })) },
    );
    std_function_item("std.fs.write_file", params, std_bool_string_type(), stmts)
}

