fn std_path_with_extension_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    params.push(("extension", Type::String));
    let base_args: Vec[Expr] = Vec::new();
    base_args.push(Expr::Var { name: "path" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "base",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Base", base_args)),
        },
    );
    let current_args: Vec[Expr] = Vec::new();
    current_args.push(Expr::Var { name: "path" });
    stmts.push(
        Stmt::Var {
            name: "current",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Ext", current_args)),
        },
    );
    let clear_current: Vec[Stmt] = Vec::new();
    clear_current.push(Stmt::Assign { name: "current", value: Expr::String { value: "" } });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "current" },
                rhs: Expr::Var { name: "base" },
            },
            then_: Block { stmts: clear_current },
            else_: Option::None,
        },
    );
    let without_args: Vec[Expr] = Vec::new();
    without_args.push(Expr::Var { name: "path" });
    without_args.push(Expr::Var { name: "current" });
    stmts.push(
        Stmt::Var {
            name: "without",
            ty: Type::String,
            value: Option::Some(std_call("_goml_strings.TrimSuffix", without_args)),
        },
    );
    let empty: Vec[Stmt] = Vec::new();
    empty.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "without" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "extension" },
                rhs: Expr::String { value: "" },
            },
            then_: Block { stmts: empty },
            else_: Option::None,
        },
    );
    let extension_args: Vec[Expr] = Vec::new();
    extension_args.push(Expr::Var { name: "extension" });
    extension_args.push(Expr::String { value: "." });
    stmts.push(
        Stmt::Assign {
            name: "extension",
            value: std_call("_goml_strings.TrimPrefix", extension_args),
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "without" },
                        rhs: Expr::String { value: "." },
                    },
                    rhs: Expr::Var { name: "extension" },
                },
            ),
        },
    );
    std_function_item("std.path.with_extension", params, Type::String, stmts)
}

