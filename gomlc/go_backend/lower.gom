package go_backend;

use gomlc::anf;
use gomlc::ast;
use gomlc::numeric;
use gomlc::resources;
use gomlc::repr;
use gomlc::tast;
use std::task;
use std::num;

pub struct FunctionNames {
    pub by_source: HashMap[string, string],
    pub reserved: HashMap[string, unit],
    pub variant_names: HashMap[string, string],
}

struct LowerEnv {
    builtin: tast::BuiltinContract,
    joins: Vec[anf::JoinBind],
    emitted_loop_labels: Vec[string],
    variants: VariantInfos,
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    functions: Vec[anf::Function],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
}

struct CompiledValue {
    stmts: Vec[Stmt],
    expr: Expr,
}

struct GoForeignSpec {
    import_path: string,
    symbol: string,
    ty: repr::Type,
}

struct JoinRecResult {
    stmts: Vec[Stmt],
    loop_names: Vec[string],
}

fn append_stmts(target: Vec[Stmt], values: Vec[Stmt]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn append_items(target: Vec[Item], values: Vec[Item]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn function_name(value: string) -> string {
    if value == "main" {
        "main0"
    } else if value == "init" {
        go_generated_ident("_goml_user_init")
    } else {
        go_ident(value)
    }
}

fn new_function_names() -> FunctionNames {
    FunctionNames {
        by_source: HashMap::from_array([]),
        reserved: HashMap::from_array([]),
        variant_names: HashMap::from_array([]),
    }
}

fn add_function_name(values: FunctionNames, source: string, generated: string) -> unit {
    values.by_source[source] = generated;
    values.reserved[generated] = ();
}

fn mapped_function_name(values: FunctionNames, value: string) -> Option[string] {
    values.by_source[value]
}

fn env_function_name(env: LowerEnv, value: string) -> string {
    match mapped_function_name(env.function_names, value) {
        Some(name) => name,
        None => function_name(value),
    }
}

fn function_type_names(
    function_names: FunctionNames,
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
) -> HashMap[string, unit] {
    let result: HashMap[string, unit] = HashMap::from_array([]);
    for definition in structs {
        let name = go_user_type_name(definition.name);
        result[name] = ();
        function_names.reserved[name] = ();
    }
    for definition in enums {
        let name = go_user_type_name(definition.name);
        result[name] = ();
        function_names.reserved[name] = ();
    }
    for instance in instances {
        let name = go_user_type_name(instance.name);
        result[name] = ();
        function_names.reserved[name] = ();
    }
    result
}

fn resolve_function_name(value: string, type_names: HashMap[string, unit]) -> string {
    if value == "main" {
        "main"
    } else {
        let candidate = go_ident(value);
        if candidate == "init" || is_generated_tuple_type_name(candidate)
            || type_names.contains(candidate) {
            go_generated_ident("_goml_user_" + candidate)
        } else {
            candidate
        }
    }
}

fn add_entry_variant_names(
    used: NameSet,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> unit {
    for definition in enums {
        for variant in definition.variants {
            let name = variant_go_name(
                definition.name,
                variant.name,
                enums,
                structs,
                instances,
                function_names,
            );
            add_reachable(used, name)
        }
    }
}

fn entry_wrapper_name(
    functions: Vec[anf::Function],
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> string {
    let used = new_name_set();
    for function in functions {
        if function.name != "main" {
            add_reachable(used, go_ident(function.name))
        } else {}
    }
    for definition in structs {
        add_reachable(used, go_user_type_name(definition.name))
    }
    for definition in enums {
        add_reachable(used, go_user_type_name(definition.name))
    }
    for instance in instances {
        add_reachable(used, go_user_type_name(instance.name))
    }
    add_entry_variant_names(used, enums, structs, instances, function_names);
    if !name_present(used, "main0") {
        "main0"
    } else {
        let mut index = 1;
        let mut result = "main0__" + index.to_string();
        while name_present(used, result) {
            index = index + 1;
            result = "main0__" + index.to_string();
        }
        result
    }
}

fn build_function_names(
    functions: Vec[anf::Function],
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
) -> FunctionNames {
    let resolved = new_function_names();
    let type_names = function_type_names(resolved, structs, enums, instances);
    for function in functions {
        add_function_name(resolved, function.name, resolve_function_name(function.name, type_names))
    }
    let entry_name = entry_wrapper_name(functions, structs, enums, instances, resolved);
    let result = FunctionNames {
        by_source: HashMap::from_array([]),
        reserved: resolved.reserved,
        variant_names: resolved.variant_names,
    };
    for function in functions {
        let name = if function.name == "main" {
            entry_name
        } else {
            match mapped_function_name(resolved, function.name) {
                Some(name) => name,
                None => function_name(function.name),
            }
        };
        add_function_name(result, function.name, name)
    }
    result
}

fn go_foreign_import_alias(import_path: string) -> string {
    go_hashed_ident("ffi_import", import_path)
}

fn go_foreign_wrapper_name(import_path: string, symbol: string, ty: repr::Type) -> string {
    go_hashed_ident("ffi", import_path + "\u0000" + symbol + "\u0000" + compact_type(ty))
}

fn go_foreign_call(spec: GoForeignSpec, args: Vec[Expr]) -> Expr {
    Expr::Call {
        func: Expr::Field {
            expr: Expr::Var { name: go_foreign_import_alias(spec.import_path) },
            field_name: spec.symbol,
        },
        args,
    }
}

fn go_foreign_opaque_dyn(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Dyn { trait_name: _, args, associated_types, additional_bounds } => args.is_empty()
            && associated_types.is_empty()
            && additional_bounds.is_empty(),
        _ => false,
    }
}

fn go_foreign_argument(name: string, ty: repr::Type) -> Expr {
    let value = Expr::Var { name };
    if go_foreign_opaque_dyn(ty) {
        Expr::Field { expr: value, field_name: "data" }
    } else {
        value
    }
}

fn go_foreign_result(value: Expr, ty: repr::Type) -> Expr {
    if go_foreign_opaque_dyn(ty) {
        Expr::StructLiteral { ty: lower_type(ty), fields: Vec::from_array([("data", value)]) }
    } else {
        value
    }
}

fn go_foreign_wrapper(spec: GoForeignSpec) -> Function {
    match repr::resolve_type(spec.ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::from_array([]);
            let args: Vec[Expr] = Vec::from_array([]);
            for index in 0..param_types.len() {
                let name = "arg" + index.to_string();
                params.push((name, lower_type(param_types[index])));
                args.push(go_foreign_argument(name, param_types[index]))
            }
            let call = go_foreign_call(spec, args);
            let stmts: Vec[Stmt] = Vec::from_array([]);
            match repr::resolve_type(ret_ty) {
                Unit => {
                    stmts.push(Stmt::Expr { expr: call });
                    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) })
                },
                Tuple { items: values } => {
                    let names: Vec[string] = Vec::from_array([]);
                    let fields: Vec[(string, Expr)] = Vec::from_array([]);
                    for index in 0..values.len() {
                        let name = "result" + index.to_string();
                        stmts.push(
                            Stmt::Var { name, ty: lower_type(values[index]), value: Option::None },
                        );
                        names.push(name);
                        fields.push(("_" + index.to_string(), Expr::Var { name }))
                    }
                    stmts.push(Stmt::MultiAssign { names, value: call });
                    stmts.push(
                        Stmt::Return {
                            expr: Option::Some(
                                Expr::StructLiteral { ty: lower_type(ret_ty), fields },
                            ),
                        },
                    )
                },
                _ => stmts.push(
                    Stmt::Return { expr: Option::Some(go_foreign_result(call, ret_ty)) },
                ),
            };
            Function {
                name: go_foreign_wrapper_name(spec.import_path, spec.symbol, spec.ty),
                params,
                ret_ty: Option::Some(lower_type(ret_ty)),
                body: Block { stmts },
            }
        },
        _ => Function {
            name: go_foreign_wrapper_name(spec.import_path, spec.symbol, spec.ty),
            params: Vec::from_array([]),
            ret_ty: Option::Some(Type::Unit),
            body: Block {
                stmts: Vec::from_array([Stmt::Return { expr: Option::Some(Expr::Unit) }]),
            },
        },
    }
}

fn emit_go_foreign_import_items(items: Vec[Item], values: Vec[GoForeignSpec]) -> unit {
    let imports: Vec[(string, string)] = Vec::from_array([]);
    for value in values {
        let mut found = false;
        for present in imports {
            if present.1 == value.import_path {
                found = true;
                break
            } else {}
        }
        if !found {
            imports.push((go_foreign_import_alias(value.import_path), value.import_path))
        } else {}
    }
    if !imports.is_empty() {
        items.push(Item::ImportGroup(imports))
    } else {}
}

fn emit_go_foreign_wrapper_items(items: Vec[Item], values: Vec[GoForeignSpec]) -> unit {
    for value in values {
        items.push(Item::Function(go_foreign_wrapper(value)))
    }
}

fn callable_name(env: LowerEnv, value: repr::Callable, ty: repr::Type) -> string {
    match value {
        Function(name) => env_function_name(env, name),
        LangItem { item: _, function_name } => env_function_name(env, function_name),
        Runtime(name) => runtime_hook_name(name),
        Intrinsic(name) => go_ident(name),
        GoForeign { import_path, symbol } => go_foreign_wrapper_name(import_path, symbol, ty),
        TraitMethod { trait_ref: reference, method_name: name, .. } => {
            go_ident(reference.name + "#" + name)
        },
        DynTraitMethod { trait_name: owner, dispatch_name: dispatch, method_name: name } => {
            go_ident("dyn#" + owner + "#" + dispatch + "#" + name)
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            env_function_name(env, repr::inherent_method_name(owner, name))
        },
    }
}

fn go_float_literal(value: string, ty: repr::Type) -> string {
    match repr::resolve_type(ty) {
        Float32 => match numeric::parse_float32(value) {
            Some(parsed) => parsed.to_string(),
            None => value,
        },
        Float64 => match num::parse_float64(value) {
            Ok(parsed) => parsed.to_string(),
            Err(_) => value,
        },
        _ => value,
    }
}

fn compile_primitive(value: repr::Primitive, ty: repr::Type) -> Expr {
    match value {
        Unit => Expr::Unit,
        Bool { value } => Expr::Bool { value },
        Int { value } | Int8 { value } | Int16 { value } | Int32 { value } | Int64 { value } | Uint {
            value,
        } | Uint8 { value } | Uint16 { value } | Uint32 { value } | Uint64 { value } => Expr::Int {
            value,
        },
        Float { value } | Float32 { value } | Float64 { value } => Expr::Float {
            value: go_float_literal(value, ty),
        },
        String { value } => Expr::String { value },
        Char { value } => Expr::Int { value: (value.to_uint32()).to_string() },
        Bytes { values } => {
            let items: Vec[Expr] = Vec::with_capacity(values.len());
            for value in values {
                items.push(Expr::Int { value })
            }
            let fields: Vec[(string, Expr)] = Vec::from_array([]);
            fields.push(
                ("items", Expr::ArrayLiteral { ty: Type::Slice { elem: Type::Uint8 }, items }),
            );
            Expr::Unary {
                op: UnaryOp::Address,
                expr: Expr::StructLiteral {
                    ty: Type::Named {
                        name: go_generated_ident(
                            "_goml_vec_" + go_ident(encode_type(repr::Type::Uint8)),
                        ),
                    },
                    fields,
                },
            }
        },
    }
}

fn compile_constant_expr(variants: VariantInfos, value: repr::ConstExpr) -> Expr {
    match value {
        Prim { value, ty } => compile_primitive(value, ty),
        Ref { name, ty: _ } => Expr::Var { name: go_local_ident(name) },
        Unary { op, expr, ty: _ } => Expr::Unary {
            op: compile_unary(op),
            expr: compile_constant_expr(variants, expr),
        },
        Cast { expr, ty } => Expr::Convert {
            ty: lower_type(ty),
            expr: compile_constant_expr(variants, expr),
        },
        Binary { op, lhs, rhs, ty: _ } => Expr::Binary {
            op: compile_binary(op),
            lhs: compile_constant_expr(variants, lhs),
            rhs: compile_constant_expr(variants, rhs),
        },
        Tuple { items, ty } => {
            let fields: Vec[(string, Expr)] = Vec::with_capacity(items.len());
            for index in 0..items.len() {
                fields.push(
                    ("_" + index.to_string(), compile_constant_expr(variants, items[index])),
                )
            }
            Expr::StructLiteral { ty: lower_type(ty), fields }
        },
        Array { items, ty } => {
            let values: Vec[Expr] = Vec::with_capacity(items.len());
            for item in items {
                values.push(compile_constant_expr(variants, item))
            }
            Expr::ArrayLiteral { ty: lower_type(ty), items: values }
        },
        Constr { constructor, args, ty } => {
            let fields: Vec[(string, Expr)] = Vec::with_capacity(args.len());
            let info = match constructor.tag {
                Some(tag) => find_variant_info(variants, ty, tag),
                None => Option::None,
            };
            match info {
                Some(value) => if value.compact {
                    fields.push(("_tag", Expr::Int { value: value.tag.to_string() }))
                } else {},
                None => (),
            };
            for index in 0..args.len() {
                fields.push(
                    (
                        if constructor.is_struct && index < constructor.fields.len() {
                            go_ident(constructor.fields[index])
                        } else if match info {
                            Some(value) => value.compact,
                            None => false,
                        } {
                            compact_variant_field_name(
                                match constructor.tag {
                                    Some(tag) => tag,
                                    None => 0,
                                },
                                index,
                            )
                        } else {
                            "_" + index.to_string()
                        },
                        compile_constant_expr(variants, args[index]),
                    ),
                )
            }
            let go_ty = if constructor.is_struct {
                lower_type(ty)
            } else {
                match info {
                    Some(value) => if value.compact {
                        lower_type(ty)
                    } else {
                        Type::Named { name: value.variant_name }
                    },
                    None => constructor_type(constructor),
                }
            };
            Expr::StructLiteral { ty: go_ty, fields }
        },
    }
}

fn scalar_constant_type(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        _ => false,
    }
}

fn emit_constants(items: Vec[Item], values: Vec[repr::Constant], variants: VariantInfos) -> unit {
    let specs: Vec[ConstSpec] = Vec::from_array([]);
    for value in values {
        if scalar_constant_type(value.ty) {
            specs.push(
                ConstSpec {
                    name: go_local_ident(value.name),
                    ty: lower_type(value.ty),
                    value: compile_constant_expr(variants, value.value),
                },
            )
        } else {
            items.push(
                Item::Global(
                    Global {
                        name: go_local_ident(value.name),
                        ty: Option::Some(lower_type(value.ty)),
                        value: compile_constant_expr(variants, value.value),
                    },
                ),
            )
        }
    }
    if specs.is_empty() {} else {
        items.push(Item::ConstGroup(ConstGroup { specs }))
    }
}

fn emit_statics(items: Vec[Item], values: Vec[repr::Static]) -> unit {
    for value in values {
        let cell_ty = lower_type(value.ty);
        let body_stmts: Vec[Stmt] = Vec::from_array([]);
        body_stmts.push(
            Stmt::Var {
                name: "cell",
                ty: cell_ty,
                value: Option::Some(
                    Expr::Call {
                        func: Expr::Var { name: runtime_helper_name("once_cell_new", value.ty) },
                        args: Vec::from_array([]),
                    },
                ),
            },
        );
        body_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "cell" },
                field_name: "name",
                value: Expr::String { value: value.name },
            },
        );
        body_stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "cell" }) });
        items.push(
            Item::Global(
                Global {
                    name: go_local_ident(value.name),
                    ty: Option::Some(cell_ty),
                    value: Expr::Call {
                        func: Expr::FuncLit {
                            params: Vec::from_array([]),
                            ret_ty: cell_ty,
                            body: Block { stmts: body_stmts },
                        },
                        args: Vec::from_array([]),
                    },
                },
            ),
        )
    }
}

fn compile_imm(env: LowerEnv, value: anf::Imm) -> Expr {
    match value {
        Var { name, ty: _ } => {
            match mapped_function_name(env.function_names, name) {
                Some(value) => Expr::Var { name: value },
                None => Expr::Var { name: go_local_ident(name) },
            }
        },
        Callable { callable: Intrinsic(key), ty: function_ty } => {
            compile_intrinsic_callable(key, function_ty)
        },
        Callable { callable: value, ty } => Expr::Var { name: callable_name(env, value, ty) },
        Prim { value, ty } => compile_primitive(value, ty),
        Tag { index, ty: owner_ty } => {
            match find_variant_info(env.variants, owner_ty, index) {
                Some(info) => {
                    if info.tag_only {
                        Expr::Var { name: info.variant_name }
                    } else {
                        Expr::Int { value: index.to_string() }
                    }
                },
                None => Expr::Int { value: index.to_string() },
            }
        },
    }
}

fn compile_runtime_imm(env: LowerEnv, value: anf::Imm, name: string) -> CompiledValue {
    let expr = compile_imm(env, value);
    match value {
        Prim { value: _, ty } => {
            let stmts: Vec[Stmt] = Vec::from_array([]);
            stmts.push(Stmt::Var { name, ty: lower_type(ty), value: Option::Some(expr) });
            CompiledValue { stmts, expr: Expr::Var { name } }
        },
        _ => CompiledValue { stmts: Vec::from_array([]), expr },
    }
}

fn compile_closure_function(
    env: LowerEnv,
    environment: anf::Imm,
    apply: string,
    target_ty: repr::Type,
) -> Expr {
    match repr::resolve_type(target_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::from_array([]);
            let args: Vec[Expr] = Vec::from_array([]);
            args.push(compile_imm(env, environment));
            for index in 0..param_types.len() {
                let name = "p" + index.to_string();
                params.push((name, lower_type(param_types[index])));
                args.push(Expr::Var { name })
            }
            let stmts: Vec[Stmt] = Vec::from_array([]);
            stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Call { func: Expr::Var { name: env_function_name(env, apply) }, args },
                    ),
                },
            );
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => compile_imm(env, environment),
    }
}

fn compile_imm_expected(env: LowerEnv, value: anf::Imm, expected_ty: repr::Type) -> Expr {
    match value {
        Tag { index: tag, ty: owner_ty } => {
            match find_variant_info(env.variants, owner_ty, tag) {
                Some(info) => if info.compact {
                    Expr::StructLiteral {
                        ty: lower_type(owner_ty),
                        fields: Vec::from_array([("_tag", Expr::Int { value: tag.to_string() })]),
                    }
                } else {
                    match variant_type(env.variants, owner_ty, tag) {
                        Some(ty) => Expr::StructLiteral { ty, fields: Vec::from_array([]) },
                        None => compile_imm(env, value),
                    }
                },
                None => compile_imm(env, value),
            }
        },
        _ => compile_imm(env, value),
    }
}

fn compile_imms_expected(env: LowerEnv, values: Vec[anf::Imm], expected: Vec[repr::Type]) -> Vec[
    Expr,
] {
    let result: Vec[Expr] = Vec::from_array([]);
    for index in 0..values.len() {
        if index < expected.len() {
            result.push(compile_imm_expected(env, values[index], expected[index]))
        } else {
            result.push(compile_imm(env, values[index]))
        }
    }
    result
}

fn find_dyn_method(
    builtin: tast::BuiltinContract,
    functions: Vec[anf::Function],
    trait_name: string,
    method_name: string,
) -> Option[DynMethod] {
    let methods = dyn_methods(builtin, functions, trait_name);
    let mut index = methods.len() - 1;
    while index >= 0 {
        let method = methods[index];
        if method.name == method_name {
            return Option::Some(method)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn intrinsic_source_name(key: string) -> string {
    if key == "array.get" {
        "array_get"
    } else if key == "array.set" {
        "array_set"
    } else if key == "ref.new" {
        "ref"
    } else if key == "ref.get" {
        "ref_get"
    } else if key == "ref.set" {
        "ref_set"
    } else if key == "ref.ptr_eq" {
        "ptr_eq"
    } else if key == "ref.ptr_hash" {
        "ptr_hash"
    } else if key == "vec.new" {
        "vec_new"
    } else if key == "vec.with_capacity" {
        "vec_with_capacity"
    } else if key == "vec.push" {
        "vec_push"
    } else if key == "vec.get" {
        "vec_get"
    } else if key == "vec.set" {
        "vec_set"
    } else if key == "vec.len" {
        "vec_len"
    } else if key == "vec.capacity" {
        "vec_capacity"
    } else if key == "vec.reserve" {
        "vec_reserve"
    } else if key == "vec.truncate" {
        "vec_truncate"
    } else if key == "once_cell.new" {
        "once_cell_new"
    } else if key == "once_cell.get_or_init" {
        "once_cell_get_or_init"
    } else if key == "hashmap.new" {
        "hashmap_new"
    } else if key == "hashmap.get" {
        "hashmap_get"
    } else if key == "hashmap.set" {
        "hashmap_set"
    } else if key == "hashmap.remove" {
        "hashmap_remove"
    } else if key == "hashmap.len" {
        "hashmap_len"
    } else if key == "hashmap.contains" {
        "hashmap_contains"
    } else if key == "hashmap.entries" {
        "hashmap_entries"
    } else if key == "channel.new" {
        "channel_new"
    } else if key == "channel.send" {
        "channel_send"
    } else if key == "channel.recv" {
        "channel_recv"
    } else if key == "channel.send_cancel" {
        "channel_send_cancel"
    } else if key == "channel.recv_cancel" {
        "channel_recv_cancel"
    } else if key == "channel.close" {
        "channel_close"
    } else if key == "compiler.missing" {
        "missing"
    } else {
        key
    }
}

fn intrinsic_owner_type(key: string, function_ty: repr::Type, args: Vec[anf::Imm]) -> Option[
    repr::Type,
] {
    if key == "ref.new" || key == "vec.new" || key == "vec.with_capacity" || key == "hashmap.new"
        || key == "once_cell.new"
        || key == "compiler.missing" {
        match repr::resolve_type(function_ty) {
            Func { params: _, ret_ty } => Option::Some(ret_ty),
            _ => Option::None,
        }
    } else if !args.is_empty() {
        Option::Some(anf::imm_type(args[0]))
    } else {
        match repr::resolve_type(function_ty) {
            Func { params, ret_ty: _ } => {
                if !params.is_empty() {
                    Option::Some(params[0])
                } else {
                    Option::None
                }
            },
            _ => Option::None,
        }
    }
}

fn intrinsic_helper_call_name(key: string, function_ty: repr::Type, args: Vec[anf::Imm]) -> Option[
    string,
] {
    let supported = key == "array.get" || key == "array.set" || key == "ref.new" || key == "ref.get"
        || key == "ref.set"
        || key == "ref.ptr_eq"
        || key == "ref.ptr_hash"
        || key == "vec.new"
        || key == "vec.with_capacity"
        || key == "vec.push"
        || key == "vec.get"
        || key == "vec.set"
        || key == "vec.len"
        || key == "vec.capacity"
        || key == "vec.reserve"
        || key == "vec.truncate"
        || key == "once_cell.new"
        || key == "once_cell.get_or_init"
        || key == "hashmap.new"
        || key == "hashmap.get"
        || key == "hashmap.set"
        || key == "hashmap.remove"
        || key == "hashmap.len"
        || key == "hashmap.contains"
        || key == "hashmap.entries"
        || key == "compiler.missing";
    if supported {
        match intrinsic_owner_type(key, function_ty, args) {
            Some(owner) => Option::Some(runtime_helper_name(intrinsic_source_name(key), owner)),
            None => Option::None,
        }
    } else {
        Option::None
    }
}

fn compile_slice_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::from_array([]);
            let vars: Vec[Expr] = Vec::from_array([]);
            for index in 0..param_types.len() {
                let name = "p" + index.to_string();
                params.push((name, lower_type(param_types[index])));
                vars.push(Expr::Var { name })
            }
            let value = if key == "slice.new" {
                Expr::Slice {
                    base: Expr::Field { expr: vars[0], field_name: "items" },
                    start: vars[1],
                    end: vars[2],
                }
            } else if key == "slice.get" {
                Expr::Index { base: vars[0], index: vars[1] }
            } else if key == "slice.len" {
                let args: Vec[Expr] = Vec::from_array([]);
                args.push(vars[0]);
                Expr::Call { func: Expr::Var { name: "len" }, args }
            } else {
                Expr::Slice { base: vars[0], start: vars[1], end: vars[2] }
            };
            let stmts: Vec[Stmt] = Vec::from_array([]);
            stmts.push(Stmt::Return { expr: Option::Some(value) });
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_channel_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::from_array([]);
            let vars: Vec[Expr] = Vec::from_array([]);
            for index in 0..param_types.len() {
                let name = "p" + index.to_string();
                params.push((name, lower_type(param_types[index])));
                vars.push(Expr::Var { name })
            }
            let stmts: Vec[Stmt] = Vec::from_array([]);
            if key == "channel.new" {
                let args: Vec[Expr] = Vec::from_array([]);
                args.push(vars[0]);
                stmts.push(
                    Stmt::Return { expr: Option::Some(Expr::Make { ty: lower_type(ret_ty), args }) },
                )
            } else if key == "channel.send" {
                stmts.push(Stmt::Expr { expr: Expr::Send { channel: vars[0], value: vars[1] } });
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) })
            } else if key == "channel.recv" {
                let elem = match repr::resolve_type(param_types[0]) {
                    Channel { elem } => elem,
                    _ => repr::Type::Unit,
                };
                stmts.push(Stmt::Var { name: "value", ty: lower_type(elem), value: Option::None });
                stmts.push(Stmt::Var { name: "ok", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::MultiAssign {
                        names: Vec::from_array(["value", "ok"]),
                        value: Expr::Receive { channel: vars[0] },
                    },
                );
                let fields: Vec[(string, Expr)] = Vec::from_array([]);
                fields.push(("_0", Expr::Var { name: "value" }));
                fields.push(("_1", Expr::Var { name: "ok" }));
                stmts.push(
                    Stmt::Return {
                        expr: Option::Some(Expr::StructLiteral { ty: lower_type(ret_ty), fields }),
                    },
                )
            } else if key == "channel.send_cancel" {
                stmts.push(Stmt::Var { name: "completed", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::Select {
                        cases: Vec::from_array(
                            [
                                SelectCase {
                                    operation: SelectOperation::Send {
                                        channel: vars[0],
                                        value: vars[1],
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: true },
                                                },
                                            ],
                                        ),
                                    },
                                },
                                SelectCase {
                                    operation: SelectOperation::Receive {
                                        names: Vec::from_array([]),
                                        channel: task_context_done_expr(vars[2]),
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: false },
                                                },
                                            ],
                                        ),
                                    },
                                },
                            ],
                        ),
                    },
                );
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "completed" }) })
            } else if key == "channel.recv_cancel" {
                let elem = match repr::resolve_type(param_types[0]) {
                    Channel { elem } => elem,
                    _ => repr::Type::Unit,
                };
                stmts.push(Stmt::Var { name: "value", ty: lower_type(elem), value: Option::None });
                stmts.push(Stmt::Var { name: "ok", ty: Type::Bool, value: Option::None });
                stmts.push(Stmt::Var { name: "completed", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::Select {
                        cases: Vec::from_array(
                            [
                                SelectCase {
                                    operation: SelectOperation::Receive {
                                        names: Vec::from_array(["value", "ok"]),
                                        channel: vars[0],
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: true },
                                                },
                                            ],
                                        ),
                                    },
                                },
                                SelectCase {
                                    operation: SelectOperation::Receive {
                                        names: Vec::from_array([]),
                                        channel: task_context_done_expr(vars[1]),
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: false },
                                                },
                                            ],
                                        ),
                                    },
                                },
                            ],
                        ),
                    },
                );
                let fields: Vec[(string, Expr)] = Vec::from_array([]);
                fields.push(("_0", Expr::Var { name: "value" }));
                fields.push(("_1", Expr::Var { name: "ok" }));
                fields.push(("_2", Expr::Var { name: "completed" }));
                stmts.push(
                    Stmt::Return {
                        expr: Option::Some(Expr::StructLiteral { ty: lower_type(ret_ty), fields }),
                    },
                )
            } else {
                let args: Vec[Expr] = Vec::from_array([]);
                args.push(vars[0]);
                stmts.push(
                    Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "close" }, args } },
                );
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) })
            };
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_collection_from_array_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } if param_types.len() == 1 => {
            let params = Vec::from_array([("values", lower_type(param_types[0]))]);
            let values = Expr::Var { name: "values" };
            let stmts: Vec[Stmt] = Vec::from_array([]);
            if key == "vec.from_array" {
                let result_ty = match lower_type(ret_ty) {
                    Type::Pointer { elem } => elem,
                    other => other,
                };
                let empty = match repr::resolve_type(param_types[0]) {
                    Array { len, elem: _ } => len == 0,
                    _ => false,
                };
                if empty {
                    let len_args = Vec::from_array([values]);
                    let items = Expr::Slice {
                        base: values,
                        start: Expr::Int { value: "0" },
                        end: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                    };
                    stmts.push(
                        Stmt::Return {
                            expr: Option::Some(
                                Expr::Unary {
                                    op: UnaryOp::Address,
                                    expr: Expr::StructLiteral {
                                        ty: result_ty,
                                        fields: Vec::from_array([("items", items)]),
                                    },
                                },
                            ),
                        },
                    )
                } else {
                    let storage = Expr::Var { name: "storage" };
                    let storage_ty = Type::Struct {
                        fields: Vec::from_array(
                            [("vector", result_ty), ("values", lower_type(param_types[0]))],
                        ),
                    };
                    stmts.push(Stmt::Var { name: "storage", ty: storage_ty, value: Option::None });
                    stmts.push(
                        Stmt::FieldAssign { target: storage, field_name: "values", value: values },
                    );
                    let stored_values = Expr::Field { expr: storage, field_name: "values" };
                    let len_args = Vec::from_array([stored_values]);
                    let items = Expr::Slice {
                        base: stored_values,
                        start: Expr::Int { value: "0" },
                        end: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                    };
                    stmts.push(
                        Stmt::FieldAssign {
                            target: Expr::Field { expr: storage, field_name: "vector" },
                            field_name: "items",
                            value: items,
                        },
                    );
                    stmts.push(
                        Stmt::Return {
                            expr: Option::Some(
                                Expr::Unary {
                                    op: UnaryOp::Address,
                                    expr: Expr::Field { expr: storage, field_name: "vector" },
                                },
                            ),
                        },
                    )
                }
            } else {
                let result = Expr::Var { name: "result" };
                stmts.push(
                    Stmt::Var {
                        name: "result",
                        ty: lower_type(ret_ty),
                        value: Option::Some(
                            Expr::Call {
                                func: Expr::Var { name: runtime_helper_name("hashmap_new", ret_ty) },
                                args: Vec::from_array([]),
                            },
                        ),
                    },
                );
                let entry = Expr::Var { name: "entry" };
                let set_args = Vec::from_array(
                    [
                        result,
                        Expr::Field { expr: entry, field_name: "_0" },
                        Expr::Field { expr: entry, field_name: "_1" },
                    ],
                );
                stmts.push(
                    Stmt::Range {
                        names: Vec::from_array(["_", "entry"]),
                        expr: values,
                        body: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::Expr {
                                        expr: Expr::Call {
                                            func: Expr::Var {
                                                name: runtime_helper_name("hashmap_set", ret_ty),
                                            },
                                            args: set_args,
                                        },
                                    },
                                ],
                            ),
                        },
                    },
                );
                stmts.push(Stmt::Return { expr: Option::Some(result) })
            };
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_intrinsic_callable(key: string, function_ty: repr::Type) -> Expr {
    if key == "vec.from_array" || key == "hashmap.from_array" {
        compile_collection_from_array_callable(key, function_ty)
    } else if key == "slice.new" || key == "slice.get" || key == "slice.len" || key == "slice.sub" {
        compile_slice_callable(key, function_ty)
    } else if key == "channel.new" || key == "channel.send" || key == "channel.recv"
        || key == "channel.send_cancel"
        || key == "channel.recv_cancel"
        || key == "channel.close" {
        compile_channel_callable(key, function_ty)
    } else {
        match intrinsic_helper_call_name(key, function_ty, Vec::from_array([])) {
            Some(name) => Expr::Var { name },
            None => Expr::Var { name: go_ident(key) },
        }
    }
}

fn compile_callable(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    match func {
        Callable { callable: Intrinsic(key), ty: function_ty } => {
            match intrinsic_helper_call_name(key, function_ty, args) {
                Some(name) => Expr::Var { name },
                None => compile_imm(env, func),
            }
        },
        _ => compile_imm(env, func),
    }
}

fn compile_call(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    let expected = match repr::resolve_type(anf::imm_type(func)) {
        Func { params, ret_ty: _ } => params,
        _ => Vec::from_array([]),
    };
    let compiled = compile_imms_expected(env, args, expected);
    match func {
        Callable { callable: Intrinsic(key), ty: _ } => {
            if key == "slice.new" {
                Expr::Slice {
                    base: Expr::Field { expr: compiled[0], field_name: "items" },
                    start: compiled[1],
                    end: compiled[2],
                }
            } else if key == "slice.get" {
                Expr::Index { base: compiled[0], index: compiled[1] }
            } else if key == "slice.len" {
                let len_args: Vec[Expr] = Vec::from_array([]);
                len_args.push(compiled[0]);
                Expr::Call { func: Expr::Var { name: "len" }, args: len_args }
            } else if key == "slice.sub" {
                Expr::Slice { base: compiled[0], start: compiled[1], end: compiled[2] }
            } else {
                Expr::Call { func: compile_callable(env, func, args), args: compiled }
            }
        },
        _ => Expr::Call { func: compile_callable(env, func, args), args: compiled },
    }
}

fn compile_unary(value: ast::UnaryOp) -> UnaryOp {
    match value {
        Neg => UnaryOp::Neg,
        Not => UnaryOp::Not,
        BitNot => UnaryOp::BitNot,
    }
}

fn compile_binary(value: ast::BinaryOp) -> BinaryOp {
    match value {
        Add => BinaryOp::Add,
        Sub => BinaryOp::Sub,
        Mul => BinaryOp::Mul,
        Div => BinaryOp::Div,
        Rem => BinaryOp::Rem,
        BitAnd => BinaryOp::BitAnd,
        BitOr => BinaryOp::BitOr,
        BitXor => BinaryOp::BitXor,
        Shl => BinaryOp::Shl,
        Shr => BinaryOp::Shr,
        And => BinaryOp::And,
        Or => BinaryOp::Or,
        Less => BinaryOp::Less,
        Greater => BinaryOp::Greater,
        LessEq => BinaryOp::LessEq,
        GreaterEq => BinaryOp::GreaterEq,
        Eq => BinaryOp::Eq,
        NotEq => BinaryOp::NotEq,
    }
}

fn materializes_binary_operands(value: ast::BinaryOp) -> bool {
    match value {
        Rem | BitAnd | BitOr | BitXor | Shl | Shr => true,
        _ => false,
    }
}

fn append_struct_field_types(result: Vec[repr::Type], definition: repr::StructDef) -> unit {
    for field in definition.fields {
        result.push(field.1)
    }
}

fn struct_field_types(env: LowerEnv, value: repr::Type) -> Vec[repr::Type] {
    let result: Vec[repr::Type] = Vec::from_array([]);
    match repr::resolve_type(value) {
        Named { name } | ClosureEnvironment { name } => match find_struct(env.structs, name) {
            Some(definition) => append_struct_field_types(result, definition),
            None => (),
        },
        _ => (),
    };
    result
}

fn compile_constructor(
    env: LowerEnv,
    constructor: repr::Constructor,
    args: Vec[anf::Imm],
    ty: repr::Type,
) -> Expr {
    let expected: Vec[repr::Type] = Vec::from_array([]);
    let info = if constructor.is_struct {
        Option::None
    } else {
        match constructor.tag {
            Some(tag) => find_variant_info(env.variants, ty, tag),
            None => Option::None,
        }
    };
    if constructor.is_struct {
        for field_ty in struct_field_types(env, ty) {
            expected.push(field_ty)
        }
    } else {
        match constructor.tag {
            Some(tag) => match find_variant_info(env.variants, ty, tag) {
                Some(info) => {
                    for field_ty in info.field_types {
                        expected.push(field_ty)
                    }
                },
                None => (),
            },
            None => (),
        }
    };
    let fields: Vec[(string, Expr)] = Vec::from_array([]);
    match info {
        Some(value) => if value.compact {
            fields.push(("_tag", Expr::Int { value: value.tag.to_string() }))
        } else {},
        None => (),
    };
    for index in 0..args.len() {
        let name = if constructor.is_struct && index < constructor.fields.len() {
            go_ident(constructor.fields[index])
        } else if match info {
            Some(value) => value.compact,
            None => false,
        } {
            compact_variant_field_name(
                match constructor.tag {
                    Some(tag) => tag,
                    None => 0,
                },
                index,
            )
        } else {
            "_" + index.to_string()
        };
        let compiled = if index < expected.len() {
            compile_imm_expected(env, args[index], expected[index])
        } else {
            compile_imm(env, args[index])
        };
        fields.push((name, compiled))
    }
    let go_ty = if constructor.is_struct {
        lower_type(ty)
    } else {
        match info {
            Some(value) => if value.compact {
                lower_type(ty)
            } else {
                Type::Named { name: value.variant_name }
            },
            None => constructor_type(constructor),
        }
    };
    Expr::StructLiteral { ty: go_ty, fields }
}

fn compile_value(env: LowerEnv, bind_name: string, value: anf::Value, expected_ty: repr::Type) -> CompiledValue {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let expr = match value {
        Imm(value) => compile_imm_expected(env, value, expected_ty),
        Constr { constructor, args, ty } => compile_constructor(env, constructor, args, ty),
        Tuple { items, ty } => {
            let fields: Vec[(string, Expr)] = Vec::from_array([]);
            match repr::resolve_type(ty) {
                Tuple { items: item_types } => {
                    for index in 0..items.len() {
                        fields.push(
                            (
                                "_" + index.to_string(),
                                compile_imm_expected(env, items[index], item_types[index]),
                            ),
                        )
                    }
                },
                _ => {
                    for index in 0..items.len() {
                        fields.push(("_" + index.to_string(), compile_imm(env, items[index])))
                    }
                },
            };
            Expr::StructLiteral { ty: lower_type(ty), fields }
        },
        Array { items, ty } => {
            let expected = match repr::resolve_type(ty) {
                Array { len: _, elem } => {
                    let values: Vec[repr::Type] = Vec::from_array([]);
                    for _ in items {
                        values.push(elem)
                    }
                    values
                },
                _ => Vec::from_array([]),
            };
            Expr::ArrayLiteral {
                ty: lower_type(ty),
                items: compile_imms_expected(env, items, expected),
            }
        },
        ConstrGet { expr, constructor, field_index: index, ty: _ } => {
            let owner_ty = anf::imm_type(expr);
            let info = match constructor.tag {
                Some(tag) => find_variant_info(env.variants, owner_ty, tag),
                None => Option::None,
            };
            let field = if constructor.is_struct && index < constructor.fields.len() {
                go_ident(constructor.fields[index])
            } else if match info {
                Some(value) => value.compact,
                None => false,
            } {
                compact_variant_field_name(
                    match constructor.tag {
                        Some(tag) => tag,
                        None => 0,
                    },
                    index,
                )
            } else {
                "_" + index.to_string()
            };
            let target = if constructor.is_struct {
                compile_imm(env, expr)
            } else {
                match info {
                    Some(value) => if value.compact {
                        compile_imm(env, expr)
                    } else {
                        Expr::Cast {
                            expr: compile_imm(env, expr),
                            ty: Type::Named { name: value.variant_name },
                        }
                    },
                    None => {
                        Expr::Cast {
                            expr: compile_imm(env, expr),
                            ty: constructor_type(constructor),
                        }
                    },
                }
            };
            Expr::Field { expr: target, field_name: field }
        },
        Unary { op, expr: operand, ty: _ } => {
            let compiled = match op {
                BitNot => compile_runtime_imm(env, operand, go_local_ident(bind_name) + "_operand"),
                _ => CompiledValue { stmts: Vec::from_array([]), expr: compile_imm(env, operand) },
            };
            append_stmts(stmts, compiled.stmts);
            Expr::Unary { op: compile_unary(op), expr: compiled.expr }
        },
        Cast { expr: source, ty } => {
            let source_ty = lower_type(anf::imm_type(source));
            let compiled = compile_runtime_imm(env, source, go_local_ident(bind_name) + "_source");
            append_stmts(stmts, compiled.stmts);
            Expr::Convert {
                ty: lower_type(ty),
                expr: Expr::Convert { ty: source_ty, expr: compiled.expr },
            }
        },
        Binary { op, lhs, rhs, ty: _ } => {
            let compiled_lhs = if materializes_binary_operands(op) {
                compile_runtime_imm(env, lhs, go_local_ident(bind_name) + "_lhs")
            } else {
                CompiledValue { stmts: Vec::from_array([]), expr: compile_imm(env, lhs) }
            };
            let compiled_rhs = if materializes_binary_operands(op) {
                compile_runtime_imm(env, rhs, go_local_ident(bind_name) + "_rhs")
            } else {
                CompiledValue { stmts: Vec::from_array([]), expr: compile_imm(env, rhs) }
            };
            append_stmts(stmts, compiled_lhs.stmts);
            append_stmts(stmts, compiled_rhs.stmts);
            Expr::Binary { op: compile_binary(op), lhs: compiled_lhs.expr, rhs: compiled_rhs.expr }
        },
        Assign { name, value, target_ty, ty: _ } => {
            stmts.push(
                Stmt::Assign {
                    name: go_local_ident(name),
                    value: compile_imm_expected(env, value, target_ty),
                },
            );
            Expr::Unit
        },
        Call { func, args, ty: _ } => compile_call(env, func, args),
        ToDyn { trait_name, for_ty, expr, ty } => {
            let fields: Vec[(string, Expr)] = Vec::from_array([]);
            let compiled = compile_imm_expected(env, expr, for_ty);
            let data = match repr::resolve_type(for_ty) {
                Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | Char => Expr::Convert {
                    ty: lower_type(for_ty),
                    expr: compiled,
                },
                _ => compiled,
            };
            fields.push(("data", data));
            fields.push(
                (
                    "vtable",
                    Expr::Call {
                        func: Expr::Var {
                            name: dyn_factory_name(env.dyn_helper_names, trait_name, for_ty),
                        },
                        args: Vec::from_array([]),
                    },
                ),
            );
            Expr::StructLiteral { ty: lower_type(ty), fields }
        },
        DynCall { trait_name, method_name: method, receiver, args, ty: _ } => {
            let method_name = dyn_method_parts(method, trait_name).1;
            let receiver = compile_imm(env, receiver);
            let values: Vec[Expr] = Vec::from_array([]);
            values.push(Expr::Field { expr: receiver, field_name: "data" });
            let expected = match find_dyn_method(
                env.builtin,
                env.functions,
                trait_name,
                method_name,
            ) {
                Some(info) => info.params,
                None => Vec::from_array([]),
            };
            for arg in compile_imms_expected(env, args, expected) {
                values.push(arg)
            }
            Expr::Call {
                func: Expr::Field {
                    expr: Expr::Field { expr: receiver, field_name: "vtable" },
                    field_name: go_ident(method_name),
                },
                args: values,
            }
        },
        Go { closure: value, ty: _ } => {
            let call = compile_call(env, value, Vec::from_array([]));
            stmts.push(Stmt::Go { call });
            Expr::Unit
        },
        PackClosure { environment, apply, ty } => {
            compile_closure_function(env, environment, apply, ty)
        },
        Proj { tuple, index, ty: _ } => {
            Expr::Field { expr: compile_imm(env, tuple), field_name: "_" + index.to_string() }
        },
    };
    CompiledValue { stmts, expr }
}

fn compile_let(env: LowerEnv, value: anf::LetBind) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::from_array([]);
    let compiled = compile_value(env, value.name, value.value, value.ty);
    append_stmts(result, compiled.stmts);
    result.push(
        Stmt::Var {
            name: go_local_ident(value.name),
            ty: lower_type(value.ty),
            value: Option::Some(compiled.expr),
        },
    );
    result
}

fn collect_joins_term(result: Vec[anf::JoinBind], value: anf::Term) -> unit {
    match value {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_joins_block(result, then_);
            collect_joins_block(result, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_joins_block(result, arm.body)
            }
            match default {
                Some(body) => collect_joins_block(result, body),
                None => (),
            }
        },
        Return(_) | Jump { target: _, args: _, ret_ty: _ } | Unreachable { ty: _ } => (),
    }
}

fn collect_joins_block(result: Vec[anf::JoinBind], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            Let(_) => (),
            Join(join) => {
                result.push(join);
                collect_joins_block(result, join.body)
            },
            JoinRec(joins) => {
                for join in joins {
                    collect_joins_block(result, join.body)
                }
            },
        }
    }
    collect_joins_term(result, value.term)
}

fn find_join(values: Vec[anf::JoinBind], name: string) -> Option[anf::JoinBind] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn same_target(lhs: Option[string], rhs: Option[string]) -> Option[string] {
    match lhs {
        Some(left) => match rhs {
            Some(right) => {
                if left == right {
                    Option::Some(left)
                } else {
                    Option::None
                }
            },
            None => Option::None,
        },
        None => Option::None,
    }
}

fn match_block_target(arms: Vec[anf::Arm], default: Option[anf::Block]) -> Option[string] {
    if arms.is_empty() {
        return match default {
            Some(body) => block_target(body),
            None => Option::None,
        }
    } else {};
    let expected = block_target(arms[0].body)?;
    for index in 1..arms.len() {
        match block_target(arms[index].body) {
            Some(value) => if value == expected {} else {
                return Option::None
            },
            None => return Option::None,
        }
    }
    match default {
        Some(body) => match block_target(body) {
            Some(value) => if value == expected {} else {
                return Option::None
            },
            None => return Option::None,
        },
        None => (),
    };
    Option::Some(expected)
}

fn term_target(value: anf::Term) -> Option[string] {
    match value {
        Jump { target, args: _, ret_ty: _ } => Option::Some(target),
        If { cond: _, then_, else_, ret_ty: _ } => {
            same_target(block_target(then_), block_target(else_))
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => match_block_target(arms, default),
        Return(_) | Unreachable { ty: _ } => Option::None,
    }
}

fn find_block_join(value: anf::Block, name: string) -> Option[anf::JoinBind] {
    let mut index = value.binds.len() - 1;
    while index >= 0 {
        let bind = value.binds[index];
        match bind {
            Join(join) => {
                if join.name == name {
                    return Option::Some(join)
                } else {
                    index = index - 1;
                }
            },
            Let(_) | JoinRec(_) => {
                index = index - 1;
            },
        }
    }
    Option::None
}

fn block_target_with_visited(value: anf::Block, visited: Vec[string]) -> Option[string] {
    match term_target(value.term) {
        Some(target) => {
            if visited.contains(target) {
                Option::None
            } else {
                match find_block_join(value, target) {
                    Some(join) => {
                        visited.push(target);
                        block_target_with_visited(join.body, visited)
                    },
                    None => Option::Some(target),
                }
            }
        },
        None => Option::None,
    }
}

fn block_target(value: anf::Block) -> Option[string] {
    block_target_with_visited(value, Vec::from_array([]))
}

fn blocks_reach_target(
    values: Vec[anf::Arm],
    target: string,
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    for arm in values {
        if block_reaches_target(arm.body, target, joins, visited) {
            return true
        } else {}
    }
    false
}

fn compile_jump_args(env: LowerEnv, value: anf::JoinBind, args: Vec[anf::Imm]) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::from_array([]);
    for index in 0..args.len() {
        if index < value.params.len() && value.params[index].0 != "_" {
            result.push(
                Stmt::Assign {
                    name: go_local_ident(value.params[index].0),
                    value: compile_imm_expected(env, args[index], value.params[index].1),
                },
            )
        } else {}
    }
    result
}

fn compile_branch_to_join(env: LowerEnv, value: anf::Block, target: string, join: anf::JoinBind) -> Block {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let pending: Vec[anf::JoinBind] = Vec::from_array([]);
    let loop_names: Vec[string] = Vec::from_array([]);
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: go_local_ident(param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    } else {}
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        match term_target(value.term) {
            Some(inner_target) => {
                if inner_target == target {
                    append_stmts(stmts, compile_term_to_join(env, value.term, target, join))
                } else {
                    match find_join(pending, inner_target) {
                        Some(inner_join) => {
                            append_stmts(
                                stmts,
                                compile_term_to_join(env, value.term, inner_target, inner_join),
                            );
                            append_stmts(
                                stmts,
                                compile_branch_to_join(env, inner_join.body, target, join).stmts,
                            )
                        },
                        None => append_stmts(
                            stmts,
                            compile_term_with_pending(env, value.term, pending),
                        ),
                    }
                }
            },
            None => append_stmts(stmts, compile_term_with_pending(env, value.term, pending)),
        }
    } else {};
    Block { stmts }
}

fn match_scrutinee_is_unit(value: anf::Imm) -> bool {
    match repr::resolve_type(anf::imm_type(value)) {
        Unit => true,
        _ => false,
    }
}

fn first_match_body(arms: Vec[anf::Arm], default: Option[anf::Block]) -> Option[anf::Block] {
    if !arms.is_empty() {
        Option::Some(arms[0].body)
    } else {
        default
    }
}

fn compile_match_leaf(
    env: LowerEnv,
    scrut: anf::Imm,
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::from_array([]);
    if match_scrutinee_is_unit(scrut) {
        match first_match_body(arms, default) {
            Some(body) => append_stmts(result, compile_block(env, body).stmts),
            None => append_stmts(result, non_exhaustive_block().stmts),
        }
    } else if match_uses_types(env, arms) {
        let cases: Vec[TypeSwitchCase] = Vec::from_array([]);
        for arm in arms {
            match arm_type(env, arm.lhs) {
                Some(ty) => cases.push(TypeSwitchCase { ty, body: compile_block(env, arm.body) }),
                None => (),
            }
        }
        let lowered_default = match default {
            Some(body) => Option::Some(compile_block(env, body)),
            None => Option::Some(non_exhaustive_block()),
        };
        result.push(
            Stmt::TypeSwitch {
                binding: Option::None,
                expr: compile_imm(env, scrut),
                cases,
                default: lowered_default,
            },
        )
    } else {
        let cases: Vec[SwitchCase] = Vec::from_array([]);
        for arm in arms {
            cases.push(
                SwitchCase { value: compile_imm(env, arm.lhs), body: compile_block(env, arm.body) },
            )
        }
        let lowered_default = match default {
            Some(body) => Option::Some(compile_block(env, body)),
            None => Option::Some(non_exhaustive_block()),
        };
        result.push(
            Stmt::Switch {
                expr: compile_match_scrutinee(env, scrut),
                cases,
                default: lowered_default,
            },
        )
    };
    result
}

fn arm_type(env: LowerEnv, value: anf::Imm) -> Option[Type] {
    match value {
        Tag { index: tag, ty: owner_ty } => variant_type(env.variants, owner_ty, tag),
        _ => Option::None,
    }
}

fn match_uses_types(env: LowerEnv, values: Vec[anf::Arm]) -> bool {
    for value in values {
        match arm_type(env, value.lhs) {
            Some(_) => return true,
            None => (),
        }
    }
    false
}

fn compile_match_scrutinee(env: LowerEnv, value: anf::Imm) -> Expr {
    match find_variant_info(env.variants, anf::imm_type(value), 0) {
        Some(info) => if info.compact {
            Expr::Field { expr: compile_imm(env, value), field_name: "_tag" }
        } else {
            compile_imm(env, value)
        },
        None => compile_imm(env, value),
    }
}

fn non_exhaustive_block() -> Block {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    stmts.push(Stmt::Panic { message: "non-exhaustive match" });
    Block { stmts }
}

fn compile_term_leaf(env: LowerEnv, value: anf::Term) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::from_array([]);
    match value {
        Return(value) => result.push(
            Stmt::Return {
                expr: Option::Some(compile_imm_expected(env, value, anf::imm_type(value))),
            },
        ),
        Jump { target, args, ret_ty: _ } => match find_join(env.joins, target) {
            Some(join) => {
                append_stmts(result, compile_jump_args(env, join, args));
                append_stmts(result, compile_block(env, join.body).stmts)
            },
            None => result.push(Stmt::Unreachable),
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_block(env, then_),
                else_: Option::Some(compile_block(env, else_)),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            append_stmts(result, compile_match_leaf(env, scrut, arms, default))
        },
        Unreachable { ty: _ } => result.push(Stmt::Unreachable),
    };
    result
}

fn compile_term_to_join(env: LowerEnv, value: anf::Term, target: string, join: anf::JoinBind) -> Vec[
    Stmt,
] {
    let result: Vec[Stmt] = Vec::from_array([]);
    match value {
        Jump { target: _, args, ret_ty: _ } => {
            append_stmts(result, compile_jump_args(env, join, args))
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_branch_to_join(env, then_, target, join),
                else_: Option::Some(compile_branch_to_join(env, else_, target, join)),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Some(body) => append_stmts(
                        result,
                        compile_branch_to_join(env, body, target, join).stmts,
                    ),
                    None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::from_array([]);
                for arm in arms {
                    match arm_type(env, arm.lhs) {
                        Some(ty) => cases.push(
                            TypeSwitchCase {
                                ty,
                                body: compile_branch_to_join(env, arm.body, target, join),
                            },
                        ),
                        None => (),
                    }
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(compile_branch_to_join(env, body, target, join)),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::TypeSwitch {
                        binding: Option::None,
                        expr: compile_imm(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            } else {
                let cases: Vec[SwitchCase] = Vec::from_array([]);
                for arm in arms {
                    cases.push(
                        SwitchCase {
                            value: compile_imm(env, arm.lhs),
                            body: compile_branch_to_join(env, arm.body, target, join),
                        },
                    )
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(compile_branch_to_join(env, body, target, join)),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::Switch {
                        expr: compile_match_scrutinee(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            }
        },
        _ => append_stmts(result, compile_term_leaf(env, value)),
    };
    result
}

fn compile_term_with_pending(env: LowerEnv, value: anf::Term, pending: Vec[anf::JoinBind]) -> Vec[
    Stmt,
] {
    match term_target(value) {
        Some(target) => match find_join(pending, target) {
            Some(join) => {
                let result: Vec[Stmt] = Vec::from_array([]);
                append_stmts(result, compile_term_to_join(env, value, target, join));
                append_stmts(result, compile_block(env, join.body).stmts);
                result
            },
            None => compile_term_leaf(env, value),
        },
        None => compile_term_leaf(env, value),
    }
}

fn loop_label(value: string) -> string {
    "Loop_" + go_local_ident(value)
}

fn fresh_loop_label_with_suffix(emitted: Vec[string], base: string, suffix: int) -> string {
    let candidate = if suffix == 1 {
        base
    } else {
        base + "__" + suffix.to_string()
    };
    if emitted.contains(candidate) {
        fresh_loop_label_with_suffix(emitted, base, suffix + 1)
    } else {
        emitted.push(candidate);
        candidate
    }
}

fn fresh_loop_label(env: LowerEnv, value: string) -> string {
    fresh_loop_label_with_suffix(env.emitted_loop_labels, loop_label(value), 1)
}

fn scoped_joins(parent: Vec[anf::JoinBind], value: anf::Block) -> Vec[anf::JoinBind] {
    let result: Vec[anf::JoinBind] = Vec::from_array([]);
    for join in parent {
        result.push(join)
    }
    for bind in value.binds {
        match bind {
            Join(join) => result.push(join),
            JoinRec(joins) => {
                for join in joins {
                    result.push(join)
                }
            },
            Let(_) => (),
        }
    }
    result
}

fn block_reaches_target(
    value: anf::Block,
    target: string,
    parent: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    let joins = scoped_joins(parent, value);
    term_reaches_target(value.term, target, joins, visited)
}

fn term_reaches_target(
    value: anf::Term,
    target: string,
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    match value {
        Jump { target: name, args, ret_ty: _ } => {
            if name == target && args.is_empty() {
                true
            } else if visited.contains(name) {
                false
            } else {
                match find_join(joins, name) {
                    Some(join) => {
                        visited.push(name);
                        block_reaches_target(join.body, target, joins, visited)
                    },
                    None => false,
                }
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            block_reaches_target(then_, target, joins, visited)
                || block_reaches_target(else_, target, joins, visited)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            blocks_reach_target(arms, target, joins, visited)
                || match default {
                    Some(body) => block_reaches_target(body, target, joins, visited),
                    None => false,
                }
        },
        Return(_) | Unreachable { ty: _ } => false,
    }
}

fn block_tail_target_through_joins(
    value: anf::Block,
    parent: Vec[anf::JoinBind],
    visited: Vec[string],
) -> Option[string] {
    let joins = scoped_joins(parent, value);
    term_tail_target_through_joins(value.term, joins, visited)
}

fn match_tail_target_through_joins(
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> Option[string] {
    if arms.is_empty() {
        return match default {
            Some(body) => block_tail_target_through_joins(body, joins, visited),
            None => Option::None,
        }
    } else {};
    let expected = block_tail_target_through_joins(arms[0].body, joins, visited)?;
    for index in 1..arms.len() {
        match block_tail_target_through_joins(arms[index].body, joins, visited) {
            Some(value) => if value == expected {} else {
                return Option::None
            },
            None => return Option::None,
        }
    }
    match default {
        Some(body) => match block_tail_target_through_joins(body, joins, visited) {
            Some(value) => if value == expected {} else {
                return Option::None
            },
            None => return Option::None,
        },
        None => (),
    };
    Option::Some(expected)
}

fn term_tail_target_through_joins(value: anf::Term, joins: Vec[anf::JoinBind], visited: Vec[string]) -> Option[
    string,
] {
    match value {
        Jump { target, args: _, ret_ty: _ } => {
            if visited.contains(target) {
                Option::None
            } else {
                match find_join(joins, target) {
                    Some(join) => match join.role {
                        anf::JoinRole::LoopExit => Option::Some(target),
                        anf::JoinRole::Return => Option::None,
                        anf::JoinRole::Continuation => {
                            visited.push(target);
                            let result = block_tail_target_through_joins(join.body, joins, visited);
                            let _ = visited.remove(visited.len() - 1);
                            result
                        },
                    },
                    None => Option::None,
                }
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            same_target(
                block_tail_target_through_joins(then_, joins, visited),
                block_tail_target_through_joins(else_, joins, visited),
            )
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            match_tail_target_through_joins(arms, default, joins, visited)
        },
        Return(_) | Unreachable { ty: _ } => Option::None,
    }
}

fn block_all_paths_reach_or_terminate(
    value: anf::Block,
    target: string,
    parent: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    let joins = scoped_joins(parent, value);
    term_all_paths_reach_or_terminate(value.term, target, joins, visited)
}

fn term_all_paths_reach_or_terminate(
    value: anf::Term,
    target: string,
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    match value {
        Jump { target: name, args: _, ret_ty: _ } => {
            if name == target {
                true
            } else if visited.contains(name) {
                false
            } else {
                match find_join(joins, name) {
                    Some(join) => {
                        visited.push(name);
                        let result = block_all_paths_reach_or_terminate(
                            join.body,
                            target,
                            joins,
                            visited,
                        );
                        let _ = visited.remove(visited.len() - 1);
                        result
                    },
                    None => true,
                }
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            block_all_paths_reach_or_terminate(then_, target, joins, visited)
                && block_all_paths_reach_or_terminate(else_, target, joins, visited)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                if !block_all_paths_reach_or_terminate(arm.body, target, joins, visited) {
                    return false
                } else {}
            }
            match default {
                Some(body) => {
                    block_all_paths_reach_or_terminate(body, target, joins, visited)
                },
                None => true,
            }
        },
        Return(_) | Unreachable { ty: _ } => true,
    }
}

fn all_paths_reach_or_terminate(value: anf::Block, target: string) -> bool {
    block_all_paths_reach_or_terminate(value, target, Vec::from_array([]), Vec::from_array([]))
}

enum LoopBranchTarget {
    Continue,
    Exit(string),
    Invalid,
}

fn loop_branch_target(body: anf::Block, loop_name: string, joins: Vec[anf::JoinBind]) -> LoopBranchTarget {
    if block_reaches_target(body, loop_name, joins, Vec::from_array([])) {
        LoopBranchTarget::Continue
    } else {
        match block_tail_target_through_joins(body, joins, Vec::from_array([])) {
            Some(target) => LoopBranchTarget::Exit(target),
            None => LoopBranchTarget::Invalid,
        }
    }
}

fn loop_exit_target(value: anf::Block, loop_name: string, parent: Vec[anf::JoinBind]) -> Option[
    string,
] {
    let joins = scoped_joins(parent, value);
    match value.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            let then_reaches = block_reaches_target(then_, loop_name, joins, Vec::from_array([]));
            let else_reaches = block_reaches_target(else_, loop_name, joins, Vec::from_array([]));
            if then_reaches && !else_reaches {
                block_tail_target_through_joins(else_, joins, Vec::from_array([]))
            } else if else_reaches && !then_reaches {
                block_tail_target_through_joins(then_, joins, Vec::from_array([]))
            } else {
                Option::None
            }
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            let targets: Vec[LoopBranchTarget] = Vec::from_array([]);
            for arm in arms {
                targets.push(loop_branch_target(arm.body, loop_name, joins))
            }
            match default {
                Some(body) => targets.push(loop_branch_target(body, loop_name, joins)),
                None => (),
            };
            let exits: Vec[string] = Vec::from_array([]);
            let continues: Vec[unit] = Vec::from_array([]);
            for target in targets {
                match target {
                    Continue => continues.push(()),
                    Exit(target) => exits.push(target),
                    Invalid => return Option::None,
                }
            }
            if continues.is_empty() || exits.is_empty() {
                return Option::None
            } else {};
            let target = exits[0];
            for value in exits {
                if value != target {
                    return Option::None
                } else {}
            }
            Option::Some(target)
        },
        _ => Option::None,
    }
}

fn find_loop_exit(value: anf::Block, loop_name: string, parent: Vec[anf::JoinBind]) -> Option[
    string,
] {
    let joins = scoped_joins(parent, value);
    match loop_exit_target(value, loop_name, joins) {
        Some(target) => Option::Some(target),
        None => {
            for bind in value.binds {
                match bind {
                    Join(dispatch) => if all_paths_reach_or_terminate(value, dispatch.name) {
                        match find_loop_exit(dispatch.body, loop_name, joins) {
                            Some(target) => return Option::Some(target),
                            None => (),
                        }
                    } else {},
                    _ => (),
                }
            }
            Option::None
        },
    }
}

fn compile_loop_branch_to_join(
    env: LowerEnv,
    value: anf::Block,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let pending: Vec[anf::JoinBind] = Vec::from_array([]);
    let loop_names: Vec[string] = Vec::from_array([]);
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: go_local_ident(param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    } else {}
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec_in_loop(env, values, loop_name, exit_name, label);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        match term_target(value.term) {
            Some(inner_target) => {
                if inner_target == target {
                    append_stmts(
                        stmts,
                        compile_loop_term_to_join(
                            env,
                            value.term,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    )
                } else {
                    match find_join(pending, inner_target) {
                        Some(inner_join) => {
                            append_stmts(
                                stmts,
                                compile_loop_term_to_join(
                                    env,
                                    value.term,
                                    inner_target,
                                    inner_join,
                                    loop_name,
                                    exit_name,
                                    label,
                                ),
                            );
                            append_stmts(
                                stmts,
                                compile_loop_branch_to_join(
                                    env,
                                    inner_join.body,
                                    target,
                                    join,
                                    loop_name,
                                    exit_name,
                                    label,
                                ).stmts,
                            )
                        },
                        None => append_stmts(
                            stmts,
                            compile_loop_term_with_pending(
                                env,
                                value.term,
                                pending,
                                loop_name,
                                exit_name,
                                label,
                            ),
                        ),
                    }
                }
            },
            None => append_stmts(
                stmts,
                compile_loop_term_with_pending(
                    env,
                    value.term,
                    pending,
                    loop_name,
                    exit_name,
                    label,
                ),
            ),
        }
    } else {};
    Block { stmts }
}

fn compile_loop_term_leaf(
    env: LowerEnv,
    value: anf::Term,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::from_array([]);
    match value {
        Jump { target, args, ret_ty: _ } => {
            if target == loop_name {
                result.push(Stmt::Continue)
            } else if target == exit_name {
                match find_join(env.joins, target) {
                    Some(join) => append_stmts(result, compile_jump_args(env, join, args)),
                    None => (),
                };
                result.push(Stmt::BreakLabel { label })
            } else {
                match find_join(env.joins, target) {
                    Some(join) => {
                        match value {
                            Jump { target: _, args, ret_ty: _ } => {
                                append_stmts(result, compile_jump_args(env, join, args))
                            },
                            _ => (),
                        };
                        append_stmts(
                            result,
                            compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                        )
                    },
                    None => append_stmts(result, compile_term_leaf(env, value)),
                }
            }
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_loop_block(env, then_, loop_name, exit_name, label),
                else_: Option::Some(compile_loop_block(env, else_, loop_name, exit_name, label)),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Some(body) => append_stmts(
                        result,
                        compile_loop_block(env, body, loop_name, exit_name, label).stmts,
                    ),
                    None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::from_array([]);
                for arm in arms {
                    match arm_type(env, arm.lhs) {
                        Some(ty) => cases.push(
                            TypeSwitchCase {
                                ty,
                                body: compile_loop_block(env, arm.body, loop_name, exit_name, label),
                            },
                        ),
                        None => (),
                    }
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_block(env, body, loop_name, exit_name, label),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::TypeSwitch {
                        binding: Option::None,
                        expr: compile_imm(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            } else {
                let cases: Vec[SwitchCase] = Vec::from_array([]);
                for arm in arms {
                    cases.push(
                        SwitchCase {
                            value: compile_imm(env, arm.lhs),
                            body: compile_loop_block(env, arm.body, loop_name, exit_name, label),
                        },
                    )
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_block(env, body, loop_name, exit_name, label),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::Switch {
                        expr: compile_match_scrutinee(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            }
        },
        _ => append_stmts(result, compile_term_leaf(env, value)),
    };
    result
}

fn compile_loop_term_to_join(
    env: LowerEnv,
    value: anf::Term,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::from_array([]);
    match value {
        Jump { target: _, args, ret_ty: _ } => {
            append_stmts(result, compile_jump_args(env, join, args))
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_loop_branch_to_join(
                    env,
                    then_,
                    target,
                    join,
                    loop_name,
                    exit_name,
                    label,
                ),
                else_: Option::Some(
                    compile_loop_branch_to_join(
                        env,
                        else_,
                        target,
                        join,
                        loop_name,
                        exit_name,
                        label,
                    ),
                ),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Some(body) => append_stmts(
                        result,
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ).stmts,
                    ),
                    None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::from_array([]);
                for arm in arms {
                    match arm_type(env, arm.lhs) {
                        Some(ty) => cases.push(
                            TypeSwitchCase {
                                ty,
                                body: compile_loop_branch_to_join(
                                    env,
                                    arm.body,
                                    target,
                                    join,
                                    loop_name,
                                    exit_name,
                                    label,
                                ),
                            },
                        ),
                        None => (),
                    }
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::TypeSwitch {
                        binding: Option::None,
                        expr: compile_imm(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            } else {
                let cases: Vec[SwitchCase] = Vec::from_array([]);
                for arm in arms {
                    cases.push(
                        SwitchCase {
                            value: compile_imm(env, arm.lhs),
                            body: compile_loop_branch_to_join(
                                env,
                                arm.body,
                                target,
                                join,
                                loop_name,
                                exit_name,
                                label,
                            ),
                        },
                    )
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::Switch {
                        expr: compile_match_scrutinee(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            }
        },
        _ => append_stmts(result, compile_loop_term_leaf(env, value, loop_name, exit_name, label)),
    };
    result
}

fn compile_loop_term_with_pending(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    match term_target(value) {
        Some(target) => match find_join(pending, target) {
            Some(join) => {
                let result: Vec[Stmt] = Vec::from_array([]);
                append_stmts(
                    result,
                    compile_loop_term_to_join(env, value, target, join, loop_name, exit_name, label),
                );
                append_stmts(
                    result,
                    compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                );
                result
            },
            None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
        },
        None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
    }
}

fn compile_loop_block(
    env: LowerEnv,
    value: anf::Block,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let pending: Vec[anf::JoinBind] = Vec::from_array([]);
    let loop_names: Vec[string] = Vec::from_array([]);
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: go_local_ident(param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    } else {}
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec_in_loop(env, values, loop_name, exit_name, label);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(
            stmts,
            compile_loop_term_with_pending(env, value.term, pending, loop_name, exit_name, label),
        )
    } else {};
    Block { stmts }
}

fn compile_joinrec_in_loop(
    env: LowerEnv,
    values: Vec[anf::JoinBind],
    outer_loop_name: string,
    outer_exit_name: string,
    outer_label: string,
) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let loop_names: Vec[string] = Vec::from_array([]);
    let single = values.len() == 1;
    for value in values {
        match find_loop_exit(value.body, value.name, env.joins) {
            Some(exit_name) => {
                let label = fresh_loop_label(env, value.name);
                let body = compile_loop_block(env, value.body, value.name, exit_name, label);
                stmts.push(loop_stmt(label, body));
                match find_join(env.joins, exit_name) {
                    Some(exit) => {
                        append_stmts(
                            stmts,
                            compile_loop_block(
                                env,
                                exit.body,
                                outer_loop_name,
                                outer_exit_name,
                                outer_label,
                            ).stmts,
                        )
                    },
                    None => (),
                };
                loop_names.push(value.name)
            },
            None => if single
                && block_reaches_target(
                    value.body,
                    value.name,
                    Vec::from_array([]),
                    Vec::from_array([]),
                ) {
                let label = fresh_loop_label(env, value.name);
                let body = compile_loop_block(env, value.body, value.name, "", label);
                stmts.push(loop_stmt(label, body));
                loop_names.push(value.name)
            } else if single
                && !block_reaches_target(
                    value.body,
                    value.name,
                    Vec::from_array([]),
                    Vec::from_array([]),
                ) {
                append_stmts(
                    stmts,
                    compile_loop_block(
                        env,
                        value.body,
                        outer_loop_name,
                        outer_exit_name,
                        outer_label,
                    ).stmts,
                );
                loop_names.push(value.name)
            } else {},
        }
    }
    JoinRecResult { stmts, loop_names }
}

fn block_contains_break_label(value: Block, label: string) -> bool {
    for stmt in value.stmts {
        if stmt_contains_break_label(stmt, label) {
            return true
        } else {}
    }
    false
}

fn stmt_contains_break_label(value: Stmt, label: string) -> bool {
    match value {
        BreakLabel { label: actual } => actual == label,
        If { cond: _, then_, else_ } => {
            block_contains_break_label(then_, label)
                || match else_ {
                    Some(body) => block_contains_break_label(body, label),
                    None => false,
                }
        },
        Loop { body } | LabeledLoop { label: _, body } => {
            block_contains_break_label(body, label)
        },
        Switch { expr: _, cases, default } => {
            for case in cases {
                if block_contains_break_label(case.body, label) {
                    return true
                } else {}
            }
            match default {
                Some(body) => block_contains_break_label(body, label),
                None => false,
            }
        },
        TypeSwitch { binding: _, expr: _, cases, default } => {
            for case in cases {
                if block_contains_break_label(case.body, label) {
                    return true
                } else {}
            }
            match default {
                Some(body) => block_contains_break_label(body, label),
                None => false,
            }
        },
        _ => false,
    }
}

fn loop_stmt(label: string, body: Block) -> Stmt {
    if block_contains_break_label(body, label) {
        Stmt::LabeledLoop { label, body }
    } else {
        Stmt::Loop { body }
    }
}

fn compile_joinrec(env: LowerEnv, values: Vec[anf::JoinBind]) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let loop_names: Vec[string] = Vec::from_array([]);
    let single = values.len() == 1;
    for value in values {
        match find_loop_exit(value.body, value.name, env.joins) {
            Some(exit_name) => {
                let label = fresh_loop_label(env, value.name);
                let body = compile_loop_block(env, value.body, value.name, exit_name, label);
                stmts.push(loop_stmt(label, body));
                match find_join(env.joins, exit_name) {
                    Some(exit) => {
                        append_stmts(stmts, compile_block(env, exit.body).stmts)
                    },
                    None => (),
                };
                loop_names.push(value.name)
            },
            None => if single
                && block_reaches_target(
                    value.body,
                    value.name,
                    Vec::from_array([]),
                    Vec::from_array([]),
                ) {
                let label = fresh_loop_label(env, value.name);
                let body = compile_loop_block(env, value.body, value.name, "", label);
                stmts.push(loop_stmt(label, body));
                loop_names.push(value.name)
            } else if single
                && !block_reaches_target(
                    value.body,
                    value.name,
                    Vec::from_array([]),
                    Vec::from_array([]),
                ) {
                append_stmts(stmts, compile_block(env, value.body).stmts);
                loop_names.push(value.name)
            } else {},
        }
    }
    JoinRecResult { stmts, loop_names }
}

fn compile_block(env: LowerEnv, value: anf::Block) -> Block {
    let stmts: Vec[Stmt] = Vec::from_array([]);
    let pending: Vec[anf::JoinBind] = Vec::from_array([]);
    let loop_names: Vec[string] = Vec::from_array([]);
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: go_local_ident(param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    } else {}
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(stmts, compile_term_with_pending(env, value.term, pending))
    } else {};
    Block { stmts }
}

struct CollectedTypes {
    values: Vec[repr::Type],
    buckets: HashMap[string, Vec[repr::Type]],
}

fn new_collected_types() -> CollectedTypes {
    CollectedTypes { values: Vec::from_array([]), buckets: HashMap::from_array([]) }
}

fn add_collected_type(result: CollectedTypes, value: repr::Type) -> unit {
    let key = encode_type(value);
    match result.buckets[key] {
        Some(values) => {
            for present in values {
                if repr::types_equal(present, value) {
                    return ()
                } else {}
            }
            values.push(value)
        },
        None => {
            result.buckets[key] = Vec::from_array([value]);
        },
    };
    result.values.push(value)
}

fn collect_type(result: CollectedTypes, value: repr::Type) -> unit {
    match repr::resolve_type(value) {
        Tuple { items: values } => {
            add_collected_type(result, value);
            for inner in values {
                collect_type(result, inner)
            }
        },
        Named { name: _ } | ClosureEnvironment { name: _ } => add_collected_type(result, value),
        Dyn { trait_name: _, .. } => add_collected_type(result, value),
        Array { len: _, elem } => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        Slice { elem } => collect_type(result, elem),
        VecType { elem } => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        RefType { elem } => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        Channel { elem } => collect_type(result, elem),
        HashMap { key, value } => {
            add_collected_type(result, repr::Type::HashMap { key, value });
            collect_type(result, key);
            collect_type(result, value);
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_type(result, param)
            }
            collect_type(result, ret_ty)
        },
        _ => (),
    }
}

fn collect_imm_type(result: CollectedTypes, value: anf::Imm) -> unit {
    collect_type(result, anf::imm_type(value))
}

fn collect_runtime_imm(
    result: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    go_foreign: Vec[GoForeignSpec],
    value: anf::Imm,
) -> unit {
    match value {
        Callable { callable: Runtime(key), ty: _ } => {
            if !result.contains(key) {
                result.push(key)
            } else {}
        },
        Callable { callable: Intrinsic(key), ty: function_ty } => {
            if !intrinsics.contains(key) {
                intrinsics.push(key)
            } else {};
            if key == "compiler.missing" {
                match repr::resolve_type(function_ty) {
                    Func { params: _, ret_ty } => add_collected_type(missing_types, ret_ty),
                    _ => (),
                }
            } else {}
        },
        Callable { callable: GoForeign { import_path, symbol }, ty } => {
            let name = go_foreign_wrapper_name(import_path, symbol, ty);
            let mut found = false;
            for value in go_foreign {
                if go_foreign_wrapper_name(value.import_path, value.symbol, value.ty) == name {
                    found = true;
                    break
                } else {}
            }
            if !found {
                go_foreign.push(GoForeignSpec { import_path, symbol, ty })
            } else {}
        },
        _ => (),
    }
}

fn collect_runtime_value(
    result: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    go_foreign: Vec[GoForeignSpec],
    value: anf::Value,
) -> unit {
    match value {
        Imm(value) => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, value)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => {
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, go_foreign, arg)
            }
        },
        ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary { op: _, expr, ty: _ } | Cast {
            expr,
            ty: _,
        } | Go { closure: expr, ty: _ } | PackClosure { environment: expr, apply: _, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, expr)
        },
        Binary { op: _, lhs, rhs, ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, lhs);
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, rhs)
        },
        Assign { name: _, value: expr, target_ty: _, ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, expr)
        },
        Call { func, args, ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, func);
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, go_foreign, arg)
            }
        },
        ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, receiver);
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, go_foreign, arg)
            }
        },
    }
}

fn collect_runtime_block(
    result: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    go_foreign: Vec[GoForeignSpec],
    value: anf::Block,
) -> unit {
    for bind in value.binds {
        match bind {
            Let(value) => {
                collect_runtime_value(result, missing_types, intrinsics, go_foreign, value.value)
            },
            Join(value) => {
                collect_runtime_block(result, missing_types, intrinsics, go_foreign, value.body)
            },
            JoinRec(values) => {
                for value in values {
                    collect_runtime_block(result, missing_types, intrinsics, go_foreign, value.body)
                }
            },
        }
    }
    match value.term {
        Return(value) => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, value)
        },
        Jump { target: _, args, ret_ty: _ } => {
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, go_foreign, arg)
            }
        },
        If { cond, then_, else_, ret_ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, cond);
            collect_runtime_block(result, missing_types, intrinsics, go_foreign, then_);
            collect_runtime_block(result, missing_types, intrinsics, go_foreign, else_)
        },
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            collect_runtime_imm(result, missing_types, intrinsics, go_foreign, scrut);
            for arm in arms {
                collect_runtime_imm(result, missing_types, intrinsics, go_foreign, arm.lhs);
                collect_runtime_block(result, missing_types, intrinsics, go_foreign, arm.body)
            }
            match default {
                Some(body) => {
                    collect_runtime_block(result, missing_types, intrinsics, go_foreign, body)
                },
                None => (),
            }
        },
        Unreachable { ty: _ } => (),
    }
}

fn collect_value_type(result: CollectedTypes, value: anf::Value) -> unit {
    collect_type(result, anf::value_type(value));
    match value {
        Imm(value) => collect_imm_type(result, value),
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => {
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary { op: _, expr, ty: _ } | Cast {
            expr,
            ty: _,
        } | Go { closure: expr, ty: _ } | PackClosure { environment: expr, apply: _, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => collect_imm_type(result, expr),
        Binary { op: _, lhs, rhs, ty: _ } => {
            collect_imm_type(result, lhs);
            collect_imm_type(result, rhs)
        },
        Assign { name: _, value: expr, target_ty, ty: _ } => {
            collect_imm_type(result, expr);
            collect_type(result, target_ty)
        },
        Call { func, args, ty: _ } => {
            collect_imm_type(result, func);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            collect_type(result, for_ty);
            collect_imm_type(result, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_imm_type(result, receiver);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
    }
}

fn collect_block_types(result: CollectedTypes, value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            Let(value) => {
                collect_type(result, value.ty);
                collect_value_type(result, value.value)
            },
            Join(value) => {
                for param in value.params {
                    collect_type(result, param.1)
                }
                collect_type(result, value.ret_ty);
                collect_block_types(result, value.body)
            },
            JoinRec(values) => {
                for value in values {
                    for param in value.params {
                        collect_type(result, param.1)
                    }
                    collect_type(result, value.ret_ty);
                    collect_block_types(result, value.body)
                }
            },
        }
    }
    match value.term {
        Return(value) => collect_imm_type(result, value),
        Jump { target: _, args, ret_ty: ty } => {
            collect_type(result, ty);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        If { cond, then_, else_, ret_ty: ty } => {
            collect_imm_type(result, cond);
            collect_type(result, ty);
            collect_block_types(result, then_);
            collect_block_types(result, else_)
        },
        Match { scrutinee: scrut, arms, default, ret_ty: ty } => {
            collect_imm_type(result, scrut);
            collect_type(result, ty);
            for arm in arms {
                collect_imm_type(result, arm.lhs);
                collect_block_types(result, arm.body)
            }
            match default {
                Some(body) => collect_block_types(result, body),
                None => (),
            }
        },
        Unreachable { ty } => collect_type(result, ty),
    }
}

fn collect_type_definition_fields(
    result: CollectedTypes,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
) -> unit {
    let _ = instances;
    for definition in structs {
        for field in definition.fields {
            collect_type(result, field.1)
        }
    }
    for definition in enums {
        for variant in definition.variants {
            for field in enum_field_types(variant.fields) {
                collect_type(result, field)
            }
        }
    }
}

fn runtime_struct(value: repr::Type) -> StructDef {
    match repr::resolve_type(value) {
        Tuple { items: values } => {
            let fields: Vec[(string, Type)] = Vec::from_array([]);
            for index in 0..values.len() {
                fields.push(("_" + index.to_string(), lower_type(values[index])))
            }
            StructDef { name: type_name(value), fields }
        },
        RefType { elem } => {
            let fields: Vec[(string, Type)] = Vec::from_array([]);
            fields.push(("value", lower_type(elem)));
            StructDef {
                name: go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x"),
                fields,
            }
        },
        VecType { elem } => {
            let fields: Vec[(string, Type)] = Vec::from_array([]);
            fields.push(("items", Type::Slice { elem: lower_type(elem) }));
            StructDef {
                name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                fields,
            }
        },
        _ => StructDef { name: "Error", fields: Vec::from_array([]) },
    }
}

fn add_dyn_coercion(result: Vec[DynCoercion], trait_name: string, for_ty: repr::Type) -> unit {
    for value in result {
        if value.trait_name == trait_name && encode_type(value.for_ty) == encode_type(for_ty) {
            return
        } else {}
    }
    result.push(DynCoercion { trait_name, for_ty })
}

fn collect_dyn_value(result: Vec[DynCoercion], value: anf::Value) -> unit {
    match value {
        ToDyn { trait_name, for_ty, expr: _, ty: _ } => {
            add_dyn_coercion(result, trait_name, for_ty)
        },
        _ => (),
    }
}

fn collect_dyn_block(result: Vec[DynCoercion], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            Let(value) => collect_dyn_value(result, value.value),
            Join(value) => collect_dyn_block(result, value.body),
            JoinRec(values) => {
                for value in values {
                    collect_dyn_block(result, value.body)
                }
            },
        }
    }
    match value.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_dyn_block(result, then_);
            collect_dyn_block(result, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_dyn_block(result, arm.body)
            }
            match default {
                Some(body) => collect_dyn_block(result, body),
                None => (),
            }
        },
        _ => (),
    }
}

fn compile_function(
    builtin: tast::BuiltinContract,
    value: anf::Function,
    variants: VariantInfos,
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    functions: Vec[anf::Function],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
) -> Function {
    let joins: Vec[anf::JoinBind] = Vec::from_array([]);
    collect_joins_block(joins, value.body);
    let params: Vec[(string, Type)] = Vec::from_array([]);
    for param in value.params {
        params.push((go_local_ident(param.0), lower_type(param.1)))
    }
    let env = LowerEnv {
        builtin,
        joins,
        emitted_loop_labels: Vec::from_array([]),
        variants,
        structs,
        instances,
        functions,
        function_names,
        dyn_helper_names,
    };
    Function {
        name: env_function_name(env, value.name),
        params,
        ret_ty: Option::Some(lower_type(value.ret_ty)),
        body: eliminate_dead_vars(compile_block(env, value.body)),
    }
}

fn compile_functions(
    builtin: tast::BuiltinContract,
    values: Vec[anf::Function],
    variants: VariantInfos,
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
) -> Vec[Function] {
    let work: Vec[(int, anf::Function)] = Vec::with_capacity(values.len());
    let compiled: Vec[Option[Function]] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        work.push((index, values[index]));
        compiled.push(Option::None)
    }
    let completed: Result[unit, Vec[task::IndexedError[unit]]] = task::for_each_concurrent(
        8,
        work,
        |_: task::CancelToken, item: (int, anf::Function)| {
            compiled[item.0] = Option::Some(
                compile_function(
                    builtin,
                    item.1,
                    variants,
                    structs,
                    instances,
                    values,
                    function_names,
                    dyn_helper_names,
                ),
            );
            Result::Ok(())
        },
    );
    match completed {
        Ok(()) => (),
        Err(_) => (),
    };
    let result: Vec[Function] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        match compiled[index] {
            Some(value) => result.push(value),
            None => result.push(
                compile_function(
                    builtin,
                    values[index],
                    variants,
                    structs,
                    instances,
                    values,
                    function_names,
                    dyn_helper_names,
                ),
            ),
        }
    }
    result
}

fn test_main_function(
    function_names: FunctionNames,
    test_cases: Vec[(string, string, Vec[(string, string)])],
    test_fail_key: string,
) -> Function {
    let cases: Vec[SwitchCase] = Vec::from_array([]);
    for test_case in test_cases {
        let function_name = match mapped_function_name(function_names, test_case.1) {
            Some(name) => name,
            None => function_name(test_case.1),
        };
        let body_stmts: Vec[Stmt] = Vec::from_array([]);
        let arguments: Vec[Expr] = Vec::from_array([]);
        for argument in test_case.2 {
            arguments.push(
                if argument.0 == "string" {
                    Expr::String { value: argument.1 }
                } else {
                    Expr::Bool { value: argument.1 == "true" }
                },
            )
        }
        body_stmts.push(
            Stmt::Expr {
                expr: Expr::Call { func: Expr::Var { name: function_name }, args: arguments },
            },
        );
        cases.push(
            SwitchCase {
                value: Expr::String { value: test_case.0 },
                body: Block { stmts: body_stmts },
            },
        )
    }
    let default_stmts: Vec[Stmt] = Vec::from_array([]);
    let fail_args: Vec[Expr] = Vec::from_array([]);
    fail_args.push(Expr::String { value: "unknown test id" });
    default_stmts.push(
        Stmt::Expr {
            expr: Expr::Call {
                func: Expr::Var { name: runtime_hook_name(test_fail_key) },
                args: fail_args,
            },
        },
    );
    let stmts: Vec[Stmt] = Vec::from_array([]);
    stmts.push(
        Stmt::Switch {
            expr: Expr::Index {
                base: Expr::Var { name: "_goml_os.Args" },
                index: Expr::Int { value: "1" },
            },
            cases,
            default: Option::Some(Block { stmts: default_stmts }),
        },
    );
    Function {
        name: "main",
        params: Vec::from_array([]),
        ret_ty: Option::None,
        body: Block { stmts },
    }
}

fn lower_with_test_cases(
    value: anf::File,
    testing: bool,
    test_cases: Vec[(string, string, Vec[(string, string)])],
) -> Result[File, string] {
    let builtin = tast::builtin_contract()?;
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let constants = value.constants;
    let statics = value.statics;
    let function_names = build_function_names(value.functions, structs, enums, type_instances);
    let items: Vec[Item] = Vec::from_array([]);
    let types = new_collected_types();
    let runtime_hook_keys: Vec[string] = Vec::from_array([]);
    let intrinsics: Vec[string] = Vec::from_array([]);
    let go_foreign: Vec[GoForeignSpec] = Vec::from_array([]);
    let missing_types = new_collected_types();
    let coercions: Vec[DynCoercion] = Vec::from_array([]);
    let variants = new_variant_infos();
    for function in value.functions {
        for param in function.params {
            collect_type(types, param.1)
        }
        collect_type(types, function.ret_ty);
        collect_block_types(types, function.body);
        collect_runtime_block(
            runtime_hook_keys,
            missing_types,
            intrinsics,
            go_foreign,
            function.body,
        );
        collect_dyn_block(coercions, function.body)
    }
    for value in statics {
        collect_type(types, value.ty)
    }
    let runtime_hooks = resolve_runtime_hooks(runtime_hook_keys)?;
    for instance in type_instances {
        if backend_names_match(instance.base_name, builtin.static_cell.name)
            && instance.args.len() == 1 {
            if !intrinsics.contains("once_cell.new") {
                intrinsics.push("once_cell.new")
            } else {};
            if !intrinsics.contains("once_cell.get_or_init") {
                intrinsics.push("once_cell.get_or_init")
            } else {}
        } else {}
    }
    if testing {
        runtime_hooks.push(
            resources::RuntimeHook::Standard(resources::StandardRuntimeHook::TestingFail),
        )
    } else {};
    let dyn_helper_names = build_dyn_helper_names(builtin, coercions, value.functions);
    collect_type_definition_fields(types, enums, structs, type_instances);
    emit_go_foreign_import_items(items, go_foreign);
    emit_runtime_hook_items(items, runtime_hooks, intrinsics);
    emit_go_foreign_wrapper_items(items, go_foreign);
    emit_missing_base_item(items, missing_types.values);
    emit_builtin_runtime_items(
        builtin,
        items,
        types.values,
        missing_types.values,
        type_instances,
        enums,
        structs,
        function_names,
    );
    emit_user_type_items(builtin, items, variants, enums, structs, type_instances, function_names);
    emit_constants(items, constants, variants);
    emit_statics(items, statics);
    emit_dyn_runtime_items(
        builtin,
        items,
        types.values,
        coercions,
        enums,
        type_instances,
        value.functions,
        dyn_helper_names,
    );
    for function in compile_functions(
        builtin,
        value.functions,
        variants,
        structs,
        type_instances,
        function_names,
        dyn_helper_names,
    ) {
        items.push(Item::Function(function))
    }
    if testing {
        let test_fail = resources::runtime_abi_by_hook(
            resources::RuntimeHook::Standard(resources::StandardRuntimeHook::TestingFail),
        );
        match test_fail {
            Some(spec) => {
                items.push(Item::Function(test_main_function(function_names, test_cases, spec.key)))
            },
            None => return Result::Err("missing testing runtime hook ABI"),
        }
    } else {
        let stmts: Vec[Stmt] = Vec::from_array([]);
        let entry_name = match mapped_function_name(function_names, "main") {
            Some(name) => name,
            None => "main0",
        };
        stmts.push(
            Stmt::Expr {
                expr: Expr::Call { func: Expr::Var { name: entry_name }, args: Vec::from_array([]) },
            },
        );
        items.push(
            Item::Function(
                Function {
                    name: "main",
                    params: Vec::from_array([]),
                    ret_ty: Option::None,
                    body: Block { stmts },
                },
            ),
        )
    };
    Result::Ok(prune_functions(File { items }))
}

fn validate_anf_term(value: anf::Term) -> Result[unit, string] {
    match value {
        If { cond: _, then_, else_, ret_ty: _ } => {
            validate_anf_block(then_)?;
            validate_anf_block(else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                validate_anf_block(arm.body)?
            }
            match default {
                Some(body) => validate_anf_block(body),
                None => Result::Ok(()),
            }
        },
        Return(_) | Jump { target: _, args: _, ret_ty: _ } | Unreachable { ty: _ } => {
            Result::Ok(())
        },
    }
}

fn validate_anf_block(value: anf::Block) -> Result[unit, string] {
    for bind in value.binds {
        match bind {
            Let(_) => (),
            Join(join) => validate_anf_block(join.body)?,
            JoinRec(joins) => {
                if joins.len() != 1 {
                    return Result::Err(
                        "Go backend requires each recursive join group to contain exactly one join",
                    )
                } else {};
                validate_anf_block(joins[0].body)?
            },
        }
    }
    validate_anf_term(value.term)
}

fn resolve_runtime_hooks(keys: Vec[string]) -> Result[Vec[resources::RuntimeHook], string] {
    let hooks: Vec[resources::RuntimeHook] = Vec::from_array([]);
    for key in keys {
        match resources::runtime_abi_by_key(key) {
            Some(spec) => hooks.push(spec.hook),
            None => return Result::Err("unknown runtime hook " + key),
        }
    }
    Result::Ok(hooks)
}

fn validate_anf(value: anf::File) -> Result[unit, string] {
    anf::verify(value)?;
    let runtime_hooks: Vec[string] = Vec::from_array([]);
    let intrinsics: Vec[string] = Vec::from_array([]);
    let go_foreign: Vec[GoForeignSpec] = Vec::from_array([]);
    let missing_types = new_collected_types();
    for function in value.functions {
        match validate_anf_block(function.body) {
            Ok(_) => (),
            Err(error) => return Result::Err("in function " + function.name + ": " + error),
        };
        collect_runtime_block(runtime_hooks, missing_types, intrinsics, go_foreign, function.body)
    }
    resolve_runtime_hooks(runtime_hooks)?;
    for key in intrinsics {
        if resources::intrinsic_abi_by_key(key).is_none() {
            return Result::Err("unknown intrinsic " + key)
        } else {}
    }
    Result::Ok(())
}

pub fn lower(value: anf::File) -> Result[File, string] {
    validate_anf(value)?;
    lower_with_test_cases(value, false, Vec::from_array([]))
}

pub fn lower_tests(value: anf::File, test_cases: Vec[(string, string, Vec[(string, string)])]) -> Result[
    File,
    string,
] {
    validate_anf(value)?;
    lower_with_test_cases(value, true, test_cases)
}
