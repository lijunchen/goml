    Vec::[
        "unit_to_string",
        "bool_to_string",
        "string_len",
        "string_get",
        "string_byte_get",
        "string_byte_slice",
        "string_to_bytes",
        "string_from_utf8",
        "string_concat",
        "char_to_string",
        "char_from_uint32",
        "int_to_string",
        "int8_to_string",
        "int16_to_string",
        "int32_to_string",
        "int64_to_string",
        "uint_to_string",
        "uint8_to_string",
        "uint16_to_string",
        "uint32_to_string",
        "uint64_to_string",
        "float32_to_string",
        "float64_to_string",
        "string_parse_float32",
        "string_parse_float64",
        "int_hash",
