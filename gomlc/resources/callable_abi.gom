package resources;

pub struct CallableAbiSpec {
    pub key: string,
    pub source_name: string,
    pub artifact_id: string,
    pub legacy_ids: Vec[string],
}

fn callable_abi(key: string, source_name: string, artifact_id: string, legacy_ids: Vec[string]) -> CallableAbiSpec {
    CallableAbiSpec { key, source_name, artifact_id, legacy_ids }
}

