package resources;

pub struct CallableAbiSpec {
    pub key: string,
    pub source_name: string,
    pub artifact_id: string,
    pub legacy_ids: Vec[string],
}

fn callable_abi(key: string, source_name: string, artifact_id: string, legacy_ids: Vec[string]) -> CallableAbiSpec {
    CallableAbiSpec { key, source_name, artifact_id, legacy_ids }
}

pub fn intrinsic_abi_specs() -> Vec[CallableAbiSpec] {
    Vec::from_array(
        [
            callable_abi("array.get", "array_get", "array_get", Vec::from_array([])),
            callable_abi("array.set", "array_set", "array_set", Vec::from_array([])),
            callable_abi("ref.new", "ref", "ref_new", Vec::from_array([])),
            callable_abi("ref.get", "ref_get", "ref_get", Vec::from_array([])),
            callable_abi("ref.set", "ref_set", "ref_set", Vec::from_array([])),
            callable_abi("ref.ptr_eq", "ptr_eq", "ref_ptr_eq", Vec::from_array([])),
            callable_abi("ref.ptr_hash", "ptr_hash", "ref_ptr_hash", Vec::from_array([])),
            callable_abi("vec.new", "vec_new", "vec_new", Vec::from_array([])),
            callable_abi(
                "vec.with_capacity",
                "vec_with_capacity",
                "vec_with_capacity",
                Vec::from_array([]),
            ),
            callable_abi("vec.push", "vec_push", "vec_push", Vec::from_array([])),
            callable_abi("vec.get", "vec_get", "vec_get", Vec::from_array([])),
            callable_abi("vec.set", "vec_set", "vec_set", Vec::from_array([])),
            callable_abi("vec.len", "vec_len", "vec_len", Vec::from_array([])),
            callable_abi("vec.capacity", "vec_capacity", "vec_capacity", Vec::from_array([])),
            callable_abi("vec.reserve", "vec_reserve", "vec_reserve", Vec::from_array([])),
            callable_abi("vec.truncate", "vec_truncate", "vec_truncate", Vec::from_array([])),
            callable_abi("vec.from_array", "vec_from_array", "vec_from_array", Vec::from_array([])),
            callable_abi("once_cell.new", "once_cell_new", "once_cell_new", Vec::from_array([])),
            callable_abi(
                "once_cell.get_or_init",
                "once_cell_get_or_init",
                "once_cell_get_or_init",
                Vec::from_array([]),
            ),
            callable_abi("slice.new", "slice", "slice_new", Vec::from_array([])),
            callable_abi("slice.get", "slice_get", "slice_get", Vec::from_array([])),
            callable_abi("slice.len", "slice_len", "slice_len", Vec::from_array([])),
            callable_abi("slice.sub", "slice_sub", "slice_sub", Vec::from_array([])),
            callable_abi(
                "hashmap.new",
                "hashmap_new",
                "hash_map_new",
                Vec::from_array(["hashmap_new"]),
            ),
            callable_abi(
                "hashmap.get",
                "hashmap_get",
                "hash_map_get",
                Vec::from_array(["hashmap_get"]),
            ),
            callable_abi(
                "hashmap.set",
                "hashmap_set",
                "hash_map_set",
                Vec::from_array(["hashmap_set"]),
            ),
            callable_abi(
                "hashmap.remove",
                "hashmap_remove",
                "hash_map_remove",
                Vec::from_array(["hashmap_remove"]),
            ),
            callable_abi(
                "hashmap.len",
                "hashmap_len",
                "hash_map_len",
                Vec::from_array(["hashmap_len"]),
            ),
            callable_abi(
                "hashmap.contains",
                "hashmap_contains",
                "hash_map_contains",
                Vec::from_array(["hashmap_contains"]),
            ),
            callable_abi(
                "hashmap.entries",
                "hashmap_entries",
                "hash_map_entries",
                Vec::from_array(["hashmap_entries"]),
            ),
            callable_abi(
                "hashmap.from_array",
                "hashmap_from_array",
                "hash_map_from_array",
                Vec::from_array([]),
            ),
            callable_abi("channel.new", "channel_new", "channel_new", Vec::from_array([])),
            callable_abi("channel.send", "channel_send", "channel_send", Vec::from_array([])),
            callable_abi("channel.recv", "channel_recv", "channel_recv", Vec::from_array([])),
            callable_abi(
                "channel.send_cancel",
                "channel_send_cancel",
                "channel_send_cancel",
                Vec::from_array([]),
            ),
            callable_abi(
                "channel.recv_cancel",
                "channel_recv_cancel",
                "channel_recv_cancel",
                Vec::from_array([]),
            ),
            callable_abi("channel.close", "channel_close", "channel_close", Vec::from_array([])),
            callable_abi("compiler.missing", "missing", "missing", Vec::from_array([])),
        ],
    )
}

fn callable_abi_by_key(values: Vec[CallableAbiSpec], key: string) -> Option[CallableAbiSpec] {
    for value in values {
        if value.key == key {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn callable_abi_by_id(values: Vec[CallableAbiSpec], id: string) -> Option[CallableAbiSpec] {
    for value in values {
        if value.artifact_id == id {
            return Option::Some(value)
        } else {
            for legacy_id in value.legacy_ids {
                if legacy_id == id {
                    return Option::Some(value)
                } else {}
            }
        }
    }
    Option::None
}

pub fn intrinsic_abi_by_key(key: string) -> Option[CallableAbiSpec] {
    callable_abi_by_key(intrinsic_abi_specs(), key)
}

pub fn intrinsic_abi_by_id(id: string) -> Option[CallableAbiSpec] {
    callable_abi_by_id(intrinsic_abi_specs(), id)
}
