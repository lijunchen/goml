        "uint32_hash",
        "float32_hash",
        "float64_hash",
        "string_hash",
        "string_print",
        "string_println",
    ]
}

fn abi_by_key(values: Vec[CallableAbiSpec], key: string) -> Option[CallableAbiSpec] {
    for value in values {
        if value.key == key {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn abi_by_id(values: Vec[CallableAbiSpec], id: string) -> Option[CallableAbiSpec] {
    for value in values {
        if value.artifact_id == id {
            return Option::Some(value)
        } else {
            for legacy_id in value.legacy_ids {
                if legacy_id == id {
                    return Option::Some(value)
                } else {}
            }
        }
    }
    Option::None
}

pub fn intrinsic_abi_by_key(key: string) -> Option[CallableAbiSpec] {
    abi_by_key(intrinsic_abi_specs(), key)
}

pub fn intrinsic_abi_by_id(id: string) -> Option[CallableAbiSpec] {
    abi_by_id(intrinsic_abi_specs(), id)
}

pub fn runtime_abi_by_key(key: string) -> Option[CallableAbiSpec] {
    if key.starts_with("core.") {
        let id = key.byte_slice(5, key.byte_len());
        for allowed in core_runtime_keys() {
            if allowed == id {
                let source_name = if id == "string_get" {
                    "string_get_raw"
                } else if id == "string_byte_slice" {
                    "string_byte_slice_raw"
                } else if id == "string_from_utf8" {
                    "string_from_utf8_raw"
                } else if id == "char_to_string" {
                    "char_to_string_raw"
                } else if id == "char_from_uint32" {
                    "char_from_uint32_raw"
                } else {
                    id
                };
                return Option::Some(callable_abi(key, source_name, id, Vec::[]))
            } else {}
        }
        Option::None
    } else {
        abi_by_key(standard_runtime_abi_specs(), key)
    }
}

pub fn runtime_abi_by_id(id: string) -> Option[CallableAbiSpec] {
    for allowed in core_runtime_keys() {
        if allowed == id {
            return runtime_abi_by_key("core." + id)
        } else {}
    }
    abi_by_id(standard_runtime_abi_specs(), id)
}
