pub struct Source {
    pub path: string,
    pub source: string,
}

pub struct StandardPackageSpec {
    pub name: string,
    pub declared_name: string,
    pub parent: string,
    pub source_paths: Vec[string],
    pub dependencies: Vec[string],
    pub link_dependencies: Vec[string],
}

fn standard_package(
    name: string,
    declared_name: string,
    parent: string,
    source_paths: Vec[string],
    dependencies: Vec[string],
    link_dependencies: Vec[string],
) -> StandardPackageSpec {
    StandardPackageSpec {
        name,
        declared_name,
        parent,
        source_paths,
        dependencies,
        link_dependencies,
    }
}

