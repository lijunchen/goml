pub fn standard_package_spec(package_name: string) -> Option[StandardPackageSpec] {
    for spec in standard_package_specs() {
        if spec.name == package_name {
            return Option::Some(spec)
        } else {
            ()
        }
    };
    Option::None
}

pub fn standard_package_children(package_name: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for spec in standard_package_specs() {
        if package_name == "std" && spec.name == "std::io" {
            result.push("internal")
        } else {
            ()
        };
        if spec.parent == package_name {
            result.push(spec.declared_name)
        } else {
            ()
        }
    };
    result
}

fn add_standard_package_closure(result: Vec[string], package_name: string) -> unit {
    for value in result {
        if value == package_name {
            return
        } else {
            ()
        }
    };
    match standard_package_spec(package_name) {
        Some(spec) => {
            for dependency in spec.dependencies {
                add_standard_package_closure(result, dependency)
            };
            result.push(package_name)
        },
        None => (),
    }
}

pub fn standard_package_closure(package_names: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for package_name in package_names {
        add_standard_package_closure(result, package_name)
    };
    result
}

fn add_standard_link_closure(result: Vec[string], package_name: string) -> unit {
    for value in result {
        if value == package_name {
            return
        } else {
            ()
        }
    };
    match standard_package_spec(package_name) {
        Some(spec) => {
            for dependency in spec.link_dependencies {
                add_standard_link_closure(result, dependency)
            };
            result.push(package_name)
        },
        None => (),
    }
}

pub fn standard_package_link_closure(package_names: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for package_name in package_names {
        add_standard_link_closure(result, package_name)
    };
    result
}

pub fn toolchain_lib_dir() -> Result[string, string] {
    let executable = match env::current_exe() {
        Ok(value) => value,
        Err(error) => return Result::Err("could not locate compiler executable: " + error),
    };
    let binary_dir = match path::parent(executable) {
        Some(value) => value,
        None => return Result::Err("compiler executable has no parent directory: " + executable),
    };
    let prefix = match path::parent(binary_dir) {
        Some(value) => value,
        None => return Result::Err("compiler bin directory has no parent directory: " + binary_dir),
    };
    Result::Ok(path::join(prefix, "lib"))
}

fn read_sources(relative_paths: Vec[string]) -> Result[Vec[Source], string] {
    let lib_dir = toolchain_lib_dir()?;
    let result: Vec[Source] = Vec::[];
    for relative_path in relative_paths {
        let source_path = path::join(lib_dir, relative_path);
        match fs::read_file(source_path) {
            Ok(source) => result.push(Source { path: source_path, source }),
            Err(error) => return Result::Err(
                "could not read compiler resource " + source_path + ": " + error,
            ),
        }
    };
    Result::Ok(result)
}

pub fn builtin_sources() -> Result[Vec[Source], string] {
    read_sources(Vec::["builtin_contract.gom", "builtin_prelude.gom"])
}

pub fn standard_sources(package_name: string) -> Result[Option[Vec[Source]], string] {
    match standard_package_spec(package_name) {
        Some(value) => match read_sources(value.source_paths) {
            Ok(sources) => Result::Ok(Option::Some(sources)),
            Err(error) => Result::Err(error),
        },
        None => Result::Ok(Option::None),
    }
}
