package hir;

use gomlc::ast;
use gomlc::cst;
use gomlc::ctfe;
use gomlc::ctir;
use gomlc::derive as derive_runtime;
use std::collections;
use std::text;

fn dummy_span() -> ast::Span {
    ast::span(0, 0)
}

fn empty_attributes() -> Vec[ast::Attribute] {
    Vec::[]
}

fn empty_strings() -> Vec[string] {
    Vec::[]
}

fn empty_bounds() -> Vec[(string, Vec[ast::TraitRef])] {
    Vec::[]
}

fn empty_predicates() -> Vec[ast::Predicate] {
    Vec::[]
}

fn empty_associated_types() -> Vec[(string, ast::TypeExpr)] {
    Vec::[]
}

fn one_segment_path(name: string) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::[];
    segments.push(ast::PathSegment { ident: name, span: dummy_span() });
    ast::Path { segments }
}

fn two_segment_path(first: string, second: string) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::[];
    segments.push(ast::PathSegment { ident: first, span: dummy_span() });
    segments.push(ast::PathSegment { ident: second, span: dummy_span() });
    ast::Path { segments }
}

fn trait_ref(name: string) -> ast::TraitRef {
    ast::TraitRef { path: one_segment_path(name), args: Vec::[] }
}

fn type_for_name(name: string) -> ast::TypeExpr {
    ast::TypeExpr::Con { path: one_segment_path(name) }
}

fn type_for_generics(name: string, generics: Vec[string]) -> ast::TypeExpr {
    if generics.is_empty() {
        type_for_name(name)
    } else {
        let args: Vec[ast::TypeExpr] = Vec::[];
        for generic in generics {
            args.push(type_for_name(generic))
        }
        ast::TypeExpr::App { ty: type_for_name(name), args }
    }
}

fn path_key(value: ast::Path) -> string {
    let mut result = "";
    for segment in value.segments {
        if result == "" {
            result = segment.ident;
        } else {
            result = result + "::" + segment.ident;
        }
    }
    result
}

fn type_key(value: ast::TypeExpr) -> string {
    match value {
        Unit => "unit",
        Bool => "bool",
        Int => "int",
        Int8 => "int8",
        Int16 => "int16",
        Int32 => "int32",
        Int64 => "int64",
        Uint => "uint",
        Uint8 => "uint8",
        Uint16 => "uint16",
        Uint32 => "uint32",
        Uint64 => "uint64",
        Float32 => "float32",
        Float64 => "float64",
        String => "string",
        Char => "char",
        Tuple { items } => {
            let mut result = "(";
            for item in items {
                result = result + type_key(item) + ",";
            }
            result + ")"
        },
        Con { path } => path_key(path),
        Dyn { bounds } => {
            let mut result = "dyn ";
            let mut bound_index = 0;
            for bound in bounds {
                if bound_index > 0 {
                    result = result + " + ";
                } else {};
                result = result + path_key(bound.trait_path);
                if !bound.args.is_empty() || !bound.associated_types.is_empty() {
                    result = result + "[";
                    let mut arg_index = 0;
                    for arg in bound.args {
                        if arg_index > 0 {
                            result = result + ",";
                        } else {};
                        result = result + type_key(arg);
                        arg_index = arg_index + 1;
                    }
                    for binding in bound.associated_types {
                        if arg_index > 0 {
                            result = result + ",";
                        } else {};
                        result = result + binding.0 + "=" + type_key(binding.1);
                        arg_index = arg_index + 1;
                    }
                    result = result + "]";
                } else {};
                bound_index = bound_index + 1;
            }
            result
        },
        App { ty, args } => {
            let mut result = type_key(ty) + "[";
            for arg in args {
                result = result + type_key(arg) + ",";
            }
            result + "]"
        },
        Array { len, elem } => "[" + type_key(elem) + ";" + len + "]",
        Func { params, ret_ty } => {
            let mut result = "fn(";
            for param in params {
                result = result + type_key(param) + ",";
            }
            result + ")->" + type_key(ret_ty)
        },
    }
}

fn type_mentions_generics(value: ast::TypeExpr, generics: Vec[string]) -> bool {
    match value {
        Con { path } => if path.segments.len() == 1 {
            collections::contains(generics, path.segments[0].ident)
        } else {
            false
        },
        Tuple { items } => {
            for item in items {
                if type_mentions_generics(item, generics) {
                    return true
                } else {}
            }
            false
        },
        App { ty, args } => {
            if type_mentions_generics(ty, generics) {
                true
            } else {
                for arg in args {
                    if type_mentions_generics(arg, generics) {
                        return true
                    } else {}
                }
                false
            }
        },
        Array { len: _, elem } => type_mentions_generics(elem, generics),
        Func { params, ret_ty } => {
            for param in params {
                if type_mentions_generics(param, generics) {
                    return true
                } else {}
            }
            type_mentions_generics(ret_ty, generics)
        },
        _ => false,
    }
}

fn derive_predicates(field_types: Vec[ast::TypeExpr], generics: Vec[string], trait_name: string) -> Vec[
    ast::Predicate,
] {
    let result: Vec[ast::Predicate] = Vec::[];
    let seen: Vec[string] = Vec::[];
    for ty in field_types {
        let key = type_key(ty);
        if type_mentions_generics(ty, generics) && !collections::contains(seen, key) {
            seen.push(key);
            result.push(ast::Predicate::Trait { ty, trait_ref: trait_ref(trait_name) })
        } else {}
    }
    result
}

fn derives(attrs: Vec[ast::Attribute], name: string) -> bool {
    for attr in attrs {
        if attr.name == "derive" {
            for arg in attr.args {
                match arg {
                    ast::AttributeArg::Ident(target) => if target == name {
                        return true
                    } else {},
                    ast::AttributeArg::Path(_) | ast::AttributeArg::String(_) => (),
                }
            }
        } else {}
    }
    false
}

fn supported_derive(value: string) -> bool {
    value == "ToString" || value == "Eq" || value == "Hash"
}

fn validate_derive_attributes(attrs: Vec[ast::Attribute], diagnostics: Vec[cst::Diagnostic]) -> unit {
    for attr in attrs {
        if attr.name == "derive" {
            for arg in attr.args {
                match arg {
                    ast::AttributeArg::Ident(_) | ast::AttributeArg::Path(_) => (),
                    ast::AttributeArg::String(_) => diagnostics.push(
                        cst::diagnostic(
                            "derive target must be a path",
                            attr.span.start,
                            attr.span.end,
                        ),
                    ),
                }
            }
        } else {}
    }
}

fn validate_file_derives(value: ast::File, diagnostics: Vec[cst::Diagnostic]) -> unit {
    for item in value.items {
        match item {
            StructDef(definition) => validate_derive_attributes(definition.attrs, diagnostics),
            EnumDef(definition) => validate_derive_attributes(definition.attrs, diagnostics),
            _ => (),
        }
    }
}

fn var_expr(name: string) -> ast::Expr {
    ast::Expr::Path {
        path: one_segment_path(name),
        owner_type_args: Vec::[],
        member_type_args: Vec::[],
        span: dummy_span(),
    }
}

fn string_expr(value: string) -> ast::Expr {
    ast::Expr::String { value, span: dummy_span() }
}

fn bool_expr(value: bool) -> ast::Expr {
    ast::Expr::Bool { value, span: dummy_span() }
}

fn uint64_expr(value: string) -> ast::Expr {
    ast::Expr::Int { value, span: dummy_span() }
}

fn field_expr(value: ast::Expr, field: string) -> ast::Expr {
    ast::Expr::Field {
        expr: value,
        field_name: field,
        method_type_args: Vec::[],
        span: dummy_span(),
    }
}

fn call_expr(func: ast::Expr, args: Vec[ast::Expr]) -> ast::Expr {
    ast::Expr::Call { func, args, span: dummy_span() }
}

fn trait_call(trait_name: string, method_name: string, args: Vec[ast::Expr]) -> ast::Expr {
    call_expr(
        ast::Expr::Path {
            path: two_segment_path(trait_name, method_name),
            owner_type_args: Vec::[],
            member_type_args: Vec::[],
            span: dummy_span(),
        },
        args,
    )
}

fn call_to_string(value: ast::Expr, ty: ast::TypeExpr) -> ast::Expr {
    match ty {
        String => value,
        _ => call_expr(field_expr(value, "to_string"), Vec::[]),
    }
}

fn concat_parts(parts: Vec[ast::Expr]) -> ast::Expr {
    if parts.is_empty() {
        string_expr("")
    } else {
        let mut result = parts[0];
        for index in 1..parts.len() {
            result = ast::Expr::Binary {
                op: ast::BinaryOp::Add,
                lhs: result,
                rhs: parts[index],
                span: dummy_span(),
            };
        }
        result
    }
}

fn let_stmt(pat: ast::Pat, annotation: Option[ast::TypeExpr], value: ast::Expr) -> ast::Stmt {
    ast::Stmt::Let {
        is_mut: false,
        pat,
        annotation,
        value,
        else_branch: Option::None,
        span: dummy_span(),
    }
}

fn block_expr(stmts: Vec[ast::Stmt], tail: ast::Expr) -> ast::Expr {
    ast::Expr::Block {
        block: ast::Block { stmts, tail: Option::Some(tail), span: dummy_span() },
        span: dummy_span(),
    }
}

fn expr_body(value: ast::Expr) -> ast::Block {
    match value {
        Block { block, span: _ } => block,
        _ => ast::Block { stmts: Vec::[], tail: Option::Some(value), span: dummy_span() },
    }
}

fn make_method(
    name: string,
    params: Vec[(string, ast::TypeExpr)],
    ret_ty: ast::TypeExpr,
    body: ast::Expr,
) -> ast::Function {
    let param_type_spans: Vec[ast::Span] = Vec::[];
    for _ in params {
        param_type_spans.push(dummy_span())
    }
    ast::Function {
        attrs: empty_attributes(),
        visibility: ast::Visibility::Private,
        name,
        generics: empty_strings(),
        generic_bounds: empty_bounds(),
        predicates: empty_predicates(),
        params,
        param_type_spans,
        ret_ty: Option::Some(ret_ty),
        ret_ty_span: Option::Some(dummy_span()),
        body: expr_body(body),
    }
}

fn make_impl(
    trait_name: string,
    target_name: string,
    generics: Vec[string],
    field_types: Vec[ast::TypeExpr],
    method: ast::Function,
) -> ast::ImplBlock {
    let methods: Vec[ast::Function] = Vec::[];
    methods.push(method);
    ast::ImplBlock {
        attrs: empty_attributes(),
        generics,
        generic_bounds: empty_bounds(),
        predicates: derive_predicates(field_types, generics, trait_name),
        associated_types: empty_associated_types(),
        trait_ref: Option::Some(trait_ref(trait_name)),
        for_type: type_for_generics(target_name, generics),
        for_type_span: dummy_span(),
        methods,
    }
}

fn struct_field_types(value: ast::StructDef) -> Vec[ast::TypeExpr] {
    let result: Vec[ast::TypeExpr] = Vec::[];
    for field in value.fields {
        result.push(field.1)
    }
    result
}

fn enum_payload_types(value: ast::EnumDef) -> Vec[ast::TypeExpr] {
    let result: Vec[ast::TypeExpr] = Vec::[];
    for variant in value.variants {
        for ty in enum_field_types(variant.fields) {
            result.push(ty)
        }
    }
    result
}

fn struct_to_string_body(value: ast::StructDef) -> ast::Expr {
    if value.fields.is_empty() {
        string_expr(value.name + " {}")
    } else {
        let parts: Vec[ast::Expr] = Vec::[];
        parts.push(string_expr(value.name + " { "));
        let fields: Vec[(string, ast::Pat)] = Vec::[];
        let mut index = 0;
        for field in value.fields {
            parts.push(string_expr(field.0 + ": "));
            parts.push(call_to_string(var_expr(field.0), field.1));
            if index + 1 != value.fields.len() {
                parts.push(string_expr(", "))
            } else {};
            fields.push(
                (field.0, ast::Pat::Var { name: field.0, is_mut: false, span: dummy_span() }),
            );
            index = index + 1;
        }
        parts.push(string_expr(" }"));
        let stmts: Vec[ast::Stmt] = Vec::[];
        stmts.push(
            let_stmt(
                ast::Pat::Struct {
                    name: one_segment_path(value.name),
                    fields,
                    has_rest: false,
                    span: dummy_span(),
                },
                Option::None,
                var_expr("self"),
            ),
        );
        block_expr(stmts, concat_parts(parts))
    }
}

fn enum_to_string_body(value: ast::EnumDef) -> ast::Expr {
    let arms: Vec[ast::Arm] = Vec::[];
    for variant in value.variants {
        let fields = enum_field_types(variant.fields);
        let bindings: Vec[string] = Vec::[];
        for index in 0..fields.len() {
            bindings.push("__field" + index.to_string())
        }
        let parts: Vec[ast::Expr] = Vec::[];
        match variant.fields {
            Unit => {
                parts.push(string_expr(value.name + "::" + variant.name))
            },
            Tuple(_) => {
                parts.push(string_expr(value.name + "::" + variant.name + "("));
                for index in 0..fields.len() {
                    if index > 0 {
                        parts.push(string_expr(", "))
                    } else {};
                    parts.push(call_to_string(var_expr(bindings[index]), fields[index]))
                }
                parts.push(string_expr(")"))
            },
            Struct(named) => {
                parts.push(string_expr(value.name + "::" + variant.name + " { "));
                for index in 0..named.len() {
                    if index > 0 {
                        parts.push(string_expr(", "))
                    } else {};
                    parts.push(string_expr(named[index].0 + ": "));
                    parts.push(call_to_string(var_expr(bindings[index]), named[index].1))
                }
                parts.push(string_expr(" }"))
            },
        };
        arms.push(
            ast::Arm {
                pat: enum_variant_pat(
                    two_segment_path(value.name, variant.name),
                    variant.fields,
                    bindings,
                ),
                guard: Option::None,
                body: concat_parts(parts),
            },
        )
    }
    ast::Expr::Match { expr: var_expr("self"), arms, span: dummy_span() }
}

fn struct_eq_body(value: ast::StructDef) -> ast::Expr {
    let mut result = bool_expr(true);
    for field in value.fields {
        let args: Vec[ast::Expr] = Vec::[];
        args.push(field_expr(var_expr("self"), field.0));
        args.push(field_expr(var_expr("other"), field.0));
        result = ast::Expr::Binary {
            op: ast::BinaryOp::And,
            lhs: result,
            rhs: trait_call("Eq", "eq", args),
            span: dummy_span(),
        };
    }
    result
}

fn variant_bindings(prefix: string, variant: int, count: int) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for index in 0..count {
        result.push(prefix + variant.to_string() + "_" + index.to_string())
    }
    result
}

fn constr_pat(path: ast::Path, bindings: Vec[string]) -> ast::Pat {
    let args: Vec[ast::Pat] = Vec::[];
    for binding in bindings {
        args.push(ast::Pat::Var { name: binding, is_mut: false, span: dummy_span() })
    }
    ast::Pat::Constr { constructor: path, args, span: dummy_span() }
}

fn enum_field_types(fields: ast::EnumVariantFields) -> Vec[ast::TypeExpr] {
    match fields {
        Unit => Vec::[],
        Tuple(types) => types,
        Struct(fields) => {
            let types: Vec[ast::TypeExpr] = Vec::[];
            for field in fields {
                types.push(field.1)
            }
            types
        },
    }
}

fn enum_variant_pat(path: ast::Path, fields: ast::EnumVariantFields, bindings: Vec[string]) -> ast::Pat {
    match fields {
        Struct(fields) => {
            let patterns: Vec[(string, ast::Pat)] = Vec::[];
            for index in 0..fields.len() {
                patterns.push(
                    (
                        fields[index].0,
                        ast::Pat::Var { name: bindings[index], is_mut: false, span: dummy_span() },
                    ),
                )
            }
            ast::Pat::Struct { name: path, fields: patterns, has_rest: false, span: dummy_span() }
        },
        _ => constr_pat(path, bindings),
    }
}

fn enum_eq_body(value: ast::EnumDef) -> ast::Expr {
    let tuple_items: Vec[ast::Expr] = Vec::[];
    tuple_items.push(var_expr("self"));
    tuple_items.push(var_expr("other"));
    let arms: Vec[ast::Arm] = Vec::[];
    let mut variant_index = 0;
    for variant in value.variants {
        let field_count = enum_field_types(variant.fields).len();
        let left = variant_bindings("__l", variant_index, field_count);
        let right = variant_bindings("__r", variant_index, field_count);
        let tuple_pats: Vec[ast::Pat] = Vec::[];
        tuple_pats.push(
            enum_variant_pat(two_segment_path(value.name, variant.name), variant.fields, left),
        );
        tuple_pats.push(
            enum_variant_pat(two_segment_path(value.name, variant.name), variant.fields, right),
        );
        let mut body = bool_expr(true);
        for index in 0..left.len() {
            let args: Vec[ast::Expr] = Vec::[];
            args.push(var_expr(left[index]));
            args.push(var_expr(right[index]));
            body = ast::Expr::Binary {
                op: ast::BinaryOp::And,
                lhs: body,
                rhs: trait_call("Eq", "eq", args),
                span: dummy_span(),
            };
        }
        arms.push(
            ast::Arm {
                pat: ast::Pat::Tuple { items: tuple_pats, span: dummy_span() },
                guard: Option::None,
                body,
            },
        );
        variant_index = variant_index + 1;
    }
    arms.push(
        ast::Arm {
            pat: ast::Pat::Wild { span: dummy_span() },
            guard: Option::None,
            body: bool_expr(false),
        },
    );
    ast::Expr::Match {
        expr: ast::Expr::Tuple { items: tuple_items, span: dummy_span() },
        arms,
        span: dummy_span(),
    }
}

fn hash_step(value: ast::Expr) -> ast::Expr {
    let hash_args: Vec[ast::Expr] = Vec::[];
    hash_args.push(value);
    ast::Expr::Binary {
        op: ast::BinaryOp::Add,
        lhs: ast::Expr::Binary {
            op: ast::BinaryOp::Mul,
            lhs: var_expr("h"),
            rhs: uint64_expr("1099511628211"),
            span: dummy_span(),
        },
        rhs: trait_call("Hash", "hash", hash_args),
        span: dummy_span(),
    }
}

fn h_binding(annotation: Option[ast::TypeExpr], value: ast::Expr) -> ast::Stmt {
    let_stmt(ast::Pat::Var { name: "h", is_mut: false, span: dummy_span() }, annotation, value)
}

fn struct_hash_body(value: ast::StructDef) -> ast::Expr {
    let stmts: Vec[ast::Stmt] = Vec::[];
    stmts.push(h_binding(Option::Some(ast::TypeExpr::Uint64), uint64_expr("14695981039346656037")));
    for field in value.fields {
        stmts.push(h_binding(Option::None, hash_step(field_expr(var_expr("self"), field.0))))
    }
    block_expr(stmts, var_expr("h"))
}

fn enum_hash_body(value: ast::EnumDef) -> ast::Expr {
    let arms: Vec[ast::Arm] = Vec::[];
    let mut variant_index = 0;
    for variant in value.variants {
        let bindings: Vec[string] = Vec::[];
        for field_index in 0..enum_field_types(variant.fields).len() {
            bindings.push("__field" + variant_index.to_string() + "_" + field_index.to_string())
        }
        let stmts: Vec[ast::Stmt] = Vec::[];
        stmts.push(
            h_binding(
                Option::Some(ast::TypeExpr::Uint64),
                ast::Expr::Binary {
                    op: ast::BinaryOp::Add,
                    lhs: uint64_expr("14695981039346656037"),
                    rhs: uint64_expr((variant_index + 1).to_string()),
                    span: dummy_span(),
                },
            ),
        );
        for binding in bindings {
            stmts.push(h_binding(Option::None, hash_step(var_expr(binding))))
        }
        arms.push(
            ast::Arm {
                pat: enum_variant_pat(
                    two_segment_path(value.name, variant.name),
                    variant.fields,
                    bindings,
                ),
                guard: Option::None,
                body: block_expr(stmts, var_expr("h")),
            },
        );
        variant_index = variant_index + 1;
    }
    ast::Expr::Match { expr: var_expr("self"), arms, span: dummy_span() }
}

fn one_param(name: string, ty: ast::TypeExpr) -> Vec[(string, ast::TypeExpr)] {
    let result: Vec[(string, ast::TypeExpr)] = Vec::[];
    result.push((name, ty));
    result
}

fn two_params(
    first_name: string,
    first_ty: ast::TypeExpr,
    second_name: string,
    second_ty: ast::TypeExpr,
) -> Vec[(string, ast::TypeExpr)] {
    let result: Vec[(string, ast::TypeExpr)] = Vec::[];
    result.push((first_name, first_ty));
    result.push((second_name, second_ty));
    result
}

fn derive_struct_to_string(value: ast::StructDef) -> ast::ImplBlock {
    let target = type_for_generics(value.name, value.generics);
    make_impl(
        "ToString",
        value.name,
        value.generics,
        struct_field_types(value),
        make_method(
            "to_string",
            one_param("self", target),
            ast::TypeExpr::String,
            struct_to_string_body(value),
        ),
    )
}

fn derive_enum_to_string(value: ast::EnumDef) -> ast::ImplBlock {
    let target = type_for_generics(value.name, value.generics);
    make_impl(
        "ToString",
        value.name,
        value.generics,
        enum_payload_types(value),
        make_method(
            "to_string",
            one_param("self", target),
            ast::TypeExpr::String,
            enum_to_string_body(value),
        ),
    )
}

fn derive_struct_eq(value: ast::StructDef) -> ast::ImplBlock {
    let target = type_for_generics(value.name, value.generics);
    make_impl(
        "Eq",
        value.name,
        value.generics,
        struct_field_types(value),
        make_method(
            "eq",
            two_params("self", target, "other", target),
            ast::TypeExpr::Bool,
            struct_eq_body(value),
        ),
    )
}

fn derive_enum_eq(value: ast::EnumDef) -> ast::ImplBlock {
    let target = type_for_generics(value.name, value.generics);
    make_impl(
        "Eq",
        value.name,
        value.generics,
        enum_payload_types(value),
        make_method(
            "eq",
            two_params("self", target, "other", target),
            ast::TypeExpr::Bool,
            enum_eq_body(value),
        ),
    )
}

fn derive_struct_hash(value: ast::StructDef) -> ast::ImplBlock {
    let target = type_for_generics(value.name, value.generics);
    make_impl(
        "Hash",
        value.name,
        value.generics,
        struct_field_types(value),
        make_method(
            "hash",
            one_param("self", target),
            ast::TypeExpr::Uint64,
            struct_hash_body(value),
        ),
    )
}

fn derive_enum_hash(value: ast::EnumDef) -> ast::ImplBlock {
    let target = type_for_generics(value.name, value.generics);
    make_impl(
        "Hash",
        value.name,
        value.generics,
        enum_payload_types(value),
        make_method("hash", one_param("self", target), ast::TypeExpr::Uint64, enum_hash_body(value)),
    )
}

fn derived_struct_impls(value: ast::StructDef) -> Vec[ast::ImplBlock] {
    let result: Vec[ast::ImplBlock] = Vec::[];
    if derives(value.attrs, "ToString") {
        result.push(derive_struct_to_string(value))
    } else {};
    if derives(value.attrs, "Eq") {
        result.push(derive_struct_eq(value))
    } else {};
    if derives(value.attrs, "Hash") {
        result.push(derive_struct_hash(value))
    } else {};
    result
}

fn derived_enum_impls(value: ast::EnumDef) -> Vec[ast::ImplBlock] {
    let result: Vec[ast::ImplBlock] = Vec::[];
    if derives(value.attrs, "ToString") {
        result.push(derive_enum_to_string(value))
    } else {};
    if derives(value.attrs, "Eq") {
        result.push(derive_enum_eq(value))
    } else {};
    if derives(value.attrs, "Hash") {
        result.push(derive_enum_hash(value))
    } else {};
    result
}

fn trait_default_name(trait_name: string, method_name: string) -> string {
    "trait_default#" + trait_name + "#" + method_name
}

fn trait_default_ref(value: ast::TraitDef) -> ast::TraitRef {
    let args: Vec[ast::TypeExpr] = Vec::[];
    for generic in value.generics {
        args.push(type_for_name(generic))
    }
    ast::TraitRef { path: one_segment_path(value.name), args }
}

fn trait_default_function(
    trait_def: ast::TraitDef,
    method: ast::TraitMethodSignature,
    body: ast::Block,
) -> ast::Function {
    let generics = copy_strings(trait_def.generics);
    generics.push("Self");
    for generic in method.generics {
        generics.push(generic)
    }
    let generic_bounds: Vec[(string, Vec[ast::TraitRef])] = Vec::[];
    for bound in trait_def.generic_bounds {
        generic_bounds.push(bound)
    }
    let self_bounds: Vec[ast::TraitRef] = Vec::[];
    self_bounds.push(trait_default_ref(trait_def));
    generic_bounds.push(("Self", self_bounds));
    for bound in method.generic_bounds {
        generic_bounds.push(bound)
    }
    let predicates: Vec[ast::Predicate] = Vec::[];
    for predicate in trait_def.predicates {
        predicates.push(predicate)
    }
    for predicate in method.predicates {
        predicates.push(predicate)
    }
    let param_type_spans: Vec[ast::Span] = Vec::[];
    for _ in method.params {
        param_type_spans.push(dummy_span())
    }
    ast::Function {
        attrs: empty_attributes(),
        visibility: ast::Visibility::Private,
        name: trait_default_name(trait_def.name, method.name),
        generics,
        generic_bounds,
        predicates,
        params: method.params,
        param_type_spans,
        ret_ty: Option::Some(method.ret_ty),
        ret_ty_span: Option::Some(dummy_span()),
        body,
    }
}

fn trait_default_functions(value: ast::TraitDef) -> Vec[ast::Function] {
    let result: Vec[ast::Function] = Vec::[];
    for method in value.method_sigs {
        match method.body {
            Some(body) => result.push(trait_default_function(value, method, body)),
            None => (),
        }
    }
    result
}

pub enum BuiltinDeriveMode {
    CompilerFallback,
    SourceHandlers,
}

pub struct DeriveEnvironment {
    pub builtin: Option[ctir::CtModule],
    pub dependencies: Vec[ctir::CtModule],
    pub builtin_mode: BuiltinDeriveMode,
}

fn compiler_builtin_derive_fallback(value: BuiltinDeriveMode) -> bool {
    match value {
        BuiltinDeriveMode::CompilerFallback => true,
        BuiltinDeriveMode::SourceHandlers => false,
    }
}

struct ImportedDerive {
    local_name: string,
    module: ctir::CtModule,
    entry: ctir::CtDeriveEntry,
}

enum ResolvedDerive {
    BuiltinFallback(string),
    Handler {
        module: ctir::CtModule,
        entry: ctir::CtDeriveEntry,
    },
}

fn environment_modules(value: DeriveEnvironment) -> Vec[ctir::CtModule] {
    let result: Vec[ctir::CtModule] = Vec::[];
    match value.builtin {
        Some(module) => result.push(module),
        None => (),
    };
    for module in value.dependencies {
        result.push(module)
    }
    result
}

fn derive_entry_export_name(value: ctir::CtDeriveEntry) -> string {
    match value.export_name {
        Some(name) => name,
        None => {
            let segments = text::split(value.name, "::");
            if segments.is_empty() {
                value.name
            } else {
                segments[segments.len() - 1]
            }
        },
    }
}

fn module_derive_exports(module: ctir::CtModule, name: string) -> Vec[ctir::CtDeriveEntry] {
    let result: Vec[ctir::CtDeriveEntry] = Vec::[];
    for entry in module.derive_entries {
        if entry.public && derive_entry_export_name(entry) == name {
            result.push(entry)
        } else {}
    }
    result
}

fn package_alias_target(file: ast::File, alias: string) -> Option[string] {
    for entry in prospective_use_aliases(file) {
        if entry.alias == alias {
            return Option::Some(join_segments(entry.target))
        } else {}
    }
    Option::None
}

fn resolve_package_derive(
    environment: DeriveEnvironment,
    package_name: string,
    export_name: string,
    display_name: string,
) -> Result[(ctir::CtModule, ctir::CtDeriveEntry), string] {
    let matches: Vec[(ctir::CtModule, ctir::CtDeriveEntry)] = Vec::[];
    for module in environment_modules(environment) {
        if module.package_name == package_name {
            for entry in module_derive_exports(module, export_name) {
                matches.push((module, entry))
            }
        } else {}
    }
    if matches.is_empty() {
        Result::Err(
            "package `" + package_name + "` does not export comptime derive `" + export_name + "`",
        )
    } else if matches.len() > 1 {
        Result::Err("ambiguous derive target `" + display_name + "`")
    } else {
        Result::Ok(matches[0])
    }
}

fn resolve_qualified_derive(file: ast::File, environment: DeriveEnvironment, target: string) -> Result[
    (ctir::CtModule, ctir::CtDeriveEntry),
    string,
] {
    let segments = text::split(target, "::");
    if segments.len() != 2 {
        return Result::Err(
            "custom derive target `" + target + "` must use an imported package alias",
        )
    } else {};
    let package_name = match package_alias_target(file, segments[0]) {
        Some(value) => value,
        None => return Result::Err(
            "derive target package `" + segments[0] + "` is not imported in this file",
        ),
    };
    resolve_package_derive(environment, package_name, segments[1], target)
}

fn module_imported_derives(
    environment: DeriveEnvironment,
    package_name: string,
    export_name: string,
    local_name: string,
) -> Vec[ImportedDerive] {
    let result: Vec[ImportedDerive] = Vec::[];
    for module in environment_modules(environment) {
        if module.package_name == package_name {
            for entry in module_derive_exports(module, export_name) {
                result.push(ImportedDerive { local_name, module, entry })
            }
        } else {}
    }
    result
}

fn append_imported_derives(
    result: Vec[ImportedDerive],
    environment: DeriveEnvironment,
    package_name: string,
    export_name: string,
    local_name: string,
) -> unit {
    for value in module_imported_derives(environment, package_name, export_name, local_name) {
        result.push(value)
    }
}

fn derive_imports(file: ast::File, environment: DeriveEnvironment) -> Vec[ImportedDerive] {
    let result: Vec[ImportedDerive] = Vec::[];
    let aliases = prospective_use_aliases(file);
    for use_decl in file.uses {
        let target = path_segments(use_decl.path);
        if !use_decl.items.is_empty() {
            let base = match expand_use_alias(aliases, target) {
                Some(value) => value,
                None => target,
            };
            let package_name = join_segments(base);
            for item in use_decl.items {
                append_imported_derives(
                    result,
                    environment,
                    package_name,
                    item.name,
                    match item.alias {
                        Some(value) => value,
                        None => item.name,
                    },
                )
            }
        } else {
            match expand_use_alias(aliases, target) {
                Some(expanded) => if expanded.len() > 1 {
                    let package_segments: Vec[string] = Vec::[];
                    for index in 0..expanded.len() - 1 {
                        package_segments.push(expanded[index])
                    }
                    let export_name = expanded[expanded.len() - 1];
                    append_imported_derives(
                        result,
                        environment,
                        join_segments(package_segments),
                        export_name,
                        match use_decl.alias {
                            Some(value) => value,
                            None => export_name,
                        },
                    )
                } else {},
                None => (),
            }
        }
    }
    result
}

fn resolve_bare_derive(file: ast::File, environment: DeriveEnvironment, name: string) -> Result[
    ResolvedDerive,
    string,
] {
    let candidates: Vec[ResolvedDerive] = Vec::[];
    if supported_derive(name) && compiler_builtin_derive_fallback(environment.builtin_mode) {
        candidates.push(ResolvedDerive::BuiltinFallback(name))
    } else {
        match environment.builtin {
            Some(module) => for entry in module.derive_entries {
                match entry.export_name {
                    Some(export_name) => if entry.public && export_name == name {
                        candidates.push(ResolvedDerive::Handler { module, entry })
                    } else {},
                    None => (),
                }
            },
            None => (),
        }
    };
    if candidates.is_empty() && supported_derive(name)
        && compiler_builtin_derive_fallback(environment.builtin_mode) {
        candidates.push(ResolvedDerive::BuiltinFallback(name))
    } else {};
    for imported in derive_imports(file, environment) {
        if imported.local_name == name {
            candidates.push(
                ResolvedDerive::Handler { module: imported.module, entry: imported.entry },
            )
        } else {}
    }
    if candidates.is_empty() {
        Result::Err(
            "derive name `" + name
                + "` is not in scope; library derives must be qualified or explicitly imported",
        )
    } else if candidates.len() > 1 {
        Result::Err(
            "derive name `" + name
                + "` is ambiguous; use a package-qualified name or an import alias",
        )
    } else {
        Result::Ok(candidates[0])
    }
}

fn derive_dependencies(environment: DeriveEnvironment, package_name: string) -> Vec[ctir::CtModule] {
    let result: Vec[ctir::CtModule] = Vec::[];
    for module in environment_modules(environment) {
        let mut present = false;
        for existing in result {
            if existing.package_name == module.package_name {
                present = true;
            } else {}
        }
        if module.package_name == package_name || present {} else {
            result.push(module)
        }
    }
    result
}

fn derive_error_message(value: ctfe::CtError) -> string {
    let mut result = value.message;
    if !value.stack.is_empty() {
        result = result + "\ncomptime derive stack:";
        for frame in value.stack {
            result = result + "\n  " + frame.package_name + "::" + frame.function_name;
        }
    } else {};
    result
}

fn expand_handler_derive(
    item: derive_runtime::DeriveItem,
    attribute: ast::Attribute,
    environment: DeriveEnvironment,
    handler: (ctir::CtModule, ctir::CtDeriveEntry),
    diagnostics: Vec[cst::Diagnostic],
) -> Option[ast::ImplBlock] {
    match ctfe::evaluate_derive_entry(
        handler.0,
        derive_dependencies(environment, handler.0.package_name),
        handler.1.name,
        derive_runtime::DeriveRequest { item, attribute, handler_package: handler.0.package_name },
        ctfe::default_limits(),
    ) {
        Ok(value) => Option::Some(value),
        Err(error) => {
            diagnostics.push(
                cst::diagnostic(
                    derive_error_message(error),
                    attribute.span.start,
                    attribute.span.end,
                ),
            );
            Option::None
        },
    }
}

fn builtin_fallback_derive(item: derive_runtime::DeriveItem, name: string) -> Option[ast::ImplBlock] {
    match item {
        derive_runtime::DeriveItem::Struct(value) => if name == "ToString" {
            Option::Some(derive_struct_to_string(value))
        } else if name == "Eq" {
            Option::Some(derive_struct_eq(value))
        } else if name == "Hash" {
            Option::Some(derive_struct_hash(value))
        } else {
            Option::None
        },
        derive_runtime::DeriveItem::Enum(value) => if name == "ToString" {
            Option::Some(derive_enum_to_string(value))
        } else if name == "Eq" {
            Option::Some(derive_enum_eq(value))
        } else if name == "Hash" {
            Option::Some(derive_enum_hash(value))
        } else {
            Option::None
        },
    }
}

fn derive_impls(
    file: ast::File,
    item: derive_runtime::DeriveItem,
    attrs: Vec[ast::Attribute],
    environment: DeriveEnvironment,
    diagnostics: Vec[cst::Diagnostic],
) -> Vec[ast::ImplBlock] {
    let result: Vec[ast::ImplBlock] = Vec::[];
    for attribute in attrs {
        if attribute.name == "derive" {
            for arg in attribute.args {
                let resolved = match arg {
                    ast::AttributeArg::Ident(value) => resolve_bare_derive(file, environment, value),
                    ast::AttributeArg::Path(value) => match resolve_qualified_derive(
                        file,
                        environment,
                        value,
                    ) {
                        Ok(value) => Result::Ok(
                            ResolvedDerive::Handler { module: value.0, entry: value.1 },
                        ),
                        Err(message) => Result::Err(message),
                    },
                    ast::AttributeArg::String(_) => continue,
                };
                match resolved {
                    Ok(ResolvedDerive::BuiltinFallback(name)) => match builtin_fallback_derive(
                        item,
                        name,
                    ) {
                        Some(value) => result.push(value),
                        None => (),
                    },
                    Ok(ResolvedDerive::Handler { module, entry }) => match expand_handler_derive(
                        item,
                        attribute,
                        environment,
                        (module, entry),
                        diagnostics,
                    ) {
                        Some(value) => result.push(value),
                        None => (),
                    },
                    Err(message) => diagnostics.push(
                        cst::diagnostic(message, attribute.span.start, attribute.span.end),
                    ),
                }
            }
        } else {}
    }
    result
}

fn expand_file_derives(
    value: ast::File,
    environment: DeriveEnvironment,
    diagnostics: Vec[cst::Diagnostic],
) -> ast::File {
    let items: Vec[ast::Item] = Vec::[];
    for item in value.items {
        items.push(item);
        match item {
            StructDef(definition) => {
                for impl_block in derive_impls(
                    value,
                    derive_runtime::DeriveItem::Struct(definition),
                    definition.attrs,
                    environment,
                    diagnostics,
                ) {
                    items.push(ast::Item::ImplBlock(impl_block))
                }
            },
            EnumDef(definition) => {
                for impl_block in derive_impls(
                    value,
                    derive_runtime::DeriveItem::Enum(definition),
                    definition.attrs,
                    environment,
                    diagnostics,
                ) {
                    items.push(ast::Item::ImplBlock(impl_block))
                }
            },
            TraitDef(definition) => {
                for function in trait_default_functions(definition) {
                    items.push(ast::Item::Function(function))
                }
            },
            _ => (),
        }
    }
    ast::File {
        package_name: value.package_name,
        package_explicit: value.package_explicit,
        uses: value.uses,
        items,
        invalid_self_type_spans: value.invalid_self_type_spans,
    }
}

pub fn expand_derives_with_environment(value: ast::LowerResult, environment: DeriveEnvironment) -> ast::LowerResult {
    let diagnostics = value.diagnostics;
    let expanded = match value.ast {
        Some(file) => {
            validate_file_derives(file, diagnostics);
            Option::Some(expand_file_derives(file, environment, diagnostics))
        },
        None => Option::None,
    };
    ast::LowerResult { ast: expanded, diagnostics }
}

pub fn expand_derives_with_comptime(value: ast::LowerResult, modules: Vec[ctir::CtModule]) -> ast::LowerResult {
    expand_derives_with_environment(
        value,
        DeriveEnvironment {
            builtin: Option::None,
            dependencies: modules,
            builtin_mode: BuiltinDeriveMode::CompilerFallback,
        },
    )
}

pub fn expand_derives(value: ast::LowerResult) -> ast::LowerResult {
    expand_derives_with_comptime(value, Vec::[])
}
