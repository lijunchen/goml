package callable_codec;

use gomlc::artifact_type_codec as type_codec;
use gomlc::artifact_wire as wire;

use gomlc::strings;
use gomlc::tast;
use std::io;
use std::process;
use std::text;

fn fail(message: string) -> unit {
    io::eprintln(message);
    process::exit(1)
}

pub struct ArtifactCallable {
    pub name: string,
    pub kind: string,
    pub id: Option[string],
}

pub fn artifact_intrinsic_source_name(value: string) -> string {
    if value == "eq.primitive" {
        "__goml_primitive_eq"
    } else if value == "array.get" {
        "array_get"
    } else if value == "array.set" {
        "array_set"
    } else if value == "ref.new" {
        "ref"
    } else if value == "ref.get" {
        "ref_get"
    } else if value == "ref.set" {
        "ref_set"
    } else if value == "ref.ptr_eq" {
        "ptr_eq"
    } else if value == "ref.ptr_hash" {
        "ptr_hash"
    } else if value == "vec.new" {
        "vec_new"
    } else if value == "vec.with_capacity" {
        "vec_with_capacity"
    } else if value == "vec.push" {
        "vec_push"
    } else if value == "vec.get" {
        "vec_get"
    } else if value == "vec.set" {
        "vec_set"
    } else if value == "vec.len" {
        "vec_len"
    } else if value == "vec.capacity" {
        "vec_capacity"
    } else if value == "vec.reserve" {
        "vec_reserve"
    } else if value == "vec.truncate" {
        "vec_truncate"
    } else if value == "slice.new" {
        "slice"
    } else if value == "slice.get" {
        "slice_get"
    } else if value == "slice.len" {
        "slice_len"
    } else if value == "slice.sub" {
        "slice_sub"
    } else if value == "hashmap.new" {
        "hashmap_new"
    } else if value == "hashmap.get" {
        "hashmap_get"
    } else if value == "hashmap.set" {
        "hashmap_set"
    } else if value == "hashmap.remove" {
        "hashmap_remove"
    } else if value == "hashmap.len" {
        "hashmap_len"
    } else if value == "hashmap.contains" {
        "hashmap_contains"
    } else if value == "hashmap.entries" {
        "hashmap_entries"
    } else if value == "channel.new" {
        "channel_new"
    } else if value == "channel.send" {
        "channel_send"
    } else if value == "channel.recv" {
        "channel_recv"
    } else if value == "channel.close" {
        "channel_close"
    } else if value == "compiler.missing" {
        "missing"
    } else {
        fail("error[compile]: invalid intrinsic in compiler artifact");
        value
    }
}

pub fn artifact_replace_dots(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '.' {
            builder.write_char('_')
        } else {
            builder.write_char(character)
        }
    };
    builder.finish()
}

pub fn artifact_runtime_source_name(value: string) -> string {
    if strings::starts_with(value, "core.") {
        let name = value.byte_slice(5, value.byte_len());
        if name == "char_from_uint32" {
            name + "_raw"
        } else {
            name
        }
    } else {
        "std::internal::host::"
            + match value {
                "std.env.args" => "args",
                "std.env.current_dir" => "current_dir",
                "std.env.current_exe" => "current_exe",
                "std.env.var" => "env_var",
                "std.fs.read_file" => "read_file",
                "std.fs.write_file" => "write_file",
                "std.fs.read_bytes" => "read_bytes",
                "std.fs.write_bytes" => "write_bytes",
                "std.fs.create_dir_all" => "create_dir_all",
                "std.fs.remove_file" => "remove_file",
                "std.fs.remove_dir_all" => "remove_dir_all",
                "std.fs.file_exists" => "file_exists",
                "std.fs.is_file" => "is_file",
                "std.fs.is_dir" => "is_dir",
                "std.fs.canonicalize" => "canonicalize",
                "std.fs.read_dir" => "read_dir",
                "std.fs.sha256_file" => "sha256_file",
                "std.io.print" => "print",
                "std.io.println" => "println",
                "std.io.eprint" => "eprint",
                "std.io.read_stdin" => "read_stdin",
                "std.io.read_stdin_exact" => "read_stdin_exact",
                "std.io.write_stdout" => "write_stdout",
                "std.io.write_stderr" => "write_stderr",
                "std.path.join" => "path_join",
                "std.path.clean" => "path_clean",
                "std.path.is_absolute" => "path_is_absolute",
                "std.path.parent" => "path_parent",
                "std.path.file_name" => "path_file_name",
                "std.path.extension" => "path_extension",
                "std.path.file_stem" => "path_file_stem",
                "std.path.with_extension" => "path_with_extension",
                "std.path.absolute" => "path_absolute",
                "std.process.exit" => "exit",
                "std.process.look_path" => "process_look_path",
                "std.process.output" => "process_output",
                "std.process.output_timeout" => "process_output_timeout",
                "std.process.status" => "process_status",
                "std.process.status_timeout" => "process_status_timeout",
                "std.testing.fail" => "test_fail",
                "std.num.parse_int" => "parse_int",
                "std.num.parse_uint" => "parse_uint",
                "std.num.parse_float32" => "parse_float32",
                "std.num.parse_float64" => "parse_float64",
                "std.time.monotonic_nanoseconds" => "monotonic_nanoseconds",
                "std.time.unix_nanoseconds" => "unix_nanoseconds",
                "std.time.sleep_nanoseconds" => "sleep_nanoseconds",
                _ => {
                    fail("error[compile]: invalid runtime hook in compiler artifact");
                    value
                },
            }
    }
}

pub fn artifact_callable_id(kind: string, value: string) -> string {
    if kind == "intrinsic" {
        if value == "eq.primitive" {
            "primitive_eq"
        } else if value == "compiler.missing" {
            "missing"
        } else if value == "hashmap.new" {
            "hash_map_new"
        } else if value == "hashmap.get" {
            "hash_map_get"
        } else if value == "hashmap.set" {
            "hash_map_set"
        } else if value == "hashmap.remove" {
            "hash_map_remove"
        } else if value == "hashmap.len" {
            "hash_map_len"
        } else if value == "hashmap.contains" {
            "hash_map_contains"
        } else if value == "hashmap.entries" {
            "hash_map_entries"
        } else {
            artifact_replace_dots(value)
        }
    } else if strings::starts_with(value, "core.") {
        value.byte_slice(5, value.byte_len())
    } else {
        artifact_replace_dots(value)
    }
}

pub fn artifact_callable(value: tast::Callable) -> ArtifactCallable {
    match value {
        Function(value) => ArtifactCallable { name: value, kind: "goml", id: Option::None },
        Runtime(value) => ArtifactCallable {
            name: artifact_runtime_source_name(value),
            kind: "runtime",
            id: Option::Some(artifact_callable_id("runtime", value)),
        },
        Intrinsic(value) => ArtifactCallable {
            name: artifact_intrinsic_source_name(value),
            kind: "intrinsic",
            id: Option::Some(artifact_callable_id("intrinsic", value)),
        },
        TraitMethod { trait_ref: _, method_name: _ } | DynTraitMethod {
            trait_name: _,
            dispatch_name: _,
            method_name: _,
        } | InherentMethod { receiver_ty: _, method_name: _ } => {
            fail("error[compile]: unresolved callable in compiler artifact");
            ArtifactCallable { name: "", kind: "goml", id: Option::None }
        },
    }
}

pub fn artifact_json_callable_body(writer: wire::ArtifactJsonWriter, value: ArtifactCallable) -> unit {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "kind");
    wire::artifact_json_string(writer, value.kind);
    match value.id {
        Some(value) => {
            wire::artifact_json_name(writer, "id");
            wire::artifact_json_string(writer, value)
        },
        None => (),
    };
    wire::artifact_json_end_object(writer)
}

pub fn artifact_intrinsic_key_from_id(value: string) -> Option[string] {
    match value {
        "primitive_eq" => Option::Some("eq.primitive"),
        "array_get" => Option::Some("array.get"),
        "array_set" => Option::Some("array.set"),
        "ref_new" => Option::Some("ref.new"),
        "ref_get" => Option::Some("ref.get"),
        "ref_set" => Option::Some("ref.set"),
        "ref_ptr_eq" => Option::Some("ref.ptr_eq"),
        "ref_ptr_hash" => Option::Some("ref.ptr_hash"),
        "vec_new" => Option::Some("vec.new"),
        "vec_with_capacity" => Option::Some("vec.with_capacity"),
        "vec_push" => Option::Some("vec.push"),
        "vec_get" => Option::Some("vec.get"),
        "vec_set" => Option::Some("vec.set"),
        "vec_len" => Option::Some("vec.len"),
        "vec_capacity" => Option::Some("vec.capacity"),
        "vec_reserve" => Option::Some("vec.reserve"),
        "vec_truncate" => Option::Some("vec.truncate"),
        "slice_new" => Option::Some("slice.new"),
        "slice_get" => Option::Some("slice.get"),
        "slice_len" => Option::Some("slice.len"),
        "slice_sub" => Option::Some("slice.sub"),
        "hash_map_new" | "hashmap_new" => Option::Some("hashmap.new"),
        "hash_map_get" | "hashmap_get" => Option::Some("hashmap.get"),
        "hash_map_set" | "hashmap_set" => Option::Some("hashmap.set"),
        "hash_map_remove" | "hashmap_remove" => Option::Some("hashmap.remove"),
        "hash_map_len" | "hashmap_len" => Option::Some("hashmap.len"),
        "hash_map_contains" | "hashmap_contains" => Option::Some("hashmap.contains"),
        "hash_map_entries" | "hashmap_entries" => Option::Some("hashmap.entries"),
        "channel_new" => Option::Some("channel.new"),
        "channel_send" => Option::Some("channel.send"),
        "channel_recv" => Option::Some("channel.recv"),
        "channel_close" => Option::Some("channel.close"),
        "missing" => Option::Some("compiler.missing"),
        _ => Option::None,
    }
}

pub fn artifact_runtime_key_from_id(value: string) -> Option[string] {
    match value {
        "std_env_args" => Option::Some("std.env.args"),
        "std_env_current_dir" => Option::Some("std.env.current_dir"),
        "std_env_current_exe" => Option::Some("std.env.current_exe"),
        "std_env_var" => Option::Some("std.env.var"),
        "std_fs_read_file" => Option::Some("std.fs.read_file"),
        "std_fs_write_file" => Option::Some("std.fs.write_file"),
        "std_fs_read_bytes" => Option::Some("std.fs.read_bytes"),
        "std_fs_write_bytes" => Option::Some("std.fs.write_bytes"),
        "std_fs_create_dir_all" => Option::Some("std.fs.create_dir_all"),
        "std_fs_remove_file" => Option::Some("std.fs.remove_file"),
        "std_fs_remove_dir_all" => Option::Some("std.fs.remove_dir_all"),
        "std_fs_file_exists" => Option::Some("std.fs.file_exists"),
        "std_fs_is_file" => Option::Some("std.fs.is_file"),
        "std_fs_is_dir" => Option::Some("std.fs.is_dir"),
        "std_fs_canonicalize" => Option::Some("std.fs.canonicalize"),
        "std_fs_read_dir" => Option::Some("std.fs.read_dir"),
        "std_fs_sha256_file" => Option::Some("std.fs.sha256_file"),
        "std_io_print" => Option::Some("std.io.print"),
        "std_io_println" => Option::Some("std.io.println"),
        "std_io_eprint" => Option::Some("std.io.eprint"),
        "std_io_read_stdin" => Option::Some("std.io.read_stdin"),
        "std_io_read_stdin_exact" => Option::Some("std.io.read_stdin_exact"),
        "std_io_write_stdout" => Option::Some("std.io.write_stdout"),
        "std_io_write_stderr" => Option::Some("std.io.write_stderr"),
        "std_path_join" => Option::Some("std.path.join"),
        "std_path_clean" => Option::Some("std.path.clean"),
        "std_path_is_absolute" => Option::Some("std.path.is_absolute"),
        "std_path_parent" => Option::Some("std.path.parent"),
        "std_path_file_name" => Option::Some("std.path.file_name"),
        "std_path_extension" => Option::Some("std.path.extension"),
        "std_path_file_stem" => Option::Some("std.path.file_stem"),
        "std_path_with_extension" => Option::Some("std.path.with_extension"),
        "std_path_absolute" => Option::Some("std.path.absolute"),
        "std_process_exit" => Option::Some("std.process.exit"),
        "std_process_look_path" => Option::Some("std.process.look_path"),
        "std_process_output" => Option::Some("std.process.output"),
        "std_process_output_timeout" => Option::Some("std.process.output_timeout"),
        "std_process_status" => Option::Some("std.process.status"),
        "std_process_status_timeout" => Option::Some("std.process.status_timeout"),
        "std_testing_fail" => Option::Some("std.testing.fail"),
        "std_num_parse_int" => Option::Some("std.num.parse_int"),
        "std_num_parse_uint" => Option::Some("std.num.parse_uint"),
        "std_num_parse_float32" => Option::Some("std.num.parse_float32"),
        "std_num_parse_float64" => Option::Some("std.num.parse_float64"),
        "std_time_monotonic_nanoseconds" => Option::Some("std.time.monotonic_nanoseconds"),
        "std_time_unix_nanoseconds" => Option::Some("std.time.unix_nanoseconds"),
        "std_time_sleep_nanoseconds" => Option::Some("std.time.sleep_nanoseconds"),
        "unit_to_string" | "bool_to_string" | "string_len" | "string_get" | "string_byte_get" | "string_byte_slice" | "string_is_char_boundary" | "string_decode_utf8_at" | "string_to_bytes" | "string_from_utf8" | "string_concat" | "string_print" | "string_println" | "char_to_string" | "char_from_uint32" | "int_to_string" | "int8_to_string" | "int16_to_string" | "int32_to_string" | "int64_to_string" | "uint_to_string" | "uint8_to_string" | "uint16_to_string" | "uint32_to_string" | "uint64_to_string" | "float32_to_string" | "float64_to_string" | "string_parse_float32" | "string_parse_float64" | "int_hash" | "int8_hash" | "int16_hash" | "int32_hash" | "int64_hash" | "uint_hash" | "uint8_hash" | "uint16_hash" | "uint32_hash" | "float32_hash" | "float64_hash" | "string_hash" | "char_hash" => Option::Some(
            "core." + value,
        ),
        _ => Option::None,
    }
}

pub fn artifact_decode_callable_body(name: string, value: wire::ArtifactValue) -> Result[
    tast::Callable,
    string,
] {
    let object = type_codec::artifact_json_object(value, "callable body")?;
    let kind = type_codec::artifact_json_field_string(object, "kind")?;
    if kind == "goml" {
        Result::Ok(tast::Callable::Function(name))
    } else {
        let id = type_codec::artifact_json_field_string(object, "id")?;
        if kind == "intrinsic" {
            match artifact_intrinsic_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Intrinsic(value)),
                None => Result::Err(type_codec::artifact_decode_error("intrinsic id")),
            }
        } else if kind == "runtime" {
            match artifact_runtime_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Runtime(value)),
                None => Result::Err(type_codec::artifact_decode_error("runtime hook id")),
            }
        } else {
            Result::Err(type_codec::artifact_decode_error("callable kind"))
        }
    }
}
