        \\fn smaller(left: int, right: int) -> int {
        \\    if left < right {
        \\        left
        \\    } else {
        \\        right
        \\    }
        \\}
        \\
        \\pub fn stable_sort_by[T](values: Vec[T], compare: (T, T) -> int) -> unit {
        \\    let length = values.len();
        \\    if length < 2 {
        \\        return
        \\    } else {
        \\        ()
        \\    };
        \\    let buffer: Vec[T] = Vec::with_capacity(length);
        \\    for index in 0..length {
        \\        buffer.push(values[index])
        \\    };
        \\    let mut width = 1;
        \\    while width < length {
        \\        let mut left = 0;
        \\        while left < length {
        \\            let middle = smaller(left + width, length);
        \\            let right = smaller(middle + width, length);
        \\            let mut first = left;
        \\            let mut second = middle;
        \\            let mut output = left;
        \\            while first < middle && second < right {
        \\                if compare(values[first], values[second]) <= 0 {
        \\                    buffer[output] = values[first];
        \\                    first += 1;
        \\                } else {
        \\                    buffer[output] = values[second];
        \\                    second += 1;
        \\                };
        \\                output += 1;
        \\            };
        \\            while first < middle {
        \\                buffer[output] = values[first];
        \\                first += 1;
        \\                output += 1;
        \\            };
        \\            while second < right {
        \\                buffer[output] = values[second];
        \\                second += 1;
        \\                output += 1;
        \\            };
        \\            left = right;
        \\        };
        \\        for index in 0..length {
        \\            values[index] = buffer[index];
        \\        };
        \\        width = if width > length / 2 {
        \\            length
        \\        } else {
        \\            width * 2
        \\        };
        \\    }
        \\}
        \\
        \\pub fn sort_by[T](values: Vec[T], compare: (T, T) -> int) -> unit {
        \\    stable_sort_by(values, compare)
        \\}
        \\
        \\pub fn binary_search_by[T](values: Vec[T], compare: (T) -> int) -> Option[int] {
        \\    let mut low = 0;
        \\    let mut high = values.len();
        \\    while low < high {
        \\        let middle = low + (high - low) / 2;
        \\        if compare(values[middle]) < 0 {
        \\            low = middle + 1;
        \\        } else {
        \\            high = middle;
        \\        }
        \\    };
        \\    if low < values.len() && compare(values[low]) == 0 {
        \\        Option::Some(low)
        \\    } else {
        \\        Option::None
        \\    }
        \\}
        \\
        \\pub fn position_by[T](values: Vec[T], predicate: (T) -> bool) -> Option[int] {
        \\    for index in 0..values.len() {
        \\        if predicate(values[index]) {
        \\            return Option::Some(index)
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    Option::None
        \\}
        \\
        \\pub fn contains[T: Eq](values: Vec[T], expected: T) -> bool {
        \\    position_by(values, |value: T| Eq::eq(value, expected)).is_some()
        \\}
        \\
        \\pub fn min_by[T](values: Vec[T], compare: (T, T) -> int) -> Option[T] {
        \\    if values.len() == 0 {
        \\        Option::None
        \\    } else {
        \\        let mut best = values[0];
        \\        for index in 1..values.len() {
        \\            let value = values[index];
        \\            if compare(value, best) < 0 {
        \\                best = value;
        \\            } else {
        \\                ()
        \\            }
        \\        };
        \\        Option::Some(best)
        \\    }
        \\}
        \\
        \\pub fn max_by[T](values: Vec[T], compare: (T, T) -> int) -> Option[T] {
        \\    if values.len() == 0 {
        \\        Option::None
        \\    } else {
        \\        let mut best = values[0];
        \\        for index in 1..values.len() {
        \\            let value = values[index];
        \\            if compare(value, best) > 0 {
        \\                best = value;
        \\            } else {
        \\                ()
        \\            }
        \\        };
        \\        Option::Some(best)
        \\    }
        \\}
        \\
        \\pub fn dedup_by[T](values: Vec[T], equal: (T, T) -> bool) -> unit {
        \\    if values.len() < 2 {
        \\        return
        \\    } else {
        \\        ()
        \\    };
        \\    let mut output = 1;
        \\    for index in 1..values.len() {
        \\        let value = values[index];
        \\        if equal(values[output - 1], value) == false {
        \\            values[output] = value;
        \\            output += 1;
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    values.truncate(output)
        \\}
        \\
        \\pub fn dedup[T: Eq](values: Vec[T]) -> unit {
        \\    dedup_by(values, |left: T, right: T| Eq::eq(left, right))
        \\}
    ;
    source
}

pub fn json_source() -> string {
    let source = \\package json;
        \\
        \\use std::text;
        \\
        \\pub enum Value {
        \\    Object(Vec[(string, Value)]),
        \\    Array(Vec[Value]),
        \\    String(string),
        \\    Number(string),
        \\    Bool(bool),
        \\    Null,
        \\}
        \\
        \\struct JsonParser {
        \\    input: string,
        \\    index: Ref[int],
        \\}
        \\
        \\fn json_parser(input: string) -> JsonParser {
        \\    JsonParser { input, index: Ref::new(0) }
        \\}
        \\
        \\fn json_error(value: JsonParser, message: string) -> string {
        \\    f"{message} at byte {value.index.get()}"
        \\}
        \\
        \\fn json_whitespace(value: byte) -> bool {
        \\    value == b'\t' || value == b'\n' || value == b'\r' || value == b' '
        \\}
        \\
        \\fn skip_json_whitespace(value: JsonParser) -> unit {
        \\    while value.index.get() < value.input.byte_len()
        \\        && json_whitespace(value.input.byte_get(value.index.get())) {
        \\        value.index.set(value.index.get() + 1)
        \\    }
        \\}
        \\
        \\fn hex_digit(value: byte) -> Option[uint32] {
        \\    if value >= b'0' && value <= b'9' {
        \\        Option::Some((value - b'0') as uint32)
        \\    } else if value >= b'A' && value <= b'F' {
        \\        Option::Some((value - b'A' + 10) as uint32)
        \\    } else if value >= b'a' && value <= b'f' {
        \\        Option::Some((value - b'a' + 10) as uint32)
        \\    } else {
        \\        Option::None
        \\    }
        \\}
        \\
        \\fn parse_hex_quad(value: JsonParser) -> Result[uint32, string] {
        \\    if value.index.get() + 4 > value.input.byte_len() {
        \\        Result::Err(json_error(value, "incomplete unicode escape"))
        \\    } else {
        \\        let mut result = 0 as uint32;
        \\        for offset in 0..4 {
        \\            match hex_digit(value.input.byte_get(value.index.get() + offset)) {
        \\                Some(digit) => {
        \\                    result = result * 16 + digit;
        \\                },
        \\                None => {
        \\                    return Result::Err(json_error(value, "invalid unicode escape"))
        \\                },
        \\            }
        \\        };
        \\        value.index.set(value.index.get() + 4);
        \\        Result::Ok(result)
        \\    }
        \\}
        \\
        \\fn write_codepoint(value: JsonParser, builder: text::StringBuilder, codepoint: uint32) -> Result[
        \\    unit,
        \\    string,
        \\] {
        \\    match char_from_uint32(codepoint) {
        \\        Some(character) => {
        \\            builder.write_char(character);
        \\            Result::Ok(())
        \\        },
        \\        None => Result::Err(json_error(value, "invalid unicode codepoint")),
        \\    }
        \\}
        \\
        \\fn parse_unicode_escape(value: JsonParser, builder: text::StringBuilder) -> Result[unit, string] {
        \\    let first = parse_hex_quad(value)?;
        \\    if first >= 55296 && first <= 56319 {
        \\        if value.index.get() + 2 > value.input.byte_len()
        \\            || value.input.byte_get(value.index.get()) != b'\\'
        \\            || value.input.byte_get(value.index.get() + 1) != b'u' {
        \\            Result::Err(json_error(value, "missing low surrogate"))
        \\        } else {
        \\            value.index.set(value.index.get() + 2);
        \\            let second = parse_hex_quad(value)?;
        \\            if second < 56320 || second > 57343 {
        \\                Result::Err(json_error(value, "invalid low surrogate"))
        \\            } else {
        \\                write_codepoint(value, builder, 65536 + (first - 55296) * 1024 + second - 56320)
        \\            }
        \\        }
        \\    } else if first >= 56320 && first <= 57343 {
        \\        Result::Err(json_error(value, "unexpected low surrogate"))
        \\    } else {
        \\        write_codepoint(value, builder, first)
        \\    }
        \\}
        \\
        \\fn parse_json_string(value: JsonParser) -> Result[string, string] {
        \\    if value.index.get() >= value.input.byte_len()
        \\        || value.input.byte_get(value.index.get()) != b'"' {
        \\        return Result::Err(json_error(value, "expected string"))
