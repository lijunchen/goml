pub fn root_source() -> string {
    let source = \\package std;
        \\
        \\use std::bytes;
        \\use std::collections;
        \\use std::env;
        \\use std::fs;
        \\use std::io;
        \\use std::json;
        \\use std::path;
        \\use std::process;
        \\use std::text;
    ;
    source
}

