        \\            b'f' => parse_json_literal(value, "false", Bool(false)),
        \\            b'n' => parse_json_literal(value, "null", Null),
        \\            byte => if byte == b'-' || json_digit(byte) {
        \\                parse_json_number(value)
        \\            } else {
        \\                Result::Err(json_error(value, "unexpected JSON token"))
        \\            },
        \\        }
        \\    }
        \\}
        \\
        \\pub fn parse(input: string) -> Result[Value, string] {
        \\    let parser = json_parser(input);
        \\    let result = parse_json_value(parser)?;
        \\    skip_json_whitespace(parser);
        \\    if parser.index.get() == input.byte_len() {
        \\        Result::Ok(result)
        \\    } else {
        \\        Result::Err(json_error(parser, "trailing JSON data"))
        \\    }
        \\}
        \\
        \\fn json_hex_digit(value: byte) -> char {
        \\    "0123456789abcdef".get(value as int)
        \\}
        \\
        \\fn write_json_string(builder: text::StringBuilder, value: string) -> unit {
        \\    builder.write_char('"');
        \\    let mut start = 0;
        \\    for index in 0..value.byte_len() {
        \\        let byte = value.byte_get(index);
        \\        if byte == b'"' || byte == b'\\' || byte == b'\b' || byte == b'\t' || byte == b'\n'
        \\            || byte == b'\f'
        \\            || byte == b'\r'
        \\            || byte < b' ' {
        \\            if start < index {
        \\                builder.write_string(value.byte_slice(start, index))
        \\            } else {
        \\                ()
        \\            };
        \\            if byte == b'"' {
        \\                builder.write_string("\\\"")
        \\            } else if byte == b'\\' {
        \\                builder.write_string("\\\\")
        \\            } else if byte == b'\b' {
        \\                builder.write_string("\\b")
        \\            } else if byte == b'\t' {
        \\                builder.write_string("\\t")
        \\            } else if byte == b'\n' {
        \\                builder.write_string("\\n")
        \\            } else if byte == b'\f' {
        \\                builder.write_string("\\f")
        \\            } else if byte == b'\r' {
        \\                builder.write_string("\\r")
        \\            } else {
        \\                builder.write_string("\\u00");
        \\                builder.write_char(json_hex_digit(byte / 16));
        \\                builder.write_char(json_hex_digit(byte % 16))
        \\            };
        \\            start = index + 1;
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    if start < value.byte_len() {
        \\        builder.write_string(value.byte_slice(start, value.byte_len()))
        \\    } else {
        \\        ()
        \\    };
        \\    builder.write_char('"')
        \\}
        \\
        \\fn write_json_value(builder: text::StringBuilder, value: Value) -> unit {
        \\    match value {
        \\        Object(fields) => {
        \\            builder.write_char('{');
        \\            let mut index = 0;
        \\            for field in fields {
        \\                if index > 0 {
        \\                    builder.write_char(',')
        \\                } else {
        \\                    ()
        \\                };
        \\                write_json_string(builder, field.0);
        \\                builder.write_char(':');
        \\                write_json_value(builder, field.1);
        \\                index += 1;
        \\            };
        \\            builder.write_char('}')
        \\        },
        \\        Array(items) => {
        \\            builder.write_char('[');
        \\            let mut index = 0;
        \\            for item in items {
        \\                if index > 0 {
        \\                    builder.write_char(',')
        \\                } else {
        \\                    ()
        \\                };
        \\                write_json_value(builder, item);
        \\                index += 1;
        \\            };
        \\            builder.write_char(']')
        \\        },
        \\        String(text) => write_json_string(builder, text),
        \\        Number(number) => builder.write_string(number),
        \\        Bool(value) => builder.write_string(
        \\            if value {
        \\                "true"
        \\            } else {
        \\                "false"
        \\            },
        \\        ),
        \\        Null => builder.write_string("null"),
        \\    }
        \\}
        \\
        \\pub fn encode(value: Value) -> string {
        \\    let builder = text::StringBuilder::new();
        \\    write_json_value(builder, value);
        \\    builder.finish()
        \\}
        \\
        \\pub fn field(value: Value, name: string) -> Option[Value] {
        \\    match value {
        \\        Object(fields) => {
        \\            for field in fields {
        \\                if field.0 == name {
        \\                    return Option::Some(field.1)
        \\                } else {
        \\                    ()
        \\                }
        \\            };
        \\            Option::None
        \\        },
        \\        _ => Option::None,
        \\    }
        \\}
        \\
        \\pub fn as_string(value: Value) -> Option[string] {
        \\    match value {
        \\        String(text) => Option::Some(text),
        \\        _ => Option::None,
        \\    }
        \\}
        \\
        \\fn parse_json_int_text(value: string) -> Option[int] {
        \\    if value.byte_len() == 0 {
        \\        Option::None
        \\    } else {
        \\        let negative = value.byte_get(0) == b'-';
        \\        let mut index = if negative {
        \\            1
        \\        } else {
        \\            0
        \\        };
        \\        let mut result = 0;
        \\        if index == value.byte_len() {
        \\            return Option::None
        \\        } else {
        \\            ()
        \\        };
        \\        while index < value.byte_len() {
        \\            let byte = value.byte_get(index);
        \\            if byte < b'0' || byte > b'9' {
        \\                return Option::None
        \\            } else {
        \\                result = result * 10 + (byte - b'0') as int;
        \\            };
        \\            index += 1;
        \\        };
        \\        Option::Some(
        \\            if negative {
        \\                0 - result
        \\            } else {
        \\                result
        \\            },
        \\        )
        \\    }
        \\}
        \\
        \\pub fn as_int(value: Value) -> Option[int] {
        \\    match value {
        \\        Number(number) => parse_json_int_text(number),
        \\        _ => Option::None,
        \\    }
        \\}
        \\
        \\pub fn as_bool(value: Value) -> Option[bool] {
        \\    match value {
        \\        Bool(result) => Option::Some(result),
        \\        _ => Option::None,
        \\    }
        \\}
        \\
        \\pub fn as_array(value: Value) -> Option[Vec[Value]] {
        \\    match value {
        \\        Array(items) => Option::Some(items),
        \\        _ => Option::None,
        \\    }
        \\}
        \\
        \\pub fn object(fields: Vec[(string, Value)]) -> Value {
        \\    Value::Object(fields)
        \\}
    ;
    source
}

pub fn text_source() -> string {
    let source = \\package text;
        \\
        \\use std::bytes;
        \\
        \\pub struct StringBuilder {
        \\    pub values: Vec[byte],
        \\}
        \\
        \\impl StringBuilder {
        \\    pub fn new() -> StringBuilder {
        \\        StringBuilder { values: Vec::new() }
        \\    }
        \\
        \\    pub fn with_capacity(capacity: int) -> StringBuilder {
        \\        StringBuilder { values: Vec::with_capacity(capacity) }
        \\    }
        \\
        \\    pub fn len(self: StringBuilder) -> int {
        \\        self.values.len()
        \\    }
        \\
        \\    pub fn is_empty(self: StringBuilder) -> bool {
        \\        self.values.len() == 0
        \\    }
        \\
        \\    pub fn write_string(self: StringBuilder, value: string) -> unit {
        \\        self.values.reserve(value.byte_len());
        \\        for index in 0..value.byte_len() {
        \\            self.values.push(value.byte_get(index))
        \\        }
        \\    }
        \\
        \\    pub fn write_char(self: StringBuilder, value: char) -> unit {
        \\        self.write_string(value.to_string())
        \\    }
        \\
        \\    pub fn write_bytes(self: StringBuilder, value: bytes::Bytes) -> Result[unit, string] {
        \\        match value.to_string() {
        \\            Ok(text) => {
        \\                self.write_string(text);
        \\                Result::Ok(())
        \\            },
        \\            Err(error) => Result::Err(error),
        \\        }
        \\    }
        \\
        \\    pub fn write_line(self: StringBuilder, value: string) -> unit {
        \\        self.write_string(value);
        \\        self.write_string("\n")
        \\    }
        \\
        \\    pub fn clear(self: StringBuilder) -> unit {
        \\        self.values.clear()
        \\    }
        \\
        \\    pub fn finish(self: StringBuilder) -> string {
        \\        let (_, value) = string_from_utf8(self.values);
        \\        value
        \\    }
        \\}
        \\
        \\impl ToString for StringBuilder {
        \\    fn to_string(self: StringBuilder) -> string {
        \\        self.finish()
        \\    }
        \\}
        \\
        \\fn is_ascii_whitespace_byte(value: byte) -> bool {
        \\    value == b'\t' || value == b'\n' || value == b'\x0B' || value == b'\f' || value == b'\r'
        \\        || value == b' '
        \\}
        \\
        \\fn find_from(value: string, expected: string, start: int) -> Option[int] {
        \\    if start < 0 || start > value.byte_len() {
        \\        Option::None
        \\    } else if expected.byte_len() == 0 {
        \\        Option::Some(start)
        \\    } else if expected.byte_len() > value.byte_len() - start {
        \\        Option::None
        \\    } else {
        \\        let limit = value.byte_len() - expected.byte_len();
        \\        let mut index = start;
        \\        while index <= limit {
        \\            let end = index + expected.byte_len();
        \\            if value.is_char_boundary(index) && value.is_char_boundary(end)
        \\                && value.byte_slice(index, end) == expected {
        \\                return Option::Some(index)
        \\            } else {
        \\                index += 1;
        \\            }
        \\        };
        \\        Option::None
        \\    }
        \\}
        \\
        \\pub fn find(value: string, expected: string) -> Option[int] {
        \\    find_from(value, expected, 0)
        \\}
        \\
        \\pub fn trim_start(value: string) -> string {
        \\    let mut start = 0;
        \\    while start < value.byte_len() && is_ascii_whitespace_byte(value.byte_get(start)) {
        \\        start += 1;
        \\    };
        \\    value.byte_slice(start, value.byte_len())
        \\}
        \\
        \\pub fn trim_end(value: string) -> string {
        \\    let mut end = value.byte_len();
        \\    while end > 0 && is_ascii_whitespace_byte(value.byte_get(end - 1)) {
        \\        end -= 1;
        \\    };
        \\    value.byte_slice(0, end)
        \\}
        \\
        \\pub fn trim(value: string) -> string {
        \\    trim_end(trim_start(value))
        \\}
        \\
        \\pub fn split(value: string, separator: string) -> Vec[string] {
        \\    let result: Vec[string] = Vec::new();
        \\    if separator.byte_len() == 0 {
        \\        result.push(value);
        \\        return result
        \\    } else {
        \\        ()
        \\    };
        \\    let mut start = 0;
        \\    while true {
        \\        match find_from(value, separator, start) {
        \\            Some(index) => {
        \\                result.push(value.byte_slice(start, index));
        \\                start = index + separator.byte_len();
        \\            },
        \\            None => {
        \\                result.push(value.byte_slice(start, value.byte_len()));
        \\                break
        \\            },
        \\        }
        \\    };
        \\    result
        \\}
        \\
        \\pub fn split_once(value: string, separator: string) -> Option[(string, string)] {
        \\    if separator.byte_len() == 0 {
        \\        Option::None
        \\    } else {
        \\        match find(value, separator) {
        \\            Some(index) => Option::Some(
        \\                (
        \\                    value.byte_slice(0, index),
        \\                    value.byte_slice(index + separator.byte_len(), value.byte_len()),
        \\                ),
        \\            ),
        \\            None => Option::None,
        \\        }
        \\    }
        \\}
        \\
        \\pub fn lines(value: string) -> Vec[string] {
        \\    let result = split(value, "\n");
        \\    if result.len() > 0 && result[result.len() - 1] == "" {
        \\        let _ = result.pop();
        \\    } else {
        \\        ()
        \\    };
        \\    for index in 0..result.len() {
        \\        let line = result[index];
        \\        if line.byte_len() > 0 && line.byte_get(line.byte_len() - 1) == b'\r' {
        \\            result[index] = line.byte_slice(0, line.byte_len() - 1);
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    result
        \\}
        \\
        \\pub fn replace(value: string, expected: string, replacement: string) -> string {
        \\    if expected.byte_len() == 0 {
        \\        value
        \\    } else {
        \\        let builder = StringBuilder::with_capacity(value.byte_len());
        \\        let mut start = 0;
        \\        while true {
        \\            match find_from(value, expected, start) {
        \\                Some(index) => {
        \\                    builder.write_string(value.byte_slice(start, index));
        \\                    builder.write_string(replacement);
        \\                    start = index + expected.byte_len();
        \\                },
        \\                None => {
        \\                    builder.write_string(value.byte_slice(start, value.byte_len()));
        \\                    break
        \\                },
        \\            }
        \\        };
        \\        builder.finish()
        \\    }
        \\}
        \\
        \\pub fn join(values: Vec[string], separator: string) -> string {
        \\    let builder = StringBuilder::new();
        \\    for index in 0..values.len() {
        \\        if index > 0 {
        \\            builder.write_string(separator)
        \\        } else {
        \\            ()
        \\        };
        \\        builder.write_string(values[index])
        \\    };
        \\    builder.finish()
        \\}
        \\
        \\pub fn repeat(value: string, count: int) -> string {
        \\    if count <= 0 || value.byte_len() == 0 {
        \\        ""
        \\    } else {
        \\        let builder = StringBuilder::with_capacity(value.byte_len() * count);
        \\        for _ in 0..count {
        \\            builder.write_string(value)
        \\        };
        \\        builder.finish()
        \\    }
        \\}
        \\
        \\pub fn is_ascii(value: string) -> bool {
        \\    for index in 0..value.byte_len() {
        \\        if value.byte_get(index) > 127 {
        \\            return false
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    true
        \\}
        \\
        \\pub fn to_ascii_lowercase(value: string) -> string {
        \\    let values = value.to_bytes();
        \\    for index in 0..values.len() {
        \\        let current = values[index];
        \\        if current >= b'A' && current <= b'Z' {
        \\            values[index] = current + (b'a' - b'A');
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    let (_, result) = string_from_utf8(values);
        \\    result
        \\}
        \\
        \\pub fn to_ascii_uppercase(value: string) -> string {
        \\    let values = value.to_bytes();
        \\    for index in 0..values.len() {
        \\        let current = values[index];
        \\        if current >= b'a' && current <= b'z' {
        \\            values[index] = current - (b'a' - b'A');
        \\        } else {
        \\            ()
        \\        }
        \\    };
        \\    let (_, result) = string_from_utf8(values);
        \\    result
        \\}
    ;
    source
}

pub fn num_source() -> string {
    let source = \\package num;
        \\
        \\use std::internal::host;
        \\
        \\fn int_result(value: (bool, int, string)) -> Result[int, string] {
