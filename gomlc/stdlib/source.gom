pub fn json_source() -> string {
    let source = \\package json;
        \\
        \\use std::text;
        \\
        \\pub enum Value {
        \\    Object(Vec[(string, Value)]),
        \\    Array(Vec[Value]),
        \\    String(string),
        \\    Number(string),
        \\    Bool(bool),
        \\    Null,
        \\}
        \\
        \\struct JsonParser {
        \\    input: string,
        \\    index: Ref[int],
        \\}
        \\
        \\fn json_parser(input: string) -> JsonParser {
        \\    JsonParser {
        \\        input,
        \\        index: Ref::new(0),
        \\    }
        \\}
        \\
        \\fn json_error(value: JsonParser, message: string) -> string {
        \\    message + " at byte " + value.index.get().to_string()
        \\}
        \\
        \\fn json_whitespace(value: uint8) -> bool {
        \\    value == 9 || value == 10 || value == 13 || value == 32
        \\}
        \\
        \\fn skip_json_whitespace(value: JsonParser) -> unit {
        \\    while value.index.get() < value.input.byte_len()
        \\        && json_whitespace(value.input.byte_get(value.index.get()))
        \\    {
        \\        value.index.set(value.index.get() + 1)
        \\    }
        \\}
        \\
        \\fn hex_digit(value: uint8) -> Option[uint32] {
        \\    if value >= 48 && value <= 57 {
        \\        Option::Some((value - 48) as uint32)
        \\    } else if value >= 65 && value <= 70 {
        \\        Option::Some((value - 55) as uint32)
        \\    } else if value >= 97 && value <= 102 {
        \\        Option::Some((value - 87) as uint32)
        \\    } else {
        \\        Option::None
        \\    }
        \\}
        \\
        \\fn parse_hex_quad(value: JsonParser) -> Result[uint32, string] {
        \\    if value.index.get() + 4 > value.input.byte_len() {
        \\        Result::Err(json_error(value, "incomplete unicode escape"))
        \\    } else {
        \\        let result = Ref::new(0 as uint32);
        \\        for offset in range(0, 4) {
        \\            match hex_digit(value.input.byte_get(value.index.get() + offset)) {
        \\                Option::Some(digit) => {
        \\                    result.set(result.get() * 16 + digit)
        \\                },
        \\                Option::None => {
        \\                    return Result::Err(json_error(
        \\                        value,
        \\                        "invalid unicode escape",
        \\                    ))
        \\                },
        \\            }
        \\        };
        \\        value.index.set(value.index.get() + 4);
        \\        Result::Ok(result.get())
        \\    }
        \\}
        \\
        \\fn write_codepoint(
        \\    value: JsonParser,
        \\    builder: text::StringBuilder,
        \\    codepoint: uint32,
        \\) -> Result[unit, string] {
        \\    match char_from_uint32(codepoint) {
        \\        Option::Some(character) => {
        \\            builder.write_char(character);
        \\            Result::Ok(())
        \\        },
        \\        Option::None => Result::Err(json_error(
        \\            value,
        \\            "invalid unicode codepoint",
        \\        )),
        \\    }
        \\}
        \\
        \\fn parse_unicode_escape(
        \\    value: JsonParser,
        \\    builder: text::StringBuilder,
        \\) -> Result[unit, string] {
        \\    let first = match parse_hex_quad(value) {
        \\        Result::Ok(codepoint) => codepoint,
        \\        Result::Err(error) => return Result::Err(error),
        \\    };
        \\    if first >= 55296 && first <= 56319 {
        \\        if value.index.get() + 2 > value.input.byte_len()
        \\            || value.input.byte_get(value.index.get()) != 92
        \\            || value.input.byte_get(value.index.get() + 1) != 117
        \\        {
        \\            Result::Err(json_error(value, "missing low surrogate"))
        \\        } else {
        \\            value.index.set(value.index.get() + 2);
        \\            let second = match parse_hex_quad(value) {
        \\                Result::Ok(codepoint) => codepoint,
        \\                Result::Err(error) => return Result::Err(error),
        \\            };
        \\            if second < 56320 || second > 57343 {
        \\                Result::Err(json_error(value, "invalid low surrogate"))
        \\            } else {
        \\                write_codepoint(
        \\                    value,
        \\                    builder,
        \\                    65536 + (first - 55296) * 1024 + second - 56320,
        \\                )
        \\            }
        \\        }
        \\    } else if first >= 56320 && first <= 57343 {
        \\        Result::Err(json_error(value, "unexpected low surrogate"))
        \\    } else {
        \\        write_codepoint(value, builder, first)
        \\    }
        \\}
        \\
        \\fn parse_json_string(value: JsonParser) -> Result[string, string] {
        \\    if value.index.get() >= value.input.byte_len()
        \\        || value.input.byte_get(value.index.get()) != 34
        \\    {
        \\        return Result::Err(json_error(value, "expected string"))
        \\    } else {
        \\        value.index.set(value.index.get() + 1)
        \\    };
