pub fn process_source() -> string {
    let source = \\package process;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub struct ExitStatus {
        \\    pub code_value: int,
        \\}
        \\
        \\impl ExitStatus {
        \\    pub fn success(self: ExitStatus) -> bool {
        \\        self.code_value == 0
        \\    }
        \\
        \\    pub fn code(self: ExitStatus) -> Option[int] {
        \\        if self.code_value < 0 {
        \\            Option::None
        \\        } else {
        \\            Option::Some(self.code_value)
        \\        }
        \\    }
        \\}
        \\
        \\pub struct Output {
        \\    pub status_value: ExitStatus,
        \\    pub stdout_value: bytes::Bytes,
        \\    pub stderr_value: bytes::Bytes,
        \\}
        \\
        \\impl Output {
        \\    pub fn status(self: Output) -> ExitStatus {
        \\        self.status_value
        \\    }
        \\
        \\    pub fn stdout(self: Output) -> bytes::Bytes {
        \\        self.stdout_value
        \\    }
        \\
        \\    pub fn stderr(self: Output) -> bytes::Bytes {
        \\        self.stderr_value
        \\    }
        \\}
        \\
        \\pub struct Command {
        \\    pub program: string,
        \\    pub arguments: Vec[string],
        \\    pub has_directory: bool,
        \\    pub directory: string,
        \\    pub environment: Vec[(string, string)],
        \\    pub has_input: bool,
        \\    pub input_value: Vec[uint8],
        \\}
        \\
        \\impl Command {
        \\    pub fn new(program: string) -> Command {
        \\        Command {
        \\            program,
        \\            arguments: Vec::new(),
        \\            has_directory: false,
        \\            directory: "",
        \\            environment: Vec::new(),
        \\            has_input: false,
        \\            input_value: Vec::new(),
        \\        }
        \\    }
        \\
        \\    pub fn arg(self: Command, argument: string) -> Command {
        \\        self.arguments.push(argument);
        \\        self
        \\    }
        \\
        \\    pub fn args(self: Command, arguments: Vec[string]) -> Command {
        \\        for argument in arguments {
        \\            self.arguments.push(argument)
        \\        };
        \\        self
        \\    }
        \\
        \\    pub fn current_dir(self: Command, directory: string) -> Command {
        \\        Command {
        \\            program: self.program,
        \\            arguments: self.arguments,
        \\            has_directory: true,
        \\            directory,
        \\            environment: self.environment,
        \\            has_input: self.has_input,
        \\            input_value: self.input_value,
        \\        }
        \\    }
        \\
        \\    pub fn env(self: Command, key: string, value: string) -> Command {
        \\        self.environment.push((key, value));
        \\        self
        \\    }
        \\
        \\    pub fn input(self: Command, value: bytes::Bytes) -> Command {
        \\        Command {
        \\            program: self.program,
        \\            arguments: self.arguments,
        \\            has_directory: self.has_directory,
        \\            directory: self.directory,
        \\            environment: self.environment,
        \\            has_input: true,
        \\            input_value: value.to_vec(),
        \\        }
        \\    }
        \\
        \\    pub fn output(self: Command) -> Result[Output, string] {
        \\        let (ok, code, stdout, stderr, err) = host::process_output(
        \\            self.program,
        \\            self.arguments,
        \\            self.has_directory,
        \\            self.directory,
        \\            self.environment,
        \\            self.has_input,
        \\            self.input_value,
        \\        );
        \\        if ok {
        \\            Result::Ok(
        \\                Output {
        \\                    status_value: ExitStatus { code_value: code },
        \\                    stdout_value: bytes::Bytes::from_vec(stdout),
        \\                    stderr_value: bytes::Bytes::from_vec(stderr),
        \\                },
        \\            )
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\
        \\    pub fn output_timeout(self: Command, timeout_ms: int) -> Result[(Output, bool), string] {
        \\        let (ok, code, stdout, stderr, err, timed_out) = host::process_output_timeout(
        \\            self.program,
        \\            self.arguments,
        \\            self.has_directory,
        \\            self.directory,
        \\            self.environment,
        \\            self.has_input,
        \\            self.input_value,
        \\            timeout_ms,
        \\        );
        \\        if ok {
        \\            Result::Ok(
        \\                (
        \\                    Output {
        \\                        status_value: ExitStatus { code_value: code },
        \\                        stdout_value: bytes::Bytes::from_vec(stdout),
        \\                        stderr_value: bytes::Bytes::from_vec(stderr),
        \\                    },
        \\                    timed_out,
        \\                ),
        \\            )
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\
        \\    pub fn status(self: Command) -> Result[ExitStatus, string] {
        \\        let (ok, code, err) = host::process_status(
        \\            self.program,
        \\            self.arguments,
        \\            self.has_directory,
        \\            self.directory,
        \\            self.environment,
        \\        );
        \\        if ok {
        \\            Result::Ok(ExitStatus { code_value: code })
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\
        \\    pub fn status_timeout(self: Command, timeout_ms: int) -> Result[(ExitStatus, bool), string] {
        \\        let (ok, code, err, timed_out) = host::process_status_timeout(
        \\            self.program,
        \\            self.arguments,
        \\            self.has_directory,
        \\            self.directory,
        \\            self.environment,
        \\            timeout_ms,
        \\        );
        \\        if ok {
        \\            Result::Ok((ExitStatus { code_value: code }, timed_out))
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\}
        \\
        \\pub fn exit(code: int) -> unit {
        \\    host::exit(code)
        \\}
        \\
        \\pub fn look_path(program: string) -> Result[string, string] {
        \\    let (ok, result, err) = host::process_look_path(program);
        \\    if ok {
        \\        Result::Ok(result)
        \\    } else {
