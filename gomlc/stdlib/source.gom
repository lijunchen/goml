pub fn bytes_source() -> string {
    let source = \\package bytes;
        \\
        \\pub struct Bytes {
        \\    pub values: Vec[byte],
        \\}
        \\
        \\impl Bytes {
        \\    pub fn new() -> Bytes {
        \\        Bytes { values: Vec::new() }
        \\    }
        \\
        \\    pub fn with_capacity(capacity: int) -> Bytes {
        \\        Bytes { values: Vec::with_capacity(capacity) }
        \\    }
        \\
        \\    pub fn from_vec(values: Vec[byte]) -> Bytes {
        \\        Bytes { values }
        \\    }
        \\
        \\    pub fn from_string(value: string) -> Bytes {
        \\        Bytes { values: value.to_bytes() }
        \\    }
        \\
        \\    pub fn len(self: Bytes) -> int {
        \\        self.values.len()
        \\    }
        \\
        \\    pub fn capacity(self: Bytes) -> int {
        \\        self.values.capacity()
        \\    }
        \\
        \\    pub fn is_empty(self: Bytes) -> bool {
        \\        self.values.is_empty()
        \\    }
        \\
        \\    pub fn get(self: Bytes, index: int) -> byte {
        \\        self.values[index]
        \\    }
        \\
        \\    pub fn set(self: Bytes, index: int, value: byte) -> unit {
        \\        self.values[index] = value;
        \\    }
        \\
        \\    pub fn push(self: Bytes, value: byte) -> unit {
        \\        self.values.push(value)
        \\    }
        \\
        \\    pub fn pop(self: Bytes) -> Option[byte] {
        \\        self.values.pop()
        \\    }
        \\
        \\    pub fn reserve(self: Bytes, additional: int) -> unit {
        \\        self.values.reserve(additional)
        \\    }
        \\
        \\    pub fn truncate(self: Bytes, len: int) -> unit {
        \\        self.values.truncate(len)
        \\    }
        \\
        \\    pub fn clear(self: Bytes) -> unit {
        \\        self.values.clear()
        \\    }
        \\
        \\    pub fn slice(self: Bytes, start: int, end: int) -> Slice[byte] {
        \\        self.values.slice(start, end)
        \\    }
        \\
        \\    pub fn to_vec(self: Bytes) -> Vec[byte] {
        \\        self.values
        \\    }
        \\
        \\    pub fn to_string(self: Bytes) -> Result[string, string] {
        \\        let (valid, value) = string_from_utf8(self.values);
        \\        if valid {
        \\            Result::Ok(value)
        \\        } else {
        \\            Result::Err("invalid UTF-8")
        \\        }
        \\    }
        \\}
    ;
    source
}

pub fn fs_source() -> string {
    let source = \\package fs;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub fn read_file(path: string) -> Result[string, string] {
        \\    match read_bytes(path) {
        \\        Ok(data) => data.to_string(),
        \\        Err(error) => Result::Err(error),
        \\    }
        \\}
        \\
        \\pub fn write_file(path: string, content: string) -> Result[unit, string] {
        \\    write_bytes(path, bytes::Bytes::from_string(content))
        \\}
        \\
        \\pub fn read_bytes(path: string) -> Result[bytes::Bytes, string] {
        \\    let (ok, data, err) = host::read_bytes(path);
        \\    if ok {
        \\        Result::Ok(bytes::Bytes::from_vec(data))
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_bytes(path: string, data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_bytes(path, data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn create_dir_all(path: string) -> Result[unit, string] {
        \\    let (ok, err) = host::create_dir_all(path);
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn remove_file(path: string) -> Result[unit, string] {
        \\    let (ok, err) = host::remove_file(path);
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn remove_dir_all(path: string) -> Result[unit, string] {
        \\    let (ok, err) = host::remove_dir_all(path);
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn exists(path: string) -> bool {
        \\    host::file_exists(path)
        \\}
        \\
        \\pub fn is_file(path: string) -> bool {
        \\    host::is_file(path)
        \\}
        \\
        \\pub fn is_dir(path: string) -> bool {
        \\    host::is_dir(path)
        \\}
        \\
        \\pub fn canonicalize(path: string) -> Result[string, string] {
        \\    let (ok, result, err) = host::canonicalize(path);
        \\    if ok {
        \\        Result::Ok(result)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn read_dir(path: string) -> Result[Vec[string], string] {
        \\    let (ok, names, err) = host::read_dir(path);
        \\    if ok {
        \\        Result::Ok(names)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn sha256_file(path: string) -> Result[string, string] {
        \\    let (ok, result, err) = host::sha256_file(path);
        \\    if ok {
        \\        Result::Ok(result)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
    ;
    source
}

pub fn io_source() -> string {
    let source = \\package io;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub fn print[T: ToString](value: T) -> unit {
        \\    host::print(ToString::to_string(value))
        \\}
        \\
        \\pub fn println[T: ToString](value: T) -> unit {
        \\    host::println(ToString::to_string(value))
        \\}
        \\
        \\pub fn eprint[T: ToString](value: T) -> unit {
        \\    host::eprint(ToString::to_string(value))
        \\}
        \\
        \\pub fn eprintln[T: ToString](value: T) -> unit {
        \\    host::eprint(ToString::to_string(value) + "\n")
        \\}
        \\
        \\pub fn read_stdin() -> Result[bytes::Bytes, string] {
        \\    let (ok, data, err) = host::read_stdin();
        \\    if ok {
        \\        Result::Ok(bytes::Bytes::from_vec(data))
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_stdout(data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_stdout(data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_stderr(data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_stderr(data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn read_stdin_exact(length: int) -> Result[bytes::Bytes, string] {
        \\    if length < 0 {
        \\        Result::Err("read length must be non-negative")
        \\    } else {
        \\        let (ok, data, err) = host::read_stdin_exact(length);
        \\        if ok {
        \\            Result::Ok(bytes::Bytes::from_vec(data))
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\}
    ;
    source
}

