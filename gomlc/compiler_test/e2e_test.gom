package compiler_test;

#[test]
fn e2e_fixture_counts_are_stable() -> unit {
    assert_e2e_counts()
}

#[test]
fn e2e_good_shard_0() -> unit {
    assert_e2e_suite("good", 0, 8)
}

#[test]
fn e2e_good_shard_1() -> unit {
    assert_e2e_suite("good", 1, 8)
}

#[test]
fn e2e_good_shard_2() -> unit {
    assert_e2e_suite("good", 2, 8)
}

#[test]
fn e2e_good_shard_3() -> unit {
    assert_e2e_suite("good", 3, 8)
}

#[test]
fn e2e_good_shard_4() -> unit {
    assert_e2e_suite("good", 4, 8)
}

#[test]
fn e2e_good_shard_5() -> unit {
    assert_e2e_suite("good", 5, 8)
}

#[test]
fn e2e_good_shard_6() -> unit {
    assert_e2e_suite("good", 6, 8)
}

#[test]
fn e2e_good_shard_7() -> unit {
    assert_e2e_suite("good", 7, 8)
}

#[test]
fn e2e_bad_shard_0() -> unit {
    assert_e2e_suite("bad", 0, 2)
}

#[test]
fn e2e_bad_shard_1() -> unit {
    assert_e2e_suite("bad", 1, 2)
}
