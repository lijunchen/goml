package lift;

use gomlc::ast;
use gomlc::core;
use gomlc::hir;
use gomlc::mono;
use gomlc::parser;
use gomlc::tast;
use std::testing;

fn lower_source(source: string) -> core::File {
    lower(
        mono::lower(
            core::lower(tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom"))),
        ),
    )
}

#[test]
fn consumes_shared_names_for_lifted_parameters() -> unit {
    let value = mono::lower(
        core::lower(
            tast::check(
                hir::lower(
                    ast::lower(
                        parser::parse(
                            "fn main() { let result = (|x| x + 1)(41); println(result); }",
                        ),
                    ),
                    "main.gom",
                ),
            ),
        ),
    );
    let counter = Ref::new(61);
    let file = lower_with_counter(value, counter);
    testing::assert_eq(counter.get(), 62);
    testing::assert_eq(file.functions.get(1).params.get(0).0, "env61")
}

#[test]
fn flattens_monomorphic_blocks() -> unit {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let mtmp0 = () in\n  let a/0 = (true, false, (true, false)) in\n  let b/5 =\n    let x1 = a/0.0 in\n    let x2 = a/0.1 in\n    let x3 = a/0.2 in\n    let x4 = x3.0 in\n    let x5 = x3.1 in\n    let w/4 = x5 in\n    let z/3 = x4 in\n    let y/2 = x2 in\n    let x/1 = x1 in\n    w/4 in\n  let mtmp6 = print(b/5) in\n  ()\n}",
    )
}

#[test]
fn fills_empty_block_tails() -> unit {
    testing::assert_eq(
        encode(lower_source("fn main() -> unit { let value = 1; }")),
        "fn main() -> unit {\n  let value/0 = 1 in\n  ()\n}",
    )
}

#[test]
fn lifts_closures_in_enum_payloads() -> unit {
    let source = "enum MaybeFn { Some((int32) -> int32), None } fn next(flag: bool) -> MaybeFn { if flag { MaybeFn::Some(|x| x + 1) } else { MaybeFn::None } } fn main() -> unit { match next(true) { MaybeFn::Some(f) => println(f(41).to_string()), MaybeFn::None => println(\"none\"), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn next(flag/0: bool) -> MaybeFn {\n  if flag/0 {\n      MaybeFn::Some(closure_env_next_0 {})\n  } else {\n      MaybeFn::None\n  }\n}\n\nfn main() -> unit {\n  let mtmp0 = next(true) in\n  match mtmp0 {\n    MaybeFn::Some(x1) => {\n      let x1 = MaybeFn::Some._0(mtmp0) in\n      let f/2 = x1 in\n      println(inherent#int32#int32#to_string(f/2(41)))\n    },\n    MaybeFn::None => {\n      println(\"none\")\n    },\n  }\n}\n\nfn inherent#closure_env_next_0#closure_env_next_0#apply(\n  env2: closure_env_next_0,\n  x/1: int32\n) -> int32 {\n  (x/1 + 1)\n}",
    )
}

#[test]
fn ignores_digits_in_monomorphic_function_names() -> unit {
    let source = "fn grow[T](x: T, flag: bool) -> unit { if flag { grow(|n: int32| n + 1, false) } else { println(\"done\") } } fn main() -> unit { grow(1, true) }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  grow__T_int(1, true)\n}\n\nfn grow__T_int(x/0: int, flag/1: bool) -> unit {\n  if flag/1 {\n      grow__T_(int32)->int32(closure_env_grow_T_int_0 {}, false)\n  } else {\n      println(\"done\")\n  }\n}\n\nfn grow__T_(int32)->int32(x/0: (int32) -> int32, flag/1: bool) -> unit {\n  if flag/1 {\n      grow__T_(int32)->int32(closure_env_grow_T_int32_int32_1 {}, false)\n  } else {\n      println(\"done\")\n  }\n}\n\nfn inherent#closure_env_grow_T_int_0#closure_env_grow_T_int_0#apply(\n  env0: closure_env_grow_T_int_0,\n  n/2: int32\n) -> int32 {\n  (n/2 + 1)\n}\n\nfn inherent#closure_env_grow_T_int32_int32_1#closure_env_grow_T_int32_int32_1#apply(\n  env1: closure_env_grow_T_int32_int32_1,\n  n/2: int32\n) -> int32 {\n  (n/2 + 1)\n}",
    )
}

#[test]
fn preserves_immediate_closure_calls() -> unit {
    let source = "fn main() { let result = (|x| x + 1)(41); println(result.to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let result/1 = closure_env_main_0 {}(41) in\n  let _wild0 = println(inherent#int#int#to_string(result/1)) in\n  ()\n}\n\nfn inherent#closure_env_main_0#closure_env_main_0#apply(env1: closure_env_main_0, x/0: int) -> int {\n  (x/0 + 1)\n}",
    )
}

#[test]
fn avoids_existing_closure_environment_names() -> unit {
    let source = "struct ClosureEnvF0 { value: int32 } fn main() -> unit { let _ = ClosureEnvF0 { value: 1 }; let f = |x: int32| x + 1; println(f(2).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let mtmp0 = ClosureEnvF0 { value: 1 } in\n  let f/1 = closure_env_f_0 {} in\n  let _wild1 =\n    println(\n      inherent#int32#int32#to_string(inherent#closure_env_f_0#closure_env_f_0#apply(f/1, 2))\n    ) in\n  ()\n}\n\nfn inherent#closure_env_f_0#closure_env_f_0#apply(env2: closure_env_f_0, x/0: int32) -> int32 {\n  (x/0 + 1)\n}",
    )
}

#[test]
fn eliminates_dead_lifted_locals() -> unit {
    let value = lower_source(
        "fn effect() -> int32 { 1 } fn main() -> unit { let dead = (1, 2); let kept = effect(); () }",
    );
    let output = encode(dce(value));
    testing::assert(!output.contains("dead/"));
    testing::assert(output.contains("let kept/"))
}
