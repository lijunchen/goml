package lift;

use gomlc::mono;

fn empty_file() -> File {
    File {
        functions: Vec::from_array([]),
        enums: Vec::from_array([]),
        structs: Vec::from_array([]),
        type_instances: Vec::from_array([]),
        constants: Vec::from_array([]),
        statics: Vec::from_array([]),
        closure_defs: Vec::from_array([]),
    }
}

fn finish_lowering(value: LambdaLiftResult) -> Result[File, string] {
    match value.error {
        Some(message) => Result::Err(message),
        None => {
            let file = detach_file(value.file);
            match validate(file) {
                Ok(_) => Result::Ok(file),
                Err(message) => Result::Err("invalid Lift IR: " + message),
            }
        },
    }
}

pub fn lower_checked(value: mono::File) -> Result[File, string] {
    finish_lowering(lambda_lift(value))
}

pub fn lower_checked_with_counter(value: mono::File, counter: Ref[int]) -> Result[File, string] {
    finish_lowering(lambda_lift_with_counter(value, counter))
}

pub fn lower(value: mono::File) -> File {
    match lower_checked(value) {
        Ok(value) => value,
        Err(_) => empty_file(),
    }
}

pub fn lower_with_counter(value: mono::File, counter: Ref[int]) -> File {
    match lower_checked_with_counter(value, counter) {
        Ok(value) => value,
        Err(_) => empty_file(),
    }
}
