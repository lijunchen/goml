package lift;

use gomlc::mono;
use gomlc::tast;
use std::ascii;
use std::collections;
use std::text;

struct ScopeEntry {
    name: string,
    ty: tast::Type,
    closure_struct: Option[string],
}

struct ClosureInfo {
    struct_name: string,
    apply_name: string,
    apply_ty: tast::Type,
}

struct Capture {
    name: string,
    ty: tast::Type,
}

struct State {
    next_env: Ref[int],
    next_name: Ref[int],
    generated: Vec[Function],
    generated_structs: Vec[tast::StructDef],
    closures: Vec[ClosureInfo],
    used_types: Vec[string],
}

fn copy_scope(values: Vec[ScopeEntry]) -> Vec[ScopeEntry] {
    let result: Vec[ScopeEntry] = Vec::[];
    for value in values {
        result.push(value)
    }
    result
}

fn find_scope(values: Vec[ScopeEntry], name: string) -> Option[ScopeEntry] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index = index - 1;
        }
    }
    Option::None
}

fn find_closure(state: State, name: string) -> Option[ClosureInfo] {
    for value in state.closures {
        if value.struct_name == name {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn closure_for_type(state: State, ty: tast::Type) -> Option[ClosureInfo] {
    match tast::resolve_type(ty) {
        Con { name } => find_closure(state, name),
        _ => Option::None,
    }
}

fn record_used_type(values: Vec[string], name: string) -> unit {
    if collections::contains(values, name) {} else {
        values.push(name)
    }
}

fn collect_used_types(values: Vec[string], ty: tast::Type) -> unit {
    match tast::resolve_type(ty) {
        Con { name } => record_used_type(values, name),
        Tuple { items } => {
            for item in items {
                collect_used_types(values, item)
            }
        },
        Projection { for_ty: base, name: _, trait_ref: _ } => collect_used_types(values, base),
        App { ty: base, args } => {
            collect_used_types(values, base);
            for arg in args {
                collect_used_types(values, arg)
            }
        },
        Array { len: _, elem } | Slice { elem } | VecType { elem } | RefType { elem } | Channel {
            elem,
        } => collect_used_types(values, elem),
        HashMap { key, value } => {
            collect_used_types(values, key);
            collect_used_types(values, value)
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_used_types(values, param)
            }
            collect_used_types(values, ret_ty)
        },
        _ => (),
    }
}

fn collect_used_exprs(values: Vec[string], exprs: Vec[mono::Expr]) -> unit {
    for expr in exprs {
        collect_used_expr(values, expr)
    }
}

fn collect_used_optional_expr(values: Vec[string], expr: Option[mono::Expr]) -> unit {
    match expr {
        Some(expr) => collect_used_expr(values, expr),
        None => (),
    }
}

fn collect_used_block(values: Vec[string], block: mono::Block) -> unit {
    for stmt in block.stmts {
        collect_used_types(values, stmt.ty);
        collect_used_expr(values, stmt.value)
    }
    collect_used_optional_expr(values, block.tail)
}

fn collect_used_expr(values: Vec[string], expr: mono::Expr) -> unit {
    collect_used_types(values, mono::expr_type(expr));
    match expr {
        Constr { constructor: _, args, ty: _ } => collect_used_exprs(values, args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            collect_used_exprs(values, items)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                collect_used_types(values, param.ty)
            }
            collect_used_expr(values, body)
        },
        Block { block, ty: _ } => collect_used_block(values, block),
        Match { expr: scrutinee, arms, default, ty: _ } => {
            collect_used_expr(values, scrutinee);
            for arm in arms {
                collect_used_expr(values, arm.lhs);
                collect_used_expr(values, arm.body)
            }
            collect_used_optional_expr(values, default)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            collect_used_expr(values, cond);
            collect_used_expr(values, then_);
            collect_used_expr(values, else_)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            collect_used_expr(values, cond);
            collect_used_expr(values, body)
        },
        Loop { body, ty: _ } => collect_used_expr(values, body),
        Return { expr, ty: _ } => collect_used_optional_expr(values, expr),
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | Proj { tuple: expr, index: _, ty: _ } => collect_used_expr(
            values,
            expr,
        ),
        Assign { name: _, value: expr, target_ty, ty: _ } => {
            collect_used_types(values, target_ty);
            collect_used_expr(values, expr)
        },
        Call { func, args, ty: _ } => {
            collect_used_expr(values, func);
            collect_used_exprs(values, args)
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            collect_used_types(values, for_ty);
            collect_used_expr(values, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_used_expr(values, receiver);
            collect_used_exprs(values, args)
        },
        Break { value, ty: _, .. } => match value {
            Some(expr) => collect_used_expr(values, expr),
            None => (),
        },
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
    }
}

fn initial_used_types(value: mono::File) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for function in value.functions {
        for param in function.params {
            collect_used_types(result, param.1)
        }
        collect_used_types(result, function.ret_ty);
        match function.trait_impl {
            Some(value) => {
                collect_used_types(result, value.for_ty);
                for associated in value.associated_types {
                    collect_used_types(result, associated.1)
                }
            },
            None => (),
        };
        collect_used_block(result, function.body)
    }
    result
}

fn primary_name(value: string) -> string {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'/' {
            return value.byte_slice(0, index)
        } else {}
    }
    value
}

fn sanitize_name(value: string) -> Option[string] {
    let value = primary_name(value);
    let builder = text::StringBuilder::new();
    let mut pending_separator = false;
    let mut wrote = false;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if ascii::is_alphanumeric(byte) {
            if pending_separator && wrote {
                builder.write_char('_')
            } else {};
            if !wrote && byte >= b'0' && byte <= b'9' {
                builder.write_char('_')
            } else {};
            builder.write_string(value.byte_slice(index, index + 1));
            pending_separator = false;
            wrote = true;
        } else if wrote {
            pending_separator = true;
        } else {}
    }
    if wrote {
        Option::Some(builder.finish())
    } else {
        Option::None
    }
}

fn fresh_struct_name(state: State, hint: Option[string]) -> string {
    loop {
        let index = state.next_env.get();
        state.next_env.set(index + 1);
        let candidate = match hint {
            Some(name) => "closure_env_" + name + "_" + index.to_string(),
            None => "closure_env_" + index.to_string(),
        };
        if collections::contains(state.used_types, candidate) {} else {
            state.used_types.push(candidate);
            return candidate
        }
    }
}

fn fresh_name(state: State, prefix: string) -> string {
    let index = state.next_name.get();
    state.next_name.set(index + 1);
    prefix + index.to_string()
}

fn trailing_number(value: string) -> Option[int] {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'/' {
            return Option::None
        } else {}
    }
    if value.byte_len() == 0 {
        Option::None
    } else {
        let mut start = value.byte_len();
        let mut index = value.byte_len();
        while index > 0 {
            let next = index - 1;
            let byte = value.byte_get(next);
            if byte >= b'0' && byte <= b'9' {
                start = next;
                index = next;
            } else {
                break
            }
        }
        if start == value.byte_len() {
            Option::None
        } else {
            Option::Some(parse_digits(value, start))
        }
    }
}

fn parse_digits(value: string, start: int) -> int {
    let mut result = 0;
    for index in start..value.byte_len() {
        let byte = value.byte_get(index);
        let digit = if byte == b'0' {
            0
        } else if byte == b'1' {
            1
        } else if byte == b'2' {
            2
        } else if byte == b'3' {
            3
        } else if byte == b'4' {
            4
        } else if byte == b'5' {
            5
        } else if byte == b'6' {
            6
        } else if byte == b'7' {
            7
        } else if byte == b'8' {
            8
        } else {
            9
        };
        result = result * 10 + digit;
    }
    result
}

fn observe_name(maximum: Ref[int], name: string) -> unit {
    match trailing_number(name) {
        Some(value) => if value > maximum.get() {
            maximum.set(value)
        } else {},
        None => (),
    }
}

fn observe_exprs(maximum: Ref[int], values: Vec[mono::Expr]) -> unit {
    for value in values {
        observe_expr(maximum, value)
    }
}

fn observe_optional_expr(maximum: Ref[int], value: Option[mono::Expr]) -> unit {
    match value {
        Some(value) => observe_expr(maximum, value),
        None => (),
    }
}

fn observe_block(maximum: Ref[int], value: mono::Block) -> unit {
    for stmt in value.stmts {
        observe_name(maximum, stmt.name);
        observe_expr(maximum, stmt.value)
    }
    observe_optional_expr(maximum, value.tail)
}

fn observe_expr(maximum: Ref[int], value: mono::Expr) -> unit {
    match value {
        Var { name: _, ty: _ } => (),
        Constr { constructor: _, args, ty: _ } => observe_exprs(maximum, args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            observe_exprs(maximum, items)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                observe_name(maximum, param.name)
            }
            observe_expr(maximum, body)
        },
        Block { block, ty: _ } => observe_block(maximum, block),
        Match { expr, arms, default, ty: _ } => {
            observe_expr(maximum, expr);
            for arm in arms {
                observe_expr(maximum, arm.lhs);
                observe_expr(maximum, arm.body)
            }
            observe_optional_expr(maximum, default)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            observe_expr(maximum, cond);
            observe_expr(maximum, then_);
            observe_expr(maximum, else_)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            observe_expr(maximum, cond);
            observe_expr(maximum, body)
        },
        Loop { body, ty: _ } => observe_expr(maximum, body),
        Return { expr, ty: _ } => observe_optional_expr(maximum, expr),
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => observe_expr(maximum, expr),
        Assign { name: _, value: expr, target_ty: _, ty: _ } => observe_expr(maximum, expr),
        Call { func, args, ty: _ } => {
            observe_expr(maximum, func);
            observe_exprs(maximum, args)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            observe_expr(maximum, receiver);
            observe_exprs(maximum, args)
        },
        Break { value, ty: _, .. } => observe_optional_expr(maximum, value),
        Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue { ty: _, .. } => (),
    }
}

fn initial_name_counter(value: mono::File) -> int {
    let maximum = Ref::new(-1);
    for function in value.functions {
        for param in function.params {
            observe_name(maximum, param.0)
        }
        observe_block(maximum, function.body)
    }
    maximum.get() + 1
}

fn transform_exprs(
    state: State,
    scope: Vec[ScopeEntry],
    values: Vec[mono::Expr],
    context: Option[string],
) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::[];
    for value in values {
        result.push(transform_expr(state, scope, value, context))
    }
    result
}

fn transform_optional_expr(
    state: State,
    scope: Vec[ScopeEntry],
    value: Option[mono::Expr],
    context: Option[string],
) -> Option[Expr] {
    match value {
        Some(value) => {
            Option::Some(transform_expr(state, scope, value, context))
        },
        None => Option::None,
    }
}

fn block_type(value: Block) -> tast::Type {
    match value.tail {
        Some(value) => expr_type(value),
        None => tast::Type::Unit,
    }
}

fn transform_block(
    state: State,
    outer_scope: Vec[ScopeEntry],
    value: mono::Block,
    context: Option[string],
) -> Block {
    let scope = copy_scope(outer_scope);
    let stmts: Vec[LetStmt] = Vec::[];
    for stmt in value.stmts {
        let transformed = match stmt.value {
            Closure { params, body, ty } => transform_closure(
                state,
                scope,
                params,
                body,
                ty,
                Option::Some(stmt.name),
                context,
            ),
            other => transform_expr(state, scope, other, context),
        };
        let ty = expr_type(transformed);
        let closure_struct = match closure_for_type(state, ty) {
            Some(info) => Option::Some(info.struct_name),
            None => Option::None,
        };
        stmts.push(LetStmt { name: stmt.name, value: transformed, ty });
        scope.push(ScopeEntry { name: stmt.name, ty, closure_struct })
    }
    Block { stmts, tail: transform_optional_expr(state, scope, value.tail, context) }
}

fn transform_arm(state: State, scope: Vec[ScopeEntry], value: mono::Arm, context: Option[string]) -> Arm {
    Arm {
        lhs: transform_expr(state, scope, value.lhs, context),
        body: transform_expr(state, scope, value.body, context),
    }
}

fn transform_arms(
    state: State,
    scope: Vec[ScopeEntry],
    values: Vec[mono::Arm],
    context: Option[string],
) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::[];
    for value in values {
        result.push(transform_arm(state, scope, value, context))
    }
    result
}

fn transform_call(
    state: State,
    scope: Vec[ScopeEntry],
    func: mono::Expr,
    args: Vec[mono::Expr],
    ty: tast::Type,
    context: Option[string],
) -> Expr {
    let func = transform_expr(state, scope, func, context);
    let args = transform_exprs(state, scope, args, context);
    let closure = match func {
        Var { name, ty: _ } => match find_scope(scope, name) {
            Some(entry) => match entry.closure_struct {
                Some(name) => find_closure(state, name),
                None => closure_for_type(state, entry.ty),
            },
            None => Option::None,
        },
        _ => closure_for_type(state, expr_type(func)),
    };
    match closure {
        Some(info) => {
            let call_args: Vec[Expr] = Vec::[];
            call_args.push(func);
            for arg in args {
                call_args.push(arg)
            }
            Expr::Call {
                func: Expr::Var { name: info.apply_name, ty: info.apply_ty },
                args: call_args,
                ty,
            }
        },
        None => Expr::Call { func, args, ty },
    }
}

fn transform_expr(state: State, scope: Vec[ScopeEntry], value: mono::Expr, context: Option[string]) -> Expr {
    match value {
        Var { name, ty } => match find_scope(scope, name) {
            Some(entry) => Expr::Var { name, ty: entry.ty },
            None => Expr::Var { name, ty },
        },
        Callable { callable, ty } => Expr::Callable { callable, ty },
        Prim { value, ty } => Expr::Prim { value, ty },
        Constr { constructor, args, ty } => Expr::Constr {
            constructor,
            args: transform_exprs(state, scope, args, context),
            ty,
        },
        Tuple { items, ty } => Expr::Tuple {
            items: transform_exprs(state, scope, items, context),
            ty,
        },
        Array { items, ty } => Expr::Array {
            items: transform_exprs(state, scope, items, context),
            ty,
        },
        Closure { params, body, ty } => transform_closure(
            state,
            scope,
            params,
            body,
            ty,
            Option::None,
            context,
        ),
        Block { block, ty: _ } => {
            let block = transform_block(state, scope, block, context);
            Expr::Block { block, ty: block_type(block) }
        },
        Match { expr, arms, default, ty } => Expr::Match {
            expr: transform_expr(state, scope, expr, context),
            arms: transform_arms(state, scope, arms, context),
            default: transform_optional_expr(state, scope, default, context),
            ty,
        },
        If { cond, then_branch: then_, else_branch: else_, ty } => Expr::If {
            cond: transform_expr(state, scope, cond, context),
            then_branch: transform_expr(state, scope, then_, context),
            else_branch: transform_expr(state, scope, else_, context),
            ty,
        },
        While { cond, body, ty } => Expr::While {
            cond: transform_expr(state, scope, cond, context),
            body: transform_expr(state, scope, body, context),
            ty,
        },
        Loop { body, ty } => {
            Expr::Loop { body: transform_expr(state, scope, body, context), ty }
        },
        Break { target, value, ty } => Expr::Break {
            target,
            value: transform_optional_expr(state, scope, value, context),
            ty,
        },
        Continue { target, ty } => Expr::Continue { target, ty },
        Return { expr, ty } => Expr::Return {
            expr: transform_optional_expr(state, scope, expr, context),
            ty,
        },
        Go { expr, ty } => Expr::Go { expr: transform_expr(state, scope, expr, context), ty },
        ConstrGet { expr, constructor, field_index: index, ty } => Expr::ConstrGet {
            expr: transform_expr(state, scope, expr, context),
            constructor,
            field_index: index,
            ty,
        },
        Unary { op, expr, ty } => Expr::Unary {
            op,
            expr: transform_expr(state, scope, expr, context),
            ty,
        },
        Cast { expr, ty } => Expr::Cast { expr: transform_expr(state, scope, expr, context), ty },
        Binary { op, lhs, rhs, ty } => Expr::Binary {
            op,
            lhs: transform_expr(state, scope, lhs, context),
            rhs: transform_expr(state, scope, rhs, context),
            ty,
        },
        Assign { name, value: expr, target_ty, ty } => Expr::Assign {
            name,
            value: transform_expr(state, scope, expr, context),
            target_ty,
            ty,
        },
        Call { func, args, ty } => {
            transform_call(state, scope, func, args, ty, context)
        },
        ToDyn { trait_name, for_ty, expr, ty } => Expr::ToDyn {
            trait_name,
            for_ty,
            expr: transform_expr(state, scope, expr, context),
            ty,
        },
        DynCall { trait_name, method_name, receiver, args, ty } => {
            Expr::DynCall {
                trait_name,
                method_name,
                receiver: transform_expr(state, scope, receiver, context),
                args: transform_exprs(state, scope, args, context),
                ty,
            }
        },
        Proj { tuple: expr, index, ty } => Expr::Proj {
            tuple: transform_expr(state, scope, expr, context),
            index,
            ty,
        },
    }
}

fn capture_exists(values: Vec[Capture], name: string) -> bool {
    for value in values {
        if value.name == name {
            return true
        } else {}
    }
    false
}

fn collect_captured_exprs(
    values: Vec[Expr],
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> unit {
    for value in values {
        collect_captured(value, bound, captured, scope)
    }
}

fn collect_captured_optional(
    value: Option[Expr],
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> unit {
    match value {
        Some(value) => collect_captured(value, bound, captured, scope),
        None => (),
    }
}

fn collect_captured_block(
    value: Block,
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> unit {
    let mut added = 0;
    for stmt in value.stmts {
        collect_captured(stmt.value, bound, captured, scope);
        bound.push(stmt.name);
        added = added + 1;
    }
    collect_captured_optional(value.tail, bound, captured, scope);
    for _ in 0..added {
        let _ = bound.pop();
    }
}

fn collect_captured(value: Expr, bound: Vec[string], captured: Vec[Capture], scope: Vec[ScopeEntry]) -> unit {
    match value {
        Var { name, ty: _ } => if collections::contains(bound, name) {} else {
            match find_scope(scope, name) {
                Some(entry) => if capture_exists(captured, name) {} else {
                    captured.push(Capture { name, ty: entry.ty })
                },
                None => (),
            }
        },
        Constr { constructor: _, args, ty: _ } => {
            collect_captured_exprs(args, bound, captured, scope)
        },
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            collect_captured_exprs(items, bound, captured, scope)
        },
        Block { block, ty: _ } => {
            collect_captured_block(block, bound, captured, scope)
        },
        Match { expr, arms, default, ty: _ } => {
            collect_captured(expr, bound, captured, scope);
            for arm in arms {
                collect_captured(arm.lhs, bound, captured, scope);
                collect_captured(arm.body, bound, captured, scope)
            }
            collect_captured_optional(default, bound, captured, scope)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            collect_captured(cond, bound, captured, scope);
            collect_captured(then_, bound, captured, scope);
            collect_captured(else_, bound, captured, scope)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            collect_captured(cond, bound, captured, scope);
            collect_captured(body, bound, captured, scope)
        },
        Loop { body, ty: _ } => collect_captured(body, bound, captured, scope),
        Return { expr, ty: _ } => {
            collect_captured_optional(expr, bound, captured, scope)
        },
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => {
            collect_captured(expr, bound, captured, scope)
        },
        Assign { name: _, value: expr, target_ty: _, ty: _ } => {
            collect_captured(expr, bound, captured, scope)
        },
        Call { func, args, ty: _ } => {
            collect_captured(func, bound, captured, scope);
            collect_captured_exprs(args, bound, captured, scope)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_captured(receiver, bound, captured, scope);
            collect_captured_exprs(args, bound, captured, scope)
        },
        Break { value, ty: _, .. } => match value {
            Some(expr) => collect_captured(expr, bound, captured, scope),
            None => (),
        },
        Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue { ty: _, .. } | Invalid {
            ty: _,
        } => (),
    }
}

fn make_field_name(name: string, index: int) -> string {
    match sanitize_name(name) {
        Some(name) => name + "_" + index.to_string(),
        None => "field_" + index.to_string(),
    }
}

fn closure_body_block(value: Expr) -> Block {
    match value {
        Block { block, ty: _ } => block,
        other => Block { stmts: Vec::[], tail: Option::Some(other) },
    }
}

fn prepend_captures(
    body: Block,
    captures: Vec[Capture],
    env_name: string,
    env_ty: tast::Type,
    constructor: tast::Constructor,
) -> Block {
    let stmts: Vec[LetStmt] = Vec::[];
    for index in 0..captures.len() {
        let capture = captures[index];
        stmts.push(
            LetStmt {
                name: capture.name,
                value: Expr::ConstrGet {
                    expr: Expr::Var { name: env_name, ty: env_ty },
                    constructor,
                    field_index: index,
                    ty: capture.ty,
                },
                ty: capture.ty,
            },
        )
    }
    for stmt in body.stmts {
        stmts.push(stmt)
    }
    Block { stmts, tail: body.tail }
}

fn transform_closure(
    state: State,
    outer_scope: Vec[ScopeEntry],
    params: Vec[tast::ClosureParam],
    body: mono::Expr,
    ty: tast::Type,
    name_hint: Option[string],
    context: Option[string],
) -> Expr {
    let signature = match tast::resolve_type(ty) {
        Func { params: param_tys, ret_ty } => Option::Some((param_tys, ret_ty)),
        _ => Option::None,
    };
    match signature {
        Some(signature) => {
            let closure_scope = copy_scope(outer_scope);
            let lowered_params: Vec[(string, tast::Type)] = Vec::[];
            let bound: Vec[string] = Vec::[];
            for index in 0..params.len() {
                let param = params[index];
                let param_ty = signature.0[index];
                closure_scope.push(
                    ScopeEntry {
                        name: param.name,
                        ty: param_ty,
                        closure_struct: match closure_for_type(state, param_ty) {
                            Some(info) => Option::Some(info.struct_name),
                            None => Option::None,
                        },
                    },
                );
                lowered_params.push((param.name, param_ty));
                bound.push(param.name)
            }
            let hint = match name_hint {
                Some(name) => match sanitize_name(name) {
                    Some(name) => Option::Some(name),
                    None => context,
                },
                None => context,
            };
            let body = transform_expr(state, closure_scope, body, hint);
            let captures: Vec[Capture] = Vec::[];
            collect_captured(body, bound, captures, outer_scope);
            let struct_name = fresh_struct_name(state, hint);
            let env_ty = tast::Type::Con { name: struct_name };
            let fields: Vec[string] = Vec::[];
            let struct_fields: Vec[(string, tast::Type)] = Vec::[];
            let captured_args: Vec[Expr] = Vec::[];
            for index in 0..captures.len() {
                let capture = captures[index];
                let field_name = make_field_name(capture.name, index);
                fields.push(field_name);
                struct_fields.push((field_name, capture.ty));
                captured_args.push(Expr::Var { name: capture.name, ty: capture.ty })
            }
            let constructor = tast::Constructor {
                name: struct_name,
                fields,
                is_struct: true,
                tag: Option::None,
            };
            let apply_name = "inherent#" + struct_name + "#" + struct_name + "#apply";
            let env_name = fresh_name(state, "env");
            let fn_params: Vec[(string, tast::Type)] = Vec::[];
            fn_params.push((env_name, env_ty));
            let apply_param_types: Vec[tast::Type] = Vec::[];
            apply_param_types.push(env_ty);
            for param in lowered_params {
                fn_params.push(param);
                apply_param_types.push(param.1)
            }
            let apply_ty = tast::Type::Func { params: apply_param_types, ret_ty: signature.1 };
            state.closures.push(ClosureInfo { struct_name, apply_name, apply_ty });
            state.generated_structs.push(
                tast::StructDef {
                    name: struct_name,
                    generics: Vec::[],
                    fields: struct_fields,
                    public_fields: Vec::[],
                    has_hidden_fields: false,
                },
            );
            let fn_body = prepend_captures(
                closure_body_block(body),
                captures,
                env_name,
                env_ty,
                constructor,
            );
            state.generated.push(
                Function {
                    name: apply_name,
                    origin: FunctionOrigin::Inherent { owner: env_ty, method_name: "apply" },
                    root: true,
                    trait_impl: Option::None,
                    params: fn_params,
                    ret_ty: signature.1,
                    body: fn_body,
                },
            );
            Expr::Constr { constructor, args: captured_args, ty: env_ty }
        },
        None => Expr::Invalid { ty },
    }
}

fn transform_function_origin(value: mono::FunctionOrigin) -> FunctionOrigin {
    match value {
        Source => FunctionOrigin::Source,
        Inherent { owner, method_name } => FunctionOrigin::Inherent { owner, method_name },
        TraitImplementation { method_name } => FunctionOrigin::TraitImplementation { method_name },
    }
}

fn transform_trait_impl(value: Option[mono::TraitImpl]) -> Option[TraitImpl] {
    match value {
        Some(value) => Option::Some(
            TraitImpl {
                trait_ref: value.trait_ref,
                for_ty: value.for_ty,
                associated_types: value.associated_types,
            },
        ),
        None => Option::None,
    }
}

fn transform_function(state: State, value: mono::Function) -> Function {
    let scope: Vec[ScopeEntry] = Vec::[];
    for param in value.params {
        scope.push(
            ScopeEntry {
                name: param.0,
                ty: param.1,
                closure_struct: match closure_for_type(state, param.1) {
                    Some(info) => Option::Some(info.struct_name),
                    None => Option::None,
                },
            },
        )
    }
    let context = sanitize_name(value.name);
    Function {
        name: value.name,
        origin: transform_function_origin(value.origin),
        root: value.root,
        trait_impl: transform_trait_impl(value.trait_impl),
        params: value.params,
        ret_ty: value.ret_ty,
        body: transform_block(state, scope, value.body, context),
    }
}

fn transform_type_instances(values: Vec[mono::TypeInstance]) -> Vec[TypeInstance] {
    let result: Vec[TypeInstance] = Vec::with_capacity(values.len());
    for value in values {
        result.push(TypeInstance { base_name: value.base_name, args: value.args, name: value.name })
    }
    result
}

fn lambda_lift_with_counter(value: mono::File, counter: Ref[int]) -> File {
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = transform_type_instances(value.type_instances);
    let constants = value.constants;
    let state = State {
        next_env: Ref::new(0),
        next_name: counter,
        generated: Vec::[],
        generated_structs: Vec::[],
        closures: Vec::[],
        used_types: initial_used_types(value),
    };
    let functions: Vec[Function] = Vec::[];
    for function in value.functions {
        functions.push(transform_function(state, function))
    }
    for function in state.generated {
        functions.push(function)
    }
    for generated_struct in state.generated_structs {
        structs.push(generated_struct)
    }
    let closure_environments: Vec[string] = Vec::with_capacity(state.closures.len());
    for info in state.closures {
        closure_environments.push(info.struct_name)
    }
    File { functions, enums, structs, type_instances, constants, closure_environments }
}

fn lambda_lift(value: mono::File) -> File {
    let counter = Ref::new(initial_name_counter(value));
    lambda_lift_with_counter(value, counter)
}
