package snapshot_names;

use std::testing;

#[test]
fn canonicalizes_ids_by_prefix() -> () {
    let values = names();
    testing::assert_eq(canonical(values, "self/401"), "self/0");
    testing::assert_eq(canonical(values, "self/812"), "self/1");
    testing::assert_eq(canonical(values, "mtmp802"), "mtmp0");
    testing::assert_eq(canonical(values, "_wild803"), "_wild0");
    testing::assert_eq(canonical(values, "mtmp802"), "mtmp0");
    testing::assert_eq(canonical(values, "stable"), "stable")
}

#[test]
fn skips_exact_reserved_names() -> () {
    let values = names();
    reserve(values, "t1");
    reserve(values, "t3");
    testing::assert_eq(canonical(values, "t801"), "t0");
    testing::assert_eq(canonical(values, "t802"), "t2");
    testing::assert_eq(canonical(values, "t803"), "t4")
}
