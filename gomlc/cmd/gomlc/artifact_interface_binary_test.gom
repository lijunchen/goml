package main;

use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::ast;
use module::ctir;
use module::hir;
use module::parser;
use module::resources;
use module::tast;
use std::bytes;
use std::testing;

fn binary_interface_fixture() -> artifact::ArtifactInterfaceUnit {
    interface_codec::new_unit(
        "audit::value",
        interface_codec::empty_exports(),
        artifact::ArtifactPackageInterface {
            package_name: "audit::value",
            name: "value",
            value_exports: Vec::new(),
            enum_variants: Vec::new(),
        },
        Vec::from_array([("builtin", "0123456789abcdef")]),
    )
}

fn binary_comptime_module(value: int, source_path: string) -> ctir::CtModule {
    let ty = ctir::CtType::Integer { signed: true, width: 64 };
    let module = ctir::empty_module("audit::comptime");
    module.origins.set(0, ctir::CtOrigin { source_path, start: 10, end: 20 });
    module.functions.push(
        ctir::CtFunction {
            id: 0,
            name: "audit::comptime::value",
            parameter_slots: Vec::from_array([]),
            parameter_types: Vec::from_array([]),
            local_count: 0,
            local_types: Vec::from_array([]),
            return_type: ty,
            body: ctir::CtBlock {
                statements: Vec::from_array([]),
                tail: Option::Some(
                    ctir::CtExpr {
                        kind: ctir::CtExprKind::Value(
                            ctir::CtValue::Integer {
                                signed: true,
                                width: 64,
                                bits: value.to_uint64(),
                            },
                        ),
                        ty,
                        origin: 0,
                    },
                ),
                origin: 0,
            },
            origin: 0,
        },
    );
    module.entries.push(
        ctir::CtEntry { name: "audit::comptime::value", function_id: 0, public: true },
    );
    module
}

fn binary_comptime_interface(value: int, source_path: string) -> artifact::ArtifactInterfaceUnit {
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            name: "audit::comptime::value",
            comptime: tast::ComptimeCapability::Capable,
            type_params: Vec::from_array([]),
            constraints: Vec::from_array([]),
            ty: tast::Type::Func { params: Vec::from_array([]), ret_ty: tast::Type::Int },
            body: tast::Callable::Function("audit::comptime::value"),
        },
    );
    interface_codec::new_unit_with_comptime(
        "audit::comptime",
        exports,
        artifact::ArtifactPackageInterface {
            package_name: "audit::comptime",
            name: "comptime",
            value_exports: Vec::from_array([("audit::comptime::value", 0)]),
            enum_variants: Vec::from_array([]),
        },
        Option::Some(interface_codec::new_comptime_unit(binary_comptime_module(value, source_path))),
        Vec::from_array([]),
    )
}

fn source_interface(source: string) -> artifact::ArtifactInterfaceUnit {
    let lowered_ast = ast::lower(parser::parse(source));
    let public_names = public_item_names(Vec::from_array([lowered_ast]), "audit::value");
    let lowered = hir::lower_package(lowered_ast, "value.gom", "audit::value");
    let hir_file = match lowered.hir {
        Some(value) => value,
        None => {
            testing::fail("expected source interface HIR");
            hir::File {
                package_name: "audit::value",
                path: "value.gom",
                source_path: "value.gom",
                imports: Vec::from_array([]),
                import_aliases: Vec::from_array([]),
                use_traits: Vec::from_array([]),
                public_reexports: Vec::from_array([]),
                items: Vec::from_array([]),
                invalid_self_type_spans: Vec::from_array([]),
            }
        },
    };
    let signatures = match tast::package_signatures(hir_file) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            tast::PackageSignatures {
                traits: Vec::from_array([]),
                functions: Vec::from_array([]),
                type_aliases: Vec::from_array([]),
                constants: Vec::from_array([]),
            }
        },
    };
    let checked = tast::check_package_files_for_link_with_dependencies(
        Vec::from_array([hir_file]),
        Vec::from_array([]),
    );
    if checked.diagnostics.is_empty() {} else {
        testing::fail(checked.diagnostics[0].message)
    };
    let file = match checked.tast {
        Some(value) => value,
        None => {
            testing::fail("expected source interface TAST");
            tast::File {
                items: Vec::from_array([]),
                enums: Vec::from_array([]),
                structs: Vec::from_array([]),
                constants: Vec::from_array([]),
                statics: Vec::from_array([]),
            }
        },
    };
    let exports = required_artifact_package_exports(
        file,
        signatures,
        "audit::value",
        public_names,
        Vec::from_array([]),
        true,
        Vec::from_array([]),
        Vec::from_array([]),
    );
    interface_codec::new_unit_with_comptime(
        "audit::value",
        exports,
        artifact_package_interface("audit::value", "value", exports),
        artifact_comptime_unit(checked.comptime, exports),
        Vec::from_array([]),
    )
}

#[test]
fn binary_artifact_value_round_trips_value_shapes() -> unit {
    let value = wire::ArtifactValue::Object(
        Vec::from_array(
            [
                ("null", wire::ArtifactValue::Null),
                ("false", wire::ArtifactValue::Bool(false)),
                ("true", wire::ArtifactValue::Bool(true)),
                ("number", wire::ArtifactValue::Number("-12.5e2")),
                ("string", wire::ArtifactValue::String("hello")),
                (
                    "array",
                    wire::ArtifactValue::Array(
                        Vec::from_array(
                            [wire::ArtifactValue::Number("1"), wire::ArtifactValue::String("x")],
                        ),
                    ),
                ),
            ],
        ),
    );
    let table = wire::artifact_binary_string_table(value);
    testing::assert_eq(wire::artifact_binary_string_id(table, "-12.5e2"), -1);
    let encoded = match wire::encode_artifact_binary_value(table, value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match wire::decode_artifact_binary_value(table, encoded) {
        Ok(decoded) => match wire::encode_artifact_binary_value(table, decoded) {
            Ok(reencoded) => testing::assert(wire::artifact_binary_bytes_equal(encoded, reencoded)),
            Err(error) => testing::fail(error),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_is_deterministic() -> unit {
    let first = match interface_codec::encode_binary(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    let second = match interface_codec::encode_binary(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    testing::assert_eq(wire::artifact_binary_bytes_equal(first, second), true);
    match interface_codec::decode_binary(first) {
        Ok(value) => testing::assert_eq(
            interface_codec::encode_json(value, false),
            interface_codec::encode_json(binary_interface_fixture(), false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_comptime_interface_round_trips() -> unit {
    let value = binary_comptime_interface(42, "src/value.gom");
    let encoded = match interface_codec::encode_binary(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(decoded) => testing::assert_eq(
            interface_codec::encode_json(decoded, false),
            interface_codec::encode_json(value, false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn comptime_semantic_hash_ignores_origins_and_tracks_values() -> unit {
    let first = interface_codec::new_comptime_unit(binary_comptime_module(42, "src/first.gom"));
    let renamed = interface_codec::new_comptime_unit(
        binary_comptime_module(42, "other/renamed.gom"),
    );
    let changed = interface_codec::new_comptime_unit(binary_comptime_module(43, "src/first.gom"));
    let target_changed_module = binary_comptime_module(42, "src/first.gom");
    target_changed_module.target = ctir::CtTarget { int_width: 32 };
    let target_changed = interface_codec::new_comptime_unit(target_changed_module);
    testing::assert_eq(first.semantic_hash, renamed.semantic_hash);
    testing::assert(first.semantic_hash != changed.semantic_hash);
    testing::assert(first.semantic_hash != target_changed.semantic_hash)
}

#[test]
fn interface_hash_tracks_only_public_comptime_body_closures() -> unit {
    let first = source_interface(
        "package value; fn runtime_helper() -> int { 1 } pub fn runtime_value() -> int { runtime_helper() } #[comptime] fn ct_helper() -> int { 2 } #[comptime] pub fn ct_value() -> int { ct_helper() }",
    );
    let runtime_changed = source_interface(
        "package value; fn runtime_helper() -> int { 99 } pub fn runtime_value() -> int { runtime_helper() } #[comptime] fn ct_helper() -> int { 2 } #[comptime] pub fn ct_value() -> int { ct_helper() }",
    );
    let comptime_changed = source_interface(
        "package value; fn runtime_helper() -> int { 1 } pub fn runtime_value() -> int { runtime_helper() } #[comptime] fn ct_helper() -> int { 3 } #[comptime] pub fn ct_value() -> int { ct_helper() }",
    );
    testing::assert_eq(first.interface_hash, runtime_changed.interface_hash);
    testing::assert(first.interface_hash != comptime_changed.interface_hash)
}

#[test]
fn derive_entries_round_trip_and_affect_interface_hash() -> unit {
    let first = source_interface(
        "package value; #[comptime_derive] fn helper(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") } #[comptime_derive(Value)] pub fn derive_value(input: DeriveInput) -> DeriveOutput { helper(input) }",
    );
    let changed = source_interface(
        "package value; #[comptime_derive] fn helper(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Changed\") } #[comptime_derive(Value)] pub fn derive_value(input: DeriveInput) -> DeriveOutput { helper(input) }",
    );
    let renamed = source_interface(
        "package value; #[comptime_derive] fn helper(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") } #[comptime_derive(Renamed)] pub fn derive_value(input: DeriveInput) -> DeriveOutput { helper(input) }",
    );
    testing::assert(first.interface_hash != changed.interface_hash);
    testing::assert(first.interface_hash != renamed.interface_hash);
    let encoded = match interface_codec::encode_binary(first) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    let decoded = match interface_codec::decode_binary(encoded) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            first
        },
    };
    match decoded.comptime {
        Some(value) => {
            testing::assert_eq(value.module.derive_entries.len(), 1);
            testing::assert_eq(value.module.derive_entries[0].name, "audit::value::derive_value");
            match value.module.derive_entries[0].export_name {
                Some(name) => testing::assert_eq(name, "Value"),
                None => testing::fail("expected derive export name"),
            };
            testing::assert_eq(value.module.functions.len(), 2)
        },
        None => testing::fail("expected derive comptime unit"),
    }
}

#[test]
fn exported_comptime_origins_are_package_relative() -> unit {
    let exports = binary_comptime_interface(42, "src/value.gom").exports;
    match artifact_comptime_unit(binary_comptime_module(42, "/checkout/src/value.gom"), exports) {
        Some(value) => {
            testing::assert_eq(value.module.origins[0].source_path, "value.gom")
        },
        None => testing::fail("expected exported comptime unit"),
    }
}

#[test]
fn comptime_interface_rejects_invalid_semantic_hash() -> unit {
    let value = binary_comptime_interface(42, "src/value.gom");
    let comptime = match value.comptime {
        Some(value) => value,
        None => {
            testing::fail("expected comptime unit");
            interface_codec::new_comptime_unit(binary_comptime_module(42, "src/value.gom"))
        },
    };
    value.comptime = Option::Some(
        artifact::ArtifactComptimeUnit {
            version: comptime.version,
            module: comptime.module,
            semantic_hash: "invalid",
        },
    );
    let encoded = match interface_codec::encode_binary(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(_) => testing::fail("expected invalid comptime semantic hash rejection"),
        Err(_) => (),
    }
}

#[test]
fn comptime_interface_rejects_unknown_ctir_version() -> unit {
    let value = binary_comptime_interface(42, "src/value.gom");
    let comptime = match value.comptime {
        Some(value) => value,
        None => {
            testing::fail("expected comptime unit");
            interface_codec::new_comptime_unit(binary_comptime_module(42, "src/value.gom"))
        },
    };
    value.comptime = Option::Some(
        artifact::ArtifactComptimeUnit {
            version: comptime.version + 1,
            module: comptime.module,
            semantic_hash: comptime.semantic_hash,
        },
    );
    let encoded = match interface_codec::encode_binary(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(_) => testing::fail("expected unsupported comptime version rejection"),
        Err(error) => testing::assert(error.contains("unsupported comptime artifact version")),
    }
}

#[test]
fn dependency_loader_rejects_invalid_comptime_local_types() -> unit {
    let interface = binary_comptime_interface(42, "src/value.gom");
    let comptime = match interface.comptime {
        Some(value) => value,
        None => {
            testing::fail("expected comptime unit");
            interface_codec::new_comptime_unit(binary_comptime_module(42, "src/value.gom"))
        },
    };
    comptime.module.functions[0].local_count = 1;
    interface.comptime = Option::Some(interface_codec::new_comptime_unit(comptime.module));
    let world = test_package_world();
    match artifact_dependency_environments(
        world.builtin_interface.exports,
        world.prelude.interface_unit.exports,
        world.standard,
        no_standard_needs(),
        Vec::from_array([interface]),
    ) {
        Ok(_) => testing::fail("expected invalid imported comptime module rejection"),
        Err(error) => testing::assert(error.contains("local type count does not match local count")),
    }
}

#[test]
fn binary_interface_artifact_streams_standard_type_data() -> unit {
    let world = test_package_world();
    let value = required_artifact_standard_package(
        world.standard,
        resources::STD_COLLECTIONS_PACKAGE,
    ).interface_unit;
    let encoded = match interface_codec::encode_binary(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(decoded) => testing::assert_eq(
            interface_codec::encode_json(decoded, false),
            interface_codec::encode_json(value, false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_rejects_unknown_required_section() -> unit {
    let sections = match interface_codec::artifact_binary_interface_sections(
        binary_interface_fixture(),
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            Vec::new()
        },
    };
    sections.push(
        wire::ArtifactBinarySection {
            id: 99,
            version: 1,
            flags: wire::required_section_flag(),
            data: bytes::Bytes::new(),
        },
    );
    let encoded = match wire::encode_artifact_binary_container(1, sections) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(_) => testing::fail("expected unknown required section rejection"),
        Err(_) => (),
    }
}
