package main;

use gomlc::artifact::interface_codec as interface_codec;
use gomlc::artifact::wire as wire;
use gomlc::artifact;
use std::bytes;
use std::testing;

fn binary_interface_fixture() -> artifact::ArtifactInterfaceUnit {
    interface_codec::new_unit(
        "audit::value",
        interface_codec::empty_exports(),
        artifact::ArtifactPackageInterface {
            package_name: "audit::value",
            name: "value",
            value_exports: Vec::new(),
            enum_variants: Vec::new(),
        },
        Vec::[("builtin", "0123456789abcdef")],
    )
}

#[test]
fn binary_artifact_value_round_trips_value_shapes() -> unit {
    let value = wire::ArtifactValue::Object(
        Vec::[
            ("null", wire::ArtifactValue::Null),
            ("false", wire::ArtifactValue::Bool(false)),
            ("true", wire::ArtifactValue::Bool(true)),
            ("number", wire::ArtifactValue::Number("-12.5e2")),
            ("string", wire::ArtifactValue::String("hello")),
            (
                "array",
                wire::ArtifactValue::Array(
                    Vec::[wire::ArtifactValue::Number("1"), wire::ArtifactValue::String("x")],
                ),
            ),
        ],
    );
    let table = wire::artifact_binary_string_table(value);
    testing::assert_eq(wire::artifact_binary_string_id(table, "-12.5e2"), -1);
    let encoded = match wire::encode_artifact_binary_value(table, value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match wire::decode_artifact_binary_value(table, encoded) {
        Ok(decoded) => match wire::encode_artifact_binary_value(table, decoded) {
            Ok(reencoded) => testing::assert(wire::artifact_binary_bytes_equal(encoded, reencoded)),
            Err(error) => testing::fail(error),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_is_deterministic() -> unit {
    let first = match interface_codec::encode_binary(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    let second = match interface_codec::encode_binary(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    testing::assert_eq(wire::artifact_binary_bytes_equal(first, second), true);
    match interface_codec::decode_binary(first) {
        Ok(value) => testing::assert_eq(
            interface_codec::encode_json(value, false),
            interface_codec::encode_json(binary_interface_fixture(), false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_streams_standard_type_data() -> unit {
    let value = package_world().standard.collections.interface_unit;
    let encoded = match interface_codec::encode_binary(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(decoded) => testing::assert_eq(
            interface_codec::encode_json(decoded, false),
            interface_codec::encode_json(value, false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_rejects_unknown_required_section() -> unit {
    let sections = match interface_codec::artifact_binary_interface_sections(
        binary_interface_fixture(),
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            Vec::new()
        },
    };
    sections.push(
        wire::ArtifactBinarySection {
            id: 99,
            version: 1,
            flags: wire::required_section_flag(),
            data: bytes::Bytes::new(),
        },
    );
    let encoded = match wire::encode_artifact_binary_container(1, sections) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(encoded) {
        Ok(_) => testing::fail("expected unknown required section rejection"),
        Err(_) => (),
    }
}
