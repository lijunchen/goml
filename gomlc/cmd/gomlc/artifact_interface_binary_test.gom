package main;

use gomlc::artifact_codec as codec;

use gomlc::artifact_wire as wire;

use gomlc::artifact_model;

use std::bytes;
use std::testing;

fn binary_interface_fixture() -> artifact_model::ArtifactInterfaceUnit {
    codec::new_artifact_interface_unit(
        "audit::value",
        codec::empty_artifact_package_exports(),
        artifact_model::ArtifactPackageInterface {
            package_name: "audit::value",
            name: "value",
            value_exports: Vec::new(),
            enum_variants: Vec::new(),
        },
        Vec::[("builtin", "0123456789abcdef")],
    )
}

#[test]
fn binary_artifact_value_round_trips_value_shapes() -> unit {
    let value = wire::ArtifactValue::Object(
        Vec::[
            ("null", wire::ArtifactValue::Null),
            ("false", wire::ArtifactValue::Bool(false)),
            ("true", wire::ArtifactValue::Bool(true)),
            ("number", wire::ArtifactValue::Number("-12.5e2")),
            ("string", wire::ArtifactValue::String("hello")),
            (
                "array",
                wire::ArtifactValue::Array(Vec::[wire::ArtifactValue::Number("1"), wire::ArtifactValue::String("x")]),
            ),
        ],
    );
    let table = wire::artifact_binary_string_table(value);
    testing::assert_eq(wire::artifact_binary_string_id(table, "-12.5e2"), -1);
    let encoded = match wire::encode_artifact_binary_value(table, value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match wire::decode_artifact_binary_value(table, encoded) {
        Ok(decoded) => match wire::encode_artifact_binary_value(table, decoded) {
            Ok(reencoded) => testing::assert(wire::artifact_binary_bytes_equal(encoded, reencoded)),
            Err(error) => testing::fail(error),
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_is_deterministic() -> unit {
    let first = match codec::encode_artifact_interface_binary(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    let second = match codec::encode_artifact_interface_binary(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    testing::assert_eq(wire::artifact_binary_bytes_equal(first, second), true);
    match codec::decode_artifact_interface_binary(first) {
        Ok(value) => testing::assert_eq(
            codec::encode_artifact_interface_unit(value, false),
            codec::encode_artifact_interface_unit(binary_interface_fixture(), false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_streams_standard_type_data() -> unit {
    let value = package_world().standard.collections.interface_unit;
    let encoded = match codec::encode_artifact_interface_binary(value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match codec::decode_artifact_interface_binary(encoded) {
        Ok(decoded) => testing::assert_eq(
            codec::encode_artifact_interface_unit(decoded, false),
            codec::encode_artifact_interface_unit(value, false),
        ),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn binary_interface_artifact_rejects_unknown_required_section() -> unit {
    let sections = match codec::artifact_binary_interface_sections(binary_interface_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            Vec::new()
        },
    };
    sections.push(
        wire::ArtifactBinarySection {
            id: 99,
            version: 1,
            flags: codec::artifact_binary_required_section_flag(),
            data: bytes::Bytes::new(),
        },
    );
    let encoded = match wire::encode_artifact_binary_container(1, sections) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match codec::decode_artifact_interface_binary(encoded) {
        Ok(_) => testing::fail("expected unknown required section rejection"),
        Err(_) => (),
    }
}
