package main;

use std::bytes;

fn artifact_binary_core_sections(value: ArtifactCoreUnit) -> Result[
    Vec[ArtifactBinarySection],
    string,
] {
    let collector = new_artifact_binary_string_collector();
    artifact_json_core_unit(collector, value);
    let table = artifact_binary_collected_string_table(collector);
    let writer = new_artifact_binary_value_stream(table);
    artifact_json_core_unit(writer, value);
    let payload = match artifact_binary_stream_finish(writer) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    Result::Ok(
        Vec::new().pushed(
            ArtifactBinarySection {
                id: artifact_binary_string_table_section_id(),
                version: 1,
                flags: artifact_binary_required_section_flag(),
                data: encode_artifact_binary_string_table(table),
            },
        ).pushed(
            ArtifactBinarySection {
                id: artifact_binary_value_section_id(),
                version: 3,
                flags: artifact_binary_required_section_flag(),
                data: payload,
            },
        ),
    )
}

fn encode_artifact_core_binary(value: ArtifactCoreUnit) -> Result[bytes::Bytes, string] {
    let sections = match artifact_binary_core_sections(value) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    encode_artifact_binary_container(2, sections)
}

fn artifact_binary_validate_core_sections(value: ArtifactBinaryContainer) -> Result[unit, string] {
    for section in value.sections {
        if section.id == artifact_binary_string_table_section_id() {
            if section.version != 1 {
                return Result::Err("unsupported binary Core artifact section version")
            } else if section.flags != artifact_binary_required_section_flag() {
                return Result::Err("invalid binary Core artifact section flags")
            } else {
                ()
            }
        } else if section.id == artifact_binary_value_section_id() {
            if section.version != 3 {
                return Result::Err("unsupported binary Core artifact section version")
            } else if section.flags != artifact_binary_required_section_flag() {
                return Result::Err("invalid binary Core artifact section flags")
            } else {
                ()
            }
        } else if section.flags & artifact_binary_required_section_flag() != 0 {
            return Result::Err("unsupported required binary Core artifact section")
        } else {
            ()
        }
    };
    Result::Ok(())
}

fn decode_artifact_core_binary(data: bytes::Bytes) -> Result[ArtifactCoreUnit, string] {
    let container = match decode_artifact_binary_container(data) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if container.kind != 2 {
        return Result::Err("binary artifact is not Core")
    } else {
        ()
    };
    match artifact_binary_validate_core_sections(container) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let string_section = match artifact_binary_find_section(
        container,
        artifact_binary_string_table_section_id(),
    ) {
        Some(value) => value,
        None => {
            return Result::Err("binary Core artifact is missing string table")
        },
    };
    let value_section = match artifact_binary_find_section(
        container,
        artifact_binary_value_section_id(),
    ) {
        Some(value) => value,
        None => return Result::Err("binary Core artifact is missing value"),
    };
    let table = match decode_artifact_binary_string_table(string_section.data) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let value = match decode_artifact_binary_value(table, value_section.data) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    artifact_decode_core_value(value)
}
