package main;

use gomlc::core;
use gomlc::tast;

fn artifact_decode_core_type_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, ArtifactValue)],
    name: string,
) -> Result[tast::Type, string] {
    match artifact_json_required_field(object, name) {
        Ok(value) => artifact_decode_type(context.types, value),
        Err(error) => Result::Err(error),
    }
}

fn artifact_decode_core_expr_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, ArtifactValue)],
    name: string,
) -> Result[core::Expr, string] {
    match artifact_json_required_field(object, name) {
        Ok(value) => artifact_decode_core_expr(context, value),
        Err(error) => Result::Err(error),
    }
}

fn artifact_decode_core_exprs(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
    expected: string,
) -> Result[Vec[core::Expr], string] {
    let values = match artifact_json_array(value, expected) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        match artifact_decode_core_expr(context, value) {
            Ok(value) => result.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_core_expr_array_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, ArtifactValue)],
    name: string,
) -> Result[Vec[core::Expr], string] {
    match artifact_json_required_field(object, name) {
        Ok(value) => artifact_decode_core_exprs(context, value, name),
        Err(error) => Result::Err(error),
    }
}

fn artifact_decode_optional_core_expr(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[Option[core::Expr], string] {
    match value {
        Null => Result::Ok(Option::None),
        other => match artifact_decode_core_expr(context, other) {
            Ok(value) => Result::Ok(Option::Some(value)),
            Err(error) => Result::Err(error),
        },
    }
}

fn artifact_decode_closure_params(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[Vec[tast::ClosureParam], string] {
    let values = match artifact_json_array(value, "closure parameters") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let object = match artifact_json_object(value, "closure parameter") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let name = match artifact_json_field_string(object, "name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let ty = match artifact_decode_core_type_field(context, object, "ty") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push(tast::ClosureParam { name, ty })
    };
    Result::Ok(result)
}

fn artifact_decode_core_arms(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[Vec[core::Arm], string] {
    let values = match artifact_json_array(value, "match arms") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let object = match artifact_json_object(value, "match arm") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let lhs = match artifact_decode_core_expr_field(context, object, "lhs") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let body = match artifact_decode_core_expr_field(context, object, "body") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push(core::Arm { lhs, body })
    };
    Result::Ok(result)
}

fn artifact_decode_core_expr(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[core::Expr, string] {
    let variant = match artifact_json_object(value, "Core expression") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if variant.len() != 1 {
        return Result::Err(artifact_decode_error("Core expression variant"))
    } else {
        ()
    };
    let kind = variant.get(0).0;
    let object = match artifact_json_object(variant.get(0).1, "Core expression payload") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if kind == "EVar" {
        let name = match artifact_json_field_string(object, "name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Var { name, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "ECallable" {
        let name = match artifact_json_field_string(object, "name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let callable = match artifact_json_required_field(object, "body") {
            Ok(value) => match artifact_decode_callable_body(name, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Callable { callable, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EPrim" {
        let primitive = match artifact_json_required_field(object, "value") {
            Ok(value) => match artifact_decode_primitive(value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Prim { value: primitive, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EConstr" {
        let constructor = match artifact_json_required_field(object, "constructor") {
            Ok(value) => match artifact_decode_constructor(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let args = match artifact_decode_core_expr_array_field(context, object, "args") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Constr { constructor, args, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "ETuple" || kind == "EArray" {
        let items = match artifact_decode_core_expr_array_field(context, object, "items") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => if kind == "ETuple" {
                Result::Ok(core::Expr::Tuple { items, ty })
            } else {
                Result::Ok(core::Expr::Array { items, ty })
            },
            Err(error) => Result::Err(error),
        }
    } else if kind == "EClosure" {
        let params = match artifact_json_required_field(object, "params") {
            Ok(value) => match artifact_decode_closure_params(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let body = match artifact_decode_core_expr_field(context, object, "body") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Closure { params, body, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EBlock" {
        let block = match artifact_json_required_field(object, "block") {
            Ok(value) => match artifact_decode_core_block(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Block { block, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EMatch" {
        let expr = match artifact_decode_core_expr_field(context, object, "expr") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let arms = match artifact_json_required_field(object, "arms") {
            Ok(value) => match artifact_decode_core_arms(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let default = match artifact_json_required_field(object, "default") {
            Ok(value) => match artifact_decode_optional_core_expr(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Match { expr, arms, default, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EIf" {
        let cond = match artifact_decode_core_expr_field(context, object, "cond") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let then_branch = match artifact_decode_core_expr_field(context, object, "then_branch") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let else_branch = match artifact_decode_core_expr_field(context, object, "else_branch") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::If { cond, then_branch, else_branch, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EWhile" {
        let cond = match artifact_decode_core_expr_field(context, object, "cond") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let body = match artifact_decode_core_expr_field(context, object, "body") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::While { cond, body, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EBreak" || kind == "EContinue" {
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => if kind == "EBreak" {
                Result::Ok(core::Expr::Break { ty })
            } else {
                Result::Ok(core::Expr::Continue { ty })
            },
            Err(error) => Result::Err(error),
        }
    } else if kind == "EReturn" {
        let expr = match artifact_json_required_field(object, "expr") {
            Ok(value) => match artifact_decode_optional_core_expr(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Return { expr, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EGo" {
        let expr = match artifact_decode_core_expr_field(context, object, "expr") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Go { expr, ty }),
            Err(error) => Result::Err(error),
        }
    } else {
        artifact_decode_core_expr_tail(context, kind, object)
    }
}

fn artifact_decode_core_index_field(
    object: Vec[(string, ArtifactValue)],
    name: string,
) -> Result[int, string] {
    match artifact_json_required_field(object, name) {
        Ok(value) => match artifact_json_number_value(value, name) {
            Ok(value) => artifact_parse_nonnegative_int(value),
            Err(error) => Result::Err(error),
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_decode_core_expr_tail(
    context: ArtifactCoreDecodeContext,
    kind: string,
    object: Vec[(string, ArtifactValue)],
) -> Result[core::Expr, string] {
    if kind == "EConstrGet" {
        let expr = match artifact_decode_core_expr_field(context, object, "expr") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let constructor = match artifact_json_required_field(object, "constructor") {
            Ok(value) => match artifact_decode_constructor(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let field_index = match artifact_decode_core_index_field(object, "field_index") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::ConstrGet {
                expr,
                constructor,
                field_index,
                ty,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EUnary" {
        let op = match artifact_json_field_string(object, "op") {
            Ok(value) => match artifact_decode_unary(value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let expr = match artifact_decode_core_expr_field(context, object, "expr") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Unary { op, expr, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "ECast" {
        let expr = match artifact_decode_core_expr_field(context, object, "expr") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Cast { expr, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EBinary" {
        let op = match artifact_json_field_string(object, "op") {
            Ok(value) => match artifact_decode_binary(value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let lhs = match artifact_decode_core_expr_field(context, object, "lhs") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let rhs = match artifact_decode_core_expr_field(context, object, "rhs") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Binary { op, lhs, rhs, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EAssign" {
        let name = match artifact_json_field_string(object, "name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let value = match artifact_decode_core_expr_field(context, object, "value") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let target_ty = match artifact_decode_core_type_field(context, object, "target_ty") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Assign { name, value, target_ty, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "ECall" {
        let func = match artifact_decode_core_expr_field(context, object, "func") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let args = match artifact_decode_core_expr_array_field(context, object, "args") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Call { func, args, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EToDyn" {
        let trait_name = match artifact_json_field_string(object, "trait_name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let for_ty = match artifact_decode_core_type_field(context, object, "for_ty") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let expr = match artifact_decode_core_expr_field(context, object, "expr") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::ToDyn { trait_name, for_ty, expr, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EDynCall" {
        let trait_name = match artifact_json_field_string(object, "trait_name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let method_name = match artifact_json_field_string(object, "method_name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let receiver = match artifact_decode_core_expr_field(context, object, "receiver") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let args = match artifact_decode_core_expr_array_field(context, object, "args") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::DynCall {
                trait_name,
                method_name,
                receiver,
                args,
                ty,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "ETraitCall" {
        let trait_ref = match artifact_json_required_field(object, "trait_ref") {
            Ok(value) => match artifact_decode_trait_ref(context.types, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let method_name = match artifact_json_field_string(object, "method_name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let receiver = match artifact_decode_core_expr_field(context, object, "receiver") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let args = match artifact_decode_core_expr_array_field(context, object, "args") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::TraitCall {
                trait_ref,
                method_name,
                instance_name: Option::None,
                receiver,
                args,
                ty,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "EProj" {
        let tuple = match artifact_decode_core_expr_field(context, object, "tuple") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let index = match artifact_decode_core_index_field(object, "index") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_core_type_field(context, object, "ty") {
            Ok(ty) => Result::Ok(core::Expr::Proj { tuple, index, ty }),
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_decode_error("Core expression kind"))
    }
}

fn artifact_decode_core_block(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[core::Block, string] {
    let object = match artifact_json_object(value, "Core block") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let values = match artifact_json_field_array(object, "stmts") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let stmts = Vec::new();
    for value in values {
        let statement = match artifact_json_object(value, "Core let statement") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let name = match artifact_json_field_string(statement, "name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let value = match artifact_decode_core_expr_field(context, statement, "value") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let ty = match artifact_decode_core_type_field(context, statement, "ty") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        stmts.push(core::LetStmt { name, value, ty })
    };
    let tail = match artifact_json_required_field(object, "tail") {
        Ok(value) => match artifact_decode_optional_core_expr(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    Result::Ok(core::Block { stmts, tail })
}

fn artifact_decode_core_trait_impl(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[Option[core::TraitImpl], string] {
    match value {
        Null => Result::Ok(Option::None),
        other => {
            let object = match artifact_json_object(other, "Core trait implementation") {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            };
            let trait_ref = match artifact_json_required_field(object, "trait_ref") {
                Ok(value) => match artifact_decode_trait_ref(context.types, value) {
                    Ok(value) => value,
                    Err(error) => return Result::Err(error),
                },
                Err(error) => return Result::Err(error),
            };
            let for_ty = match artifact_decode_core_type_field(context, object, "for_ty") {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            };
            let generic_count = match artifact_decode_core_index_field(
                object,
                "generic_count",
            ) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            };
            let predicate_count = match artifact_decode_core_index_field(
                object,
                "predicate_count",
            ) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            };
            Result::Ok(Option::Some(core::TraitImpl {
                trait_ref,
                for_ty,
                associated_types: Vec::new(),
                generic_count,
                predicate_count,
            }))
        },
    }
}

fn artifact_decode_core_params(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[Vec[(string, tast::Type)], string] {
    let values = match artifact_json_array(value, "Core function parameters") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let pair = match artifact_json_array(value, "Core function parameter") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("Core function parameter"))
        } else {
            ()
        };
        let name = match artifact_json_string_value(pair.get(0), "Core parameter name") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let ty = match artifact_decode_type(context.types, pair.get(1)) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push((name, ty))
    };
    Result::Ok(result)
}

fn artifact_decode_core_function(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[core::Function, string] {
    let object = match artifact_json_object(value, "Core function") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_json_field_string(object, "name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let root = match artifact_json_required_field(object, "root") {
        Ok(value) => match artifact_json_bool_value(value, "Core function root") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let generics = match artifact_json_required_field(object, "generics") {
        Ok(value) => match artifact_decode_string_array(value, "Core function generics") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let trait_impl = match artifact_json_required_field(object, "trait_impl") {
        Ok(value) => match artifact_decode_core_trait_impl(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let params = match artifact_json_required_field(object, "params") {
        Ok(value) => match artifact_decode_core_params(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let ret_ty = match artifact_decode_core_type_field(context, object, "ret_ty") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let body = match artifact_json_required_field(object, "body") {
        Ok(value) => match artifact_decode_core_block(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    Result::Ok(core::Function {
        name,
        root,
        generics,
        predicates: Vec::new(),
        trait_impl,
        params,
        ret_ty,
        body,
    })
}

fn artifact_decode_const_expr_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, ArtifactValue)],
    name: string,
) -> Result[tast::ConstExpr, string] {
    match artifact_json_required_field(object, name) {
        Ok(value) => artifact_decode_const_expr(context, value),
        Err(error) => Result::Err(error),
    }
}

fn artifact_decode_const_expr(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[tast::ConstExpr, string] {
    let variant = match artifact_json_object(value, "constant expression") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if variant.len() != 1 {
        return Result::Err(artifact_decode_error("constant expression variant"))
    } else {
        ()
    };
    let kind = variant.get(0).0;
    let object = match artifact_json_object(
        variant.get(0).1,
        "constant expression payload",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let ty = match artifact_decode_core_type_field(context, object, "ty") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if kind == "CPrim" {
        let primitive = match artifact_json_required_field(object, "value") {
            Ok(value) => match artifact_decode_primitive(value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        Result::Ok(tast::ConstExpr::Prim { value: primitive, ty })
    } else if kind == "CRef" {
        match artifact_json_field_string(object, "name") {
            Ok(name) => Result::Ok(tast::ConstExpr::Ref { name, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "CUnary" {
        let op = match artifact_json_field_string(object, "op") {
            Ok(value) => match artifact_decode_unary(value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_const_expr_field(context, object, "expr") {
            Ok(expr) => Result::Ok(tast::ConstExpr::Unary {
                op,
                expr,
                ty,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "CCast" {
        match artifact_decode_const_expr_field(context, object, "expr") {
            Ok(expr) => Result::Ok(tast::ConstExpr::Cast { expr, ty }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "CBinary" {
        let op = match artifact_json_field_string(object, "op") {
            Ok(value) => match artifact_decode_binary(value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let lhs = match artifact_decode_const_expr_field(context, object, "lhs") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_decode_const_expr_field(context, object, "rhs") {
            Ok(rhs) => Result::Ok(tast::ConstExpr::Binary {
                op,
                lhs,
                rhs,
                ty,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "CError" {
        Result::Ok(tast::ConstExpr::Error { ty })
    } else {
        Result::Err(artifact_decode_error("constant expression"))
    }
}

fn artifact_decode_constant(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[tast::Constant, string] {
    let object = match artifact_json_object(value, "constant") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_json_field_string(object, "name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let ty = match artifact_decode_core_type_field(context, object, "ty") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_decode_const_expr_field(context, object, "value") {
        Ok(value) => Result::Ok(tast::Constant { name, ty, value }),
        Err(error) => Result::Err(error),
    }
}

fn artifact_decode_core_file(
    context: ArtifactCoreDecodeContext,
    value: ArtifactValue,
) -> Result[core::File, string] {
    let object = match artifact_json_object(value, "Core file") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let values = match artifact_json_field_array(object, "toplevels") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let functions = Vec::new();
    for value in values {
        match artifact_decode_core_function(context, value) {
            Ok(value) => functions.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    let constant_values = match artifact_json_field_array(object, "constants") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let constants = Vec::new();
    for value in constant_values {
        match artifact_decode_constant(context, value) {
            Ok(value) => constants.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(core::File {
        functions,
        enums: context.enums,
        structs: context.structs,
        type_instances: Vec::new(),
        constants,
    })
}
