package main;

use gomlc::ast;
use gomlc::anf;
use gomlc::cst;
use gomlc::core;
use gomlc::go_backend;
use gomlc::hir;
use gomlc::lexer;
use gomlc::lift;
use gomlc::mono;
use gomlc::parser;
use gomlc::tast;
use std::env;
use std::fs;
use std::io;
use std::process;
use std::text;

const dump_ast_option: string = "--dump-ast";

const dump_expanded_ast_option: string = "--dump-expanded-ast";

const dump_hir_option: string = "--dump-hir";

const dump_tast_option: string = "--dump-tast";

const dump_ctir_option: string = "--dump-ctir";

const dump_core_option: string = "--dump-core";

const dump_mono_option: string = "--dump-mono";

const dump_lift_option: string = "--dump-lift";

const dump_anf_option: string = "--dump-anf";

const dump_go_option: string = "--dump-go";

struct RunArgs {
    file: string,
    dump_ast: bool,
    dump_expanded_ast: bool,
    dump_hir: bool,
    dump_tast: bool,
    dump_ctir: bool,
    dump_core: bool,
    dump_mono: bool,
    dump_lift: bool,
    dump_anf: bool,
    dump_go: bool,
}

struct CoreStage {
    file: core::File,
    counter: Ref[int],
}

fn fail(message: string) -> unit {
    io::eprintln(message);
    process::exit(1)
}

fn read_source(path: string) -> string {
    match fs::read_file(path) {
        Ok(source) => source,
        Err(_) => {
            fail("error reading goml file: " + path);
            ""
        },
    }
}

fn dump_argument(value: string) -> bool {
    match value {
        dump_ast_option | dump_expanded_ast_option | dump_hir_option | dump_tast_option | dump_ctir_option | dump_core_option | dump_mono_option | dump_lift_option | dump_anf_option | dump_go_option => true,
        _ => false,
    }
}

fn inline_dump_argument(value: string) -> Option[(string, string)] {
    let names: Vec[string] = Vec::[];
    names.push(dump_ast_option);
    names.push(dump_expanded_ast_option);
    names.push(dump_hir_option);
    names.push(dump_tast_option);
    names.push(dump_ctir_option);
    names.push(dump_core_option);
    names.push(dump_mono_option);
    names.push(dump_lift_option);
    names.push(dump_anf_option);
    names.push(dump_go_option);
    for name in names {
        match inline_cli_value(value, name) {
            Some(argument) => return Option::Some((name, argument)),
            None => (),
        }
    }
    Option::None
}

fn inline_dump_argument_present(value: Option[(string, string)]) -> bool {
    value.is_some()
}

fn selected_run_usage(used_dumps: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string("gomlc run-single");
    for argument in used_dumps {
        builder.write_char(' ');
        builder.write_string(argument)
    }
    builder.write_string(" <FILE>");
    builder.finish()
}

fn parse_run_args(args: Vec[string]) -> Result[RunArgs, string] {
    let mut file: Option[string] = Option::None;
    let seen: HashMap[string, unit] = HashMap::{};
    let used_dumps: Vec[string] = Vec::[];
    let mut positional = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
            index += 1;
        } else if !positional && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if !positional && option_string_present(inline_cli_value(argument, "--help")) {
            let value = match inline_cli_value(argument, "--help") {
                Some(value) => value,
                None => "",
            };
            let usage = if used_dumps.is_empty() {
                "gomlc run-single --help <FILE>"
            } else {
                "gomlc run-single --help <--dump-ast|--dump-expanded-ast|--dump-hir|--dump-tast|--dump-ctir|--dump-core|--dump-mono|--dump-lift|--dump-anf|--dump-go|FILE>"
            };
            return Result::Err(unexpected_value_error_with_usage(value, "--help", usage))
        } else if !positional && dump_argument(argument) {
            if seen.contains(argument) {
                return Result::Err(repeated_argument_error(run_single_command, argument))
            } else {
                seen[argument] = ();
                used_dumps.push(argument);
                index += 1;
            }
        } else if !positional && inline_dump_argument_present(inline_dump_argument(argument)) {
            match inline_dump_argument(argument) {
                Some((name, value)) => return Result::Err(
                    unexpected_value_error(run_single_command, value, name, f"{name} <FILE>"),
                ),
                None => (),
            }
        } else if !positional && cli_option(argument) {
            match similar_cli_argument(run_single_command, argument) {
                Some(similar) => {
                    let usage = if similar == "--help" {
                        "gomlc run-single --help <FILE>"
                    } else {
                        if !seen.contains(similar) {
                            used_dumps.push(similar)
                        } else {};
                        selected_run_usage(used_dumps)
                    };
                    return Result::Err(unexpected_similar_argument_error(argument, similar, usage))
                },
                None => (),
            };
            let usage = if !used_dumps.is_empty() || file.is_some() {
                selected_run_usage(used_dumps)
            } else {
                command_usage(run_single_command)
            };
            return Result::Err(unexpected_argument_error_with_usage(argument, true, usage))
        } else {
            match file {
                Some(_) => return Result::Err(
                    unexpected_argument_error(run_single_command, argument, false),
                ),
                None => {
                    file = Option::Some(argument);
                    index += 1;
                },
            }
        }
    }
    match file {
        Some(value) => Result::Ok(
            RunArgs {
                file: value,
                dump_ast: seen.contains(dump_ast_option),
                dump_expanded_ast: seen.contains(dump_expanded_ast_option),
                dump_hir: seen.contains(dump_hir_option),
                dump_tast: seen.contains(dump_tast_option),
                dump_ctir: seen.contains(dump_ctir_option),
                dump_core: seen.contains(dump_core_option),
                dump_mono: seen.contains(dump_mono_option),
                dump_lift: seen.contains(dump_lift_option),
                dump_anf: seen.contains(dump_anf_option),
                dump_go: seen.contains(dump_go_option),
            },
        ),
        None => {
            let missing: Vec[string] = Vec::[];
            missing.push("<FILE>");
            Result::Err(
                missing_required_arguments_error_with_usage(missing, selected_run_usage(used_dumps)),
            )
        },
    }
}

fn lower_core_stage(source_path: string, source: string) -> CoreStage {
    let counter = Ref::new(0);
    let file = core::lower_with_counter(
        tast::check(hir::lower(ast::lower(parser::parse(source)), source_path)),
        counter,
    );
    CoreStage { file, counter }
}

fn canonical_stage_output(stage: string, source_path: string, source: string) -> string {
    match stage {
        lex_stage => lexer::encode_tokens(lexer::lex(source)),
        cst_stage => cst::encode(parser::parse(source)),
        ast_stage => ast::encode(ast::lower(parser::parse(source))),
        hir_stage => hir::encode(hir::lower(ast::lower(parser::parse(source)), source_path)),
        tast_stage => tast::encode(
            tast::check(hir::lower(ast::lower(parser::parse(source)), source_path)),
        ),
        core_stage => {
            let value = lower_core_stage(source_path, source);
            core::encode(value.file)
        },
        mono_stage => {
            let value = lower_core_stage(source_path, source);
            mono::encode(lower_mono_or_fail(value.file))
        },
        lift_stage => {
            let value = lower_core_stage(source_path, source);
            let mono_value = lower_mono_or_fail(value.file);
            lift::encode(lift::lower_with_counter(mono_value, value.counter))
        },
        anf_stage => {
            let value = lower_core_stage(source_path, source);
            let mono_value = lower_mono_or_fail(value.file);
            let lift_value = lift::lower_with_counter(mono_value, value.counter);
            anf::encode(anf::lower_with_counter(lift_value, value.counter))
        },
        go_stage => {
            let value = lower_core_stage(source_path, source);
            let mono_value = lower_mono_or_fail(value.file);
            let lift_value = lift::lower_with_counter(mono_value, value.counter);
            let anf_value = anf::lower_with_counter(lift_value, value.counter);
            go_backend::encode(lower_go_or_fail(go_backend::lower(anf_value)))
        },
        _ => {
            fail("unknown mode: " + stage);
            ""
        },
    }
}

fn run_canonical_stage(args: Vec[string]) -> unit {
    if args.len() != 4 {
        fail("usage: gomlc __canonical-stage <STAGE> <FILE>")
    } else {
        let source_path = args[3];
        io::print(canonical_stage_output(args[2], source_path, read_source(source_path)))
    }
}

fn run_stage(args: Vec[string]) -> unit {
    if args.len() != 3 {
        fail("usage: gomlc <lex|cst|ast|hir|tast|core|mono|lift|anf|go> <FILE>")
    } else {
        match args[1] {
            lex_stage => io::print(lexer::encode_tokens(lexer::lex(read_source(args[2])))),
            _ => {
                let source_path = args[2];
                io::print(pipeline_stage_output(args[1], source_path, read_source(source_path)))
            },
        }
    }
}

fn main() -> unit {
    let args = env::args();
    if args.len() == 1 {
        fail_cli(top_level_help())
    } else if cli_help_argument(args[1]) {
        print_cli_help(top_level_help())
    } else if option_string_present(inline_cli_value(args[1], "--help")) {
        let value = match inline_cli_value(args[1], "--help") {
            Some(value) => value,
            None => "",
        };
        fail_cli(unexpected_value_error_with_usage(value, "--help", "gomlc --help <COMMAND>"))
    } else if args[1] == "--" {
        if args.len() == 2 {
            fail_cli(top_level_help())
        } else {
            fail_unknown_subcommand(args[2])
        }
    } else {
        match args[1] {
            help_command => run_help_command(args),
            version_command => run_version(args),
            prepare_world_command => run_prepare_world(args),
            check_command => run_package_command(args, false, false),
            test_check_command => run_package_command(args, false, true),
            build_command => run_package_command(args, true, false),
            test_build_command => run_package_command(args, true, true),
            link_command => run_link_command(args),
            test_link_command => run_test_link_command(args),
            package_info_command => run_package_info(args),
            "__canonical-stage" => run_canonical_stage(args),
            "__builtin-interface" => if args.len() == 2 {
                io::print(builtin_artifact_json())
            } else {
                fail("usage: gomlc __builtin-interface")
            },
            "__test-diagnostics" => run_test_diagnostics(args),
            run_single_command => match parse_run_args(args) {
                Ok(run_args) => run_single(run_args),
                Err(error) => handle_cli_parse_error(run_single_command, error),
            },
            _ if is_debug_stage(args[1]) => run_stage(args),
            _ if cli_option(args[1]) => match similar_cli_argument("", args[1]) {
                Some(similar) => fail_cli(
                    unexpected_similar_argument_error(
                        args[1],
                        similar,
                        similar_cli_argument_usage("", similar),
                    ),
                ),
                None => fail_cli(unexpected_argument_error("", args[1], false)),
            },
            _ => fail_unknown_subcommand(args[1]),
        }
    }
}
