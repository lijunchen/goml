package main;

use gomlc::artifact_wire as wire;

use std::bytes;
use std::testing;

#[test]
fn artifact_readers_accept_only_gaf() -> unit {
    let interface = binary_interface_fixture();
    let interface_data = match encode_artifact_interface_binary(interface) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            wire::artifact_binary_magic()
        },
    };
    match decode_artifact_interface_bytes(interface_data) {
        Ok(value) => testing::assert_eq(value.interface_hash, interface.interface_hash),
        Err(error) => testing::fail(error),
    };
    match decode_artifact_interface_bytes(bytes::Bytes::from_string("{}")) {
        Ok(_) => testing::fail("expected JSON interface rejection"),
        Err(_) => (),
    };
    let core = binary_core_fixture();
    let core_data = match encode_artifact_core_binary(core) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            wire::artifact_binary_magic()
        },
    };
    match decode_artifact_core_bytes(core_data) {
        Ok(value) => testing::assert_eq(value.interface_hash, core.interface_hash),
        Err(error) => testing::fail(error),
    };
    match decode_artifact_core_bytes(bytes::Bytes::from_string("{}")) {
        Ok(_) => testing::fail("expected JSON Core rejection"),
        Err(_) => (),
    }
}
