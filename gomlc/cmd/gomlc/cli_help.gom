package main;

use gomlc::strings;
use std::io;
use std::process;
use std::text;

fn top_level_help() -> string {
    "Usage: gomlc <COMMAND>\n\nCommands:\n  check          \n  test-check     \n  build          \n  test-build     \n  link           \n  test-link      \n  prepare-world  \n  package-info   \n  run-single     \n  version        \n  help           Print this message or the help of the given subcommand(s)\n\nOptions:\n  -h, --help  Print help"
}

fn package_command_help(command: string) -> string {
    "Usage: gomlc " + command
        + " [OPTIONS] --package <PACKAGE> --input <INPUT>... --output <OUTPUT>\n\nOptions:\n      --package <PACKAGE>                \n      --input <INPUT>...                 \n      --interface-path <INTERFACE_FILE>  \n      --output <OUTPUT>                  \n  -h, --help                             Print help"
}

fn command_help(command: string) -> Option[string] {
    if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        Option::Some(package_command_help(command))
    } else if command == "link" {
        Option::Some(
            "Usage: gomlc link --input <INPUT>... --entry <ENTRY> --output <OUTPUT>\n\nOptions:\n      --input <INPUT>...  \n      --entry <ENTRY>     \n      --output <OUTPUT>   \n  -h, --help              Print help",
        )
    } else if command == "test-link" {
        Option::Some(
            "Usage: gomlc test-link --input <INPUT>... --package <PACKAGE> --output <OUTPUT> --manifest <MANIFEST>\n\nOptions:\n      --input <INPUT>...     \n      --package <PACKAGE>    \n      --output <OUTPUT>      \n      --manifest <MANIFEST>  \n  -h, --help                 Print help",
        )
    } else if command == "prepare-world" {
        Option::Some(
            "Usage: gomlc prepare-world --output <OUTPUT>\n\nOptions:\n      --output <OUTPUT>  \n  -h, --help             Print help",
        )
    } else if command == "package-info" {
        Option::Some(
            "Usage: gomlc package-info [OPTIONS] --input <INPUT>...\n\nOptions:\n      --input <INPUT>...  \n      --format <FORMAT>   [default: json] [possible values: json]\n  -h, --help              Print help",
        )
    } else if command == "run-single" {
        Option::Some(
            "Usage: gomlc run-single [OPTIONS] <FILE>\n\nArguments:\n  <FILE>  \n\nOptions:\n      --dump-ast   \n      --dump-hir   \n      --dump-tast  \n      --dump-core  \n      --dump-mono  \n      --dump-lift  \n      --dump-anf   \n      --dump-go    \n  -h, --help       Print help",
        )
    } else if command == "version" {
        Option::Some(
            "Usage: gomlc version [OPTIONS]\n\nOptions:\n      --format <FORMAT>  [default: text] [possible values: text, json]\n  -h, --help             Print help",
        )
    } else if command == "help" {
        Option::Some(
            "Print this message or the help of the given subcommand(s)\n\nUsage: gomlc help [COMMAND]...\n\nArguments:\n  [COMMAND]...  Print help for the subcommand(s)",
        )
    } else {
        Option::None
    }
}

fn command_usage(command: string) -> string {
    if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        "gomlc " + command + " [OPTIONS] --package <PACKAGE> --input <INPUT>... --output <OUTPUT>"
    } else if command == "link" {
        "gomlc link --input <INPUT>... --entry <ENTRY> --output <OUTPUT>"
    } else if command == "test-link" {
        "gomlc test-link --input <INPUT>... --package <PACKAGE> --output <OUTPUT> --manifest <MANIFEST>"
    } else if command == "prepare-world" {
        "gomlc prepare-world --output <OUTPUT>"
    } else if command == "prepare-world" {
        "gomlc prepare-world --output <OUTPUT>"
    } else if command == "package-info" {
        "gomlc package-info [OPTIONS] --input <INPUT>..."
    } else if command == "run-single" {
        "gomlc run-single [OPTIONS] <FILE>"
    } else if command == "version" {
        "gomlc version [OPTIONS]"
    } else {
        "gomlc <COMMAND>"
    }
}

fn required_command_usage(command: string) -> string {
    if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        "gomlc " + command + " --package <PACKAGE> --input <INPUT>... --output <OUTPUT>"
    } else if command == "run-single" {
        "gomlc run-single <FILE>"
    } else if command == "prepare-world" {
        "gomlc prepare-world --output <OUTPUT>"
    } else if command == "package-info" {
        "gomlc package-info --input <INPUT>..."
    } else {
        command_usage(command)
    }
}

fn cli_help_signal() -> string {
    "__gomlc_help_requested__"
}

fn is_cli_help_signal(value: string) -> bool {
    value == cli_help_signal()
}

fn cli_error_footer() -> string {
    "For more information, try '--help'."
}

fn cli_error(message: string) -> string {
    "error: " + message + "\n\n" + cli_error_footer()
}

fn cli_error_with_usage(message: string, usage: string) -> string {
    "error: " + message + "\n\nUsage: " + usage + "\n\n" + cli_error_footer()
}

fn cli_argument_name(argument: string) -> string {
    if !strings::starts_with(argument, "--") {
        return argument
    } else {
        ()
    };
    let mut end = argument.byte_len();
    for index in 0..argument.byte_len() {
        if end == argument.byte_len() && argument.byte_get(index) == b'=' {
            end = index;
        } else {
            ()
        }
    };
    argument.byte_slice(0, end)
}

fn cli_help_argument(argument: string) -> bool {
    argument == "--help" || strings::starts_with(argument, "-h")
}

fn cli_minimum(left: int, middle: int, right: int) -> int {
    let first = if left < middle {
        left
    } else {
        middle
    };
    if first < right {
        first
    } else {
        right
    }
}

fn cli_maximum(left: int, right: int) -> int {
    if left > right {
        left
    } else {
        right
    }
}

fn cli_edit_distance(left: string, right: string) -> int {
    let initial: Vec[int] = Vec::[];
    for index in 0..right.byte_len() + 1 {
        initial.push(index)
    };
    let mut previous = initial;
    for left_index in 0..left.byte_len() {
        let current: Vec[int] = Vec::[];
        current.push(left_index + 1);
        for right_index in 0..right.byte_len() {
            let substitution = if left.byte_get(left_index) == right.byte_get(right_index) {
                previous[right_index]
            } else {
                previous[right_index] + 1
            };
            current.push(
                cli_minimum(current[right_index] + 1, previous[right_index + 1] + 1, substitution),
            )
        };
        previous = current;
    };
    previous[right.byte_len()]
}

fn similar_cli_argument(command: string, argument: string) -> Option[string] {
    let candidates: Vec[string] = Vec::[];
    if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        candidates.push("--package");
        candidates.push("--input");
        candidates.push("--interface-path");
        candidates.push("--output");
        candidates.push("--help")
    } else if command == "link" {
        candidates.push("--input");
        candidates.push("--entry");
        candidates.push("--output");
        candidates.push("--help")
    } else if command == "test-link" {
        candidates.push("--input");
        candidates.push("--package");
        candidates.push("--output");
        candidates.push("--manifest");
        candidates.push("--help")
    } else if command == "prepare-world" {
        candidates.push("--output");
        candidates.push("--help")
    } else if command == "package-info" {
        candidates.push("--input");
        candidates.push("--format");
        candidates.push("--help")
    } else if command == "run-single" {
        candidates.push("--dump-ast");
        candidates.push("--dump-hir");
        candidates.push("--dump-tast");
        candidates.push("--dump-core");
        candidates.push("--dump-mono");
        candidates.push("--dump-lift");
        candidates.push("--dump-anf");
        candidates.push("--dump-go");
        candidates.push("--help")
    } else if command == "version" {
        candidates.push("--format");
        candidates.push("--help")
    } else {
        candidates.push("--help")
    };
    let name = cli_argument_name(argument);
    let mut best: Option[string] = Option::None;
    let mut distance = 2147483647;
    for candidate in candidates {
        let candidate_distance = cli_edit_distance(name, candidate);
        if candidate_distance < distance {
            distance = candidate_distance;
            best = Option::Some(candidate);
        } else {
            ()
        }
    };
    if distance <= 3 {
        best
    } else {
        Option::None
    }
}

fn similar_cli_argument_usage(command: string, argument: string) -> string {
    if command == "" && argument == "--help" {
        "gomlc --help <COMMAND>"
    } else if command == "version" && argument == "--format" {
        "gomlc version --format <FORMAT>"
    } else if command == "version" && argument == "--help" {
        "gomlc version --help"
    } else if command == "package-info" && argument == "--format" {
        "gomlc package-info --format <FORMAT> --input <INPUT>..."
    } else if command == "package-info" && argument == "--help" {
        "gomlc package-info --help --input <INPUT>..."
    } else if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        if argument == "--interface-path" {
            required_command_usage(command) + " --interface-path <INTERFACE_FILE>"
        } else if argument == "--help" {
            required_command_usage(command) + " --help"
        } else {
            required_command_usage(command)
        }
    } else {
        command_usage(command)
    }
}

fn cli_value_option(command: string, argument: string) -> bool {
    if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        argument == "--package" || argument == "--input" || argument == "--interface-path"
            || argument == "--output"
    } else if command == "link" {
        argument == "--input" || argument == "--entry" || argument == "--output"
    } else if command == "test-link" {
        argument == "--input" || argument == "--package" || argument == "--output"
            || argument == "--manifest"
    } else if command == "prepare-world" {
        argument == "--output"
    } else if command == "package-info" {
        argument == "--input" || argument == "--format"
    } else if command == "version" {
        argument == "--format"
    } else {
        false
    }
}

fn known_cli_option(command: string, argument: string) -> bool {
    if argument == "--" || cli_help_argument(argument)
        || option_string_present(inline_cli_value(argument, "--help"))
        || cli_value_option(command, argument) {
        true
    } else if command == "check" || command == "test-check" || command == "build"
        || command == "test-build" {
        option_string_present(inline_cli_value(argument, "--package"))
            || option_string_present(inline_cli_value(argument, "--input"))
            || option_string_present(inline_cli_value(argument, "--interface-path"))
            || option_string_present(inline_cli_value(argument, "--output"))
    } else if command == "link" {
        option_string_present(inline_cli_value(argument, "--input"))
            || option_string_present(inline_cli_value(argument, "--entry"))
            || option_string_present(inline_cli_value(argument, "--output"))
    } else if command == "test-link" {
        option_string_present(inline_cli_value(argument, "--input"))
            || option_string_present(inline_cli_value(argument, "--package"))
            || option_string_present(inline_cli_value(argument, "--output"))
            || option_string_present(inline_cli_value(argument, "--manifest"))
    } else if command == "prepare-world" {
        option_string_present(inline_cli_value(argument, "--output"))
    } else if command == "package-info" {
        option_string_present(inline_cli_value(argument, "--input"))
            || option_string_present(inline_cli_value(argument, "--format"))
    } else if command == "version" {
        option_string_present(inline_cli_value(argument, "--format"))
    } else {
        false
    }
}

fn unexpected_cli_option_error_with_usage(command: string, argument: string, usage: string) -> string {
    match similar_cli_argument(command, argument) {
        Some(similar) => unexpected_similar_argument_error(
            argument,
            similar,
            similar_cli_argument_usage(command, similar),
        ),
        None => unexpected_argument_error_with_usage(argument, false, usage),
    }
}

fn missing_required_arguments_error_with_usage(arguments: Vec[string], usage: string) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string("error: the following required arguments were not provided:");
    for argument in arguments {
        builder.write_string("\n  ");
        builder.write_string(argument)
    };
    builder.write_string("\n\nUsage: ");
    builder.write_string(usage);
    builder.write_string("\n\n");
    builder.write_string(cli_error_footer());
    builder.finish()
}

fn missing_required_arguments_error(command: string, arguments: Vec[string]) -> string {
    missing_required_arguments_error_with_usage(arguments, required_command_usage(command))
}

fn value_required_error(argument: string, possible_values: Option[string]) -> string {
    let values = match possible_values {
        Some(values) => "\n  [possible values: " + values + "]",
        None => "",
    };
    "error: a value is required for '" + argument + "' but none was supplied" + values + "\n\n"
        + cli_error_footer()
}

fn unexpected_argument_error_with_usage(argument: string, value_tip: bool, usage: string) -> string {
    let name = cli_argument_name(argument);
    let displayed = if name.byte_len() > 2 && strings::starts_with(name, "-")
        && !strings::starts_with(name, "--") {
        name.byte_slice(0, 2)
    } else {
        name
    };
    let tip = if value_tip {
        "\n\n  tip: to pass '" + displayed + "' as a value, use '-- " + displayed + "'"
    } else {
        ""
    };
    cli_error_with_usage("unexpected argument '" + displayed + "' found" + tip, usage)
}

fn unexpected_argument_error(command: string, argument: string, value_tip: bool) -> string {
    unexpected_argument_error_with_usage(argument, value_tip, command_usage(command))
}

fn unexpected_similar_argument_error(argument: string, similar: string, usage: string) -> string {
    cli_error_with_usage(
        "unexpected argument '" + cli_argument_name(argument)
            + "' found\n\n  tip: a similar argument exists: '"
            + similar
            + "'",
        usage,
    )
}

fn repeated_argument_error(command: string, argument: string) -> string {
    cli_error_with_usage(
        "the argument '" + argument + "' cannot be used multiple times",
        command_usage(command),
    )
}

fn invalid_value_error(value: string, argument: string, possible_values: string) -> string {
    cli_error(
        "invalid value '" + value + "' for '" + argument + "'\n  [possible values: "
            + possible_values
            + "]",
    )
}

fn unexpected_value_error(command: string, value: string, argument: string, usage: string) -> string {
    cli_error_with_usage(
        "unexpected value '" + value + "' for '" + argument + "' found; no more were expected",
        "gomlc " + command + " " + usage,
    )
}

fn unexpected_value_error_with_usage(value: string, argument: string, usage: string) -> string {
    cli_error_with_usage(
        "unexpected value '" + value + "' for '" + argument + "' found; no more were expected",
        usage,
    )
}

fn is_debug_stage(command: string) -> bool {
    command == "lex" || command == "cst" || command == "ast" || command == "hir"
        || command == "tast"
        || command == "core"
        || command == "mono"
        || command == "lift"
        || command == "anf"
        || command == "go"
}

fn print_cli_help(message: string) -> unit {
    io::println(message)
}

struct CliSimilarity {
    value: string,
    numerator: int,
    denominator: int,
}

fn cli_jaro_similarity(left: string, right: string) -> Option[CliSimilarity] {
    if left == right {
        return Option::Some(CliSimilarity { value: right, numerator: 1, denominator: 1 })
    } else if left.byte_len() == 0 || right.byte_len() == 0 {
        return Option::None
    } else {
        ()
    };
    let window = cli_maximum(cli_maximum(left.byte_len(), right.byte_len()) / 2 - 1, 0);
    let left_matches: Vec[bool] = Vec::[];
    let right_matches: Vec[bool] = Vec::[];
    for _ in 0..left.byte_len() {
        left_matches.push(false)
    };
    for _ in 0..right.byte_len() {
        right_matches.push(false)
    };
    let mut matches = 0;
    for left_index in 0..left.byte_len() {
        let start = cli_maximum(left_index - window, 0);
        let end = cli_minimum(left_index + window + 1, right.byte_len(), right.byte_len());
        let mut right_index = start;
        while right_index < end {
            let index = right_index;
            if !(right_matches[index]) && left.byte_get(left_index) == right.byte_get(index) {
                left_matches[left_index] = true;
                right_matches[index] = true;
                matches = matches + 1;
                break
            } else {
                right_index = index + 1;
            }
        }
    };
    if matches == 0 {
        return Option::None
    } else {
        ()
    };
    let mut right_index = 0;
    let mut mismatches = 0;
    for left_index in 0..left.byte_len() {
        if left_matches[left_index] {
            while !(right_matches[right_index]) {
                right_index = right_index + 1;
            };
            if left.byte_get(left_index) != right.byte_get(right_index) {
                mismatches = mismatches + 1;
            } else {
                ()
            };
            right_index = right_index + 1;
        } else {
            ()
        }
    };
    let matched = matches;
    let transpositions = mismatches / 2;
    let numerator = matched * matched * right.byte_len() + matched * matched * left.byte_len()
        + (matched - transpositions) * left.byte_len() * right.byte_len();
    let denominator = 3 * left.byte_len() * right.byte_len() * matched;
    Option::Some(CliSimilarity { value: right, numerator, denominator })
}

fn similar_cli_subcommands(command: string) -> Vec[string] {
    let candidates: Vec[string] = Vec::[];
    candidates.push("check");
    candidates.push("test-check");
    candidates.push("build");
    candidates.push("test-build");
    candidates.push("link");
    candidates.push("test-link");
    candidates.push("prepare-world");
    candidates.push("package-info");
    candidates.push("run-single");
    candidates.push("version");
    candidates.push("help");
    let similar: Vec[CliSimilarity] = Vec::[];
    for candidate in candidates {
        match cli_jaro_similarity(command, candidate) {
            Some(value) => if value.numerator * 10 >= value.denominator * 7 {
                similar.push(value)
            } else {
                ()
            },
            None => (),
        }
    };
    for index in 1..similar.len() {
        let value = similar[index];
        let mut target = index;
        while target > 0
            && similar[target - 1].numerator * value.denominator
                > value.numerator * similar[target - 1].denominator {
            similar[target] = similar[target - 1];
            target = target - 1;
        };
        similar[target] = value;
    };
    let result: Vec[string] = Vec::[];
    for value in similar {
        result.push(value.value)
    };
    result
}

fn similar_subcommand_tip(values: Vec[string]) -> string {
    if values.is_empty() {
        ""
    } else {
        let builder = text::StringBuilder::new();
        builder.write_string(
            if values.len() == 1 {
                "\n\n  tip: a similar subcommand exists: "
            } else {
                "\n\n  tip: some similar subcommands exist: "
            },
        );
        for index in 0..values.len() {
            if index > 0 {
                builder.write_string(", ")
            } else {
                ()
            };
            builder.write_char('\'');
            builder.write_string(values[index]);
            builder.write_char('\'')
        };
        builder.finish()
    }
}

fn unknown_subcommand_error(command: string) -> string {
    let tip = similar_subcommand_tip(similar_cli_subcommands(command));
    "error: unrecognized subcommand '" + command + "'" + tip
        + "\n\nUsage: gomlc <COMMAND>\n\nFor more information, try '--help'."
}

fn fail_cli(message: string) -> unit {
    io::eprintln(message);
    process::exit(2)
}

fn fail_unknown_subcommand(command: string) -> unit {
    fail_cli(unknown_subcommand_error(command))
}

fn handle_cli_parse_error(command: string, error: string) -> unit {
    if is_cli_help_signal(error) {
        match command_help(command) {
            Some(help) => print_cli_help(help),
            None => (),
        };
        process::exit(0)
    } else {
        fail_cli(error)
    }
}

fn run_help_command(args: Vec[string]) -> unit {
    if args.len() == 2 {
        print_cli_help(top_level_help())
    } else if args.len() == 3 {
        match command_help(args[2]) {
            Some(help) => print_cli_help(help),
            None => fail_unknown_subcommand(args[2]),
        }
    } else {
        let command = args[2];
        match command_help(command) {
            Some(_) => {
                let usage = if command == "help" {
                    "gomlc help [COMMAND]..."
                } else {
                    command_usage(command)
                };
                let footer = if command == "help" {
                    ""
                } else {
                    "\n\n" + cli_error_footer()
                };
                fail_cli(
                    "error: unrecognized subcommand '" + args[3] + "'\n\nUsage: " + usage + footer,
                )
            },
            None => fail_unknown_subcommand(command),
        }
    }
}
