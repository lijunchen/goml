package main;

use gomlc::hash;
use gomlc::tast;

struct ArtifactFnScheme {
    name: string,
    type_params: Vec[string],
    constraints: Vec[tast::TypePredicate],
    ty: tast::Type,
    body: tast::Callable,
}

struct ArtifactAssociatedTypeDef {
    name: string,
    bounds: Vec[tast::TraitRef],
}

struct ArtifactTraitDef {
    name: string,
    params: Vec[string],
    predicates: Vec[tast::TypePredicate],
    supertraits: Vec[tast::TraitRef],
    associated_types: Vec[ArtifactAssociatedTypeDef],
    methods: Vec[ArtifactFnScheme],
}

struct ArtifactImplDef {
    params: Vec[string],
    constraints: Vec[tast::TypePredicate],
    associated_types: Vec[(string, tast::Type)],
    methods: Vec[ArtifactFnScheme],
    valid: bool,
}

struct ArtifactTraitImpl {
    trait_ref: tast::TraitRef,
    for_ty: tast::Type,
    definition: ArtifactImplDef,
}

enum ArtifactInherentImplKey {
    Exact(tast::Type),
    Constr(string),
}

struct ArtifactInherentImpl {
    key: ArtifactInherentImplKey,
    definition: ArtifactImplDef,
}

struct ArtifactPackageExports {
    enum_type_names: Vec[string],
    struct_type_names: Vec[string],
    type_aliases: Vec[tast::TypeAliasInfo],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    traits: Vec[ArtifactTraitDef],
    trait_impls: Vec[ArtifactTraitImpl],
    inherent_impls: Vec[ArtifactInherentImpl],
    functions: Vec[ArtifactFnScheme],
    constants: Vec[tast::ConstantScheme],
}

struct ArtifactPackageInterface {
    package_name: string,
    name: string,
    value_exports: Vec[(string, int)],
    enum_variants: Vec[(string, Vec[string])],
}

struct ArtifactInterfaceUnit {
    package_name: string,
    exports: ArtifactPackageExports,
    package_interface: ArtifactPackageInterface,
    deps: Vec[(string, string)],
    interface_hash: string,
}

fn empty_artifact_package_exports() -> ArtifactPackageExports {
    ArtifactPackageExports {
        enum_type_names: Vec::[],
        struct_type_names: Vec::[],
        type_aliases: Vec::[],
        enums: Vec::[],
        structs: Vec::[],
        traits: Vec::[],
        trait_impls: Vec::[],
        inherent_impls: Vec::[],
        functions: Vec::[],
        constants: Vec::[],
    }
}

fn artifact_exports_type_context(value: ArtifactPackageExports) -> ArtifactTypeContext {
    let enum_names = value.enum_type_names;
    let struct_names = value.struct_type_names;
    for definition in value.enums {
        enum_names.push(definition.name)
    };
    for definition in value.structs {
        struct_names.push(definition.name)
    };
    artifact_type_context(enum_names, struct_names)
}

fn artifact_json_type_pairs(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[(string, tast::Type)],
) -> unit {
    artifact_json_begin_array(writer);
    for value in values {
        artifact_json_begin_array(writer);
        artifact_json_string(writer, value.0);
        artifact_json_type(writer, context, value.1);
        artifact_json_end_array(writer)
    };
    artifact_json_end_array(writer)
}

fn artifact_json_enum_def(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::EnumDef,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "name");
    artifact_json_string(writer, value.name);
    artifact_json_name(writer, "generics");
    artifact_json_string_array(writer, value.generics);
    artifact_json_name(writer, "variants");
    artifact_json_begin_array(writer);
    for variant in value.variants {
        artifact_json_begin_object(writer);
        artifact_json_name(writer, "name");
        artifact_json_string(writer, variant.name);
        artifact_json_name(writer, "fields");
        match variant.fields {
            Unit => artifact_json_string(writer, "Unit"),
            Tuple(fields) => {
                artifact_json_begin_object(writer);
                artifact_json_name(writer, "Tuple");
                artifact_json_type_array(writer, context, fields);
                artifact_json_end_object(writer)
            },
            Struct(fields) => {
                artifact_json_begin_object(writer);
                artifact_json_name(writer, "Struct");
                artifact_json_type_pairs(writer, context, fields);
                artifact_json_end_object(writer)
            },
        };
        artifact_json_end_object(writer)
    };
    artifact_json_end_array(writer);
    artifact_json_end_object(writer)
}

fn artifact_json_struct_def(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::StructDef,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "name");
    artifact_json_string(writer, value.name);
    artifact_json_name(writer, "generics");
    artifact_json_string_array(writer, value.generics);
    artifact_json_name(writer, "fields");
    artifact_json_type_pairs(writer, context, value.fields);
    artifact_json_name(writer, "has_hidden_fields");
    artifact_json_bool(writer, value.has_hidden_fields);
    artifact_json_end_object(writer)
}

fn artifact_json_predicates(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[tast::TypePredicate],
) -> unit {
    artifact_json_begin_array(writer);
    for value in values {
        artifact_json_type_predicate(writer, context, value)
    };
    artifact_json_end_array(writer)
}

fn artifact_json_trait_refs(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[tast::TraitRef],
) -> unit {
    artifact_json_begin_array(writer);
    for value in values {
        artifact_json_trait_ref(writer, context, value)
    };
    artifact_json_end_array(writer)
}

fn artifact_json_fn_scheme(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactFnScheme,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "type_params");
    artifact_json_string_array(writer, value.type_params);
    artifact_json_name(writer, "constraints");
    artifact_json_predicates(writer, context, value.constraints);
    artifact_json_name(writer, "ty");
    artifact_json_type(writer, context, value.ty);
    artifact_json_name(writer, "body");
    artifact_json_callable_body(writer, artifact_callable(value.body));
    artifact_json_end_object(writer)
}

fn artifact_json_methods(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[ArtifactFnScheme],
) -> unit {
    artifact_json_begin_object(writer);
    for value in values {
        artifact_json_name(writer, value.name);
        artifact_json_fn_scheme(writer, context, value)
    };
    artifact_json_end_object(writer)
}

fn artifact_json_trait_def(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactTraitDef,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "params");
    artifact_json_string_array(writer, value.params);
    artifact_json_name(writer, "predicates");
    artifact_json_predicates(writer, context, value.predicates);
    artifact_json_name(writer, "supertraits");
    artifact_json_trait_refs(writer, context, value.supertraits);
    artifact_json_name(writer, "associated_types");
    artifact_json_begin_object(writer);
    for associated in value.associated_types {
        artifact_json_name(writer, associated.name);
        artifact_json_begin_object(writer);
        artifact_json_name(writer, "bounds");
        artifact_json_trait_refs(writer, context, associated.bounds);
        artifact_json_end_object(writer)
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "methods");
    artifact_json_methods(writer, context, value.methods);
    artifact_json_end_object(writer)
}

fn artifact_json_impl_def(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactImplDef,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "params");
    artifact_json_string_array(writer, value.params);
    artifact_json_name(writer, "constraints");
    artifact_json_predicates(writer, context, value.constraints);
    artifact_json_name(writer, "associated_types");
    artifact_json_begin_object(writer);
    for associated in value.associated_types {
        artifact_json_name(writer, associated.0);
        artifact_json_type(writer, context, associated.1)
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "methods");
    artifact_json_methods(writer, context, value.methods);
    artifact_json_name(writer, "valid");
    artifact_json_bool(writer, value.valid);
    artifact_json_end_object(writer)
}

fn artifact_json_trait_impl_key(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactTraitImpl,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "trait_ref");
    artifact_json_trait_ref(writer, context, value.trait_ref);
    artifact_json_name(writer, "for_ty");
    artifact_json_type(writer, context, value.for_ty);
    artifact_json_end_object(writer)
}

fn artifact_json_inherent_impl_key(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactInherentImplKey,
) -> unit {
    artifact_json_begin_object(writer);
    match value {
        Exact(value) => {
            artifact_json_name(writer, "Exact");
            artifact_json_type(writer, context, value)
        },
        Constr(value) => {
            artifact_json_name(writer, "Constr");
            artifact_json_string(writer, value)
        },
    };
    artifact_json_end_object(writer)
}

fn artifact_json_package_exports(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactPackageExports,
) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "type_env");
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "enums");
    artifact_json_begin_object(writer);
    for definition in value.enums {
        artifact_json_name(writer, definition.name);
        artifact_json_enum_def(writer, context, definition)
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "structs");
    artifact_json_begin_object(writer);
    for definition in value.structs {
        artifact_json_name(writer, definition.name);
        artifact_json_struct_def(writer, context, definition)
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "aliases");
    artifact_json_begin_object(writer);
    for alias in value.type_aliases {
        artifact_json_name(writer, alias.name);
        artifact_json_begin_object(writer);
        artifact_json_name(writer, "generics");
        artifact_json_string_array(writer, alias.generics);
        artifact_json_name(writer, "ty");
        artifact_json_type(writer, context, alias.ty);
        artifact_json_end_object(writer)
    };
    artifact_json_end_object(writer);
    artifact_json_end_object(writer);
    artifact_json_name(writer, "trait_env");
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "trait_defs");
    artifact_json_begin_object(writer);
    for definition in value.traits {
        artifact_json_name(writer, definition.name);
        artifact_json_trait_def(writer, context, definition)
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "trait_impls");
    artifact_json_begin_array(writer);
    for implementation in value.trait_impls {
        artifact_json_begin_array(writer);
        artifact_json_trait_impl_key(writer, context, implementation);
        artifact_json_impl_def(writer, context, implementation.definition);
        artifact_json_end_array(writer)
    };
    artifact_json_end_array(writer);
    artifact_json_name(writer, "inherent_impls");
    artifact_json_begin_array(writer);
    for implementation in value.inherent_impls {
        artifact_json_begin_array(writer);
        artifact_json_inherent_impl_key(writer, context, implementation.key);
        artifact_json_impl_def(writer, context, implementation.definition);
        artifact_json_end_array(writer)
    };
    artifact_json_end_array(writer);
    artifact_json_end_object(writer);
    artifact_json_name(writer, "value_env");
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "funcs");
    artifact_json_begin_object(writer);
    for function in value.functions {
        artifact_json_name(writer, function.name);
        artifact_json_fn_scheme(writer, context, function)
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "consts");
    artifact_json_begin_object(writer);
    for value in value.constants {
        artifact_json_name(writer, value.name);
        artifact_json_begin_object(writer);
        artifact_json_name(writer, "ty");
        artifact_json_type(writer, context, value.ty);
        artifact_json_end_object(writer)
    };
    artifact_json_end_object(writer);
    artifact_json_end_object(writer);
    artifact_json_end_object(writer)
}

fn artifact_json_string_map(writer: ArtifactJsonWriter, values: Vec[(string, string)]) -> unit {
    for index in 1..values.len() {
        let current = values[index];
        let mut destination = index;
        while destination > 0
            && artifact_string_less(current.0, values[destination - 1].0) {
            values[destination] = values[destination - 1];
            destination = destination - 1;
        };
        values[destination] = current;
    };
    artifact_json_begin_object(writer);
    for value in values {
        artifact_json_name(writer, value.0);
        artifact_json_string(writer, value.1)
    };
    artifact_json_end_object(writer)
}

fn artifact_json_package_interface(writer: ArtifactJsonWriter, value: ArtifactPackageInterface) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "package");
    artifact_json_string(writer, value.package_name);
    artifact_json_name(writer, "name");
    artifact_json_string(writer, value.name);
    artifact_json_name(writer, "value_exports");
    artifact_json_begin_object(writer);
    for export in value.value_exports {
        artifact_json_name(writer, export.0);
        artifact_json_number(writer, export.1.to_string())
    };
    artifact_json_end_object(writer);
    artifact_json_name(writer, "enum_variants");
    artifact_json_begin_object(writer);
    for definition in value.enum_variants {
        artifact_json_name(writer, definition.0);
        artifact_json_string_array(writer, definition.1)
    };
    artifact_json_end_object(writer);
    artifact_json_end_object(writer)
}

fn artifact_json_interface_hash_view(
    writer: ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: ArtifactInterfaceUnit,
) -> unit {
    artifact_json_begin_object(writer);
    if writer.binary_mode < 2 {
        artifact_json_name(writer, "format_version");
        artifact_json_number(writer, "17");
        artifact_json_name(writer, "compiler_abi");
        artifact_json_number(writer, "3")
    } else {
        ()
    };
    artifact_json_name(writer, "package");
    artifact_json_string(writer, value.package_name);
    artifact_json_name(writer, "exports");
    artifact_json_package_exports(writer, context, value.exports);
    artifact_json_name(writer, "interface");
    artifact_json_package_interface(writer, value.package_interface);
    artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    artifact_json_end_object(writer)
}

fn artifact_interface_hash(value: ArtifactInterfaceUnit) -> string {
    let writer = new_artifact_json_writer(false);
    artifact_json_interface_hash_view(writer, artifact_exports_type_context(value.exports), value);
    hash::sha256_hex(artifact_json_finish(writer))
}

fn new_artifact_interface_unit(
    package_name: string,
    exports: ArtifactPackageExports,
    package_interface: ArtifactPackageInterface,
    deps: Vec[(string, string)],
) -> ArtifactInterfaceUnit {
    let value = ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash: "",
    };
    let interface_hash = artifact_interface_hash(value);
    ArtifactInterfaceUnit {
        package_name: value.package_name,
        exports: value.exports,
        package_interface: value.package_interface,
        deps: value.deps,
        interface_hash,
    }
}

fn artifact_json_interface_unit(writer: ArtifactJsonWriter, value: ArtifactInterfaceUnit) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "format_version");
    artifact_json_number(writer, "17");
    artifact_json_name(writer, "compiler_abi");
    artifact_json_number(writer, "3");
    artifact_json_name(writer, "package");
    artifact_json_string(writer, value.package_name);
    artifact_json_name(writer, "exports");
    artifact_json_package_exports(
        writer,
        artifact_exports_type_context(value.exports),
        value.exports,
    );
    artifact_json_name(writer, "interface");
    artifact_json_package_interface(writer, value.package_interface);
    artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    artifact_json_name(writer, "interface_hash");
    artifact_json_string(writer, value.interface_hash);
    artifact_json_end_object(writer)
}

fn encode_artifact_interface_unit(value: ArtifactInterfaceUnit, pretty: bool) -> string {
    let writer = new_artifact_json_writer(pretty);
    artifact_json_interface_unit(writer, value);
    artifact_json_finish(writer)
}
