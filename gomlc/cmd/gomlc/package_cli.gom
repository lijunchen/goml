package main;

use gomlc::strings;
use std::fs;
use std::path;

struct PackageCommandArgs {
    package_name: string,
    inputs: Vec[string],
    interface_paths: Vec[string],
    output: string,
    world: Option[string],
}

struct LinkCommandArgs {
    inputs: Vec[string],
    entry: string,
    output: string,
    world: Option[string],
}

struct TestLinkCommandArgs {
    inputs: Vec[string],
    packages: Vec[string],
    output: string,
    manifest: string,
    world: Option[string],
}

struct ExtractedWorldArgs {
    args: Vec[string],
    world: Option[string],
}

fn extract_world_args(args: Vec[string]) -> Result[ExtractedWorldArgs, string] {
    let result = Vec::new();
    let world: Ref[Option[string]] = Ref::new(Option::None);
    let index = Ref::new(0);
    let positional = Ref::new(false);
    while index.get() < args.len() {
        let argument = args[index.get()];
        if index.get() >= 2 && positional.get() == false && argument == "--" {
            positional.set(true);
            result.push(argument);
            index.set(index.get() + 1)
        } else if index.get() >= 2 && positional.get() == false && argument == "--world" {
            if option_string_present(world.get()) {
                return Result::Err(repeated_argument_error(args[1], "--world <WORLD>"))
            } else if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--world <WORLD>", Option::None))
            } else {
                world.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if index.get() >= 2 && positional.get() == false
            && option_string_present(inline_cli_value(argument, "--world")) {
            if option_string_present(world.get()) {
                return Result::Err(repeated_argument_error(args[1], "--world <WORLD>"))
            } else if option_string_empty(inline_cli_value(argument, "--world")) {
                return Result::Err(value_required_error("--world <WORLD>", Option::None))
            } else {
                world.set(inline_cli_value(argument, "--world"));
                index.set(index.get() + 1)
            }
        } else {
            result.push(argument);
            index.set(index.get() + 1)
        }
    };
    Result::Ok(ExtractedWorldArgs { args: result, world: world.get() })
}

fn cli_option(value: string) -> bool {
    strings::starts_with(value, "-")
}

fn inline_cli_value(argument: string, name: string) -> Option[string] {
    let prefix = name + "=";
    if strings::starts_with(argument, prefix) {
        Option::Some(argument.byte_slice(prefix.byte_len(), argument.byte_len()))
    } else {
        Option::None
    }
}

fn option_string_present(value: Option[string]) -> bool {
    value.is_some()
}

fn option_string_empty(value: Option[string]) -> bool {
    match value {
        Some(value) => value == "",
        None => false,
    }
}

fn selected_package_usage(command: string, interface_paths: Vec[string]) -> string {
    if interface_paths.len() > 0 {
        required_command_usage(command) + " --interface-path <INTERFACE_FILE>"
    } else {
        required_command_usage(command)
    }
}

fn sorted_unique_package_inputs(values: Vec[string]) -> Vec[string] {
    let sorted = sort_artifact_names(values);
    let result: Vec[string] = Vec::new();
    for value in sorted {
        if result.len() == 0 || result[result.len() - 1] != value {
            result.push(value)
        } else {
            ()
        }
    };
    result
}

fn parse_package_command_args(args: Vec[string]) -> Result[PackageCommandArgs, string] {
    let extracted = extract_world_args(args)?;
    let args = extracted.args;
    let package_name: Ref[Option[string]] = Ref::new(Option::None);
    let output: Ref[Option[string]] = Ref::new(Option::None);
    let inputs = Vec::new();
    let interface_paths = Vec::new();
    let index = Ref::new(2);
    let positional = Ref::new(false);
    let command = args[1];
    while index.get() < args.len() {
        let argument = args[index.get()];
        if positional.get() == false && argument == "--" {
            positional.set(true);
            index.set(index.get() + 1)
        } else if positional.get() == false && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--help")) {
            let value = match inline_cli_value(argument, "--help") {
                Some(value) => value,
                None => "",
            };
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    selected_package_usage(command, interface_paths) + " --help",
                ),
            )
        } else if positional.get() == false && cli_value_option(command, argument)
            && index.get() + 1 < args.len()
            && cli_option(args[index.get() + 1])
            && !known_cli_option(command, args[index.get() + 1]) {
            let usage = if option_string_present(package_name.get())
                || option_string_present(output.get())
                || inputs.len() > 0
                || interface_paths.len() > 0 {
                selected_package_usage(command, interface_paths)
            } else {
                command_usage(command)
            };
            return Result::Err(
                unexpected_cli_option_error_with_usage(command, args[index.get() + 1], usage),
            )
        } else if positional.get() {
            return Result::Err(unexpected_argument_error(command, argument, false))
        } else if argument == "--package" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--package <PACKAGE>", Option::None))
            } else if option_string_present(package_name.get()) {
                return Result::Err(repeated_argument_error(command, "--package <PACKAGE>"))
            } else {
                package_name.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--package")) {
            if option_string_present(package_name.get()) {
                return Result::Err(repeated_argument_error(command, "--package <PACKAGE>"))
            } else {
                package_name.set(inline_cli_value(argument, "--package"));
                index.set(index.get() + 1)
            }
        } else if argument == "--input" {
            index.set(index.get() + 1);
            let previous_len = inputs.len();
            while index.get() < args.len() && !cli_option(args[index.get()]) {
                inputs.push(args[index.get()]);
                index.set(index.get() + 1)
            };
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                ()
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = match inline_cli_value(argument, "--input") {
                Some(value) => value,
                None => "",
            };
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index.set(index.get() + 1);
                while index.get() < args.len() && !cli_option(args[index.get()]) {
                    inputs.push(args[index.get()]);
                    index.set(index.get() + 1)
                }
            }
        } else if argument == "--interface-path" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(
                    value_required_error("--interface-path <INTERFACE_FILE>", Option::None),
                )
            } else {
                interface_paths.push(args[index.get() + 1]);
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--interface-path")) {
            if option_string_empty(inline_cli_value(argument, "--interface-path")) {
                return Result::Err(
                    value_required_error("--interface-path <INTERFACE_FILE>", Option::None),
                )
            } else {
                match inline_cli_value(argument, "--interface-path") {
                    Some(value) => interface_paths.push(value),
                    None => (),
                };
                index.set(index.get() + 1)
            }
        } else if argument == "--output" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--output")) {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(inline_cli_value(argument, "--output"));
                index.set(index.get() + 1)
            }
        } else {
            match similar_cli_argument(command, argument) {
                Some(similar) => {
                    let usage = if similar == "--interface-path" && interface_paths.len() == 0 {
                        required_command_usage(command) + " --interface-path <INTERFACE_FILE>"
                    } else if similar == "--help" {
                        selected_package_usage(command, interface_paths) + " --help"
                    } else {
                        selected_package_usage(command, interface_paths)
                    };
                    return Result::Err(unexpected_similar_argument_error(argument, similar, usage))
                },
                None => (),
            };
            let usage = if cli_option(argument)
                && (option_string_present(package_name.get()) || option_string_present(output.get())
                    || inputs.len() > 0
                    || interface_paths.len() > 0) {
                selected_package_usage(command, interface_paths)
            } else {
                command_usage(command)
            };
            return Result::Err(unexpected_argument_error_with_usage(argument, false, usage))
        }
    };
    let missing = Vec::new();
    if !option_string_present(package_name.get()) {
        missing.push("--package <PACKAGE>")
    } else {
        ()
    };
    if inputs.len() == 0 {
        missing.push("--input <INPUT>...")
    } else {
        ()
    };
    if !option_string_present(output.get()) {
        missing.push("--output <OUTPUT>")
    } else {
        ()
    };
    if missing.len() > 0 {
        Result::Err(
            missing_required_arguments_error_with_usage(
                missing,
                selected_package_usage(command, interface_paths),
            ),
        )
    } else {
        Result::Ok(
            PackageCommandArgs {
                package_name: match package_name.get() {
                    Some(value) => value,
                    None => "",
                },
                inputs: sorted_unique_package_inputs(inputs),
                interface_paths,
                output: match output.get() {
                    Some(value) => value,
                    None => "",
                },
                world: extracted.world,
            },
        )
    }
}

fn parse_link_command_args(args: Vec[string]) -> Result[LinkCommandArgs, string] {
    let extracted = extract_world_args(args)?;
    let args = extracted.args;
    let entry: Ref[Option[string]] = Ref::new(Option::None);
    let output: Ref[Option[string]] = Ref::new(Option::None);
    let inputs = Vec::new();
    let index = Ref::new(2);
    let positional = Ref::new(false);
    let command = args[1];
    while index.get() < args.len() {
        let argument = args[index.get()];
        if positional.get() == false && argument == "--" {
            positional.set(true);
            index.set(index.get() + 1)
        } else if positional.get() == false && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--help")) {
            let value = match inline_cli_value(argument, "--help") {
                Some(value) => value,
                None => "",
            };
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    command_usage(command) + " --help",
                ),
            )
        } else if positional.get() == false && cli_value_option(command, argument)
            && index.get() + 1 < args.len()
            && cli_option(args[index.get() + 1])
            && !known_cli_option(command, args[index.get() + 1]) {
            return Result::Err(
                unexpected_cli_option_error_with_usage(
                    command,
                    args[index.get() + 1],
                    command_usage(command),
                ),
            )
        } else if positional.get() {
            return Result::Err(unexpected_argument_error(command, argument, false))
        } else if argument == "--input" {
            index.set(index.get() + 1);
            let previous_len = inputs.len();
            while index.get() < args.len() && !cli_option(args[index.get()]) {
                inputs.push(args[index.get()]);
                index.set(index.get() + 1)
            };
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                ()
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = match inline_cli_value(argument, "--input") {
                Some(value) => value,
                None => "",
            };
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index.set(index.get() + 1);
                while index.get() < args.len() && !cli_option(args[index.get()]) {
                    inputs.push(args[index.get()]);
                    index.set(index.get() + 1)
                }
            }
        } else if argument == "--entry" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--entry <ENTRY>", Option::None))
            } else if option_string_present(entry.get()) {
                return Result::Err(repeated_argument_error(command, "--entry <ENTRY>"))
            } else {
                entry.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--entry")) {
            if option_string_present(entry.get()) {
                return Result::Err(repeated_argument_error(command, "--entry <ENTRY>"))
            } else {
                entry.set(inline_cli_value(argument, "--entry"));
                index.set(index.get() + 1)
            }
        } else if argument == "--output" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--output")) {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(inline_cli_value(argument, "--output"));
                index.set(index.get() + 1)
            }
        } else {
            match similar_cli_argument(command, argument) {
                Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(argument, similar, command_usage(command)),
                ),
                None => return Result::Err(unexpected_argument_error(command, argument, false)),
            }
        }
    };
    let missing = Vec::new();
    if inputs.len() == 0 {
        missing.push("--input <INPUT>...")
    } else {
        ()
    };
    if !option_string_present(entry.get()) {
        missing.push("--entry <ENTRY>")
    } else {
        ()
    };
    if !option_string_present(output.get()) {
        missing.push("--output <OUTPUT>")
    } else {
        ()
    };
    if missing.len() > 0 {
        Result::Err(missing_required_arguments_error(command, missing))
    } else {
        Result::Ok(
            LinkCommandArgs {
                inputs,
                entry: match entry.get() {
                    Some(value) => value,
                    None => "",
                },
                output: match output.get() {
                    Some(value) => value,
                    None => "",
                },
                world: extracted.world,
            },
        )
    }
}

fn parse_test_link_command_args(args: Vec[string]) -> Result[TestLinkCommandArgs, string] {
    let extracted = extract_world_args(args)?;
    let args = extracted.args;
    let output: Ref[Option[string]] = Ref::new(Option::None);
    let manifest: Ref[Option[string]] = Ref::new(Option::None);
    let inputs = Vec::new();
    let packages = Vec::new();
    let index = Ref::new(2);
    let positional = Ref::new(false);
    let command = args[1];
    while index.get() < args.len() {
        let argument = args[index.get()];
        if positional.get() == false && argument == "--" {
            positional.set(true);
            index.set(index.get() + 1)
        } else if positional.get() == false && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--help")) {
            let value = match inline_cli_value(argument, "--help") {
                Some(value) => value,
                None => "",
            };
            return Result::Err(
                unexpected_value_error_with_usage(
                    value,
                    "--help",
                    command_usage(command) + " --help",
                ),
            )
        } else if positional.get() == false && cli_value_option(command, argument)
            && index.get() + 1 < args.len()
            && cli_option(args[index.get() + 1])
            && !known_cli_option(command, args[index.get() + 1]) {
            return Result::Err(
                unexpected_cli_option_error_with_usage(
                    command,
                    args[index.get() + 1],
                    command_usage(command),
                ),
            )
        } else if positional.get() {
            return Result::Err(unexpected_argument_error(command, argument, false))
        } else if argument == "--input" {
            index.set(index.get() + 1);
            let previous_len = inputs.len();
            while index.get() < args.len() && !cli_option(args[index.get()]) {
                inputs.push(args[index.get()]);
                index.set(index.get() + 1)
            };
            if inputs.len() == previous_len {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                ()
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = match inline_cli_value(argument, "--input") {
                Some(value) => value,
                None => "",
            };
            if value == "" {
                return Result::Err(value_required_error("--input <INPUT>...", Option::None))
            } else {
                inputs.push(value);
                index.set(index.get() + 1);
                while index.get() < args.len() && !cli_option(args[index.get()]) {
                    inputs.push(args[index.get()]);
                    index.set(index.get() + 1)
                }
            }
        } else if argument == "--package" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--package <PACKAGE>", Option::None))
            } else {
                packages.push(args[index.get() + 1]);
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--package")) {
            match inline_cli_value(argument, "--package") {
                Some(value) => packages.push(value),
                None => (),
            };
            index.set(index.get() + 1)
        } else if argument == "--output" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--output")) {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(inline_cli_value(argument, "--output"));
                index.set(index.get() + 1)
            }
        } else if argument == "--manifest" {
            if index.get() + 1 >= args.len() || cli_option(args[index.get() + 1]) {
                return Result::Err(value_required_error("--manifest <MANIFEST>", Option::None))
            } else if option_string_present(manifest.get()) {
                return Result::Err(repeated_argument_error(command, "--manifest <MANIFEST>"))
            } else {
                manifest.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--manifest")) {
            if option_string_empty(inline_cli_value(argument, "--manifest")) {
                return Result::Err(value_required_error("--manifest <MANIFEST>", Option::None))
            } else if option_string_present(manifest.get()) {
                return Result::Err(repeated_argument_error(command, "--manifest <MANIFEST>"))
            } else {
                manifest.set(inline_cli_value(argument, "--manifest"));
                index.set(index.get() + 1)
            }
        } else {
            match similar_cli_argument(command, argument) {
                Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(argument, similar, command_usage(command)),
                ),
                None => return Result::Err(unexpected_argument_error(command, argument, false)),
            }
        }
    };
    let missing = Vec::new();
    if inputs.len() == 0 {
        missing.push("--input <INPUT>...")
    } else {
        ()
    };
    if packages.len() == 0 {
        missing.push("--package <PACKAGE>")
    } else {
        ()
    };
    if !option_string_present(output.get()) {
        missing.push("--output <OUTPUT>")
    } else {
        ()
    };
    if !option_string_present(manifest.get()) {
        missing.push("--manifest <MANIFEST>")
    } else {
        ()
    };
    if missing.len() > 0 {
        Result::Err(missing_required_arguments_error(command, missing))
    } else {
        Result::Ok(
            TestLinkCommandArgs {
                inputs,
                packages,
                output: match output.get() {
                    Some(value) => value,
                    None => "",
                },
                manifest: match manifest.get() {
                    Some(value) => value,
                    None => "",
                },
                world: extracted.world,
            },
        )
    }
}

fn ensure_parent(path_value: string) -> Result[unit, string] {
    match path::parent(path_value) {
        Some(parent) => fs::create_dir_all(parent),
        None => Result::Ok(()),
    }
}

fn interface_output_path(output: string) -> string {
    path::with_extension(output, "interface")
}

fn core_output_path(output: string) -> string {
    path::with_extension(output, "core")
}
