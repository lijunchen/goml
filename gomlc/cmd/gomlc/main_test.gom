fn test_package_world() -> PackageWorld {
    match env::var("GOML_TEST_COMPILER_WORLD") {
        Some(path) => match read_package_world(path) {
            Ok(value) => value,
            Err(error) => {
                testing::fail(error);
                package_world()
            },
        },
        None => package_world(),
    }
}

fn main_string_contains(value: string, expected: string) -> bool {
    if expected.byte_len() == 0 {
        true
    } else if value.byte_len() < expected.byte_len() {
        false
    } else {
        let found = Ref::new(false);
        for index in range(0, value.byte_len() - expected.byte_len() + 1) {
            if value.byte_slice(index, index + expected.byte_len()) == expected {
                found.set(true)
            } else {}
        }
        found.get()
    }
}

#[test]
fn stage_lowering_preserves_hidden_fresh_names() -> unit {
    let source = "enum E { A(int32), B(int32), C(int32) } fn main() -> unit { let value = E::B(1); match value { E::B(item) => (), _ => () } }";
    let stage = lower_core_stage("main.gom", source);
    testing::assert_eq(stage.counter.get(), 3)
}

fn args_with(values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push("run-single");
    for value in values {
        args.push(value)
    }
    args
}

fn version_args_with(values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push("version");
    for value in values {
        args.push(value)
    }
    args
}

fn command_args_with(command: string, values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push(command);
    for value in values {
        args.push(value)
    }
    args
}

fn parse_ok(values: Vec[string]) -> RunArgs {
    match parse_run_args(args_with(values)) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            parse_ok(Vec::new())
        },
    }
}

fn assert_parse_error(values: Vec[string], expected: string) -> unit {
    match parse_run_args(args_with(values)) {
        Ok(_) => testing::fail("expected argument error"),
        Err(error) => testing::assert_eq(error, expected),
    }
}

fn core_function_index(value: core::File, expected: string) -> int {
    let result = Ref::new(-1);
    for index in range(0, value.functions.len()) {
        if value.functions.get(index).name == expected {
            result.set(index)
        } else {}
    }
    result.get()
}

#[test]
fn detects_single_file_entrypoint() -> unit {
    let present = tast::check_for_link(
        hir::lower(ast::lower(parser::parse("fn main() -> unit {}")), "main.gom"),
    );
    let missing = tast::check_for_link(
        hir::lower(ast::lower(parser::parse("fn helper() -> unit {}")), "main.gom"),
    );
    testing::assert(has_single_file_entrypoint(present));
    testing::assert(!has_single_file_entrypoint(missing))
}

#[test]
fn links_imported_standard_package_closure() -> unit {
    let source = "use std::fs; use std::io; fn main() -> unit { let _ = fs::write_file(\"out.txt\", \"ok\"); io::println(\"done\") }";
    let compilation = compile_source("main.gom", source);
    let bytes = core_function_index(
        compilation.core_value,
        "inherent#std::bytes::Bytes#std::bytes::Bytes#from_string",
    );
    let fs = core_function_index(compilation.core_value, "std::fs::read_file");
    let io = core_function_index(compilation.core_value, "std::io::println");
    let main = core_function_index(compilation.core_value, "main");
    testing::assert(bytes >= 0);
    testing::assert(fs >= 0);
    testing::assert(io >= 0);
    testing::assert(bytes < main);
    testing::assert(fs < main);
    testing::assert(io < main);
    testing::assert_eq(core_function_index(compilation.core_value, "std::env::args"), -1)
}

#[test]
fn tracks_host_api_package_link_needs() -> unit {
    let source = "package main; use std::path; use std::process; use std::testing; fn main() -> unit {}";
    let needs = source_standard_needs(ast::lower(parser::parse(source)));
    testing::assert(needs.bytes);
    testing::assert(needs.path);
    testing::assert(needs.process);
    testing::assert(needs.testing);
    testing::assert(!needs.root);
    testing::assert(needs.ascii);
    testing::assert(!needs.cmp);
    testing::assert(!needs.collections);
    testing::assert(needs.env);
    testing::assert(!needs.fs);
    testing::assert(needs.io);
    testing::assert(!needs.iter);
    testing::assert(!needs.json);
    testing::assert(needs.num);
    testing::assert(needs.internal_task);
    testing::assert(needs.task);
    testing::assert(needs.text);
    testing::assert(needs.time)
}

#[test]
fn tracks_json_package_link_needs() -> unit {
    let source = "package main; use std::json; fn main() -> unit { let _ = json::parse(\"null\"); () }";
    let needs = source_standard_needs(ast::lower(parser::parse(source)));
    testing::assert(needs.ascii);
    testing::assert(needs.bytes);
    testing::assert(needs.json);
    testing::assert(needs.text);
    testing::assert(!needs.root)
}

#[test]
fn tracks_standard_root_package_needs() -> unit {
    let needs = source_standard_needs(
        ast::lower(parser::parse("package main; use std; fn main() -> unit {}")),
    );
    testing::assert(needs.root);
    testing::assert(needs.ascii);
    testing::assert(needs.bytes);
    testing::assert(needs.cmp);
    testing::assert(needs.collections);
    testing::assert(needs.env);
    testing::assert(needs.fs);
    testing::assert(needs.io);
    testing::assert(needs.iter);
    testing::assert(needs.json);
    testing::assert(needs.num);
    testing::assert(needs.path);
    testing::assert(needs.process);
    testing::assert(!needs.testing);
    testing::assert(needs.text);
    testing::assert(needs.time)
}

#[test]
fn tracks_ascii_and_iter_package_needs() -> unit {
    let needs = source_standard_needs(
        ast::lower(
            parser::parse("package main; use std::ascii; use std::iter; fn main() -> unit {}"),
        ),
    );
    testing::assert(needs.ascii);
    testing::assert(needs.iter);
    testing::assert(!needs.root);
    testing::assert(!needs.bytes);
    testing::assert(!needs.cmp);
    testing::assert(!needs.text)
}

#[test]
fn tracks_cmp_and_collections_package_needs() -> unit {
    let direct = source_standard_needs(
        ast::lower(parser::parse("package main; use std::cmp; fn main() -> unit {}")),
    );
    testing::assert(direct.cmp);
    testing::assert(!direct.collections);
    let collections = source_standard_needs(
        ast::lower(parser::parse("package main; use std::collections; fn main() -> unit {}")),
    );
    testing::assert(collections.cmp);
    testing::assert(collections.collections)
}

#[test]
fn parses_run_single_dump_flags() -> unit {
    let values = Vec::new();
    values.push("--dump-go");
    values.push("main.gom");
    values.push("--dump-ast");
    values.push("--dump-expanded-ast");
    values.push("--dump-tast");
    values.push("--dump-ctir");
    values.push("--dump-core");
    values.push("--dump-mono");
    values.push("--dump-lift");
    values.push("--dump-anf");
    values.push("--dump-hir");
    let args = parse_ok(values);
    testing::assert_eq(args.file, "main.gom");
    testing::assert(args.dump_ast);
    testing::assert(args.dump_expanded_ast);
    testing::assert(args.dump_hir);
    testing::assert(args.dump_tast);
    testing::assert(args.dump_ctir);
    testing::assert(args.dump_core);
    testing::assert(args.dump_mono);
    testing::assert(args.dump_lift);
    testing::assert(args.dump_anf);
    testing::assert(args.dump_go)
}

#[test]
fn parses_run_single_without_dumps() -> unit {
    let values = Vec::new();
    values.push("main.gom");
    let args = parse_ok(values);
    testing::assert_eq(args.file, "main.gom");
    testing::assert(!args.dump_ast);
    testing::assert(!args.dump_expanded_ast);
    testing::assert(!args.dump_hir);
    testing::assert(!args.dump_tast);
    testing::assert(!args.dump_ctir);
    testing::assert(!args.dump_core);
    testing::assert(!args.dump_mono);
    testing::assert(!args.dump_lift);
    testing::assert(!args.dump_anf);
    testing::assert(!args.dump_go)
}

#[test]
fn preserves_source_and_expanded_ast_views() -> unit {
    let compilation = compile_source(
        "main.gom",
        "#[derive(PartialEq, Eq)] struct Key { value: int } fn main() -> unit { () }",
    );
    let source = ast::pretty(compilation.source_ast_value);
    let expanded = ast::pretty(compilation.ast_value);
    testing::assert(!source.contains("impl Eq for Key"));
    testing::assert(expanded.contains("impl PartialEq for Key"));
    testing::assert(expanded.contains("impl Eq for Key"))
}

#[test]
fn parses_version_formats() -> unit {
    match parse_version_args(version_args_with(Vec::new())) {
        Ok(Text) => (),
        _ => testing::fail("expected default text version format"),
    };
    let json_args = Vec::new();
    json_args.push("--format");
    json_args.push("json");
    match parse_version_args(version_args_with(json_args)) {
        Ok(Json) => (),
        _ => testing::fail("expected json version format"),
    };
    let inline_args = Vec::new();
    inline_args.push("--format=text");
    match parse_version_args(version_args_with(inline_args)) {
        Ok(Text) => (),
        _ => testing::fail("expected inline text version format"),
    }
}

#[test]
fn parses_package_information_without_lowering_file_bodies() -> unit {
    let source = "// header\npackage sample;\nuse alpha::beta;\nuse gamma::delta as other;\nuse theta::api::{Thing, make as create,};\nfn main() -> unit { let _ = \"use hidden::path;\"; }";
    match parse_package_info_file("main.gom", source) {
        Ok(value) => {
            testing::assert_eq(value.package_name, "sample");
            testing::assert(value.package_explicit);
            testing::assert_eq(value.uses.len(), 3);
            testing::assert_eq(value.uses.get(0).path, "alpha::beta");
            match value.uses.get(0).alias {
                Some(alias) => testing::assert_eq(alias, "beta"),
                None => testing::fail("expected inferred use alias"),
            };
            testing::assert_eq(value.uses.get(1).path, "gamma::delta");
            match value.uses.get(1).alias {
                Some(alias) => testing::assert_eq(alias, "other"),
                None => testing::fail("expected use alias"),
            };
            testing::assert_eq(value.uses.get(2).path, "theta::api");
            testing::assert(value.uses.get(2).alias.is_none())
        },
        Err(error) => testing::fail(error),
    };
    match parse_package_info_file("main.gom", "use alpha::;") {
        Err(error) => testing::assert_eq(
            error,
            "error[parser]: main.gom: expected a path segment after '::'",
        ),
        Ok(_) => testing::fail("expected package information error"),
    }
}

#[test]
fn package_information_scanner_stops_at_the_first_body_token() -> unit {
    let source = "// header\npackage main;\nuse alpha::beta as value;\nfn main() -> unit {}";
    let scanner = new_package_info_scanner(source);
    package_info_skip_trivia(scanner);
    testing::assert(package_info_consume_keyword(scanner, "package"));
    match package_info_read_ident(scanner) {
        Some(value) => testing::assert_eq(value, "main"),
        None => testing::fail("expected package name"),
    };
    testing::assert(package_info_consume_text(scanner, ";"));
    testing::assert(package_info_consume_keyword(scanner, "use"));
    match package_info_parse_use(scanner, "main.gom") {
        Ok(value) => {
            testing::assert_eq(value.path, "alpha::beta");
            match value.alias {
                Some(alias) => testing::assert_eq(alias, "value"),
                None => testing::fail("expected use alias"),
            }
        },
        Err(error) => testing::fail(error),
    };
    package_info_skip_trivia(scanner);
    testing::assert(package_info_at_keyword(scanner, "fn"));
    testing::assert(scanner.index.get() < source.byte_len())
}

#[test]
fn package_information_scanner_respects_keyword_boundaries() -> unit {
    let scanner = new_package_info_scanner("package_name");
    testing::assert_eq(package_info_consume_keyword(scanner, "package"), false);
    let use_scanner = new_package_info_scanner("useful");
    testing::assert_eq(package_info_consume_keyword(use_scanner, "use"), false)
}

#[test]
fn reports_driver_protocol_version() -> unit {
    testing::assert_eq(
        version_output_with(VersionFormat::Text, Option::None, Option::None),
        "gomlc " + version::current(),
    );
    testing::assert_eq(
        version_output_with(VersionFormat::Json, Option::None, Option::None),
        "{\"artifact_format\":18,\"compiler_abi\":5,\"driver_protocol\":1,\"installed_world\":1,\"world_artifact\":1,\"git_date\":null,\"git_hash\":null,\"tool\":\"gomlc\",\"version\":\""
            + version::current()
            + "\"}",
    );
    match parse_version_format("yaml") {
        Err(error) => testing::assert_eq(
            error,
            "error: invalid value 'yaml' for '--format <FORMAT>'\n  [possible values: text, json]\n\nFor more information, try '--help'.",
        ),
        Ok(_) => testing::fail("expected invalid version format"),
    }
}

#[test]
fn suggests_similar_subcommands() -> unit {
    testing::assert_eq(
        unknown_subcommand_error("chec"),
        "error: unrecognized subcommand 'chec'\n\n  tip: a similar subcommand exists: 'check'\n\nUsage: gomlc <COMMAND>\n\nFor more information, try '--help'.",
    );
    testing::assert_eq(
        unknown_subcommand_error("unknown"),
        "error: unrecognized subcommand 'unknown'\n\nUsage: gomlc <COMMAND>\n\nFor more information, try '--help'.",
    );
    testing::assert_eq(
        unknown_subcommand_error("xcheck"),
        "error: unrecognized subcommand 'xcheck'\n\n  tip: some similar subcommands exist: 'test-check', 'check'\n\nUsage: gomlc <COMMAND>\n\nFor more information, try '--help'.",
    )
}

#[test]
fn parses_package_command_arguments() -> unit {
    let values = Vec::new();
    values.push("--package");
    values.push("alice::app");
    values.push("--input");
    values.push("main.gom");
    values.push("extra.gom");
    values.push("main.gom");
    values.push("--interface-path");
    values.push("lib.interface");
    values.push("--output");
    values.push("artifact/package");
    values.push("--world");
    values.push("artifact/world.gaf");
    match parse_package_command_args(command_args_with("build", values)) {
        Ok(args) => {
            testing::assert_eq(args.package_name, "alice::app");
            testing::assert_eq(args.inputs.len(), 2);
            testing::assert_eq(args.inputs.get(0), "extra.gom");
            testing::assert_eq(args.inputs.get(1), "main.gom");
            testing::assert_eq(args.interface_paths.len(), 1);
            testing::assert_eq(args.interface_paths.get(0), "lib.interface");
            testing::assert_eq(args.output, "artifact/package");
            match args.world {
                Some(value) => testing::assert_eq(value, "artifact/world.gaf"),
                None => testing::fail("expected compiler world"),
            }
        },
        Err(error) => testing::fail(error),
    }
}

#[test]
fn parses_toolchain_package_capabilities() -> unit {
    match parse_toolchain_build_args(
        Vec::from_array(
            [
                "gomlc",
                "__toolchain-build",
                "--builtin-contract",
                "--counter-output",
                "counter",
                "--package",
                "builtin",
                "--input",
                "contract.gom",
                "--output",
                "builtin",
            ],
        ),
    ) {
        Ok(value) => {
            testing::assert(value.builtin_contract);
            testing::assert_eq(value.command.package_name, "builtin")
        },
        Err(error) => testing::fail(error),
    };
    match parse_toolchain_build_args(
        Vec::from_array(
            [
                "gomlc",
                "__toolchain-build",
                "--package",
                "builtin",
                "--input",
                "contract.gom",
                "--output",
                "builtin",
            ],
        ),
    ) {
        Ok(_) => testing::fail("builtin package compiled without capability"),
        Err(error) => testing::assert_eq(
            error,
            "package builtin requires builtin contract capability",
        ),
    }
}

#[test]
fn parses_link_command_arguments() -> unit {
    let values = Vec::new();
    values.push("--input");
    values.push("lib.core");
    values.push("main.core");
    values.push("--output");
    values.push("artifact/main.go");
    values.push("--entry");
    values.push("alice::app");
    match parse_link_command_args(command_args_with("link", values)) {
        Ok(args) => {
            testing::assert_eq(args.inputs.len(), 2);
            testing::assert_eq(args.inputs.get(0), "lib.core");
            testing::assert_eq(args.inputs.get(1), "main.core");
            testing::assert_eq(args.entry, "alice::app");
            testing::assert_eq(args.output, "artifact/main.go")
        },
        Err(error) => testing::fail(error),
    }
}

