}

#[test]
fn renders_source_path_for_spanless_diagnostics() -> unit {
    let diagnostics = Vec::new();
    diagnostics.push(
        tast::Diagnostic {
            severity: tast::DiagnosticSeverity::Error,
            stage: "typer",
            message: "Unknown trait Missing",
            source_path: "helper.gom",
            span: Option::None,
            primary_label: Option::None,
            secondary_labels: Vec::new(),
            sort_order: 0,
        },
    );
    testing::assert_eq(
        render_typer_diagnostics(diagnostics, "helper.gom", ""),
        "error[typer]: Unknown trait Missing\nat: helper.gom",
    )
}
