    }
}

#[test]
fn collects_and_encodes_test_descriptors() -> unit {
    let source = "package sample; #[test] fn zebra() -> unit {} #[test] #[ignore(\"later: \\\"quoted\\\"\")] fn alpha() -> unit {}";
    let files = Vec::new();
    files.push(ast::lower(parser::parse(source)));
    let paths = Vec::new();
    paths.push("sample/sample_test.gom");
    let collected = collect_package_test_candidates(files, paths);
    testing::assert_eq(collected.diagnostics.len(), 0);
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "alice::sample::zebra",
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit },
            body: tast::Callable::Function("alice::sample::zebra"),
        },
    );
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "alice::sample::alpha",
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit },
            body: tast::Callable::Function("alice::sample::alpha"),
        },
    );
    let validated = validate_package_tests("alice::sample", collected.candidates, exports);
    testing::assert_eq(validated.diagnostics.len(), 0);
    let tests = validated.tests;
    testing::assert_eq(tests.len(), 2);
    testing::assert_eq(tests.get(0).id, "alice::sample::alpha");
    testing::assert(tests.get(0).ignored);
    match tests.get(0).ignore_reason {
        Some(reason) => testing::assert_eq(reason, "later: \"quoted\""),
        None => testing::fail("expected ignore reason"),
    };
    testing::assert_eq(tests.get(1).id, "alice::sample::zebra");
    testing::assert(!(tests.get(1).ignored));
    let manifest = encode_test_manifest(tests);
    testing::assert_eq(manifest.byte_slice(manifest.byte_len() - 1, manifest.byte_len()), "]");
    testing::assert(main_string_contains(manifest, "\"source_path\": \"sample/sample_test.gom\""));
    testing::assert(main_string_contains(manifest, "\"ignore_reason\": \"later: \\\"quoted\\\"\""))
}

#[test]
fn collects_parameterized_test_descriptors() -> unit {
    let source = "package sample; #[test_case(\"left\", true)] #[test_case(\"right\", false)] fn pair(value: string, expected: bool) -> unit {}";
    let files = Vec::new();
    files.push(ast::lower(parser::parse(source)));
    let paths = Vec::new();
    paths.push("sample/sample_test.gom");
    let collected = collect_package_test_candidates(files, paths);
    testing::assert_eq(collected.diagnostics.len(), 0);
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "alice::sample::pair",
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::String, tast::Type::Bool]),
                ret_ty: tast::Type::Unit,
            },
            body: tast::Callable::Function("alice::sample::pair"),
        },
    );
    let validated = validate_package_tests("alice::sample", collected.candidates, exports);
    testing::assert_eq(validated.diagnostics.len(), 0);
    testing::assert_eq(validated.tests.len(), 2);
    let mut found_left = false;
    let mut found_right = false;
    for test in validated.tests {
        testing::assert(test.id.starts_with("alice::sample::pair::case_"));
        testing::assert_eq(test.arguments.len(), 2);
        if test.display_name == "alice::sample::pair(\"left\", true)" {
            found_left = true;
            testing::assert_eq(test.arguments[0].0, "string");
            testing::assert_eq(test.arguments[0].1, "left");
            testing::assert_eq(test.arguments[1].0, "bool");
            testing::assert_eq(test.arguments[1].1, "true")
        } else if test.display_name == "alice::sample::pair(\"right\", false)" {
            found_right = true;
            testing::assert_eq(test.arguments[0].0, "string");
            testing::assert_eq(test.arguments[0].1, "right");
            testing::assert_eq(test.arguments[1].0, "bool");
            testing::assert_eq(test.arguments[1].1, "false")
        } else {
            testing::fail("unexpected parameterized test display name")
        }
    }
    testing::assert(found_left);
    testing::assert(found_right)
}

#[test]
fn parameterized_test_ids_ignore_source_location() -> unit {
    let arguments = Vec::from_array([("string", "same"), ("bool", "true")]);
    let first = TestCandidate {
        name: "case",
        source_path: "first.gom",
        start: 1,
        end: 2,
        label_end: 2,
        ignored: false,
        ignore_reason: Option::None,
        arguments,
    };
    let second = TestCandidate {
        name: "case",
        source_path: "second.gom",
        start: 100,
        end: 200,
        label_end: 200,
        ignored: false,
        ignore_reason: Option::None,
        arguments: Vec::from_array([("string", "same"), ("bool", "true")]),
    };
    testing::assert_eq(
        test_candidate_id("alice::sample", first),
        test_candidate_id("alice::sample", second),
    )
}

#[test]
fn validates_ignore_arguments_for_parameterized_tests() -> unit {
    let files = Vec::new();
    files.push(
        ast::lower(
            parser::parse("#[test_case(true)] #[ignore(false)] fn invalid(value: bool) -> unit {}"),
        ),
    );
    let paths = Vec::from_array(["invalid_test.gom"]);
    let collected = collect_package_test_candidates(files, paths);
    testing::assert_eq(collected.candidates.len(), 1);
    testing::assert_eq(collected.diagnostics.len(), 1);
    testing::assert_eq(
        collected.diagnostics[0].message,
        "`#[ignore]` accepts either no arguments or one string reason",
    )
}

#[test]
fn collects_all_invalid_test_signature_diagnostics() -> unit {
    let files = Vec::new();
    files.push(ast::lower(parser::parse("#[test] fn invalid[T](value: T) -> bool { true }")));
    let paths = Vec::new();
    paths.push("bad_test.gom");
    let collected = collect_package_test_candidates(files, paths);
    testing::assert_eq(collected.diagnostics.len(), 0);
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "alice::bad::invalid",
            type_params: Vec::from_array(["T"]),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Param { name: "T" }]),
                ret_ty: tast::Type::Bool,
            },
            body: tast::Callable::Function("alice::bad::invalid"),
        },
    );
    let validated = validate_package_tests("alice::bad", collected.candidates, exports);
    testing::assert_eq(validated.tests.len(), 0);
    testing::assert_eq(validated.diagnostics.len(), 3);
    testing::assert_eq(
        validated.diagnostics.get(0).message,
        "test function `invalid` must not have type parameters",
    );
    testing::assert_eq(
        validated.diagnostics.get(1).message,
        "test function `invalid` must not have parameters",
    );
    testing::assert_eq(
        validated.diagnostics.get(2).message,
        "test function `invalid` must return unit, found bool",
    );
    for diagnostic in validated.diagnostics {
        testing::assert_eq(diagnostic.stage, "typer");
        testing::assert_eq(diagnostic.source_path, "bad_test.gom");
        match diagnostic.span {
            Some(span) => {
                testing::assert_eq(span.start, 0);
                testing::assert_eq(span.end, 8)
            },
            None => testing::fail("expected test diagnostic span"),
        }
    }
}

#[test]
fn collects_all_invalid_test_attribute_diagnostics() -> unit {
    let source = "#[ignore] fn ignored_without_test() -> unit {} #[test()] fn test_with_arguments() -> unit {} #[test] #[test] fn duplicate_test() -> unit {} #[test] #[ignore(1)] fn invalid_ignore_reason() -> unit {} #[test] struct Value {} #[ignore] enum Choice { A }";
    let files = Vec::new();
    files.push(ast::lower(parser::parse(source)));
    let paths = Vec::new();
    paths.push("attribute_test.gom");
    let collected = collect_package_test_candidates(files, paths);
    testing::assert_eq(collected.candidates.len(), 2);
    testing::assert_eq(collected.diagnostics.len(), 6);
    let expected = Vec::new();
    expected.push("`#[ignore]` requires `#[test]`");
    expected.push("`#[test]` does not accept arguments");
    expected.push("duplicate `#[test]` attribute");
    expected.push("`#[ignore]` accepts either no arguments or one string reason");
    expected.push("test attributes can only be applied to top-level functions, not struct");
    expected.push("`#[ignore]` requires a top-level `#[test]` function");
    for index in range(0, collected.diagnostics.len()) {
        let diagnostic = collected.diagnostics.get(index);
        testing::assert_eq(diagnostic.stage, "attribute");
        testing::assert_eq(diagnostic.message, expected.get(index));
        testing::assert_eq(diagnostic.source_path, "attribute_test.gom");
        match diagnostic.span {
            Some(_) => (),
            None => testing::fail("expected attribute diagnostic span"),
        }
    }
}

#[test]
fn labels_duplicate_test_ids_across_files() -> unit {
    let parsed = Vec::new();
    parsed.push(parser::parse("package tests; #[test] fn duplicate() -> unit { () }"));
    parsed.push(parser::parse("package tests;\n#[test]\nfn duplicate() -> unit { () }"));
    let files = ast::lower_package(parsed);
    let paths = Vec::new();
    paths.push("first.gom");
    paths.push("second.gom");
    let collected = collect_package_test_candidates(files, paths);
    testing::assert_eq(collected.diagnostics.len(), 0);
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "example::tests::duplicate",
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit },
            body: tast::Callable::Function("example::tests::duplicate"),
        },
    );
    let validated = validate_package_tests("example::tests", collected.candidates, exports);
    testing::assert_eq(validated.tests.len(), 1);
    testing::assert_eq(validated.diagnostics.len(), 1);
    let diagnostic = validated.diagnostics.get(0);
    testing::assert_eq(diagnostic.message, "duplicate test id `example::tests::duplicate`");
    testing::assert_eq(diagnostic.source_path, "second.gom");
    match diagnostic.primary_label {
        Some(label) => testing::assert_eq(label, "duplicate test declared here"),
        None => testing::fail("expected primary test label"),
    };
    testing::assert_eq(diagnostic.secondary_labels.len(), 1);
    let secondary = diagnostic.secondary_labels.get(0);
    testing::assert_eq(secondary.source_path, "first.gom");
    testing::assert_eq(secondary.message, "first test declared here")
}

#[test]
fn adds_canonical_entry_wrapper() -> unit {
    let functions = Vec::new();
    functions.push(
        core::Function {
            name: "alice::app::main",
            origin: core::FunctionOrigin::Source,
            root: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: core::Type::Unit,
            body: core::Block {
                stmts: Vec::new(),
                tail: Option::Some(
                    core::Expr::Prim { value: core::Primitive::Unit, ty: core::Type::Unit },
                ),
            },
        },
    );
    let wrapped = add_entry_wrapper(
        core::File {
            functions,
            enums: Vec::new(),
            structs: Vec::new(),
            type_instances: Vec::new(),
            constants: Vec::new(),
            statics: Vec::new(),
        },
        "alice::app",
    );
    testing::assert_eq(wrapped.functions.len(), 2);
    testing::assert_eq(wrapped.functions.get(0).name, "alice::app::main");
    testing::assert_eq(wrapped.functions.get(1).name, "main");
    match wrapped.functions.get(1).body.tail {
        Some(Call { func: Var { name, ty: Func { params, ret_ty: Unit } }, args, ty: Unit }) => {
            testing::assert_eq(name, "alice::app::main");
            testing::assert_eq(params.len(), 0);
            testing::assert_eq(args.len(), 0)
        },
        _ => testing::fail("expected canonical entry call"),
    }
}

#[test]
fn rejects_invalid_run_single_arguments() -> unit {
    assert_parse_error(
        Vec::new(),
        "error: the following required arguments were not provided:\n  <FILE>\n\nUsage: gomlc run-single <FILE>\n\nFor more information, try '--help'.",
    );
    let unknown = Vec::new();
    unknown.push("--unknown");
    assert_parse_error(
        unknown,
        "error: unexpected argument '--unknown' found\n\n  tip: to pass '--unknown' as a value, use '-- --unknown'\n\nUsage: gomlc run-single [OPTIONS] <FILE>\n\nFor more information, try '--help'.",
    );
    let multiple = Vec::new();
    multiple.push("one.gom");
    multiple.push("two.gom");
    assert_parse_error(
        multiple,
        "error: unexpected argument 'two.gom' found\n\nUsage: gomlc run-single [OPTIONS] <FILE>\n\nFor more information, try '--help'.",
    )
}

#[test]
fn matches_cli_help_and_empty_value_semantics() -> unit {
    let dump = Vec::new();
    dump.push("--dump-go");
    assert_parse_error(
        dump,
        "error: the following required arguments were not provided:\n  <FILE>\n\nUsage: gomlc run-single --dump-go <FILE>\n\nFor more information, try '--help'.",
    );
    let version_help = Vec::new();
    version_help.push("--help");
    match parse_version_args(version_args_with(version_help)) {
        Err(error) => testing::assert(is_cli_help_signal(error)),
        Ok(_) => testing::fail("expected version help"),
    };
    let missing_format = Vec::new();
    missing_format.push("--format");
    missing_format.push("--help");
    match parse_version_args(version_args_with(missing_format)) {
        Err(error) => testing::assert_eq(
            error,
            "error: a value is required for '--format <FORMAT>' but none was supplied\n  [possible values: text, json]\n\nFor more information, try '--help'.",
        ),
        Ok(_) => testing::fail("expected missing version format"),
    };
    let empty_package = Vec::new();
    empty_package.push("--package=");
    match parse_package_command_args(command_args_with("check", empty_package)) {
        Err(error) => testing::assert_eq(
            error,
            "error: the following required arguments were not provided:\n  --input <INPUT>...\n  --output <OUTPUT>\n\nUsage: gomlc check --package <PACKAGE> --input <INPUT>... --output <OUTPUT>\n\nFor more information, try '--help'.",
        ),
        Ok(_) => testing::fail("expected missing package arguments"),
    };
    let empty_interface = Vec::new();
    empty_interface.push("--interface-path=");
    match parse_package_command_args(command_args_with("check", empty_interface)) {
        Err(error) => testing::assert_eq(
            error,
            "error: a value is required for '--interface-path <INTERFACE_FILE>' but none was supplied\n\nFor more information, try '--help'.",
        ),
        Ok(_) => testing::fail("expected missing interface path"),
    };
    let short_help = Vec::new();
    short_help.push("-help");
    match parse_run_args(args_with(short_help)) {
        Err(error) => testing::assert(is_cli_help_signal(error)),
        Ok(_) => testing::fail("expected run help"),
    };
    let delimiter = Vec::new();
    delimiter.push("--");
    match parse_version_args(version_args_with(delimiter)) {
        Ok(Text) => (),
        _ => testing::fail("expected version delimiter"),
    };
    let unknown_format = Vec::new();
    unknown_format.push("--format");
    unknown_format.push("--wat");
    match parse_version_args(version_args_with(unknown_format)) {
        Err(error) => testing::assert_eq(
            error,
            "error: unexpected argument '--wat' found\n\nUsage: gomlc version [OPTIONS]\n\nFor more information, try '--help'.",
        ),
        Ok(_) => testing::fail("expected unknown version argument"),
    };
    testing::assert_eq(cli_argument_name("--packagex=value"), "--packagex");
    match similar_cli_argument("check", "--outpu") {
        Some(argument) => testing::assert_eq(argument, "--output"),
        None => testing::fail("expected similar output argument"),
    }
}

#[test]
fn rejects_project_imports_in_single_file_mode() -> unit {
    let source = "use std::io; use packages_basic::Lib; fn main() -> unit {}";
    match single_file_project_import(ast::lower(parser::parse(source))) {
        Some(value) => testing::assert_eq(value, "packages_basic::Lib"),
        None => testing::fail("expected project import"),
    };
    match single_file_project_import(
        ast::lower(parser::parse("use std::fs; use std::io; fn main() -> unit {}")),
    ) {
        Some(_) => testing::fail("expected standard imports to be accepted"),
        None => (),
    }
}

#[test]
fn rejects_private_types_exposed_by_public_trait_impls() -> unit {
    let source = "package api; pub trait Source { type Item; fn get(self: Self) -> Self::Item; } pub struct Public {} struct Hidden {} impl Source for Public { type Item = Hidden; fn get(self: Public) -> Hidden { Hidden {} } }";
    let ast_values = Vec::new();
    ast_values.push(ast::lower(parser::parse(source)));
    let public_names = public_item_names(ast_values, "visibility_impl_audit::api");
    let lowered = hir::lower_package(
        ast::lower(parser::parse(source)),
        "api/api.gom",
        "visibility_impl_audit::api",
    );
    let file = match lowered.hir {
        Some(value) => value,
        None => {
            testing::fail("expected public impl HIR");
            hir::File {
                package_name: "visibility_impl_audit::api",
                path: "api/api.gom",
                source_path: "api/api.gom",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    };
    match validate_public_trait_impls(file, "visibility_impl_audit::api", public_names) {
        Err(error) => testing::assert_eq(
            error,
            "Public trait implementation visibility_impl_audit::api::Source exposes private type visibility_impl_audit::api::Hidden",
        ),
        Ok(()) => testing::fail("expected private type exposure error"),
    }
}

#[test]
fn filters_private_types_traits_and_trait_impls() -> unit {
    let source = "package api; enum HiddenEnum { A } struct HiddenStruct {} trait HiddenTrait { fn hidden(self: Self) -> int32; } pub struct Item {} impl HiddenTrait for Item { fn hidden(self: Item) -> int32 { 1 } } pub fn item() -> Item { Item {} }";
    let ast_values = Vec::new();
    ast_values.push(ast::lower(parser::parse(source)));
    let public_names = public_item_names(ast_values, "visibility_audit::api");
    let lowered = hir::lower_package(
        ast::lower(parser::parse(source)),
        "api/api.gom",
        "visibility_audit::api",
    );
    let file = match lowered.hir {
        Some(value) => value,
        None => {
            testing::fail("expected private item HIR");
            hir::File {
                package_name: "visibility_audit::api",
                path: "api/api.gom",
                source_path: "api/api.gom",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    };
    let Ok(signatures) = tast::package_signatures(file) else {
        testing::fail("expected package signatures");
        return
    };
    let checked = tast::check_package_files_for_link_with_dependencies(
        Vec::from_array([file]),
        Vec::new(),
    );
    let tast_file = match checked.tast {
        Some(value) => value,
        None => {
            testing::fail("expected checked package");
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    };
    let exports = required_artifact_package_exports(
        tast_file,
        signatures,
        "visibility_audit::api",
        public_names,
        Vec::new(),
        true,
        Vec::new(),
        Vec::new(),
    );
    testing::assert_eq(exports.enums.len(), 0);
    testing::assert_eq(exports.structs.len(), 1);
    testing::assert_eq(exports.structs.get(0).name, "visibility_audit::api::Item");
    testing::assert_eq(exports.traits.len(), 0);
    testing::assert_eq(exports.trait_impls.len(), 0);
    testing::assert_eq(exports.functions.len(), 1);
    testing::assert_eq(exports.functions.get(0).name, "visibility_audit::api::item")
}

#[test]
fn orders_link_inputs_by_dependencies_and_name() -> unit {
    let nodes = Vec::new();
    nodes.push(PackageOrderNode { name: "z", dependencies: Vec::new(), position: 0 });
    nodes.push(PackageOrderNode { name: "c", dependencies: Vec::from_array(["a"]), position: 1 });
    nodes.push(PackageOrderNode { name: "a", dependencies: Vec::new(), position: 2 });
    nodes.push(PackageOrderNode { name: "b", dependencies: Vec::from_array(["a"]), position: 3 });
    match order_package_nodes(nodes) {
        Ok(order) => {
            testing::assert_eq(order.len(), 4);
            testing::assert_eq(order.get(0), 2);
            testing::assert_eq(order.get(1), 3);
            testing::assert_eq(order.get(2), 1);
            testing::assert_eq(order.get(3), 0)
        },
        Err(error) => testing::fail(error),
    }
}

fn sample_artifact_json(pretty: bool) -> string {
    let writer = wire::new_artifact_json_writer(pretty);
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "text");
    wire::artifact_json_string(writer, "quote \" slash \\ line\n tab\t zero\u0000 é");
    wire::artifact_json_name(writer, "values");
    wire::artifact_json_begin_array(writer);
    wire::artifact_json_number(writer, "12");
    wire::artifact_json_bool(writer, true);
    wire::artifact_json_null(writer);
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_finish(writer)
}

#[test]
fn writes_compact_artifact_json() -> unit {
    testing::assert_eq(
        sample_artifact_json(false),
        "{\"text\":\"quote \\\" slash \\\\ line\\n tab\\t zero\\u0000 é\",\"values\":[12,true,null]}",
    )
}

#[test]
fn writes_pretty_artifact_json() -> unit {
    testing::assert_eq(
        sample_artifact_json(true),
        "{\n  \"text\": \"quote \\\" slash \\\\ line\\n tab\\t zero\\u0000 é\",\n  \"values\": [\n    12,\n    true,\n    null\n  ]\n}",
    )
}

#[test]
fn writes_artifact_type_shapes() -> unit {
    let context = tast_codec::artifact_type_context(
        Vec::from_array(["Option"]),
        Vec::from_array(["Box"]),
    );
    let option = tast::Type::App {
        ty: tast::Type::Con { name: "Option" },
        args: Vec::from_array([tast::Type::Int32]),
    };
    let projection = tast::Type::Projection {
        for_ty: tast::Type::Param { name: "I" },
        name: "Item",
        trait_ref: Option::Some(tast::TraitRef { name: "Iterator", args: Vec::new() }),
    };
    let value = tast::Type::Func { params: Vec::from_array([option]), ret_ty: projection };
    let writer = wire::new_artifact_json_writer(false);
    tast_codec::artifact_json_type(writer, context, value);
    testing::assert_eq(
        wire::artifact_json_finish(writer),
        "{\"TFunc\":{\"params\":[{\"TApp\":{\"ty\":{\"TEnum\":{\"name\":\"Option\"}},\"args\":[\"TInt32\"]}}],\"ret_ty\":{\"TProjection\":{\"trait_ref\":{\"name\":\"Iterator\",\"args\":[]},\"for_ty\":{\"TParam\":{\"name\":\"I\"}},\"name\":\"Item\"}}}}",
    );
    let writer = wire::new_artifact_json_writer(false);
    tast_codec::artifact_json_type_predicate(
        writer,
        context,
        tast::TypePredicate::Equality {
            lhs: tast::Type::Con { name: "Box" },
            rhs: tast::Type::Int32,
        },
    );
    testing::assert_eq(
        wire::artifact_json_finish(writer),
        "{\"Equality\":{\"lhs\":{\"TStruct\":{\"name\":\"Box\"}},\"rhs\":\"TInt32\"}}",
    )
}

#[test]
fn writes_core_file_shape() -> unit {
    let value = core::File {
        functions: Vec::from_array(
            [
                core::Function {
                    name: "audit::answer",
                    origin: core::FunctionOrigin::Source,
                    root: true,
                    generics: Vec::new(),
                    predicates: Vec::new(),
                    trait_impl: Option::None,
                    params: Vec::new(),
                    ret_ty: core::Type::Int32,
                    body: core::Block {
                        stmts: Vec::new(),
                        tail: Option::Some(
                            core::Expr::Prim {
                                value: core::Primitive::Int32 { value: "41" },
                                ty: core::Type::Int32,
                            },
                        ),
                    },
                },
            ],
        ),
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
        constants: Vec::new(),
        statics: Vec::new(),
    };
    let writer = wire::new_artifact_json_writer(false);
    core_codec::write_core_file(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    );
    testing::assert_eq(
        wire::artifact_json_finish(writer),
        "{\"toplevels\":[{\"name\":\"audit::answer\",\"origin\":{\"Source\":null},\"root\":true,\"generics\":[],\"predicates\":[],\"trait_impl\":null,\"params\":[],\"ret_ty\":\"TInt32\",\"body\":{\"stmts\":[],\"tail\":{\"EPrim\":{\"value\":{\"Int32\":{\"value\":41}},\"ty\":\"TInt32\"}}}}],\"constants\":[],\"statics\":[]}",
    )
}

#[test]
fn writes_callable_body_shapes() -> unit {
    let writer = wire::new_artifact_json_writer(false);
    wire::artifact_json_begin_array(writer);
    let intrinsic = tast_codec::artifact_callable(tast::Callable::Intrinsic("ref.new"));
    wire::artifact_json_string(writer, intrinsic.name);
    tast_codec::artifact_json_callable_body(writer, intrinsic);
    let runtime = tast_codec::artifact_callable(tast::Callable::Runtime("core.char_from_uint32"));
    wire::artifact_json_string(writer, runtime.name);
    tast_codec::artifact_json_callable_body(writer, runtime);
    let host = tast_codec::artifact_callable(tast::Callable::Runtime("std.path.file_name"));
    wire::artifact_json_string(writer, host.name);
    tast_codec::artifact_json_callable_body(writer, host);
    let go_foreign = tast_codec::artifact_callable(
        tast::Callable::GoForeign { import_path: "strings", symbol: "ToUpper" },
    );
    wire::artifact_json_string(writer, go_foreign.name);
    tast_codec::artifact_json_callable_body(writer, go_foreign);
    wire::artifact_json_end_array(writer);
    testing::assert_eq(
        wire::artifact_json_finish(writer),
        "[\"ref\",{\"kind\":\"intrinsic\",\"id\":\"ref_new\"},\"char_from_uint32_raw\",{\"kind\":\"runtime\",\"id\":\"char_from_uint32\"},\"std::internal::host::path_file_name\",{\"kind\":\"runtime\",\"id\":\"std_path_file_name\"},\"ToUpper\",{\"kind\":\"go\",\"import_path\":\"strings\",\"symbol\":\"ToUpper\"}]",
    )
}

#[test]
fn writes_interface_unit_shape_and_hash() -> unit {
    let exports = interface_codec::empty_exports();
    exports.functions.push(
        artifact::ArtifactFnScheme {
            comptime: tast::ComptimeCapability::RuntimeOnly,
            name: "audit::value::value",
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Int32 },
            body: tast::Callable::Function("audit::value::value"),
        },
    );
    let artifact_unit = interface_codec::new_unit(
        "audit::value",
        exports,
        artifact::ArtifactPackageInterface {
            package_name: "audit::value",
            name: "value",
            value_exports: Vec::from_array([("audit::value::value", 0)]),
            enum_variants: Vec::new(),
        },
        Vec::from_array(
            [("builtin", "03e930c72ad34b9d78ee4c6c55838bbd390ab7c11161e6edd7c6f616725f7cc8")],
        ),
    );
    testing::assert_eq(
        artifact_unit.interface_hash,
        "edc8cc79dca9596e96570429449cde357a6d659e0fa3f6eea34b337b79a7cfdd",
    );
    let encoded = interface_codec::encode_json(artifact_unit, false);
    testing::assert_eq(
        encoded,
        "{\"format_version\":23,\"compiler_abi\":5,\"package\":\"audit::value\",\"exports\":{\"reexports\":{},\"type_env\":{\"enums\":{},\"structs\":{},\"aliases\":{}}"
            + ",\"trait_env\":{\"trait_defs\":{},\"trait_impls\":[],\"inherent_impls\":[]},\"value_env\":{\"funcs\":{\"audit::value::value\":{\"comptime\":false,\"type_params\":[],\"constraints\":[],\"ty\":{\"TFunc\":{\"params\":[],\"ret_ty\":\"TInt32\"}},\"body\":{\"kind\":\"goml\",\"id\":\"audit::value::value\"}}},\"consts\":{}}},\"interface\":{\"package\":\"audit::value\",\"name\":\"value\",\"value_exports\":{\"audit::value::value\":0},\"enum_variants\":{}},\"comptime\":null,\"deps\":{\"builtin\":\"03e930c72ad34b9d78ee4c6c55838bbd390ab7c11161e6edd7c6f616725f7cc8\"},\"interface_hash\":\"edc8cc79dca9596e96570429449cde357a6d659e0fa3f6eea34b337b79a7cfdd\"}",
    );
    let binary = match interface_codec::encode_binary(artifact_unit) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    match interface_codec::decode_binary(binary) {
        Ok(value) => testing::assert_eq(interface_codec::encode_json(value, false), encoded),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn extracts_interface_unit_from_checked_package() -> unit {
    let source = "package value; fn private_value() -> int32 { 41 } pub fn value() -> int32 { private_value() + 1 }";
    let lowered_ast = ast::lower(parser::parse(source));
    let ast_values = Vec::new();
    ast_values.push(lowered_ast);
    let public_names = public_item_names(ast_values, "audit::value");
    let lowered = hir::lower_package(lowered_ast, "value/value.gom", "audit::value");
    let hir_file = match lowered.hir {
        Some(value) => value,
        None => {
            testing::fail("expected package HIR");
            hir::File {
                package_name: "audit::value",
                path: "value/value.gom",
                source_path: "value/value.gom",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    };
    let Ok(signatures) = tast::package_signatures(hir_file) else {
        testing::fail("expected package signatures");
        return
    };
    let checked = tast::check_package_files_for_link_with_dependencies(
        Vec::from_array([hir_file]),
        Vec::new(),
    );
    let tast_file = match checked.tast {
        Some(value) => value,
        None => {
