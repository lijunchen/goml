package main;

use gomlc::tast;
use std::bytes;

struct ArtifactInterfaceBinaryReader {
    reader: ArtifactBinaryReader,
    table: ArtifactBinaryStringTable,
}

fn new_artifact_interface_binary_reader(
    data: bytes::Bytes,
    table: ArtifactBinaryStringTable,
) -> ArtifactInterfaceBinaryReader {
    ArtifactInterfaceBinaryReader {
        reader: new_artifact_binary_reader(data),
        table,
    }
}

fn artifact_interface_binary_error(expected: string) -> string {
    artifact_decode_error(expected)
}

fn artifact_interface_binary_read_tag(
    reader: ArtifactInterfaceBinaryReader,
) -> Result[uint8, string] {
    artifact_binary_read_u8(reader.reader)
}

fn artifact_interface_binary_expect_tag(
    reader: ArtifactInterfaceBinaryReader,
    expected_tag: uint8,
    expected: string,
) -> Result[unit, string] {
    match artifact_interface_binary_read_tag(reader) {
        Ok(value) => if value == expected_tag {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error(expected))
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_read_count(
    reader: ArtifactInterfaceBinaryReader,
    tag: uint8,
    expected: string,
) -> Result[int, string] {
    match artifact_interface_binary_expect_tag(reader, tag, expected) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let count = match artifact_binary_read_u32(reader.reader) {
        Ok(value) => value as int,
        Err(error) => return Result::Err(error),
    };
    if count > 10000000 {
        Result::Err(artifact_interface_binary_error(expected))
    } else {
        Result::Ok(count)
    }
}

fn artifact_interface_binary_object(
    reader: ArtifactInterfaceBinaryReader,
    expected_count: int,
    expected: string,
) -> Result[unit, string] {
    match artifact_interface_binary_read_count(reader, 6, expected) {
        Ok(value) => if value == expected_count {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error(expected))
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_array(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[int, string] {
    artifact_interface_binary_read_count(reader, 5, expected)
}

fn artifact_interface_binary_field(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[unit, string] {
    match artifact_binary_decode_string_id(reader.reader, reader.table) {
        Ok(value) => if value == expected {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error("field " + expected))
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_string(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[string, string] {
    match artifact_interface_binary_expect_tag(reader, 4, expected) {
        Ok(()) => artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_number(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[string, string] {
    match artifact_interface_binary_expect_tag(reader, 3, expected) {
        Ok(()) => artifact_binary_read_string(reader.reader),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_bool(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[bool, string] {
    match artifact_interface_binary_read_tag(reader) {
        Ok(1) => Result::Ok(false),
        Ok(2) => Result::Ok(true),
        Ok(_) => Result::Err(artifact_interface_binary_error(expected)),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_named_string(
    reader: ArtifactInterfaceBinaryReader,
    field: string,
    expected: string,
) -> Result[string, string] {
    match artifact_interface_binary_object(reader, 1, expected) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, field) {
        Ok(()) => artifact_interface_binary_string(reader, expected),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_string_array(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[Vec[string], string] {
    let count = match artifact_interface_binary_array(reader, expected) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        match artifact_interface_binary_string(reader, expected) {
            Ok(value) => result.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_type_array(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    expected: string,
) -> Result[Vec[tast::Type], string] {
    let count = match artifact_interface_binary_array(reader, expected) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        match artifact_interface_binary_type(reader, context) {
            Ok(value) => result.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_trait_ref(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[tast::TraitRef, string] {
    match artifact_interface_binary_object(reader, 2, "trait reference") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "name") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_interface_binary_string(reader, "trait name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "args") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let args = match artifact_interface_binary_type_array(
        reader,
        context,
        "trait arguments",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    Result::Ok(tast::TraitRef { name, args })
}

fn artifact_interface_binary_optional_trait_ref(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[Option[tast::TraitRef], string] {
    let offset = reader.reader.offset.get();
    let tag = match artifact_interface_binary_read_tag(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if tag == 0 {
        Result::Ok(Option::None)
    } else {
        reader.reader.offset.set(offset);
        match artifact_interface_binary_trait_ref(reader, context) {
            Ok(value) => Result::Ok(Option::Some(value)),
            Err(error) => Result::Err(error),
        }
    }
}

fn artifact_interface_binary_element_type(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    expected: string,
) -> Result[tast::Type, string] {
    match artifact_interface_binary_object(reader, 1, expected) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "elem") {
        Ok(()) => artifact_interface_binary_type(reader, context),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_simple_type(
    name: string,
) -> Result[tast::Type, string] {
    match name {
        "TUnit" => Result::Ok(tast::Type::Unit),
        "TNever" => Result::Ok(tast::Type::Never),
        "TBool" => Result::Ok(tast::Type::Bool),
        "TInt" => Result::Ok(tast::Type::Int),
        "TInt8" => Result::Ok(tast::Type::Int8),
        "TInt16" => Result::Ok(tast::Type::Int16),
        "TInt32" => Result::Ok(tast::Type::Int32),
        "TInt64" => Result::Ok(tast::Type::Int64),
        "TUint" => Result::Ok(tast::Type::Uint),
        "TUint8" => Result::Ok(tast::Type::Uint8),
        "TUint16" => Result::Ok(tast::Type::Uint16),
        "TUint32" => Result::Ok(tast::Type::Uint32),
        "TUint64" => Result::Ok(tast::Type::Uint64),
        "TFloat32" => Result::Ok(tast::Type::Float32),
        "TFloat64" => Result::Ok(tast::Type::Float64),
        "TString" => Result::Ok(tast::Type::String),
        "TChar" => Result::Ok(tast::Type::Char),
        _ => Result::Err(artifact_interface_binary_error("type")),
    }
}

fn artifact_interface_binary_type(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[tast::Type, string] {
    let tag = match artifact_interface_binary_read_tag(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if tag == 4 {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        return artifact_interface_binary_simple_type(name)
    } else if tag != 6 {
        return Result::Err(artifact_interface_binary_error("type"))
    } else {
        ()
    };
    let count = match artifact_binary_read_u32(reader.reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if count != 1 {
        return Result::Err(artifact_interface_binary_error("type variant"))
    } else {
        ()
    };
    let kind = match artifact_binary_decode_string_id(reader.reader, reader.table) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if kind == "TEnum" || kind == "TStruct" {
        let name = match artifact_interface_binary_named_string(
            reader,
            "name",
            "named type",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if kind == "TEnum" {
            artifact_add_type_name(context.enum_names, name)
        } else {
            artifact_add_type_name(context.struct_names, name)
        };
        Result::Ok(tast::Type::Con { name })
    } else if kind == "TDyn" {
        match artifact_interface_binary_named_string(
            reader,
            "trait_name",
            "dynamic type",
        ) {
            Ok(value) => Result::Ok(tast::Type::Dyn {
                trait_name: value,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TParam" {
        match artifact_interface_binary_named_string(
            reader,
            "name",
            "type parameter",
        ) {
            Ok(value) => Result::Ok(tast::Type::Param { name: value }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TTuple" {
        match artifact_interface_binary_object(reader, 1, "tuple type") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "typs") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type_array(
            reader,
            context,
            "tuple elements",
        ) {
            Ok(value) => Result::Ok(tast::Type::Tuple { items: value }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TProjection" {
        match artifact_interface_binary_object(reader, 3, "projection type") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "trait_ref") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let trait_ref = match artifact_interface_binary_optional_trait_ref(
            reader,
            context,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "for_ty") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let for_ty = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "name") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_string(reader, "projection name") {
            Ok(name) => Result::Ok(tast::Type::Projection {
                for_ty,
                name,
                trait_ref,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TApp" {
        match artifact_interface_binary_object(reader, 2, "type application") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "ty") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let ty = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "args") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type_array(
            reader,
            context,
            "type arguments",
        ) {
            Ok(args) => Result::Ok(tast::Type::App { ty, args }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TArray" {
        match artifact_interface_binary_object(reader, 2, "array type") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "len") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let number = match artifact_interface_binary_number(reader, "array length") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let len = if number == "18446744073709551615" {
            -1
        } else {
            match artifact_parse_nonnegative_int(number) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            }
        };
        match artifact_interface_binary_field(reader, "elem") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type(reader, context) {
            Ok(elem) => Result::Ok(tast::Type::Array { len, elem }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TSlice"
        || kind == "TVec"
        || kind == "TRef"
        || kind == "TChannel"
    {
        let elem = match artifact_interface_binary_element_type(
            reader,
            context,
            "element type",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if kind == "TSlice" {
            Result::Ok(tast::Type::Slice { elem })
        } else if kind == "TVec" {
            Result::Ok(tast::Type::VecType { elem })
        } else if kind == "TRef" {
            Result::Ok(tast::Type::RefType { elem })
        } else {
            Result::Ok(tast::Type::Channel { elem })
        }
    } else if kind == "THashMap" {
        match artifact_interface_binary_object(reader, 2, "hash map type") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "key") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let key = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "value") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type(reader, context) {
            Ok(value) => Result::Ok(tast::Type::HashMap { key, value }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "TFunc" {
        match artifact_interface_binary_object(reader, 2, "function type") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "params") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let params = match artifact_interface_binary_type_array(
            reader,
            context,
            "function parameters",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "ret_ty") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type(reader, context) {
            Ok(ret_ty) => Result::Ok(tast::Type::Func {
                params,
                ret_ty,
            }),
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_interface_binary_error("supported type variant"))
    }
}

fn artifact_interface_binary_trait_refs(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[Vec[tast::TraitRef], string] {
    let count = match artifact_interface_binary_array(
        reader,
        "trait references",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        match artifact_interface_binary_trait_ref(reader, context) {
            Ok(value) => result.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_predicate(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[tast::TypePredicate, string] {
    match artifact_interface_binary_object(reader, 1, "type predicate") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let kind = match artifact_binary_decode_string_id(reader.reader, reader.table) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_object(reader, 2, "type predicate payload") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    if kind == "Trait" {
        match artifact_interface_binary_field(reader, "for_ty") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let for_ty = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "trait_ref") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_trait_ref(reader, context) {
            Ok(trait_ref) => Result::Ok(tast::TypePredicate::Trait {
                for_ty,
                trait_ref,
            }),
            Err(error) => Result::Err(error),
        }
    } else if kind == "Equality" {
        match artifact_interface_binary_field(reader, "lhs") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let lhs = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "rhs") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type(reader, context) {
            Ok(rhs) => Result::Ok(tast::TypePredicate::Equality {
                lhs,
                rhs,
            }),
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_interface_binary_error(
            "supported type predicate",
        ))
    }
}

fn artifact_interface_binary_predicates(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[Vec[tast::TypePredicate], string] {
    let count = match artifact_interface_binary_array(
        reader,
        "type predicates",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        match artifact_interface_binary_predicate(reader, context) {
            Ok(value) => result.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_type_pairs(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    expected: string,
) -> Result[Vec[(string, tast::Type)], string] {
    let count = match artifact_interface_binary_array(reader, expected) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        let pair_count = match artifact_interface_binary_array(reader, expected) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if pair_count != 2 {
            return Result::Err(artifact_interface_binary_error(expected))
        } else {
            ()
        };
        let name = match artifact_interface_binary_string(reader, expected) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type(reader, context) {
            Ok(value) => result.push((name, value)),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_enum_fields(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[tast::EnumVariantFields, string] {
    let offset = reader.reader.offset.get();
    let tag = match artifact_interface_binary_read_tag(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if tag == 4 {
        let value = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if value == "Unit" {
            Result::Ok(tast::EnumVariantFields::Unit)
        } else {
            Result::Err(artifact_interface_binary_error(
                "enum variant fields",
            ))
        }
    } else {
        reader.reader.offset.set(offset);
        match artifact_interface_binary_object(
            reader,
            1,
            "enum variant fields",
        ) {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let kind = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if kind == "Tuple" {
            match artifact_interface_binary_type_array(
                reader,
                context,
                "enum tuple fields",
            ) {
                Ok(value) => {
                    Result::Ok(tast::EnumVariantFields::Tuple(value))
                },
                Err(error) => Result::Err(error),
            }
        } else if kind == "Struct" {
            match artifact_interface_binary_type_pairs(
                reader,
                context,
                "enum struct fields",
            ) {
                Ok(value) => {
                    Result::Ok(tast::EnumVariantFields::Struct(value))
                },
                Err(error) => Result::Err(error),
            }
        } else {
            Result::Err(artifact_interface_binary_error(
                "enum variant fields",
            ))
        }
    }
}

fn artifact_interface_binary_enum_def(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    map_name: string,
) -> Result[tast::EnumDef, string] {
    match artifact_interface_binary_object(reader, 3, "enum definition") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "name") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_interface_binary_string(reader, "enum name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if name != map_name {
        return Result::Err(artifact_interface_binary_error(
            "matching enum name",
        ))
    } else {
        artifact_add_type_name(context.enum_names, name)
    };
    match artifact_interface_binary_field(reader, "generics") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let generics = match artifact_interface_binary_string_array(
        reader,
        "enum generics",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "variants") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let count = match artifact_interface_binary_array(reader, "enum variants") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let variants = Vec::with_capacity(count);
    for _ in range(0, count) {
        match artifact_interface_binary_object(reader, 2, "enum variant") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "name") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let variant_name = match artifact_interface_binary_string(
            reader,
            "enum variant name",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "fields") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let fields = match artifact_interface_binary_enum_fields(
            reader,
            context,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        variants.push(tast::EnumVariantDef {
            name: variant_name,
            fields,
        })
    };
    Result::Ok(tast::EnumDef {
        name,
        generics,
        variants,
    })
}

fn artifact_interface_binary_struct_def(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    map_name: string,
) -> Result[tast::StructDef, string] {
    match artifact_interface_binary_object(reader, 4, "struct definition") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "name") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_interface_binary_string(reader, "struct name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if name != map_name {
        return Result::Err(artifact_interface_binary_error(
            "matching struct name",
        ))
    } else {
        artifact_add_type_name(context.struct_names, name)
    };
    match artifact_interface_binary_field(reader, "generics") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let generics = match artifact_interface_binary_string_array(
        reader,
        "struct generics",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "fields") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let fields = match artifact_interface_binary_type_pairs(
        reader,
        context,
        "struct fields",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let public_fields = Vec::with_capacity(fields.len());
    for field in fields {
        public_fields.push(field.0)
    };
    match artifact_interface_binary_field(reader, "has_hidden_fields") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let has_hidden_fields = match artifact_interface_binary_bool(
        reader,
        "struct hidden fields flag",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    Result::Ok(tast::StructDef {
        name,
        generics,
        fields,
        public_fields,
        has_hidden_fields,
    })
}

fn artifact_interface_binary_type_alias(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    name: string,
) -> Result[tast::TypeAliasInfo, string] {
    match artifact_interface_binary_object(reader, 2, "type alias") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "generics") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let generics = match artifact_interface_binary_string_array(
        reader,
        "type alias generics",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "ty") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_type(reader, context) {
        Ok(ty) => Result::Ok(tast::TypeAliasInfo {
            name,
            generics,
            ty,
        }),
        Err(error) => Result::Err(error),
    }
}

fn artifact_interface_binary_callable(
    reader: ArtifactInterfaceBinaryReader,
    name: string,
) -> Result[tast::Callable, string] {
    let count = match artifact_interface_binary_read_count(
        reader,
        6,
        "callable body",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "kind") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let kind = match artifact_interface_binary_string(reader, "callable kind") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if kind == "goml" {
        if count == 1 {
            Result::Ok(tast::Callable::Function(name))
        } else {
            Result::Err(artifact_interface_binary_error("callable body"))
        }
    } else if count != 2 {
        Result::Err(artifact_interface_binary_error("callable body"))
    } else {
        match artifact_interface_binary_field(reader, "id") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let id = match artifact_interface_binary_string(reader, "callable id") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if kind == "intrinsic" {
        match artifact_intrinsic_key_from_id(id) {
            Some(value) => Result::Ok(tast::Callable::Intrinsic(value)),
            None => Result::Err(artifact_interface_binary_error(
                "intrinsic id",
            )),
        }
        } else if kind == "runtime" {
            match artifact_runtime_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Runtime(value)),
                None => Result::Err(artifact_interface_binary_error(
                    "runtime hook id",
                )),
            }
        } else {
            Result::Err(artifact_interface_binary_error("callable kind"))
        }
    }
}

fn artifact_interface_binary_fn_scheme(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
    name: string,
) -> Result[ArtifactFnScheme, string] {
    match artifact_interface_binary_object(reader, 4, "function scheme") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "type_params") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let type_params = match artifact_interface_binary_string_array(
        reader,
        "type parameters",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "constraints") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let constraints = match artifact_interface_binary_predicates(
        reader,
        context,
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "ty") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let ty = match artifact_interface_binary_type(reader, context) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "body") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let body = match artifact_interface_binary_callable(reader, name) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    Result::Ok(ArtifactFnScheme {
        name,
        type_params,
        constraints,
        ty,
        body,
    })
}

fn artifact_interface_binary_fn_map(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[Vec[ArtifactFnScheme], string] {
    let count = match artifact_interface_binary_read_count(
        reader,
        6,
        "function map",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_fn_scheme(reader, context, name) {
            Ok(value) => result.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_associated_type_defs(
