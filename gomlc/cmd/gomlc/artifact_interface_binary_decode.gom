fn artifact_interface_binary_trait_impls(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[Vec[ArtifactTraitImpl], string] {
    let count = match artifact_interface_binary_array(
        reader,
        "trait implementations",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        let pair_count = match artifact_interface_binary_array(
            reader,
            "trait implementation",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if pair_count != 2 {
            return Result::Err(artifact_interface_binary_error(
                "trait implementation pair",
            ))
        } else {
            ()
        };
        match artifact_interface_binary_object(
            reader,
            2,
            "trait implementation key",
        ) {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "trait_ref") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let trait_ref = match artifact_interface_binary_trait_ref(
            reader,
            context,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "for_ty") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let for_ty = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let definition = match artifact_interface_binary_impl_def(
            reader,
            context,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push(ArtifactTraitImpl {
            trait_ref,
            for_ty,
            definition,
        })
    };
    Result::Ok(result)
}

fn artifact_interface_binary_inherent_key(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[ArtifactInherentImplKey, string] {
    match artifact_interface_binary_object(
        reader,
        1,
        "inherent implementation key",
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let kind = match artifact_binary_decode_string_id(reader.reader, reader.table) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if kind == "Exact" {
        match artifact_interface_binary_type(reader, context) {
            Ok(value) => {
                Result::Ok(ArtifactInherentImplKey::Exact(value))
            },
            Err(error) => Result::Err(error),
        }
    } else if kind == "Constr" {
        match artifact_interface_binary_string(
            reader,
            "inherent constructor",
        ) {
            Ok(value) => {
                Result::Ok(ArtifactInherentImplKey::Constr(value))
            },
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_interface_binary_error(
            "inherent implementation key",
        ))
    }
}

fn artifact_interface_binary_inherent_impls(
    reader: ArtifactInterfaceBinaryReader,
    context: ArtifactDecodeContext,
) -> Result[Vec[ArtifactInherentImpl], string] {
    let count = match artifact_interface_binary_array(
        reader,
        "inherent implementations",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        let pair_count = match artifact_interface_binary_array(
            reader,
            "inherent implementation",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if pair_count != 2 {
            return Result::Err(artifact_interface_binary_error(
                "inherent implementation pair",
            ))
        } else {
            ()
        };
        let key = match artifact_interface_binary_inherent_key(
            reader,
            context,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let definition = match artifact_interface_binary_impl_def(
            reader,
            context,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push(ArtifactInherentImpl { key, definition })
    };
    Result::Ok(result)
}

fn artifact_interface_binary_package_exports(
    reader: ArtifactInterfaceBinaryReader,
) -> Result[ArtifactPackageExports, string] {
    let context = new_artifact_decode_context();
    match artifact_interface_binary_object(reader, 3, "package exports") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "type_env") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_object(reader, 3, "type environment") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "enums") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let enum_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "enum map",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let enums = Vec::with_capacity(enum_count);
    for _ in range(0, enum_count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_enum_def(reader, context, name) {
            Ok(value) => enums.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    match artifact_interface_binary_field(reader, "structs") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let struct_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "struct map",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let structs = Vec::with_capacity(struct_count);
    for _ in range(0, struct_count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_struct_def(reader, context, name) {
            Ok(value) => structs.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    match artifact_interface_binary_field(reader, "aliases") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let alias_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "type alias map",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let type_aliases = Vec::with_capacity(alias_count);
    for _ in range(0, alias_count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_type_alias(reader, context, name) {
            Ok(value) => type_aliases.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    match artifact_interface_binary_field(reader, "trait_env") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_object(reader, 3, "trait environment") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "trait_defs") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let trait_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "trait definitions",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let traits = Vec::with_capacity(trait_count);
    for _ in range(0, trait_count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_trait_def(reader, context, name) {
            Ok(value) => traits.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    match artifact_interface_binary_field(reader, "trait_impls") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let trait_impls = match artifact_interface_binary_trait_impls(
        reader,
        context,
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "inherent_impls") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let inherent_impls = match artifact_interface_binary_inherent_impls(
        reader,
        context,
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "value_env") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_object(reader, 2, "value environment") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "funcs") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let functions = match artifact_interface_binary_fn_map(reader, context) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "consts") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let constant_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "constant map",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let constants = Vec::with_capacity(constant_count);
    for _ in range(0, constant_count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_object(reader, 1, "constant scheme") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_field(reader, "ty") {
            Ok(()) => (),
            Err(error) => return Result::Err(error),
        };
        let ty = match artifact_interface_binary_type(reader, context) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        constants.push(tast::ConstantScheme {
            def_id: Option::None,
            name,
            ty,
        })
    };
    Result::Ok(ArtifactPackageExports {
        enum_type_names: context.enum_names,
        struct_type_names: context.struct_names,
        type_aliases,
        enums,
        structs,
        traits,
        trait_impls,
        inherent_impls,
        functions,
        constants,
    })
}

fn artifact_interface_binary_package_interface(
    reader: ArtifactInterfaceBinaryReader,
) -> Result[ArtifactPackageInterface, string] {
    match artifact_interface_binary_object(reader, 4, "package interface") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "package") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let package_name = match artifact_interface_binary_string(
        reader,
        "package name",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "name") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_interface_binary_string(reader, "interface name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "value_exports") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let value_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "value exports",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let value_exports = Vec::with_capacity(value_count);
    for _ in range(0, value_count) {
        let export_name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let number = match artifact_interface_binary_number(
            reader,
            "value export index",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_parse_nonnegative_int(number) {
            Ok(value) => value_exports.push((export_name, value)),
            Err(error) => return Result::Err(error),
        }
    };
    match artifact_interface_binary_field(reader, "enum_variants") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let enum_count = match artifact_interface_binary_read_count(
        reader,
        6,
        "enum variants",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let enum_variants = Vec::with_capacity(enum_count);
    for _ in range(0, enum_count) {
        let enum_name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_string_array(
            reader,
            "enum variant names",
        ) {
            Ok(value) => enum_variants.push((enum_name, value)),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(ArtifactPackageInterface {
        package_name,
        name,
        value_exports,
        enum_variants,
    })
}

fn artifact_interface_binary_string_map(
    reader: ArtifactInterfaceBinaryReader,
    expected: string,
) -> Result[Vec[(string, string)], string] {
    let count = match artifact_interface_binary_read_count(
        reader,
        6,
        expected,
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::with_capacity(count);
    for _ in range(0, count) {
        let name = match artifact_binary_decode_string_id(
            reader.reader,
            reader.table,
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_interface_binary_string(reader, expected) {
            Ok(value) => result.push((name, value)),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_interface_binary_version_field(
    reader: ArtifactInterfaceBinaryReader,
    name: string,
    expected: string,
) -> Result[unit, string] {
    match artifact_interface_binary_field(reader, name) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_number(reader, name) {
        Ok(value) => if value == expected {
            Result::Ok(())
        } else {
            Result::Err(artifact_interface_binary_error(name))
        },
        Err(error) => Result::Err(error),
    }
}

fn decode_artifact_interface_binary_value(
    table: ArtifactBinaryStringTable,
    data: bytes::Bytes,
) -> Result[ArtifactInterfaceUnit, string] {
    let reader = new_artifact_interface_binary_reader(data, table);
    match artifact_interface_binary_object(reader, 7, "interface unit") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_version_field(
        reader,
        "format_version",
        "17",
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_version_field(
        reader,
        "compiler_abi",
        "3",
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "package") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let package_name = match artifact_interface_binary_string(
        reader,
        "package name",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "exports") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let exports = match artifact_interface_binary_package_exports(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "interface") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let package_interface = match artifact_interface_binary_package_interface(
        reader,
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "deps") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let deps = match artifact_interface_binary_string_map(
        reader,
        "dependency hashes",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    match artifact_interface_binary_field(reader, "interface_hash") {
        Ok(()) => (),
        Err(error) => return Result::Err(error),
    };
    let interface_hash = match artifact_interface_binary_string(
        reader,
        "interface hash",
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if artifact_binary_reader_remaining(reader.reader) != 0 {
        return Result::Err("trailing bytes in binary artifact value")
    } else {
        ()
    };
    let result = ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(artifact_interface_binary_error(
            "matching interface package",
        ))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(artifact_interface_binary_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}
