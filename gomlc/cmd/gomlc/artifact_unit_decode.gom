package main;

use gomlc::vecs;

fn artifact_decode_optional_string(value: ArtifactValue, expected: string) -> Result[
    Option[string],
    string,
] {
    match value {
        Null => Result::Ok(Option::None),
        other => match artifact_json_string_value(other, expected) {
            Ok(value) => Result::Ok(Option::Some(value)),
            Err(error) => Result::Err(error),
        },
    }
}

fn artifact_decode_test_descriptor(value: ArtifactValue) -> Result[TestDescriptor, string] {
    let object = artifact_json_object(value, "test descriptor")?;
    let id = artifact_json_field_string(object, "id")?;
    let package_name = artifact_json_field_string(object, "package")?;
    let symbol = artifact_json_field_string(object, "symbol")?;
    let display_name = artifact_json_field_string(object, "display_name")?;
    let source_path = artifact_json_field_string(object, "source_path")?;
    let start = artifact_decode_core_index_field(object, "start")?;
    let end = artifact_decode_core_index_field(object, "end")?;
    let ignored = artifact_json_bool_value(
        artifact_json_required_field(object, "ignored")?,
        "test ignored flag",
    )?;
    let ignore_reason = artifact_decode_optional_string(
        artifact_json_required_field(object, "ignore_reason")?,
        "test ignore reason",
    )?;
    Result::Ok(
        TestDescriptor {
            id,
            package_name,
            symbol,
            display_name,
            source_path,
            start,
            end,
            ignored,
            ignore_reason,
        },
    )
}

fn artifact_decode_tests(value: ArtifactValue) -> Result[Vec[TestDescriptor], string] {
    let values = artifact_json_array(value, "test descriptors")?;
    let result: Vec[TestDescriptor] = Vec::[];
    for value in values {
        result.push(artifact_decode_test_descriptor(value)?)
    };
    Result::Ok(result)
}

fn artifact_test_descriptors_valid(package_name: string, values: Vec[TestDescriptor]) -> bool {
    let ids: Vec[string] = Vec::[];
    for value in values {
        if value.package_name != package_name || value.id == "" || value.symbol == ""
            || value.display_name == ""
            || value.source_path == ""
            || value.start > value.end
            || (!value.ignored && option_string_present(value.ignore_reason))
            || vecs::contains(ids, value.id) {
            return false
        } else {
            ids.push(value.id)
        }
    };
    true
}

fn artifact_decode_core_value(value: ArtifactValue) -> Result[ArtifactCoreUnit, string] {
    let object = artifact_json_object(value, "Core unit")?;
    let package_name = artifact_json_field_string(object, "package")?;
    let declared_name = artifact_json_field_string(object, "declared_name")?;
    let interface_hash = artifact_json_field_string(object, "interface_hash")?;
    let exports = artifact_decode_package_exports(artifact_json_required_field(object, "exports")?)?;
    let context = artifact_core_decode_context(exports);
    let core_ir = artifact_decode_core_file(
        context,
        artifact_json_required_field(object, "core_ir")?,
    )?;
    let deps = artifact_decode_string_map(
        artifact_json_required_field(object, "deps")?,
        "dependency hashes",
    )?;
    let sources = artifact_decode_string_array(
        artifact_json_required_field(object, "sources")?,
        "source paths",
    )?;
    let tests = match artifact_json_optional_field(object, "tests")? {
        Some(value) => artifact_decode_tests(value)?,
        None => Vec::[],
    };
    if !artifact_test_descriptors_valid(package_name, tests) {
        Result::Err(artifact_decode_error("valid test descriptors"))
    } else {
        Result::Ok(
            ArtifactCoreUnit {
                package_name,
                declared_name,
                interface_hash,
                exports,
                core_ir,
                deps,
                sources,
                tests,
            },
        )
    }
}
