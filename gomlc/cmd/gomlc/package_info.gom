package main;

use gomlc::strings;
use std::io;
use std::text;

struct PackageInfoArgs {
    inputs: Vec[string],
}

fn parse_package_info_args(args: Vec[string]) -> Result[PackageInfoArgs, string] {
    let inputs = Vec::new();
    let format: Ref[Option[string]] = Ref::new(Option::None);
    let index = Ref::new(2);
    let positional = Ref::new(false);
    while index.get() < args.len() {
        let argument = args[index.get()];
        if positional.get() == false && argument == "--" {
            positional.set(true);
            index.set(index.get() + 1)
        } else if positional.get() == false && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--help"))
        {
            let value = match inline_cli_value(argument, "--help") {
                Some(value) => value,
                None => "",
            };
            return Result::Err(unexpected_value_error_with_usage(
                value,
                "--help",
                "gomlc package-info --help --input <INPUT>...",
            ))
        } else if positional.get() {
            return Result::Err(unexpected_argument_error(
                "package-info",
                argument,
                false,
            ))
        } else if argument == "--input" {
            index.set(index.get() + 1);
            let previous_len = inputs.len();
            while index.get() < args.len() && !cli_option(args[index.get()]) {
                inputs.push(args[index.get()]);
                index.set(index.get() + 1)
            };
            if inputs.len() == previous_len {
                return Result::Err(value_required_error(
                    "--input <INPUT>...",
                    Option::None,
                ))
            } else {
                ()
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = match inline_cli_value(argument, "--input") {
                Some(value) => value,
                None => "",
            };
            if value == "" {
                return Result::Err(value_required_error(
                    "--input <INPUT>...",
                    Option::None,
                ))
            } else {
                inputs.push(value);
                index.set(index.get() + 1);
                while index.get() < args.len() && !cli_option(args[index.get()]) {
                    inputs.push(args[index.get()]);
                    index.set(index.get() + 1)
                }
            }
        } else if argument == "--format" {
            if index.get() + 1 >= args.len()
                || cli_option(args[index.get() + 1])
            {
                return Result::Err(value_required_error(
                    "--format <FORMAT>",
                    Option::None,
                ))
            } else if option_string_present(format.get()) {
                return Result::Err(repeated_argument_error(
                    "package-info",
                    "--format <FORMAT>",
                ))
            } else {
                format.set(Option::Some(args[index.get() + 1]));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--format")) {
            if option_string_empty(inline_cli_value(argument, "--format")) {
                return Result::Err(value_required_error(
                    "--format <FORMAT>",
                    Option::None,
                ))
            } else if option_string_present(format.get()) {
                return Result::Err(repeated_argument_error(
                    "package-info",
                    "--format <FORMAT>",
                ))
            } else {
                format.set(inline_cli_value(argument, "--format"));
                index.set(index.get() + 1)
            }
        } else {
            return Result::Err(unexpected_cli_option_error_with_usage(
                "package-info",
                argument,
                command_usage("package-info"),
            ))
        }
    };
    let selected_format = match format.get() {
        Some(value) => value,
        None => "json",
    };
    if selected_format != "json" {
        Result::Err(
            "error: invalid value '"
                + selected_format
                + "' for '--format <FORMAT>'\n  [possible values: json]\n\n"
                + cli_error_footer(),
        )
    } else if inputs.len() == 0 {
        Result::Err(missing_required_arguments_error_with_usage(
            Vec::new().pushed("--input <INPUT>..."),
            required_command_usage("package-info"),
        ))
    } else {
        Result::Ok(PackageInfoArgs {
            inputs: sorted_unique_package_inputs(inputs),
        })
    }
}

struct PackageInfoUse {
    alias: Option[string],
    path: string,
}

struct PackageInfoFile {
    package_name: string,
    package_explicit: bool,
    uses: Vec[PackageInfoUse],
}

struct PackageInfoScanner {
    source: string,
    index: Ref[int],
}

fn new_package_info_scanner(source: string) -> PackageInfoScanner {
    PackageInfoScanner {
        source,
        index: Ref::new(0),
    }
}

fn package_info_ident_continue(value: uint8) -> bool {
    (value >= 65 && value <= 90)
        || (value >= 97 && value <= 122)
        || (value >= 48 && value <= 57)
        || value == 95
}

fn package_info_skip_trivia(scanner: PackageInfoScanner) -> unit {
    while scanner.index.get() < scanner.source.byte_len() {
        let index = scanner.index.get();
        let value = scanner.source.byte_get(index);
        if value == 32 || value == 9 || value == 10 || value == 13 {
            scanner.index.set(index + 1)
        } else if index + 1 < scanner.source.byte_len()
            && value == 47
            && scanner.source.byte_get(index + 1) == 47
        {
            scanner.index.set(index + 2);
            while scanner.index.get() < scanner.source.byte_len()
                && scanner.source.byte_get(scanner.index.get()) != 10
            {
                scanner.index.set(scanner.index.get() + 1)
            }
        } else {
            break
        }
    }
}

fn package_info_at_text(
    scanner: PackageInfoScanner,
    expected: string,
) -> bool {
    let start = scanner.index.get();
    let end = start + expected.byte_len();
    end <= scanner.source.byte_len()
        && strings::starts_with_at(scanner.source, start, expected)
}

fn package_info_at_keyword(
    scanner: PackageInfoScanner,
    expected: string,
) -> bool {
    let end = scanner.index.get() + expected.byte_len();
    package_info_at_text(scanner, expected)
        && (end >= scanner.source.byte_len()
            || !package_info_ident_continue(scanner.source.byte_get(end)))
}

fn package_info_consume_text(
    scanner: PackageInfoScanner,
    expected: string,
) -> bool {
    package_info_skip_trivia(scanner);
    if package_info_at_text(scanner, expected) {
        scanner.index.set(scanner.index.get() + expected.byte_len());
        true
    } else {
        false
    }
}

fn package_info_consume_keyword(
    scanner: PackageInfoScanner,
    expected: string,
) -> bool {
    package_info_skip_trivia(scanner);
    if package_info_at_keyword(scanner, expected) {
        scanner.index.set(scanner.index.get() + expected.byte_len());
        true
    } else {
        false
    }
}

fn package_info_read_ident(scanner: PackageInfoScanner) -> Option[string] {
    package_info_skip_trivia(scanner);
    if scanner.index.get() >= scanner.source.byte_len() {
        Option::None
    } else {
        let start = scanner.index.get();
        let first = scanner.source.byte_get(start);
        if !((first >= 65 && first <= 90)
            || (first >= 97 && first <= 122)
            || first == 95)
        {
            Option::None
        } else {
            scanner.index.set(start + 1);
            while scanner.index.get() < scanner.source.byte_len()
                && package_info_ident_continue(
                    scanner.source.byte_get(scanner.index.get()),
                )
            {
                scanner.index.set(scanner.index.get() + 1)
            };
            Option::Some(
                scanner.source.byte_slice(start, scanner.index.get()),
            )
        }
    }
}

fn package_info_lower_ident(value: string) -> bool {
    if value.byte_len() == 0 {
        false
    } else {
        let first = value.byte_get(0);
        (first >= 97 && first <= 122) || first == 95
    }
}

fn package_info_error(source_path: string, message: string) -> string {
    "error[parser]: " + source_path + ": " + message
}

fn package_info_expect_text(
    scanner: PackageInfoScanner,
    expected: string,
    source_path: string,
    message: string,
) -> Result[unit, string] {
    if package_info_consume_text(scanner, expected) {
        Result::Ok(())
    } else {
        Result::Err(package_info_error(source_path, message))
    }
}

fn package_info_parse_use(
    scanner: PackageInfoScanner,
    source_path: string,
) -> Result[PackageInfoUse, string] {
    let first = match package_info_read_ident(scanner) {
        Some(value) => value,
        None => {
            return Result::Err(package_info_error(
                source_path,
                "expected a path after `use`",
            ))
        },
    };
    let path = text::StringBuilder::new();
    path.write_string(first);
    package_info_skip_trivia(scanner);
    while package_info_at_text(scanner, "::") {
        scanner.index.set(scanner.index.get() + 2);
        match package_info_read_ident(scanner) {
            Some(value) => {
                path.write_string("::");
                path.write_string(value);
                package_info_skip_trivia(scanner)
            },
            None => {
                return Result::Err(package_info_error(
                    source_path,
                    "expected a path segment after '::'",
                ))
            },
        }
    };
    let alias: Ref[Option[string]] = Ref::new(Option::None);
    if package_info_consume_keyword(scanner, "as") {
        match package_info_read_ident(scanner) {
            Some(value) => if package_info_lower_ident(value) {
                alias.set(Option::Some(value))
            } else {
                return Result::Err(package_info_error(
                    source_path,
                    "use alias must start with a lowercase letter or `_`",
                ))
            },
            None => {
                return Result::Err(package_info_error(
                    source_path,
                    "expected use alias",
                ))
            },
        }
    } else {
        ()
    };
    match package_info_expect_text(scanner, ";", source_path, "expected ';'") {
        Ok(_) => Result::Ok(PackageInfoUse {
            alias: alias.get(),
            path: path.finish(),
        }),
        Err(error) => Result::Err(error),
    }
}

fn parse_package_info_file(
    source_path: string,
    source: string,
) -> Result[PackageInfoFile, string] {
    let scanner = new_package_info_scanner(source);
    package_info_skip_trivia(scanner);
    let declared_package = if package_info_consume_keyword(scanner, "package") {
        let package_name = match package_info_read_ident(scanner) {
            Some(value) => if !package_info_lower_ident(value) {
                return Result::Err(package_info_error(
                    source_path,
                    "package name must start with a lowercase letter or `_`",
                ))
            } else {
                value
            },
            None => {
                return Result::Err(package_info_error(
                    source_path,
                    "expected package name",
                ))
            },
        };
        match package_info_expect_text(scanner, ";", source_path, "expected ';'") {
            Ok(_) => (),
            Err(error) => return Result::Err(error),
        };
        (package_name, true)
    } else {
        ("main", false)
    };
    let uses = Vec::new();
    package_info_skip_trivia(scanner);
    while package_info_consume_keyword(scanner, "use") {
        match package_info_parse_use(scanner, source_path) {
            Ok(value) => uses.push(value),
            Err(error) => return Result::Err(error),
        };
        package_info_skip_trivia(scanner)
    };
    Result::Ok(PackageInfoFile {
        package_name: declared_package.0,
        package_explicit: declared_package.1,
        uses,
    })
}

fn package_info_json(args: PackageInfoArgs) -> string {
    let writer = new_artifact_json_writer(false);
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "files");
    artifact_json_begin_array(writer);
    for source_path in args.inputs {
        let source = read_source(source_path);
        let file = match parse_package_info_file(source_path, source) {
            Ok(value) => value,
            Err(error) => {
                fail(error);
                PackageInfoFile {
                    package_name: "",
                    package_explicit: false,
                    uses: Vec::new(),
                }
            },
        };
        artifact_json_begin_object(writer);
        artifact_json_name(writer, "package");
        artifact_json_string(writer, file.package_name);
        artifact_json_name(writer, "package_explicit");
        artifact_json_bool(writer, file.package_explicit);
        artifact_json_name(writer, "path");
        artifact_json_string(writer, source_path);
        artifact_json_name(writer, "uses");
        artifact_json_begin_array(writer);
        for use_decl in file.uses {
            artifact_json_begin_object(writer);
            artifact_json_name(writer, "alias");
            match use_decl.alias {
                Some(value) => artifact_json_string(writer, value),
                None => artifact_json_null(writer),
            };
            artifact_json_name(writer, "path");
            artifact_json_string(writer, use_decl.path);
            artifact_json_end_object(writer)
        };
        artifact_json_end_array(writer);
        artifact_json_end_object(writer)
    };
    artifact_json_end_array(writer);
    artifact_json_name(writer, "protocol_version");
    artifact_json_number(writer, "1");
    artifact_json_end_object(writer);
    artifact_json_finish(writer)
}

fn run_package_info(args: Vec[string]) -> unit {
    match parse_package_info_args(args) {
        Ok(value) => io::println(package_info_json(value)),
        Err(error) => handle_cli_parse_error("package-info", error),
    }
}
