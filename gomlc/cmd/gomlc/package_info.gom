package main;

use gomlc::lexer;
use std::io;

struct PackageInfoArgs {
    inputs: Vec[string],
}

fn parse_package_info_args(args: Vec[string]) -> Result[PackageInfoArgs, string] {
    let inputs = Vec::new();
    let format: Ref[Option[string]] = Ref::new(Option::None);
    let index = Ref::new(2);
    let positional = Ref::new(false);
    while index.get() < args.len() {
        let argument = args.get(index.get());
        if positional.get() == false && argument == "--" {
            positional.set(true);
            index.set(index.get() + 1)
        } else if positional.get() == false && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--help"))
        {
            let value = match inline_cli_value(argument, "--help") {
                Option::Some(value) => value,
                Option::None => "",
            };
            return Result::Err(unexpected_value_error_with_usage(
                value,
                "--help",
                "gomlc package-info --help --input <INPUT>...",
            ))
        } else if positional.get() {
            return Result::Err(unexpected_argument_error(
                "package-info",
                argument,
                false,
            ))
        } else if argument == "--input" {
            index.set(index.get() + 1);
            let previous_len = inputs.len();
            while index.get() < args.len() && !cli_option(args.get(index.get())) {
                inputs.push(args.get(index.get()));
                index.set(index.get() + 1)
            };
            if inputs.len() == previous_len {
                return Result::Err(value_required_error(
                    "--input <INPUT>...",
                    Option::None,
                ))
            } else {
                ()
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = match inline_cli_value(argument, "--input") {
                Option::Some(value) => value,
                Option::None => "",
            };
            if value == "" {
                return Result::Err(value_required_error(
                    "--input <INPUT>...",
                    Option::None,
                ))
            } else {
                inputs.push(value);
                index.set(index.get() + 1);
                while index.get() < args.len() && !cli_option(args.get(index.get())) {
                    inputs.push(args.get(index.get()));
                    index.set(index.get() + 1)
                }
            }
        } else if argument == "--format" {
            if index.get() + 1 >= args.len()
                || cli_option(args.get(index.get() + 1))
            {
                return Result::Err(value_required_error(
                    "--format <FORMAT>",
                    Option::None,
                ))
            } else if option_string_present(format.get()) {
                return Result::Err(repeated_argument_error(
                    "package-info",
                    "--format <FORMAT>",
                ))
            } else {
                format.set(Option::Some(args.get(index.get() + 1)));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--format")) {
            if option_string_empty(inline_cli_value(argument, "--format")) {
                return Result::Err(value_required_error(
                    "--format <FORMAT>",
                    Option::None,
                ))
            } else if option_string_present(format.get()) {
                return Result::Err(repeated_argument_error(
                    "package-info",
                    "--format <FORMAT>",
                ))
            } else {
                format.set(inline_cli_value(argument, "--format"));
                index.set(index.get() + 1)
            }
        } else {
            return Result::Err(unexpected_cli_option_error_with_usage(
                "package-info",
                argument,
                command_usage("package-info"),
            ))
        }
    };
    let selected_format = match format.get() {
        Option::Some(value) => value,
        Option::None => "json",
    };
    if selected_format != "json" {
        Result::Err(
            "error: invalid value '"
                + selected_format
                + "' for '--format <FORMAT>'\n  [possible values: json]\n\n"
                + cli_error_footer(),
        )
    } else if inputs.len() == 0 {
        Result::Err(missing_required_arguments_error_with_usage(
            Vec::new().pushed("--input <INPUT>..."),
            required_command_usage("package-info"),
        ))
    } else {
        Result::Ok(PackageInfoArgs {
            inputs: sorted_unique_package_inputs(inputs),
        })
    }
}

struct PackageInfoUse {
    alias: Option[string],
    path: string,
}

struct PackageInfoFile {
    package_name: string,
    package_explicit: bool,
    uses: Vec[PackageInfoUse],
}

fn package_info_trivia(kind: lexer::TokenKind) -> bool {
    lexer::token_kind_equal(kind, lexer::TokenKind::Whitespace)
        || lexer::token_kind_equal(kind, lexer::TokenKind::Comment)
}

fn package_info_skip_trivia(tokens: Vec[lexer::Token], index: Ref[int]) -> unit {
    while index.get() < tokens.len()
        && package_info_trivia(tokens.get(index.get()).kind)
    {
        index.set(index.get() + 1)
    }
}

fn package_info_at(
    tokens: Vec[lexer::Token],
    index: int,
    kind: lexer::TokenKind,
) -> bool {
    index < tokens.len() && lexer::token_kind_equal(tokens.get(index).kind, kind)
}

fn package_info_lower_ident(value: string) -> bool {
    if value.byte_len() == 0 {
        false
    } else {
        let first = value.byte_get(0);
        (first >= 97 && first <= 122) || first == 95
    }
}

fn package_info_error(source_path: string, message: string) -> string {
    "error[parser]: " + source_path + ": " + message
}

fn package_info_expect(
    tokens: Vec[lexer::Token],
    index: Ref[int],
    kind: lexer::TokenKind,
    source_path: string,
    message: string,
) -> Result[unit, string] {
    package_info_skip_trivia(tokens, index);
    if package_info_at(tokens, index.get(), kind) {
        index.set(index.get() + 1);
        Result::Ok(())
    } else {
        Result::Err(package_info_error(source_path, message))
    }
}

fn package_info_parse_use(
    tokens: Vec[lexer::Token],
    index: Ref[int],
    source_path: string,
) -> Result[PackageInfoUse, string] {
    index.set(index.get() + 1);
    package_info_skip_trivia(tokens, index);
    if !package_info_at(tokens, index.get(), lexer::TokenKind::Ident) {
        Result::Err(package_info_error(
            source_path,
            "expected a path after `use`",
        ))
    } else {
        let path: Ref[string] = Ref::new(tokens.get(index.get()).text);
        index.set(index.get() + 1);
        package_info_skip_trivia(tokens, index);
        while package_info_at(tokens, index.get(), lexer::TokenKind::ColonColon) {
            index.set(index.get() + 1);
            package_info_skip_trivia(tokens, index);
            if package_info_at(tokens, index.get(), lexer::TokenKind::Ident) {
                path.set(path.get() + "::" + tokens.get(index.get()).text);
                index.set(index.get() + 1);
                package_info_skip_trivia(tokens, index)
            } else {
                return Result::Err(package_info_error(
                    source_path,
                    "expected a path segment after '::'",
                ))
            }
        };
        let alias: Ref[Option[string]] = Ref::new(Option::None);
        if package_info_at(tokens, index.get(), lexer::TokenKind::AsKeyword) {
            index.set(index.get() + 1);
            package_info_skip_trivia(tokens, index);
            if package_info_at(tokens, index.get(), lexer::TokenKind::Ident) {
                let value = tokens.get(index.get()).text;
                if package_info_lower_ident(value) {
                    alias.set(Option::Some(value));
                    index.set(index.get() + 1)
                } else {
                    return Result::Err(package_info_error(
                        source_path,
                        "use alias must start with a lowercase letter or `_`",
                    ))
                }
            } else {
                return Result::Err(package_info_error(
                    source_path,
                    "expected use alias",
                ))
            }
        } else {
            ()
        };
        match package_info_expect(
            tokens,
            index,
            lexer::TokenKind::Semi,
            source_path,
            "expected ';'",
        ) {
            Result::Ok(_) => Result::Ok(PackageInfoUse {
                alias: alias.get(),
                path: path.get(),
            }),
            Result::Err(error) => Result::Err(error),
        }
    }
}

fn parse_package_info_file(
    source_path: string,
    source: string,
) -> Result[PackageInfoFile, string] {
    let tokens = lexer::lex(source);
    let index = Ref::new(0);
    package_info_skip_trivia(tokens, index);
    let package_name: Ref[string] = Ref::new("main");
    let package_explicit: Ref[bool] = Ref::new(false);
    if package_info_at(tokens, index.get(), lexer::TokenKind::PackageKeyword) {
        package_explicit.set(true);
        index.set(index.get() + 1);
        package_info_skip_trivia(tokens, index);
        if !package_info_at(tokens, index.get(), lexer::TokenKind::Ident) {
            return Result::Err(package_info_error(
                source_path,
                "expected package name",
            ))
        } else {
            let value = tokens.get(index.get()).text;
            if !package_info_lower_ident(value) {
                return Result::Err(package_info_error(
                    source_path,
                    "package name must start with a lowercase letter or `_`",
                ))
            } else {
                package_name.set(value);
                index.set(index.get() + 1)
            }
        };
        match package_info_expect(
            tokens,
            index,
            lexer::TokenKind::Semi,
            source_path,
            "expected ';'",
        ) {
            Result::Ok(_) => (),
            Result::Err(error) => return Result::Err(error),
        }
    } else {
        ()
    };
    let uses = Vec::new();
    package_info_skip_trivia(tokens, index);
    while package_info_at(tokens, index.get(), lexer::TokenKind::UseKeyword) {
        match package_info_parse_use(tokens, index, source_path) {
            Result::Ok(value) => uses.push(value),
            Result::Err(error) => return Result::Err(error),
        };
        package_info_skip_trivia(tokens, index)
    };
    Result::Ok(PackageInfoFile {
        package_name: package_name.get(),
        package_explicit: package_explicit.get(),
        uses,
    })
}

fn package_info_json(args: PackageInfoArgs) -> string {
    let writer = new_artifact_json_writer(false);
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "files");
    artifact_json_begin_array(writer);
    for source_path in args.inputs {
        let source = read_source(source_path);
        let file = match parse_package_info_file(source_path, source) {
            Result::Ok(value) => value,
            Result::Err(error) => {
                fail(error);
                PackageInfoFile {
                    package_name: "",
                    package_explicit: false,
                    uses: Vec::new(),
                }
            },
        };
        artifact_json_begin_object(writer);
        artifact_json_name(writer, "package");
        artifact_json_string(writer, file.package_name);
        artifact_json_name(writer, "package_explicit");
        artifact_json_bool(writer, file.package_explicit);
        artifact_json_name(writer, "path");
        artifact_json_string(writer, source_path);
        artifact_json_name(writer, "uses");
        artifact_json_begin_array(writer);
        for use_decl in file.uses {
            artifact_json_begin_object(writer);
            artifact_json_name(writer, "alias");
            match use_decl.alias {
                Option::Some(value) => artifact_json_string(writer, value),
                Option::None => artifact_json_null(writer),
            };
            artifact_json_name(writer, "path");
            artifact_json_string(writer, use_decl.path);
            artifact_json_end_object(writer)
        };
        artifact_json_end_array(writer);
        artifact_json_end_object(writer)
    };
    artifact_json_end_array(writer);
    artifact_json_name(writer, "protocol_version");
    artifact_json_number(writer, "1");
    artifact_json_end_object(writer);
    artifact_json_finish(writer)
}

fn run_package_info(args: Vec[string]) -> unit {
    match parse_package_info_args(args) {
        Result::Ok(value) => io::println(package_info_json(value)),
        Result::Err(error) => handle_cli_parse_error("package-info", error),
    }
}
