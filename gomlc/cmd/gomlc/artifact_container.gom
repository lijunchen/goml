package main;

use gomlc::go_backend;
use std::bytes;

struct ArtifactBinarySection {
    id: uint16,
    version: uint16,
    flags: uint16,
    data: bytes::Bytes,
}

struct ArtifactBinaryContainer {
    kind: uint8,
    sections: Vec[ArtifactBinarySection],
}

fn artifact_binary_header_size() -> int {
    70
}

fn artifact_binary_directory_entry_size() -> int {
    56
}

fn artifact_binary_magic() -> bytes::Bytes {
    bytes::Bytes::from_vec(
        Vec::new()
            .pushed(71)
            .pushed(79)
            .pushed(77)
            .pushed(76)
            .pushed(65)
            .pushed(82)
            .pushed(84)
            .pushed(0),
    )
}

fn artifact_binary_bytes_equal(
    left: bytes::Bytes,
    right: bytes::Bytes,
) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in range(0, left.len()) {
            if left.get(index) != right.get(index) {
                return false
            } else {
                ()
            }
        };
        true
    }
}

fn artifact_binary_hex_value(value: uint8) -> uint8 {
    if value >= 48 && value <= 57 {
        value - 48
    } else if value >= 97 && value <= 102 {
        value - 87
    } else {
        0
    }
}

fn artifact_binary_sha256(value: bytes::Bytes) -> bytes::Bytes {
    let text = go_backend::sha256_bytes_hex(value);
    let result = bytes::Bytes::with_capacity(32);
    for index in range(0, 32) {
        result.push(
            (artifact_binary_hex_value(text.byte_get(index * 2)) << 4)
                | artifact_binary_hex_value(text.byte_get(index * 2 + 1)),
        )
    };
    result
}

fn artifact_binary_section_insert_index(
    values: Vec[ArtifactBinarySection],
    value: ArtifactBinarySection,
) -> int {
    for index in range(0, values.len()) {
        if value.id < values.get(index).id {
            return index
        } else {
            ()
        }
    };
    values.len()
}

fn artifact_binary_sort_sections(
    values: Vec[ArtifactBinarySection],
) -> Vec[ArtifactBinarySection] {
    let result = Vec::new();
    for value in values {
        let index = artifact_binary_section_insert_index(result, value);
        if index == result.len() {
            result.push(value)
        } else {
            result.insert(index, value)
        }
    };
    result
}

fn artifact_binary_sections_valid(
    values: Vec[ArtifactBinarySection],
) -> bool {
    let previous: Ref[Option[uint16]] = Ref::new(Option::None);
    for value in values {
        match previous.get() {
            Some(id) => if id == value.id {
                return false
            } else {
                ()
            },
            None => (),
        };
        previous.set(Option::Some(value.id))
    };
    true
}

fn encode_artifact_binary_container(
    kind: uint8,
    sections: Vec[ArtifactBinarySection],
) -> Result[bytes::Bytes, string] {
    if kind != 1 && kind != 2 && kind != 3 {
        return Result::Err("invalid binary artifact kind")
    } else {
        ()
    };
    let sections = artifact_binary_sort_sections(sections);
    if !artifact_binary_sections_valid(sections) {
        return Result::Err("duplicate binary artifact section")
    } else if sections.len() > 1024 {
        return Result::Err("too many binary artifact sections")
    } else {
        ()
    };
    let payload = bytes::Bytes::new();
    for section in sections {
        for index in range(0, section.data.len()) {
            payload.push(section.data.get(index))
        }
    };
    let writer = new_artifact_binary_writer();
    artifact_binary_write_raw_bytes(writer, artifact_binary_magic());
    artifact_binary_write_u16(writer, 1);
    artifact_binary_write_u16(writer, 0);
    artifact_binary_write_u8(writer, kind);
    artifact_binary_write_u8(writer, 0);
    artifact_binary_write_u32(writer, 3);
    artifact_binary_write_u16(writer, sections.len() as uint16);
    artifact_binary_write_u16(writer, 0);
    artifact_binary_write_u64(
        writer,
        artifact_binary_header_size() as uint64,
    );
    artifact_binary_write_u64(writer, payload.len() as uint64);
    artifact_binary_write_raw_bytes(writer, artifact_binary_sha256(payload));
    let offset = Ref::new(
        artifact_binary_header_size()
            + artifact_binary_directory_entry_size() * sections.len(),
    );
    for section in sections {
        artifact_binary_write_u16(writer, section.id);
        artifact_binary_write_u16(writer, section.version);
        artifact_binary_write_u16(writer, section.flags);
        artifact_binary_write_u16(writer, 0);
        artifact_binary_write_u64(writer, offset.get() as uint64);
        artifact_binary_write_u64(writer, section.data.len() as uint64);
        artifact_binary_write_raw_bytes(
            writer,
            artifact_binary_sha256(section.data),
        );
        offset.set(offset.get() + section.data.len())
    };
    artifact_binary_write_raw_bytes(writer, payload);
    Result::Ok(artifact_binary_writer_finish(writer))
}

fn artifact_binary_checked_int(
    reader: ArtifactBinaryReader,
    value: uint64,
    name: string,
) -> Result[int, string] {
    if value > 2147483647 {
        Result::Err(artifact_binary_reader_error(
            reader,
            name + " exceeds supported size",
        ))
    } else {
        Result::Ok(value as int)
    }
}

fn decode_artifact_binary_container(
    data: bytes::Bytes,
) -> Result[ArtifactBinaryContainer, string] {
    let reader = new_artifact_binary_reader(data);
    let magic = match artifact_binary_read_raw_bytes(reader, 8) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if !artifact_binary_bytes_equal(magic, artifact_binary_magic()) {
        return Result::Err("invalid binary artifact magic")
    } else {
        ()
    };
    let major = match artifact_binary_read_u16(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let minor = match artifact_binary_read_u16(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if major != 1 {
        return Result::Err("unsupported binary artifact major version")
    } else if minor > 0 {
        return Result::Err("unsupported binary artifact minor version")
    } else {
        ()
    };
    let kind = match artifact_binary_read_u8(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if kind != 1 && kind != 2 && kind != 3 {
        return Result::Err("invalid binary artifact kind")
    } else {
        ()
    };
    let flags = match artifact_binary_read_u8(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if flags != 0 {
        return Result::Err("unsupported binary artifact flags")
    } else {
        ()
    };
    let compiler_abi = match artifact_binary_read_u32(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if compiler_abi != 3 {
        return Result::Err("unsupported binary artifact compiler ABI")
    } else {
        ()
    };
    let section_count = match artifact_binary_read_u16(reader) {
        Ok(value) => value as int,
        Err(error) => return Result::Err(error),
    };
    let reserved = match artifact_binary_read_u16(reader) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if section_count > 1024 {
        return Result::Err("too many binary artifact sections")
    } else if reserved != 0 {
        return Result::Err("invalid binary artifact reserved field")
    } else {
        ()
    };
    let directory_offset = match artifact_binary_read_u64(reader) {
        Ok(value) => match artifact_binary_checked_int(
            reader,
            value,
            "directory offset",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let payload_length = match artifact_binary_read_u64(reader) {
        Ok(value) => match artifact_binary_checked_int(
            reader,
            value,
            "payload length",
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let payload_hash = match artifact_binary_read_raw_bytes(reader, 32) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if directory_offset != artifact_binary_header_size() {
        return Result::Err("invalid binary artifact directory offset")
    } else {
        ()
    };
    let payload_offset = artifact_binary_header_size()
        + section_count * artifact_binary_directory_entry_size();
    if payload_offset > data.len()
        || payload_length != data.len() - payload_offset
    {
        return Result::Err("invalid binary artifact payload length")
    } else {
        ()
    };
    let section_ids = Vec::with_capacity(section_count);
    let section_versions = Vec::with_capacity(section_count);
    let section_flags = Vec::with_capacity(section_count);
    let section_offsets = Vec::with_capacity(section_count);
    let section_lengths = Vec::with_capacity(section_count);
    let section_hashes = Vec::with_capacity(section_count);
    for _ in range(0, section_count) {
        let id = match artifact_binary_read_u16(reader) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if section_ids.len() > 0
            && id <= section_ids.get(section_ids.len() - 1)
        {
            return Result::Err(
                "binary artifact section directory is not sorted",
            )
        } else {
            ()
        };
        let version = match artifact_binary_read_u16(reader) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let flags = match artifact_binary_read_u16(reader) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let reserved = match artifact_binary_read_u16(reader) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if reserved != 0 {
            return Result::Err("invalid binary artifact section reserved field")
        } else {
            ()
        };
        let offset = match artifact_binary_read_u64(reader) {
            Ok(value) => match artifact_binary_checked_int(
                reader,
                value,
                "section offset",
            ) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let length = match artifact_binary_read_u64(reader) {
            Ok(value) => match artifact_binary_checked_int(
                reader,
                value,
                "section length",
            ) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let hash = match artifact_binary_read_raw_bytes(reader, 32) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        section_ids.push(id);
        section_versions.push(version);
        section_flags.push(flags);
        section_offsets.push(offset);
        section_lengths.push(length);
        section_hashes.push(hash)
    };
    let payload = bytes::Bytes::with_capacity(payload_length);
    for index in range(0, payload_length) {
        payload.push(data.get(payload_offset + index))
    };
    if !artifact_binary_bytes_equal(
        payload_hash,
        artifact_binary_sha256(payload),
    ) {
        return Result::Err("binary artifact payload checksum mismatch")
    } else {
        ()
    };
    let result = Vec::new();
    let previous_end = Ref::new(payload_offset);
    for index in range(0, section_count) {
        let offset = section_offsets.get(index);
        let length = section_lengths.get(index);
        if offset != previous_end.get()
            || length > data.len() - offset
        {
            return Result::Err("invalid binary artifact section range")
        } else {
            ()
        };
        let section_data = bytes::Bytes::with_capacity(length);
        for item in range(0, length) {
            section_data.push(data.get(offset + item))
        };
        if !artifact_binary_bytes_equal(
            section_hashes.get(index),
            artifact_binary_sha256(section_data),
        ) {
            return Result::Err("binary artifact section checksum mismatch")
        } else {
            ()
        };
        result.push(ArtifactBinarySection {
            id: section_ids.get(index),
            version: section_versions.get(index),
            flags: section_flags.get(index),
            data: section_data,
        });
        previous_end.set(offset + length)
    };
    if previous_end.get() != data.len() {
        Result::Err("invalid binary artifact section coverage")
    } else if !artifact_binary_sections_valid(result) {
        Result::Err("duplicate binary artifact section")
    } else {
        Result::Ok(ArtifactBinaryContainer {
            kind,
            sections: result,
        })
    }
}

fn artifact_binary_find_section(
    value: ArtifactBinaryContainer,
    id: uint16,
) -> Option[ArtifactBinarySection] {
    for offset in range(0, value.sections.len()) {
        let section = value.sections.get(value.sections.len() - 1 - offset);
        if section.id == id {
            return Option::Some(section)
        } else {
            ()
        }
    };
    Option::None
}
