package main;

use std::bytes;
use std::fs;

fn decode_artifact_interface_bytes(
    data: bytes::Bytes,
) -> Result[ArtifactInterfaceUnit, string] {
    decode_artifact_interface_binary(data)
}

fn decode_artifact_core_bytes(
    data: bytes::Bytes,
) -> Result[ArtifactCoreUnit, string] {
    decode_artifact_core_binary(data)
}

fn write_artifact_interface(
    path_value: string,
    value: ArtifactInterfaceUnit,
) -> Result[unit, string] {
    match encode_artifact_interface_binary(value) {
        Result::Ok(data) => fs::write_bytes(path_value, data),
        Result::Err(error) => Result::Err(error),
    }
}

fn write_artifact_core(
    path_value: string,
    value: ArtifactCoreUnit,
) -> Result[unit, string] {
    match encode_artifact_core_binary(value) {
        Result::Ok(data) => fs::write_bytes(path_value, data),
        Result::Err(error) => Result::Err(error),
    }
}
