package main;

use gomlc::artifact_model;

use std::bytes;
use std::fs;

fn decode_artifact_interface_bytes(data: bytes::Bytes) -> Result[artifact_model::ArtifactInterfaceUnit, string] {
    decode_artifact_interface_binary(data)
}

fn decode_artifact_core_bytes(data: bytes::Bytes) -> Result[artifact_model::ArtifactCoreUnit, string] {
    decode_artifact_core_binary(data)
}

fn write_artifact_interface(path_value: string, value: artifact_model::ArtifactInterfaceUnit) -> Result[
    unit,
    string,
] {
    match encode_artifact_interface_binary(value) {
        Ok(data) => fs::write_bytes(path_value, data),
        Err(error) => Result::Err(error),
    }
}

fn write_artifact_core(path_value: string, value: artifact_model::ArtifactCoreUnit) -> Result[unit, string] {
    match encode_artifact_core_binary(value) {
        Ok(data) => fs::write_bytes(path_value, data),
        Err(error) => Result::Err(error),
    }
}
