package main;

use std::text;

enum ArtifactJsonValue {
    Object(Vec[(string, ArtifactJsonValue)]),
    Array(Vec[ArtifactJsonValue]),
    String(string),
    Number(string),
    Bool(bool),
    Null,
}

struct ArtifactJsonParser {
    input: string,
    index: Ref[int],
}

fn new_artifact_json_parser(input: string) -> ArtifactJsonParser {
    ArtifactJsonParser {
        input,
        index: Ref::new(0),
    }
}

fn artifact_json_parse_error(value: ArtifactJsonParser, message: string) -> string {
    message + " at byte " + value.index.get().to_string()
}

fn artifact_json_parse_whitespace(byte: uint8) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn artifact_json_skip_whitespace(value: ArtifactJsonParser) -> unit {
    while value.index.get() < value.input.byte_len()
        && artifact_json_parse_whitespace(value.input.byte_get(value.index.get()))
    {
        value.index.set(value.index.get() + 1)
    }
}

fn artifact_json_parse_hex(byte: uint8) -> Option[uint32] {
    if byte >= 48 && byte <= 57 {
        Option::Some((byte - 48) as uint32)
    } else if byte >= 65 && byte <= 70 {
        Option::Some((byte - 55) as uint32)
    } else if byte >= 97 && byte <= 102 {
        Option::Some((byte - 87) as uint32)
    } else {
        Option::None
    }
}

fn artifact_json_parse_hex_quad(value: ArtifactJsonParser) -> Result[uint32, string] {
    if value.index.get() + 4 > value.input.byte_len() {
        Result::Err(artifact_json_parse_error(value, "incomplete unicode escape"))
    } else {
        let result = Ref::new(0);
        for offset in range(0, 4) {
            match artifact_json_parse_hex(value.input.byte_get(value.index.get() + offset)) {
                Option::Some(digit) => result.set(result.get() * 16 + digit),
                Option::None => return Result::Err(artifact_json_parse_error(
                    value,
                    "invalid unicode escape",
                )),
            }
        };
        value.index.set(value.index.get() + 4);
        Result::Ok(result.get())
    }
}

fn artifact_json_write_codepoint(
    value: ArtifactJsonParser,
    builder: text::StringBuilder,
    codepoint: uint32,
) -> Result[unit, string] {
    match char_from_uint32(codepoint) {
        Option::Some(character) => {
            builder.write_char(character);
            Result::Ok(())
        },
        Option::None => Result::Err(artifact_json_parse_error(
            value,
            "invalid unicode codepoint",
        )),
    }
}

fn artifact_json_parse_unicode_escape(
    value: ArtifactJsonParser,
    builder: text::StringBuilder,
) -> Result[unit, string] {
    let first = match artifact_json_parse_hex_quad(value) {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    if first >= 55296 && first <= 56319 {
        if value.index.get() + 2 > value.input.byte_len()
            || value.input.byte_get(value.index.get()) != 92
            || value.input.byte_get(value.index.get() + 1) != 117
        {
            Result::Err(artifact_json_parse_error(value, "missing low surrogate"))
        } else {
            value.index.set(value.index.get() + 2);
            let second = match artifact_json_parse_hex_quad(value) {
                Result::Ok(value) => value,
                Result::Err(error) => return Result::Err(error),
            };
            if second < 56320 || second > 57343 {
                Result::Err(artifact_json_parse_error(value, "invalid low surrogate"))
            } else {
                artifact_json_write_codepoint(
                    value,
                    builder,
                    65536 + (first - 55296) * 1024 + second - 56320,
                )
            }
        }
    } else if first >= 56320 && first <= 57343 {
        Result::Err(artifact_json_parse_error(value, "unexpected low surrogate"))
    } else {
        artifact_json_write_codepoint(value, builder, first)
    }
}

fn artifact_json_parse_string(value: ArtifactJsonParser) -> Result[string, string] {
    if value.index.get() >= value.input.byte_len()
        || value.input.byte_get(value.index.get()) != 34
    {
        return Result::Err(artifact_json_parse_error(value, "expected string"))
    } else {
        value.index.set(value.index.get() + 1)
    };
    let builder = text::StringBuilder::new();
    let segment = Ref::new(value.index.get());
    while value.index.get() < value.input.byte_len() {
        let byte = value.input.byte_get(value.index.get());
        if byte == 34 {
            if segment.get() < value.index.get() {
                builder.write_string(value.input.byte_slice(segment.get(), value.index.get()))
            } else {
                ()
            };
            value.index.set(value.index.get() + 1);
            return Result::Ok(builder.finish())
        } else if byte == 92 {
            if segment.get() < value.index.get() {
                builder.write_string(value.input.byte_slice(segment.get(), value.index.get()))
            } else {
                ()
            };
            value.index.set(value.index.get() + 1);
            if value.index.get() >= value.input.byte_len() {
                return Result::Err(artifact_json_parse_error(value, "incomplete escape"))
            } else {
                ()
            };
            let escape = value.input.byte_get(value.index.get());
            value.index.set(value.index.get() + 1);
            if escape == 34 {
                builder.write_char('"')
            } else if escape == 92 {
                builder.write_char('\\')
            } else if escape == 47 {
                builder.write_char('/')
            } else if escape == 98 {
                match char_from_uint32(8) {
                    Option::Some(value) => builder.write_char(value),
                    Option::None => (),
                }
            } else if escape == 102 {
                match char_from_uint32(12) {
                    Option::Some(value) => builder.write_char(value),
                    Option::None => (),
                }
            } else if escape == 110 {
                builder.write_char('\n')
            } else if escape == 114 {
                builder.write_char('\r')
            } else if escape == 116 {
                builder.write_char('\t')
            } else if escape == 117 {
                match artifact_json_parse_unicode_escape(value, builder) {
                    Result::Ok(()) => (),
                    Result::Err(error) => return Result::Err(error),
                }
            } else {
                return Result::Err(artifact_json_parse_error(value, "invalid escape"))
            };
            segment.set(value.index.get())
        } else if byte < 32 {
            return Result::Err(artifact_json_parse_error(value, "unescaped control character"))
        } else {
            value.index.set(value.index.get() + 1)
        }
    };
    Result::Err(artifact_json_parse_error(value, "unterminated string"))
}

fn artifact_json_digit(byte: uint8) -> bool {
    byte >= 48 && byte <= 57
}

fn artifact_json_parse_digits(value: ArtifactJsonParser) -> bool {
    let start = value.index.get();
    while value.index.get() < value.input.byte_len()
        && artifact_json_digit(value.input.byte_get(value.index.get()))
    {
        value.index.set(value.index.get() + 1)
    };
    value.index.get() > start
}

fn artifact_json_parse_number(value: ArtifactJsonParser) -> Result[ArtifactJsonValue, string] {
    let start = value.index.get();
    if value.input.byte_get(value.index.get()) == 45 {
        value.index.set(value.index.get() + 1)
    } else {
        ()
    };
    if value.index.get() >= value.input.byte_len() {
        return Result::Err(artifact_json_parse_error(value, "incomplete number"))
    } else if value.input.byte_get(value.index.get()) == 48 {
        value.index.set(value.index.get() + 1);
        if value.index.get() < value.input.byte_len()
            && artifact_json_digit(value.input.byte_get(value.index.get()))
        {
            return Result::Err(artifact_json_parse_error(value, "invalid leading zero"))
        } else {
            ()
        }
    } else if !artifact_json_parse_digits(value) {
        return Result::Err(artifact_json_parse_error(value, "expected number"))
    } else {
        ()
    };
    if value.index.get() < value.input.byte_len()
        && value.input.byte_get(value.index.get()) == 46
    {
        value.index.set(value.index.get() + 1);
        if !artifact_json_parse_digits(value) {
            return Result::Err(artifact_json_parse_error(value, "missing fraction digits"))
        } else {
            ()
        }
    } else {
        ()
    };
    if value.index.get() < value.input.byte_len()
        && (value.input.byte_get(value.index.get()) == 101
            || value.input.byte_get(value.index.get()) == 69)
    {
        value.index.set(value.index.get() + 1);
        if value.index.get() < value.input.byte_len()
            && (value.input.byte_get(value.index.get()) == 43
                || value.input.byte_get(value.index.get()) == 45)
        {
            value.index.set(value.index.get() + 1)
        } else {
            ()
        };
        if !artifact_json_parse_digits(value) {
            return Result::Err(artifact_json_parse_error(value, "missing exponent digits"))
        } else {
            ()
        }
    } else {
        ()
    };
    Result::Ok(ArtifactJsonValue::Number(
        value.input.byte_slice(start, value.index.get()),
    ))
}

fn artifact_json_parse_literal(
    value: ArtifactJsonParser,
    expected: string,
    result: ArtifactJsonValue,
) -> Result[ArtifactJsonValue, string] {
    if value.index.get() + expected.byte_len() <= value.input.byte_len()
        && value.input.byte_slice(
            value.index.get(),
            value.index.get() + expected.byte_len(),
        ) == expected
    {
        value.index.set(value.index.get() + expected.byte_len());
        Result::Ok(result)
    } else {
        Result::Err(artifact_json_parse_error(value, "invalid literal"))
    }
}

fn artifact_json_parse_array(value: ArtifactJsonParser) -> Result[ArtifactJsonValue, string] {
    value.index.set(value.index.get() + 1);
    artifact_json_skip_whitespace(value);
    let result = Vec::new();
    if value.index.get() < value.input.byte_len()
        && value.input.byte_get(value.index.get()) == 93
    {
        value.index.set(value.index.get() + 1);
        return Result::Ok(ArtifactJsonValue::Array(result))
    } else {
        ()
    };
    while value.index.get() < value.input.byte_len() {
        match artifact_json_parse_value(value) {
            Result::Ok(item) => result.push(item),
            Result::Err(error) => return Result::Err(error),
        };
        artifact_json_skip_whitespace(value);
        if value.index.get() >= value.input.byte_len() {
            return Result::Err(artifact_json_parse_error(value, "unterminated array"))
        } else if value.input.byte_get(value.index.get()) == 93 {
            value.index.set(value.index.get() + 1);
            return Result::Ok(ArtifactJsonValue::Array(result))
        } else if value.input.byte_get(value.index.get()) == 44 {
            value.index.set(value.index.get() + 1);
            artifact_json_skip_whitespace(value)
        } else {
            return Result::Err(artifact_json_parse_error(value, "expected array separator"))
        }
    };
    Result::Err(artifact_json_parse_error(value, "unterminated array"))
}

fn artifact_json_parse_object(value: ArtifactJsonParser) -> Result[ArtifactJsonValue, string] {
    value.index.set(value.index.get() + 1);
    artifact_json_skip_whitespace(value);
    let result = Vec::new();
    if value.index.get() < value.input.byte_len()
        && value.input.byte_get(value.index.get()) == 125
    {
        value.index.set(value.index.get() + 1);
        return Result::Ok(ArtifactJsonValue::Object(result))
    } else {
        ()
    };
    while value.index.get() < value.input.byte_len() {
        let name = match artifact_json_parse_string(value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        artifact_json_skip_whitespace(value);
        if value.index.get() >= value.input.byte_len()
            || value.input.byte_get(value.index.get()) != 58
        {
            return Result::Err(artifact_json_parse_error(value, "expected object colon"))
        } else {
            value.index.set(value.index.get() + 1)
        };
        artifact_json_skip_whitespace(value);
        match artifact_json_parse_value(value) {
            Result::Ok(item) => result.push((name, item)),
            Result::Err(error) => return Result::Err(error),
        };
        artifact_json_skip_whitespace(value);
        if value.index.get() >= value.input.byte_len() {
            return Result::Err(artifact_json_parse_error(value, "unterminated object"))
        } else if value.input.byte_get(value.index.get()) == 125 {
            value.index.set(value.index.get() + 1);
            return Result::Ok(ArtifactJsonValue::Object(result))
        } else if value.input.byte_get(value.index.get()) == 44 {
            value.index.set(value.index.get() + 1);
            artifact_json_skip_whitespace(value)
        } else {
            return Result::Err(artifact_json_parse_error(value, "expected object separator"))
        }
    };
    Result::Err(artifact_json_parse_error(value, "unterminated object"))
}

fn artifact_json_parse_value(value: ArtifactJsonParser) -> Result[ArtifactJsonValue, string] {
    artifact_json_skip_whitespace(value);
    if value.index.get() >= value.input.byte_len() {
        Result::Err(artifact_json_parse_error(value, "expected JSON value"))
    } else {
        match value.input.byte_get(value.index.get()) {
            123 => artifact_json_parse_object(value),
            91 => artifact_json_parse_array(value),
            34 => match artifact_json_parse_string(value) {
                Result::Ok(value) => Result::Ok(ArtifactJsonValue::String(value)),
                Result::Err(error) => Result::Err(error),
            },
            116 => artifact_json_parse_literal(value, "true", ArtifactJsonValue::Bool(true)),
            102 => artifact_json_parse_literal(value, "false", ArtifactJsonValue::Bool(false)),
            110 => artifact_json_parse_literal(value, "null", ArtifactJsonValue::Null),
            byte => if byte == 45 || artifact_json_digit(byte) {
                artifact_json_parse_number(value)
            } else {
                Result::Err(artifact_json_parse_error(value, "unexpected JSON token"))
            },
        }
    }
}

fn parse_artifact_json(input: string) -> Result[ArtifactJsonValue, string] {
    let parser = new_artifact_json_parser(input);
    let result = match artifact_json_parse_value(parser) {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    artifact_json_skip_whitespace(parser);
    if parser.index.get() == input.byte_len() {
        Result::Ok(result)
    } else {
        Result::Err(artifact_json_parse_error(parser, "trailing JSON data"))
    }
}
