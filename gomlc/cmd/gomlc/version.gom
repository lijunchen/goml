package main;

use gomlc::version;
use std::env;
use std::io;
use std::process;

enum VersionFormat {
    Text,
    Json,
}

fn parse_version_format(value: string) -> Result[VersionFormat, string] {
    if value == "text" {
        Result::Ok(VersionFormat::Text)
    } else if value == "json" {
        Result::Ok(VersionFormat::Json)
    } else {
        Result::Err(invalid_value_error(value, "--format <FORMAT>", "text, json"))
    }
}

fn parse_version_args(args: Vec[string]) -> Result[VersionFormat, string] {
    let mut format: Option[string] = Option::None;
    let mut positional = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if !positional && argument == "--" {
            positional = true;
            index += 1;
        } else if !positional && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if !positional && option_string_present(inline_cli_value(argument, "--help")) {
            let value = match inline_cli_value(argument, "--help") {
                Some(value) => value,
                None => "",
            };
            return Result::Err(
                unexpected_value_error_with_usage(value, "--help", "gomlc version --help"),
            )
        } else if !positional && cli_value_option("version", argument) && index + 1 < args.len()
            && cli_option(args[index + 1])
            && !known_cli_option("version", args[index + 1]) {
            return Result::Err(
                unexpected_cli_option_error_with_usage(
                    "version",
                    args[index + 1],
                    command_usage("version"),
                ),
            )
        } else if !positional && argument == "--format" {
            if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(
                    value_required_error("--format <FORMAT>", Option::Some("text, json")),
                )
            } else if option_string_present(format) {
                return Result::Err(repeated_argument_error("version", "--format <FORMAT>"))
            } else {
                let value = args[index + 1];
                match parse_version_format(value) {
                    Ok(_) => {
                        format = Option::Some(value);
                        index += 2;
                    },
                    Err(error) => return Result::Err(error),
                }
            }
        } else if !positional && option_string_present(inline_cli_value(argument, "--format")) {
            if option_string_present(format) {
                return Result::Err(repeated_argument_error("version", "--format <FORMAT>"))
            } else {
                match inline_cli_value(argument, "--format") {
                    Some(value) => if value == "" {
                        return Result::Err(
                            value_required_error("--format <FORMAT>", Option::Some("text, json")),
                        )
                    } else {
                        match parse_version_format(value) {
                            Ok(_) => {
                                format = Option::Some(value);
                            },
                            Err(error) => return Result::Err(error),
                        }
                    },
                    None => (),
                };
                index += 1;
            }
        } else {
            if positional {
                return Result::Err(unexpected_argument_error("version", argument, false))
            } else {};
            match similar_cli_argument("version", argument) {
                Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(
                        argument,
                        similar,
                        similar_cli_argument_usage("version", similar),
                    ),
                ),
                None => return Result::Err(unexpected_argument_error("version", argument, false)),
            }
        }
    }
    match format {
        Some(value) => parse_version_format(value),
        None => Result::Ok(VersionFormat::Text),
    }
}

fn trim_version_value(value: string) -> string {
    let mut end = value.byte_len();
    while end > 0 && (value.byte_get(end - 1) == b'\n' || value.byte_get(end - 1) == b'\r') {
        end -= 1;
    }
    value.byte_slice(0, end)
}

fn git_version_value(args: Vec[string]) -> Option[string] {
    match process::Command::new("git").args(args).output() {
        Ok(output) => if output.status().success() {
            match output.stdout().to_string() {
                Ok(value) => {
                    let value = trim_version_value(value);
                    if value == "" {
                        Option::None
                    } else {
                        Option::Some(value)
                    }
                },
                Err(_) => Option::None,
            }
        } else {
            Option::None
        },
        Err(_) => Option::None,
    }
}

fn version_git_hash() -> Option[string] {
    match env::var("GOML_GIT_HASH") {
        Some(value) => Option::Some(value),
        None => git_version_value(Vec::["rev-parse", "--short=9", "HEAD"]),
    }
}

fn version_git_date() -> Option[string] {
    match env::var("GOML_GIT_DATE") {
        Some(value) => Option::Some(value),
        None => git_version_value(
            Vec::["show", "-s", "--date=format:%Y-%m-%d", "--format=%cd", "HEAD"],
        ),
    }
}

fn version_json_option(value: Option[string]) -> string {
    match value {
        Some(value) => "\"" + value + "\"",
        None => "null",
    }
}

fn version_output_with(format: VersionFormat, hash: Option[string], date: Option[string]) -> string {
    match format {
        Text => match (hash, date) {
            (Some(hash), Some(date)) => {
                "gomlc " + version::current() + " (" + hash + " " + date + ")"
            },
            _ => "gomlc " + version::current(),
        },
        Json => {
            "{\"artifact_format\":15,\"compiler_abi\":3,\"driver_protocol\":1,\"world_artifact\":1,\"git_date\":"
                + version_json_option(date)
                + ",\"git_hash\":"
                + version_json_option(hash)
                + ",\"tool\":\"gomlc\",\"version\":\""
                + version::current()
                + "\"}"
        },
    }
}

fn version_output(format: VersionFormat) -> string {
    version_output_with(format, version_git_hash(), version_git_date())
}

fn run_version(args: Vec[string]) -> unit {
    match parse_version_args(args) {
        Ok(format) => io::println(version_output(format)),
        Err(error) => handle_cli_parse_error("version", error),
    }
}
