package main;

use gomlc::tast;
use std::json;

fn artifact_intrinsic_key_from_id(value: string) -> Option[string] {
    match value {
        "primitive_eq" => Option::Some("eq.primitive"),
        "array_get" => Option::Some("array.get"),
        "array_set" => Option::Some("array.set"),
        "ref_new" => Option::Some("ref.new"),
        "ref_get" => Option::Some("ref.get"),
        "ref_set" => Option::Some("ref.set"),
        "ref_ptr_eq" => Option::Some("ref.ptr_eq"),
        "ref_ptr_hash" => Option::Some("ref.ptr_hash"),
        "vec_new" => Option::Some("vec.new"),
        "vec_with_capacity" => Option::Some("vec.with_capacity"),
        "vec_push" => Option::Some("vec.push"),
        "vec_get" => Option::Some("vec.get"),
        "vec_set" => Option::Some("vec.set"),
        "vec_len" => Option::Some("vec.len"),
        "vec_capacity" => Option::Some("vec.capacity"),
        "vec_reserve" => Option::Some("vec.reserve"),
        "vec_truncate" => Option::Some("vec.truncate"),
        "slice_new" => Option::Some("slice.new"),
        "slice_get" => Option::Some("slice.get"),
        "slice_len" => Option::Some("slice.len"),
        "slice_sub" => Option::Some("slice.sub"),
        "hash_map_new" | "hashmap_new" => Option::Some("hashmap.new"),
        "hash_map_get" | "hashmap_get" => Option::Some("hashmap.get"),
        "hash_map_set" | "hashmap_set" => Option::Some("hashmap.set"),
        "hash_map_remove" | "hashmap_remove" => Option::Some("hashmap.remove"),
        "hash_map_len" | "hashmap_len" => Option::Some("hashmap.len"),
        "hash_map_contains" | "hashmap_contains" => Option::Some("hashmap.contains"),
        "hash_map_entries" | "hashmap_entries" => Option::Some("hashmap.entries"),
        "channel_new" => Option::Some("channel.new"),
        "channel_send" => Option::Some("channel.send"),
        "channel_recv" => Option::Some("channel.recv"),
        "channel_close" => Option::Some("channel.close"),
        "missing" => Option::Some("compiler.missing"),
        _ => Option::None,
    }
}

fn artifact_runtime_key_from_id(value: string) -> Option[string] {
    match value {
        "std_env_args" => Option::Some("std.env.args"),
        "std_env_current_dir" => Option::Some("std.env.current_dir"),
        "std_env_current_exe" => Option::Some("std.env.current_exe"),
        "std_env_var" => Option::Some("std.env.var"),
        "std_fs_read_file" => Option::Some("std.fs.read_file"),
        "std_fs_write_file" => Option::Some("std.fs.write_file"),
        "std_fs_read_bytes" => Option::Some("std.fs.read_bytes"),
        "std_fs_write_bytes" => Option::Some("std.fs.write_bytes"),
        "std_fs_create_dir_all" => Option::Some("std.fs.create_dir_all"),
        "std_fs_remove_file" => Option::Some("std.fs.remove_file"),
        "std_fs_remove_dir_all" => Option::Some("std.fs.remove_dir_all"),
        "std_fs_file_exists" => Option::Some("std.fs.file_exists"),
        "std_fs_is_file" => Option::Some("std.fs.is_file"),
        "std_fs_is_dir" => Option::Some("std.fs.is_dir"),
        "std_fs_canonicalize" => Option::Some("std.fs.canonicalize"),
        "std_fs_read_dir" => Option::Some("std.fs.read_dir"),
        "std_fs_sha256_file" => Option::Some("std.fs.sha256_file"),
        "std_io_print" => Option::Some("std.io.print"),
        "std_io_println" => Option::Some("std.io.println"),
        "std_io_eprint" => Option::Some("std.io.eprint"),
        "std_io_read_stdin" => Option::Some("std.io.read_stdin"),
        "std_io_read_stdin_exact" => Option::Some("std.io.read_stdin_exact"),
        "std_io_write_stdout" => Option::Some("std.io.write_stdout"),
        "std_io_write_stderr" => Option::Some("std.io.write_stderr"),
        "std_path_join" => Option::Some("std.path.join"),
        "std_path_clean" => Option::Some("std.path.clean"),
        "std_path_is_absolute" => Option::Some("std.path.is_absolute"),
        "std_path_parent" => Option::Some("std.path.parent"),
        "std_path_file_name" => Option::Some("std.path.file_name"),
        "std_path_extension" => Option::Some("std.path.extension"),
        "std_path_file_stem" => Option::Some("std.path.file_stem"),
        "std_path_with_extension" => Option::Some("std.path.with_extension"),
        "std_path_absolute" => Option::Some("std.path.absolute"),
        "std_process_exit" => Option::Some("std.process.exit"),
        "std_process_look_path" => Option::Some("std.process.look_path"),
        "std_process_output" => Option::Some("std.process.output"),
        "std_process_output_timeout" => Option::Some("std.process.output_timeout"),
        "std_process_status" => Option::Some("std.process.status"),
        "std_process_status_timeout" => Option::Some("std.process.status_timeout"),
        "std_testing_fail" => Option::Some("std.testing.fail"),
        "unit_to_string"
        | "bool_to_string"
        | "string_len"
        | "string_get"
        | "string_byte_get"
        | "string_byte_slice"
        | "string_is_char_boundary"
        | "string_decode_utf8_at"
        | "string_to_bytes"
        | "string_from_utf8"
        | "string_concat"
        | "string_print"
        | "string_println"
        | "char_to_string"
        | "char_from_uint32"
        | "int_to_string"
        | "int8_to_string"
        | "int16_to_string"
        | "int32_to_string"
        | "int64_to_string"
        | "uint_to_string"
        | "uint8_to_string"
        | "uint16_to_string"
        | "uint32_to_string"
        | "uint64_to_string"
        | "float32_to_string"
        | "float64_to_string"
        | "string_parse_float32"
        | "string_parse_float64"
        | "int_hash"
        | "int8_hash"
        | "int16_hash"
        | "int32_hash"
        | "int64_hash"
        | "uint_hash"
        | "uint8_hash"
        | "uint16_hash"
        | "uint32_hash"
        | "float32_hash"
        | "float64_hash"
        | "string_hash"
        | "char_hash" => Option::Some("core." + value),
        _ => Option::None,
    }
}

fn artifact_decode_callable_body(
    name: string,
    value: json::Value,
) -> Result[tast::Callable, string] {
    let object = match artifact_json_object(value, "callable body") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let kind = match artifact_json_field_string(object, "kind") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    if kind == "goml" {
        Result::Ok(tast::Callable::Function(name))
    } else {
        let id = match artifact_json_field_string(object, "id") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        if kind == "intrinsic" {
            match artifact_intrinsic_key_from_id(id) {
                Option::Some(value) => Result::Ok(tast::Callable::Intrinsic(value)),
                Option::None => Result::Err(artifact_decode_error("intrinsic id")),
            }
        } else if kind == "runtime" {
            match artifact_runtime_key_from_id(id) {
                Option::Some(value) => Result::Ok(tast::Callable::Runtime(value)),
                Option::None => Result::Err(artifact_decode_error("runtime hook id")),
            }
        } else {
            Result::Err(artifact_decode_error("callable kind"))
        }
    }
}

fn artifact_decode_predicates(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[tast::TypePredicate], string] {
    let values = match artifact_json_array(value, "type predicates") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        match artifact_decode_predicate(context, value) {
            Result::Ok(value) => result.push(value),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_trait_refs(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[tast::TraitRef], string] {
    let values = match artifact_json_array(value, "trait references") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        match artifact_decode_trait_ref(context, value) {
            Result::Ok(value) => result.push(value),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_fn_scheme(
    context: ArtifactDecodeContext,
    name: string,
    value: json::Value,
) -> Result[ArtifactFnScheme, string] {
    let object = match artifact_json_object(value, "function scheme") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let type_params = match artifact_json_required_field(object, "type_params") {
        Result::Ok(value) => match artifact_decode_string_array(value, "type parameters") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let constraints = match artifact_json_required_field(object, "constraints") {
        Result::Ok(value) => match artifact_decode_predicates(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let ty = match artifact_json_required_field(object, "ty") {
        Result::Ok(value) => match artifact_decode_type(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let body = match artifact_json_optional_field(object, "body") {
        Result::Ok(Option::Some(value)) => match artifact_decode_callable_body(name, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Ok(Option::None) => tast::Callable::Function(name),
        Result::Err(error) => return Result::Err(error),
    };
    Result::Ok(ArtifactFnScheme {
        name,
        type_params,
        constraints,
        ty,
        body,
    })
}

fn artifact_decode_fn_map(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[ArtifactFnScheme], string] {
    let object = match artifact_json_object(value, "function map") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        match artifact_decode_fn_scheme(context, item.0, item.1) {
            Result::Ok(value) => result.push(value),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_type_pairs(
    context: ArtifactDecodeContext,
    value: json::Value,
    expected: string,
) -> Result[Vec[(string, tast::Type)], string] {
    let values = match artifact_json_array(value, expected) {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let pair = match artifact_json_array(value, expected) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error(expected))
        } else {
            ()
        };
        let name = match artifact_json_string_value(pair.get(0), expected) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        match artifact_decode_type(context, pair.get(1)) {
            Result::Ok(value) => result.push((name, value)),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_enum_variant_fields(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[tast::EnumVariantFields, string] {
    match value {
        json::Value::String(name) => if name == "Unit" {
            Result::Ok(tast::EnumVariantFields::Unit)
        } else {
            Result::Err(artifact_decode_error("enum variant fields"))
        },
        json::Value::Object(object) => if object.len() == 1 {
            let item = object.get(0);
            if item.0 == "Tuple" {
                match artifact_decode_type_array(context, item.1, "enum tuple fields") {
                    Result::Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Tuple(fields))
                    },
                    Result::Err(error) => Result::Err(error),
                }
            } else if item.0 == "Struct" {
                match artifact_decode_type_pairs(context, item.1, "enum struct fields") {
                    Result::Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Struct(fields))
                    },
                    Result::Err(error) => Result::Err(error),
                }
            } else {
                Result::Err(artifact_decode_error("enum variant fields"))
            }
        } else {
            Result::Err(artifact_decode_error("enum variant fields"))
        },
        _ => Result::Err(artifact_decode_error("enum variant fields")),
    }
}

fn artifact_decode_enum_def(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[tast::EnumDef, string] {
    let object = match artifact_json_object(value, "enum definition") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let name = match artifact_json_field_string(object, "name") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    artifact_add_type_name(context.enum_names, name);
    let generics = match artifact_json_required_field(object, "generics") {
        Result::Ok(value) => match artifact_decode_string_array(value, "enum generics") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let values = match artifact_json_field_array(object, "variants") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let variants = Vec::new();
    for value in values {
        let variant = match artifact_json_object(value, "enum variant") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        let variant_name = match artifact_json_field_string(variant, "name") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        let fields_value = match artifact_json_required_field(variant, "fields") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        let fields = match artifact_decode_enum_variant_fields(context, fields_value) {
            Result::Ok(fields) => fields,
            Result::Err(error) => return Result::Err(error),
        };
        variants.push(tast::EnumVariantDef {
            name: variant_name,
            fields,
        })
    };
    Result::Ok(tast::EnumDef {
        name,
        generics,
        variants,
    })
}

fn artifact_decode_struct_def(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[tast::StructDef, string] {
    let object = match artifact_json_object(value, "struct definition") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let name = match artifact_json_field_string(object, "name") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    artifact_add_type_name(context.struct_names, name);
    let generics = match artifact_json_required_field(object, "generics") {
        Result::Ok(value) => match artifact_decode_string_array(value, "struct generics") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let fields = match artifact_json_required_field(object, "fields") {
        Result::Ok(value) => match artifact_decode_type_pairs(context, value, "struct fields") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let public_fields = Vec::new();
    for field in fields {
        public_fields.push(field.0)
    };
    let has_hidden_fields = match artifact_json_required_field(object, "has_hidden_fields") {
        Result::Ok(value) => match artifact_json_bool_value(
            value,
            "struct hidden fields flag",
        ) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    Result::Ok(tast::StructDef {
        name,
        generics,
        fields,
        public_fields,
        has_hidden_fields,
    })
}

fn artifact_decode_associated_type_defs(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[ArtifactAssociatedTypeDef], string] {
    let object = match artifact_json_object(value, "associated type definitions") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        let definition = match artifact_json_object(item.1, "associated type definition") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        let bounds = match artifact_json_required_field(definition, "bounds") {
            Result::Ok(value) => match artifact_decode_trait_refs(context, value) {
                Result::Ok(value) => value,
                Result::Err(error) => return Result::Err(error),
            },
            Result::Err(error) => return Result::Err(error),
        };
        result.push(ArtifactAssociatedTypeDef {
            name: item.0,
            bounds,
        })
    };
    Result::Ok(result)
}

fn artifact_decode_trait_def(
    context: ArtifactDecodeContext,
    name: string,
    value: json::Value,
) -> Result[ArtifactTraitDef, string] {
    let object = match artifact_json_object(value, "trait definition") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let params = match artifact_json_required_field(object, "params") {
        Result::Ok(value) => match artifact_decode_string_array(value, "trait parameters") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let predicates = match artifact_json_required_field(object, "predicates") {
        Result::Ok(value) => match artifact_decode_predicates(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let supertraits = match artifact_json_required_field(object, "supertraits") {
        Result::Ok(value) => match artifact_decode_trait_refs(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let associated_types = match artifact_json_required_field(object, "associated_types") {
        Result::Ok(value) => match artifact_decode_associated_type_defs(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let methods = match artifact_json_required_field(object, "methods") {
        Result::Ok(value) => match artifact_decode_fn_map(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    Result::Ok(ArtifactTraitDef {
        name,
        params,
        predicates,
        supertraits,
        associated_types,
        methods,
    })
}

fn artifact_decode_associated_types(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[(string, tast::Type)], string] {
    let object = match artifact_json_object(value, "associated types") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        match artifact_decode_type(context, item.1) {
            Result::Ok(value) => result.push((item.0, value)),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_impl_def(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[ArtifactImplDef, string] {
    let object = match artifact_json_object(value, "implementation definition") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let params = match artifact_json_required_field(object, "params") {
        Result::Ok(value) => match artifact_decode_string_array(value, "implementation parameters") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let constraints = match artifact_json_required_field(object, "constraints") {
        Result::Ok(value) => match artifact_decode_predicates(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let associated_types = match artifact_json_required_field(object, "associated_types") {
        Result::Ok(value) => match artifact_decode_associated_types(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let methods = match artifact_json_required_field(object, "methods") {
        Result::Ok(value) => match artifact_decode_fn_map(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let valid = match artifact_json_optional_field(object, "valid") {
        Result::Ok(Option::Some(value)) => match artifact_json_bool_value(
            value,
            "implementation validity",
        ) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Ok(Option::None) => true,
        Result::Err(error) => return Result::Err(error),
    };
    Result::Ok(ArtifactImplDef {
        params,
        constraints,
        associated_types,
        methods,
        valid,
    })
}

fn artifact_decode_trait_impls(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[ArtifactTraitImpl], string] {
    let values = match artifact_json_array(value, "trait implementations") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let pair = match artifact_json_array(value, "trait implementation") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("trait implementation pair"))
        } else {
            ()
        };
        let key = match artifact_json_object(pair.get(0), "trait implementation key") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        let trait_ref = match artifact_json_required_field(key, "trait_ref") {
            Result::Ok(value) => match artifact_decode_trait_ref(context, value) {
                Result::Ok(value) => value,
                Result::Err(error) => return Result::Err(error),
            },
            Result::Err(error) => return Result::Err(error),
        };
        let for_ty = match artifact_json_required_field(key, "for_ty") {
            Result::Ok(value) => match artifact_decode_type(context, value) {
                Result::Ok(value) => value,
                Result::Err(error) => return Result::Err(error),
            },
            Result::Err(error) => return Result::Err(error),
        };
        let definition = match artifact_decode_impl_def(context, pair.get(1)) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        result.push(ArtifactTraitImpl {
            trait_ref,
            for_ty,
            definition,
        })
    };
    Result::Ok(result)
}

fn artifact_decode_inherent_impl_key(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[ArtifactInherentImplKey, string] {
    let object = match artifact_json_object(value, "inherent implementation key") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    if object.len() != 1 {
        Result::Err(artifact_decode_error("inherent implementation key variant"))
    } else if object.get(0).0 == "Exact" {
        match artifact_decode_type(context, object.get(0).1) {
            Result::Ok(value) => Result::Ok(ArtifactInherentImplKey::Exact(value)),
            Result::Err(error) => Result::Err(error),
        }
    } else if object.get(0).0 == "Constr" {
        match artifact_json_string_value(object.get(0).1, "inherent constructor") {
            Result::Ok(value) => Result::Ok(ArtifactInherentImplKey::Constr(value)),
            Result::Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_decode_error("inherent implementation key"))
    }
}

fn artifact_decode_inherent_impls(
    context: ArtifactDecodeContext,
    value: json::Value,
) -> Result[Vec[ArtifactInherentImpl], string] {
    let values = match artifact_json_array(value, "inherent implementations") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let pair = match artifact_json_array(value, "inherent implementation") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("inherent implementation pair"))
        } else {
            ()
        };
        let key = match artifact_decode_inherent_impl_key(context, pair.get(0)) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        let definition = match artifact_decode_impl_def(context, pair.get(1)) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        result.push(ArtifactInherentImpl { key, definition })
    };
    Result::Ok(result)
}

fn artifact_decode_package_exports(
    value: json::Value,
) -> Result[ArtifactPackageExports, string] {
    let context = new_artifact_decode_context();
    let object = match artifact_json_object(value, "package exports") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let type_env = match artifact_json_field_object(object, "type_env") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let enum_map = match artifact_json_field_object(type_env, "enums") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let struct_map = match artifact_json_field_object(type_env, "structs") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    for item in enum_map {
        artifact_add_type_name(context.enum_names, item.0)
    };
    for item in struct_map {
        artifact_add_type_name(context.struct_names, item.0)
    };
    let enums = Vec::new();
    for item in enum_map {
        match artifact_decode_enum_def(context, item.1) {
            Result::Ok(value) => if value.name == item.0 {
                enums.push(value)
            } else {
                return Result::Err(artifact_decode_error("matching enum name"))
            },
            Result::Err(error) => return Result::Err(error),
        }
    };
    let structs = Vec::new();
    for item in struct_map {
        match artifact_decode_struct_def(context, item.1) {
            Result::Ok(value) => if value.name == item.0 {
                structs.push(value)
            } else {
                return Result::Err(artifact_decode_error("matching struct name"))
            },
            Result::Err(error) => return Result::Err(error),
        }
    };
    let trait_env = match artifact_json_field_object(object, "trait_env") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let trait_map = match artifact_json_field_object(trait_env, "trait_defs") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let traits = Vec::new();
    for item in trait_map {
        match artifact_decode_trait_def(context, item.0, item.1) {
            Result::Ok(value) => traits.push(value),
            Result::Err(error) => return Result::Err(error),
        }
    };
    let trait_impls = match artifact_json_required_field(trait_env, "trait_impls") {
        Result::Ok(value) => match artifact_decode_trait_impls(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let inherent_impls = match artifact_json_required_field(trait_env, "inherent_impls") {
        Result::Ok(value) => match artifact_decode_inherent_impls(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let value_env = match artifact_json_field_object(object, "value_env") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let functions = match artifact_json_required_field(value_env, "funcs") {
        Result::Ok(value) => match artifact_decode_fn_map(context, value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    Result::Ok(ArtifactPackageExports {
        enum_type_names: context.enum_names,
        struct_type_names: context.struct_names,
        enums,
        structs,
        traits,
        trait_impls,
        inherent_impls,
        functions,
    })
}

fn artifact_decode_package_interface(
    value: json::Value,
) -> Result[ArtifactPackageInterface, string] {
    let object = match artifact_json_object(value, "package interface") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let package_name = match artifact_json_field_string(object, "package") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let name = match artifact_json_field_string(object, "name") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let value_map = match artifact_json_field_object(object, "value_exports") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let value_exports = Vec::new();
    for item in value_map {
        let number = match artifact_json_number_value(item.1, "value export index") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        };
        match artifact_parse_nonnegative_int(number) {
            Result::Ok(value) => value_exports.push((item.0, value)),
            Result::Err(error) => return Result::Err(error),
        }
    };
    let enum_map = match artifact_json_field_object(object, "enum_variants") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let enum_variants = Vec::new();
    for item in enum_map {
        match artifact_decode_string_array(item.1, "enum variant names") {
            Result::Ok(value) => enum_variants.push((item.0, value)),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(ArtifactPackageInterface {
        package_name,
        name,
        value_exports,
        enum_variants,
    })
}

fn artifact_decode_string_map(
    value: json::Value,
    expected: string,
) -> Result[Vec[(string, string)], string] {
    let object = match artifact_json_object(value, expected) {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        match artifact_json_string_value(item.1, expected) {
            Result::Ok(value) => result.push((item.0, value)),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_version_field(
    object: Vec[(string, json::Value)],
    name: string,
    expected: int,
) -> Result[unit, string] {
    let number = match artifact_json_required_field(object, name) {
        Result::Ok(value) => match artifact_json_number_value(value, name) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    match artifact_parse_nonnegative_int(number) {
        Result::Ok(value) => if value == expected {
            Result::Ok(())
        } else {
            Result::Err(artifact_decode_error(name + " " + expected.to_string()))
        },
        Result::Err(error) => Result::Err(error),
    }
}

fn artifact_decode_interface_value(
    value: json::Value,
) -> Result[ArtifactInterfaceUnit, string] {
    let object = match artifact_json_object(value, "interface unit") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    match artifact_decode_version_field(object, "format_version", 16) {
        Result::Ok(()) => (),
        Result::Err(error) => return Result::Err(error),
    };
    match artifact_decode_version_field(object, "compiler_abi", 3) {
        Result::Ok(()) => (),
        Result::Err(error) => return Result::Err(error),
    };
    let package_name = match artifact_json_field_string(object, "package") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let exports = match artifact_json_required_field(object, "exports") {
        Result::Ok(value) => match artifact_decode_package_exports(value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let package_interface = match artifact_json_required_field(object, "interface") {
        Result::Ok(value) => match artifact_decode_package_interface(value) {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let deps = match artifact_json_required_field(object, "deps") {
        Result::Ok(value) => match artifact_decode_string_map(value, "dependency hashes") {
            Result::Ok(value) => value,
            Result::Err(error) => return Result::Err(error),
        },
        Result::Err(error) => return Result::Err(error),
    };
    let interface_hash = match artifact_json_field_string(object, "interface_hash") {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    let result = ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(artifact_decode_error("matching interface package"))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(artifact_decode_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}

fn decode_artifact_interface_unit(input: string) -> Result[ArtifactInterfaceUnit, string] {
    match json::parse(input) {
        Result::Ok(value) => artifact_decode_interface_value(value),
        Result::Err(error) => Result::Err(error),
    }
}
