package main;

use gomlc::artifact_model;

use gomlc::tast;

fn artifact_intrinsic_key_from_id(value: string) -> Option[string] {
    match value {
        "primitive_eq" => Option::Some("eq.primitive"),
        "array_get" => Option::Some("array.get"),
        "array_set" => Option::Some("array.set"),
        "ref_new" => Option::Some("ref.new"),
        "ref_get" => Option::Some("ref.get"),
        "ref_set" => Option::Some("ref.set"),
        "ref_ptr_eq" => Option::Some("ref.ptr_eq"),
        "ref_ptr_hash" => Option::Some("ref.ptr_hash"),
        "vec_new" => Option::Some("vec.new"),
        "vec_with_capacity" => Option::Some("vec.with_capacity"),
        "vec_push" => Option::Some("vec.push"),
        "vec_get" => Option::Some("vec.get"),
        "vec_set" => Option::Some("vec.set"),
        "vec_len" => Option::Some("vec.len"),
        "vec_capacity" => Option::Some("vec.capacity"),
        "vec_reserve" => Option::Some("vec.reserve"),
        "vec_truncate" => Option::Some("vec.truncate"),
        "slice_new" => Option::Some("slice.new"),
        "slice_get" => Option::Some("slice.get"),
        "slice_len" => Option::Some("slice.len"),
        "slice_sub" => Option::Some("slice.sub"),
        "hash_map_new" | "hashmap_new" => Option::Some("hashmap.new"),
        "hash_map_get" | "hashmap_get" => Option::Some("hashmap.get"),
        "hash_map_set" | "hashmap_set" => Option::Some("hashmap.set"),
        "hash_map_remove" | "hashmap_remove" => Option::Some("hashmap.remove"),
        "hash_map_len" | "hashmap_len" => Option::Some("hashmap.len"),
        "hash_map_contains" | "hashmap_contains" => Option::Some("hashmap.contains"),
        "hash_map_entries" | "hashmap_entries" => Option::Some("hashmap.entries"),
        "channel_new" => Option::Some("channel.new"),
        "channel_send" => Option::Some("channel.send"),
        "channel_recv" => Option::Some("channel.recv"),
        "channel_close" => Option::Some("channel.close"),
        "missing" => Option::Some("compiler.missing"),
        _ => Option::None,
    }
}

fn artifact_runtime_key_from_id(value: string) -> Option[string] {
    match value {
        "std_env_args" => Option::Some("std.env.args"),
        "std_env_current_dir" => Option::Some("std.env.current_dir"),
        "std_env_current_exe" => Option::Some("std.env.current_exe"),
        "std_env_var" => Option::Some("std.env.var"),
        "std_fs_read_file" => Option::Some("std.fs.read_file"),
        "std_fs_write_file" => Option::Some("std.fs.write_file"),
        "std_fs_read_bytes" => Option::Some("std.fs.read_bytes"),
        "std_fs_write_bytes" => Option::Some("std.fs.write_bytes"),
        "std_fs_create_dir_all" => Option::Some("std.fs.create_dir_all"),
        "std_fs_remove_file" => Option::Some("std.fs.remove_file"),
        "std_fs_remove_dir_all" => Option::Some("std.fs.remove_dir_all"),
        "std_fs_file_exists" => Option::Some("std.fs.file_exists"),
        "std_fs_is_file" => Option::Some("std.fs.is_file"),
        "std_fs_is_dir" => Option::Some("std.fs.is_dir"),
        "std_fs_canonicalize" => Option::Some("std.fs.canonicalize"),
        "std_fs_read_dir" => Option::Some("std.fs.read_dir"),
        "std_fs_sha256_file" => Option::Some("std.fs.sha256_file"),
        "std_io_print" => Option::Some("std.io.print"),
        "std_io_println" => Option::Some("std.io.println"),
        "std_io_eprint" => Option::Some("std.io.eprint"),
        "std_io_read_stdin" => Option::Some("std.io.read_stdin"),
        "std_io_read_stdin_exact" => Option::Some("std.io.read_stdin_exact"),
        "std_io_write_stdout" => Option::Some("std.io.write_stdout"),
        "std_io_write_stderr" => Option::Some("std.io.write_stderr"),
        "std_path_join" => Option::Some("std.path.join"),
        "std_path_clean" => Option::Some("std.path.clean"),
        "std_path_is_absolute" => Option::Some("std.path.is_absolute"),
        "std_path_parent" => Option::Some("std.path.parent"),
        "std_path_file_name" => Option::Some("std.path.file_name"),
        "std_path_extension" => Option::Some("std.path.extension"),
        "std_path_file_stem" => Option::Some("std.path.file_stem"),
        "std_path_with_extension" => Option::Some("std.path.with_extension"),
        "std_path_absolute" => Option::Some("std.path.absolute"),
        "std_process_exit" => Option::Some("std.process.exit"),
        "std_process_look_path" => Option::Some("std.process.look_path"),
        "std_process_output" => Option::Some("std.process.output"),
        "std_process_output_timeout" => Option::Some("std.process.output_timeout"),
        "std_process_status" => Option::Some("std.process.status"),
        "std_process_status_timeout" => Option::Some("std.process.status_timeout"),
        "std_testing_fail" => Option::Some("std.testing.fail"),
        "std_num_parse_int" => Option::Some("std.num.parse_int"),
        "std_num_parse_uint" => Option::Some("std.num.parse_uint"),
        "std_num_parse_float32" => Option::Some("std.num.parse_float32"),
        "std_num_parse_float64" => Option::Some("std.num.parse_float64"),
        "std_time_monotonic_nanoseconds" => Option::Some("std.time.monotonic_nanoseconds"),
        "std_time_unix_nanoseconds" => Option::Some("std.time.unix_nanoseconds"),
        "std_time_sleep_nanoseconds" => Option::Some("std.time.sleep_nanoseconds"),
        "unit_to_string" | "bool_to_string" | "string_len" | "string_get" | "string_byte_get" | "string_byte_slice" | "string_is_char_boundary" | "string_decode_utf8_at" | "string_to_bytes" | "string_from_utf8" | "string_concat" | "string_print" | "string_println" | "char_to_string" | "char_from_uint32" | "int_to_string" | "int8_to_string" | "int16_to_string" | "int32_to_string" | "int64_to_string" | "uint_to_string" | "uint8_to_string" | "uint16_to_string" | "uint32_to_string" | "uint64_to_string" | "float32_to_string" | "float64_to_string" | "string_parse_float32" | "string_parse_float64" | "int_hash" | "int8_hash" | "int16_hash" | "int32_hash" | "int64_hash" | "uint_hash" | "uint8_hash" | "uint16_hash" | "uint32_hash" | "float32_hash" | "float64_hash" | "string_hash" | "char_hash" => Option::Some(
            "core." + value,
        ),
        _ => Option::None,
    }
}

fn artifact_decode_callable_body(name: string, value: ArtifactValue) -> Result[
    tast::Callable,
    string,
] {
    let object = artifact_json_object(value, "callable body")?;
    let kind = artifact_json_field_string(object, "kind")?;
    if kind == "goml" {
        Result::Ok(tast::Callable::Function(name))
    } else {
        let id = artifact_json_field_string(object, "id")?;
        if kind == "intrinsic" {
            match artifact_intrinsic_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Intrinsic(value)),
                None => Result::Err(artifact_decode_error("intrinsic id")),
            }
        } else if kind == "runtime" {
            match artifact_runtime_key_from_id(id) {
                Some(value) => Result::Ok(tast::Callable::Runtime(value)),
                None => Result::Err(artifact_decode_error("runtime hook id")),
            }
        } else {
            Result::Err(artifact_decode_error("callable kind"))
        }
    }
}

fn artifact_decode_predicates(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[tast::TypePredicate],
    string,
] {
    let values = artifact_json_array(value, "type predicates")?;
    let result: Vec[tast::TypePredicate] = Vec::[];
    for value in values {
        result.push(artifact_decode_predicate(context, value)?)
    };
    Result::Ok(result)
}

fn artifact_decode_trait_refs(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[tast::TraitRef],
    string,
] {
    let values = artifact_json_array(value, "trait references")?;
    let result: Vec[tast::TraitRef] = Vec::[];
    for value in values {
        result.push(artifact_decode_trait_ref(context, value)?)
    };
    Result::Ok(result)
}

fn artifact_decode_fn_scheme(context: ArtifactDecodeContext, name: string, value: ArtifactValue) -> Result[
    artifact_model::ArtifactFnScheme,
    string,
] {
    let object = artifact_json_object(value, "function scheme")?;
    let type_params = artifact_decode_string_array(
        artifact_json_required_field(object, "type_params")?,
        "type parameters",
    )?;
    let constraints = artifact_decode_predicates(
        context,
        artifact_json_required_field(object, "constraints")?,
    )?;
    let ty = artifact_decode_type(context, artifact_json_required_field(object, "ty")?)?;
    let body = match artifact_json_optional_field(object, "body")? {
        Some(value) => artifact_decode_callable_body(name, value)?,
        None => tast::Callable::Function(name),
    };
    Result::Ok(artifact_model::ArtifactFnScheme { name, type_params, constraints, ty, body })
}

fn artifact_decode_fn_map(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactFnScheme],
    string,
] {
    let object = artifact_json_object(value, "function map")?;
    let result: Vec[artifact_model::ArtifactFnScheme] = Vec::[];
    for item in object {
        result.push(artifact_decode_fn_scheme(context, item.0, item.1)?)
    };
    Result::Ok(result)
}

fn artifact_decode_type_pairs(
    context: ArtifactDecodeContext,
    value: ArtifactValue,
    expected: string,
) -> Result[Vec[(string, tast::Type)], string] {
    let values = artifact_json_array(value, expected)?;
    let result: Vec[(string, tast::Type)] = Vec::[];
    for value in values {
        let pair = artifact_json_array(value, expected)?;
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error(expected))
        } else {
            ()
        };
        let name = artifact_json_string_value(pair[0], expected)?;
        result.push((name, artifact_decode_type(context, pair[1])?))
    };
    Result::Ok(result)
}

fn artifact_decode_enum_variant_fields(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    tast::EnumVariantFields,
    string,
] {
    match value {
        String(name) => if name == "Unit" {
            Result::Ok(tast::EnumVariantFields::Unit)
        } else {
            Result::Err(artifact_decode_error("enum variant fields"))
        },
        Object(object) => if object.len() == 1 {
            let item = object[0];
            if item.0 == "Tuple" {
                match artifact_decode_type_array(context, item.1, "enum tuple fields") {
                    Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Tuple(fields))
                    },
                    Err(error) => Result::Err(error),
                }
            } else if item.0 == "Struct" {
                match artifact_decode_type_pairs(context, item.1, "enum struct fields") {
                    Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Struct(fields))
                    },
                    Err(error) => Result::Err(error),
                }
            } else {
                Result::Err(artifact_decode_error("enum variant fields"))
            }
        } else {
            Result::Err(artifact_decode_error("enum variant fields"))
        },
        _ => Result::Err(artifact_decode_error("enum variant fields")),
    }
}

fn artifact_decode_enum_def(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    tast::EnumDef,
    string,
] {
    let object = artifact_json_object(value, "enum definition")?;
    let name = artifact_json_field_string(object, "name")?;
    artifact_add_type_name(context.enum_names, name);
    let generics = artifact_decode_string_array(
        artifact_json_required_field(object, "generics")?,
        "enum generics",
    )?;
    let values = artifact_json_field_array(object, "variants")?;
    let variants: Vec[tast::EnumVariantDef] = Vec::[];
    for value in values {
        let variant = artifact_json_object(value, "enum variant")?;
        let variant_name = artifact_json_field_string(variant, "name")?;
        let fields_value = artifact_json_required_field(variant, "fields")?;
        let fields = artifact_decode_enum_variant_fields(context, fields_value)?;
        variants.push(tast::EnumVariantDef { name: variant_name, fields })
    };
    Result::Ok(tast::EnumDef { name, generics, variants })
}

fn artifact_decode_struct_def(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    tast::StructDef,
    string,
] {
    let object = artifact_json_object(value, "struct definition")?;
    let name = artifact_json_field_string(object, "name")?;
    artifact_add_type_name(context.struct_names, name);
    let generics = artifact_decode_string_array(
        artifact_json_required_field(object, "generics")?,
        "struct generics",
    )?;
    let fields = artifact_decode_type_pairs(
        context,
        artifact_json_required_field(object, "fields")?,
        "struct fields",
    )?;
    let public_fields: Vec[string] = Vec::[];
    for field in fields {
        public_fields.push(field.0)
    };
    let has_hidden_fields = artifact_json_bool_value(
        artifact_json_required_field(object, "has_hidden_fields")?,
        "struct hidden fields flag",
    )?;
    Result::Ok(tast::StructDef { name, generics, fields, public_fields, has_hidden_fields })
}

fn artifact_decode_type_alias(context: ArtifactDecodeContext, name: string, value: ArtifactValue) -> Result[
    tast::TypeAliasInfo,
    string,
] {
    let object = artifact_json_object(value, "type alias")?;
    let generics = artifact_decode_string_array(
        artifact_json_required_field(object, "generics")?,
        "type alias generics",
    )?;
    let ty = artifact_decode_type(context, artifact_json_required_field(object, "ty")?)?;
    Result::Ok(tast::TypeAliasInfo { name, generics, ty })
}

fn artifact_decode_associated_type_defs(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactAssociatedTypeDef],
    string,
] {
    let object = artifact_json_object(value, "associated type definitions")?;
    let result: Vec[artifact_model::ArtifactAssociatedTypeDef] = Vec::[];
    for item in object {
        let definition = artifact_json_object(item.1, "associated type definition")?;
        let bounds = artifact_decode_trait_refs(
            context,
            artifact_json_required_field(definition, "bounds")?,
        )?;
        result.push(artifact_model::ArtifactAssociatedTypeDef { name: item.0, bounds })
    };
    Result::Ok(result)
}

fn artifact_decode_trait_def(context: ArtifactDecodeContext, name: string, value: ArtifactValue) -> Result[
    artifact_model::ArtifactTraitDef,
    string,
] {
    let object = artifact_json_object(value, "trait definition")?;
    let params = artifact_decode_string_array(
        artifact_json_required_field(object, "params")?,
        "trait parameters",
    )?;
    let predicates = artifact_decode_predicates(
        context,
        artifact_json_required_field(object, "predicates")?,
    )?;
    let supertraits = artifact_decode_trait_refs(
        context,
        artifact_json_required_field(object, "supertraits")?,
    )?;
    let associated_types = artifact_decode_associated_type_defs(
        context,
        artifact_json_required_field(object, "associated_types")?,
    )?;
    let methods = artifact_decode_fn_map(context, artifact_json_required_field(object, "methods")?)?;
    Result::Ok(
        artifact_model::ArtifactTraitDef { name, params, predicates, supertraits, associated_types, methods },
    )
}

fn artifact_decode_associated_types(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[(string, tast::Type)],
    string,
] {
    let object = artifact_json_object(value, "associated types")?;
    let result: Vec[(string, tast::Type)] = Vec::[];
    for item in object {
        result.push((item.0, artifact_decode_type(context, item.1)?))
    };
    Result::Ok(result)
}

fn artifact_decode_impl_def(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    artifact_model::ArtifactImplDef,
    string,
] {
    let object = artifact_json_object(value, "implementation definition")?;
    let params = artifact_decode_string_array(
        artifact_json_required_field(object, "params")?,
        "implementation parameters",
    )?;
    let constraints = artifact_decode_predicates(
        context,
        artifact_json_required_field(object, "constraints")?,
    )?;
    let associated_types = artifact_decode_associated_types(
        context,
        artifact_json_required_field(object, "associated_types")?,
    )?;
    let methods = artifact_decode_fn_map(context, artifact_json_required_field(object, "methods")?)?;
    let valid = match artifact_json_optional_field(object, "valid")? {
        Some(value) => artifact_json_bool_value(value, "implementation validity")?,
        None => true,
    };
    Result::Ok(artifact_model::ArtifactImplDef { params, constraints, associated_types, methods, valid })
}

fn artifact_decode_trait_impls(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactTraitImpl],
    string,
] {
    let values = artifact_json_array(value, "trait implementations")?;
    let result: Vec[artifact_model::ArtifactTraitImpl] = Vec::[];
    for value in values {
        let pair = artifact_json_array(value, "trait implementation")?;
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("trait implementation pair"))
        } else {
            ()
        };
        let key = artifact_json_object(pair[0], "trait implementation key")?;
        let trait_ref = artifact_decode_trait_ref(
            context,
            artifact_json_required_field(key, "trait_ref")?,
        )?;
        let for_ty = artifact_decode_type(context, artifact_json_required_field(key, "for_ty")?)?;
        let definition = artifact_decode_impl_def(context, pair[1])?;
        result.push(artifact_model::ArtifactTraitImpl { trait_ref, for_ty, definition })
    };
    Result::Ok(result)
}

fn artifact_decode_inherent_impl_key(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    artifact_model::ArtifactInherentImplKey,
    string,
] {
    let object = artifact_json_object(value, "inherent implementation key")?;
    if object.len() != 1 {
        Result::Err(artifact_decode_error("inherent implementation key variant"))
    } else if object[0].0 == "Exact" {
        match artifact_decode_type(context, object[0].1) {
            Ok(value) => Result::Ok(artifact_model::ArtifactInherentImplKey::Exact(value)),
            Err(error) => Result::Err(error),
        }
    } else if object[0].0 == "Constr" {
        match artifact_json_string_value(object[0].1, "inherent constructor") {
            Ok(value) => Result::Ok(artifact_model::ArtifactInherentImplKey::Constr(value)),
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_decode_error("inherent implementation key"))
    }
}

fn artifact_decode_inherent_impls(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactInherentImpl],
    string,
] {
    let values = artifact_json_array(value, "inherent implementations")?;
    let result: Vec[artifact_model::ArtifactInherentImpl] = Vec::[];
    for value in values {
        let pair = artifact_json_array(value, "inherent implementation")?;
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("inherent implementation pair"))
        } else {
            ()
        };
        let key = artifact_decode_inherent_impl_key(context, pair[0])?;
        let definition = artifact_decode_impl_def(context, pair[1])?;
        result.push(artifact_model::ArtifactInherentImpl { key, definition })
    };
    Result::Ok(result)
}

fn artifact_decode_package_exports(value: ArtifactValue) -> Result[artifact_model::ArtifactPackageExports, string] {
    let context = new_artifact_decode_context();
    let object = artifact_json_object(value, "package exports")?;
    let type_env = artifact_json_field_object(object, "type_env")?;
    let enum_map = artifact_json_field_object(type_env, "enums")?;
    let struct_map = artifact_json_field_object(type_env, "structs")?;
    for item in enum_map {
        artifact_add_type_name(context.enum_names, item.0)
    };
    for item in struct_map {
        artifact_add_type_name(context.struct_names, item.0)
    };
    let enums: Vec[tast::EnumDef] = Vec::[];
    for item in enum_map {
        let value = artifact_decode_enum_def(context, item.1)?;
        if value.name == item.0 {
            enums.push(value)
        } else {
            return Result::Err(artifact_decode_error("matching enum name"))
        }
    };
    let structs: Vec[tast::StructDef] = Vec::[];
    for item in struct_map {
        let value = artifact_decode_struct_def(context, item.1)?;
        if value.name == item.0 {
            structs.push(value)
        } else {
            return Result::Err(artifact_decode_error("matching struct name"))
        }
    };
    let alias_map = artifact_json_field_object(type_env, "aliases")?;
    let type_aliases: Vec[tast::TypeAliasInfo] = Vec::[];
    for item in alias_map {
        type_aliases.push(artifact_decode_type_alias(context, item.0, item.1)?)
    };
    let trait_env = artifact_json_field_object(object, "trait_env")?;
    let trait_map = artifact_json_field_object(trait_env, "trait_defs")?;
    let traits: Vec[artifact_model::ArtifactTraitDef] = Vec::[];
    for item in trait_map {
        traits.push(artifact_decode_trait_def(context, item.0, item.1)?)
    };
    let trait_impls = artifact_decode_trait_impls(
        context,
        artifact_json_required_field(trait_env, "trait_impls")?,
    )?;
    let inherent_impls = artifact_decode_inherent_impls(
        context,
        artifact_json_required_field(trait_env, "inherent_impls")?,
    )?;
    let value_env = artifact_json_field_object(object, "value_env")?;
    let functions = artifact_decode_fn_map(
        context,
        artifact_json_required_field(value_env, "funcs")?,
    )?;
    let constant_map = artifact_json_field_object(value_env, "consts")?;
    let constants: Vec[tast::ConstantScheme] = Vec::[];
    for item in constant_map {
        let definition = artifact_json_object(item.1, "constant scheme")?;
        let ty = artifact_decode_type(context, artifact_json_required_field(definition, "ty")?)?;
        constants.push(tast::ConstantScheme { def_id: Option::None, name: item.0, ty })
    };
    Result::Ok(
        artifact_model::ArtifactPackageExports {
            enum_type_names: context.enum_names,
            struct_type_names: context.struct_names,
            type_aliases,
            enums,
            structs,
            traits,
            trait_impls,
            inherent_impls,
            functions,
            constants,
        },
    )
}

fn artifact_decode_package_interface(value: ArtifactValue) -> Result[
    artifact_model::ArtifactPackageInterface,
    string,
] {
    let object = artifact_json_object(value, "package interface")?;
    let package_name = artifact_json_field_string(object, "package")?;
    let name = artifact_json_field_string(object, "name")?;
    let value_map = artifact_json_field_object(object, "value_exports")?;
    let value_exports: Vec[(string, int)] = Vec::[];
    for item in value_map {
        let number = artifact_json_number_value(item.1, "value export index")?;
        value_exports.push((item.0, artifact_parse_nonnegative_int(number)?))
    };
    let enum_map = artifact_json_field_object(object, "enum_variants")?;
    let enum_variants: Vec[(string, Vec[string])] = Vec::[];
    for item in enum_map {
        enum_variants.push((item.0, artifact_decode_string_array(item.1, "enum variant names")?))
    };
    Result::Ok(artifact_model::ArtifactPackageInterface { package_name, name, value_exports, enum_variants })
}

fn artifact_decode_string_map(value: ArtifactValue, expected: string) -> Result[
    Vec[(string, string)],
    string,
] {
    let object = artifact_json_object(value, expected)?;
    let result: Vec[(string, string)] = Vec::[];
    for item in object {
        result.push((item.0, artifact_json_string_value(item.1, expected)?))
    };
    Result::Ok(result)
}

fn artifact_decode_interface_value(value: ArtifactValue) -> Result[artifact_model::ArtifactInterfaceUnit, string] {
    let object = artifact_json_object(value, "interface unit")?;
    let package_name = artifact_json_field_string(object, "package")?;
    let exports = artifact_decode_package_exports(artifact_json_required_field(object, "exports")?)?;
    let package_interface = artifact_decode_package_interface(
        artifact_json_required_field(object, "interface")?,
    )?;
    let deps = artifact_decode_string_map(
        artifact_json_required_field(object, "deps")?,
        "dependency hashes",
    )?;
    let interface_hash = artifact_json_field_string(object, "interface_hash")?;
    let result = artifact_model::ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(artifact_decode_error("matching interface package"))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(artifact_decode_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}
