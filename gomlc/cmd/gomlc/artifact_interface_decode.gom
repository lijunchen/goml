    let object = match artifact_json_object(value, "type alias") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let generics = match artifact_json_required_field(object, "generics") {
        Ok(value) => match artifact_decode_string_array(value, "type alias generics") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let ty = match artifact_json_required_field(object, "ty") {
        Ok(value) => match artifact_decode_type(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    Result::Ok(tast::TypeAliasInfo { name, generics, ty })
}

fn artifact_decode_associated_type_defs(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[ArtifactAssociatedTypeDef],
    string,
] {
    let object = match artifact_json_object(value, "associated type definitions") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        let definition = match artifact_json_object(item.1, "associated type definition") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let bounds = match artifact_json_required_field(definition, "bounds") {
            Ok(value) => match artifact_decode_trait_refs(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        result.push(ArtifactAssociatedTypeDef { name: item.0, bounds })
    };
    Result::Ok(result)
}

fn artifact_decode_trait_def(context: ArtifactDecodeContext, name: string, value: ArtifactValue) -> Result[
    ArtifactTraitDef,
    string,
] {
    let object = match artifact_json_object(value, "trait definition") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let params = match artifact_json_required_field(object, "params") {
        Ok(value) => match artifact_decode_string_array(value, "trait parameters") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let predicates = match artifact_json_required_field(object, "predicates") {
        Ok(value) => match artifact_decode_predicates(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let supertraits = match artifact_json_required_field(object, "supertraits") {
        Ok(value) => match artifact_decode_trait_refs(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let associated_types = match artifact_json_required_field(object, "associated_types") {
        Ok(value) => match artifact_decode_associated_type_defs(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let methods = match artifact_json_required_field(object, "methods") {
        Ok(value) => match artifact_decode_fn_map(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    Result::Ok(
        ArtifactTraitDef { name, params, predicates, supertraits, associated_types, methods },
    )
}

fn artifact_decode_associated_types(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[(string, tast::Type)],
    string,
] {
    let object = match artifact_json_object(value, "associated types") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        match artifact_decode_type(context, item.1) {
            Ok(value) => result.push((item.0, value)),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_impl_def(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    ArtifactImplDef,
    string,
] {
    let object = match artifact_json_object(value, "implementation definition") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let params = match artifact_json_required_field(object, "params") {
        Ok(value) => match artifact_decode_string_array(value, "implementation parameters") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let constraints = match artifact_json_required_field(object, "constraints") {
        Ok(value) => match artifact_decode_predicates(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let associated_types = match artifact_json_required_field(object, "associated_types") {
        Ok(value) => match artifact_decode_associated_types(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let methods = match artifact_json_required_field(object, "methods") {
        Ok(value) => match artifact_decode_fn_map(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let valid = match artifact_json_optional_field(object, "valid") {
        Ok(Some(value)) => match artifact_json_bool_value(value, "implementation validity") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Ok(None) => true,
        Err(error) => return Result::Err(error),
    };
    Result::Ok(ArtifactImplDef { params, constraints, associated_types, methods, valid })
}

fn artifact_decode_trait_impls(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[ArtifactTraitImpl],
    string,
] {
    let values = match artifact_json_array(value, "trait implementations") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let pair = match artifact_json_array(value, "trait implementation") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("trait implementation pair"))
        } else {
            ()
        };
        let key = match artifact_json_object(pair[0], "trait implementation key") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let trait_ref = match artifact_json_required_field(key, "trait_ref") {
            Ok(value) => match artifact_decode_trait_ref(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let for_ty = match artifact_json_required_field(key, "for_ty") {
            Ok(value) => match artifact_decode_type(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        let definition = match artifact_decode_impl_def(context, pair[1]) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push(ArtifactTraitImpl { trait_ref, for_ty, definition })
    };
    Result::Ok(result)
}

fn artifact_decode_inherent_impl_key(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    ArtifactInherentImplKey,
    string,
] {
    let object = match artifact_json_object(value, "inherent implementation key") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    if object.len() != 1 {
        Result::Err(artifact_decode_error("inherent implementation key variant"))
    } else if object[0].0 == "Exact" {
        match artifact_decode_type(context, object[0].1) {
            Ok(value) => Result::Ok(ArtifactInherentImplKey::Exact(value)),
            Err(error) => Result::Err(error),
        }
    } else if object[0].0 == "Constr" {
        match artifact_json_string_value(object[0].1, "inherent constructor") {
            Ok(value) => Result::Ok(ArtifactInherentImplKey::Constr(value)),
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(artifact_decode_error("inherent implementation key"))
    }
}

fn artifact_decode_inherent_impls(context: ArtifactDecodeContext, value: ArtifactValue) -> Result[
    Vec[ArtifactInherentImpl],
    string,
] {
    let values = match artifact_json_array(value, "inherent implementations") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for value in values {
        let pair = match artifact_json_array(value, "inherent implementation") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        if pair.len() != 2 {
            return Result::Err(artifact_decode_error("inherent implementation pair"))
        } else {
            ()
        };
        let key = match artifact_decode_inherent_impl_key(context, pair[0]) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let definition = match artifact_decode_impl_def(context, pair[1]) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        result.push(ArtifactInherentImpl { key, definition })
    };
    Result::Ok(result)
}

fn artifact_decode_package_exports(value: ArtifactValue) -> Result[ArtifactPackageExports, string] {
    let context = new_artifact_decode_context();
    let object = match artifact_json_object(value, "package exports") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let type_env = match artifact_json_field_object(object, "type_env") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let enum_map = match artifact_json_field_object(type_env, "enums") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let struct_map = match artifact_json_field_object(type_env, "structs") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    for item in enum_map {
        artifact_add_type_name(context.enum_names, item.0)
    };
    for item in struct_map {
        artifact_add_type_name(context.struct_names, item.0)
    };
    let enums = Vec::new();
    for item in enum_map {
        match artifact_decode_enum_def(context, item.1) {
            Ok(value) => if value.name == item.0 {
                enums.push(value)
            } else {
                return Result::Err(artifact_decode_error("matching enum name"))
            },
            Err(error) => return Result::Err(error),
        }
    };
    let structs = Vec::new();
    for item in struct_map {
        match artifact_decode_struct_def(context, item.1) {
            Ok(value) => if value.name == item.0 {
                structs.push(value)
            } else {
                return Result::Err(artifact_decode_error("matching struct name"))
            },
            Err(error) => return Result::Err(error),
        }
    };
    let alias_map = match artifact_json_field_object(type_env, "aliases") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let type_aliases = Vec::new();
    for item in alias_map {
        match artifact_decode_type_alias(context, item.0, item.1) {
            Ok(value) => type_aliases.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    let trait_env = match artifact_json_field_object(object, "trait_env") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let trait_map = match artifact_json_field_object(trait_env, "trait_defs") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let traits = Vec::new();
    for item in trait_map {
        match artifact_decode_trait_def(context, item.0, item.1) {
            Ok(value) => traits.push(value),
            Err(error) => return Result::Err(error),
        }
    };
    let trait_impls = match artifact_json_required_field(trait_env, "trait_impls") {
        Ok(value) => match artifact_decode_trait_impls(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let inherent_impls = match artifact_json_required_field(trait_env, "inherent_impls") {
        Ok(value) => match artifact_decode_inherent_impls(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let value_env = match artifact_json_field_object(object, "value_env") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let functions = match artifact_json_required_field(value_env, "funcs") {
        Ok(value) => match artifact_decode_fn_map(context, value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let constant_map = match artifact_json_field_object(value_env, "consts") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let constants = Vec::new();
    for item in constant_map {
        let definition = match artifact_json_object(item.1, "constant scheme") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        let ty = match artifact_json_required_field(definition, "ty") {
            Ok(value) => match artifact_decode_type(context, value) {
                Ok(value) => value,
                Err(error) => return Result::Err(error),
            },
            Err(error) => return Result::Err(error),
        };
        constants.push(tast::ConstantScheme { def_id: Option::None, name: item.0, ty })
    };
    Result::Ok(
        ArtifactPackageExports {
            enum_type_names: context.enum_names,
            struct_type_names: context.struct_names,
            type_aliases,
            enums,
            structs,
            traits,
            trait_impls,
            inherent_impls,
            functions,
            constants,
        },
    )
}

fn artifact_decode_package_interface(value: ArtifactValue) -> Result[
    ArtifactPackageInterface,
    string,
] {
    let object = match artifact_json_object(value, "package interface") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let package_name = match artifact_json_field_string(object, "package") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let name = match artifact_json_field_string(object, "name") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let value_map = match artifact_json_field_object(object, "value_exports") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let value_exports = Vec::new();
    for item in value_map {
        let number = match artifact_json_number_value(item.1, "value export index") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        };
        match artifact_parse_nonnegative_int(number) {
            Ok(value) => value_exports.push((item.0, value)),
            Err(error) => return Result::Err(error),
        }
    };
    let enum_map = match artifact_json_field_object(object, "enum_variants") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let enum_variants = Vec::new();
    for item in enum_map {
        match artifact_decode_string_array(item.1, "enum variant names") {
            Ok(value) => enum_variants.push((item.0, value)),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(ArtifactPackageInterface { package_name, name, value_exports, enum_variants })
}

fn artifact_decode_string_map(value: ArtifactValue, expected: string) -> Result[
    Vec[(string, string)],
    string,
] {
    let object = match artifact_json_object(value, expected) {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = Vec::new();
    for item in object {
        match artifact_json_string_value(item.1, expected) {
            Ok(value) => result.push((item.0, value)),
            Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn artifact_decode_interface_value(value: ArtifactValue) -> Result[ArtifactInterfaceUnit, string] {
    let object = match artifact_json_object(value, "interface unit") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let package_name = match artifact_json_field_string(object, "package") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let exports = match artifact_json_required_field(object, "exports") {
        Ok(value) => match artifact_decode_package_exports(value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let package_interface = match artifact_json_required_field(object, "interface") {
        Ok(value) => match artifact_decode_package_interface(value) {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let deps = match artifact_json_required_field(object, "deps") {
        Ok(value) => match artifact_decode_string_map(value, "dependency hashes") {
            Ok(value) => value,
            Err(error) => return Result::Err(error),
        },
        Err(error) => return Result::Err(error),
    };
    let interface_hash = match artifact_json_field_string(object, "interface_hash") {
        Ok(value) => value,
        Err(error) => return Result::Err(error),
    };
    let result = ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(artifact_decode_error("matching interface package"))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(artifact_decode_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}
