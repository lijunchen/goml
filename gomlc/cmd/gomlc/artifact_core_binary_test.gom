package main;

use gomlc::artifact_core_codec as core_codec;
use gomlc::artifact_interface_codec as interface_codec;

use gomlc::artifact_wire as wire;

use gomlc::artifact_model;

use gomlc::core;
use gomlc::tast;
use std::bytes;
use std::testing;

fn binary_core_fixture() -> artifact_model::ArtifactCoreUnit {
    let core_ir = empty_core_file();
    core_ir.functions.push(
        core::Function {
            name: "audit::value::choose",
            root: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: tast::Type::Int,
            body: core::Block {
                stmts: Vec::new(),
                tail: Option::Some(
                    core::Expr::Loop {
                        body: core::Expr::Break {
                            value: Option::Some(
                                core::Expr::Prim {
                                    value: tast::Primitive::Int { value: "7" },
                                    ty: tast::Type::Int,
                                },
                            ),
                            ty: tast::Type::Never,
                        },
                        ty: tast::Type::Int,
                    },
                ),
            },
        },
    );
    artifact_model::ArtifactCoreUnit {
        package_name: "audit::value",
        declared_name: "value",
        interface_hash: "0123456789abcdef",
        exports: interface_codec::empty_artifact_package_exports(),
        core_ir,
        deps: Vec::[("builtin", "fedcba9876543210")],
        sources: Vec::["value.gom"],
        tests: Vec::new(),
    }
}

#[test]
fn binary_core_artifact_is_deterministic_and_independent() -> unit {
    let first = match core_codec::encode_artifact_core_binary(binary_core_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    let second = match core_codec::encode_artifact_core_binary(binary_core_fixture()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            bytes::Bytes::new()
        },
    };
    testing::assert_eq(wire::artifact_binary_bytes_equal(first, second), true);
    match core_codec::decode_artifact_core_binary(first) {
        Ok(value) => {
            testing::assert_eq(value.interface_hash, "0123456789abcdef");
            testing::assert_eq(value.declared_name, "value");
            testing::assert_eq(
                core_codec::encode_artifact_core_unit(value, false),
                core_codec::encode_artifact_core_unit(binary_core_fixture(), false),
            )
        },
        Err(error) => testing::fail(error),
    }
}
