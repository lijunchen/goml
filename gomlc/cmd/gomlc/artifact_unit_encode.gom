package main;

use gomlc::artifact_model;

use gomlc::core;

fn artifact_json_test_descriptor(writer: ArtifactJsonWriter, value: artifact_model::ArtifactTestDescriptor) -> unit {
    artifact_json_begin_object(writer);
    artifact_json_name(writer, "id");
    artifact_json_string(writer, value.id);
    artifact_json_name(writer, "package");
    artifact_json_string(writer, value.package_name);
    artifact_json_name(writer, "symbol");
    artifact_json_string(writer, value.symbol);
    artifact_json_name(writer, "display_name");
    artifact_json_string(writer, value.display_name);
    artifact_json_name(writer, "source_path");
    artifact_json_string(writer, value.source_path);
    artifact_json_name(writer, "start");
    artifact_json_number(writer, value.start.to_string());
    artifact_json_name(writer, "end");
    artifact_json_number(writer, value.end.to_string());
    artifact_json_name(writer, "ignored");
    artifact_json_bool(writer, value.ignored);
    artifact_json_name(writer, "ignore_reason");
    match value.ignore_reason {
        Some(value) => artifact_json_string(writer, value),
        None => artifact_json_null(writer),
    };
    artifact_json_end_object(writer)
}

fn artifact_json_tests(writer: ArtifactJsonWriter, values: Vec[artifact_model::ArtifactTestDescriptor]) -> unit {
    artifact_json_begin_array(writer);
    for value in values {
        artifact_json_test_descriptor(writer, value)
    };
    artifact_json_end_array(writer)
}

fn artifact_json_core_unit(writer: ArtifactJsonWriter, value: artifact_model::ArtifactCoreUnit) -> unit {
    let context = artifact_exports_type_context(value.exports);
    artifact_json_begin_object(writer);
    if writer.binary_mode < 2 {
        artifact_json_name(writer, "format_version");
        artifact_json_number(writer, "18");
        artifact_json_name(writer, "compiler_abi");
        artifact_json_number(writer, "3")
    } else {
        ()
    };
    artifact_json_name(writer, "package");
    artifact_json_string(writer, value.package_name);
    artifact_json_name(writer, "declared_name");
    artifact_json_string(writer, value.declared_name);
    artifact_json_name(writer, "interface_hash");
    artifact_json_string(writer, value.interface_hash);
    artifact_json_name(writer, "exports");
    artifact_json_package_exports(writer, context, value.exports);
    artifact_json_name(writer, "core_ir");
    artifact_json_core_file(writer, context, value.core_ir);
    artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    artifact_json_name(writer, "sources");
    artifact_json_string_array(writer, value.sources);
    artifact_json_name(writer, "tests");
    artifact_json_tests(writer, value.tests);
    artifact_json_end_object(writer)
}

fn encode_artifact_core_unit(value: artifact_model::ArtifactCoreUnit, pretty: bool) -> string {
    let writer = new_artifact_json_writer(pretty);
    artifact_json_core_unit(writer, value);
    artifact_json_finish(writer)
}
