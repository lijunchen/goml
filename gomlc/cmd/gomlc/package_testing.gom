package main;

use gomlc::ast;
use gomlc::parser;
use gomlc::strings;
use gomlc::tast;
use std::text;

struct ParsedTestAttribute {
    name: string,
    args: Option[string],
}

struct TestDescriptor {
    id: string,
    package_name: string,
    symbol: string,
    display_name: string,
    source_path: string,
    start: int,
    end: int,
    ignored: bool,
    ignore_reason: Option[string],
}

struct TestCandidate {
    name: string,
    source_path: string,
    start: int,
    end: int,
    label_end: int,
    ignored: bool,
    ignore_reason: Option[string],
}

struct TestCandidateCollection {
    candidates: Vec[TestCandidate],
    diagnostics: Vec[tast::Diagnostic],
}

struct TestValidation {
    tests: Vec[TestDescriptor],
    diagnostics: Vec[tast::Diagnostic],
}

fn test_ascii_whitespace(value: uint8) -> bool {
    value == 32 || value == 9 || value == 10 || value == 13
}

fn trim_test_text(value: string) -> string {
    let start = Ref::new(0);
    while start.get() < value.byte_len() && test_ascii_whitespace(value.byte_get(start.get())) {
        start.set(start.get() + 1)
    };
    let end = Ref::new(value.byte_len());
    while end.get() > start.get() && test_ascii_whitespace(value.byte_get(end.get() - 1)) {
        end.set(end.get() - 1)
    };
    value.byte_slice(start.get(), end.get())
}

fn find_test_byte(value: string, expected: uint8) -> Option[int] {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == expected {
            return Option::Some(index)
        } else {
            ()
        }
    };
    Option::None
}

fn parse_test_attribute(value: ast::Attribute) -> Option[ParsedTestAttribute] {
    let normalized = trim_test_text(value.text);
    if normalized.byte_len() < 3 || !strings::starts_with(normalized, "#[")
        || !strings::ends_with(normalized, "]") {
        Option::None
    } else {
        let inner = trim_test_text(normalized.byte_slice(2, normalized.byte_len() - 1));
        match find_test_byte(inner, 40) {
            Some(open) => {
                let name = trim_test_text(inner.byte_slice(0, open));
                let tail = trim_test_text(inner.byte_slice(open + 1, inner.byte_len()));
                if name.byte_len() == 0 || tail.byte_len() == 0 || !strings::ends_with(tail, ")") {
                    Option::None
                } else {
                    Option::Some(
                        ParsedTestAttribute {
                            name,
                            args: Option::Some(
                                trim_test_text(tail.byte_slice(0, tail.byte_len() - 1)),
                            ),
                        },
                    )
                }
            },
            None => if inner.byte_len() == 0 {
                Option::None
            } else {
                Option::Some(ParsedTestAttribute { name: inner, args: Option::None })
            },
        }
    }
}

fn test_attribute_name(value: ast::Attribute) -> Option[string] {
    match parse_test_attribute(value) {
        Some(parsed) => Option::Some(parsed.name),
        None => Option::None,
    }
}

fn named_test_attributes(values: Vec[ast::Attribute], expected: string) -> Vec[ast::Attribute] {
    let result = Vec::new();
    for value in values {
        match test_attribute_name(value) {
            Some(name) => if name == expected {
                result.push(value)
            } else {
                ()
            },
            None => (),
        }
    };
    result
}

fn parse_ignore_reason(value: string) -> Option[string] {
    let source = "fn __ignore_reason() -> string { " + value + " }";
    let lowered = ast::lower(parser::parse(source));
    if lowered.diagnostics.len() > 0 {
        Option::None
    } else {
        match lowered.ast {
            Some(file) => if file.items.len() == 1 {
                match file.items[0] {
                    Function(function) => match function.body.tail {
                        Some(String { value: reason, span: _ }) => Option::Some(reason),
                        _ => Option::None,
                    },
                    _ => Option::None,
                }
            } else {
                Option::None
            },
            None => Option::None,
        }
    }
}

fn test_symbol(package_name: string, name: string) -> string {
    if package_name == "main" || package_name == "builtin" {
        name
    } else {
        package_name + "::" + name
    }
}

fn package_test_diagnostic(stage: string, message: string, source_path: string, span: ast::Span) -> tast::Diagnostic {
    tast::Diagnostic {
        severity: tast::DiagnosticSeverity::Error,
        stage,
        message,
        source_path,
        span: Option::Some(span),
        primary_label: Option::None,
        secondary_labels: Vec::new(),
        sort_order: 0,
    }
}

fn duplicate_test_id_diagnostic(id: string, candidate: TestCandidate, first: TestCandidate) -> tast::Diagnostic {
    let secondary_labels: Vec[tast::DiagnosticLabel] = Vec::new();
    secondary_labels.push(
        tast::DiagnosticLabel {
            message: "first test declared here",
            source_path: first.source_path,
            span: ast::Span { start: first.start, end: first.label_end },
        },
    );
    tast::Diagnostic {
        severity: tast::DiagnosticSeverity::Error,
        stage: "typer",
        message: "duplicate test id `" + id + "`",
        source_path: candidate.source_path,
        span: Option::Some(ast::Span { start: candidate.start, end: candidate.label_end }),
        primary_label: Option::Some("duplicate test declared here"),
        secondary_labels,
        sort_order: 0,
    }
}

fn collect_function_test(
    source_path: string,
    function: ast::Function,
    candidates: Vec[TestCandidate],
    diagnostics: Vec[tast::Diagnostic],
) -> unit {
    let test_attrs = named_test_attributes(function.attrs, "test");
    let ignore_attrs = named_test_attributes(function.attrs, "ignore");
    if test_attrs.len() > 1 {
        for index in 1..test_attrs.len() {
            let attribute = test_attrs[index];
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "duplicate `#[test]` attribute",
                    source_path,
                    attribute.span,
                ),
            )
        }
    } else {
        ()
    };
    if ignore_attrs.len() > 1 {
        for index in 1..ignore_attrs.len() {
            let attribute = ignore_attrs[index];
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "duplicate `#[ignore]` attribute",
                    source_path,
                    attribute.span,
                ),
            )
        }
    } else {
        ()
    };
    if test_attrs.len() == 0 {
        for attribute in ignore_attrs {
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "`#[ignore]` requires `#[test]`",
                    source_path,
                    attribute.span,
                ),
            )
        };
        return
    } else {
        ()
    };
    let test_attr = test_attrs[0];
    let Some(parsed_test) = parse_test_attribute(test_attr) else {
        return
    };
    match parsed_test.args {
        Some(_) => {
            diagnostics.push(
                package_test_diagnostic(
                    "attribute",
                    "`#[test]` does not accept arguments",
                    source_path,
                    test_attr.span,
                ),
            );
            return
        },
        None => (),
    };
    let ignore_reason = if ignore_attrs.len() > 0 {
        let ignore_attr = ignore_attrs[0];
        let Some(parsed_ignore) = parse_test_attribute(ignore_attr) else {
            return
        };
        match parsed_ignore.args {
            Some(args) => match parse_ignore_reason(args) {
                Some(reason) => Option::Some(reason),
                None => {
                    diagnostics.push(
                        package_test_diagnostic(
                            "attribute",
                            "`#[ignore]` accepts either no arguments or one string reason",
                            source_path,
                            ignore_attr.span,
                        ),
                    );
                    Option::None
                },
            },
            None => Option::None,
        }
    } else {
        Option::None
    };
    candidates.push(
        TestCandidate {
            name: function.name,
            source_path,
            start: test_attr.span.start,
            end: test_attr.span.end,
            label_end: test_attr.span.start + trim_test_text(test_attr.text).byte_len(),
            ignored: ignore_attrs.len() > 0,
            ignore_reason,
        },
    )
}

fn reject_item_test_attributes(
    values: Vec[ast::Attribute],
    target: string,
    source_path: string,
    diagnostics: Vec[tast::Diagnostic],
) -> unit {
    for value in values {
        match test_attribute_name(value) {
            Some(name) => if name == "test" {
                diagnostics.push(
                    package_test_diagnostic(
                        "attribute",
                        "`#[test]` can only be applied to top-level functions, not " + target,
                        source_path,
                        value.span,
                    ),
                )
            } else if name == "ignore" {
                diagnostics.push(
                    package_test_diagnostic(
                        "attribute",
                        "`#[ignore]` requires a top-level `#[test]` function",
                        source_path,
                        value.span,
                    ),
                )
            } else {
                ()
            },
            None => (),
        }
    }
}

fn test_string_less(left: string, right: string) -> bool {
    let common = if left.byte_len() < right.byte_len() {
        left.byte_len()
    } else {
        right.byte_len()
    };
    for index in 0..common {
        if left.byte_get(index) < right.byte_get(index) {
            return true
        } else if left.byte_get(index) > right.byte_get(index) {
            return false
        } else {
            ()
        }
    };
    left.byte_len() < right.byte_len()
}

fn sort_test_descriptors(values: Vec[TestDescriptor]) -> Vec[TestDescriptor] {
    for index in 1..values.len() {
        let current = values[index];
        let destination = Ref::new(index);
        while destination.get() > 0
            && test_string_less(current.id, values[destination.get() - 1].id) {
            values[destination.get()] = values[destination.get() - 1];
            destination.set(destination.get() - 1)
        };
        values[destination.get()] = current;
    };
    values
}

fn collect_package_test_candidates(files: Vec[ast::LowerResult], source_paths: Vec[string]) -> TestCandidateCollection {
    let candidates: Vec[TestCandidate] = Vec::new();
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for file_index in 0..files.len() {
        let source_path = if file_index < source_paths.len() {
            source_paths[file_index]
        } else {
            "<unknown>"
        };
        match files[file_index].ast {
            Some(file) => for item in file.items {
                match item {
                    Function(function) => collect_function_test(
                        source_path,
                        function,
                        candidates,
                        diagnostics,
                    ),
                    ImplBlock(block) => {
                        reject_item_test_attributes(
                            block.attrs,
                            "impl block",
                            source_path,
                            diagnostics,
                        );
                        for method in block.methods {
                            reject_item_test_attributes(
                                method.attrs,
                                "impl method",
                                source_path,
                                diagnostics,
                            )
                        }
                    },
                    ExternFunction(function) => reject_item_test_attributes(
                        function.attrs,
                        "extern function",
                        source_path,
                        diagnostics,
                    ),
                    EnumDef(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "enum",
                        source_path,
                        diagnostics,
                    ),
                    StructDef(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "struct",
                        source_path,
                        diagnostics,
                    ),
                    TraitDef(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "trait",
                        source_path,
                        diagnostics,
                    ),
                    TypeAlias(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "type alias",
                        source_path,
                        diagnostics,
                    ),
                    Constant(definition) => reject_item_test_attributes(
                        definition.attrs,
                        "constant",
                        source_path,
                        diagnostics,
                    ),
                }
            },
            None => (),
        }
    };
    TestCandidateCollection { candidates, diagnostics }
}

fn find_test_scheme(exports: ArtifactPackageExports, symbol: string) -> Option[ArtifactFnScheme] {
    for function in exports.functions {
        if function.name == symbol {
            return Option::Some(function)
        } else {
            ()
        }
    };
    Option::None
}

fn find_valid_test_candidate(values: Vec[TestCandidate], name: string) -> Option[TestCandidate] {
    for value in values {
        if value.name == name {
            return Option::Some(value)
        } else {
            ()
        }
    };
    Option::None
}

fn validate_package_tests(
    package_name: string,
    candidates: Vec[TestCandidate],
    exports: ArtifactPackageExports,
) -> TestValidation {
    let tests: Vec[TestDescriptor] = Vec::new();
    let valid_candidates: Vec[TestCandidate] = Vec::new();
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for candidate in candidates {
        let span = ast::Span { start: candidate.start, end: candidate.end };
        let symbol = test_symbol(package_name, candidate.name);
        let scheme = match find_test_scheme(exports, symbol) {
            Some(value) => value,
            None => {
                diagnostics.push(
                    package_test_diagnostic(
                        "typer",
                        "test function `" + candidate.name + "` was not resolved",
                        candidate.source_path,
                        span,
                    ),
                );
                continue
            },
        };
        let diagnostic_count = diagnostics.len();
        if candidate.name == "main" {
            diagnostics.push(
                package_test_diagnostic(
                    "typer",
                    "the main function cannot be a test",
                    candidate.source_path,
                    span,
                ),
            )
        } else {
            ()
        };
        if scheme.type_params.len() > 0 {
            diagnostics.push(
                package_test_diagnostic(
                    "typer",
                    "test function `" + candidate.name + "` must not have type parameters",
                    candidate.source_path,
                    span,
                ),
            )
        } else {
            ()
        };
        match tast::resolve_type(scheme.ty) {
            Func { params, ret_ty } => {
                if params.len() > 0 {
                    diagnostics.push(
                        package_test_diagnostic(
                            "typer",
                            "test function `" + candidate.name + "` must not have parameters",
                            candidate.source_path,
                            span,
                        ),
                    )
                } else {
                    ()
                };
                match tast::resolve_type(ret_ty) {
                    Unit => (),
                    actual => {
                        diagnostics.push(
                            package_test_diagnostic(
                                "typer",
                                "test function `" + candidate.name + "` must return unit, found "
                                    + tast::diagnostic_type_text(actual),
                                candidate.source_path,
                                span,
                            ),
                        )
                    },
                }
            },
            other => {
                diagnostics.push(
                    package_test_diagnostic(
                        "typer",
                        "test item `" + candidate.name + "` must be a function, found "
                            + tast::diagnostic_type_text(other),
                        candidate.source_path,
                        span,
                    ),
                )
            },
        };
        if diagnostics.len() == diagnostic_count {
            match find_valid_test_candidate(valid_candidates, candidate.name) {
                Some(first) => diagnostics.push(
                    duplicate_test_id_diagnostic(symbol, candidate, first),
                ),
                None => {
                    tests.push(
                        TestDescriptor {
                            id: symbol,
                            package_name,
                            symbol,
                            display_name: symbol,
                            source_path: candidate.source_path,
                            start: candidate.start,
                            end: candidate.end,
                            ignored: candidate.ignored,
                            ignore_reason: candidate.ignore_reason,
                        },
                    );
                    valid_candidates.push(candidate)
                },
            }
        } else {
            ()
        }
    };
    TestValidation { tests: sort_test_descriptors(tests), diagnostics }
}

fn write_test_json_hex(builder: text::StringBuilder, value: uint8) -> unit {
    let digits = "0123456789abcdef";
    builder.write_char(digits.get((value / 16) as int));
    builder.write_char(digits.get((value % 16) as int))
}

fn write_test_json_string(builder: text::StringBuilder, value: string) -> unit {
    builder.write_char('"');
    let index = Ref::new(0);
    while index.get() < value.byte_len() {
        let byte = value.byte_get(index.get());
        if byte == b'"' {
            builder.write_string("\\\"");
            index.set(index.get() + 1)
        } else if byte == b'\\' {
            builder.write_string("\\\\");
            index.set(index.get() + 1)
        } else if byte == b'\b' {
            builder.write_string("\\b");
            index.set(index.get() + 1)
        } else if byte == b'\f' {
            builder.write_string("\\f");
            index.set(index.get() + 1)
        } else if byte == b'\n' {
            builder.write_string("\\n");
            index.set(index.get() + 1)
        } else if byte == b'\r' {
            builder.write_string("\\r");
            index.set(index.get() + 1)
        } else if byte == b'\t' {
            builder.write_string("\\t");
            index.set(index.get() + 1)
        } else if byte < b' ' {
            builder.write_string("\\u00");
            write_test_json_hex(builder, byte);
            index.set(index.get() + 1)
        } else {
            let width = if byte < 128 {
                1
            } else if byte < 224 {
                2
            } else if byte < 240 {
                3
            } else {
                4
            };
            builder.write_string(value.byte_slice(index.get(), index.get() + width));
            index.set(index.get() + width)
        }
    };
    builder.write_char('"')
}

fn encode_test_manifest(values: Vec[TestDescriptor]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_char('[');
    for index in 0..values.len() {
        let value = values[index];
        if index > 0 {
            builder.write_char(',')
        } else {
            ()
        };
        builder.write_string("\n  {\n    \"id\": ");
        write_test_json_string(builder, value.id);
        builder.write_string(",\n    \"package\": ");
        write_test_json_string(builder, value.package_name);
        builder.write_string(",\n    \"symbol\": ");
        write_test_json_string(builder, value.symbol);
        builder.write_string(",\n    \"display_name\": ");
        write_test_json_string(builder, value.display_name);
        builder.write_string(",\n    \"source_path\": ");
        write_test_json_string(builder, value.source_path);
        builder.write_string(",\n    \"start\": ");
        builder.write_string(value.start.to_string());
        builder.write_string(",\n    \"end\": ");
        builder.write_string(value.end.to_string());
        builder.write_string(",\n    \"ignored\": ");
        builder.write_string(
            if value.ignored {
                "true"
            } else {
                "false"
            },
        );
        builder.write_string(",\n    \"ignore_reason\": ");
        match value.ignore_reason {
            Some(reason) => write_test_json_string(builder, reason),
            None => builder.write_string("null"),
        };
        builder.write_string("\n  }")
    };
    if values.len() > 0 {
        builder.write_char('\n')
    } else {
        ()
    };
    builder.write_char(']');
    builder.finish()
}

fn test_link_cases(values: Vec[TestDescriptor]) -> Vec[(string, string)] {
    let result = Vec::new();
    for value in values {
        result.push((value.id, value.symbol))
    };
    result
}
