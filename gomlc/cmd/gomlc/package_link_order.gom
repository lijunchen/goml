package main;

use gomlc::hir;
use gomlc::vecs;

struct PackageOrderNode {
    name: string,
    dependencies: Vec[string],
    position: int,
}

fn direct_hir_dependencies(values: Vec[hir::File]) -> Vec[string] {
    let result = Vec::new();
    for value in values {
        for dependency in value.import_aliases {
            if vecs::contains(result, dependency.package_name) {
                ()
            } else {
                result.push(dependency.package_name)
            }
        }
    };
    result
}

fn package_node_name_present(values: Vec[PackageOrderNode], name: string) -> bool {
    for value in values {
        if value.name == name {
            return true
        } else {
            ()
        }
    };
    false
}

fn package_node_is_ready(value: PackageOrderNode, remaining: Vec[PackageOrderNode]) -> bool {
    for dependency in value.dependencies {
        if package_node_name_present(remaining, dependency) {
            return false
        } else {
            ()
        }
    };
    true
}

fn order_package_nodes(values: Vec[PackageOrderNode]) -> Result[Vec[int], string] {
    let remaining = Vec::new();
    let names = Vec::new();
    for value in values {
        if vecs::contains(names, value.name) {
            return Result::Err("duplicate core provided for package " + value.name)
        } else {
            names.push(value.name);
            remaining.push(value)
        }
    };
    let result = Vec::new();
    while remaining.len() > 0 {
        let candidate = Ref::new(-1);
        for index in 0..remaining.len() {
            let value = remaining[index];
            if package_node_is_ready(value, remaining)
                && (candidate.get() < 0
                    || artifact_string_less(value.name, remaining[candidate.get()].name)) {
                candidate.set(index)
            } else {
                ()
            }
        };
        if candidate.get() < 0 {
            return Result::Err("package dependency cycle detected in core inputs")
        } else {
            result.push(remaining.remove(candidate.get()).position)
        }
    };
    Result::Ok(result)
}

fn order_artifact_compilations(values: Vec[ArtifactCompilation]) -> Result[
    Vec[ArtifactCompilation],
    string,
] {
    let nodes = Vec::new();
    for index in 0..values.len() {
        let value = values[index];
        nodes.push(
            PackageOrderNode {
                name: value.package_name,
                dependencies: value.dependency_names,
                position: index,
            },
        )
    };
    match order_package_nodes(nodes) {
        Ok(order) => {
            let result = Vec::new();
            for index in order {
                result.push(values[index])
            };
            Result::Ok(result)
        },
        Err(error) => Result::Err(error),
    }
}
