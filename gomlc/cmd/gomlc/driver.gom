pub struct Compilation {
    pub ast_value: ast::LowerResult,
    pub hir_value: hir::LowerResult,
    pub tast_value: tast::CheckResult,
    pub core_value: core::File,
    pub mono_value: core::File,
    pub lift_value: core::File,
    pub anf_value: anf::File,
    pub go_value: go_backend::File,
}

pub enum SourceCompilation {
    Compiled(Compilation),
    Diagnostics(string),
}

struct PackageCompilation {
    hir_file: hir::File,
    core_value: core::File,
    interface_unit: ArtifactInterfaceUnit,
    exports: ArtifactPackageExports,
}

struct DiagnosticPosition {
    line: int,
    column: int,
    line_start: int,
    line_end: int,
}

struct StandardLibrary {
    root: PackageCompilation,
    host: PackageCompilation,
    bytes: PackageCompilation,
    collections: PackageCompilation,
    env: PackageCompilation,
    fs: PackageCompilation,
    io: PackageCompilation,
    json: PackageCompilation,
    num: PackageCompilation,
    path: PackageCompilation,
    process: PackageCompilation,
    testing: PackageCompilation,
    text: PackageCompilation,
    time: PackageCompilation,
}

struct ArtifactStandardPackage {
    core_value: core::File,
    interface_unit: ArtifactInterfaceUnit,
    environment_exports: ArtifactPackageExports,
}

struct ArtifactStandardLibrary {
    root: ArtifactStandardPackage,
    host: ArtifactStandardPackage,
    bytes: ArtifactStandardPackage,
    collections: ArtifactStandardPackage,
    env: ArtifactStandardPackage,
    fs: ArtifactStandardPackage,
    io: ArtifactStandardPackage,
    json: ArtifactStandardPackage,
    num: ArtifactStandardPackage,
    path: ArtifactStandardPackage,
    process: ArtifactStandardPackage,
    testing: ArtifactStandardPackage,
    text: ArtifactStandardPackage,
    time: ArtifactStandardPackage,
}

fn artifact_standard_package_from_compilation(value: PackageCompilation) -> ArtifactStandardPackage {
    ArtifactStandardPackage {
        core_value: value.core_value,
        interface_unit: value.interface_unit,
        environment_exports: value.exports,
    }
}

fn artifact_standard_library(value: StandardLibrary) -> ArtifactStandardLibrary {
    ArtifactStandardLibrary {
        root: artifact_standard_package_from_compilation(value.root),
        host: artifact_standard_package_from_compilation(value.host),
        bytes: artifact_standard_package_from_compilation(value.bytes),
        collections: artifact_standard_package_from_compilation(value.collections),
        env: artifact_standard_package_from_compilation(value.env),
        fs: artifact_standard_package_from_compilation(value.fs),
        io: artifact_standard_package_from_compilation(value.io),
        json: artifact_standard_package_from_compilation(value.json),
        num: artifact_standard_package_from_compilation(value.num),
        path: artifact_standard_package_from_compilation(value.path),
        process: artifact_standard_package_from_compilation(value.process),
        testing: artifact_standard_package_from_compilation(value.testing),
        text: artifact_standard_package_from_compilation(value.text),
        time: artifact_standard_package_from_compilation(value.time),
    }
}

fn import_path_text(value: ast::Path) -> string {
    let builder = text::StringBuilder::new();
    let index = Ref::new(0);
    for segment in value.segments {
        if index.get() > 0 {
            builder.write_string("::")
        } else {
            ()
        };
        builder.write_string(segment.ident);
        index.set(index.get() + 1)
    };
    builder.finish()
}

fn std_import(value: string) -> bool {
    value == "std" || strings::starts_with(value, "std::")
}

fn single_file_project_import(value: ast::LowerResult) -> Option[string] {
    match value.ast {
        Some(file) => {
            for use_decl in file.uses {
                let package_path = import_path_text(use_decl.path);
                if !std_import(package_path) {
                    return Option::Some(package_path)
                } else {
                    ()
                }
            };
            Option::None
        },
        None => Option::None,
    }
}

fn imports_package(value: ast::LowerResult, expected: string) -> bool {
    match value.ast {
        Some(file) => {
            for use_decl in file.uses {
                if import_path_text(use_decl.path) == expected {
                    return true
                } else {
                    ()
                }
            };
            false
        },
        None => false,
    }
}

fn has_standard_import(value: ast::LowerResult) -> bool {
    match value.ast {
        Some(file) => {
            for use_decl in file.uses {
                if std_import(import_path_text(use_decl.path)) {
                    return true
                } else {
                    ()
                }
            };
            false
        },
        None => false,
    }
}

fn dependency_enums(builtins: core::File, dependencies: Vec[core::File]) -> Vec[tast::EnumDef] {
    let result: Vec[tast::EnumDef] = Vec::new();
    for value in builtins.enums {
        result.push(value)
    };
    for dependency in dependencies {
        for value in dependency.enums {
            result.push(value)
        }
    };
    result
}

fn dependency_structs(builtins: core::File, dependencies: Vec[core::File]) -> Vec[tast::StructDef] {
    let result: Vec[tast::StructDef] = Vec::new();
    for value in builtins.structs {
        result.push(value)
    };
    for dependency in dependencies {
        for value in dependency.structs {
            result.push(value)
        }
    };
    result
}

fn compile_standard_package(
    source: string,
    source_path: string,
    package_name: string,
    declared_name: string,
    hir_dependencies: Vec[hir::File],
    core_dependencies: Vec[core::File],
    builtins: core::File,
    deps: Vec[(string, string)],
) -> PackageCompilation {
    let ast_value = ast::lower(parser::parse(source));
    let ast_values = Vec::new();
    ast_values.push(ast_value);
    let public_names = public_item_names(ast_values, package_name);
    let hir_value = hir::lower_package(ast_value, source_path, package_name);
    if hir_value.diagnostics.len() > 0 {
        fail("error[compile]: failed to lower standard package " + package_name)
    } else {
        ()
    };
    let hir_file = match hir_value.hir {
        Some(file) => file,
        None => {
            fail("error[compile]: missing standard package " + package_name);
            hir::File {
                package_name,
                path: source_path,
                source_path,
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    };
    let tast_value = tast::check_for_link_with_dependencies_allowing_externs(
        hir_value,
        hir_dependencies,
    );
    if tast_value.diagnostics.len() > 0 {
        fail(render_typer_diagnostics(tast_value.diagnostics, source_path, source))
    } else {
        ()
    };
    let signatures = tast::package_signatures(hir_file);
    let tast_file = match tast_value.tast {
        Some(value) => value,
        None => {
            fail("error[compile]: missing typed standard package " + package_name);
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
            }
        },
    };
    let enum_names = Vec::new();
    for definition in dependency_enums(builtins, core_dependencies) {
        enum_names.push(definition.name)
    };
    let struct_names = Vec::new();
    for definition in dependency_structs(builtins, core_dependencies) {
        struct_names.push(definition.name)
    };
    let public_exports = artifact_package_exports(
        tast_file,
        signatures,
        package_name,
        public_names,
        true,
        enum_names,
        struct_names,
    );
    let exports = artifact_package_exports(
        tast_file,
        signatures,
        package_name,
        public_names,
        false,
        enum_names,
        struct_names,
    );
    let interface_unit = new_artifact_interface_unit(
        package_name,
        public_exports,
        artifact_package_interface(package_name, declared_name, public_exports),
        deps,
    );
    let core_value = core::lower_with_counter_types_and_options(
        tast_value,
        Ref::new(0),
        dependency_enums(builtins, core_dependencies),
        dependency_structs(builtins, core_dependencies),
        true,
    );
    PackageCompilation { hir_file, core_value, interface_unit, exports }
}

fn builtin_artifact_interface_unit() -> ArtifactInterfaceUnit {
    let source = core::builtin_source();
    let lowered = hir::lower(ast::lower(parser::parse(source)), "builtin_contract.gom");
    let signatures = match lowered.hir {
        Some(file) => tast::package_signatures(file),
        None => {
            fail("error[compile]: failed to lower builtin package");
            tast::PackageSignatures {
                traits: Vec::new(),
                functions: Vec::new(),
                type_aliases: Vec::new(),
                constants: Vec::new(),
            }
        },
    };
    let traits = Vec::new();
    for value in signatures.traits {
        if value.name == "Iterator" || value.name == "IntoIterator" {
            ()
        } else {
            traits.push(value)
        }
    };
    for name in Vec::new().pushed("Iterator").pushed("IntoIterator").pushed("Eq").pushed("Hash").pushed(
        "ToString",
    ) {
        match tast::builtin_trait_info(name) {
            Some(value) => traits.push(value),
            None => fail("error[compile]: missing builtin trait " + name),
        }
    };
    let signatures = tast::PackageSignatures {
        traits,
        functions: signatures.functions,
        type_aliases: signatures.type_aliases,
        constants: signatures.constants,
    };
    let contract_functions = Vec::new().pushed("array_get").pushed("array_set").pushed(
        "unit_to_string",
    ).pushed("bool_to_string").pushed("string_len").pushed("string_get").pushed("string_byte_get").pushed(
        "string_byte_slice",
    ).pushed("string_is_char_boundary").pushed("string_decode_utf8_at").pushed("string_to_bytes").pushed(
        "string_from_utf8",
    ).pushed("string_concat").pushed("string_print").pushed("string_println").pushed(
        "char_to_string",
    ).pushed("char_from_uint32_raw").pushed("int_to_string").pushed("int8_to_string").pushed(
        "int16_to_string",
    ).pushed("int32_to_string").pushed("int64_to_string").pushed("uint_to_string").pushed(
        "uint8_to_string",
    ).pushed("uint16_to_string").pushed("uint32_to_string").pushed("uint64_to_string").pushed(
        "float32_to_string",
    ).pushed("float64_to_string").pushed("string_parse_float32").pushed("string_parse_float64").pushed(
        "int_hash",
    ).pushed("int8_hash").pushed("int16_hash").pushed("int32_hash").pushed("int64_hash").pushed(
        "uint_hash",
    ).pushed("uint8_hash").pushed("uint16_hash").pushed("uint32_hash").pushed("float32_hash").pushed(
        "float64_hash",
    ).pushed("string_hash").pushed("char_hash").pushed("vec_new").pushed("vec_with_capacity").pushed(
        "vec_push",
    ).pushed("vec_get").pushed("vec_set").pushed("vec_len").pushed("vec_capacity").pushed(
        "vec_reserve",
    ).pushed("vec_truncate").pushed("slice").pushed("slice_get").pushed("slice_len").pushed(
        "slice_sub",
    ).pushed("__goml_primitive_eq").pushed("hashmap_new").pushed("hashmap_get").pushed(
        "hashmap_set",
    ).pushed("hashmap_remove").pushed("hashmap_len").pushed("hashmap_contains").pushed(
        "hashmap_entries",
    ).pushed("channel_new").pushed("channel_send").pushed("channel_recv").pushed("channel_close").pushed(
        "ref",
    ).pushed("ref_get").pushed("ref_set").pushed("ptr_eq").pushed("ptr_hash");
    let functions = Vec::new();
    for name in contract_functions {
        match tast::builtin_function_scheme(name) {
            Some(value) => functions.push(value),
            None => fail("error[compile]: missing builtin function " + name),
        }
    };
    for value in signatures.functions {
        functions.push(value)
    };
    let signatures = tast::PackageSignatures {
        traits: signatures.traits,
        functions,
        type_aliases: signatures.type_aliases,
        constants: signatures.constants,
    };
    let checked = tast::check(lowered);
    let file = match checked.tast {
        Some(file) => file,
        None => {
            fail("error[compile]: failed to typecheck builtin package");
            tast::File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
            }
        },
    };
    let exports = artifact_package_exports(
        file,
        signatures,
        "builtin",
        Vec::new(),
        false,
        Vec::new(),
        Vec::new(),
    );
    new_artifact_interface_unit(
        "builtin",
        exports,
        artifact_package_interface("builtin", "builtin", exports),
        Vec::new(),
    )
}

fn builtin_artifact_dependency() -> (string, string) {
    ("builtin", builtin_artifact_interface_unit().interface_hash)
}

fn builtin_artifact_json() -> string {
    let writer = new_artifact_json_writer(false);
    artifact_json_interface_unit(writer, builtin_artifact_interface_unit());
    artifact_json_finish(writer)
}

fn standard_artifact_deps(builtin_hash: string, dependencies: Vec[PackageCompilation]) -> Vec[
    (string, string),
] {
    let result = Vec::new();
    result.push(("builtin", builtin_hash));
    for dependency in dependencies {
        result.push(
            (dependency.interface_unit.package_name, dependency.interface_unit.interface_hash),
        )
    };
    result
}

fn compile_standard_library(builtins: core::File, builtin_hash: string) -> StandardLibrary {
    let host = compile_standard_package(
        stdlib::host_source(),
        "host.gom",
        "std::internal::host",
        "host",
        Vec::new(),
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new()),
    );
    let bytes = compile_standard_package(
        stdlib::bytes_source(),
        "bytes.gom",
        "std::bytes",
        "bytes",
        Vec::new(),
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new()),
    );
    let collections = compile_standard_package(
        stdlib::collections_source(),
        "collections.gom",
        "std::collections",
        "collections",
        Vec::new(),
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new()),
    );
    let env_hir_dependencies: Vec[hir::File] = Vec::new();
    env_hir_dependencies.push(host.hir_file);
    let env = compile_standard_package(
        stdlib::env_source(),
        "env.gom",
        "std::env",
        "env",
        env_hir_dependencies,
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(host)),
    );
    let fs_hir_dependencies: Vec[hir::File] = Vec::new();
    fs_hir_dependencies.push(host.hir_file);
    fs_hir_dependencies.push(bytes.hir_file);
    let fs_core_dependencies: Vec[core::File] = Vec::new();
    fs_core_dependencies.push(bytes.core_value);
    let fs = compile_standard_package(
        stdlib::fs_source(),
        "fs.gom",
        "std::fs",
        "fs",
        fs_hir_dependencies,
        fs_core_dependencies,
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(bytes).pushed(host)),
    );
    let io_hir_dependencies: Vec[hir::File] = Vec::new();
    io_hir_dependencies.push(host.hir_file);
    io_hir_dependencies.push(bytes.hir_file);
    let io_core_dependencies: Vec[core::File] = Vec::new();
    io_core_dependencies.push(bytes.core_value);
    let io = compile_standard_package(
        stdlib::io_source(),
        "io.gom",
        "std::io",
        "io",
        io_hir_dependencies,
        io_core_dependencies,
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(bytes).pushed(host)),
    );
    let path_hir_dependencies: Vec[hir::File] = Vec::new();
    path_hir_dependencies.push(host.hir_file);
    let path = compile_standard_package(
        stdlib::path_source(),
        "path.gom",
        "std::path",
        "path",
        path_hir_dependencies,
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(host)),
    );
    let process_hir_dependencies: Vec[hir::File] = Vec::new();
    process_hir_dependencies.push(host.hir_file);
    process_hir_dependencies.push(bytes.hir_file);
    let process_core_dependencies: Vec[core::File] = Vec::new();
    process_core_dependencies.push(bytes.core_value);
    let process = compile_standard_package(
        stdlib::process_source(),
        "process.gom",
        "std::process",
        "process",
        process_hir_dependencies,
        process_core_dependencies,
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(bytes).pushed(host)),
    );
    let testing_hir_dependencies: Vec[hir::File] = Vec::new();
    testing_hir_dependencies.push(host.hir_file);
    let testing = compile_standard_package(
        stdlib::testing_source(),
        "testing.gom",
        "std::testing",
        "testing",
        testing_hir_dependencies,
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(host)),
    );
    let text_hir_dependencies: Vec[hir::File] = Vec::new();
    text_hir_dependencies.push(bytes.hir_file);
    let text_core_dependencies: Vec[core::File] = Vec::new();
    text_core_dependencies.push(bytes.core_value);
    let text = compile_standard_package(
        stdlib::text_source(),
        "string_builder.gom",
        "std::text",
        "text",
        text_hir_dependencies,
        text_core_dependencies,
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(bytes)),
    );
    let json_hir_dependencies: Vec[hir::File] = Vec::new();
    json_hir_dependencies.push(text.hir_file);
    let json_core_dependencies: Vec[core::File] = Vec::new();
    json_core_dependencies.push(text.core_value);
    let json = compile_standard_package(
        stdlib::json_source(),
        "json.gom",
        "std::json",
        "json",
        json_hir_dependencies,
        json_core_dependencies,
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(text)),
    );
    let num_hir_dependencies: Vec[hir::File] = Vec::new();
    num_hir_dependencies.push(host.hir_file);
    let num = compile_standard_package(
        stdlib::num_source(),
        "num.gom",
        "std::num",
        "num",
        num_hir_dependencies,
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(host)),
    );
    let time_hir_dependencies: Vec[hir::File] = Vec::new();
    time_hir_dependencies.push(host.hir_file);
    let time = compile_standard_package(
        stdlib::time_source(),
        "time.gom",
        "std::time",
        "time",
        time_hir_dependencies,
        Vec::new(),
        builtins,
        standard_artifact_deps(builtin_hash, Vec::new().pushed(host)),
    );
    let root_hir_dependencies = Vec::new().pushed(bytes.hir_file).pushed(collections.hir_file).pushed(
        env.hir_file,
    ).pushed(fs.hir_file).pushed(io.hir_file).pushed(num.hir_file).pushed(path.hir_file).pushed(
        process.hir_file,
    ).pushed(text.hir_file).pushed(json.hir_file).pushed(time.hir_file);
    let root_core_dependencies = Vec::new().pushed(bytes.core_value).pushed(collections.core_value).pushed(
        env.core_value,
    ).pushed(fs.core_value).pushed(io.core_value).pushed(num.core_value).pushed(path.core_value).pushed(
        process.core_value,
    ).pushed(text.core_value).pushed(json.core_value).pushed(time.core_value);
    let root = compile_standard_package(
        stdlib::root_source(),
        "lib.gom",
        "std",
        "std",
        root_hir_dependencies,
        root_core_dependencies,
        builtins,
        standard_artifact_deps(
            builtin_hash,
            Vec::new().pushed(bytes).pushed(collections).pushed(env).pushed(fs).pushed(io).pushed(
                num,
            ).pushed(path).pushed(process).pushed(text).pushed(json).pushed(time),
        ),
    );
    StandardLibrary {
        root,
        host,
        bytes,
        collections,
        env,
        fs,
        io,
        json,
        num,
        path,
        process,
        testing,
        text,
        time,
    }
}

fn selected_standard_hir(ast_value: ast::LowerResult, standard: StandardLibrary) -> Vec[hir::File] {
    let needs_root = imports_package(ast_value, "std");
    let needs_fs = needs_root || imports_package(ast_value, "std::fs");
    let needs_io = needs_root || imports_package(ast_value, "std::io");
    let needs_process = needs_root || imports_package(ast_value, "std::process");
    let needs_json = needs_root || imports_package(ast_value, "std::json");
    let needs_text = needs_root || needs_json || imports_package(ast_value, "std::text");
    let needs_bytes = imports_package(ast_value, "std::bytes") || needs_root || needs_fs || needs_io
        || needs_process
        || needs_text;
    let result: Vec[hir::File] = Vec::new();
    if needs_bytes {
        result.push(standard.bytes.hir_file)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::collections") {
        result.push(standard.collections.hir_file)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::env") {
        result.push(standard.env.hir_file)
    } else {
        ()
    };
    if needs_fs {
        result.push(standard.fs.hir_file)
    } else {
        ()
    };
    if needs_io {
        result.push(standard.io.hir_file)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::path") {
        result.push(standard.path.hir_file)
    } else {
        ()
    };
    if needs_process {
        result.push(standard.process.hir_file)
    } else {
        ()
    };
    if imports_package(ast_value, "std::testing") {
        result.push(standard.testing.hir_file)
    } else {
        ()
    };
    if needs_text {
        result.push(standard.text.hir_file)
    } else {
        ()
    };
    if needs_json {
        result.push(standard.json.hir_file)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::num") {
        result.push(standard.num.hir_file)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::time") {
        result.push(standard.time.hir_file)
    } else {
        ()
    };
    if needs_root {
        result.push(standard.root.hir_file)
    } else {
        ()
    };
    result
}

fn selected_standard_core(ast_value: ast::LowerResult, standard: StandardLibrary) -> Vec[core::File] {
    let needs_root = imports_package(ast_value, "std");
    let needs_fs = needs_root || imports_package(ast_value, "std::fs");
    let needs_io = needs_root || imports_package(ast_value, "std::io");
    let needs_process = needs_root || imports_package(ast_value, "std::process");
    let needs_json = needs_root || imports_package(ast_value, "std::json");
    let needs_text = needs_root || needs_json || imports_package(ast_value, "std::text");
    let needs_bytes = imports_package(ast_value, "std::bytes") || needs_root || needs_fs || needs_io
        || needs_process
        || needs_text;
    let result: Vec[core::File] = Vec::new();
    if needs_bytes {
        result.push(standard.bytes.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::collections") {
        result.push(standard.collections.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::env") {
        result.push(standard.env.core_value)
    } else {
        ()
    };
    if needs_fs {
        result.push(standard.fs.core_value)
    } else {
        ()
    };
    if needs_io {
        result.push(standard.io.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::path") {
        result.push(standard.path.core_value)
    } else {
        ()
    };
    if needs_process {
        result.push(standard.process.core_value)
    } else {
        ()
    };
    if imports_package(ast_value, "std::testing") {
        result.push(standard.testing.core_value)
    } else {
        ()
    };
    if needs_text {
        result.push(standard.text.core_value)
    } else {
        ()
    };
    if needs_json {
        result.push(standard.json.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::num") {
        result.push(standard.num.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::time") {
        result.push(standard.time.core_value)
    } else {
        ()
    };
    if needs_root {
        result.push(standard.root.core_value)
    } else {
        ()
    };
    result
}

fn hir_diagnostics(diagnostics: Vec[hir::Diagnostic], source_path: string) -> Vec[tast::Diagnostic] {
    let result = Vec::new();
    for diagnostic in diagnostics {
        result.push(
            tast::Diagnostic {
                severity: tast::DiagnosticSeverity::Error,
                stage: "typer",
                message: diagnostic.message,
                source_path,
                span: diagnostic.span,
                primary_label: Option::None,
                secondary_labels: Vec::new(),
                sort_order: 0,
            },
        )
    };
    result
}

fn diagnostic_span_start(value: tast::Diagnostic) -> int {
    match value.span {
        Some(span) => span.start,
        None => if value.source_path == "" {
            2147483647
        } else {
            0
        },
    }
}

fn diagnostic_span_end(value: tast::Diagnostic) -> int {
    match value.span {
        Some(span) => span.end,
        None => if value.source_path == "" {
            2147483647
        } else {
            0
        },
    }
}

fn diagnostic_precedes(left: tast::Diagnostic, right: tast::Diagnostic) -> bool {
    let left_inference = left.message == "Could not infer type";
    let right_inference = right.message == "Could not infer type";
    if left_inference != right_inference {
        left_inference
    } else if left_inference {
        false
    } else if left.source_path != right.source_path {
        left.source_path < right.source_path
    } else if diagnostic_span_start(left) != diagnostic_span_start(right) {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else if diagnostic_span_end(left) != diagnostic_span_end(right) {
        diagnostic_span_end(left) < diagnostic_span_end(right)
    } else if left.stage != right.stage {
        left.stage < right.stage
    } else {
        left.message < right.message
    }
}

fn sorted_typer_diagnostics(values: Vec[tast::Diagnostic]) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for value in values {
        result.push(value)
    };
    for index in range(1, result.len()) {
        let value = result[index];
        let target = Ref::new(index);
        while target.get() > 0 && diagnostic_precedes(value, result[target.get() - 1]) {
            result[target.get()] = result[target.get() - 1];
            target.set(target.get() - 1)
        };
        result[target.get()] = value;
    };
    result
}

fn diagnostic_source(source_path: string, fallback_path: string, fallback_source: string) -> string {
    if source_path == fallback_path {
        fallback_source
    } else {
        match fs::read_file(source_path) {
            Ok(source) => source,
            Err(_) => "",
        }
    }
}

fn source_position(source: string, offset: int) -> DiagnosticPosition {
    let limit = if offset < 0 {
        0
    } else if offset > source.byte_len() {
        source.byte_len()
    } else {
        offset
    };
    let line = Ref::new(0);
    let column = Ref::new(0);
    let line_start = Ref::new(0);
    for index in range(0, limit) {
        let byte = source.byte_get(index);
        if byte == 10 {
            line.set(line.get() + 1);
            column.set(0);
            line_start.set(index + 1)
        } else if byte < 128 || byte >= 192 {
            column.set(column.get() + 1)
        } else {
            ()
        }
    };
    let line_end = Ref::new(line_start.get());
    while line_end.get() < source.byte_len() {
        let byte = source.byte_get(line_end.get());
        if byte == 10 || byte == 13 {
            break
        } else {
            line_end.set(line_end.get() + 1)
        }
    };
    DiagnosticPosition {
        line: line.get(),
        column: column.get(),
        line_start: line_start.get(),
        line_end: line_end.get(),
    }
}

fn repeat_char(value: char, count: int) -> string {
    let builder = text::StringBuilder::new();
    for _ in range(0, count) {
        builder.write_char(value)
    };
    builder.finish()
}

fn diagnostic_visual_width(value: string) -> int {
    let width = Ref::new(0);
    for character in value.chars() {
        if character == '\t' {
            width.set(width.get() + 4 - width.get() % 4)
        } else {
            width.set(width.get() + 1)
        }
    };
    width.get()
}

fn expand_diagnostic_tabs(value: string) -> string {
    let builder = text::StringBuilder::new();
    let width = Ref::new(0);
    for character in value.chars() {
        if character == '\t' {
            let spaces = 4 - width.get() % 4;
            builder.write_string(repeat_char(' ', spaces));
            width.set(width.get() + spaces)
        } else {
            builder.write_char(character);
            width.set(width.get() + 1)
        }
    };
    builder.finish()
}

fn render_diagnostic_label(
    builder: text::StringBuilder,
    kind: string,
    source_path: string,
    span: ast::Span,
    message: Option[string],
    fallback_path: string,
    fallback_source: string,
) -> unit {
    let source = diagnostic_source(source_path, fallback_path, fallback_source);
    builder.write_char('\n');
    builder.write_string(kind);
    builder.write_string(": ");
    builder.write_string(source_path);
    builder.write_char(':');
    if source.byte_len() == 0 {
        builder.write_string(span.start.to_string());
        builder.write_string("..");
        builder.write_string(span.end.to_string());
        match message {
            Some(value) => {
                builder.write_string(": ");
                builder.write_string(value)
            },
            None => (),
        }
    } else {
        let start = source_position(source, span.start);
        let end = source_position(source, span.end);
        builder.write_string((start.line + 1).to_string());
        builder.write_char(':');
        builder.write_string((start.column + 1).to_string());
        if span.start != span.end {
            builder.write_char('-');
            builder.write_string((end.line + 1).to_string());
            builder.write_char(':');
            builder.write_string((end.column + 1).to_string())
        } else {
            ()
        };
        match message {
            Some(value) => {
                builder.write_string(": ");
                builder.write_string(value)
            },
            None => (),
        };
        let line_number = (start.line + 1).to_string();
        let gutter = line_number.len();
        let line_text = source.byte_slice(start.line_start, start.line_end);
        let highlight_start = if span.start < start.line_start {
            start.line_start
        } else if span.start > start.line_end {
            start.line_end
        } else {
            span.start
        };
        let highlight_end = if span.end < highlight_start {
            highlight_start
        } else if span.end > start.line_end {
            start.line_end
        } else {
            span.end
        };
        let indentation = diagnostic_visual_width(
            source.byte_slice(start.line_start, highlight_start),
        );
        let measured = diagnostic_visual_width(source.byte_slice(highlight_start, highlight_end));
        let marker_width = if measured > 0 {
            measured
        } else {
            1
        };
        builder.write_char('\n');
        builder.write_string(line_number);
        builder.write_string(" | ");
        builder.write_string(expand_diagnostic_tabs(line_text));
        builder.write_char('\n');
        builder.write_string(repeat_char(' ', gutter));
        builder.write_string(" | ");
        builder.write_string(repeat_char(' ', indentation));
        builder.write_string(repeat_char('^', marker_width))
    }
}

fn render_typer_diagnostic(value: tast::Diagnostic, fallback_path: string, fallback_source: string) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(
        match value.severity {
            Error => "error[",
            Warning => "warning[",
        },
    );
    builder.write_string(value.stage);
    builder.write_string("]: ");
    builder.write_string(value.message);
    let inference = value.message == "Could not infer type";
    match if inference {
        Option::None
    } else {
        value.span
    } {
        Some(span) => render_diagnostic_label(
            builder,
            "primary",
            value.source_path,
            span,
            value.primary_label,
            fallback_path,
            fallback_source,
        ),
        None => if value.source_path != "" && !inference {
            builder.write_string("\nat: ");
            builder.write_string(value.source_path)
        } else {
            ()
        },
    };
    for label in value.secondary_labels {
        render_diagnostic_label(
            builder,
            "secondary",
            label.source_path,
            label.span,
            Option::Some(label.message),
            fallback_path,
            fallback_source,
        )
    };
    builder.finish()
}

fn render_typer_diagnostics(
    values: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> string {
    let builder = text::StringBuilder::new();
    let index = Ref::new(0);
    for value in sorted_typer_diagnostics(values) {
        if index.get() > 0 {
            builder.write_string("\n\n")
        } else {
            ()
        };
        builder.write_string(render_typer_diagnostic(value, fallback_path, fallback_source));
        index.set(index.get() + 1)
    };
    builder.finish()
}

fn fail_on_typer_diagnostics(
    diagnostics: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> unit {
    if typer_diagnostics_have_errors(diagnostics) {
        fail(render_typer_diagnostics(diagnostics, fallback_path, fallback_source))
    } else {
        ()
    }
}

fn ast_diagnostics(diagnostics: Vec[cst::Diagnostic], stage: string, source_path: string) -> Vec[
    tast::Diagnostic,
] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for diagnostic in diagnostics {
        result.push(
            tast::Diagnostic {
                severity: tast::DiagnosticSeverity::Error,
                stage,
                message: diagnostic.message,
                source_path,
                span: Option::Some(ast::Span { start: diagnostic.start, end: diagnostic.end }),
                primary_label: Option::None,
                secondary_labels: Vec::new(),
                sort_order: 0,
            },
        )
    };
    result
}

fn fail_on_ast_diagnostics(
    diagnostics: Vec[cst::Diagnostic],
    stage: string,
    source_path: string,
    source: string,
) -> unit {
    if diagnostics.len() > 0 {
        fail(
            render_typer_diagnostics(
                ast_diagnostics(diagnostics, stage, source_path),
                source_path,
                source,
            ),
        )
    } else {
        ()
    }
}

fn compact_diagnostic_line(
    builder: text::StringBuilder,
    message: string,
    span: Option[ast::Span],
    source: string,
) -> unit {
    match span {
        Some(value) => {
            let position = source_position(source, value.start);
            builder.write_string((position.line + 1).to_string());
            builder.write_char(':');
            builder.write_string((position.column + 1).to_string());
            builder.write_string(": ")
        },
        None => (),
    };
    builder.write_string(message);
    builder.write_char('\n')
}

fn compact_ast_diagnostics(diagnostics: Vec[cst::Diagnostic], source: string, with_locations: bool) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            if with_locations {
                Option::Some(ast::Span { start: diagnostic.start, end: diagnostic.end })
            } else {
                Option::None
            },
            source,
        )
    };
    builder.finish()
}

fn compact_messages(diagnostics: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(builder, diagnostic, Option::None, "")
    };
    builder.finish()
}

fn compact_hir_diagnostics(diagnostics: Vec[hir::Diagnostic], source: string) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(builder, diagnostic.message, diagnostic.span, source)
    };
    builder.finish()
}

fn diagnostic_message_starts_with(value: string, prefix: string) -> bool {
    strings::starts_with(value, prefix)
}

fn compact_diagnostic_phase(value: tast::Diagnostic) -> int {
    if value.message == "Could not infer type" {
        4
    } else if diagnostic_message_starts_with(value.message, "Could not infer the ") {
        if diagnostic_message_starts_with(
            value.message,
            "Could not infer the type required to prove",
        ) {
            2
        } else {
            3
        }
    } else if diagnostic_message_starts_with(value.message, "No instance found for trait ") {
        2
    } else if diagnostic_message_starts_with(value.message, "Struct ")
        && strings::contains(value.message, " type arguments, but got ") {
        1
    } else {
        0
    }
}

fn specialized_inference_priority(value: string) -> int {
    if diagnostic_message_starts_with(value, "Could not infer the base type") {
        0
    } else if diagnostic_message_starts_with(value, "Could not infer the operand type") {
        1
    } else {
        2
    }
}

fn compact_diagnostic_precedes(left: tast::Diagnostic, right: tast::Diagnostic) -> bool {
    let left_phase = compact_diagnostic_phase(left);
    let right_phase = compact_diagnostic_phase(right);
    if left_phase != right_phase {
        left_phase < right_phase
    } else if diagnostic_message_starts_with(left.message, "extern ")
        && diagnostic_message_starts_with(right.message, "Internal error: ") {
        true
    } else if left_phase == 0
        && diagnostic_message_starts_with(left.message, "Unknown type constructor ")
        && diagnostic_message_starts_with(right.message, "Unknown type constructor ") {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else if left_phase == 2
        && diagnostic_message_starts_with(left.message, "No instance found for trait ")
        && diagnostic_message_starts_with(right.message, "No instance found for trait ")
        && diagnostic_span_start(left) == diagnostic_span_start(right) {
        left.message > right.message
    } else if left_phase == 3 {
        specialized_inference_priority(left.message) < specialized_inference_priority(right.message)
    } else if left_phase == 4 && left.sort_order != right.sort_order
        && (left.sort_order > 0 || right.sort_order > 0) {
        left.sort_order < right.sort_order
    } else if left_phase == 4 {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else {
        false
    }
}

fn compact_sorted_diagnostics(values: Vec[tast::Diagnostic]) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for value in values {
        match value.severity {
            Error => result.push(value),
            Warning => (),
        }
    };
    for index in range(1, result.len()) {
        let value = result[index];
        let target = Ref::new(index);
        while target.get() > 0 && compact_diagnostic_precedes(value, result[target.get() - 1]) {
            result[target.get()] = result[target.get() - 1];
            target.set(target.get() - 1)
        };
        result[target.get()] = value;
    };
    result
}

fn typer_diagnostics_have_errors(diagnostics: Vec[tast::Diagnostic]) -> bool {
    for diagnostic in diagnostics {
        match diagnostic.severity {
            Error => return true,
            Warning => (),
        }
    };
    false
}

fn compact_typer_diagnostics(
    diagnostics: Vec[tast::Diagnostic],
    source_path: string,
    source: string,
) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in compact_sorted_diagnostics(diagnostics) {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            diagnostic.span,
            diagnostic_source(diagnostic.source_path, source_path, source),
        )
    };
    builder.finish()
}

pub fn diagnostic_output(source_path: string, source: string) -> string {
    let parsed = parser::parse(source);
    if parsed.diagnostics.len() > 0 {
        return compact_ast_diagnostics(parsed.diagnostics, source, true)
    } else {
        ()
    };
    let ast_value = ast::lower(parsed);
    if ast_value.diagnostics.len() > 0 {
        return compact_ast_diagnostics(ast_value.diagnostics, source, false)
    } else {
        ()
    };
    match single_file_project_import(ast_value) {
        Some(package_path) => return "single-file compilation cannot use project package "
            + package_path
            + "\n",
        None => (),
    };
    let ast_value = hir::expand_derives(ast_value);
    if ast_value.diagnostics.len() > 0 {
        return compact_ast_diagnostics(ast_value.diagnostics, source, false)
    } else {
        ()
    };
    let hir_value = hir::lower_expanded(ast_value, source_path);
    if hir_value.diagnostics.len() > 0 {
        return compact_hir_diagnostics(hir_value.diagnostics, source)
    } else {
        ()
    };
    let counter = Ref::new(0);
    let builtins = core::lower_builtins(counter);
    let standard = if has_standard_import(ast_value) {
        Option::Some(compile_standard_library(builtins, builtin_artifact_dependency().1))
    } else {
        Option::None
    };
    let hir_dependencies = match standard {
        Some(value) => selected_standard_hir(ast_value, value),
        None => Vec::new(),
    };
    let core_dependencies = match standard {
        Some(value) => selected_standard_core(ast_value, value),
        None => Vec::new(),
    };
    let tast_value = tast::check_for_link_with_dependencies(hir_value, hir_dependencies);
    if typer_diagnostics_have_errors(tast_value.diagnostics) {
        return compact_typer_diagnostics(tast_value.diagnostics, source_path, source)
    } else {
        ()
    };
    if !has_single_file_entrypoint(tast_value) {
        return "main function is required\n"
    } else {
        ()
    };
    let core_value = core::link_with_dependencies(
        builtins,
        core_dependencies,
        core::lower_with_counter_types_and_options(
            tast_value,
            counter,
            dependency_enums(builtins, core_dependencies),
            dependency_structs(builtins, core_dependencies),
            true,
        ),
    );
    let mono_result = mono::lower_checked(core_value);
    match mono_result.error {
        Some(error) => error + "\n",
        None => "",
    }
}

fn run_test_diagnostics(args: Vec[string]) -> unit {
    if args.len() != 3 {
        fail("usage: gomlc __test-diagnostics <FILE>")
    } else {
        let source_path = args[2];
        io::print(diagnostic_output(source_path, read_source(source_path)))
    }
}

fn lower_mono_or_fail(value: core::File) -> core::File {
    let result = mono::lower_checked(value);
    match result.error {
        Some(error) => {
            fail("error[compile]: " + error);
            result.file
        },
        None => result.file,
    }
}

fn has_single_file_entrypoint(value: tast::CheckResult) -> bool {
    match value.tast {
        Some(file) => {
            for item in file.items {
                match item {
                    Function(function) => if function.name == "main" {
                        return true
                    } else {
                        ()
                    },
                    _ => (),
                }
            };
            false
        },
        None => false,
    }
}

fn fail_on_missing_single_file_entrypoint(value: tast::CheckResult) -> unit {
    if has_single_file_entrypoint(value) {
        ()
    } else {
        fail("error[typer]: main function is required")
    }
}

pub fn compile_source(source_path: string, source: string) -> Compilation {
    let parsed = parser::parse(source);
    fail_on_ast_diagnostics(parsed.diagnostics, "parser", source_path, source);
    let ast_value = ast::lower(parsed);
    fail_on_ast_diagnostics(ast_value.diagnostics, "lower", source_path, source);
    match single_file_project_import(ast_value) {
        Some(package_path) => fail(
            "error[compile]: single-file compilation cannot use project package " + package_path,
        ),
        None => (),
    };
    let ast_value = hir::expand_derives(ast_value);
    fail_on_ast_diagnostics(ast_value.diagnostics, "derive", source_path, source);
    let hir_value = hir::lower_expanded(ast_value, source_path);
    let counter = Ref::new(0);
    let builtins = core::lower_builtins(counter);
    let standard = if has_standard_import(ast_value) {
        Option::Some(compile_standard_library(builtins, builtin_artifact_dependency().1))
    } else {
        Option::None
    };
    let hir_dependencies = match standard {
        Some(value) => selected_standard_hir(ast_value, value),
        None => Vec::new(),
    };
    let core_dependencies = match standard {
        Some(value) => selected_standard_core(ast_value, value),
        None => Vec::new(),
    };
    let tast_value = tast::check_for_link_with_dependencies(hir_value, hir_dependencies);
    fail_on_typer_diagnostics(tast_value.diagnostics, source_path, source);
    fail_on_missing_single_file_entrypoint(tast_value);
    let core_value = core::link_with_dependencies(
        builtins,
        core_dependencies,
        core::lower_with_counter_types_and_options(
            tast_value,
            counter,
            dependency_enums(builtins, core_dependencies),
            dependency_structs(builtins, core_dependencies),
            true,
        ),
    );
    let mono_value = lower_mono_or_fail(core_value);
    let lift_value = lift::lower_with_counter(mono_value, counter);
    let anf_value = anf::lower_with_counter(lift_value, counter);
    let go_value = go_backend::lower(anf_value);
    Compilation {
        ast_value,
        hir_value,
        tast_value,
        core_value,
        mono_value,
        lift_value,
        anf_value,
        go_value,
    }
}

pub fn compile_source_or_diagnostics(source_path: string, source: string) -> SourceCompilation {
    let parsed = parser::parse(source);
    if parsed.diagnostics.len() > 0 {
        return SourceCompilation::Diagnostics(
            compact_ast_diagnostics(parsed.diagnostics, source, true),
        )
    } else {
        ()
    };
    let ast_value = ast::lower(parsed);
    if ast_value.diagnostics.len() > 0 {
        return SourceCompilation::Diagnostics(
            compact_ast_diagnostics(ast_value.diagnostics, source, false),
        )
    } else {
        ()
    };
    match single_file_project_import(ast_value) {
        Some(package_path) => return SourceCompilation::Diagnostics(
            "single-file compilation cannot use project package " + package_path + "\n",
        ),
        None => (),
    };
    let ast_value = hir::expand_derives(ast_value);
    if ast_value.diagnostics.len() > 0 {
        return SourceCompilation::Diagnostics(
            compact_ast_diagnostics(ast_value.diagnostics, source, false),
        )
    } else {
        ()
    };
    let hir_value = hir::lower_expanded(ast_value, source_path);
    if hir_value.diagnostics.len() > 0 {
        return SourceCompilation::Diagnostics(
            compact_hir_diagnostics(hir_value.diagnostics, source),
        )
    } else {
        ()
    };
    let counter = Ref::new(0);
    let builtins = core::lower_builtins(counter);
    let standard = if has_standard_import(ast_value) {
        Option::Some(compile_standard_library(builtins, builtin_artifact_dependency().1))
    } else {
        Option::None
    };
    let hir_dependencies = match standard {
        Some(value) => selected_standard_hir(ast_value, value),
        None => Vec::new(),
    };
    let core_dependencies = match standard {
        Some(value) => selected_standard_core(ast_value, value),
        None => Vec::new(),
    };
    let tast_value = tast::check_for_link_with_dependencies(hir_value, hir_dependencies);
    if typer_diagnostics_have_errors(tast_value.diagnostics) {
        return SourceCompilation::Diagnostics(
            compact_typer_diagnostics(tast_value.diagnostics, source_path, source),
        )
    } else if !has_single_file_entrypoint(tast_value) {
        return SourceCompilation::Diagnostics("main function is required\n")
    } else {
        ()
    };
    let core_value = core::link_with_dependencies(
        builtins,
        core_dependencies,
        core::lower_with_counter_types_and_options(
            tast_value,
            counter,
            dependency_enums(builtins, core_dependencies),
            dependency_structs(builtins, core_dependencies),
            true,
        ),
    );
    let mono_result = mono::lower_checked(core_value);
    match mono_result.error {
        Some(error) => SourceCompilation::Diagnostics(error + "\n"),
        None => {
            let mono_value = mono_result.file;
            let lift_value = lift::lower_with_counter(mono_value, counter);
            let anf_value = anf::lower_with_counter(lift_value, counter);
            let go_value = go_backend::lower(anf_value);
            SourceCompilation::Compiled(
                Compilation {
                    ast_value,
                    hir_value,
                    tast_value,
                    core_value,
                    mono_value,
                    lift_value,
                    anf_value,
                    go_value,
                },
            )
        },
    }
}

fn pipeline_stage_output(stage: string, source_path: string, source: string) -> string {
    if stage == "cst" {
        cst::debug_tree(parser::parse(source))
    } else {
        let compilation = compile_source(source_path, source);
        if stage == "ast" {
            ast::pretty(compilation.ast_value)
        } else if stage == "hir" {
            hir::encode(compilation.hir_value)
        } else if stage == "tast" {
            tast::encode(compilation.tast_value)
        } else if stage == "core" {
            core::encode(compilation.core_value)
        } else if stage == "mono" {
            mono::encode(compilation.mono_value)
        } else if stage == "lift" {
            lift::encode(compilation.lift_value)
        } else if stage == "anf" {
            anf::encode(compilation.anf_value)
        } else if stage == "go" {
            go_backend::encode(compilation.go_value)
        } else {
            fail("unknown pipeline stage: " + stage);
            ""
        }
    }
}

fn print_dump(printed: Ref[bool], label: string, content: string) -> unit {
    if printed.get() {
        io::println("")
    } else {
        ()
    };
    io::println("== " + label + " ==");
    io::println(content);
    printed.set(true)
}

fn print_dumps(compilation: Compilation, args: RunArgs, go_source: string) -> unit {
    let printed = Ref::new(false);
    if args.dump_ast {
        print_dump(printed, "AST", ast::pretty(compilation.ast_value))
    } else {
        ()
    };
    if args.dump_hir {
        print_dump(printed, "HIR", hir::encode(compilation.hir_value))
    } else {
        ()
    };
    if args.dump_tast {
        print_dump(printed, "Typed AST", tast::encode(compilation.tast_value))
    } else {
        ()
    };
    if args.dump_core {
        print_dump(printed, "Core", core::encode(compilation.core_value))
    } else {
        ()
    };
    if args.dump_mono {
        print_dump(printed, "Mono", mono::encode(compilation.mono_value))
    } else {
        ()
    };
    if args.dump_lift {
        print_dump(printed, "Lifted", lift::encode(compilation.lift_value))
    } else {
        ()
    };
    if args.dump_anf {
        print_dump(printed, "ANF", anf::encode(compilation.anf_value))
    } else {
        ()
    };
    if args.dump_go {
        print_dump(printed, "Go", go_source)
    } else {
        ()
    }
}

fn write_stdout(data: bytes::Bytes) -> unit {
    match io::write_stdout(data) {
        Ok(()) => (),
        Err(error) => fail(error),
    }
}

fn bytes_to_string(data: bytes::Bytes) -> string {
    match data.to_string() {
        Ok(value) => value,
        Err(error) => fail_string(error),
    }
}

fn fail_string(message: string) -> string {
    fail(message);
    ""
}

fn ascii_whitespace_at(value: string, index: int) -> bool {
    let character = value.byte_slice(index, index + 1);
    character == " " || character == "\n" || character == "\r" || character == "\t"
}

fn trim_ascii(value: string) -> string {
    let start = Ref::new(0);
    let end = Ref::new(value.byte_len());
    while start.get() < end.get() && ascii_whitespace_at(value, start.get()) {
        start.set(start.get() + 1)
    };
    while end.get() > start.get() && ascii_whitespace_at(value, end.get() - 1) {
        end.set(end.get() - 1)
    };
    value.byte_slice(start.get(), end.get())
}

fn temp_root() -> string {
    match env::var("TMPDIR") {
        Some(value) => if value == "" {
            "/tmp"
        } else {
            value
        },
        None => "/tmp",
    }
}

fn temp_go_path(source_path: string, source: string) -> string {
    let directory = path::join(temp_root(), "gomlc-selfhost");
    match fs::create_dir_all(directory) {
        Ok(()) => (),
        Err(error) => fail(error),
    };
    let name = Hash::hash(source_path + "\n" + source).to_string() + ".go";
    path::join(directory, name)
}

fn command_succeeded(output: process::Output) -> bool {
    process::ExitStatus::success(process::Output::status(output))
}

fn try_execute_with_yaegi(directory: string, go_file: string) -> bool {
    let available = match process::Command::new("yaegi").arg("help").output() {
        Ok(output) => command_succeeded(output),
        Err(_) => false,
    };
    if !available {
        false
    } else {
        match process::Command::new("yaegi").arg("run").arg(go_file).current_dir(directory).env(
            "TZ",
            "UTC",
        ).output() {
            Ok(output) => if command_succeeded(output) {
                write_stdout(process::Output::stdout(output));
                true
            } else {
                false
            },
            Err(_) => false,
        }
    }
}

fn cleanup_temp_file(go_file: string) -> unit {
    let _ = process::Command::new("rm").arg("-f").arg(go_file).output();
    ()
}

fn execute_with_go_run(directory: string, go_file: string) -> unit {
    match process::Command::new("go").arg("run").arg(go_file).current_dir(directory).env(
        "TZ",
        "UTC",
    ).env("GOWORK", "off").env("GO111MODULE", "off").output() {
        Ok(output) => if command_succeeded(output) {
            write_stdout(process::Output::stdout(output))
        } else {
            fail("go run failed: " + trim_ascii(bytes_to_string(process::Output::stderr(output))))
        },
        Err(error) => fail("failed to execute go run: " + error),
    }
}

fn execute_go_source(source_path: string, source: string) -> unit {
    let go_file = temp_go_path(source_path, source);
    match fs::write_file(go_file, source) {
        Ok(()) => (),
        Err(error) => fail(error),
    };
    let directory = match path::parent(go_file) {
        Some(value) => value,
        None => temp_root(),
    };
    if try_execute_with_yaegi(directory, go_file) {
        ()
    } else {
        execute_with_go_run(directory, go_file)
    };
    cleanup_temp_file(go_file)
}

fn run_single(args: RunArgs) -> unit {
    let source = read_source(args.file);
    let compilation = compile_source(args.file, source);
    let go_source = go_backend::encode(compilation.go_value);
    print_dumps(compilation, args, go_source);
    execute_go_source(args.file, go_source)
}
