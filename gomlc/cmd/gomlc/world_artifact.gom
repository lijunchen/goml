package main;

use gomlc::artifact::core_codec as core_codec;
use gomlc::artifact::interface_codec as interface_codec;
use gomlc::artifact::wire as wire;
use gomlc::artifact;
use gomlc::core;
use gomlc::resources;
use std::bytes;
use std::fs;

fn world_metadata(counter: int) -> bytes::Bytes {
    let writer = wire::new_artifact_binary_writer();
    wire::artifact_binary_write_u64(writer, counter.to_uint64());
    wire::artifact_binary_writer_finish(writer)
}

fn world_decode_counter(data: bytes::Bytes) -> Result[int, string] {
    let reader = wire::new_artifact_binary_reader(data);
    let value = wire::artifact_binary_read_u64(reader)?;
    if value > 2147483647 {
        Result::Err("world artifact counter exceeds supported size")
    } else {
        Result::Ok(value.to_int())
    }
}

fn world_core_unit(
    package_name: string,
    declared_name: string,
    interface: artifact::ArtifactInterfaceUnit,
    exports: artifact::ArtifactPackageExports,
    value: core::File,
) -> artifact::ArtifactCoreUnit {
    artifact::ArtifactCoreUnit {
        package_name,
        declared_name,
        interface_hash: interface.interface_hash,
        exports,
        core_ir: value,
        deps: interface.deps,
        sources: Vec::[],
        tests: Vec::[],
    }
}

fn world_add_package_sections(
    sections: Vec[wire::ArtifactBinarySection],
    section_id: uint16,
    value: ArtifactStandardPackage,
) -> Result[unit, string] {
    let interface = interface_codec::encode_binary(value.interface_unit)?;
    let core = core_codec::encode_binary(
        world_core_unit(
            value.interface_unit.package_name,
            value.interface_unit.package_interface.name,
            value.interface_unit,
            value.environment_exports,
            value.core_value,
        ),
    )?;
    sections.push(
        wire::ArtifactBinarySection {
            id: section_id,
            version: 1,
            flags: wire::required_section_flag(),
            data: interface,
        },
    );
    sections.push(
        wire::ArtifactBinarySection {
            id: section_id + 1,
            version: 1,
            flags: wire::required_section_flag(),
            data: core,
        },
    );
    Result::Ok(())
}

fn world_add_standard_sections(
    sections: Vec[wire::ArtifactBinarySection],
    value: ArtifactStandardLibrary,
) -> Result[unit, string] {
    let packages: Vec[(uint16, ArtifactStandardPackage)] = Vec::[
        (10.to_uint16(), value.root),
        (12.to_uint16(), value.host),
        (14.to_uint16(), value.bytes),
        (16.to_uint16(), value.collections),
        (18.to_uint16(), value.env),
        (20.to_uint16(), value.fs),
        (22.to_uint16(), value.io),
        (24.to_uint16(), value.json),
        (26.to_uint16(), value.path),
        (28.to_uint16(), value.process),
        (30.to_uint16(), value.testing),
        (32.to_uint16(), value.text),
        (34.to_uint16(), value.num),
        (36.to_uint16(), value.time),
        (38.to_uint16(), value.ascii),
        (40.to_uint16(), value.iter),
        (42.to_uint16(), value.cmp),
        (44.to_uint16(), value.internal_task),
        (46.to_uint16(), value.task),
        (48.to_uint16(), value.serde),
        (50.to_uint16(), value.toml),
        (52.to_uint16(), value.bincode),
        (54.to_uint16(), value.error),
        (56.to_uint16(), value.utf8),
        (58.to_uint16(), value.unicode),
        (60.to_uint16(), value.math),
        (62.to_uint16(), value.rand),
        (64.to_uint16(), value.crypto),
        (66.to_uint16(), value.crypto_hash),
        (68.to_uint16(), value.crypto_rand),
    ];
    for package_value in packages {
        world_add_package_sections(sections, package_value.0, package_value.1)?
    }
    Result::Ok(())
}

fn encode_package_world(value: PackageWorld) -> Result[bytes::Bytes, string] {
    let builtin_interface = interface_codec::encode_binary(value.builtin_interface)?;
    let builtin_core = core_codec::encode_binary(
        world_core_unit(
            "builtin",
            "builtin",
            value.builtin_interface,
            value.builtin_interface.exports,
            value.builtins,
        ),
    )?;
    let sections = Vec::[
        wire::ArtifactBinarySection {
            id: 1,
            version: 1,
            flags: wire::required_section_flag(),
            data: world_metadata(value.counter.get()),
        },
        wire::ArtifactBinarySection {
            id: 2,
            version: 1,
            flags: wire::required_section_flag(),
            data: builtin_interface,
        },
        wire::ArtifactBinarySection {
            id: 3,
            version: 1,
            flags: wire::required_section_flag(),
            data: builtin_core,
        },
    ];
    world_add_package_sections(sections, 4.to_uint16(), value.prelude)?;
    world_add_standard_sections(sections, value.standard)?;
    wire::encode_artifact_binary_container(3, sections)
}

fn world_required_section(value: wire::ArtifactBinaryContainer, id: uint16) -> Result[
    wire::ArtifactBinarySection,
    string,
] {
    match wire::artifact_binary_find_section(value, id) {
        Some(section) => if section.version != 1 || section.flags != wire::required_section_flag() {
            Result::Err("invalid world artifact section")
        } else {
            Result::Ok(section)
        },
        None => Result::Err("world artifact is missing a required section"),
    }
}

fn world_dependencies_equal(left: Vec[(string, string)], right: Vec[(string, string)]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if left[index] != right[index] {
                return false
            } else {}
        }
        true
    }
}

fn world_decode_package(
    value: wire::ArtifactBinaryContainer,
    section_id: uint16,
    expected_name: string,
) -> Result[ArtifactStandardPackage, string] {
    let interface_section = world_required_section(value, section_id)?;
    let core_section = world_required_section(value, section_id + 1)?;
    let interface = interface_codec::decode_binary(interface_section.data)?;
    let core = core_codec::decode_binary(core_section.data)?;
    if interface.package_name != expected_name || core.package_name != expected_name
        || core.interface_hash != interface.interface_hash
        || !world_dependencies_equal(core.deps, interface.deps) {
        Result::Err("world artifact package identity does not match")
    } else {
        Result::Ok(
            ArtifactStandardPackage {
                core_value: core.core_ir,
                interface_unit: interface,
                environment_exports: core.exports,
            },
        )
    }
}

fn world_standard_packages(value: ArtifactStandardLibrary) -> Vec[ArtifactStandardPackage] {
    Vec::[
        value.root,
        value.host,
        value.ascii,
        value.bincode,
        value.bytes,
        value.cmp,
        value.collections,
        value.error,
        value.env,
        value.fs,
        value.io,
        value.internal_task,
        value.iter,
        value.json,
        value.num,
        value.path,
        value.process,
        value.serde,
        value.task,
        value.testing,
        value.text,
        value.toml,
        value.time,
        value.utf8,
        value.unicode,
        value.math,
        value.rand,
        value.crypto,
        value.crypto_hash,
        value.crypto_rand,
    ]
}

fn world_validate_standard_dependencies(
    value: ArtifactStandardLibrary,
    builtin_hash: string,
    prelude_hash: string,
) -> Result[unit, string] {
    for package_value in world_standard_packages(value) {
        if !artifact_interface_has_dependency(package_value.interface_unit, "builtin", builtin_hash) {
            return Result::Err("world artifact standard package builtin dependency does not match")
        } else if !artifact_interface_has_dependency(
            package_value.interface_unit,
            "prelude",
            prelude_hash,
        ) {
            return Result::Err("world artifact standard package prelude dependency does not match")
        } else {}
    }
    Result::Ok(())
}

fn decode_package_world(data: bytes::Bytes) -> Result[PackageWorld, string] {
    let container = wire::decode_artifact_binary_container(data)?;
    if container.kind != 3 {
        return Result::Err("binary artifact is not a compiler world")
    } else {};
    let counter_section = world_required_section(container, 1)?;
    let counter = Ref::new(world_decode_counter(counter_section.data)?);
    let builtin_interface_section = world_required_section(container, 2)?;
    let builtin_core_section = world_required_section(container, 3)?;
    let builtin_interface = interface_codec::decode_binary(builtin_interface_section.data)?;
    let builtin_core = core_codec::decode_binary(builtin_core_section.data)?;
    if builtin_interface.package_name != "builtin" || builtin_core.package_name != "builtin"
        || builtin_core.interface_hash != builtin_interface.interface_hash
        || !world_dependencies_equal(builtin_core.deps, builtin_interface.deps) {
        return Result::Err("world artifact builtin identity does not match")
    } else {};
    let prelude = world_decode_package(container, 4, "prelude")?;
    if !artifact_interface_has_dependency(
        prelude.interface_unit,
        "builtin",
        builtin_interface.interface_hash,
    ) {
        return Result::Err("world artifact prelude builtin dependency does not match")
    } else {};
    let root = world_decode_package(container, 10, resources::STD_ROOT_PACKAGE)?;
    let host = world_decode_package(container, 12, resources::STD_INTERNAL_HOST_PACKAGE)?;
    let bytes = world_decode_package(container, 14, resources::STD_BYTES_PACKAGE)?;
    let collections = world_decode_package(container, 16, resources::STD_COLLECTIONS_PACKAGE)?;
    let env = world_decode_package(container, 18, resources::STD_ENV_PACKAGE)?;
    let fs_value = world_decode_package(container, 20, resources::STD_FS_PACKAGE)?;
    let io_value = world_decode_package(container, 22, resources::STD_IO_PACKAGE)?;
    let json = world_decode_package(container, 24, resources::STD_JSON_PACKAGE)?;
    let path_value = world_decode_package(container, 26, resources::STD_PATH_PACKAGE)?;
    let process = world_decode_package(container, 28, resources::STD_PROCESS_PACKAGE)?;
    let testing = world_decode_package(container, 30, resources::STD_TESTING_PACKAGE)?;
    let text_value = world_decode_package(container, 32, resources::STD_TEXT_PACKAGE)?;
    let num = world_decode_package(container, 34, resources::STD_NUM_PACKAGE)?;
    let time_value = world_decode_package(container, 36, resources::STD_TIME_PACKAGE)?;
    let ascii = world_decode_package(container, 38, resources::STD_ASCII_PACKAGE)?;
    let iter = world_decode_package(container, 40, resources::STD_ITER_PACKAGE)?;
    let cmp = world_decode_package(container, 42, resources::STD_CMP_PACKAGE)?;
    let internal_task = world_decode_package(container, 44, resources::STD_INTERNAL_TASK_PACKAGE)?;
    let task = world_decode_package(container, 46, resources::STD_TASK_PACKAGE)?;
    let serde = world_decode_package(container, 48, resources::STD_SERDE_PACKAGE)?;
    let toml = world_decode_package(container, 50, resources::STD_TOML_PACKAGE)?;
    let bincode = world_decode_package(container, 52, resources::STD_BINCODE_PACKAGE)?;
    let error = world_decode_package(container, 54, resources::STD_ERROR_PACKAGE)?;
    let utf8 = world_decode_package(container, 56, resources::STD_UTF8_PACKAGE)?;
    let unicode = world_decode_package(container, 58, resources::STD_UNICODE_PACKAGE)?;
    let math = world_decode_package(container, 60, resources::STD_MATH_PACKAGE)?;
    let rand = world_decode_package(container, 62, resources::STD_RAND_PACKAGE)?;
    let crypto = world_decode_package(container, 64, resources::STD_CRYPTO_PACKAGE)?;
    let crypto_hash = world_decode_package(container, 66, resources::STD_CRYPTO_HASH_PACKAGE)?;
    let crypto_rand = world_decode_package(container, 68, resources::STD_CRYPTO_RAND_PACKAGE)?;
    let standard = ArtifactStandardLibrary {
        root,
        host,
        ascii,
        bincode,
        bytes,
        cmp,
        collections,
        error,
        env,
        fs: fs_value,
        io: io_value,
        internal_task,
        iter,
        json,
        num,
        path: path_value,
        process,
        serde,
        task,
        testing,
        text: text_value,
        toml,
        time: time_value,
        utf8,
        unicode,
        math,
        rand,
        crypto,
        crypto_hash,
        crypto_rand,
    };
    world_validate_standard_dependencies(
        standard,
        builtin_interface.interface_hash,
        prelude.interface_unit.interface_hash,
    )?;
    let world = PackageWorld {
        counter,
        builtins: builtin_core.core_ir,
        builtin_interface,
        prelude,
        standard,
    };
    artifact_prepare_world(world);
    Result::Ok(world)
}

fn read_package_world(path: string) -> Result[PackageWorld, string] {
    let data = match fs::read_bytes(path) {
        Ok(value) => value,
        Err(error) => return Result::Err("failed to read compiler world " + path + ": " + error),
    };
    match decode_package_world(data) {
        Ok(value) => Result::Ok(value),
        Err(error) => Result::Err("failed to parse compiler world " + path + ": " + error),
    }
}

fn write_package_world(path: string, value: PackageWorld) -> Result[unit, string] {
    let data = encode_package_world(value)?;
    match ensure_parent(path) {
        Ok(()) => fs::write_bytes(path, data),
        Err(error) => Result::Err(error),
    }
}

fn parse_prepare_world_args(args: Vec[string]) -> Result[string, string] {
    let mut output: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if argument == "--output" {
            if option_string_present(output) {
                return Result::Err(
                    repeated_argument_error(PREPARE_WORLD_COMMAND, "--output <OUTPUT>"),
                )
            } else if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else {
                output = Option::Some(args[index + 1]);
                index = index + 2;
            }
        } else if option_string_present(inline_cli_value(argument, "--output")) {
            if option_string_present(output) {
                return Result::Err(
                    repeated_argument_error(PREPARE_WORLD_COMMAND, "--output <OUTPUT>"),
                )
            } else if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else {
                output = inline_cli_value(argument, "--output");
                index = index + 1;
            }
        } else {
            return Result::Err(unexpected_argument_error(PREPARE_WORLD_COMMAND, argument, false))
        }
    }
    match output {
        Some(value) => Result::Ok(value),
        None => {
            let missing: Vec[string] = Vec::["--output <OUTPUT>"];
            Result::Err(missing_required_arguments_error(PREPARE_WORLD_COMMAND, missing))
        },
    }
}

fn run_prepare_world(args: Vec[string]) -> unit {
    match parse_prepare_world_args(args) {
        Ok(output) => match write_package_world(output, package_world()) {
            Ok(()) => (),
            Err(error) => fail(COMPILE_ERROR_PREFIX + error),
        },
        Err(error) => handle_cli_parse_error(PREPARE_WORLD_COMMAND, error),
    }
}
