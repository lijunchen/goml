package main;

use module::artifact::core_codec as core_codec;
use module::artifact::interface_codec as interface_codec;
use module::artifact::wire as wire;
use module::artifact;
use module::core;
use module::resources;
use module::version;
use std::bytes;
use std::fs;

const WORLD_ARTIFACT_FORMAT: isize = 18;

const WORLD_COMPILER_ABI: isize = 5;

struct WorldMetadata {
    counter: isize,
    package_count: isize,
    artifact_format: isize,
    compiler_abi: isize,
    compiler_identity: string,
    source_digest: string,
    builtin_package: string,
    prelude_package: string,
}

fn world_metadata_v1(counter: isize) -> bytes::Bytes {
    let writer = wire::new_artifact_binary_writer();
    wire::artifact_binary_write_u64(writer, counter.to_u64());
    wire::artifact_binary_writer_finish(writer)
}

fn world_encode_metadata_v2(value: WorldMetadata) -> bytes::Bytes {
    let writer = wire::new_artifact_binary_writer();
    wire::artifact_binary_write_u64(writer, value.counter.to_u64());
    wire::artifact_binary_write_u64(writer, value.package_count.to_u64());
    wire::artifact_binary_write_u64(writer, value.artifact_format.to_u64());
    wire::artifact_binary_write_u64(writer, value.compiler_abi.to_u64());
    wire::artifact_binary_write_string(writer, value.compiler_identity);
    wire::artifact_binary_write_string(writer, value.source_digest);
    wire::artifact_binary_write_string(writer, value.builtin_package);
    wire::artifact_binary_write_string(writer, value.prelude_package);
    wire::artifact_binary_writer_finish(writer)
}

fn world_metadata_v2(value: PackageWorld, package_count: isize) -> bytes::Bytes {
    world_encode_metadata_v2(
        WorldMetadata {
            counter: value.counter.get(),
            package_count,
            artifact_format: WORLD_ARTIFACT_FORMAT,
            compiler_abi: WORLD_COMPILER_ABI,
            compiler_identity: version::current(),
            source_digest: value.source_digest,
            builtin_package: "builtin",
            prelude_package: "prelude",
        },
    )
}

fn world_decode_supported_int(value: u64, name: string) -> Result[isize, string] {
    if value > 2147483647 {
        Result::Err("world artifact " + name + " exceeds supported size")
    } else {
        Result::Ok(value.to_isize())
    }
}

fn world_decode_metadata_v1(data: bytes::Bytes) -> Result[WorldMetadata, string] {
    let reader = wire::new_artifact_binary_reader(data);
    let counter = world_decode_supported_int(wire::artifact_binary_read_u64(reader)?, "counter")?;
    if wire::artifact_binary_reader_remaining(reader) != 0 {
        Result::Err("world artifact metadata has trailing data")
    } else {
        Result::Ok(
            WorldMetadata {
                counter,
                package_count: 0,
                artifact_format: WORLD_ARTIFACT_FORMAT,
                compiler_abi: WORLD_COMPILER_ABI,
                compiler_identity: version::current(),
                source_digest: "",
                builtin_package: "builtin",
                prelude_package: "prelude",
            },
        )
    }
}

fn world_decode_metadata_v2(data: bytes::Bytes) -> Result[WorldMetadata, string] {
    let reader = wire::new_artifact_binary_reader(data);
    let counter = world_decode_supported_int(wire::artifact_binary_read_u64(reader)?, "counter")?;
    let package_count = world_decode_supported_int(
        wire::artifact_binary_read_u64(reader)?,
        "package count",
    )?;
    let artifact_format = world_decode_supported_int(
        wire::artifact_binary_read_u64(reader)?,
        "artifact format",
    )?;
    let compiler_abi = world_decode_supported_int(
        wire::artifact_binary_read_u64(reader)?,
        "compiler ABI",
    )?;
    let compiler_identity = wire::artifact_binary_read_string(reader)?;
    let source_digest = wire::artifact_binary_read_string(reader)?;
    let builtin_package = wire::artifact_binary_read_string(reader)?;
    let prelude_package = wire::artifact_binary_read_string(reader)?;
    if package_count < 2 {
        Result::Err("world artifact must contain builtin and prelude packages")
    } else if package_count > 511 {
        Result::Err("world artifact contains too many packages")
    } else if wire::artifact_binary_reader_remaining(reader) != 0 {
        Result::Err("world artifact metadata has trailing data")
    } else {
        Result::Ok(
            WorldMetadata {
                counter,
                package_count,
                artifact_format,
                compiler_abi,
                compiler_identity,
                source_digest,
                builtin_package,
                prelude_package,
            },
        )
    }
}

fn world_core_unit(
    package_name: string,
    declared_name: string,
    interface: artifact::ArtifactInterfaceUnit,
    exports: artifact::ArtifactPackageExports,
    value: core::File,
) -> artifact::ArtifactCoreUnit {
    artifact::ArtifactCoreUnit {
        package_name,
        declared_name,
        interface_hash: interface.interface_hash,
        exports,
        core_ir: value,
        deps: interface.deps,
        sources: Vec::from_array([]),
        tests: Vec::from_array([]),
    }
}

fn world_add_package_sections(
    sections: Vec[wire::ArtifactBinarySection],
    section_id: u16,
    value: ToolchainPackage,
) -> Result[unit, string] {
    let interface = interface_codec::encode_binary(value.interface_unit)?;
    let core = core_codec::encode_binary(
        world_core_unit(
            value.interface_unit.package_name,
            value.interface_unit.package_interface.name,
            value.interface_unit,
            value.environment_exports,
            value.core_value,
        ),
    )?;
    sections.push(
        wire::ArtifactBinarySection {
            id: section_id,
            version: 1,
            flags: wire::required_section_flag(),
            data: interface,
        },
    );
    sections.push(
        wire::ArtifactBinarySection {
            id: section_id + 1,
            version: 1,
            flags: wire::required_section_flag(),
            data: core,
        },
    );
    Result::Ok(())
}

fn world_builtin_package(value: PackageWorld) -> ToolchainPackage {
    ToolchainPackage {
        core_value: value.builtins,
        interface_unit: value.builtin_interface,
        environment_exports: value.builtin_interface.exports,
    }
}

fn world_all_packages(value: PackageWorld) -> Vec[ToolchainPackage] {
    let result = Vec::from_array([world_builtin_package(value), value.prelude]);
    for package_value in value.standard {
        result.push(package_value)
    }
    result
}

fn world_find_package(values: Vec[ToolchainPackage], package_name: string) -> Option[
    ToolchainPackage,
] {
    for value in values {
        if value.interface_unit.package_name == package_name {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn world_required_package(values: Vec[ToolchainPackage], package_name: string) -> Result[
    ToolchainPackage,
    string,
] {
    match world_find_package(values, package_name) {
        Some(value) => Result::Ok(value),
        None => Result::Err("world artifact is missing package " + package_name),
    }
}

fn world_sorted_packages(values: Vec[ToolchainPackage]) -> Result[Vec[ToolchainPackage], string] {
    let names: Vec[string] = Vec::from_array([]);
    for value in values {
        names.push(value.interface_unit.package_name)
    }
    let names = wire::sort_artifact_names(names);
    let result: Vec[ToolchainPackage] = Vec::from_array([]);
    let mut previous: Option[string] = Option::None;
    for name in names {
        match previous {
            Some(value) => if value == name {
                return Result::Err("world artifact contains duplicate package " + name)
            } else {},
            None => (),
        };
        result.push(world_required_package(values, name)?);
        previous = Option::Some(name);
    }
    Result::Ok(result)
}

fn world_v1_package_section_id(package_name: string) -> Option[u16] {
    match package_name {
        "builtin" => Option::Some(2.to_u16()),
        "prelude" => Option::Some(4.to_u16()),
        resources::STD_ROOT_PACKAGE => Option::Some(10.to_u16()),
        resources::STD_INTERNAL_HOST_PACKAGE => Option::Some(12.to_u16()),
        resources::STD_BYTES_PACKAGE => Option::Some(14.to_u16()),
        resources::STD_COLLECTIONS_PACKAGE => Option::Some(16.to_u16()),
        resources::STD_ENV_PACKAGE => Option::Some(18.to_u16()),
        resources::STD_FS_PACKAGE => Option::Some(20.to_u16()),
        resources::STD_IO_PACKAGE => Option::Some(22.to_u16()),
        resources::STD_JSON_PACKAGE => Option::Some(24.to_u16()),
        resources::STD_PATH_PACKAGE => Option::Some(26.to_u16()),
        resources::STD_PROCESS_PACKAGE => Option::Some(28.to_u16()),
        resources::STD_TESTING_PACKAGE => Option::Some(30.to_u16()),
        resources::STD_TEXT_PACKAGE => Option::Some(32.to_u16()),
        resources::STD_NUM_PACKAGE => Option::Some(34.to_u16()),
        resources::STD_TIME_PACKAGE => Option::Some(36.to_u16()),
        resources::STD_ASCII_PACKAGE => Option::Some(38.to_u16()),
        resources::STD_ITER_PACKAGE => Option::Some(40.to_u16()),
        resources::STD_CMP_PACKAGE => Option::Some(42.to_u16()),
        resources::STD_INTERNAL_TASK_PACKAGE => Option::Some(44.to_u16()),
        resources::STD_TASK_PACKAGE => Option::Some(46.to_u16()),
        resources::STD_SERDE_PACKAGE => Option::Some(48.to_u16()),
        resources::STD_TOML_PACKAGE => Option::Some(50.to_u16()),
        resources::STD_BINCODE_PACKAGE => Option::Some(52.to_u16()),
        resources::STD_ERROR_PACKAGE => Option::Some(54.to_u16()),
        resources::STD_UTF8_PACKAGE => Option::Some(56.to_u16()),
        resources::STD_UNICODE_PACKAGE => Option::Some(58.to_u16()),
        resources::STD_MATH_PACKAGE => Option::Some(60.to_u16()),
        resources::STD_RAND_PACKAGE => Option::Some(62.to_u16()),
        resources::STD_CRYPTO_PACKAGE => Option::Some(64.to_u16()),
        resources::STD_CRYPTO_HASH_PACKAGE => Option::Some(66.to_u16()),
        resources::STD_CRYPTO_RAND_PACKAGE => Option::Some(68.to_u16()),
        resources::STD_CHANNEL_PACKAGE => Option::Some(70.to_u16()),
        _ => Option::None,
    }
}

fn encode_package_world_v1(value: PackageWorld) -> Result[bytes::Bytes, string] {
    let sections: Vec[wire::ArtifactBinarySection] = Vec::from_array(
        [
            wire::ArtifactBinarySection {
                id: 1,
                version: 1,
                flags: wire::required_section_flag(),
                data: world_metadata_v1(value.counter.get()),
            },
        ],
    );
    for package_value in world_all_packages(value) {
        let section_id = match world_v1_package_section_id(
            package_value.interface_unit.package_name,
        ) {
            Some(value) => value,
            None => return Result::Err(
                "world v1 cannot encode package " + package_value.interface_unit.package_name,
            ),
        };
        world_add_package_sections(sections, section_id, package_value)?
    }
    wire::encode_artifact_binary_container(3, sections)
}

fn encode_package_world(value: PackageWorld) -> Result[bytes::Bytes, string] {
    let packages = world_sorted_packages(world_all_packages(value))?;
    let sections: Vec[wire::ArtifactBinarySection] = Vec::from_array(
        [
            wire::ArtifactBinarySection {
                id: 1,
                version: 2,
                flags: wire::required_section_flag(),
                data: world_metadata_v2(value, packages.len()),
            },
        ],
    );
    for index in 0..packages.len() {
        world_add_package_sections(sections, (2 + index * 2).to_u16(), packages[index])?
    }
    wire::encode_artifact_binary_container(3, sections)
}

fn world_required_section_version(value: wire::ArtifactBinaryContainer, id: u16, version: u16) -> Result[
    wire::ArtifactBinarySection,
    string,
] {
    match wire::artifact_binary_find_section(value, id) {
        Some(section) => if section.version != version
            || section.flags != wire::required_section_flag() {
            Result::Err("invalid world artifact section")
        } else {
            Result::Ok(section)
        },
        None => Result::Err("world artifact is missing a required section"),
    }
}

fn world_required_section(value: wire::ArtifactBinaryContainer, id: u16) -> Result[
    wire::ArtifactBinarySection,
    string,
] {
    world_required_section_version(value, id, 1.to_u16())
}

fn world_dependencies_equal(left: Vec[(string, string)], right: Vec[(string, string)]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if left[index] != right[index] {
                return false
            } else {}
        }
        true
    }
}

fn world_decode_package(
    value: wire::ArtifactBinaryContainer,
    section_id: u16,
    expected_name: string,
) -> Result[ToolchainPackage, string] {
    let interface_section = world_required_section(value, section_id)?;
    let core_section = world_required_section(value, section_id + 1)?;
    let interface = interface_codec::decode_binary(interface_section.data)?;
    let core = core_codec::decode_binary(core_section.data)?;
    if interface.package_name != expected_name || core.package_name != expected_name
        || core.interface_hash != interface.interface_hash
        || !world_dependencies_equal(core.deps, interface.deps) {
        Result::Err("world artifact package identity does not match")
    } else {
        Result::Ok(
            ToolchainPackage {
                core_value: core.core_ir,
                interface_unit: interface,
                environment_exports: core.exports,
            },
        )
    }
}

fn world_decode_package_any(value: wire::ArtifactBinaryContainer, section_id: u16) -> Result[
    ToolchainPackage,
    string,
] {
    let interface_section = world_required_section(value, section_id)?;
    let core_section = world_required_section(value, section_id + 1)?;
    let interface = interface_codec::decode_binary(interface_section.data)?;
    let core = core_codec::decode_binary(core_section.data)?;
    if core.package_name != interface.package_name
        || core.interface_hash != interface.interface_hash
        || !world_dependencies_equal(core.deps, interface.deps) {
        Result::Err("world artifact package identity does not match")
    } else {
        Result::Ok(
            ToolchainPackage {
                core_value: core.core_ir,
                interface_unit: interface,
                environment_exports: core.exports,
            },
        )
    }
}

fn world_validate_standard_dependencies(
    value: Vec[ToolchainPackage],
    builtin_hash: string,
    prelude_hash: string,
) -> Result[unit, string] {
    for package_value in value {
        if !artifact_interface_has_dependency(package_value.interface_unit, "builtin", builtin_hash) {
            return Result::Err("world artifact standard package builtin dependency does not match")
        } else if !artifact_interface_has_dependency(
            package_value.interface_unit,
            "prelude",
            prelude_hash,
        ) {
            return Result::Err("world artifact standard package prelude dependency does not match")
        } else {}
    }
    Result::Ok(())
}

fn world_validate_standard_packages(value: Vec[ToolchainPackage]) -> Result[unit, string] {
    for spec in resources::standard_package_specs() {
        world_required_package(value, spec.name)?;
    }
    if value.len() != resources::standard_package_specs().len() {
        Result::Err("world artifact standard package set does not match")
    } else {
        Result::Ok(())
    }
}

fn world_from_packages(metadata: WorldMetadata, packages: Vec[ToolchainPackage]) -> Result[
    PackageWorld,
    string,
] {
    if metadata.artifact_format != WORLD_ARTIFACT_FORMAT {
        return Result::Err("world artifact format does not match compiler")
    } else if metadata.compiler_abi != WORLD_COMPILER_ABI {
        return Result::Err("world compiler ABI does not match compiler")
    } else if metadata.compiler_identity != version::current() {
        return Result::Err("world compiler identity does not match compiler")
    } else if metadata.builtin_package != "builtin" || metadata.prelude_package != "prelude" {
        return Result::Err("world builtin or prelude package identity does not match")
    } else {};
    let builtin = world_required_package(packages, metadata.builtin_package)?;
    let prelude = world_required_package(packages, metadata.prelude_package)?;
    if !artifact_interface_has_dependency(
        prelude.interface_unit,
        "builtin",
        builtin.interface_unit.interface_hash,
    ) {
        return Result::Err("world artifact prelude builtin dependency does not match")
    } else {};
    let standard: Vec[ToolchainPackage] = Vec::from_array([]);
    for package_value in packages {
        if package_value.interface_unit.package_name != "builtin"
            && package_value.interface_unit.package_name != "prelude" {
            standard.push(package_value)
        } else {}
    }
    world_validate_standard_packages(standard)?;
    world_validate_standard_dependencies(
        standard,
        builtin.interface_unit.interface_hash,
        prelude.interface_unit.interface_hash,
    )?;
    let world = PackageWorld {
        counter: Ref::new(metadata.counter),
        source_digest: metadata.source_digest,
        builtins: builtin.core_value,
        builtin_interface: builtin.interface_unit,
        prelude,
        standard,
    };
    artifact_prepare_world(world);
    Result::Ok(world)
}

fn decode_package_world_v1(
    container: wire::ArtifactBinaryContainer,
    metadata_section: wire::ArtifactBinarySection,
) -> Result[PackageWorld, string] {
    let metadata = world_decode_metadata_v1(metadata_section.data)?;
    let builtin_interface_section = world_required_section(container, 2)?;
    let builtin_core_section = world_required_section(container, 3)?;
    let builtin_interface = interface_codec::decode_binary(builtin_interface_section.data)?;
    let builtin_core = core_codec::decode_binary(builtin_core_section.data)?;
    if builtin_interface.package_name != "builtin" || builtin_core.package_name != "builtin"
        || builtin_core.interface_hash != builtin_interface.interface_hash
        || !world_dependencies_equal(builtin_core.deps, builtin_interface.deps) {
        return Result::Err("world artifact builtin identity does not match")
    } else {};
    let prelude = world_decode_package(container, 4, "prelude")?;
    if !artifact_interface_has_dependency(
        prelude.interface_unit,
        "builtin",
        builtin_interface.interface_hash,
    ) {
        return Result::Err("world artifact prelude builtin dependency does not match")
    } else {};
    let root = world_decode_package(container, 10, resources::STD_ROOT_PACKAGE)?;
    let host = world_decode_package(container, 12, resources::STD_INTERNAL_HOST_PACKAGE)?;
    let bytes = world_decode_package(container, 14, resources::STD_BYTES_PACKAGE)?;
    let collections = world_decode_package(container, 16, resources::STD_COLLECTIONS_PACKAGE)?;
    let env = world_decode_package(container, 18, resources::STD_ENV_PACKAGE)?;
    let fs_value = world_decode_package(container, 20, resources::STD_FS_PACKAGE)?;
    let io_value = world_decode_package(container, 22, resources::STD_IO_PACKAGE)?;
    let json = world_decode_package(container, 24, resources::STD_JSON_PACKAGE)?;
    let path_value = world_decode_package(container, 26, resources::STD_PATH_PACKAGE)?;
    let process = world_decode_package(container, 28, resources::STD_PROCESS_PACKAGE)?;
    let testing = world_decode_package(container, 30, resources::STD_TESTING_PACKAGE)?;
    let text_value = world_decode_package(container, 32, resources::STD_TEXT_PACKAGE)?;
    let num = world_decode_package(container, 34, resources::STD_NUM_PACKAGE)?;
    let time_value = world_decode_package(container, 36, resources::STD_TIME_PACKAGE)?;
    let ascii = world_decode_package(container, 38, resources::STD_ASCII_PACKAGE)?;
    let iter = world_decode_package(container, 40, resources::STD_ITER_PACKAGE)?;
    let cmp = world_decode_package(container, 42, resources::STD_CMP_PACKAGE)?;
    let internal_task = world_decode_package(container, 44, resources::STD_INTERNAL_TASK_PACKAGE)?;
    let task = world_decode_package(container, 46, resources::STD_TASK_PACKAGE)?;
    let serde = world_decode_package(container, 48, resources::STD_SERDE_PACKAGE)?;
    let toml = world_decode_package(container, 50, resources::STD_TOML_PACKAGE)?;
    let bincode = world_decode_package(container, 52, resources::STD_BINCODE_PACKAGE)?;
    let error = world_decode_package(container, 54, resources::STD_ERROR_PACKAGE)?;
    let utf8 = world_decode_package(container, 56, resources::STD_UTF8_PACKAGE)?;
    let unicode = world_decode_package(container, 58, resources::STD_UNICODE_PACKAGE)?;
    let math = world_decode_package(container, 60, resources::STD_MATH_PACKAGE)?;
    let rand = world_decode_package(container, 62, resources::STD_RAND_PACKAGE)?;
    let crypto = world_decode_package(container, 64, resources::STD_CRYPTO_PACKAGE)?;
    let crypto_hash = world_decode_package(container, 66, resources::STD_CRYPTO_HASH_PACKAGE)?;
    let crypto_rand = world_decode_package(container, 68, resources::STD_CRYPTO_RAND_PACKAGE)?;
    let channel = world_decode_package(container, 70, resources::STD_CHANNEL_PACKAGE)?;
    world_from_packages(
        metadata,
        Vec::from_array(
            [
                ToolchainPackage {
                    core_value: builtin_core.core_ir,
                    interface_unit: builtin_interface,
                    environment_exports: builtin_core.exports,
                },
                prelude,
                root,
                host,
                ascii,
                bincode,
                bytes,
                cmp,
                collections,
                error,
                env,
                fs_value,
                io_value,
                internal_task,
                iter,
                json,
                num,
                path_value,
                process,
                serde,
                task,
                testing,
                text_value,
                toml,
                time_value,
                utf8,
                unicode,
                math,
                rand,
                crypto,
                crypto_hash,
                crypto_rand,
                channel,
            ],
        ),
    )
}

fn decode_package_world_v2(
    container: wire::ArtifactBinaryContainer,
    metadata_section: wire::ArtifactBinarySection,
) -> Result[PackageWorld, string] {
    let metadata = world_decode_metadata_v2(metadata_section.data)?;
    if container.sections.len() != 1 + metadata.package_count * 2 {
        return Result::Err("world artifact package section count does not match")
    } else {};
    let packages: Vec[ToolchainPackage] = Vec::from_array([]);
    let names: Vec[string] = Vec::from_array([]);
    for index in 0..metadata.package_count {
        let package_value = world_decode_package_any(container, (2 + index * 2).to_u16())?;
        names.push(package_value.interface_unit.package_name);
        packages.push(package_value)
    }
    let sorted_names: Vec[string] = Vec::from_array([]);
    for name in names {
        sorted_names.push(name)
    }
    let sorted_names = wire::sort_artifact_names(sorted_names);
    for index in 0..names.len() {
        if names[index] != sorted_names[index] {
            return Result::Err("world artifact packages are not sorted")
        } else if index > 0 && names[index] == names[index - 1] {
            return Result::Err("world artifact contains duplicate package " + names[index])
        } else {}
    }
    world_from_packages(metadata, packages)
}

fn decode_package_world(data: bytes::Bytes) -> Result[PackageWorld, string] {
    let container = wire::decode_artifact_binary_container(data)?;
    if container.kind != 3 {
        return Result::Err("binary artifact is not a compiler world")
    } else {};
    let metadata_section = match wire::artifact_binary_find_section(container, 1) {
        Some(value) => value,
        None => return Result::Err("world artifact is missing a required section"),
    };
    if metadata_section.flags != wire::required_section_flag() {
        return Result::Err("invalid world artifact section")
    } else {};
    match metadata_section.version {
        1 => decode_package_world_v1(container, metadata_section),
        2 => decode_package_world_v2(container, metadata_section),
        _ => Result::Err("unsupported world artifact version"),
    }
}

fn read_package_world(path: string) -> Result[PackageWorld, string] {
    let data = match fs::read_bytes(path) {
        Ok(value) => value,
        Err(error) => return Result::Err("failed to read compiler world " + path + ": " + error),
    };
    match decode_package_world(data) {
        Ok(value) => Result::Ok(value),
        Err(error) => Result::Err("failed to parse compiler world " + path + ": " + error),
    }
}

fn write_package_world(path: string, value: PackageWorld) -> Result[unit, string] {
    let data = encode_package_world(value)?;
    match ensure_parent(path) {
        Ok(()) => fs::write_bytes(path, data),
        Err(error) => Result::Err(error),
    }
}

fn parse_prepare_world_args(args: Vec[string]) -> Result[string, string] {
    let mut output: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if argument == "--output" {
            if option_string_present(output) {
                return Result::Err(
                    repeated_argument_error(PREPARE_WORLD_COMMAND, "--output <OUTPUT>"),
                )
            } else if index + 1 >= args.len() || cli_option(args[index + 1]) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else {
                output = Option::Some(args[index + 1]);
                index = index + 2;
            }
        } else if option_string_present(inline_cli_value(argument, "--output")) {
            if option_string_present(output) {
                return Result::Err(
                    repeated_argument_error(PREPARE_WORLD_COMMAND, "--output <OUTPUT>"),
                )
            } else if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error("--output <OUTPUT>", Option::None))
            } else {
                output = inline_cli_value(argument, "--output");
                index = index + 1;
            }
        } else {
            return Result::Err(unexpected_argument_error(PREPARE_WORLD_COMMAND, argument, false))
        }
    }
    match output {
        Some(value) => Result::Ok(value),
        None => {
            let missing: Vec[string] = Vec::from_array(["--output <OUTPUT>"]);
            Result::Err(missing_required_arguments_error(PREPARE_WORLD_COMMAND, missing))
        },
    }
}

fn run_prepare_world(args: Vec[string]) -> unit {
    match parse_prepare_world_args(args) {
        Ok(output) => match write_package_world(output, package_world()) {
            Ok(()) => (),
            Err(error) => fail(COMPILE_ERROR_PREFIX + error),
        },
        Err(error) => handle_cli_parse_error(PREPARE_WORLD_COMMAND, error),
    }
}
