    interface_unit: artifact::ArtifactInterfaceUnit,
    core_unit: artifact::ArtifactCoreUnit,
}

struct PackageWorld {
    counter: Ref[int],
    builtins: core::File,
    builtin_interface: artifact::ArtifactInterfaceUnit,
    standard: ArtifactStandardLibrary,
}

fn no_standard_needs() -> StandardNeeds {
    StandardNeeds {
        root: false,
        ascii: false,
        bincode: false,
        bytes: false,
        cmp: false,
        collections: false,
        error: false,
        env: false,
        fs: false,
        io: false,
        internal_task: false,
        iter: false,
        json: false,
        num: false,
        path: false,
        process: false,
        serde: false,
        task: false,
        testing: false,
        text: false,
        toml: false,
        time: false,
        utf8: false,
        unicode: false,
        math: false,
        rand: false,
        crypto: false,
        crypto_hash: false,
        crypto_rand: false,
    }
}

fn standard_needs_from_package_names(package_names: Vec[string]) -> StandardNeeds {
    let closure = resources::standard_package_closure(package_names);
    StandardNeeds {
        root: collections::contains(closure, resources::STD_ROOT_PACKAGE),
        ascii: collections::contains(closure, resources::STD_ASCII_PACKAGE),
        bincode: collections::contains(closure, resources::STD_BINCODE_PACKAGE),
        bytes: collections::contains(closure, resources::STD_BYTES_PACKAGE),
        cmp: collections::contains(closure, resources::STD_CMP_PACKAGE),
        collections: collections::contains(closure, resources::STD_COLLECTIONS_PACKAGE),
        error: collections::contains(closure, resources::STD_ERROR_PACKAGE),
        env: collections::contains(closure, resources::STD_ENV_PACKAGE),
        fs: collections::contains(closure, resources::STD_FS_PACKAGE),
        io: collections::contains(closure, resources::STD_IO_PACKAGE),
        internal_task: collections::contains(closure, resources::STD_INTERNAL_TASK_PACKAGE),
        iter: collections::contains(closure, resources::STD_ITER_PACKAGE),
        json: collections::contains(closure, resources::STD_JSON_PACKAGE),
        num: collections::contains(closure, resources::STD_NUM_PACKAGE),
        path: collections::contains(closure, resources::STD_PATH_PACKAGE),
        process: collections::contains(closure, resources::STD_PROCESS_PACKAGE),
        serde: collections::contains(closure, resources::STD_SERDE_PACKAGE),
        task: collections::contains(closure, resources::STD_TASK_PACKAGE),
        testing: collections::contains(closure, resources::STD_TESTING_PACKAGE),
        text: collections::contains(closure, resources::STD_TEXT_PACKAGE),
        toml: collections::contains(closure, resources::STD_TOML_PACKAGE),
        time: collections::contains(closure, resources::STD_TIME_PACKAGE),
        utf8: collections::contains(closure, resources::STD_UTF8_PACKAGE),
        unicode: collections::contains(closure, resources::STD_UNICODE_PACKAGE),
        math: collections::contains(closure, resources::STD_MATH_PACKAGE),
        rand: collections::contains(closure, resources::STD_RAND_PACKAGE),
        crypto: collections::contains(closure, resources::STD_CRYPTO_PACKAGE),
        crypto_hash: collections::contains(closure, resources::STD_CRYPTO_HASH_PACKAGE),
        crypto_rand: collections::contains(closure, resources::STD_CRYPTO_RAND_PACKAGE),
    }
}

fn source_standard_needs(value: ast::LowerResult) -> StandardNeeds {
    let package_names: Vec[string] = Vec::[];
    for spec in resources::standard_package_specs() {
        if imports_package(value, spec.name) {
            package_names.push(spec.name)
        } else {}
    }
    standard_needs_from_package_names(package_names)
}

fn merge_standard_needs(left: StandardNeeds, right: StandardNeeds) -> StandardNeeds {
    StandardNeeds {
        root: left.root || right.root,
        ascii: left.ascii || right.ascii,
        bincode: left.bincode || right.bincode,
        bytes: left.bytes || right.bytes,
        cmp: left.cmp || right.cmp,
        collections: left.collections || right.collections,
        error: left.error || right.error,
        env: left.env || right.env,
        fs: left.fs || right.fs,
        io: left.io || right.io,
        internal_task: left.internal_task || right.internal_task,
        iter: left.iter || right.iter,
        json: left.json || right.json,
        num: left.num || right.num,
        path: left.path || right.path,
        process: left.process || right.process,
        serde: left.serde || right.serde,
        task: left.task || right.task,
        testing: left.testing || right.testing,
        text: left.text || right.text,
        toml: left.toml || right.toml,
        time: left.time || right.time,
        utf8: left.utf8 || right.utf8,
        unicode: left.unicode || right.unicode,
        math: left.math || right.math,
        rand: left.rand || right.rand,
        crypto: left.crypto || right.crypto,
        crypto_hash: left.crypto_hash || right.crypto_hash,
        crypto_rand: left.crypto_rand || right.crypto_rand,
    }
}

fn package_world() -> PackageWorld {
    let counter = Ref::new(0);
    let builtins = lower_builtin_core(counter);
    let builtin_interface = builtin_artifact_interface_unit();
    let standard = artifact_standard_library(
        compile_standard_library(builtins, builtin_interface.interface_hash),
    );
    PackageWorld { counter, builtins, builtin_interface, standard }
}

fn append_core_files(target: Vec[core::File], values: Vec[core::File]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn merge_hir_files(values: Vec[hir::File], package_name: string) -> hir::File {
    let path = if !values.is_empty() {
        values[0].path
    } else {
        UNKNOWN_SOURCE_PATH
    };
    let source_path = if !values.is_empty() {
        values[0].source_path
    } else {
        UNKNOWN_SOURCE_PATH
    };
    let items: Vec[hir::Item] = Vec::[];
    let public_reexports: Vec[(string, string)] = Vec::[];
    let invalid_self_type_spans: Vec[ast::Span] = Vec::[];
    for value in values {
        for item in value.items {
            items.push(item)
        }
        for reexport in value.public_reexports {
            public_reexports.push(reexport)
        }
        for span in value.invalid_self_type_spans {
            invalid_self_type_spans.push(span)
        }
    }
    hir::File {
        package_name,
        path,
        source_path,
        imports: Vec::[],
        import_aliases: Vec::[],
        use_traits: Vec::[],
        public_reexports,
        items,
        invalid_self_type_spans,
    }
}

fn package_item_name(package_name: string, name: string) -> string {
    if package_name == "main" || package_name == "builtin" {
        name
    } else {
        package_name + "::" + name
    }
}

fn artifact_short_name(value: string) -> string {
    let mut result = value;
    let mut index = 0;
    while index + 1 < value.byte_len() {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            result = value.byte_slice(index + 2, value.byte_len());
            index = index + 2;
        } else {
            index = index + 1;
        }
    }
    result
}

fn public_ast_item_name(package_name: string, value: ast::Item) -> Option[string] {
    match value {
        EnumDef(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        StructDef(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        TraitDef(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        Function(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        ExternFunction(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        TypeAlias(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        Constant(value) => match value.visibility {
            Public => Option::Some(package_item_name(package_name, value.name)),
            Private => Option::None,
        },
        ImplBlock(_) => Option::None,
    }
}

fn public_item_names(values: Vec[ast::LowerResult], package_name: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for value in values {
        match value.ast {
            Some(file) => for item in file.items {
                match public_ast_item_name(package_name, item) {
                    Some(name) => result.push(name),
                    None => (),
                }
            },
            None => (),
        }
    }
    result
}

fn local_item_is_public(package_name: string, public_names: Vec[string], name: string) -> bool {
    let prefix = package_name + "::";
    if !name.starts_with(prefix) {
        true
    } else {
        let relative = name.byte_slice(prefix.byte_len(), name.byte_len());
        relative.contains("::") || collections::contains(public_names, name)
    }
}

fn add_private_local_name(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    name: string,
) -> unit {
    if !local_item_is_public(package_name, public_names, name)
        && !collections::contains(result, name) {
        result.push(name)
    } else {}
}

fn collect_private_type_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::TypeExpr,
) -> unit {
    match value {
        Con { name } => add_private_local_name(result, package_name, public_names, name),
        Dyn { bounds } => for bound in bounds {
            add_private_local_name(result, package_name, public_names, bound.trait_name);
            for arg in bound.args {
                collect_private_type_names(result, package_name, public_names, arg)
            }
            for binding in bound.associated_types {
                collect_private_type_names(result, package_name, public_names, binding.1)
            }
        },
        Tuple { items: values } => for value in values {
            collect_private_type_names(result, package_name, public_names, value)
        },
        Projection { base, associated: _ } => collect_private_type_names(
            result,
            package_name,
            public_names,
            base,
        ),
        App { ty: base, args } => {
            collect_private_type_names(result, package_name, public_names, base);
            for arg in args {
                collect_private_type_names(result, package_name, public_names, arg)
            }
        },
        Array { len: _, elem: element } => collect_private_type_names(
            result,
            package_name,
            public_names,
            element,
        ),
        Func { params, ret_ty } => {
            for param in params {
                collect_private_type_names(result, package_name, public_names, param)
            }
            collect_private_type_names(result, package_name, public_names, ret_ty)
        },
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => (),
    }
}

fn collect_private_trait_ref_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::TraitRef,
) -> unit {
    add_private_local_name(result, package_name, public_names, value.name);
    for arg in value.args {
        collect_private_type_names(result, package_name, public_names, arg)
    }
}

fn collect_private_predicate_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::Predicate,
) -> unit {
    match value {
        Trait { ty: for_ty, trait_ref } => {
            collect_private_type_names(result, package_name, public_names, for_ty);
            collect_private_trait_ref_names(result, package_name, public_names, trait_ref)
        },
        Equality { lhs: left, rhs: right } => {
            collect_private_type_names(result, package_name, public_names, left);
            collect_private_type_names(result, package_name, public_names, right)
        },
    }
}

fn collect_private_bounds_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    values: Vec[(string, Vec[hir::TraitRef])],
) -> unit {
    for value in values {
        for trait_ref in value.1 {
            collect_private_trait_ref_names(result, package_name, public_names, trait_ref)
        }
    }
}

fn trait_impl_header_is_public(
    value: hir::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> bool {
    match value.trait_ref {
        Some(trait_ref) => {
            let private_names: Vec[string] = Vec::[];
            collect_private_type_names(private_names, package_name, public_names, value.for_type);
            local_item_is_public(package_name, public_names, trait_ref.name)
                && private_names.is_empty()
        },
        None => true,
    }
}

fn trait_impl_exposed_private_names(
    value: hir::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    match value.trait_ref {
        Some(trait_ref) => for arg in trait_ref.args {
            collect_private_type_names(result, package_name, public_names, arg)
        },
        None => (),
    };
    collect_private_bounds_names(result, package_name, public_names, value.generic_bounds);
    for predicate in value.predicates {
        collect_private_predicate_names(result, package_name, public_names, predicate)
    }
    for associated in value.associated_types {
        collect_private_type_names(result, package_name, public_names, associated.1)
    }
    for method in value.methods {
        collect_private_bounds_names(result, package_name, public_names, method.generic_bounds);
        for predicate in method.predicates {
            collect_private_predicate_names(result, package_name, public_names, predicate)
        }
        for param in method.params {
            collect_private_type_names(result, package_name, public_names, param.1)
        }
        match method.ret_ty {
            Some(ret_ty) => collect_private_type_names(result, package_name, public_names, ret_ty),
            None => (),
        }
    }
    result
}

fn join_artifact_names(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    for index in 0..values.len() {
        if index > 0 {
            builder.write_string(", ")
        } else {};
        builder.write_string(values[index])
    }
    builder.finish()
}

fn validate_public_trait_impls(value: hir::File, package_name: string, public_names: Vec[string]) -> Result[
    unit,
    string,
] {
    for item in value.items {
        match item {
            ImplBlock(value) => match value.trait_ref {
                Some(trait_ref) => if trait_impl_header_is_public(value, package_name, public_names) {
                    let private_names = wire::sort_artifact_names(
                        trait_impl_exposed_private_names(value, package_name, public_names),
                    );
                    if !private_names.is_empty() {
                        return Result::Err(
                            "Public trait implementation " + trait_ref.name
                                + " exposes private type "
                                + join_artifact_names(private_names),
                        )
                    } else {}
                } else {},
                None => (),
            },
            _ => (),
        }
    }
    Result::Ok(())
}

fn function_exposed_private_names(
    value: hir::Function,
    package_name: string,
    public_names: Vec[string],
) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    collect_private_bounds_names(result, package_name, public_names, value.generic_bounds);
    for predicate in value.predicates {
        collect_private_predicate_names(result, package_name, public_names, predicate)
    }
    for param in value.params {
        collect_private_type_names(result, package_name, public_names, param.1)
    }
    match value.ret_ty {
        Some(ret_ty) => collect_private_type_names(result, package_name, public_names, ret_ty),
        None => (),
    };
    wire::sort_artifact_names(result)
}

fn validate_public_fields_and_inherent_methods(
    value: hir::File,
    package_name: string,
    public_names: Vec[string],
) -> Result[unit, string] {
    for item in value.items {
        match item {
            StructDef(value) => if collections::contains(public_names, value.name) {
                for field in value.fields {
                    if collections::contains(value.public_fields, field.0) {
                        let private_names: Vec[string] = Vec::[];
                        collect_private_type_names(
                            private_names,
                            package_name,
                            public_names,
                            field.1,
                        );
                        if !private_names.is_empty() {
                            return Result::Err(
                                "Public field " + value.name + "." + field.0
                                    + " exposes private type "
                                    + join_artifact_names(wire::sort_artifact_names(private_names)),
                            )
                        } else {}
                    } else {}
                }
            } else {},
            ImplBlock(value) => match value.trait_ref {
                Some(_) => (),
                None => {
                    let target_private_names: Vec[string] = Vec::[];
                    collect_private_type_names(
                        target_private_names,
                        package_name,
                        public_names,
                        value.for_type,
                    );
                    if target_private_names.is_empty() {
                        for method in value.methods {
                            match method.visibility {
                                Public => {
                                    let private_names = function_exposed_private_names(
                                        method,
                                        package_name,
                                        public_names,
                                    );
                                    if !private_names.is_empty() {
                                        return Result::Err(
                                            "Public inherent method "
                                                + artifact_short_name(method.name)
                                                + " exposes private type "
                                                + join_artifact_names(private_names),
                                        )
                                    } else {}
                                },
                                Private => (),
                            }
                        }
                    } else {}
                },
            },
            _ => (),
        }
    }
    Result::Ok(())
}

fn selected_standard_packages_for_needs(standard: ArtifactStandardLibrary, needs: StandardNeeds) -> Vec[
    ArtifactStandardPackage,
] {
    let result: Vec[ArtifactStandardPackage] = Vec::[];
    if needs.ascii {
        result.push(standard.ascii)
    } else {};
    if needs.bincode {
        result.push(standard.bincode)
    } else {};
    if needs.bytes {
        result.push(standard.bytes)
    } else {};
    if needs.cmp {
        result.push(standard.cmp)
    } else {};
    if needs.collections {
        result.push(standard.collections)
    } else {};
    if needs.error {
        result.push(standard.error)
    } else {};
    if needs.env {
        result.push(standard.env)
    } else {};
    if needs.fs {
        result.push(standard.fs)
    } else {};
    if needs.io {
        result.push(standard.io)
    } else {};
    if needs.internal_task {
        result.push(standard.internal_task)
    } else {};
    if needs.iter {
        result.push(standard.iter)
    } else {};
    if needs.num {
        result.push(standard.num)
    } else {};
    if needs.path {
        result.push(standard.path)
    } else {};
    if needs.process {
        result.push(standard.process)
    } else {};
    if needs.serde {
        result.push(standard.serde)
    } else {};
    if needs.task {
        result.push(standard.task)
    } else {};
    if needs.testing {
        result.push(standard.testing)
    } else {};
    if needs.text {
        result.push(standard.text)
    } else {};
    if needs.toml {
        result.push(standard.toml)
    } else {};
    if needs.json {
        result.push(standard.json)
    } else {};
    if needs.time {
        result.push(standard.time)
    } else {};
    if needs.utf8 {
        result.push(standard.utf8)
    } else {};
    if needs.unicode {
        result.push(standard.unicode)
    } else {};
    if needs.math {
        result.push(standard.math)
    } else {};
    if needs.rand {
        result.push(standard.rand)
    } else {};
    if needs.crypto {
        result.push(standard.crypto)
    } else {};
    if needs.crypto_hash {
        result.push(standard.crypto_hash)
    } else {};
    if needs.crypto_rand {
        result.push(standard.crypto_rand)
    } else {};
    if needs.root {
        result.push(standard.root)
    } else {};
    result
}

fn checked_hir_file(value: hir::LowerResult, package_name: string) -> hir::File {
    if !value.diagnostics.is_empty() {
        fail(
            render_typer_diagnostics(
                hir_diagnostics(value.diagnostics, value.source_path),
                value.source_path,
                read_source(value.source_path),
            ),
        )
    } else {};
    match value.hir {
        Some(file) => file,
        None => {
            fail("error[typer]: failed to lower package " + package_name);
            hir::File {
                package_name,
                path: UNKNOWN_SOURCE_PATH,
                source_path: UNKNOWN_SOURCE_PATH,
                imports: Vec::[],
                import_aliases: Vec::[],
                use_traits: Vec::[],
                public_reexports: Vec::[],
                items: Vec::[],
                invalid_self_type_spans: Vec::[],
            }
        },
    }
}

fn core_function_ret_type(functions: Vec[core::Function], name: string) -> Option[tast::Type] {
    for offset in 0..functions.len() {
        let function = functions[functions.len() - 1 - offset];
        if function.name == name {
            return Option::Some(function.ret_ty)
        } else {}
    }
    Option::None
}

fn add_entry_wrapper(value: core::File, package_name: string) -> core::File {
    let expected = if package_name == "main" {
        "main"
    } else {
        package_name + "::main"
    };
    let functions: Vec[core::Function] = Vec::[];
    for function in value.functions {
        functions.push(function)
    }
    match core_function_ret_type(functions, expected) {
        Some(ret_ty) => if expected != "main" {
            functions.push(
                core::Function {
                    name: "main",
                    origin: core::FunctionOrigin::Source,
                    root: true,
                    generics: Vec::[],
                    predicates: Vec::[],
                    trait_impl: Option::None,
                    params: Vec::[],
                    ret_ty,
                    body: core::Block {
                        stmts: Vec::[],
                        tail: Option::Some(
                            core::Expr::Call {
                                func: core::Expr::Var {
                                    name: expected,
                                    ty: tast::Type::Func { params: Vec::[], ret_ty },
                                },
                                args: Vec::[],
                                ty: ret_ty,
                            },
                        ),
                    },
                },
            )
        } else {},
        None => fail("error[compile]: entry package has no main function"),
    };
    core::File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
    }
}

fn entry_core(value: core::File, package_name: string) -> core::File {
    if package_name == "main" {
        match core_function_ret_type(value.functions, "main") {
            Some(_) => value,
            None => {
                fail("error[compile]: entry package has no main function");
                value
            },
        }
    } else {
        add_entry_wrapper(value, package_name)
    }
}

fn selected_link_standard_core(standard: ArtifactStandardLibrary, needs: StandardNeeds) -> Vec[
    core::File,
] {
    let result: Vec[core::File] = Vec::[];
    if needs.ascii {
        result.push(standard.ascii.core_value)
    } else {};
    if needs.bincode {
        result.push(standard.bincode.core_value)
    } else {};
    if needs.bytes {
        result.push(standard.bytes.core_value)
    } else {};
    if needs.cmp {
        result.push(standard.cmp.core_value)
    } else {};
    if needs.collections {
        result.push(standard.collections.core_value)
    } else {};
    if needs.error {
        result.push(standard.error.core_value)
    } else {};
    if needs.env {
        result.push(standard.env.core_value)
    } else {};
    if needs.fs {
        result.push(standard.fs.core_value)
    } else {};
    if needs.io {
        result.push(standard.io.core_value)
    } else {};
    if needs.internal_task {
        result.push(standard.internal_task.core_value)
    } else {};
    if needs.iter {
        result.push(standard.iter.core_value)
    } else {};
    if needs.num {
        result.push(standard.num.core_value)
    } else {};
    if needs.path {
        result.push(standard.path.core_value)
    } else {};
    if needs.process {
        result.push(standard.process.core_value)
    } else {};
    if needs.serde {
        result.push(standard.serde.core_value)
    } else {};
    if needs.task {
        result.push(standard.task.core_value)
    } else {};
    if needs.testing {
        result.push(standard.testing.core_value)
    } else {};
    if needs.text {
        result.push(standard.text.core_value)
    } else {};
    if needs.toml {
        result.push(standard.toml.core_value)
    } else {};
    if needs.json {
        result.push(standard.json.core_value)
    } else {};
    if needs.time {
        result.push(standard.time.core_value)
    } else {};
    if needs.utf8 {
        result.push(standard.utf8.core_value)
    } else {};
    if needs.unicode {
        result.push(standard.unicode.core_value)
    } else {};
    if needs.math {
        result.push(standard.math.core_value)
    } else {};
    if needs.rand {
        result.push(standard.rand.core_value)
    } else {};
    if needs.crypto {
        result.push(standard.crypto.core_value)
    } else {};
    if needs.crypto_hash {
        result.push(standard.crypto_hash.core_value)
    } else {};
    if needs.crypto_rand {
        result.push(standard.crypto_rand.core_value)
    } else {};
    if needs.root {
        result.push(standard.root.core_value)
    } else {};
    result
}

fn run_package_command(args: Vec[string], build: bool, emit_tests: bool) -> unit {
    let command = match parse_package_command_args(args) {
        Ok(value) => value,
        Err(error) => {
            handle_cli_parse_error(args[1], error);
            PackageCommandArgs {
                package_name: "main",
                inputs: Vec::[],
                interface_paths: Vec::[],
                output: "package",
                world: Option::None,
            }
        },
    };
    let world = match command.world {
        Some(path) => match read_package_world(path) {
            Ok(value) => value,
            Err(error) => {
                fail(COMPILE_ERROR_PREFIX + error);
                package_world()
            },
        },
        None => package_world(),
    };
    let artifact = match compile_artifact_package(world, command, build, emit_tests) {
        Ok(value) => value,
        Err(error) => {
            if error.starts_with("error[") {
                fail(error)
            } else {
                fail(COMPILE_ERROR_PREFIX + error)
            };
            let interface_unit = interface_codec::new_unit(
                command.package_name,
                interface_codec::empty_exports(),
                artifact::ArtifactPackageInterface {
                    package_name: command.package_name,
                    name: "main",
                    value_exports: Vec::[],
                    enum_variants: Vec::[],
                },
                Vec::[("builtin", artifact_builtin_interface_hash(world))],
            );
            ArtifactCompiledPackage {
                interface_unit,
                core_unit: artifact::ArtifactCoreUnit {
                    package_name: command.package_name,
                    declared_name: "main",
                    interface_hash: interface_unit.interface_hash,
                    exports: interface_codec::empty_exports(),
                    core_ir: empty_core_file(),
                    deps: Vec::[("builtin", artifact_builtin_interface_hash(world))],
                    sources: Vec::[],
                    tests: Vec::[],
                },
            }
        },
    };
    match ensure_parent(interface_output_path(command.output)) {
        Ok(()) => match write_artifact_interface(
            interface_output_path(command.output),
            artifact.interface_unit,
        ) {
            Ok(()) => (),
            Err(error) => fail(error),
        },
        Err(error) => fail(error),
    };
    if build {
        match ensure_parent(core_output_path(command.output)) {
            Ok(()) => match write_artifact_core(
                core_output_path(command.output),
                artifact.core_unit,
            ) {
                Ok(()) => (),
                Err(error) => fail(error),
            },
            Err(error) => fail(error),
        }
    } else {}
}

fn run_link_command(args: Vec[string]) -> unit {
    let command = match parse_link_command_args(args) {
        Ok(value) => value,
        Err(error) => {
            handle_cli_parse_error(LINK_COMMAND, error);
            LinkCommandArgs {
                inputs: Vec::[],
                entry: "main",
                output: "main.go",
                world: Option::None,
            }
        },
    };
    let world = match command.world {
        Some(path) => match read_package_world(path) {
            Ok(value) => value,
            Err(error) => {
                fail(COMPILE_ERROR_PREFIX + error);
                package_world()
            },
        },
        None => package_world(),
    };
    let core_units = match artifact_read_core_units(command.inputs) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::[]
        },
    };
    let roots = Vec::[command.entry];
    let core_units = match artifact_reachable_core_units(roots, core_units) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::[]
        },
    };
    match artifact_validate_link_core_units(world, core_units) {
        Ok(()) => (),
        Err(error) => fail(COMPILE_ERROR_PREFIX + error),
    };
    artifact_prepare_core_units(world, core_units);
    match artifact_find_core_unit(core_units, command.entry) {
        Some(value) => if value.declared_name == "" || value.declared_name == "main" {} else {
            fail(
                "error[compile]: entry package " + command.entry + " declares package "
                    + value.declared_name
                    + ", expected main",
            )
        },
        None => fail("error[compile]: missing entry package " + command.entry),
    };
    let dependencies: Vec[core::File] = Vec::[];
    let entries: Vec[ArtifactCompilation] = Vec::[];
    let needs = artifact_core_standard_needs(core_units);
    let compilations = match artifact_core_compilations(core_units) {
        Ok(values) => values,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::[]
        },
    };
    for compilation in compilations {
        if compilation.package_name == command.entry {
            entries.push(compilation)
        } else {
            dependencies.push(compilation.core_value)
        }
    }
    if entries.is_empty() {
        fail("error[compile]: missing entry package " + command.entry)
    } else {};
    let entry = entries[entries.len() - 1];
    let linked_dependencies = selected_link_standard_core(world.standard, needs);
    append_core_files(linked_dependencies, dependencies);
    let linked = core::link_with_dependencies(
        world.builtins,
        linked_dependencies,
        entry_core(entry.core_value, command.entry),
    );
    let mono_value = lower_mono_or_fail(linked);
    let lift_value = lower_lift_stage(mono_value, world.counter);
    let anf_value = lower_anf_stage(lift_value, world.counter);
    let go_source = go_backend::encode(lower_go_or_fail(go_backend::lower(anf_value)));
    match ensure_parent(command.output) {
        Ok(()) => match fs::write_file(command.output, go_source) {
            Ok(()) => (),
            Err(error) => fail(error),
        },
        Err(error) => fail(error),
    }
}

fn empty_core_file() -> core::File {
    core::File {
        functions: Vec::[],
        enums: Vec::[],
        structs: Vec::[],
        type_instances: Vec::[],
        constants: Vec::[],
    }
}

fn run_test_link_command(args: Vec[string]) -> unit {
    let command = match parse_test_link_command_args(args) {
        Ok(value) => value,
        Err(error) => {
            handle_cli_parse_error(TEST_LINK_COMMAND, error);
            TestLinkCommandArgs {
                inputs: Vec::[],
                packages: Vec::[],
                output: "main.go",
                manifest: "tests.json",
                world: Option::None,
            }
        },
    };
    let world = match command.world {
        Some(path) => match read_package_world(path) {
            Ok(value) => value,
            Err(error) => {
                fail(COMPILE_ERROR_PREFIX + error);
                package_world()
            },
        },
        None => package_world(),
    };
    let core_units = match artifact_read_core_units(command.inputs) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::[]
        },
    };
    let core_units = match artifact_reachable_core_units(command.packages, core_units) {
        Ok(value) => value,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::[]
        },
    };
    match artifact_validate_link_core_units(world, core_units) {
        Ok(()) => (),
        Err(error) => fail(COMPILE_ERROR_PREFIX + error),
    };
    artifact_prepare_core_units(world, core_units);
    let package_cores: Vec[core::File] = Vec::[];
    let needs = artifact_core_standard_needs(core_units);
    let compilations = match artifact_core_compilations(core_units) {
        Ok(values) => values,
        Err(error) => {
            fail(COMPILE_ERROR_PREFIX + error);
            Vec::[]
        },
    };
    for compilation in compilations {
        package_cores.push(compilation.core_value)
    }
    let tests: Vec[artifact::ArtifactTestDescriptor] = Vec::[];
    for package_name in command.packages {
        match artifact_find_core_unit(core_units, package_name) {
            Some(core_unit) => for test in core_unit.tests {
                tests.push(test)
            },
            None => fail("error[compile]: missing test package " + package_name),
        }
    }
    let linked_dependencies = selected_link_standard_core(world.standard, needs);
    append_core_files(linked_dependencies, package_cores);
    let linked = core::link_with_dependencies(
        world.builtins,
        linked_dependencies,
        empty_core_file(),
    );
    let mono_value = lower_mono_or_fail(linked);
    let lift_value = lower_lift_stage(mono_value, world.counter);
    let anf_value = lower_anf_stage(lift_value, world.counter);
    let go_source = go_backend::encode(
        lower_go_or_fail(go_backend::lower_tests(anf_value, test_link_cases(tests))),
    );
    match ensure_parent(command.output) {
        Ok(()) => match fs::write_file(command.output, go_source) {
            Ok(()) => (),
            Err(error) => fail(error),
        },
        Err(error) => fail(error),
    };
    match ensure_parent(command.manifest) {
        Ok(()) => match fs::write_file(command.manifest, encode_test_manifest(tests)) {
            Ok(()) => (),
            Err(error) => fail(error),
        },
        Err(error) => fail(error),
    }
}
