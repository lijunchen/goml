struct StandardNeeds {
    root: bool,
    bytes: bool,
    collections: bool,
    env: bool,
    fs: bool,
    io: bool,
    json: bool,
    path: bool,
    process: bool,
    testing: bool,
    text: bool,
}

struct ArtifactCompilation {
    package_name: string,
    dependency_names: Vec[string],
    core_value: core::File,
}

struct ArtifactCompiledPackage {
    interface_unit: ArtifactInterfaceUnit,
    core_unit: ArtifactCoreUnit,
}

struct PackageWorld {
    counter: Ref[int],
    builtins: core::File,
    builtin_interface: ArtifactInterfaceUnit,
    standard: ArtifactStandardLibrary,
}

fn no_standard_needs() -> StandardNeeds {
    StandardNeeds {
        root: false,
        bytes: false,
        collections: false,
        env: false,
        fs: false,
        io: false,
        json: false,
        path: false,
        process: false,
        testing: false,
        text: false,
    }
}

fn source_standard_needs(value: ast::LowerResult) -> StandardNeeds {
    let needs_root = imports_package(value, "std");
    let needs_fs = needs_root || imports_package(value, "std::fs");
    let needs_io = needs_root || imports_package(value, "std::io");
    let needs_process = needs_root || imports_package(value, "std::process");
    let needs_json = needs_root || imports_package(value, "std::json");
    let needs_text = needs_root
        || needs_json
        || imports_package(value, "std::text");
    StandardNeeds {
        root: needs_root,
        bytes: imports_package(value, "std::bytes")
            || needs_root
            || needs_fs
            || needs_io
            || needs_process
            || needs_text,
        collections: needs_root || imports_package(value, "std::collections"),
        env: needs_root || imports_package(value, "std::env"),
        fs: needs_fs,
        io: needs_io,
        json: needs_json,
        path: needs_root || imports_package(value, "std::path"),
        process: needs_process,
        testing: imports_package(value, "std::testing"),
        text: needs_text,
    }
}

fn merge_standard_needs(left: StandardNeeds, right: StandardNeeds) -> StandardNeeds {
    StandardNeeds {
        root: left.root || right.root,
        bytes: left.bytes || right.bytes,
        collections: left.collections || right.collections,
        env: left.env || right.env,
        fs: left.fs || right.fs,
        io: left.io || right.io,
        json: left.json || right.json,
        path: left.path || right.path,
        process: left.process || right.process,
        testing: left.testing || right.testing,
        text: left.text || right.text,
    }
}

fn package_world() -> PackageWorld {
    let counter = Ref::new(0);
    let builtins = core::lower_builtins(counter);
    let builtin_interface = builtin_artifact_interface_unit();
    let standard = artifact_standard_library(compile_standard_library(
        builtins,
        builtin_interface.interface_hash,
    ));
    PackageWorld {
        counter,
        builtins,
        builtin_interface,
        standard,
    }
}

fn append_core_files(target: Vec[core::File], values: Vec[core::File]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn merge_hir_files(values: Vec[hir::File], package_name: string) -> hir::File {
    let path = if values.len() > 0 {
        values.get(0).path
    } else {
        "<unknown>"
    };
    let source_path = if values.len() > 0 {
        values.get(0).source_path
    } else {
        "<unknown>"
    };
    let items: Vec[hir::Item] = Vec::new();
    let invalid_self_type_spans: Vec[ast::Span] = Vec::new();
    for value in values {
        for item in value.items {
            items.push(item)
        };
        for span in value.invalid_self_type_spans {
            invalid_self_type_spans.push(span)
        }
    };
    hir::File {
        package_name,
        path,
        source_path,
        imports: Vec::new(),
        import_aliases: Vec::new(),
        use_traits: Vec::new(),
        items,
        invalid_self_type_spans,
    }
}

fn package_item_name(package_name: string, name: string) -> string {
    if package_name == "main" || package_name == "builtin" {
        name
    } else {
        package_name + "::" + name
    }
}

fn artifact_short_name(value: string) -> string {
    let result = Ref::new(value);
    let index = Ref::new(0);
    while index.get() + 1 < value.byte_len() {
        if value.byte_get(index.get()) == 58
            && value.byte_get(index.get() + 1) == 58
        {
            result.set(value.byte_slice(index.get() + 2, value.byte_len()));
            index.set(index.get() + 2)
        } else {
            index.set(index.get() + 1)
        }
    };
    result.get()
}

fn public_ast_item_name(package_name: string, value: ast::Item) -> Option[string] {
    match value {
        ast::Item::EnumDef(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::StructDef(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::TraitDef(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::Function(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::ExternFunction(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::TypeAlias(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::Constant(value) => match value.visibility {
            ast::Visibility::Public => Option::Some(package_item_name(package_name, value.name)),
            ast::Visibility::Private => Option::None,
        },
        ast::Item::ImplBlock(_) => Option::None,
    }
}

fn public_item_names(
    values: Vec[ast::LowerResult],
    package_name: string,
) -> Vec[string] {
    let result = Vec::new();
    for value in values {
        match value.ast {
            Option::Some(file) => for item in file.items {
                match public_ast_item_name(package_name, item) {
                    Option::Some(name) => result.push(name),
                    Option::None => (),
                }
            },
            Option::None => (),
        }
    };
    result
}

fn local_item_is_public(
    package_name: string,
    public_names: Vec[string],
    name: string,
) -> bool {
    let prefix = package_name + "::";
    if !strings::starts_with(name, prefix) {
        true
    } else {
        let relative = name.byte_slice(prefix.byte_len(), name.byte_len());
        strings::contains(relative, "::")
            || vecs::contains(public_names, name)
    }
}

fn add_private_local_name(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    name: string,
) -> unit {
    if !local_item_is_public(package_name, public_names, name)
        && !vecs::contains(result, name)
    {
        result.push(name)
    } else {
        ()
    }
}

fn collect_private_type_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::TypeExpr,
) -> unit {
    match value {
        hir::TypeExpr::Con { name } => add_private_local_name(
            result,
            package_name,
            public_names,
            name,
        ),
        hir::TypeExpr::Dyn { trait_name: name } => add_private_local_name(
            result,
            package_name,
            public_names,
            name,
        ),
        hir::TypeExpr::Tuple { items: values } => for value in values {
            collect_private_type_names(result, package_name, public_names, value)
        },
        hir::TypeExpr::Projection { base, associated: _ } => collect_private_type_names(
            result,
            package_name,
            public_names,
            base,
        ),
        hir::TypeExpr::App { ty: base, args } => {
            collect_private_type_names(result, package_name, public_names, base);
            for arg in args {
                collect_private_type_names(result, package_name, public_names, arg)
            }
        },
        hir::TypeExpr::Array { len: _, elem: element } => collect_private_type_names(
            result,
            package_name,
            public_names,
            element,
        ),
        hir::TypeExpr::Func { params, ret_ty } => {
            for param in params {
                collect_private_type_names(result, package_name, public_names, param)
            };
            collect_private_type_names(result, package_name, public_names, ret_ty)
        },
        hir::TypeExpr::Unit
        | hir::TypeExpr::Bool
        | hir::TypeExpr::Int
        | hir::TypeExpr::Int8
        | hir::TypeExpr::Int16
        | hir::TypeExpr::Int32
        | hir::TypeExpr::Int64
        | hir::TypeExpr::Uint
        | hir::TypeExpr::Uint8
        | hir::TypeExpr::Uint16
        | hir::TypeExpr::Uint32
        | hir::TypeExpr::Uint64
        | hir::TypeExpr::Float32
        | hir::TypeExpr::Float64
        | hir::TypeExpr::String
        | hir::TypeExpr::Char => (),
    }
}

fn collect_private_trait_ref_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::TraitRef,
) -> unit {
    add_private_local_name(result, package_name, public_names, value.name);
    for arg in value.args {
        collect_private_type_names(result, package_name, public_names, arg)
    }
}

fn collect_private_predicate_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    value: hir::Predicate,
) -> unit {
    match value {
        hir::Predicate::Trait { ty: for_ty, trait_ref } => {
            collect_private_type_names(result, package_name, public_names, for_ty);
            collect_private_trait_ref_names(
                result,
                package_name,
                public_names,
                trait_ref,
            )
        },
        hir::Predicate::Equality { lhs: left, rhs: right } => {
            collect_private_type_names(result, package_name, public_names, left);
            collect_private_type_names(result, package_name, public_names, right)
        },
    }
}

fn collect_private_bounds_names(
    result: Vec[string],
    package_name: string,
    public_names: Vec[string],
    values: Vec[(string, Vec[hir::TraitRef])],
) -> unit {
    for value in values {
        for trait_ref in value.1 {
            collect_private_trait_ref_names(
                result,
                package_name,
                public_names,
                trait_ref,
            )
        }
    }
}

fn trait_impl_header_is_public(
    value: hir::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> bool {
    match value.trait_ref {
        Option::Some(trait_ref) => {
            let private_names = Vec::new();
            collect_private_type_names(
                private_names,
                package_name,
                public_names,
                value.for_type,
            );
            local_item_is_public(package_name, public_names, trait_ref.name)
                && private_names.len() == 0
        },
        Option::None => true,
    }
}

fn trait_impl_exposed_private_names(
    value: hir::ImplBlock,
    package_name: string,
    public_names: Vec[string],
) -> Vec[string] {
    let result = Vec::new();
    match value.trait_ref {
        Option::Some(trait_ref) => for arg in trait_ref.args {
            collect_private_type_names(result, package_name, public_names, arg)
        },
        Option::None => (),
    };
    collect_private_bounds_names(
        result,
        package_name,
        public_names,
        value.generic_bounds,
    );
    for predicate in value.predicates {
        collect_private_predicate_names(
            result,
            package_name,
            public_names,
            predicate,
        )
    };
    for associated in value.associated_types {
        collect_private_type_names(
            result,
            package_name,
            public_names,
            associated.1,
        )
    };
    for method in value.methods {
        collect_private_bounds_names(
            result,
            package_name,
            public_names,
            method.generic_bounds,
        );
        for predicate in method.predicates {
            collect_private_predicate_names(
                result,
                package_name,
                public_names,
                predicate,
            )
        };
        for param in method.params {
            collect_private_type_names(
                result,
                package_name,
                public_names,
                param.1,
            )
        };
        match method.ret_ty {
            Option::Some(ret_ty) => collect_private_type_names(
                result,
                package_name,
                public_names,
                ret_ty,
            ),
            Option::None => (),
        }
    };
    result
}

fn artifact_string_less(left: string, right: string) -> bool {
    let common = if left.byte_len() < right.byte_len() {
        left.byte_len()
    } else {
        right.byte_len()
    };
    for index in range(0, common) {
        if left.byte_get(index) < right.byte_get(index) {
            return true
        } else if left.byte_get(index) > right.byte_get(index) {
            return false
        } else {
            ()
        }
    };
    left.byte_len() < right.byte_len()
}

fn sort_artifact_names(values: Vec[string]) -> Vec[string] {
    for index in range(1, values.len()) {
        let current = values.get(index);
        let destination = Ref::new(index);
        while destination.get() > 0
            && artifact_string_less(current, values.get(destination.get() - 1))
        {
            values.set(destination.get(), values.get(destination.get() - 1));
            destination.set(destination.get() - 1)
        };
        values.set(destination.get(), current)
    };
    values
}

fn join_artifact_names(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        builder.write_string(values.get(index))
    };
    builder.finish()
}

fn validate_public_trait_impls(
    value: hir::File,
    package_name: string,
    public_names: Vec[string],
) -> Result[unit, string] {
    for item in value.items {
        match item {
            hir::Item::ImplBlock(value) => match value.trait_ref {
                Option::Some(trait_ref) => if trait_impl_header_is_public(
                    value,
                    package_name,
                    public_names,
                ) {
                    let private_names = sort_artifact_names(
                        trait_impl_exposed_private_names(
                            value,
                            package_name,
                            public_names,
                        ),
                    );
                    if private_names.len() > 0 {
                        return Result::Err(
                            "Public trait implementation "
                                + trait_ref.name
                                + " exposes private type "
                                + join_artifact_names(private_names),
                        )
                    } else {
                        ()
                    }
                } else {
                    ()
                },
                Option::None => (),
            },
            _ => (),
        }
    };
    Result::Ok(())
}

fn function_exposed_private_names(
    value: hir::Function,
    package_name: string,
    public_names: Vec[string],
) -> Vec[string] {
    let result = Vec::new();
    collect_private_bounds_names(
        result,
        package_name,
        public_names,
        value.generic_bounds,
    );
    for predicate in value.predicates {
        collect_private_predicate_names(
            result,
            package_name,
            public_names,
            predicate,
        )
    };
    for param in value.params {
        collect_private_type_names(
            result,
            package_name,
            public_names,
            param.1,
        )
    };
    match value.ret_ty {
        Option::Some(ret_ty) => collect_private_type_names(
            result,
            package_name,
            public_names,
            ret_ty,
        ),
        Option::None => (),
    };
    sort_artifact_names(result)
}

fn validate_public_fields_and_inherent_methods(
    value: hir::File,
    package_name: string,
    public_names: Vec[string],
) -> Result[unit, string] {
    for item in value.items {
        match item {
            hir::Item::StructDef(value) => if vecs::contains(
                public_names,
                value.name,
            ) {
                for field in value.fields {
                    if vecs::contains(value.public_fields, field.0) {
                        let private_names = Vec::new();
                        collect_private_type_names(
                            private_names,
                            package_name,
                            public_names,
                            field.1,
                        );
                        if private_names.len() > 0 {
                            return Result::Err(
                                "Public field "
                                    + value.name
                                    + "."
                                    + field.0
                                    + " exposes private type "
                                    + join_artifact_names(
                                        sort_artifact_names(private_names),
                                    ),
                            )
                        } else {
                            ()
                        }
                    } else {
                        ()
                    }
                }
            } else {
                ()
            },
            hir::Item::ImplBlock(value) => match value.trait_ref {
                Option::Some(_) => (),
                Option::None => {
                    let target_private_names = Vec::new();
                    collect_private_type_names(
                        target_private_names,
                        package_name,
                        public_names,
                        value.for_type,
                    );
                    if target_private_names.len() == 0 {
                        for method in value.methods {
                            match method.visibility {
                                ast::Visibility::Public => {
                                    let private_names =
                                        function_exposed_private_names(
                                            method,
                                            package_name,
                                            public_names,
                                        );
                                    if private_names.len() > 0 {
                                        return Result::Err(
                                            "Public inherent method "
                                                + artifact_short_name(method.name)
                                                + " exposes private type "
                                                + join_artifact_names(private_names),
                                        )
                                    } else {
                                        ()
                                    }
                                },
                                ast::Visibility::Private => (),
                            }
                        }
                    } else {
                        ()
                    }
                },
            },
            _ => (),
        }
    };
    Result::Ok(())
}

fn selected_standard_packages_for_needs(
    standard: ArtifactStandardLibrary,
    needs: StandardNeeds,
) -> Vec[ArtifactStandardPackage] {
    let result: Vec[ArtifactStandardPackage] = Vec::new();
    if needs.bytes {
        result.push(standard.bytes)
    } else {
        ()
    };
    if needs.collections {
        result.push(standard.collections)
    } else {
        ()
    };
    if needs.env {
        result.push(standard.env)
    } else {
        ()
    };
    if needs.fs {
        result.push(standard.fs)
    } else {
        ()
    };
    if needs.io {
        result.push(standard.io)
    } else {
        ()
    };
    if needs.path {
        result.push(standard.path)
    } else {
        ()
    };
    if needs.process {
        result.push(standard.process)
    } else {
        ()
    };
    if needs.testing {
        result.push(standard.testing)
    } else {
        ()
    };
    if needs.text {
        result.push(standard.text)
    } else {
        ()
    };
    if needs.json {
        result.push(standard.json)
    } else {
        ()
    };
    if needs.root {
        result.push(standard.root)
    } else {
        ()
    };
    result
}

fn checked_hir_file(value: hir::LowerResult, package_name: string) -> hir::File {
    if value.diagnostics.len() > 0 {
        fail(render_typer_diagnostics(
            hir_diagnostics(value.diagnostics, value.source_path),
            value.source_path,
            read_source(value.source_path),
        ))
    } else {
        ()
    };
    match value.hir {
        Option::Some(file) => file,
        Option::None => {
            fail("error[typer]: failed to lower package " + package_name);
            hir::File {
                package_name,
                path: "<unknown>",
                source_path: "<unknown>",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

fn core_function_ret_type(
    functions: Vec[core::Function],
    name: string,
) -> Option[tast::Type] {
    for offset in range(0, functions.len()) {
        let function = functions.get(functions.len() - 1 - offset);
        if function.name == name {
            return Option::Some(function.ret_ty)
        } else {
            ()
        }
    };
    Option::None
}

fn add_entry_wrapper(value: core::File, package_name: string) -> core::File {
    let expected = if package_name == "main" {
        "main"
    } else {
        package_name + "::main"
    };
    let functions = Vec::new();
    for function in value.functions {
        functions.push(function)
    };
    match core_function_ret_type(functions, expected) {
        Option::Some(ret_ty) => if expected != "main" {
            functions.push(core::Function {
                name: "main",
                root: true,
                generics: Vec::new(),
                predicates: Vec::new(),
                trait_impl: Option::None,
                params: Vec::new(),
                ret_ty,
                body: core::Block {
                    stmts: Vec::new(),
                    tail: Option::Some(core::Expr::Call {
                        func: core::Expr::Var {
                                                name: expected,
                                                ty: tast::Type::Func { params: Vec::new(), ret_ty },
                                            },
                        args: Vec::new(),
                        ty: ret_ty,
                    }),
                },
            })
        } else {
            ()
        },
        Option::None => fail("error[compile]: entry package has no main function"),
    };
    core::File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
    }
}

fn entry_core(value: core::File, package_name: string) -> core::File {
    if package_name == "main" {
        match core_function_ret_type(value.functions, "main") {
            Option::Some(_) => value,
            Option::None => {
                fail("error[compile]: entry package has no main function");
                value
            },
        }
    } else {
        add_entry_wrapper(value, package_name)
    }
}

