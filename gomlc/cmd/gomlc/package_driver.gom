struct StandardNeeds {
    root: bool,
    ascii: bool,
    bincode: bool,
    bytes: bool,
    cmp: bool,
    collections: bool,
    error: bool,
    env: bool,
    fs: bool,
    io: bool,
    internal_task: bool,
    iter: bool,
    json: bool,
    num: bool,
    path: bool,
    process: bool,
    serde: bool,
    task: bool,
    testing: bool,
    text: bool,
    toml: bool,
    time: bool,
    utf8: bool,
    unicode: bool,
    math: bool,
    rand: bool,
    crypto: bool,
    crypto_hash: bool,
    crypto_rand: bool,
}

struct ArtifactCompilation {
    package_name: string,
    dependency_names: Vec[string],
    core_value: core::File,
}

