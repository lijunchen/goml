package tast;

use gomlc::ast;
use gomlc::ctir;
use gomlc::derive;
use gomlc::hir;
use gomlc::resources;
use std::collections;

pub struct EnumVariantInfo {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub struct EnumInfo {
    pub def_id: hir::DefId,
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariantInfo],
}

pub fn enum_variant_field_types(fields: EnumVariantFields) -> Vec[Type] {
    match fields {
        Unit => Vec::[],
        Tuple(types) => types,
        Struct(fields) => {
            let types: Vec[Type] = Vec::[];
            for field in fields {
                types.push(field.1)
            }
            types
        },
    }
}

pub fn enum_variant_named_fields(fields: EnumVariantFields) -> Option[Vec[(string, Type)]] {
    match fields {
        Struct(fields) => Option::Some(fields),
        _ => Option::None,
    }
}

pub struct StructInfo {
    pub def_id: hir::DefId,
    pub name: string,
    pub generics: Vec[string],
    pub fields: Vec[(string, Type)],
    pub public_fields: Vec[string],
    pub has_hidden_fields: bool,
}

pub struct TypeAliasInfo {
    pub name: string,
    pub generics: Vec[string],
    pub ty: Type,
}

pub struct ConstantScheme {
    pub def_id: Option[hir::DefId],
    pub name: string,
    pub ty: Type,
}

pub struct TraitMethodInfo {
    pub name: string,
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub params: Vec[Type],
    pub ret_ty: Type,
    pub default_name: Option[string],
}

pub struct AssociatedTypeInfo {
    pub name: string,
    pub bounds: Vec[TraitRef],
}

pub struct TraitInfo {
    pub name: string,
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub supertraits: Vec[TraitRef],
    pub associated_types: Vec[AssociatedTypeInfo],
    pub methods: Vec[TraitMethodInfo],
}

pub enum TypePredicate {
    Trait {
        for_ty: Type,
        trait_ref: TraitRef,
    },
    Equality {
        lhs: Type,
        rhs: Type,
    },
}

pub struct FunctionScheme {
    pub def_id: Option[hir::DefId],
    pub name: string,
    pub comptime: ComptimeCapability,
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub params: Vec[Type],
    pub ret_ty: Type,
    pub callable: Callable,
}

struct RejectedExtern {
    def_id: hir::DefId,
    name: string,
    arity: int,
    source_path: string,
    local: bool,
}

struct InstantiatedFunction {
    callable: Callable,
    ty: Type,
    predicates: Vec[TypePredicate],
}

pub struct MethodInfo {
    pub owner_generics: Vec[string],
    pub method_generics: Vec[string],
    pub owner_predicate_count: int,
    pub trait_ref: Option[TraitRef],
    pub for_type: Type,
    pub function: FunctionScheme,
}

pub struct ImplInfo {
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub trait_ref: TraitRef,
    pub for_type: Type,
    pub associated_types: Vec[(string, Type)],
    pub origin: string,
    pub span: ast::Span,
}

struct FieldConstraint {
    receiver: Type,
    name: string,
    field_ty: Type,
    span: Option[ast::Span],
}

struct PredicateRequirement {
    predicate: TypePredicate,
    message: string,
    span: Option[ast::Span],
}

struct CoercionConstraint {
    actual: Type,
    expected: Type,
    span: Option[ast::Span],
}

struct NumericLiteralConstraint {
    raw: string,
    ty: Type,
    float: bool,
    negative: Ref[bool],
    span: Option[ast::Span],
}

struct LoopResult {
    label: Option[string],
    result_ty: Option[Type],
    has_break: Ref[bool],
}

struct Checker {
    counter: Ref[int],
    diagnostics: Vec[Diagnostic],
    typeck_results: TypeckResults,
    package_name: string,
    source_path: string,
    current_span: Ref[Option[ast::Span]],
    coercion_constraints: Vec[CoercionConstraint],
    numeric_literal_constraints: Vec[NumericLiteralConstraint],
    defer_coercion_depth: Ref[int],
    package_aliases: Vec[hir::ImportAlias],
    symbol_aliases: Vec[(string, string)],
    imported_items: Vec[string],
    in_scope_traits: Vec[string],
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    type_aliases: Vec[TypeAliasInfo],
    constants: Vec[ConstantScheme],
    enum_names: HashMap[string, int],
    enum_short_names: HashMap[string, int],
    struct_names: HashMap[string, int],
    struct_short_names: HashMap[string, int],
    coverage_domains: HashMap[string, Vec[CoverageConstructor]],
    coverage_inhabited: HashMap[string, bool],
    traits: Vec[TraitInfo],
    functions: Vec[FunctionScheme],
    rejected_externs: Vec[RejectedExtern],
    methods: Vec[MethodInfo],
    impls: Vec[ImplInfo],
    invalid_impl_origins: Vec[string],
    invalid_impl_arity_owners: Vec[string],
    predicates: Vec[TypePredicate],
    param_aliases: Vec[TypeSubst],
    projection_aliases: Vec[ProjectionAlias],
    field_constraints: Vec[FieldConstraint],
    silent_field_receivers: Vec[Type],
    required_predicates: Vec[PredicateRequirement],
    locals: Vec[(hir::LocalId, Type)],
    unresolved_locals: Vec[hir::LocalId],
    unresolved_inference_vars: Vec[Ref[TypeVar]],
    reported_inference_spans: Vec[int],
    suppress_unresolved_ref_diagnostic: Ref[int],
    mutable_locals: Vec[hir::LocalId],
    return_ty: Type,
    self_ty: Option[Type],
    type_params: Vec[string],
    loop_depth: Ref[int],
    loop_results: Vec[LoopResult],
    condition_depth: Ref[int],
    condition_loop_depth: Ref[int],
    comptime_depth: Ref[int],
    comptime_capability: ComptimeCapability,
    allow_unstructured_go: bool,
}

fn new_diagnostic(stage: string, message: string, source_path: string, span: Option[ast::Span]) -> Diagnostic {
    Diagnostic {
        severity: DiagnosticSeverity::Error,
        stage,
        message,
        source_path,
        span,
        primary_label: Option::None,
        secondary_labels: Vec::[],
        sort_order: 0,
    }
}

fn push_warning_at(ctx: Checker, message: string, span: Option[ast::Span]) -> unit {
    ctx.diagnostics.push(
        Diagnostic {
            severity: DiagnosticSeverity::Warning,
            stage: "typer",
            message,
            source_path: ctx.source_path,
            span,
            primary_label: Option::None,
            secondary_labels: Vec::[],
            sort_order: 0,
        },
    )
}

fn inference_diagnostic_reported(ctx: Checker, span: ast::Span) -> bool {
    let inference_prefix = "Could not infer";
    for value in ctx.diagnostics {
        if value.message.starts_with(inference_prefix) && value.source_path == ctx.source_path
            && match value.span {
                Some(value_span) => value_span.start == span.start,
                None => false,
            } {
            return true
        } else {}
    }
    for start in ctx.reported_inference_spans {
        if start == span.start {
            return true
        } else {}
    }
    false
}

fn push_inference_diagnostic_at(ctx: Checker, span: ast::Span, sort_order: int) -> unit {
    if inference_diagnostic_reported(ctx, span) {} else {
        ctx.reported_inference_spans.push(span.start);
        ctx.diagnostics.push(
            Diagnostic {
                severity: DiagnosticSeverity::Error,
                stage: "typer",
                message: "Could not infer type",
                source_path: ctx.source_path,
                span: Option::Some(span),
                primary_label: Option::None,
                secondary_labels: Vec::[],
                sort_order,
            },
        )
    }
}

fn push_diagnostic(ctx: Checker, message: string) -> unit {
    push_diagnostic_at(ctx, message, ctx.current_span.get())
}

fn push_diagnostic_at(ctx: Checker, message: string, span: Option[ast::Span]) -> unit {
    let diagnostics = ctx.diagnostics;
    diagnostics.push(new_diagnostic("typer", message, ctx.source_path, span))
}

fn push_stage_diagnostic(ctx: Checker, stage: string, message: string) -> unit {
    let diagnostics = ctx.diagnostics;
    diagnostics.push(new_diagnostic(stage, message, ctx.source_path, ctx.current_span.get()))
}

fn push_global_diagnostic(ctx: Checker, message: string) -> unit {
    let inference_prefix = "Could not infer";
    let inference = message.starts_with(inference_prefix);
    if message == "Could not infer type" {
        match ctx.current_span.get() {
            Some(span) => push_inference_diagnostic_at(ctx, span, 0),
            None => ctx.diagnostics.push(new_diagnostic("typer", message, "", Option::None)),
        }
    } else {
        let diagnostics = ctx.diagnostics;
        diagnostics.push(
            new_diagnostic(
                "typer",
                message,
                if inference {
                    ctx.source_path
                } else {
                    ""
                },
                if inference {
                    ctx.current_span.get()
                } else {
                    Option::None
                },
            ),
        )
    }
}

fn push_spanless_inference_diagnostic(ctx: Checker) -> unit {
    ctx.diagnostics.push(new_diagnostic("typer", "Could not infer type", "", Option::None))
}

fn diagnostics_from_messages(values: Vec[string], source_path: string) -> Vec[Diagnostic] {
    let diagnostics: Vec[Diagnostic] = Vec::[];
    for value in values {
        diagnostics.push(new_diagnostic("typer", value, source_path, Option::None))
    }
    diagnostics
}

fn diagnostics_from_lower(values: Vec[hir::Diagnostic], source_path: string) -> Vec[Diagnostic] {
    let diagnostics: Vec[Diagnostic] = Vec::[];
    for value in values {
        diagnostics.push(new_diagnostic("typer", value.message, source_path, value.span))
    }
    diagnostics
}

pub struct PackageSignatures {
    pub traits: Vec[TraitInfo],
    pub functions: Vec[FunctionScheme],
    pub type_aliases: Vec[TypeAliasInfo],
    pub constants: Vec[ConstantScheme],
}

pub struct DependencyEnvironment {
    pub comptime: Option[ctir::CtModule],
    pub reexports: Vec[(string, string)],
    pub enums: Vec[EnumInfo],
    pub structs: Vec[StructInfo],
    pub type_aliases: Vec[TypeAliasInfo],
    pub constants: Vec[ConstantScheme],
    pub traits: Vec[TraitInfo],
    pub functions: Vec[FunctionScheme],
    pub methods: Vec[MethodInfo],
    pub impls: Vec[ImplInfo],
}

pub fn dependency_environment(
    reexports: Vec[(string, string)],
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    type_aliases: Vec[TypeAliasInfo],
    constants: Vec[ConstantScheme],
    traits: Vec[TraitInfo],
    functions: Vec[FunctionScheme],
    methods: Vec[MethodInfo],
    impls: Vec[ImplInfo],
) -> DependencyEnvironment {
    DependencyEnvironment {
        comptime: Option::None,
        reexports,
        enums,
        structs,
        type_aliases,
        constants,
        traits,
        functions,
        methods,
        impls,
    }
}

pub fn dependency_environment_with_comptime(
    value: DependencyEnvironment,
    comptime: Option[ctir::CtModule],
) -> DependencyEnvironment {
    DependencyEnvironment {
        comptime,
        reexports: value.reexports,
        enums: value.enums,
        structs: value.structs,
        type_aliases: value.type_aliases,
        constants: value.constants,
        traits: value.traits,
        functions: value.functions,
        methods: value.methods,
        impls: value.impls,
    }
}

fn append_names(left: Vec[string], right: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for value in left {
        result.push(value)
    }
    for value in right {
        result.push(value)
    }
    result
}

fn append_predicates(left: Vec[TypePredicate], right: Vec[TypePredicate]) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::[];
    for value in left {
        result.push(value)
    }
    for value in right {
        result.push(value)
    }
    result
}

fn type_from_hir(value: hir::TypeExpr, params: Vec[string], self_ty: Option[Type]) -> Type {
    match value {
        Unit => Type::Unit,
        Bool => Type::Bool,
        Int => Type::Int,
        Int8 => Type::Int8,
        Int16 => Type::Int16,
        Int32 => Type::Int32,
        Int64 => Type::Int64,
        Uint => Type::Uint,
        Uint8 => Type::Uint8,
        Uint16 => Type::Uint16,
        Uint32 => Type::Uint32,
        Uint64 => Type::Uint64,
        Float32 => Type::Float32,
        Float64 => Type::Float64,
        String => Type::String,
        Char => Type::Char,
        Tuple { items: values } => {
            let result: Vec[Type] = Vec::[];
            for item in values {
                result.push(type_from_hir(item, params, self_ty))
            }
            Type::Tuple { items: result }
        },
        Con { name } => if name == "byte" {
            Type::Uint8
        } else if name == "Self" {
            match self_ty {
                Some(ty) => ty,
                None => Type::Param { name },
            }
        } else if collections::contains(params, name) {
            Type::Param { name }
        } else {
            Type::Con { name }
        },
        Projection { base, associated: name } => {
            Type::Projection {
                for_ty: type_from_hir(base, params, self_ty),
                name,
                trait_ref: Option::None,
            }
        },
        Dyn { bounds } => {
            let result: Vec[DynTraitBound] = Vec::[];
            for bound in bounds {
                let args: Vec[Type] = Vec::[];
                for arg in bound.args {
                    args.push(type_from_hir(arg, params, self_ty))
                }
                let associated_types: Vec[(string, Type)] = Vec::[];
                for binding in bound.associated_types {
                    associated_types.push((binding.0, type_from_hir(binding.1, params, self_ty)))
                }
                result.push(DynTraitBound { trait_name: bound.trait_name, args, associated_types })
            }
            if result.is_empty() {
                Type::Error
            } else {
                let additional_bounds: Vec[DynTraitBound] = Vec::[];
                for index in 1..result.len() {
                    additional_bounds.push(result[index])
                }
                Type::Dyn {
                    trait_name: result[0].trait_name,
                    args: result[0].args,
                    associated_types: result[0].associated_types,
                    additional_bounds,
                }
            }
        },
        App { ty: base, args } => {
            let base = type_from_hir(base, params, self_ty);
            let result: Vec[Type] = Vec::[];
            for arg in args {
                result.push(type_from_hir(arg, params, self_ty))
            }
            match prune(base) {
                Con { name } => nominal_type(name, result),
                _ => Type::App { ty: base, args: result },
            }
        },
        Array { len: length, elem } => Type::Array {
            len: parse_array_length(length),
            elem: type_from_hir(elem, params, self_ty),
        },
        Func { params: values, ret_ty } => {
            let result: Vec[Type] = Vec::[];
            for param in values {
                result.push(type_from_hir(param, params, self_ty))
            }
            Type::Func { params: result, ret_ty: type_from_hir(ret_ty, params, self_ty) }
        },
    }
}

fn trait_ref_from_hir(value: hir::TraitRef, params: Vec[string], self_ty: Option[Type]) -> TraitRef {
    let args: Vec[Type] = Vec::[];
    for arg in value.args {
        args.push(type_from_hir(arg, params, self_ty))
    }
    TraitRef { name: value.name, args }
}

fn predicate_from_hir(value: hir::Predicate, params: Vec[string], self_ty: Option[Type]) -> TypePredicate {
    match value {
        Trait { ty, trait_ref: reference } => TypePredicate::Trait {
            for_ty: type_from_hir(ty, params, self_ty),
            trait_ref: trait_ref_from_hir(reference, params, self_ty),
        },
        Equality { lhs: left, rhs: right } => TypePredicate::Equality {
            lhs: type_from_hir(left, params, self_ty),
            rhs: type_from_hir(right, params, self_ty),
        },
    }
}

fn predicates_from_hir(
    generic_bounds: Vec[(string, Vec[hir::TraitRef])],
    predicates: Vec[hir::Predicate],
    params: Vec[string],
    self_ty: Option[Type],
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::[];
    for generic_bound in generic_bounds {
        for bound in generic_bound.1 {
            result.push(
                TypePredicate::Trait {
                    for_ty: type_from_hir(
                        hir::TypeExpr::Con { name: generic_bound.0 },
                        params,
                        self_ty,
                    ),
                    trait_ref: trait_ref_from_hir(bound, params, self_ty),
                },
            )
        }
    }
    for predicate in predicates {
        result.push(predicate_from_hir(predicate, params, self_ty))
    }
    result
}

fn function_scheme(
    value: hir::Function,
    inherited_generics: Vec[string],
    inherited_predicates: Vec[TypePredicate],
    self_ty: Option[Type],
    callable: Callable,
) -> FunctionScheme {
    let generics = append_names(inherited_generics, value.generics);
    let params: Vec[Type] = Vec::[];
    for param in value.params {
        params.push(type_from_hir(param.1, generics, self_ty))
    }
    FunctionScheme {
        comptime: function_comptime_capability(
            value.attrs,
            callable,
            !value.generics.is_empty() || !value.generic_bounds.is_empty()
                || !value.predicates.is_empty(),
        ),
        def_id: Option::Some(value.def_id),
        name: value.name,
        generics,
        predicates: append_predicates(
            inherited_predicates,
            predicates_from_hir(value.generic_bounds, value.predicates, generics, self_ty),
        ),
        params,
        ret_ty: match value.ret_ty {
            Some(ty) => type_from_hir(ty, generics, self_ty),
            None => Type::Unit,
        },
        callable: match lang_item_attribute(value.attrs) {
            Some(item) => Callable::LangItem { item, function_name: value.name },
            None => callable,
        },
    }
}

fn valid_comptime_derive_attribute(attribute: ast::Attribute) -> bool {
    if attribute.name != "comptime_derive" {
        false
    } else if !attribute.has_argument_list {
        true
    } else if attribute.args.len() != 1 {
        false
    } else {
        match attribute.args[0] {
            ast::AttributeArg::Ident(_) => true,
            ast::AttributeArg::Path(_) | ast::AttributeArg::String(_) => false,
        }
    }
}

fn comptime_derive_export_name(attrs: Vec[ast::Attribute]) -> Option[string] {
    for attribute in attrs {
        if valid_comptime_derive_attribute(attribute) && attribute.has_argument_list {
            match attribute.args[0] {
                ast::AttributeArg::Ident(value) => return Option::Some(value),
                ast::AttributeArg::Path(_) | ast::AttributeArg::String(_) => (),
            }
        } else {}
    }
    Option::None
}

fn function_comptime_capability(attrs: Vec[ast::Attribute], callable: Callable, generic: bool) -> ComptimeCapability {
    let mut marked = false;
    let mut derive_marked = false;
    for attribute in attrs {
        if attribute.name == "comptime" && !attribute.has_argument_list {
            marked = true;
        } else if valid_comptime_derive_attribute(attribute) {
            derive_marked = true;
        } else {}
    }
    if marked && derive_marked {
        ComptimeCapability::RuntimeOnly
    } else if derive_marked && !generic && lang_item_attribute(attrs).is_none() {
        match callable {
            Function(_) => ComptimeCapability::Derive,
            _ => ComptimeCapability::RuntimeOnly,
        }
    } else if marked && !generic && lang_item_attribute(attrs).is_none() {
        match callable {
            Function(_) => ComptimeCapability::Capable,
            _ => ComptimeCapability::RuntimeOnly,
        }
    } else {
        ComptimeCapability::RuntimeOnly
    }
}

fn lang_item_attribute(attrs: Vec[ast::Attribute]) -> Option[string] {
    for attribute in attrs {
        match extern_attribute_payload(attribute, "lang") {
            Some(item) => return Option::Some(item),
            None => (),
        }
    }
    Option::None
}

fn extern_scheme(value: hir::ExternFunction) -> FunctionScheme {
    let params: Vec[Type] = Vec::[];
    for param in value.params {
        params.push(type_from_hir(param.1, value.generics, Option::None))
    }
    FunctionScheme {
        comptime: ComptimeCapability::RuntimeOnly,
        def_id: Option::Some(value.def_id),
        name: value.name,
        generics: value.generics,
        predicates: predicates_from_hir(
            value.generic_bounds,
            value.predicates,
            value.generics,
            Option::None,
        ),
        params,
        ret_ty: match value.ret_ty {
            Some(ty) => type_from_hir(ty, value.generics, Option::None),
            None => Type::Unit,
        },
        callable: extern_callable(value),
    }
}

fn extern_attribute_payload(value: ast::Attribute, name: string) -> Option[string] {
    if value.name != name || value.args.len() != 1 {
        Option::None
    } else {
        match value.args[0] {
            ast::AttributeArg::String(payload) => Option::Some(payload),
            ast::AttributeArg::Ident(_) | ast::AttributeArg::Path(_) => Option::None,
        }
    }
}

fn go_ffi_attribute_target(value: ast::Attribute) -> Option[(string, string)] {
    if value.name != "go_ffi" || value.args.len() != 2 {
        Option::None
    } else {
        match (value.args[0], value.args[1]) {
            (ast::AttributeArg::String(import_path), ast::AttributeArg::String(symbol)) => {
                Option::Some((import_path, symbol))
            },
            _ => Option::None,
        }
    }
}

fn has_go_ffi_attribute(value: hir::ExternFunction) -> bool {
    for attribute in value.attrs {
        if attribute.name == "go_ffi" {
            return true
        } else {}
    }
    false
}

fn go_ffi_attribute_span(value: hir::ExternFunction) -> ast::Span {
    for attribute in value.attrs {
        if attribute.name == "go_ffi" {
            return attribute.span
        } else {}
    }
    ast::span(0, 0)
}

fn go_ffi_import_path_is_valid(value: string) -> bool {
    if value == "" {
        return false
    } else {};
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if byte <= 32 || byte == b'"' || byte == b'\'' || byte == b'`' || byte == b'\\' {
            return false
        } else {}
    }
    true
}

fn go_ffi_symbol_is_valid(value: string) -> bool {
    if value == "" || value.byte_get(0) < b'A' || value.byte_get(0) > b'Z' {
        return false
    } else {};
    for index in 1..value.byte_len() {
        let byte = value.byte_get(index);
        if (byte >= b'A' && byte <= b'Z') || (byte >= b'a' && byte <= b'z')
            || (byte >= b'0' && byte <= b'9')
            || byte == b'_' {} else {
            return false
        }
    }
    true
}

fn go_ffi_type_is_safe(value: Type, top_level_return: bool) -> bool {
    match resolve_type(value) {
        Unit => top_level_return,
        Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        Tuple { items } => if top_level_return && !items.is_empty() {
            for item in items {
                if !go_ffi_type_is_safe(item, false) {
                    return false
                } else {}
            }
            true
        } else {
            false
        },
        Array { len: _, elem } | Slice { elem } | Channel { elem } => {
            go_ffi_type_is_safe(elem, false)
        },
        _ => false,
    }
}

fn go_ffi_signature_diagnostic(ctx: Checker, value: hir::ExternFunction) -> Option[string] {
    for param in value.params {
        let ty = expand_type_aliases(ctx, type_from_hir(param.1, Vec::[], Option::None), false);
        if !go_ffi_type_is_safe(ty, false) {
            return Option::Some(
                "Go FFI parameter " + param.0 + " has unsupported type " + diagnostic_type_text(ty),
            )
        } else {}
    }
    let ret_ty = match value.ret_ty {
        Some(ty) => expand_type_aliases(ctx, type_from_hir(ty, Vec::[], Option::None), false),
        None => Type::Unit,
    };
    if go_ffi_type_is_safe(ret_ty, true) {
        Option::None
    } else {
        Option::Some("Go FFI return type " + diagnostic_type_text(ret_ty) + " is unsupported")
    }
}

fn extern_callable(value: hir::ExternFunction) -> Callable {
    for attribute in value.attrs {
        match extern_attribute_payload(attribute, "runtime") {
            Some(name) => return Callable::Runtime(name),
            None => match extern_attribute_payload(attribute, "intrinsic") {
                Some(name) => return Callable::Intrinsic(name),
                None => match go_ffi_attribute_target(attribute) {
                    Some(target) => return Callable::GoForeign {
                        import_path: target.0,
                        symbol: target.1,
                    },
                    None => (),
                },
            },
        }
    }
    Callable::Function(value.name)
}

fn extern_callable_diagnostic(value: hir::ExternFunction) -> Option[(string, ast::Span)] {
    let mut abi_attributes = 0;
    let mut abi_span = ast::span(0, 0);
    for attribute in value.attrs {
        if attribute.name == "runtime" || attribute.name == "intrinsic"
            || attribute.name == "go_ffi" {
            abi_attributes = abi_attributes + 1;
            abi_span = attribute.span;
        } else {}
    }
    if abi_attributes != 1 {
        return Option::Some(("Extern declarations require exactly one ABI attribute", abi_span))
    } else {};
    for attribute in value.attrs {
        if attribute.name == "runtime" {
            match extern_attribute_payload(attribute, "runtime") {
                Some(key) => if resources::runtime_abi_by_key(key).is_none() {
                    return Option::Some(("Unknown runtime hook " + key, attribute.span))
                } else {},
                None => return Option::Some(
                    ("runtime attribute expects one string argument", attribute.span),
                ),
            }
        } else if attribute.name == "intrinsic" {
            match extern_attribute_payload(attribute, "intrinsic") {
                Some(key) => if resources::intrinsic_abi_by_key(key).is_none() {
                    return Option::Some(("Unknown intrinsic " + key, attribute.span))
                } else {},
                None => return Option::Some(
                    ("intrinsic attribute expects one string argument", attribute.span),
                ),
            }
        } else if attribute.name == "go_ffi" {
            match go_ffi_attribute_target(attribute) {
                Some(target) => if !go_ffi_import_path_is_valid(target.0) {
                    return Option::Some(("go_ffi import path is invalid", attribute.span))
                } else if !go_ffi_symbol_is_valid(target.1) {
                    return Option::Some(
                        ("go_ffi symbol must be an exported ASCII Go identifier", attribute.span),
                    )
                } else if !value.generics.is_empty() || !value.generic_bounds.is_empty()
                    || !value.predicates.is_empty() {
                    return Option::Some(
                        (
                            "Go FFI functions cannot declare generic parameters or predicates",
                            attribute.span,
                        ),
                    )
                } else {},
                None => return Option::Some(
                    (
                        "go_ffi attribute expects import path and symbol string arguments",
                        attribute.span,
                    ),
                ),
            }
        } else {}
    }
    Option::None
}

fn collect_enum(value: hir::EnumDef) -> EnumInfo {
    let variants: Vec[EnumVariantInfo] = Vec::[];
    for variant in value.variants {
        let fields = match variant.fields {
            Unit => EnumVariantFields::Unit,
            Tuple(types) => {
                let lowered: Vec[Type] = Vec::[];
                for field in types {
                    lowered.push(type_from_hir(field, value.generics, Option::None))
                }
                EnumVariantFields::Tuple(lowered)
            },
            Struct(fields) => {
                let lowered: Vec[(string, Type)] = Vec::[];
                for field in fields {
                    lowered.push((field.0, type_from_hir(field.1, value.generics, Option::None)))
                }
                EnumVariantFields::Struct(lowered)
            },
        };
        variants.push(EnumVariantInfo { name: variant.name, fields })
    }
    EnumInfo { def_id: value.def_id, name: value.name, generics: value.generics, variants }
}

fn collect_struct(value: hir::StructDef) -> StructInfo {
    let fields: Vec[(string, Type)] = Vec::[];
    for field in value.fields {
        fields.push((field.0, type_from_hir(field.1, value.generics, Option::None)))
    }
    StructInfo {
        def_id: value.def_id,
        name: value.name,
        generics: value.generics,
        fields,
        public_fields: value.public_fields,
        has_hidden_fields: false,
    }
}

fn qualify_trait_projection(value: Type, reference: TraitRef, associated_names: Vec[string]) -> Type {
    match value {
        Tuple { items: values } => {
            let result: Vec[Type] = Vec::[];
            for item in values {
                result.push(qualify_trait_projection(item, reference, associated_names))
            }
            Type::Tuple { items: result }
        },
        Projection { for_ty: base, name, trait_ref: qualifier } => {
            let base = qualify_trait_projection(base, reference, associated_names);
            let qualifier = match qualifier {
                Some(value) => Option::Some(value),
                None => match base {
                    Param { name: owner } => if owner == "Self"
                        && collections::contains(associated_names, name) {
                        Option::Some(reference)
                    } else {
                        Option::None
                    },
                    _ => Option::None,
                },
            };
            Type::Projection { for_ty: base, name, trait_ref: qualifier }
        },
        App { ty: base, args } => {
            let result: Vec[Type] = Vec::[];
            for arg in args {
                result.push(qualify_trait_projection(arg, reference, associated_names))
            }
            Type::App {
                ty: qualify_trait_projection(base, reference, associated_names),
                args: result,
            }
        },
        Array { len: length, elem } => Type::Array {
            len: length,
            elem: qualify_trait_projection(elem, reference, associated_names),
        },
        Slice { elem } => {
            Type::Slice { elem: qualify_trait_projection(elem, reference, associated_names) }
        },
        VecType { elem } => {
            Type::VecType { elem: qualify_trait_projection(elem, reference, associated_names) }
        },
        RefType { elem } => {
            Type::RefType { elem: qualify_trait_projection(elem, reference, associated_names) }
        },
        Channel { elem } => {
            Type::Channel { elem: qualify_trait_projection(elem, reference, associated_names) }
        },
        HashMap { key, value: item } => Type::HashMap {
            key: qualify_trait_projection(key, reference, associated_names),
            value: qualify_trait_projection(item, reference, associated_names),
        },
        Func { params, ret_ty } => {
            let result: Vec[Type] = Vec::[];
            for param in params {
                result.push(qualify_trait_projection(param, reference, associated_names))
            }
            Type::Func {
                params: result,
                ret_ty: qualify_trait_projection(ret_ty, reference, associated_names),
            }
        },
        other => other,
    }
}

fn qualify_trait_ref_projection(value: TraitRef, reference: TraitRef, associated_names: Vec[string]) -> TraitRef {
    let args: Vec[Type] = Vec::[];
    for arg in value.args {
        args.push(qualify_trait_projection(arg, reference, associated_names))
    }
    TraitRef { name: value.name, args }
}

fn qualify_trait_predicate(value: TypePredicate, reference: TraitRef, associated_names: Vec[string]) -> TypePredicate {
    match value {
        Trait { for_ty, trait_ref } => TypePredicate::Trait {
            for_ty: qualify_trait_projection(for_ty, reference, associated_names),
            trait_ref: qualify_trait_ref_projection(trait_ref, reference, associated_names),
        },
        Equality { lhs: left, rhs: right } => TypePredicate::Equality {
            lhs: qualify_trait_projection(left, reference, associated_names),
            rhs: qualify_trait_projection(right, reference, associated_names),
        },
    }
}

fn collect_trait(value: hir::TraitDef) -> TraitInfo {
    let params = append_names(value.generics, Vec::["Self"]);
    let raw_predicates = predicates_from_hir(
        value.generic_bounds,
        value.predicates,
        params,
        Option::None,
    );
    let supertraits: Vec[TraitRef] = Vec::[];
    for supertrait in value.supertraits {
        supertraits.push(trait_ref_from_hir(supertrait, params, Option::None))
    }
    let trait_args: Vec[Type] = Vec::[];
    for generic in value.generics {
        trait_args.push(Type::Param { name: generic })
    }
    let reference = TraitRef { name: value.name, args: trait_args };
    let associated_types: Vec[AssociatedTypeInfo] = Vec::[];
    let associated_names: Vec[string] = Vec::[];
    for associated in value.associated_types {
        let bounds: Vec[TraitRef] = Vec::[];
        for bound in associated.bounds {
            bounds.push(trait_ref_from_hir(bound, params, Option::None))
        }
        associated_types.push(AssociatedTypeInfo { name: associated.name, bounds });
        associated_names.push(associated.name)
    }
    let predicates: Vec[TypePredicate] = Vec::[];
    for predicate in raw_predicates {
        predicates.push(qualify_trait_predicate(predicate, reference, associated_names))
    }
    let methods: Vec[TraitMethodInfo] = Vec::[];
    for method in value.method_sigs {
        let method_type_params = append_names(params, method.generics);
        let method_predicates: Vec[TypePredicate] = Vec::[];
        for predicate in predicates_from_hir(
            method.generic_bounds,
            method.predicates,
            method_type_params,
            Option::None,
        ) {
            method_predicates.push(qualify_trait_predicate(predicate, reference, associated_names))
        }
        let method_params: Vec[Type] = Vec::[];
        for param in method.params {
            method_params.push(
                qualify_trait_projection(
                    type_from_hir(param, method_type_params, Option::None),
                    reference,
                    associated_names,
                ),
            )
        }
        methods.push(
            TraitMethodInfo {
                name: method.name,
                generics: method.generics,
                predicates: method_predicates,
                params: method_params,
                ret_ty: qualify_trait_projection(
                    type_from_hir(method.ret_ty, method_type_params, Option::None),
                    reference,
                    associated_names,
                ),
                default_name: method.default_name,
            },
        )
    }
    TraitInfo {
        name: value.name,
        generics: value.generics,
        predicates,
        supertraits,
        associated_types,
        methods,
    }
}

fn collected_nominal_arity(enums: Vec[EnumInfo], structs: Vec[StructInfo], name: string) -> Option[
    int,
] {
    let mut result = builtin_nominal_arity(short_name(name));
    for value in enums {
        if names_match(value.name, name) {
            result = Option::Some(value.generics.len());
        } else {}
    }
    for value in structs {
        if names_match(value.name, name) {
            result = Option::Some(value.generics.len());
        } else {}
    }
    result
}

fn collected_type_error_kind(enums: Vec[EnumInfo], structs: Vec[StructInfo], value: Type) -> int {
    match prune(value) {
        Con { name } => match collected_nominal_arity(enums, structs, name) {
            Some(expected) => if expected == 0 {
                0
            } else {
                1
            },
            None => if name == short_name(name) {
                2
            } else {
                0
            },
        },
        Tuple { items: values } => {
            let mut result = 0;
            for value in values {
                let kind = collected_type_error_kind(enums, structs, value);
                if result == 0 && kind != 0 {
                    result = kind;
                } else {}
            }
            result
        },
        Projection { for_ty: base, name: _, trait_ref: _ } => collected_type_error_kind(
            enums,
            structs,
            base,
        ),
        App { ty: base, args } => {
            let result = match prune(base) {
                Con { name } => match collected_nominal_arity(enums, structs, name) {
                    Some(expected) => if expected == args.len() {
                        0
                    } else {
                        1
                    },
                    None => if name == short_name(name) {
                        2
                    } else {
                        0
                    },
                },
                _ => collected_type_error_kind(enums, structs, base),
            };
            let mut result = result;
            for value in args {
                let kind = collected_type_error_kind(enums, structs, value);
                if result == 0 && kind != 0 {
                    result = kind;
                } else {}
            }
            result
        },
        Array { len: _, elem } | Slice { elem } | VecType { elem } | RefType { elem } | Channel {
            elem,
        } => collected_type_error_kind(enums, structs, elem),
        HashMap { key, value } => {
            let key_kind = collected_type_error_kind(enums, structs, key);
            if key_kind != 0 {
                key_kind
            } else {
                collected_type_error_kind(enums, structs, value)
            }
        },
        Func { params, ret_ty } => {
            let mut result = collected_type_error_kind(enums, structs, ret_ty);
            for value in params {
                let kind = collected_type_error_kind(enums, structs, value);
                if result == 0 && kind != 0 {
                    result = kind;
                } else {}
            }
            result
        },
        _ => 0,
    }
}

fn resolve_signature_types(ctx: Checker, values: Vec[Type], predicates: Vec[TypePredicate]) -> Vec[
    Type,
] {
    let result: Vec[Type] = Vec::[];
    for value in values {
        result.push(resolve_signature_type(ctx, value, predicates, false))
    }
    result
}

fn expand_alias_types(ctx: Checker, values: Vec[Type]) -> Vec[Type] {
    let result: Vec[Type] = Vec::[];
    for value in values {
        result.push(expand_type_aliases(ctx, value, false))
    }
    result
}

fn resolve_signature_trait_ref(ctx: Checker, value: TraitRef, predicates: Vec[TypePredicate]) -> TraitRef {
    TraitRef { name: value.name, args: resolve_signature_types(ctx, value.args, predicates) }
}

fn resolve_signature_callable(ctx: Checker, value: Callable, predicates: Vec[TypePredicate]) -> Callable {
    match value {
        TraitMethod { trait_ref, method_name } => {
            Callable::TraitMethod {
                trait_ref: resolve_signature_trait_ref(ctx, trait_ref, predicates),
                method_name,
            }
        },
        InherentMethod { receiver_ty, method_name } => {
            Callable::InherentMethod {
                receiver_ty: resolve_signature_type(ctx, receiver_ty, predicates, false),
                method_name,
            }
        },
        other => other,
    }
}

fn resolve_function_scheme_signature(ctx: Checker, value: FunctionScheme) -> FunctionScheme {
    let predicates = resolve_signature_predicates(ctx, value.predicates, false);
    FunctionScheme {
        comptime: value.comptime,
        def_id: value.def_id,
        name: value.name,
        generics: value.generics,
        predicates,
        params: resolve_signature_types(ctx, value.params, predicates),
        ret_ty: resolve_signature_type(ctx, value.ret_ty, predicates, false),
        callable: resolve_signature_callable(ctx, value.callable, predicates),
    }
}

fn resolve_enum_info_signature(ctx: Checker, value: EnumInfo) -> EnumInfo {
    let variants: Vec[EnumVariantInfo] = Vec::[];
    for variant in value.variants {
        let fields = match variant.fields {
            Unit => EnumVariantFields::Unit,
            Tuple(values) => EnumVariantFields::Tuple(expand_alias_types(ctx, values)),
            Struct(values) => {
                let fields: Vec[(string, Type)] = Vec::[];
                for field in values {
                    fields.push((field.0, expand_type_aliases(ctx, field.1, false)))
                }
                EnumVariantFields::Struct(fields)
            },
        };
        variants.push(EnumVariantInfo { name: variant.name, fields })
    }
    EnumInfo { def_id: value.def_id, name: value.name, generics: value.generics, variants }
}

fn resolve_struct_info_signature(ctx: Checker, value: StructInfo) -> StructInfo {
    let fields: Vec[(string, Type)] = Vec::[];
    for field in value.fields {
        fields.push((field.0, expand_type_aliases(ctx, field.1, false)))
    }
    StructInfo {
        def_id: value.def_id,
        name: value.name,
        generics: value.generics,
        fields,
        public_fields: value.public_fields,
        has_hidden_fields: value.has_hidden_fields,
    }
}

fn resolve_trait_info_signature(ctx: Checker, value: TraitInfo) -> TraitInfo {
    let predicates = expand_type_alias_predicates(ctx, value.predicates, false);
    let supertraits: Vec[TraitRef] = Vec::[];
    for reference in value.supertraits {
        supertraits.push(expand_type_alias_trait_ref(ctx, reference, false))
    }
    let associated_types: Vec[AssociatedTypeInfo] = Vec::[];
    for associated in value.associated_types {
        let bounds: Vec[TraitRef] = Vec::[];
        for bound in associated.bounds {
            bounds.push(expand_type_alias_trait_ref(ctx, bound, false))
        }
        associated_types.push(AssociatedTypeInfo { name: associated.name, bounds })
    }
    let methods: Vec[TraitMethodInfo] = Vec::[];
    for method in value.methods {
        methods.push(
            TraitMethodInfo {
                name: method.name,
                generics: method.generics,
                predicates: expand_type_alias_predicates(ctx, method.predicates, false),
                params: expand_alias_types(ctx, method.params),
                ret_ty: expand_type_aliases(ctx, method.ret_ty, false),
                default_name: method.default_name,
            },
        )
    }
    TraitInfo {
        name: value.name,
        generics: value.generics,
        predicates,
        supertraits,
        associated_types,
        methods,
    }
}

fn resolve_method_info_signature(ctx: Checker, value: MethodInfo) -> MethodInfo {
    let predicates = expand_type_alias_predicates(ctx, value.function.predicates, false);
    let function = FunctionScheme {
        def_id: value.function.def_id,
        name: value.function.name,
        comptime: value.function.comptime,
        generics: value.function.generics,
        predicates,
        params: expand_alias_types(ctx, value.function.params),
        ret_ty: expand_type_aliases(ctx, value.function.ret_ty, false),
        callable: match value.function.callable {
            TraitMethod { trait_ref, method_name } => {
                Callable::TraitMethod {
                    trait_ref: expand_type_alias_trait_ref(ctx, trait_ref, false),
                    method_name,
                }
            },
            InherentMethod { receiver_ty, method_name } => {
                Callable::InherentMethod {
                    receiver_ty: expand_type_aliases(ctx, receiver_ty, false),
                    method_name,
                }
            },
            other => other,
        },
    };
    MethodInfo {
        owner_generics: value.owner_generics,
        method_generics: value.method_generics,
        owner_predicate_count: value.owner_predicate_count,
        trait_ref: match value.trait_ref {
            Some(reference) => Option::Some(expand_type_alias_trait_ref(ctx, reference, false)),
            None => Option::None,
        },
        for_type: expand_type_aliases(ctx, value.for_type, false),
        function,
    }
}

fn resolve_impl_info_signature(ctx: Checker, value: ImplInfo) -> ImplInfo {
    let predicates = expand_type_alias_predicates(ctx, value.predicates, false);
    let associated_types: Vec[(string, Type)] = Vec::[];
    for associated in value.associated_types {
        associated_types.push((associated.0, expand_type_aliases(ctx, associated.1, false)))
    }
    ImplInfo {
        generics: value.generics,
        predicates,
        trait_ref: expand_type_alias_trait_ref(ctx, value.trait_ref, false),
        for_type: expand_type_aliases(ctx, value.for_type, false),
        associated_types,
        origin: value.origin,
        span: value.span,
    }
}

fn collect_environment(file: hir::File, allow_externs: bool) -> Checker {
    let enums: Vec[EnumInfo] = Vec::[];
    let structs: Vec[StructInfo] = Vec::[];
    let type_aliases: Vec[TypeAliasInfo] = Vec::[];
    let constants: Vec[ConstantScheme] = Vec::[];
    let traits: Vec[TraitInfo] = Vec::[];
    for item in file.items {
        match item {
            EnumDef(value) => enums.push(collect_enum(value)),
            StructDef(value) => structs.push(collect_struct(value)),
            TypeAlias(value) => type_aliases.push(
                TypeAliasInfo {
                    name: value.name,
                    generics: value.generics,
                    ty: type_from_hir(value.ty, value.generics, Option::None),
                },
            ),
            Constant(value) => constants.push(
                ConstantScheme {
                    def_id: Option::Some(value.def_id),
                    name: value.name,
                    ty: type_from_hir(value.ty, Vec::[], Option::None),
                },
            ),
            TraitDef(value) => traits.push(collect_trait(value)),
            _ => (),
        }
    }
    let functions: Vec[FunctionScheme] = Vec::[];
    let diagnostics: Vec[Diagnostic] = Vec::[];
    let rejected_externs: Vec[RejectedExtern] = Vec::[];
    let methods: Vec[MethodInfo] = Vec::[];
    let impls: Vec[ImplInfo] = Vec::[];
    let invalid_impl_arity_owners: Vec[string] = Vec::[];
    for item in file.items {
        match item {
            Function(value) => functions.push(
                function_scheme(
                    value,
                    Vec::[],
                    Vec::[],
                    Option::None,
                    Callable::Function(value.name),
                ),
            ),
            ExternFunction(value) => if allow_externs || has_go_ffi_attribute(value) {
                match extern_callable_diagnostic(value) {
                    Some(diagnostic) => diagnostics.push(
                        new_diagnostic(
                            "typer",
                            diagnostic.0,
                            file.source_path,
                            Option::Some(diagnostic.1),
                        ),
                    ),
                    None => (),
                };
                functions.push(extern_scheme(value))
            } else {
                rejected_externs.push(
                    RejectedExtern {
                        def_id: value.def_id,
                        name: value.name,
                        arity: value.params.len(),
                        source_path: file.source_path,
                        local: true,
                    },
                )
            },
            ImplBlock(value) => {
                let for_type = type_from_hir(value.for_type, value.generics, Option::None);
                let trait_ref = match value.trait_ref {
                    Some(reference) => Option::Some(
                        trait_ref_from_hir(reference, value.generics, Option::Some(for_type)),
                    ),
                    None => Option::None,
                };
                let predicates = predicates_from_hir(
                    value.generic_bounds,
                    value.predicates,
                    value.generics,
                    Option::Some(for_type),
                );
                let target_error = collected_type_error_kind(enums, structs, for_type);
                if target_error == 0 {
                    match trait_ref {
                        Some(reference) => {
                            let associated_types: Vec[(string, Type)] = Vec::[];
                            for associated in value.associated_types {
                                associated_types.push(
                                    (
                                        associated.0,
                                        type_from_hir(
                                            associated.1,
                                            value.generics,
                                            Option::Some(for_type),
                                        ),
                                    ),
                                )
                            }
                            impls.push(
                                ImplInfo {
                                    generics: value.generics,
                                    predicates,
                                    trait_ref: reference,
                                    for_type,
                                    associated_types,
                                    origin: file.package_name + "#" + impls.len().to_string(),
                                    span: value.for_type_span,
                                },
                            )
                        },
                        None => (),
                    };
                    for method in value.methods {
                        let callable = match trait_ref {
                            Some(reference) => {
                                Callable::TraitMethod {
                                    trait_ref: reference,
                                    method_name: method.name,
                                }
                            },
                            None => Callable::InherentMethod {
                                receiver_ty: for_type,
                                method_name: method.name,
                            },
                        };
                        methods.push(
                            MethodInfo {
                                owner_generics: value.generics,
                                method_generics: method.generics,
                                owner_predicate_count: predicates.len(),
                                trait_ref,
                                for_type,
                                function: function_scheme(
                                    method,
                                    value.generics,
                                    predicates,
                                    Option::Some(for_type),
                                    callable,
                                ),
                            },
                        )
                    }
                } else if target_error == 1 {
                    match type_constructor_name(for_type) {
                        Some(owner) => if !collections::contains(invalid_impl_arity_owners, owner) {
                            invalid_impl_arity_owners.push(owner)
                        } else {},
                        None => (),
                    }
                } else {}
            },
            _ => (),
        }
    }
    let in_scope_traits = file.use_traits;
    let builtin_traits: Vec[string] = Vec::[];
    builtin_traits.push("ToString");
    builtin_traits.push("Eq");
    builtin_traits.push("Hash");
    builtin_traits.push("Iterator");
    builtin_traits.push("IntoIterator");
    for name in builtin_traits {
        if !collections::contains(in_scope_traits, name) {
            in_scope_traits.push(name)
        } else {}
    }
    for value in traits {
        if !collections::contains(in_scope_traits, value.name) {
            in_scope_traits.push(value.name)
        } else {}
    }
    let environment = Checker {
        counter: Ref::new(0),
        diagnostics,
        typeck_results: empty_typeck_results(),
        package_name: file.package_name,
        source_path: file.source_path,
        current_span: Ref::new(Option::None),
        coercion_constraints: Vec::[],
        numeric_literal_constraints: Vec::[],
        defer_coercion_depth: Ref::new(0),
        package_aliases: file.import_aliases,
        symbol_aliases: Vec::[],
        imported_items: file.imports,
        in_scope_traits,
        enums,
        structs,
        type_aliases,
        constants,
        enum_names: enum_name_index(enums, false),
        enum_short_names: enum_name_index(enums, true),
        struct_names: struct_name_index(structs, false),
        struct_short_names: struct_name_index(structs, true),
        coverage_domains: HashMap::{},
        coverage_inhabited: HashMap::{},
        traits,
        functions,
        rejected_externs,
        methods,
        impls,
        invalid_impl_origins: Vec::[],
        invalid_impl_arity_owners,
        predicates: Vec::[],
        param_aliases: Vec::[],
        projection_aliases: Vec::[],
        field_constraints: Vec::[],
        silent_field_receivers: Vec::[],
        required_predicates: Vec::[],
        locals: Vec::[],
        unresolved_locals: Vec::[],
        unresolved_inference_vars: Vec::[],
        reported_inference_spans: Vec::[],
        suppress_unresolved_ref_diagnostic: Ref::new(0),
        mutable_locals: Vec::[],
        return_ty: Type::Unit,
        self_ty: Option::None,
        type_params: Vec::[],
        loop_depth: Ref::new(0),
        loop_results: Vec::[],
        condition_depth: Ref::new(0),
        condition_loop_depth: Ref::new(0),
        comptime_depth: Ref::new(0),
        comptime_capability: ComptimeCapability::RuntimeOnly,
        allow_unstructured_go: false,
    };
    for index in 0..environment.enums.len() {
        environment.enums.set(
            index,
            resolve_enum_info_signature(environment, environment.enums[index]),
        )
    }
    for index in 0..environment.structs.len() {
        environment.structs.set(
            index,
            resolve_struct_info_signature(environment, environment.structs[index]),
        )
    }
    for index in 0..environment.traits.len() {
        environment.traits.set(
            index,
            resolve_trait_info_signature(environment, environment.traits[index]),
        )
    }
    for index in 0..environment.functions.len() {
        environment.functions.set(
            index,
            resolve_function_scheme_signature(environment, environment.functions[index]),
        )
    }
    for index in 0..environment.methods.len() {
        environment.methods.set(
            index,
            resolve_method_info_signature(environment, environment.methods[index]),
        )
    }
    for index in 0..environment.impls.len() {
        environment.impls.set(
            index,
            resolve_impl_info_signature(environment, environment.impls[index]),
        )
    }
    for index in 0..environment.constants.len() {
        let value = environment.constants[index];
        environment.constants.set(
            index,
            ConstantScheme {
                def_id: value.def_id,
                name: value.name,
                ty: resolve_signature_type(environment, value.ty, Vec::[], false),
            },
        )
    }
    environment
}

fn validate_go_ffi_signatures(ctx: Checker, file: hir::File) -> unit {
    for item in file.items {
        match item {
            ExternFunction(value) if extern_callable_diagnostic(value).is_none()
                && has_go_ffi_attribute(value) => {
                match go_ffi_signature_diagnostic(ctx, value) {
                    Some(message) => ctx.diagnostics.push(
                        new_diagnostic(
                            "typer",
                            message,
                            file.source_path,
                            Option::Some(go_ffi_attribute_span(value)),
                        ),
                    ),
                    None => (),
                }
            },
            _ => (),
        }
    }
}

pub fn package_signatures(file: hir::File) -> PackageSignatures {
    let environment = collect_environment(file, true);
    let type_aliases: Vec[TypeAliasInfo] = Vec::[];
    for value in environment.type_aliases {
        type_aliases.push(
            TypeAliasInfo {
                name: value.name,
                generics: value.generics,
                ty: normalized_type_alias_target(environment, value),
            },
        )
    }
    PackageSignatures {
        traits: environment.traits,
        functions: environment.functions,
        type_aliases,
        constants: environment.constants,
    }
}

fn canonical_supertrait_scope_name(ctx: Checker, owner: string, name: string) -> string {
    let mut result = name;
    if short_name(name) == name {
        let owner_short = short_name(owner);
        let prefix = owner.byte_slice(0, owner.byte_len() - owner_short.byte_len());
        let candidate = prefix + name;
        for info in ctx.traits {
            if info.name == candidate {
                result = candidate;
            } else {}
        }
    } else {};
    result
}

fn expand_in_scope_supertraits(ctx: Checker) -> unit {
    let mut index = 0;
    while index < ctx.in_scope_traits.len() {
        let name = ctx.in_scope_traits[index];
        index = index + 1;
        for info in ctx.traits {
            if info.name == name {
                for supertrait in info.supertraits {
                    let supertrait_name = canonical_supertrait_scope_name(
                        ctx,
                        info.name,
                        supertrait.name,
                    );
                    if collections::contains(ctx.in_scope_traits, supertrait_name) {} else {
                        ctx.in_scope_traits.push(supertrait_name)
                    }
                }
            } else {}
        }
    }
}

fn external_function_scheme(value: FunctionScheme) -> FunctionScheme {
    FunctionScheme {
        comptime: value.comptime,
        def_id: Option::None,
        name: value.name,
        generics: value.generics,
        predicates: value.predicates,
        params: value.params,
        ret_ty: value.ret_ty,
        callable: value.callable,
    }
}

fn append_package_environment(ctx: Checker, file: hir::File, allow_externs: bool) -> unit {
    let package_env = collect_environment(file, allow_externs);
    for value in package_env.enums {
        ctx.enums.push(value);
        index_enum_name(ctx, value, ctx.enums.len() - 1)
    }
    for value in package_env.structs {
        ctx.structs.push(value);
        index_struct_name(ctx, value, ctx.structs.len() - 1)
    }
    for value in package_env.type_aliases {
        ctx.type_aliases.push(value)
    }
    for value in package_env.constants {
        ctx.constants.push(value)
    }
    for value in package_env.traits {
        if collections::contains(ctx.in_scope_traits, value.name) {} else {
            ctx.in_scope_traits.push(value.name)
        };
        ctx.traits.push(value)
    }
    for value in package_env.functions {
        ctx.functions.push(value)
    }
    for value in package_env.rejected_externs {
        ctx.rejected_externs.push(
            RejectedExtern {
                def_id: value.def_id,
                name: value.name,
                arity: value.arity,
                source_path: value.source_path,
                local: false,
            },
        )
    }
    for value in package_env.methods {
        ctx.methods.push(value)
    }
    for value in package_env.impls {
        ctx.impls.push(value)
    }
}

fn dependency_environment_from_hir(file: hir::File) -> DependencyEnvironment {
    let dependency = collect_environment(file, true);
    let enums: Vec[EnumInfo] = Vec::[];
    for value in dependency.enums {
        enums.push(
            EnumInfo {
                def_id: hir::DefId { pkg: -1, index: -1 },
                name: value.name,
                generics: value.generics,
                variants: value.variants,
            },
        )
    }
    let structs: Vec[StructInfo] = Vec::[];
    for value in dependency.structs {
        structs.push(
            StructInfo {
                def_id: hir::DefId { pkg: -1, index: -1 },
                name: value.name,
                generics: value.generics,
                fields: value.fields,
                public_fields: value.public_fields,
                has_hidden_fields: value.has_hidden_fields,
            },
        )
    }
    let functions: Vec[FunctionScheme] = Vec::[];
    for value in dependency.functions {
        functions.push(external_function_scheme(value))
    }
    let methods: Vec[MethodInfo] = Vec::[];
    for value in dependency.methods {
        methods.push(
            MethodInfo {
                owner_generics: value.owner_generics,
                method_generics: value.method_generics,
                owner_predicate_count: value.owner_predicate_count,
                trait_ref: value.trait_ref,
                for_type: value.for_type,
                function: external_function_scheme(value.function),
            },
        )
    }
    let reexports: Vec[(string, string)] = Vec::[];
    for value in file.public_reexports {
        reexports.push(
            (
                if file.package_name == "main" || file.package_name == "builtin" {
                    value.0
                } else {
                    file.package_name + "::" + value.0
                },
                value.1,
            ),
        )
    }
    DependencyEnvironment {
        comptime: Option::None,
        reexports,
        enums,
        structs,
        type_aliases: dependency.type_aliases,
        constants: dependency.constants,
        traits: dependency.traits,
        functions,
        methods,
        impls: dependency.impls,
    }
}

pub fn dependency_environments(values: Vec[hir::File]) -> Vec[DependencyEnvironment] {
    let result: Vec[DependencyEnvironment] = Vec::[];
    for value in values {
        result.push(dependency_environment_from_hir(value))
    }
    result
}

fn append_dependency_environment(ctx: Checker, dependency: DependencyEnvironment) -> unit {
    for value in dependency.reexports {
        ctx.symbol_aliases.push(value)
    }
    for value in dependency.enums {
        ctx.enums.push(value);
        index_enum_name(ctx, value, ctx.enums.len() - 1)
    }
    for value in dependency.structs {
        ctx.structs.push(value);
        index_struct_name(ctx, value, ctx.structs.len() - 1)
    }
    for value in dependency.type_aliases {
        ctx.type_aliases.push(value)
    }
    for value in dependency.constants {
        ctx.constants.push(value)
    }
    for value in dependency.traits {
        ctx.traits.push(value)
    }
    for value in dependency.functions {
        ctx.functions.push(value)
    }
    for value in dependency.methods {
        ctx.methods.push(value)
    }
    for value in dependency.impls {
        ctx.impls.push(value)
    }
}

fn package_function_scheme(ctx: Checker, owner: string, member: string) -> Option[FunctionScheme] {
    find_function_by_name(ctx, canonical_imported_name(ctx, owner + "::" + member))
}

fn explicit_function_scheme(ctx: Checker, owner: string, member: string) -> Option[FunctionScheme] {
    if owner == "" {
        match find_function_by_name(ctx, member) {
            Some(value) => Option::Some(value),
            None => builtin_function_scheme(member),
        }
    } else {
        package_function_scheme(ctx, owner, member)
    }
}

fn canonical_imported_name(ctx: Checker, name: string) -> string {
    let mut result = name;
    for alias in ctx.package_aliases {
        let prefix = alias.alias + "::";
        if name.byte_len() > prefix.byte_len() && name.starts_with(prefix) {
            result = alias.package_name + name.byte_slice(alias.alias.byte_len(), name.byte_len());
            break
        } else {}
    }
    let mut remaining = ctx.symbol_aliases.len() + 1;
    while remaining > 0 {
        let mut changed = false;
        for alias in ctx.symbol_aliases {
            if result == alias.0 {
                result = alias.1;
                changed = true;
                break
            } else {
                let prefix = alias.0 + "::";
                if result.starts_with(prefix) {
                    result = alias.1 + result.byte_slice(alias.0.byte_len(), result.byte_len());
                    changed = true;
                    break
                } else {}
            }
        }
        if !changed {
            return result
        } else {
            remaining = remaining - 1;
        };
    }
    result
}

fn is_package_alias(ctx: Checker, name: string) -> bool {
    for alias in ctx.package_aliases {
        if alias.alias == name || alias.package_name == name {
            return true
        } else {}
    }
    false
}

fn diagnostic_type_name(ctx: Checker, name: string) -> string {
    if name.contains("::") {
        canonical_imported_name(ctx, name)
    } else if ctx.package_name == "main" || ctx.package_name == "builtin" {
        name
    } else {
        ctx.package_name + "::" + name
    }
}

fn same_def(left: hir::DefId, right: hir::DefId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

fn same_local(left: hir::LocalId, right: hir::LocalId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

fn contains_local(values: Vec[hir::LocalId], expected: hir::LocalId) -> bool {
    for value in values {
        if same_local(value, expected) {
            return true
        } else {}
    }
    false
}

fn local_name(value: hir::LocalId) -> string {
    value.hint + "/" + value.index.to_string()
}

fn find_local(ctx: Checker, id: hir::LocalId) -> Option[Type] {
    for value in ctx.locals {
        if same_local(value.0, id) {
            return Option::Some(value.1)
        } else {}
    }
    Option::None
}

fn insert_local(ctx: Checker, id: hir::LocalId, ty: Type) -> unit {
    ctx.locals.push((id, ty));
    ctx.typeck_results.locals.push(
        LocalFact { source_path: ctx.source_path, span: ctx.current_span.get(), local: id, ty },
    )
}

fn mark_mutable_local(ctx: Checker, id: hir::LocalId) -> unit {
    ctx.mutable_locals.push(id)
}

fn local_is_mutable(ctx: Checker, id: hir::LocalId) -> bool {
    for candidate in ctx.mutable_locals {
        if same_local(candidate, id) {
            return true
        } else {}
    }
    false
}

fn find_function_by_def(ctx: Checker, id: hir::DefId) -> Option[FunctionScheme] {
    for value in ctx.functions {
        match value.def_id {
            Some(candidate) => if same_def(candidate, id) {
                return Option::Some(value)
            } else {},
            None => (),
        }
    }
    Option::None
}

fn find_constant_by_def(ctx: Checker, id: hir::DefId) -> Option[ConstantScheme] {
    for value in ctx.constants {
        match value.def_id {
            Some(candidate) => if same_def(candidate, id) {
                return Option::Some(value)
            } else {},
            None => (),
        }
    }
    Option::None
}

fn find_rejected_extern(ctx: Checker, id: hir::DefId) -> Option[RejectedExtern] {
    for value in ctx.rejected_externs {
        if same_def(value.def_id, id) {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn find_function_by_name(ctx: Checker, name: string) -> Option[FunctionScheme] {
    let name = canonical_imported_name(ctx, name);
    for offset in 0..ctx.functions.len() {
        let value = ctx.functions[ctx.functions.len() - 1 - offset];
        if value.name == name {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn find_constant_by_name(ctx: Checker, name: string) -> Option[ConstantScheme] {
    let name = canonical_imported_name(ctx, name);
    for offset in 0..ctx.constants.len() {
        let value = ctx.constants[ctx.constants.len() - 1 - offset];
        if value.name == name {
            return Option::Some(value)
        } else {}
    }
    Option::None
}

fn instantiate_scheme_candidate(ctx: Checker, value: FunctionScheme, explicit: Vec[Type]) -> InstantiatedFunction {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, explicit);
    let params: Vec[Type] = Vec::[];
    for param in value.params {
        params.push(substitute_type(param, substitutions))
    }
    let predicates = expand_implied_predicates(
        ctx,
        substitute_predicates(value.predicates, substitutions),
    );
    apply_predicate_equalities(predicates);
    InstantiatedFunction {
        callable: substitute_callable(value.callable, substitutions),
        ty: Type::Func { params, ret_ty: substitute_type(value.ret_ty, substitutions) },
        predicates,
    }
}

fn instantiate_scheme(ctx: Checker, value: FunctionScheme, explicit: Vec[Type]) -> (Callable, Type) {
    let candidate = instantiate_scheme_candidate(ctx, value, explicit);
    (candidate.callable, candidate.ty)
}

fn substitute_trait_ref(value: TraitRef, substitutions: Vec[TypeSubst]) -> TraitRef {
    let args: Vec[Type] = Vec::[];
    for arg in value.args {
        args.push(substitute_type(arg, substitutions))
    }
    TraitRef { name: value.name, args }
}

fn substitute_predicate(value: TypePredicate, substitutions: Vec[TypeSubst]) -> TypePredicate {
    match value {
        Trait { for_ty: ty, trait_ref: reference } => TypePredicate::Trait {
            for_ty: substitute_type(ty, substitutions),
            trait_ref: substitute_trait_ref(reference, substitutions),
        },
        Equality { lhs: left, rhs: right } => TypePredicate::Equality {
            lhs: substitute_type(left, substitutions),
            rhs: substitute_type(right, substitutions),
        },
    }
}

fn substitute_predicates(values: Vec[TypePredicate], substitutions: Vec[TypeSubst]) -> Vec[
    TypePredicate,
] {
    let result: Vec[TypePredicate] = Vec::[];
    for value in values {
        result.push(substitute_predicate(value, substitutions))
    }
    result
}

fn apply_predicate_equalities(values: Vec[TypePredicate]) -> unit {
    for value in values {
        match value {
            Equality { lhs: left, rhs: right } => {
                match (prune(left), prune(right)) {
                    (
                        Projection { for_ty: _, name: _, trait_ref: _ },
                        Projection { for_ty: _, name: _, trait_ref: _ },
                    ) => (),
                    (left, right) => {
                        let _ = unify(left, right);
                    },
                }
            },
            Trait { for_ty: _, trait_ref: _ } => (),
        }
    }
}

fn substitute_callable(value: Callable, substitutions: Vec[TypeSubst]) -> Callable {
    match value {
        Function(name) => Callable::Function(name),
        LangItem { item, function_name } => Callable::LangItem { item, function_name },
        Runtime(name) => Callable::Runtime(name),
        Intrinsic(name) => Callable::Intrinsic(name),
        GoForeign { import_path, symbol } => Callable::GoForeign { import_path, symbol },
        TraitMethod { trait_ref: reference, method_name: name } => {
            Callable::TraitMethod {
                trait_ref: substitute_trait_ref(reference, substitutions),
                method_name: name,
            }
        },
        DynTraitMethod { trait_name: owner, dispatch_name: dispatch, method_name: name } => {
            Callable::DynTraitMethod {
                trait_name: owner,
                dispatch_name: dispatch,
                method_name: name,
            }
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            Callable::InherentMethod {
                receiver_ty: substitute_type(owner, substitutions),
                method_name: name,
            }
        },
    }
}

fn expect_type(ctx: Checker, actual: Type, expected: Type) -> unit {
    expect_type_at(ctx, actual, expected, ctx.current_span.get())
}

fn expect_type_at(ctx: Checker, actual: Type, expected: Type, span: Option[ast::Span]) -> unit {
    let actual = normalize_type(ctx, actual);
    let expected = normalize_type(ctx, expected);
    let message = first_unification_error(actual, expected);
    if !unify(actual, expected) {
        push_diagnostic_at(
            ctx,
            match message {
                Some(message) => message,
                None => type_mismatch_text(actual, expected),
            },
            span,
        )
    } else {}
}

fn one_type(value: Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::[];
    result.push(value);
    result
}

fn two_types(first: Type, second: Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::[];
    result.push(first);
    result.push(second);
    result
}

fn three_types(first: Type, second: Type, third: Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::[];
    result.push(first);
    result.push(second);
    result.push(third);
    result
}

fn generic_names(first: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    result.push(first);
    result
}

fn generic_names2(first: string, second: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    result.push(first);
    result.push(second);
    result
}

fn builtin_callable(name: string) -> Callable {
    for spec in resources::intrinsic_abi_specs() {
        if spec.source_name == name {
            return Callable::Intrinsic(spec.key)
        } else {}
    }
    for key in resources::core_runtime_keys() {
        match resources::runtime_abi_by_key("core." + key) {
            Some(spec) => if spec.source_name == name {
                return Callable::Runtime(spec.key)
            } else {},
            None => (),
        }
    }
    Callable::Function(name)
}

fn apply_builtin_callable(value: Option[FunctionScheme], name: string) -> Option[FunctionScheme] {
    match value {
        Some(scheme) => {
            let callable = match scheme.callable {
                Function(_) => builtin_callable(name),
                other => other,
            };
            Option::Some(
                FunctionScheme {
                    comptime: scheme.comptime,
                    def_id: scheme.def_id,
                    name: scheme.name,
                    generics: scheme.generics,
                    predicates: scheme.predicates,
                    params: scheme.params,
                    ret_ty: scheme.ret_ty,
                    callable,
                },
            )
        },
        None => Option::None,
    }
}

fn derive_abi_type(name: string) -> Type {
    if name == "unit" {
        Type::Unit
    } else if name == "bool" {
        Type::Bool
    } else if name == "int" {
        Type::Int
    } else if name == "string" {
        Type::String
    } else {
        Type::Con { name }
    }
}

fn derive_intrinsic_scheme(name: string) -> Option[FunctionScheme] {
    for spec in derive::intrinsic_specs() {
        if spec.name == name {
            let params: Vec[Type] = Vec::[];
            for value in spec.params {
                params.push(derive_abi_type(value))
            }
            return Option::Some(
                FunctionScheme {
                    comptime: ComptimeCapability::Derive,
                    def_id: Option::None,
                    name,
                    generics: Vec::[],
                    predicates: Vec::[],
                    params,
                    ret_ty: derive_abi_type(spec.ret),
                    callable: Callable::Intrinsic(name),
                },
            )
        } else {}
    }
    Option::None
}

pub fn builtin_function_scheme(name: string) -> Option[FunctionScheme] {
    let t = Type::Param { name: "T" };
    let no_generics: Vec[string] = Vec::[];
    match derive_intrinsic_scheme(name) {
        Some(value) => return apply_builtin_callable(Option::Some(value), name),
        None => {},
    };
    let scheme = if name == "compile_error" {
        Option::Some(
            FunctionScheme {
                comptime: ComptimeCapability::Capable,
                def_id: Option::None,
                name,
                generics: no_generics,
                predicates: Vec::[],
                params: one_type(Type::String),
                ret_ty: Type::Never,
                callable: Callable::Intrinsic("compile_error"),
            },
        )
    } else if name == "print" || name == "println" {
        Option::Some(
            FunctionScheme {
                comptime: ComptimeCapability::RuntimeOnly,
                def_id: Option::None,
                name,
                generics: generic_names("T"),
