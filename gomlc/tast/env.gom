package tast;

use module::ast;
use module::ctir;
use module::derive;
use module::hir;
use module::parser;
use module::resources;

const TYPER_STAGE: string = "typer";

const INFERENCE_FAILURE_MESSAGE: string = "Could not infer type";

static implicit_builtin_hir_cache: OnceCell[Result[FrozenVec[hir::File], string]] = OnceCell::new();

fn implicit_prelude_hir_files() -> Result[Vec[hir::File], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array([]);
    for source in resources::prelude_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::from_array([]);
    for lowered in hir::lower_package_files(inputs, "prelude") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err("failed to lower prelude source " + lowered.source_path),
        }
    }
    Result::Ok(files)
}

fn load_implicit_builtin_hir_files() -> Result[FrozenVec[hir::File], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array([]);
    for source in resources::builtin_layer_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::from_array([]);
    for lowered in hir::lower_package_files(inputs, "builtin") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err("failed to lower builtin source " + lowered.source_path),
        }
    }
    Result::Ok(files.freeze())
}

fn implicit_builtin_hir_files() -> Result[Vec[hir::File], string] {
    Result::Ok(
        implicit_builtin_hir_cache.get_or_init(|| load_implicit_builtin_hir_files())?.to_vec(),
    )
}

fn implicit_builtin_dependency_environment() -> Result[DependencyEnvironment, string] {
    builtin_dependency_environment(implicit_builtin_hir_files()?)
}

fn collection_from_array_method(
    owner_generics: Vec[string],
    predicates: Vec[TypePredicate],
    for_type: Type,
    name: string,
    param: Type,
    intrinsic: string,
) -> MethodInfo {
    MethodInfo {
        owner_generics,
        method_generics: Vec::from_array([]),
        owner_predicate_count: predicates.len(),
        trait_ref: Option::None,
        for_type,
        function: FunctionScheme {
            comptime: ComptimeCapability::RuntimeOnly,
            def_id: Option::None,
            name,
            generics: owner_generics,
            predicates,
            params: Vec::from_array([param]),
            ret_ty: for_type,
            callable: Callable::Intrinsic(intrinsic),
        },
    }
}

fn reject_collection_from_array_method_conflicts(methods: Vec[MethodInfo], builtin: BuiltinContract) -> Result[
    unit,
    string,
] {
    for method in methods {
        let conflicts = if method.function.name == builtin.vec.from_array {
            match method.for_type {
                Type::VecType { elem: _ } => true,
                _ => false,
            }
        } else if method.function.name == builtin.hashmap.from_array {
            match method.for_type {
                Type::HashMap { key: _, value: _ } => true,
                _ => false,
            }
        } else {
            false
        };
        if conflicts {
            return Result::Err(
                "builtin collection method " + method.function.name
                    + " conflicts with synthetic method",
            )
        } else {}
    }
    Result::Ok(())
}

fn append_collection_from_array_methods(methods: Vec[MethodInfo], builtin: BuiltinContract) -> Result[
    unit,
    string,
] {
    reject_collection_from_array_method_conflicts(methods, builtin)?;
    let elem = Type::Param { name: "T" };
    methods.push(
        collection_from_array_method(
            Vec::from_array(["T"]),
            Vec::from_array([]),
            Type::VecType { elem },
            builtin.vec.from_array,
            Type::Array { len: -1, elem },
            "vec.from_array",
        ),
    );
    let key = Type::Param { name: "K" };
    let value = Type::Param { name: "V" };
    let predicates = Vec::from_array(
        [
            TypePredicate::Trait {
                for_ty: key,
                trait_ref: TraitRef { name: builtin.hash.name, args: Vec::from_array([]) },
            },
            TypePredicate::Trait {
                for_ty: key,
                trait_ref: TraitRef { name: builtin.eq.name, args: Vec::from_array([]) },
            },
        ],
    );
    methods.push(
        collection_from_array_method(
            Vec::from_array(["K", "V"]),
            predicates,
            Type::HashMap { key, value },
            builtin.hashmap.from_array,
            Type::Array { len: -1, elem: Type::Tuple { items: Vec::from_array([key, value]) } },
            "hashmap.from_array",
        ),
    );
    Result::Ok(())
}

pub fn append_builtin_collection_methods(methods: Vec[MethodInfo]) -> Result[unit, string] {
    append_collection_from_array_methods(methods, builtin_contract()?)
}

pub fn builtin_dependency_environment(files: Vec[hir::File]) -> Result[
    DependencyEnvironment,
    string,
] {
    let builtin = builtin_contract()?;
    let enums: Vec[EnumInfo] = Vec::from_array([]);
    let structs: Vec[StructInfo] = Vec::from_array([]);
    let type_aliases: Vec[TypeAliasInfo] = Vec::from_array([]);
    let constants: Vec[ConstantScheme] = Vec::from_array([]);
    let functions: Vec[FunctionScheme] = Vec::from_array([]);
    let methods: Vec[MethodInfo] = Vec::from_array([]);
    let exported_names = resources::prelude_builtin_export_names();
    for file in files {
        let environment = dependency_environment_from_hir_with_contract(file, builtin);
        for value in environment.enums {
            if builtin_source_enum_info(value.name).is_none() {
                enums.push(value)
            } else {}
        }
        for value in environment.structs {
            structs.push(value)
        }
        for value in environment.type_aliases {
            type_aliases.push(value)
        }
        for value in environment.constants {
            constants.push(value)
        }
        for value in environment.functions {
            if exported_names.contains(value.name) {
                functions.push(value)
            } else {}
        }
        for value in environment.methods {
            methods.push(value)
        }
    }
    append_collection_from_array_methods(methods, builtin)?;
    Result::Ok(
        dependency_environment(
            Vec::from_array([]),
            enums,
            structs,
            type_aliases,
            constants,
            Vec::from_array([]),
            functions,
            methods,
            Vec::from_array([]),
        ),
    )
}

pub struct EnumVariantInfo {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub struct EnumInfo {
    pub def_id: hir::DefId,
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariantInfo],
}

pub fn enum_variant_field_types(fields: EnumVariantFields) -> Vec[Type] {
    match fields {
        Unit => Vec::from_array([]),
        Tuple(types) => types,
        Struct(fields) => {
            let types: Vec[Type] = Vec::from_array([]);
            for field in fields {
                types.push(field.1)
            }
            types
        },
    }
}

pub fn enum_variant_named_fields(fields: EnumVariantFields) -> Option[Vec[(string, Type)]] {
    match fields {
        Struct(fields) => Option::Some(fields),
        _ => Option::None,
    }
}

