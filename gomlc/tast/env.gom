                generics: generic_names("T"),
                predicates: Vec::[],
                params: one_type(Type::Channel { elem: t }),
                ret_ty: Type::Unit,
                callable: Callable::Function(name),
            },
        )
    } else if name == "range" || name == "__goml_builtin_range"
        || name == "__goml_builtin_range_inclusive" {
        let item = if name == "__goml_builtin_range_inclusive" {
            "range_inclusive"
        } else {
            "range"
        };
        Option::Some(
            FunctionScheme {
                comptime: ComptimeCapability::RuntimeOnly,
                def_id: Option::None,
                name,
                generics: no_generics,
                predicates: Vec::[],
                params: two_types(Type::Int, Type::Int),
                ret_ty: nominal_type("FnIterator", one_type(Type::Int)),
