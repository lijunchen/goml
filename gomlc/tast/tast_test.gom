package tast;

use gomlc::ast;
use gomlc::hir;
use gomlc::parser;
use gomlc::pretty;
use std::testing;
use std::text;

fn checked_file(source: string) -> File {
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => file,
        None => {
            testing::fail("expected TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
            }
        },
    }
}

fn checked_diagnostics(source: string) -> Vec[Diagnostic] {
    check(hir::lower(ast::lower(parser::parse(source)), "main.gom")).diagnostics
}

fn has_diagnostic(values: Vec[Diagnostic], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.message == expected {
            found.set(true)
        } else {}
    }
    found.get()
}

fn has_diagnostic_containing(values: Vec[Diagnostic], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.message.contains(expected) {
            found.set(true)
        } else {}
    }
    found.get()
}

#[test]
fn evaluates_explicit_comptime_functions() -> unit {
    let file = checked_file(
        "#[comptime] fn fibonacci(n: int) -> int { if n < 2 { n } else { fibonacci(n - 1) + fibonacci(n - 2) } } fn main() -> int { comptime { fibonacci(10) } }",
    );
    testing::assert_eq(file.items.len(), 2);
    match file.items[1] {
        Function(value) => match value.body.tail {
            Some(Prim { value: Primitive::Int { value }, ty: _ }) => {
                testing::assert_eq(value, "55")
            },
            _ => testing::fail("expected a reified comptime integer"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn validates_comptime_derive_capability_boundaries() -> unit {
    let named = checked_file(
        "#[comptime_derive(Label)] pub fn handler(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    match named.items[0] {
        Function(value) => match value.derive_export_name {
            Some(name) => testing::assert_eq(name, "Label"),
            None => testing::fail("expected named derive export"),
        },
        _ => testing::fail("expected named derive handler"),
    };
    let private_named = checked_diagnostics(
        "#[comptime_derive(Label)] fn handler(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    testing::assert(
        has_diagnostic(private_named, "a named #[comptime_derive] export must be public"),
    );
    let invalid_name = checked_diagnostics(
        "#[comptime_derive(owner::Label)] pub fn handler(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    testing::assert(
        has_diagnostic(
            invalid_name,
            "#[comptime_derive] accepts at most one identifier export name",
        ),
    );
    let duplicate = checked_diagnostics(
        "#[comptime_derive(Label)] pub fn first(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") } #[comptime_derive(Label)] pub fn second(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    testing::assert(has_diagnostic(duplicate, "duplicate comptime derive export `Label`"));
    let invalid_signature = checked_diagnostics("#[comptime_derive] pub fn handler() -> int { 1 }");
    testing::assert(
        has_diagnostic(
            invalid_signature,
            "public #[comptime_derive] function must have signature (DeriveInput) -> DeriveOutput",
        ),
    );
    let runtime_call = checked_diagnostics(
        "#[comptime_derive] fn helper() -> int { 1 } fn value() -> int { helper() }",
    );
    testing::assert(
        has_diagnostic(
            runtime_call,
            "#[comptime_derive] function is only callable from another derive handler",
        ),
    );
    let intrinsic_call = checked_diagnostics("fn value() -> MetaExpr { meta_expr_unit() }");
    testing::assert(
        has_diagnostic(
            intrinsic_call,
            "derive intrinsic `meta_expr_unit` is only available in #[comptime_derive]",
        ),
    );
    let leaked_type = checked_diagnostics("fn value(input: DeriveInput) -> DeriveInput { input }");
    testing::assert(
        has_diagnostic(
            leaked_type,
            "derive metadata type DeriveInput is only available in #[comptime_derive]",
        ),
    )
}

#[test]
fn evaluates_comptime_shadowing_like_runtime() -> unit {
    let file = checked_file(
        "#[comptime] fn shadow(value: int) -> int { let base = value; let nested = { let base = base + 1; base * 2 }; base + nested } fn main() -> int { comptime { shadow(3) } }",
    );
    match file.items[1] {
        Function(value) => match value.body.tail {
            Some(Prim { value: Primitive::Int { value }, ty: _ }) => {
                testing::assert_eq(value, "12")
            },
            _ => testing::fail("expected a shadowed comptime integer"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn eliminates_comptime_before_core_lowering() -> unit {
    let file = checked_file(
        "#[comptime] fn double(value: int) -> int { value * 2 } fn main() -> int { comptime { double(21) } }",
    );
    testing::assert(!contains_comptime(file))
}

#[test]
fn evaluates_top_level_constants_with_comptime_functions() -> unit {
    let file = checked_file(
        "#[comptime] fn square(value: int) -> int { value * value } const answer: int = square(12); fn main() -> int { answer }",
    );
    testing::assert_eq(file.constants.len(), 1);
    match file.constants[0].value {
        ConstExpr::Prim { value: Primitive::Int { value }, ty: _ } => {
            testing::assert_eq(value, "144")
        },
        _ => testing::fail("expected a finalized comptime constant"),
    }
}

#[test]
fn rejects_runtime_capture_and_runtime_only_calls_in_comptime() -> unit {
    let capture = checked_diagnostics("fn main(value: int) -> int { comptime { value + 1 } }");
    testing::assert(
        has_diagnostic(capture, "comptime expression cannot capture runtime local `value/0`"),
    );
    let runtime_call = checked_diagnostics(
        "fn runtime_value() -> int { 1 } fn main() -> int { comptime { runtime_value() } }",
    );
    testing::assert(
        has_diagnostic(
            runtime_call,
            "comptime function calls runtime-only function `runtime_value`",
        ),
    );
    let source = "fn runtime_value() -> int { 1 } #[comptime] fn checked() -> int { runtime_value() } fn main() -> unit {}";
    let diagnostics = checked_diagnostics(source);
    let expected_call = match text::rfind(source, "runtime_value") {
        Some(value) => value,
        None => {
            testing::fail("expected runtime-only call");
            0
        },
    };
    let expected_attribute = match text::find(source, "#[comptime]") {
        Some(value) => value,
        None => {
            testing::fail("expected comptime attribute");
            0
        },
    };
    let found = Ref::new(false);
    for diagnostic in diagnostics {
        if diagnostic.message.contains("runtime-only function `runtime_value`") {
            match diagnostic.span {
                Some(span) => testing::assert_eq(span.start, expected_call),
                None => testing::fail("expected runtime-only call span"),
            };
            testing::assert_eq(diagnostic.secondary_labels.len(), 1);
            testing::assert_eq(diagnostic.secondary_labels[0].span.start, expected_attribute);
            found.set(true)
        } else {}
    }
    testing::assert(found.get())
}

#[test]
fn reports_compile_error_from_comptime() -> unit {
    let source = "#[comptime] fn checked(value: int) -> int { if value < 0 { compile_error(\"value must be non-negative\") } else { value } } fn main() -> int { comptime { checked(-1) } }";
    let diagnostics = checked_diagnostics(source);
    testing::assert(has_diagnostic_containing(diagnostics, "value must be non-negative"));
    testing::assert(has_diagnostic_containing(diagnostics, "comptime call stack:"));
    testing::assert(has_diagnostic_containing(diagnostics, "at checked"));
    let expected_start = match text::find(source, "compile_error") {
        Some(value) => value,
        None => {
            testing::fail("expected compile_error source");
            0
        },
    };
    let found = Ref::new(false);
    for diagnostic in diagnostics {
        if diagnostic.message.contains("value must be non-negative") {
            match diagnostic.span {
                Some(span) => {
                    testing::assert_eq(span.start, expected_start)
                },
                None => testing::fail("expected precise comptime failure span"),
            };
            testing::assert_eq(diagnostic.secondary_labels.len(), 1);
            found.set(true)
        } else {}
    }
    testing::assert(found.get())
}

#[test]
fn validates_comptime_attributes_and_function_capabilities() -> unit {
    let invalid = checked_diagnostics(
        "#[comptime(1)] #[comptime] #[comptime] fn generic[T](value: T) -> T { value } #[comptime] struct Value {} fn main() -> unit {}",
    );
    testing::assert(has_diagnostic(invalid, "#[comptime] does not accept arguments"));
    testing::assert(has_diagnostic(invalid, "duplicate #[comptime] attribute"));
    testing::assert(
        has_diagnostic(
            invalid,
            "#[comptime] functions cannot declare generic parameters or predicates",
        ),
    );
    testing::assert(
        has_diagnostic(invalid, "#[comptime] is only valid on free function declarations"),
    );
    let closure = checked_diagnostics(
        "#[comptime] fn invalid() -> int { let value = || 1; value() } fn main() -> unit {}",
    );
    testing::assert(has_diagnostic_containing(closure, "closures are not available in comptime"));
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn main() -> unit { compile_error(\"runtime\"); }"),
            "compile_error is only available in comptime",
        ),
    )
}

#[test]
fn checks_let_else_and_value_break_restrictions() -> unit {
    let source = "enum Choice { Value(int), Empty } fn non_exit(value: Choice) -> int { let Value(item) = value else { 0 }; item } fn while_value() { while true { break 1; }; } fn irrefutable() { let item = 1 else { return; }; }";
    let diagnostics = checked_diagnostics(source);
    testing::assert(
        has_diagnostic(diagnostics, "`let else` branch must exit the surrounding control flow"),
    );
    testing::assert(has_diagnostic(diagnostics, "`break` with a value is only allowed in `loop`"));
    testing::assert(has_diagnostic(diagnostics, "`let else` requires a refutable pattern"))
}

#[test]
fn checks_value_break_types_across_loop_paths() -> unit {
    let source = "fn choose(flag: bool) -> int { loop { if flag { break 1; } else { break \"wrong\"; }; } }";
    testing::assert(
        has_diagnostic(checked_diagnostics(source), "Type mismatch: expected string, found int"),
    )
}

#[test]
fn checks_block_and_byte_string_types() -> unit {
    let valid = checked_diagnostics(
        "fn answer() -> int { { let base = 40; base + 2 } } fn main() -> unit { let empty = b\"\"; let bytes: Vec[byte] = br#\"raw\"#; let _ = empty.len() + bytes.len(); }",
    );
    testing::assert_eq(valid.len(), 0);
    let invalid = checked_diagnostics("fn wrong() -> Vec[int] { b\"value\" }");
    testing::assert(invalid.len() > 0)
}

fn dependency_hir(source: string, package_name: string) -> hir::File {
    let result = hir::lower_package(ast::lower(parser::parse(source)), "package.gom", package_name);
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Some(file) => file,
        None => {
            testing::fail("expected dependency HIR");
            hir::File {
                package_name: "",
                path: "",
                source_path: "",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

fn checked_file_with_dependencies(source: string, dependencies: Vec[hir::File]) -> File {
    let result = check_for_link_with_dependencies(
        hir::lower(ast::lower(parser::parse(source)), "main.gom"),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => file,
        None => {
            testing::fail("expected TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
            }
        },
    }
}

fn checked_package_file_with_dependencies(source: string, dependencies: Vec[hir::File]) -> File {
    let result = check_for_link_with_dependencies(
        hir::lower_package(ast::lower(parser::parse(source)), "main.gom", "main"),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => file,
        None => {
            testing::fail("expected package TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
            }
        },
    }
}

#[test]
fn records_typecheck_query_facts() -> unit {
    let result = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn identity(value: int32) -> int32 { value } fn main() -> int32 { let answer = identity(42); answer }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert(result.typeck_results.exprs.len() > 0);
    testing::assert(result.typeck_results.pats.len() > 0);
    testing::assert(result.typeck_results.locals.len() > 0);
    testing::assert_eq(result.typeck_results.calls.len(), 1);
    match resolve_type(result.typeck_results.calls.get(0).callee_ty) {
        Func { params, ret_ty } => {
            testing::assert_eq(params.len(), 1);
            match resolve_type(params.get(0)) {
                Int32 => (),
                _ => testing::fail("expected call parameter type"),
            };
            match resolve_type(ret_ty) {
                Int32 => (),
                _ => testing::fail("expected call return type"),
            }
        },
        _ => testing::fail("expected callable type"),
    };
    let local_reference = Ref::new(false);
    let callable_reference = Ref::new(false);
    for reference in result.typeck_results.references {
        testing::assert_eq(reference.source_path, "main.gom");
        match reference.target {
            Local(_) => {
                local_reference.set(true);
                match resolve_type(reference.ty) {
                    Int32 => (),
                    _ => testing::fail("expected local reference type"),
                }
            },
            Definition(_) | Callable(_) => {
                callable_reference.set(true)
            },
            Constructor(_) => (),
            Unresolved(_) => (),
        }
    }
    testing::assert(local_reference.get());
    testing::assert(callable_reference.get())
}

#[test]
fn merges_typecheck_query_facts_for_package_files() -> unit {
    let parsed = Vec::new();
    parsed.push(parser::parse("package values; fn value() -> int32 { 42 }"));
    parsed.push(parser::parse("package values; fn answer() -> int32 { value() }"));
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "value.gom"));
    inputs.push((ast_files.get(1), "answer.gom"));
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected package HIR"),
        }
    }
    let result = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert_eq(result.diagnostics.len(), 0);
    let value_facts = Ref::new(0);
    let answer_facts = Ref::new(0);
    for fact in result.typeck_results.exprs {
        if fact.source_path == "value.gom" {
            value_facts.set(value_facts.get() + 1)
        } else if fact.source_path == "answer.gom" {
            answer_facts.set(answer_facts.get() + 1)
        } else {}
    }
    testing::assert(value_facts.get() > 0);
    testing::assert(answer_facts.get() > 0)
}

#[test]
fn checks_cross_file_package_definitions() -> unit {
    let parsed = Vec::new();
    parsed.push(
        parser::parse(
            "package main; trait Label { fn label(self: Self) -> string; } enum Status { Idle, Busy(int32) } impl Label for Status { fn label(self: Status) -> string { match self { Idle => \"idle\", Busy(value) => value.to_string() } } }",
        ),
    );
    parsed.push(
        parser::parse(
            "package main; fn main() -> unit { println(Idle.label()); println(Busy(4).label()) }",
        ),
    );
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "types.gom"));
    inputs.push((ast_files.get(1), "main.gom"));
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "main") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected cross-file HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert_eq(checked.diagnostics.len(), 0);
    match checked.tast {
        Some(file) => {
            testing::assert_eq(file.enums.len(), 1);
            testing::assert_eq(file.items.len(), 2)
        },
        None => testing::fail("expected cross-file TAST"),
    }
}

#[test]
fn diagnoses_duplicate_functions_across_package_files() -> unit {
    let parsed = Vec::new();
    parsed.push(parser::parse("package values; fn duplicate() -> unit { () }"));
    parsed.push(parser::parse("package values; fn duplicate() -> unit { () }"));
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "first.gom"));
    inputs.push((ast_files.get(1), "second.gom"));
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected duplicate function HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert(
        has_diagnostic(
            checked.diagnostics,
            "function example::values::duplicate is defined multiple times",
        ),
    )
}

#[test]
fn diagnoses_duplicate_declaration_names() -> unit {
    let diagnostics = checked_diagnostics(
        "enum E { A, A } struct S { x: int32, x: string } enum Both { A } struct Both { value: int32 } type Alias = int32; type Alias = string; struct Mixed {} type Mixed = int32; trait T[T, T] { type Item; type Item; fn f(self: Self) -> unit; fn f(self: Self) -> unit; } fn duplicate[T, T](x: int32, x: string) -> unit {} fn duplicate() -> unit {} const repeated: int = 1; const repeated: int = 2; fn conflict() -> int { 1 } const conflict: int = 1;",
    );
    let expected = Vec::new();
    expected.push("variant A is defined multiple times in enum E");
    expected.push("field x is defined multiple times in struct S");
    expected.push("type Both is defined as both a struct and an enum");
    expected.push("type alias Alias is defined multiple times");
    expected.push("type Mixed is defined as both a struct and a type alias");
    expected.push("type parameter T is defined multiple times");
    expected.push("associated type Item is defined multiple times in trait T");
    expected.push("method f is defined multiple times in trait T");
    expected.push("parameter x is defined multiple times");
    expected.push("function duplicate is defined multiple times");
    expected.push("constant repeated is defined multiple times");
    expected.push("value conflict is defined as both a function and a constant");
    for message in expected {
        testing::assert(has_diagnostic(diagnostics, message))
    }
}

#[test]
fn resolves_generic_functions_from_package_interfaces() -> unit {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir(
            "package api; pub fn identity[T: ToString](value: T) -> T { value }",
            "vendor::api",
        ),
    );
    let file = checked_file_with_dependencies(
        "use vendor::api as service; fn main() -> string { service::identity(\"ok\") }",
        dependencies,
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Function(name), ty: Func { params, ret_ty } },
                args: _,
                ty: String,
            }) => {
                testing::assert_eq(name, "vendor::api::identity");
                match resolve_type(params.get(0)) {
                    String => (),
                    _ => testing::fail("expected string package parameter"),
                };
                match resolve_type(ret_ty) {
                    String => (),
                    _ => testing::fail("expected string package return"),
                }
            },
            _ => testing::fail("expected package function call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn enforces_source_extern_capabilities() -> unit {
    let source = "#[runtime(\"std.io.println\")] extern fn output(value: string) -> unit; fn main() -> unit { output(\"ok\") }";
    let rejected = checked_diagnostics(source);
    testing::assert_eq(rejected.len(), 2);
    testing::assert_eq(
        rejected.get(0).message,
        "Internal error: Function output not found in environment",
    );
    testing::assert_eq(rejected.get(1).message, "extern output is not permitted in this source");
    let allowed = check_for_link_with_dependencies_allowing_externs(
        hir::lower(ast::lower(parser::parse(source)), "host.gom"),
        Vec::new(),
    );
    testing::assert_eq(allowed.diagnostics.len(), 0);
    match allowed.tast {
        Some(file) => match file.items.get(0) {
            Function(value) => match value.body.tail {
                Some(Call { func: Callable { callable: Runtime(name), ty: _ }, args: _, ty: Unit }) => testing::assert_eq(
                    name,
                    "std.io.println",
                ),
                _ => testing::fail("expected allowed runtime call"),
            },
            _ => testing::fail("expected main function"),
        },
        None => testing::fail("expected allowed extern TAST"),
    }
}

#[test]
fn classifies_extern_attributes_by_name_instead_of_payload_text() -> unit {
    let source = "#[intrinsic(\"ref.get\")] extern fn probe() -> unit; fn main() -> unit { probe() }";
    let allowed = check_for_link_with_dependencies_allowing_externs(
        hir::lower(ast::lower(parser::parse(source)), "host.gom"),
        Vec::new(),
    );
    testing::assert_eq(allowed.diagnostics.len(), 0);
    match allowed.tast {
        Some(file) => match file.items.get(0) {
            Function(value) => match value.body.tail {
                Some(Call { func: Callable { callable: Intrinsic(name), ty: _ }, args: _, ty: Unit }) => testing::assert_eq(
                    name,
                    "ref.get",
                ),
                _ => testing::fail("expected intrinsic call"),
            },
            _ => testing::fail("expected main function"),
        },
        None => testing::fail("expected allowed extern TAST"),
    }
}

#[test]
fn permits_typed_go_ffi_externs_in_user_sources() -> unit {
    let source = "type Text = string; #[go_ffi(\"strings\", \"ToUpper\")] extern fn to_upper(value: Text) -> Text; fn main() -> Text { to_upper(\"goml\") }";
    let file = checked_file(source);
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: GoForeign { import_path, symbol }, ty: _ },
                args: _,
                ty: String,
            },) => {
                testing::assert_eq(import_path, "strings");
                testing::assert_eq(symbol, "ToUpper")
            },
            _ => testing::fail("expected Go FFI call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn diagnoses_invalid_go_ffi_declarations() -> unit {
    testing::assert(
        has_diagnostic(
            checked_diagnostics("#[go_ffi(\"strings\")] extern fn probe() -> unit;"),
            "go_ffi attribute expects import path and symbol string arguments",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[go_ffi(\"strings\", \"toUpper\")] extern fn probe(value: string) -> string;",
            ),
            "go_ffi symbol must be an exported ASCII Go identifier",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[go_ffi(\"example.com/ffi\", \"Use\")] extern fn probe(values: Vec[int32]) -> unit;",
            ),
            "Go FFI parameter values has unsupported type Vec[int32]",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[go_ffi(\"example.com/ffi\", \"Use\")] extern fn probe[T](value: T) -> unit;",
            ),
            "Go FFI functions cannot declare generic parameters or predicates",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[runtime(\"std.io.println\")] #[go_ffi(\"fmt\", \"Println\")] extern fn probe(value: string) -> unit;",
            ),
            "Extern declarations require exactly one ABI attribute",
        ),
    )
}

#[test]
fn permits_runtime_externs_in_builtin_sources() -> unit {
    let lowered = hir::lower(
        ast::lower(
            parser::parse(
                "#[runtime(\"core.string_get\")] extern fn string_get_raw(value: string, index: int) -> char; fn load(value: string, index: int) -> char { string_get_raw(value, index) }",
            ),
        ),
        "builtin_prelude.gom",
    );
    let files: Vec[hir::File] = Vec::[];
    match lowered.hir {
        Some(file) => files.push(file),
        None => testing::fail("expected builtin HIR"),
    };
    let checked = check_builtin_package_files(files);
    testing::assert_eq(checked.diagnostics.len(), 0)
}

#[test]
fn diagnoses_unknown_extern_callable_keys() -> unit {
    let runtime = check_for_link_with_dependencies_allowing_externs(
        hir::lower(
            ast::lower(parser::parse("#[runtime(\"vendor.unknown\")] extern fn probe() -> unit;")),
            "host.gom",
        ),
        Vec::new(),
    );
    testing::assert(has_diagnostic(runtime.diagnostics, "Unknown runtime hook vendor.unknown"));
    let intrinsic = check_for_link_with_dependencies_allowing_externs(
        hir::lower(
            ast::lower(parser::parse("#[intrinsic(\"vendor.unknown\")] extern fn probe() -> unit;")),
            "host.gom",
        ),
        Vec::new(),
    );
    testing::assert(has_diagnostic(intrinsic.diagnostics, "Unknown intrinsic vendor.unknown"))
}

#[test]
fn recovers_rejected_externs_with_builtin_signatures() -> unit {
    let diagnostics = checked_diagnostics(
        "#[intrinsic(\"ref.get\")] extern fn ref_get[T](reference: Ref[T]) -> T; fn main() -> unit { println(ref_get(1)) }",
    );
    testing::assert_eq(diagnostics.len(), 3);
    testing::assert(has_diagnostic(diagnostics, "extern ref_get is not permitted in this source"));
    testing::assert(
        has_diagnostic(diagnostics, "Could not infer the type required to prove ToString<unknown>"),
    );
    testing::assert(has_diagnostic(diagnostics, "Numeric literal cannot be used as Ref[unknown]"))
}

#[test]
fn resolves_runtime_externs_from_package_interfaces() -> unit {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir(
            "package host; #[runtime(\"std.io.println\")] pub extern fn output(value: string) -> unit;",
            "std::internal::host",
        ),
    );
    let file = checked_file_with_dependencies(
        "use std::internal::host; fn main() -> unit { host::output(\"ok\") }",
        dependencies,
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Call { func: Callable { callable: Runtime(name), ty: _ }, args: _, ty: Unit }) => testing::assert_eq(
                name,
                "std.io.println",
            ),
            _ => testing::fail("expected runtime package call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn resolves_enum_patterns_from_package_interfaces() -> unit {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir("package api; pub enum Choice { Empty, Value(int32) }", "vendor::api"),
    );
    let file = checked_file_with_dependencies(
        "use vendor::api; fn unwrap(value: api::Choice) -> int32 { match value { api::Choice::Empty => 0, api::Choice::Value(inner) => inner } }",
        dependencies,
    );
    match file.items.get(0) {
        Function(function) => match function.body.tail {
            Some(Match { expr: _, arms, ty: Int32 }) => {
                testing::assert_eq(arms.len(), 2)
            },
            _ => testing::fail("expected external enum match"),
        },
        _ => testing::fail("expected external enum function"),
    }
}

#[test]
fn prefers_exact_struct_names_over_dependency_short_names() -> unit {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir("package api; pub struct Context { foreign: string }", "vendor::api"),
    );
    let file = checked_package_file_with_dependencies(
        "struct Context { local: int32 } fn read(value: Context) -> int32 { value.local }",
        dependencies,
    );
    match file.items.get(0) {
        Function(function) => match function.body.tail {
            Some(Field { expr: _, field_name: "local", ty: Int32 }) => (),
            _ => testing::fail("expected local struct field"),
        },
        _ => testing::fail("expected local struct function"),
    }
}

#[test]
fn resolves_deferred_field_constraints() -> unit {
    let source = "struct Named { name: string } fn read(value: Named) -> string { let values = Vec::new(); let selected = values.get(0).name; values.push(value); selected }";
    let file = checked_file(source);
    match file.items.get(0) {
        Function(function) => match function.body.tail {
            Some(value) => match resolve_type(expr_type(value)) {
                String => (),
                _ => testing::fail("expected resolved field type"),
            },
            None => testing::fail("expected function result"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn diagnoses_invalid_deferred_field_constraints() -> unit {
    let source = "struct Named { name: string } fn read(value: Named) -> unit { let values = Vec::new(); let _ = values.get(0).missing; values.push(value) }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(result.diagnostics.get(0).message, "field not found: missing")
}

#[test]
fn rejects_mismatched_let_annotations() -> unit {
    let result = check(
        hir::lower(
            ast::lower(
                parser::parse("fn main() -> unit { let value: int32 = \"wrong\"; let _ = value; }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(
        result.diagnostics.get(0).message,
        "Type mismatch: expected string, found int32",
    )
}

#[test]
fn reports_call_return_mismatches_once_per_constraint_phase() -> unit {
    let local = checked_diagnostics("fn value() -> int32 { 1 } fn main() -> string { value() }");
    testing::assert_eq(local.len(), 2);
    for diagnostic in local {
        testing::assert_eq(diagnostic.message, "Type mismatch: expected int32, found string")
    }
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(dependency_hir("package api; pub fn value() -> int32 { 1 }", "vendor::api"));
    let external = check_for_link_with_dependencies(
        hir::lower(
            ast::lower(parser::parse("use vendor::api; fn main() -> string { api::value() }")),
            "main.gom",
        ),
        dependencies,
    );
    testing::assert_eq(external.diagnostics.len(), 2);
    for diagnostic in external.diagnostics {
        testing::assert_eq(diagnostic.message, "Type mismatch: expected int32, found string")
    }
}

#[test]
fn infers_numeric_generic_arguments_from_expected_types() -> unit {
    let source = "fn main() -> unit { let r: Ref[uint8] = Ref::new(10); }";
    let diagnostics = checked_diagnostics(source);
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn rejects_float_remainder_operands() -> unit {
    let result = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> unit { let _ = 5.0 % 2.0; }")),
            "main.gom",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(
        result.diagnostics.get(0).message,
        "Operator % is not defined for type float64",
    )
}

#[test]
fn rejects_missing_dyn_impls_and_noncomparable_equality() -> unit {
    let dyn_result = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "trait Display { fn display(self: Self) -> string; } fn convert(value: int32) -> dyn Display { value }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(dyn_result.diagnostics.len(), 1);
    testing::assert_eq(
        dyn_result.diagnostics.get(0).message,
        "Type int32 does not implement trait Display",
    );
    let equality_result = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn main() -> unit { let left: (int32) -> int32 = |value| value; let right: (int32) -> int32 = |value| value; let _ = left == right; }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(equality_result.diagnostics.len(), 1);
    testing::assert_eq(
        equality_result.diagnostics.get(0).message,
        "No instance found for trait PartialEq<(int32) -> int32>",
    )
}

#[test]
fn rejects_non_function_go_operands() -> unit {
    let result = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> unit { while true { go break; } }")),
            "main.gom",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert(
        result.diagnostics.get(0).message.starts_with("unstructured_go: `go` starts detached work"),
    );
    match result.diagnostics.get(0).severity {
        Warning => (),
        Error => testing::fail("expected unstructured go warning"),
    };
    testing::assert_eq(
        result.diagnostics.get(1).message,
        "`go` expects a value of type () -> unit, found never",
    );
    match result.diagnostics.get(1).severity {
        Error => (),
        Warning => testing::fail("expected go operand error"),
    }
}

#[test]
fn rejects_invalid_signature_names_and_integer_literals() -> unit {
    let unknown_trait = check(
        hir::lower(
            ast::lower(parser::parse("fn use_value[T: Missing](value: T) -> unit { () }")),
            "main.gom",
        ),
    );
    testing::assert_eq(unknown_trait.diagnostics.len(), 1);
    testing::assert_eq(unknown_trait.diagnostics.get(0).message, "Unknown trait Missing");
    let bad_application = check(
        hir::lower(
            ast::lower(parser::parse("fn use_value[T](value: T[int32]) -> unit { () }")),
            "main.gom",
        ),
    );
    testing::assert(bad_application.diagnostics.len() > 0);
    testing::assert_eq(
        bad_application.diagnostics.get(0).message,
        "Expected a type constructor, got T",
    );
    let overflow = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> unit { let value: int8 = 999; }")),
            "main.gom",
        ),
    );
    testing::assert_eq(overflow.diagnostics.len(), 1);
    testing::assert_eq(
        overflow.diagnostics.get(0).message,
        "Integer literal 999 does not fit in int8",
    );
    let negative_unsigned = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> unit { let value: uint8 = -1; }")),
            "main.gom",
        ),
    );
    testing::assert_eq(negative_unsigned.diagnostics.len(), 1);
    testing::assert_eq(
        negative_unsigned.diagnostics.get(0).message,
        "Integer literal -1 does not fit in uint8",
    );
    let uint_overflow = check(
        hir::lower(
            ast::lower(
                parser::parse("fn main() -> unit { let value: uint = 18446744073709551616; }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(uint_overflow.diagnostics.len(), 1);
    testing::assert_eq(
        uint_overflow.diagnostics.get(0).message,
        "Integer literal 18446744073709551616 does not fit in uint",
    )
}

#[test]
fn rejects_generic_and_parameterized_main_functions() -> unit {
    let result = check(
        hir::lower(ast::lower(parser::parse("fn main[T](value: T) -> unit { () }")), "main.gom"),
    );
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert(has_diagnostic(result.diagnostics, "main function must not have parameters"));
    testing::assert(
        has_diagnostic(result.diagnostics, "main function must not have type parameters"),
    )
}

#[test]
fn rejects_self_types_outside_impl_methods() -> unit {
    let diagnostics = checked_diagnostics(
        "struct Direct { value: Self } struct Nested { value: Vec[Self] } struct Repeated { value: (Self, Self) } fn takes(value: Self) -> Self { value } fn main() -> unit {}",
    );
    testing::assert_eq(diagnostics.len(), 6);
    for diagnostic in diagnostics {
        testing::assert_eq(diagnostic.message, "Self type is only valid in impl methods");
        testing::assert(
            match diagnostic.span {
                Some(_) => true,
                None => false,
            },
        )
    }
}

#[test]
fn checks_match_exhaustiveness_and_irrefutable_bindings() -> unit {
    let exhaustive = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: bool) -> int32 { match value { true => 1, false => 0 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(exhaustive.diagnostics.len(), 0);
    let tuple_gap = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: (bool, bool)) -> int32 { match value { (true, true) => 1, (true, false) => 2, (false, true) => 3 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(tuple_gap.diagnostics.len(), 1);
    testing::assert_eq(
        tuple_gap.diagnostics.get(0).message,
        "non-exhaustive match: missing pattern (false, false)",
    );
    let refutable = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "enum Choice { None, Some(int32) } fn make() -> Choice { Choice::None } fn main() -> unit { let Choice::Some(value) = make(); }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(refutable.diagnostics.len(), 1);
    testing::assert_eq(
        refutable.diagnostics.get(0).message,
        "Refutable pattern is not allowed in let binding; use match instead",
    )
}

#[test]
fn checks_sequence_range_and_uninhabited_exhaustiveness() -> unit {
    testing::assert_eq(
        coverage_decrement_magnitude("100000000000000000000"),
        "99999999999999999999",
    );
    let sequence_gap = check(
        hir::lower(
            ast::lower(
                parser::parse("fn choose(values: Vec[bool]) -> int32 { match values { [] => 0 } }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(sequence_gap.diagnostics.len(), 1);
    testing::assert_eq(
        sequence_gap.diagnostics.get(0).message,
        "non-exhaustive match: missing pattern _",
    );
    let sequence_complete = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(values: Vec[bool]) -> int32 { match values { [] => 0, [true, ..] => 1, [false, ..] => 2 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(sequence_complete.diagnostics.len(), 0);
    let range_complete = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: uint8) -> int32 { match value { 0..=127 => 0, 128..=255 => 1 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(range_complete.diagnostics.len(), 0);
    let range_gap = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: uint8) -> int32 { match value { 0..=126 => 0, 128..=255 => 1 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(range_gap.diagnostics.len(), 1);
    testing::assert_eq(
        range_gap.diagnostics.get(0).message,
        "non-exhaustive match: missing pattern 127",
    );
    let uninhabited = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "enum Never {} enum MaybeNever { Empty, Filled(Never) } fn absurd(value: Never) -> int32 { match value {} } fn maybe(value: MaybeNever) -> int32 { match value { MaybeNever::Empty => 0 } } fn empty_vec(value: Vec[Never]) -> int32 { match value { [] => 0 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(uninhabited.diagnostics.len(), 0)
}

#[test]
fn checks_loop_control_contexts_and_impl_overlap() -> unit {
    let condition = check(
        hir::lower(
            ast::lower(
                parser::parse("fn main() -> unit { while if true { break } else { false } {} }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(condition.diagnostics.len(), 1);
    testing::assert_eq(
        condition.diagnostics.get(0).message,
        "`break` is not allowed in a while condition",
    );
    let nested = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> unit { while true { break; } }")),
            "main.gom",
        ),
    );
    testing::assert_eq(nested.diagnostics.len(), 0);
    let overlap = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "trait Pick { fn pick(self: Self) -> int32; } impl Pick for int32 { fn pick(self: int32) -> int32 { 1 } } impl[T] Pick for T { fn pick(self: T) -> int32 { 2 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert(overlap.diagnostics.len() > 0);
    testing::assert_eq(
        overlap.diagnostics.get(0).message,
        "Trait Pick implementation for T overlaps with implementation main#0",
    )
}

#[test]
fn rejects_impls_overlapping_builtin_ref_blankets() -> unit {
    let diagnostics = checked_diagnostics(
        "impl Eq for Ref[int32] { fn eq(self: Ref[int32], other: Ref[int32]) -> bool { true } } impl Hash for Ref[int32] { fn hash(self: Ref[int32]) -> uint64 { 0 } }",
    );
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert_eq(
        diagnostics.get(0).message,
        "Trait Eq implementation for Ref[int32] overlaps with builtin implementation",
    );
    testing::assert_eq(
        diagnostics.get(1).message,
        "Trait Hash implementation for Ref[int32] overlaps with builtin implementation",
    );
    for diagnostic in diagnostics {
        testing::assert(
            match diagnostic.span {
                Some(_) => true,
                None => false,
            },
        )
    }
}

#[test]
fn distinguishes_fully_qualified_trait_names() -> unit {
    testing::assert(!names_match("first::Flag", "second::Flag"));
    testing::assert(names_match("Flag", "first::Flag"));
    testing::assert(names_match("second::Flag", "Flag"))
}

#[test]
fn solves_trait_chains_without_an_arbitrary_depth_cutoff() -> unit {
    let ty = Ref::new("int32");
    let value = Ref::new("0");
    for _ in 0..24 {
        ty.set("Wrap[" + ty.get() + "]");
        value.set("Wrap { value: " + value.get() + " }")
    }
    let source = "trait Mark {} struct Wrap[T] { value: T } impl Mark for int32 {} impl[T: Mark] Mark for Wrap[T] {} fn require[T: Mark](value: T) -> unit {} fn main() -> unit { let value: "
        + ty.get()
        + " = "
        + value.get()
        + "; require(value) }";
    let diagnostics = checked_diagnostics(source);
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn rejects_invalid_for_sources_and_patterns() -> unit {
    let non_iterator = checked_diagnostics("fn main() -> unit { for _ in 1 {} }");
    testing::assert(
        has_diagnostic(non_iterator, "for loop expects a type implementing IntoIterator, got int"),
    );
    let refutable = checked_diagnostics("fn main() -> unit { for 1 in range(0, 3) {} }");
    testing::assert(
        has_diagnostic(refutable, "Refutable pattern is not allowed in for loop; use match instead"),
    )
}

#[test]
fn checks_indexed_assignment_roots() -> unit {
    let temporary = checked_diagnostics(
        "fn make() -> [int32; 2] { [1, 2] } fn main() -> unit { make()[0] = 3; }",
    );
    testing::assert(
        has_diagnostic(
            temporary,
            "array indexed assignment requires a writable root such as a mutable local or `ref.get()`",
        ),
    );
    testing::assert(
        match temporary.get(0).span {
            Some(_) => true,
            None => false,
        },
    );
    let readonly = checked_diagnostics(
        "fn main() -> unit { let values = Vec::new().pushed(1); let view = values.slice(0, 1); view[0] = 2; }",
    );
    testing::assert(
        has_diagnostic(readonly, "cannot assign through Slice indexing; Slice is read-only"),
    );
    let writable = checked_diagnostics(
        "fn main() -> unit { let mut values = [1, 2]; values[0] = 3; let cell = Ref::new([1, 2]); cell.get()[0] = 4; }",
    );
    testing::assert_eq(writable.len(), 0)
}

#[test]
fn checks_practical_expression_syntax() -> unit {
    let valid = checked_diagnostics(
        "struct Point { x: int, y: int } fn main() -> unit { let mut point = Point { x: 1, y: 2 }; point.x += 3; let base = Point { x: 4, y: 5 }; let _ = Point { x: 6, ..base }; let values: Vec[int] = Vec::[]; let table: HashMap[string, int] = HashMap::{ \"x\" => 1 }; let _ = f\"{point.x}:{values.len()}:{table.len()}\"; }",
    );
    testing::assert_eq(valid.len(), 0)
}

#[test]
fn rejects_uninferred_collection_literals() -> unit {
    let empty = checked_diagnostics("fn main() -> unit { let values = Vec::[]; let _ = values; }");
    testing::assert(has_diagnostic(empty, "Could not infer type"))
}

#[test]
fn rejects_hashmap_index_compound_assignment() -> unit {
    let hashmap_compound = checked_diagnostics(
        "fn main() -> unit { let values: HashMap[string, int] = HashMap::{ \"x\" => 1 }; values[\"x\"] += 2; }",
    );
    testing::assert(
        has_diagnostic(
            hashmap_compound,
            "compound assignment is not supported for HashMap indexing because reads return Option[V]",
        ),
    )
}

#[test]
fn rejects_non_stringifiable_interpolation() -> unit {
    let interpolation = checked_diagnostics("fn main() -> unit { let _ = f\"{|| ()}\"; }");
    testing::assert(
        has_diagnostic(
            interpolation,
            "interpolated expression of type () -> unit does not implement ToString",
        ),
    )
}

#[test]
fn validates_trait_impl_contracts() -> unit {
    let duplicate = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } impl Display for int32 { fn show(self: int32) -> string { \"a\" } fn show(self: int32) -> string { \"b\" } }",
    );
    testing::assert(
        has_diagnostic(duplicate, "Method show implemented multiple times in impl of trait Display"),
    );
    let extra = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } impl Display for int32 { fn show(self: int32) -> string { \"a\" } fn extra(self: int32) -> string { \"b\" } }",
    );
    testing::assert(has_diagnostic(extra, "Method extra is not declared in trait Display"));
    let missing = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; fn debug(self: Self) -> string; } impl Display for int32 { fn show(self: int32) -> string { \"a\" } }",
    );
    testing::assert(
        has_diagnostic(missing, "Trait Display implementation for int32 is missing method debug"),
    );
    let arity = checked_diagnostics(
        "trait Format { fn format(self: Self, arg1: string) -> string; } impl Format for int32 { fn format(self: int32) -> string { \"a\" } }",
    );
    testing::assert(
        has_diagnostic(arity, "Trait Format::format expects 2 parameters but impl has 1"),
    );
    let parameter = checked_diagnostics(
        "trait Format { fn format(self: Self, arg1: string) -> string; } impl Format for int32 { fn format(self: int32, value: int32) -> string { value.to_string() } }",
    );
    testing::assert(
        has_diagnostic(
            parameter,
            "Trait Format::format parameter 1 expected type string but found int32",
        ),
    );
    let result = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } impl Display for int32 { fn show(self: int32) -> bool { true } }",
    );
    testing::assert(
        has_diagnostic(result, "Trait Display::show expected return type string but found bool"),
    )
}

#[test]
fn validates_declared_types_and_tostring_requirements() -> unit {
    let declarations = checked_diagnostics(
        "enum Maybe[T] { Just(T), Nothing } struct UseMaybe { value: Maybe, missing: Unknown[int32] } struct Generic[T] { field: V }",
    );
    testing::assert(has_diagnostic(declarations, "Type Maybe expects 1 type arguments, but got 0"));
    testing::assert(has_diagnostic(declarations, "Unknown type constructor Unknown"));
    testing::assert(has_diagnostic(declarations, "Unknown type constructor V"));
    let println_error = checked_diagnostics(
        "struct Value {} fn main() -> unit { println(Value {}) }",
    );
    testing::assert(has_diagnostic(println_error, "No instance found for trait ToString<Value>"));
    let method_error = checked_diagnostics(
        "struct Value {} fn main() -> unit { let _ = (Value {}).to_string(); }",
    );
    testing::assert(has_diagnostic(method_error, "Method to_string not found for type Value"))
}

#[test]
fn reports_unimported_package_members_canonically() -> unit {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir("package dep; pub fn value() -> int32 { 1 }", "package_model_test::dep"),
    );
    let result = check_for_link_with_dependencies(
        hir::lower_package(
            ast::lower(parser::parse("package main; fn main() -> unit { let _ = dep::value(); }")),
            "main.gom",
            "package_model_test",
        ),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert_eq(result.diagnostics.get(0).message, "Could not infer type");
    match result.diagnostics.get(0).span {
        None => (),
        Some(_) => testing::fail("expected spanless inference diagnostic"),
    };
    testing::assert_eq(result.diagnostics.get(0).source_path, "");
    testing::assert_eq(
        result.diagnostics.get(1).message,
        "Type or trait package_model_test::dep not found for member access",
    )
}

#[test]
fn reports_missing_constructor_inference_canonically() -> unit {
    let diagnostics = checked_diagnostics(
        "enum Direction { North } fn main() -> unit { let _ = Direction::Up; }",
    );
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert_eq(diagnostics.get(0).message, "Could not infer type");
    testing::assert_eq(diagnostics.get(0).source_path, "");
    testing::assert_eq(
        diagnostics.get(1).message,
        "Constructor Direction::Up not found in environment",
    )
}

