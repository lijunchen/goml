        },
        _ => testing::fail("expected iterate function"),
    }
}

#[test]
fn preserves_associated_into_iterator_item_projection() -> unit {
    let file = checked_file(
        "trait Batch { type Items: IntoIterator; fn items(self: Self) -> Self::Items; } fn iterate[B: Batch](batch: B) -> unit { for _ in Batch::items(batch) {} }",
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(For {
                pat: Wild {
                    ty: Projection {
                        for_ty: Projection {
                            for_ty: Projection {
                                for_ty: Param { name: owner },
                                name: items,
                                trait_ref: _,
                            },
                            name: into_iter,
                            trait_ref: _,
                        },
                        name: item,
                        trait_ref: _,
                    },
                },
                iterator: _,
                into_iter_trait_ref: _,
                iterator_trait_ref: _,
                iterator_ty: _,
                body: _,
                ty: Unit,
            }) => {
                testing::assert_eq(owner, "B");
                testing::assert_eq(items, "Items");
                testing::assert_eq(into_iter, "IntoIter");
                testing::assert_eq(item, "Item")
            },
            _ => testing::fail("expected associated iterator projection"),
        },
        _ => testing::fail("expected iterate function"),
    }
}

#[test]
fn resolves_iterator_item_for_for_loop_method_calls() -> unit {
