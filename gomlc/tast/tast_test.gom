#[test]
fn prefers_builtin_inherent_methods() -> unit {
    let source = "trait Container { fn is_empty(self: Self) -> bool; } impl Container for Vec[int32] { fn is_empty(self: Vec[int32]) -> bool { false } } fn main() -> bool { let values: Vec[int32] = Vec::new(); values.is_empty() }";
    let file = checked_file(source);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: InherentMethod { receiver_ty: owner, method_name: name },
                    ty: _,
                },
                args: _,
                ty: Bool,
            }) => {
                testing::assert_eq(name, "is_empty");
                match resolve_type(owner) {
                    VecType { elem: Int32 } => (),
                    _ => testing::fail("expected Vec[int32] inherent owner"),
                }
            },
            _ => testing::fail("expected builtin inherent method call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn specializes_array_builtin_lengths() -> unit {
    let file = checked_file(
        "fn exercise(values: [int32; 2]) -> int32 { array_set(values, 0, 7); array_get(values, 0) }",
    );
    match file.items.get(0) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Expr {
                    expr: Call {
                        func: Callable { callable: Intrinsic(name), ty: Func { params, ret_ty } },
                        args: _,
                        ty,
                    },
                } => {
                    testing::assert_eq(name, "array.set");
                    match resolve_type(params.get(0)) {
                        Array { len: 2, elem: Int32 } => (),
                        _ => testing::fail("expected specialized array.set length"),
                    };
                    match resolve_type(ret_ty) {
                        Array { len: 2, elem: Int32 } => (),
                        _ => testing::fail("expected specialized array.set return length"),
                    };
                    match resolve_type(ty) {
                        Array { len: 2, elem: Int32 } => (),
                        _ => testing::fail("expected specialized array.set result length"),
                    }
                },
                _ => testing::fail("expected array.set call"),
            };
            match value.body.tail {
                Some(Call {
                    func: Callable { callable: Intrinsic(name), ty: Func { params, ret_ty: Int32 } },
                    args: _,
                    ty: Int32,
                }) => {
                    testing::assert_eq(name, "array.get");
                    match resolve_type(params.get(0)) {
                        Array { len: 2, elem: Int32 } => (),
                        _ => testing::fail("expected specialized array.get length"),
                    }
                },
                _ => testing::fail("expected array.get call"),
            }
        },
        _ => testing::fail("expected array function"),
    }
}

