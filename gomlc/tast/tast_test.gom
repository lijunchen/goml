#[test]
fn validates_explicit_casts() -> unit {
    let valid = checked_diagnostics(
        "fn main() -> unit { let wide = 1 as uint64; let code = 'A' as uint32; }",
    );
    testing::assert_eq(valid.len(), 0);
    let invalid = checked_diagnostics(
        "fn main() -> unit { let a = true as uint8; let b = 1.5 as int32; let c = 'A' as uint16; let value16: uint16 = 65; let d = value16 as char; let value32: uint32 = 65; let e = value32 as char; }",
    );
    testing::assert_eq(invalid.len(), 5);
    testing::assert(has_diagnostic(invalid, "Invalid cast from bool to uint8"));
    testing::assert(has_diagnostic(invalid, "Invalid cast from float64 to int32"));
    testing::assert(has_diagnostic(invalid, "Invalid cast from char to uint16"));
    testing::assert(has_diagnostic(invalid, "Invalid cast from uint16 to char"));
    testing::assert(has_diagnostic(invalid, "Invalid cast from uint32 to char"))
}

#[test]
fn validates_numeric_unary_operators() -> unit {
    let diagnostics = checked_diagnostics("fn main() -> unit { let a = -true; let b = ~false; }");
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert(has_diagnostic(diagnostics, "Operator - is not defined for type bool"));
    testing::assert(has_diagnostic(diagnostics, "Operator ~ is not defined for type bool"))
}

#[test]
fn types_control_flow_member_subexpressions_as_unit() -> unit {
    let source = "fn projected() -> int32 { let _: int32 = (return 1).0; 0 } fn indexed() -> int32 { let _: int32 = (return 1)[0]; 0 } fn field() -> int32 { let _: int32 = (return 1).value; 0 }";
    let file = checked_file(source);
    for index in range(0, 3) {
        match file.items.get(index) {
            Function(value) => match value.body.stmts.get(0) {
                Let { is_mut: _, pat: Wild { ty: pattern_ty }, value: expression } => {
                    match (resolve_type(pattern_ty), resolve_type(expr_type(expression))) {
                        (Int32, Unit) => (),
                        _ => testing::fail("expected unit control flow expression type"),
                    };
                    if index == 1 {
                        match expression {
                            Index {
                                base: _,
                                index: Prim { value: Int { value }, ty: Int },
                                ty: Unit,
                            } => testing::assert_eq(value, "0"),
                            _ => testing::fail("expected preserved index expression"),
                        }
                    } else {}
                },
                _ => testing::fail("expected typed control flow binding"),
            },
            _ => testing::fail("expected control flow function"),
        }
    }
}

#[test]
fn suppresses_unreachable_while_condition_type_errors() -> unit {
    let wrapped_index = checked_diagnostics(
        "fn main() -> unit { while (match 0 { 0 => break, _ => continue, })[0] { break; }; }",
    );
    testing::assert_eq(wrapped_index.len(), 2);
    testing::assert(has_diagnostic(wrapped_index, "`break` is not allowed in a while condition"));
    testing::assert(has_diagnostic(wrapped_index, "`continue` is not allowed in a while condition"));
    let wrapped_call = checked_diagnostics(
        "fn id_int(x: int32) -> int32 { x } fn main() -> unit { while id_int(if true { break } else { continue }) { break; }; }",
    );
    testing::assert_eq(wrapped_call.len(), 2);
    testing::assert(has_diagnostic(wrapped_call, "`break` is not allowed in a while condition"));
    testing::assert(has_diagnostic(wrapped_call, "`continue` is not allowed in a while condition"))
}

