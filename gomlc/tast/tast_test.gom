#[test]
fn resolves_enum_constructors_from_package_interfaces() -> unit {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir("package api; pub enum Choice { None, Some(int32) }", "vendor::api"),
    );
    let file = checked_package_file_with_dependencies(
        "use vendor::api; fn zero() -> api::Choice { api::Choice::None } fn payload() -> api::Choice { api::Choice::Some(7) }",
        dependencies,
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Constr { constructor, args: values, ty: Con { name } }) => {
                testing::assert_eq(constructor.name, "vendor::api::Choice::None");
                testing::assert_eq(values.len(), 0);
                testing::assert_eq(name, "vendor::api::Choice")
            },
            _ => testing::fail("expected external unit constructor"),
        },
        _ => testing::fail("expected zero function"),
    };
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Constr { constructor, args: values, ty: Con { name } }) => {
                testing::assert_eq(constructor.name, "vendor::api::Choice::Some");
                testing::assert_eq(values.len(), 1);
                match resolve_type(expr_type(values.get(0))) {
                    Int32 => (),
                    _ => testing::fail("expected int32 constructor argument"),
                };
                testing::assert_eq(name, "vendor::api::Choice")
            },
            _ => testing::fail("expected external payload constructor"),
        },
        _ => testing::fail("expected payload function"),
    }
}

