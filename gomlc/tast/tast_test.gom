#[test]
fn resolves_reordered_result_try_tags() -> unit {
    let source = "enum Result[T, E] { Err(E), Ok(T), } fn parse(flag: bool) -> Result[int32, string] { if flag { Result::Ok(1) } else { Result::Err(\"bad\") } } fn compute(flag: bool) -> Result[int32, string] { let value = parse(flag)?; Result::Ok(value) }";
    let file = checked_file(source);
    match file.items.get(1) {
        Function(value) => match value.body.stmts.get(0) {
            Let { is_mut: _, pat: _, value: Match { expr: _, arms, ty: _ } } => {
                match arms.get(0).pat {
                    Constr { constructor, args: _, ty: _ } => {
                        match constructor.tag {
                            Some(tag) => testing::assert_eq(tag, 1),
                            None => testing::fail("expected success tag"),
                        }
                    },
                    _ => testing::fail("expected success constructor pattern"),
                };
                match arms.get(1).pat {
                    Constr { constructor, args: _, ty: _ } => {
                        match constructor.tag {
                            Some(tag) => testing::assert_eq(tag, 0),
                            None => testing::fail("expected residual tag"),
                        }
                    },
                    _ => testing::fail("expected residual constructor pattern"),
                };
                match arms.get(1).body {
                    Return { expr: Some(Constr { constructor, args: _, ty: _ }), ty: _ } => {
                        match constructor.tag {
                            Some(tag) => testing::assert_eq(tag, 0),
                            None => testing::fail("expected return tag"),
                        }
                    },
                    _ => testing::fail("expected residual return constructor"),
                }
            },
            _ => testing::fail("expected try match binding"),
        },
        _ => testing::fail("expected compute function"),
    }
}

#[test]
fn checks_closures_with_call_context() -> unit {
    let source = "fn zip_with[A, B, C](a: A, b: B, f: (A, B) -> C) -> C { f(a, b) } fn main() -> string { zip_with(10, \"hello\", |number, text| text + \"=\" + number.to_string()) }";
    let file = checked_file(source);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call { func: _, args, ty: String }) => match args.get(2) {
                Closure { params, body, ty: closure_ty } => {
                    match resolve_type(closure_ty) {
                        Func { params: _, ret_ty: String } => (),
                        _ => testing::fail("expected contextual closure return"),
                    };
                    match (resolve_type(params.get(0).ty), resolve_type(params.get(1).ty)) {
                        (Int, String) => (),
                        _ => testing::fail("expected contextual closure parameters"),
                    };
                    match body {
                        Binary {
                            op: _,
                            lhs: _,
                            rhs: Call {
                                func: Callable {
                                    callable: InherentMethod {
                                        receiver_ty: owner,
                                        method_name: name,
                                    },
                                    ty: _,
                                },
                                args: _,
                                ty: call_ty,
                            },
                            ty: body_ty,
                            resolution: _,
                        } => {
                            testing::assert_eq(name, "to_string");
                            match (
                                resolve_type(owner),
                                resolve_type(call_ty),
                                resolve_type(body_ty),
                            ) {
                                (Int, String, String) => (),
                                _ => testing::fail("expected contextual int method types"),
                            }
                        },
                        _ => testing::fail("expected contextual int method"),
                    }
                },
                _ => testing::fail("expected contextual closure argument"),
            },
            _ => testing::fail("expected zip_with call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn infers_trait_goals_from_function_calls() -> unit {
    let source = "trait Measure { fn measure(self: Self) -> int; } impl Measure for Vec[int] { fn measure(self: Vec[int]) -> int { self.len() } } fn read_measure[T: Measure](value: T) -> int { Measure::measure(value) } fn main() -> int { let values = vec_new(); read_measure(values) }";
    let file = checked_file(source);
    match file.items.get(2) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: pattern_ty },
                    value: expression,
                } => {
                    match (resolve_type(pattern_ty), resolve_type(expr_type(expression))) {
                        (VecType { elem: Int }, VecType { elem: Int }) => (),
                        _ => testing::fail("expected inferred Vec[int] binding"),
                    }
                },
                _ => testing::fail("expected inferred vector binding"),
            };
            match value.body.tail {
                Some(Call {
                    func: Callable { callable: Function(name), ty: Func { params, ret_ty: Int } },
                    args,
                    ty: Int,
                }) => {
                    testing::assert_eq(name, "read_measure");
                    match (resolve_type(params.get(0)), resolve_type(expr_type(args.get(0)))) {
                        (VecType { elem: Int }, VecType { elem: Int }) => (),
                        _ => testing::fail("expected inferred trait goal argument"),
                    }
                },
                _ => testing::fail("expected trait constrained function call"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn checks_positional_struct_constructors() -> unit {
    let source = "struct Point { x: int32, y: int32 } struct Wrapper[T] { value: T } fn point() -> Point { Point(1, 2) } fn wrapper() -> Wrapper[string] { Wrapper(\"ok\") }";
    let file = checked_file(source);
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Constr { constructor, args: values, ty: Con { name: owner } }) => {
                testing::assert_eq(owner, "Point");
                testing::assert_eq(constructor.name, "Point");
                testing::assert_eq(constructor.fields.get(0), "x");
                testing::assert_eq(constructor.fields.get(1), "y");
                match (
                    resolve_type(expr_type(values.get(0))),
                    resolve_type(expr_type(values.get(1))),
                ) {
                    (Int32, Int32) => (),
                    _ => testing::fail("expected int32 positional fields"),
                }
            },
            _ => testing::fail("expected positional Point constructor"),
        },
        _ => testing::fail("expected point function"),
    };
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Constr { constructor, args: values, ty: App { ty: Con { name: owner }, args } }) => {
                testing::assert_eq(owner, "Wrapper");
                testing::assert_eq(constructor.name, "Wrapper");
                match (resolve_type(args.get(0)), resolve_type(expr_type(values.get(0)))) {
                    (String, String) => (),
                    _ => testing::fail("expected string Wrapper field"),
                }
            },
            _ => testing::fail("expected positional Wrapper constructor"),
        },
        _ => testing::fail("expected wrapper function"),
    }
}

#[test]
fn checks_enum_patterns_and_default_integer_literals() -> unit {
    let source = "enum Choice { None, Some(int32) } fn unwrap(value: Choice) -> int32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1);
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Match { expr: _, arms, ty }) => {
                testing::assert_eq(arms.len(), 2);
                match ty {
                    Int32 => (),
                    _ => testing::fail("expected int32 match result"),
                };
                match arms.get(0).pat {
                    Constr { constructor, args, ty: Con { name } } => {
                        testing::assert_eq(constructor.name, "Choice::Some");
                        testing::assert_eq(args.len(), 1);
                        testing::assert_eq(name, "Choice")
                    },
                    _ => testing::fail("expected constructor pattern"),
                };
                match arms.get(1).body {
                    Prim { value: Int { value }, ty: literal_ty } => {
                        testing::assert_eq(value, "0");
                        match resolve_type(literal_ty) {
                            Int32 => (),
                            _ => testing::fail("expected defaulted int32 literal"),
                        }
                    },
                    _ => testing::fail("expected defaulted int32 literal"),
                }
            },
            _ => testing::fail("expected match tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_contextual_enum_patterns_from_expected_types() -> unit {
    let source = "enum First[T] { Shared(T), Empty, Named { value: T } } enum Second[T] { Shared(T) } type Alias = First[int32]; fn classify(value: Alias) -> int32 { match value { Shared(inner) => inner, Empty => 0, Named { value } => value } } fn nested(value: Option[Result[int32, string]]) -> int32 { match value { Some(Ok(inner)) => inner, Some(Err(_)) => -1, None => 0 } }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    let shared = Ref::new(false);
    let some = Ref::new(false);
    let ok = Ref::new(false);
    for reference in result.typeck_results.references {
        match reference.target {
            Constructor(constructor) => {
                if constructor.name == "First::Shared" {
                    shared.set(true)
                } else if constructor.name == "Option::Some" {
                    some.set(true)
                } else if constructor.name == "Result::Ok" {
                    ok.set(true)
                } else {}
            },
            _ => (),
        }
    }
    testing::assert(shared.get());
    testing::assert(some.get());
    testing::assert(ok.get());
    let missing = checked_diagnostics(
        "enum First { Shared } enum Second { Missing } fn classify(value: First) -> int32 { match value { Missing => 1 } }",
    );
    testing::assert(has_diagnostic(missing, "Enum First has no variant Missing"));
    let non_enum = checked_diagnostics(
        "fn classify(value: int32) -> int32 { match value { Some(inner) => inner } }",
    );
    testing::assert_eq(non_enum.len(), 1);
    testing::assert_eq(
        non_enum.get(0).message,
        "Contextual variant Some cannot match value of type int32",
    );
    let unknown = checked_diagnostics(
        "fn inspect() -> unit { let matcher = |value| match value { Some(_) => (), _ => () }; let _ = matcher; }",
    );
    testing::assert(has_diagnostic(unknown, "Could not infer enum type for variant Some"))
}

#[test]
fn resolves_associated_types_and_bound_methods() -> unit {
    let source = "trait Provider { type Item; fn get(self: Self) -> Self::Item; } struct Number { value: int32 } impl Provider for Number { type Item = int32; fn get(self: Number) -> int32 { self.value } } fn read[P: Provider](provider: P) -> P::Item { provider.get() } fn main() -> int32 { read(Number { value: 42 }) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 3);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Projection { for_ty: Param { name: owner }, name: associated, trait_ref: _ },
            }) => {
                testing::assert_eq(reference.name, "Provider");
                testing::assert_eq(name, "get");
                testing::assert_eq(owner, "P");
                testing::assert_eq(associated, "Item")
            },
            _ => testing::fail("expected bound trait method call"),
        },
        _ => testing::fail("expected read function"),
    };
    match file.items.get(2) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Function(name), ty: Func { params: _, ret_ty } },
                args: _,
                ty,
            }) => {
                testing::assert_eq(name, "read");
                match (resolve_type(ret_ty), resolve_type(ty)) {
                    (Int32, Int32) => (),
                    _ => testing::fail("expected normalized associated type"),
                }
            },
            _ => testing::fail("expected read call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn preserves_projection_equality_owners() -> unit {
    let source = "trait Source { type Item; fn get(self: Self) -> Self::Item; } struct LeftSource {} struct RightSource {} impl Source for LeftSource { type Item = int32; fn get(self: LeftSource) -> int32 { 1 } } impl Source for RightSource { type Item = int32; fn get(self: RightSource) -> int32 { 2 } } fn combine[A: Source, B: Source](left: A, right: B) -> unit where A::Item = B::Item { () } fn main() -> unit { combine(LeftSource {}, RightSource {}) }";
    let file = checked_file(source);
    match file.items.get(3) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Function(name), ty: Func { params, ret_ty: Unit } },
                args: _,
                ty: Unit,
            }) => {
                testing::assert_eq(name, "combine");
                match (resolve_type(params.get(0)), resolve_type(params.get(1))) {
                    (Con { name: left }, Con { name: right }) => {
                        testing::assert_eq(left, "LeftSource");
                        testing::assert_eq(right, "RightSource")
                    },
                    _ => testing::fail("expected distinct projection equality owners"),
                }
            },
            _ => testing::fail("expected combine call"),
        },
        _ => testing::fail("expected main function"),
    }
}

