#[test]
fn normalizes_and_escapes_char_literals() -> unit {
    match parse_char_literal("\\u0041") {
        Some(value) => testing::assert(value == 'A'),
        None => testing::fail("expected unicode char literal"),
    };
    testing::assert_eq(primitive_text(Primitive::Char { value: 'A' }), "'A'");
    testing::assert_eq(primitive_text(Primitive::Char { value: '\n' }), "'\\n'");
    testing::assert_eq(primitive_text(Primitive::Char { value: '\\' }), "'\\\\'")
}

#[test]
fn resolves_generic_trait_associated_applications() -> unit {
    let source = "trait Convert[T] { type Output; fn convert(self: Self) -> Self::Output; } struct Value {} struct Wrapped[T] { value: T } impl Convert[int32] for Value { type Output = string; fn convert(self: Value) -> string { \"int\" } } impl Convert[string] for Value { type Output = int32; fn convert(self: Value) -> int32 { 7 } } impl[T] Convert[T] for Wrapped[T] { type Output = T; fn convert(self: Wrapped[T]) -> T { self.value } } fn main() -> unit { let text: string = Convert::[int32]::convert(Value {}); let number: int32 = Convert::[string]::convert(Value {}); let generic: string = Convert::[string]::convert(Wrapped { value: \"ok\" }); }";
    let file = checked_file(source);
    match file.items.get(3) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected string associated output"),
            };
            match value.body.stmts.get(1) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: Int32 },
                    value: Call { func: _, args: _, ty: Int32 },
                } => (),
                _ => testing::fail("expected int32 associated output"),
            };
            match value.body.stmts.get(2) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected generic associated output"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn resolves_trait_methods_from_call_context() -> unit {
    let source = "trait Put[T] { fn put(self: Self, arg1: T) -> string; } struct Target {} impl Put[int32] for Target { fn put(self: Target, value: int32) -> string { value.to_string() } } impl Put[string] for Target { fn put(self: Target, value: string) -> string { value } } trait Convert[T] { type Output; fn convert(self: Self) -> Self::Output; } struct Convertible {} impl Convert[int32] for Convertible { type Output = string; fn convert(self: Convertible) -> string { \"text\" } } impl Convert[string] for Convertible { type Output = int32; fn convert(self: Convertible) -> int32 { 7 } } trait Source[T] where Self::Item = T { type Item; fn get(self: Self) -> Self::Item; } struct Number { value: int32 } impl Source[int32] for Number { type Item = int32; fn get(self: Number) -> int32 { self.value } } fn read[T, S: Source[T]](source: S) -> T { Source::[T]::get(source) } trait ItemSource { type Item; fn item(self: Self) -> Self::Item; } trait Select[T] { fn select(self: Self) -> T; } impl[S: ItemSource, T] Select[T] for S where S::Item = T { fn select(self: S) -> T { ItemSource::item(self) } } fn invoke[T, S: Select[T]](source: S) -> T { source.select() } fn main() -> unit { let numeric: string = (Target {}).put(1); let textual: string = (Target {}).put(\"goml\"); let text: string = (Convertible {}).convert(); let number: int32 = (Convertible {}).convert(); let value: int32 = read(Number { value: 8 }); }";
    let file = checked_file(source);
    match file.items.get(7) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Param { name: result },
            }) => {
                testing::assert_eq(reference.name, "Select");
                testing::assert_eq(name, "select");
                match reference.args.get(0) {
                    Param { name: arg } => testing::assert_eq(arg, "T"),
                    _ => testing::fail("expected contextual trait argument"),
                };
                testing::assert_eq(result, "T")
            },
            _ => testing::fail("expected contextual bound method"),
        },
        _ => testing::fail("expected invoke function"),
    };
    match file.items.get(8) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected integer overload"),
            };
            match value.body.stmts.get(1) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected string overload"),
            };
            match value.body.stmts.get(2) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected string return overload"),
            };
            match value.body.stmts.get(3) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: Int32 },
                    value: Call { func: _, args: _, ty: Int32 },
                } => (),
                _ => testing::fail("expected int32 return overload"),
            };
            match value.body.stmts.get(4) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: Int32 },
                    value: Call { func: _, args: _, ty: Int32 },
                } => (),
                _ => testing::fail("expected implied equality result"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

