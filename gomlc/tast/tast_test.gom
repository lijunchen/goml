}

#[test]
fn accepts_builtin_into_iterator_predicates() -> unit {
    let source = "fn sum[S: IntoIterator](source: S) -> int32 where S::Item = int32 { let total = Ref::new(0); for value in source { total.set(total.get() + value); }; total.get() } fn use_values(values: Vec[int32], slice: Slice[int32]) -> unit { let _ = sum(values); let _ = sum(slice); }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => match file.items.get(0) {
            Function(value) => {
                testing::assert_eq(value.predicates.len(), 4);
                match value.predicates.get(0) {
                    Trait { for_ty: Param { name: param }, trait_ref: reference } => {
                        testing::assert_eq(param, "S");
                        testing::assert_eq(reference.name, "IntoIterator")
                    },
                    _ => testing::fail("expected IntoIterator predicate"),
                };
                match value.predicates.get(1) {
                    Equality {
                        lhs: Projection {
                            for_ty: Param { name: param },
                            name,
                            trait_ref: Some(reference),
                        },
                        rhs: Int32,
                    } => {
                        testing::assert_eq(param, "S");
                        testing::assert_eq(name, "Item");
                        testing::assert_eq(reference.name, "IntoIterator")
                    },
                    _ => testing::fail("expected explicit Item equality"),
                };
                match value.predicates.get(2) {
                    Equality {
                        lhs: Projection {
                            for_ty: Param { name: item_param },
                            name: item_name,
                            trait_ref: Some(into_iterator),
                        },
                        rhs: Projection {
                            for_ty: Projection {
                                for_ty: Param { name: iter_param },
                                name: iter_name,
                                trait_ref: Some(iter_owner),
                            },
                            name: iterator_item_name,
                            trait_ref: Some(iterator),
                        },
                    } => {
                        testing::assert_eq(item_param, "S");
                        testing::assert_eq(item_name, "Item");
                        testing::assert_eq(into_iterator.name, "IntoIterator");
                        testing::assert_eq(iter_param, "S");
                        testing::assert_eq(iter_name, "IntoIter");
                        testing::assert_eq(iter_owner.name, "IntoIterator");
                        testing::assert_eq(iterator_item_name, "Item");
                        testing::assert_eq(iterator.name, "Iterator")
                    },
                    _ => testing::fail("expected implied Item equality"),
                };
                match value.predicates.get(3) {
                    Trait {
                        for_ty: Projection {
                            for_ty: Param { name: param },
                            name,
                            trait_ref: Some(owner),
                        },
                        trait_ref: reference,
                    } => {
                        testing::assert_eq(param, "S");
                        testing::assert_eq(name, "IntoIter");
                        testing::assert_eq(owner.name, "IntoIterator");
                        testing::assert_eq(reference.name, "Iterator")
                    },
                    _ => testing::fail("expected IntoIter Iterator predicate"),
                }
            },
            _ => testing::fail("expected sum function"),
        },
        None => testing::fail("expected TAST"),
    }
}

#[test]
fn resolves_projected_trait_impls() -> unit {
    let source = "trait Source { type Item; fn get(self: Self) -> Self::Item; } trait Pick[T] { fn pick(self: Self) -> T; } impl[S: Source] Pick[S::Item] for S { fn pick(self: S) -> S::Item { Source::get(self) } } struct Value { value: int32 } impl Source for Value { type Item = int32; fn get(self: Value) -> int32 { self.value } } fn main() -> int32 { (Value { value: 41 }).pick() }";
    let file = checked_file(source);
    match file.items.get(2) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Int32,
            }) => {
                testing::assert_eq(reference.name, "Pick");
                testing::assert_eq(name, "pick");
                match resolve_type(reference.args.get(0)) {
                    Projection { for_ty: Con { name: owner }, name: item, trait_ref: _ } => {
                        testing::assert_eq(owner, "Value");
                        testing::assert_eq(item, "Item")
                    },
                    _ => testing::fail("expected projected trait argument"),
                }
            },
            _ => testing::fail("expected projected trait method call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn accepts_projected_trait_predicates() -> unit {
    let source = "trait Source { type Item; fn get(self: Self) -> Self::Item; } trait Pick[T] { fn pick(self: Self) -> T; } impl[S: Source] Pick[S::Item] for S { fn pick(self: S) -> S::Item { Source::get(self) } } struct Value { value: int32 } impl Source for Value { type Item = int32; fn get(self: Value) -> int32 { self.value } } fn copy[S: Source + Pick[S::Item]](source: S) -> S::Item { Pick::[S::Item]::pick(source) } fn main() -> int32 { copy(Value { value: 42 }) }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0)
}

#[test]
fn resolves_constrained_blanket_methods() -> unit {
    let source = "trait Mark { fn mark(self: Self) -> string; } trait Label { fn label(self: Self) -> string; } struct Box[T] { value: T } impl Mark for int32 { fn mark(self: int32) -> string { self.to_string() } } impl[T: Mark] Label for Box[T] { fn label(self: Box[T]) -> string { self.value.mark() } } impl Label for Box[string] { fn label(self: Box[string]) -> string { self.value } } fn string_label() -> string { (Box { value: \"text\" }).label() } fn marked_label() -> string { (Box { value: 7 }).label() }";
    let file = checked_file(source);
    for index in range(3, 5) {
        match file.items.get(index) {
            Function(value) => match value.body.tail {
                Some(Call {
                    func: Callable {
                        callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                        ty: Func { params, ret_ty: String },
                    },
                    args: _,
                    ty: String,
                }) => {
                    testing::assert_eq(reference.name, "Label");
                    testing::assert_eq(name, "label");
                    match resolve_type(params.get(0)) {
                        App { ty: Con { name: owner }, args } => {
                            testing::assert_eq(owner, "Box");
                            if index == 3 {
                                match resolve_type(args.get(0)) {
                                    String => (),
                                    _ => testing::fail("expected string impl"),
                                }
                            } else {
                                match resolve_type(args.get(0)) {
                                    Int32 => (),
                                    _ => testing::fail("expected constrained blanket impl"),
                                }
                            }
                        },
                        _ => testing::fail("expected instantiated Box receiver"),
                    }
                },
                _ => testing::fail("expected constrained trait method call"),
            },
            _ => testing::fail("expected label function"),
        }
    }
}

#[test]
fn normalizes_float_pattern_literals() -> unit {
    let file = checked_file(
        "fn signed_zero(value: float64) -> string { match value { -0.0 => \"zero\", _ => \"other\" } }",
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Match { expr: _, arms, ty: String }) => match arms.get(0).pat {
                Prim { value: Float { value: literal }, ty: Float64 } => {
                    testing::assert_eq(literal, "-0")
                },
                _ => testing::fail("expected normalized float pattern"),
            },
            _ => testing::fail("expected float match"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn rounds_float32_literals() -> unit {
    testing::assert_eq(increment_decimal("99999999999999999999"), "100000000000000000000");
    testing::assert_eq(normalized_float32_literal("3.1400001"), "3.14");
    testing::assert_eq(normalized_float32_literal("16777217"), "16777216");
    testing::assert_eq(normalized_float32_literal("1.23456789"), "1.2345679");
    testing::assert_eq(normalized_float32_literal("1e20"), "100000000000000000000");
    testing::assert_eq(normalized_float32_literal("1e-20"), "0.00000000000000000001");
    testing::assert_eq(normalized_float32_literal("-0.0"), "-0");
    let file = checked_file("fn inferred() -> float32 { 3.14 } fn explicit() -> float32 { 3.14 }");
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Prim { value: Float { value: literal }, ty }) => {
                testing::assert_eq(literal, "3.14");
                match resolve_type(ty) {
                    Float32 => (),
                    _ => testing::fail("expected inferred float32 literal type"),
                }
            },
            _ => testing::fail("expected rounded inferred float32 literal"),
        },
        _ => testing::fail("expected inferred function"),
    };
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Prim { value: Float { value: literal }, ty: Float32 }) => {
                testing::assert_eq(literal, "3.14")
            },
            _ => testing::fail("expected rounded explicit float32 literal"),
        },
        _ => testing::fail("expected explicit function"),
    };
    let generic = checked_file(
        "fn identity[T](value: T) -> T { value } fn inferred() -> float32 { identity(3.14) }",
    );
    match generic.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call { func: _, args, ty: Float32 }) => match args.get(0) {
                Prim { value: Float { value: literal }, ty } => {
                    testing::assert_eq(literal, "3.14");
                    match resolve_type(ty) {
                        Float32 => (),
                        _ => testing::fail("expected generic float32 argument type"),
                    }
                },
                _ => testing::fail("expected generic float literal argument"),
            },
            _ => testing::fail("expected generic float call"),
        },
        _ => testing::fail("expected generic inferred function"),
    }
}

#[test]
fn indents_array_control_flow_expressions() -> unit {
    let file = checked_file("fn choose(flag: bool) -> [int32; 1] { [if flag { 1 } else { 2 }] }");
    let expected = "fn choose(flag/0: bool) -> [int32; 1] {\n" + "    [\n"
        + "      if (flag/0 : bool) {\n"
        + "          {\n"
        + "              1\n"
        + "          }\n"
        + "      } else {\n"
        + "          {\n"
        + "              2\n"
        + "          }\n"
        + "      }\n"
        + "    ]\n"
        + "}";
    testing::assert_eq(encode_file(file), expected)
}

#[test]
fn resolves_supertraits_and_implied_predicates() -> unit {
    let source = "trait Parent[T] { fn parent(self: Self) -> T; } trait Render { fn render(self: Self) -> string; } trait Label { fn label(self: Self) -> string; } trait Marker { fn marker(self: Self) -> string; } trait Child[T: Label]: Parent[T] + Render where T: Marker { fn child(self: Self) -> string; } fn describe[T, B: Child[T]](value: B) -> string { value.parent().label() + value.parent().marker() + value.render() + value.child() } fn inherited[T, B: Child[T]](value: B) -> T { Child::[T]::parent(value) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Param { name: result },
            }) => {
                testing::assert_eq(reference.name, "Parent");
                testing::assert_eq(reference.args.len(), 1);
                match reference.args.get(0) {
                    Param { name: arg } => testing::assert_eq(arg, "T"),
                    _ => testing::fail("expected inherited trait argument"),
                };
                testing::assert_eq(name, "parent");
                testing::assert_eq(result, "T")
            },
            _ => testing::fail("expected inherited static trait call"),
        },
        _ => testing::fail("expected inherited function"),
    }
}

#[test]
fn validates_trait_associated_function_self_resolution() -> unit {
    let valid = checked_diagnostics(
        "trait Decode { fn decode(input: string) -> Self; } trait TryDecode { fn try_decode(input: string) -> Result[Self, string]; } trait Default { fn default() -> Self; } struct Value { value: int32 } impl Decode for Value { fn decode(input: string) -> Value { Value { value: 1 } } } impl TryDecode for Value { fn try_decode(input: string) -> Result[Value, string] { Result::Ok(Value { value: 1 }) } } impl Default for Value { fn default() -> Value { Value { value: 0 } } } fn decode[T: Decode](input: string) -> T { Decode::decode(input) } fn try_decode[T: TryDecode](input: string) -> Result[T, string] { let value: T = TryDecode::try_decode(input)?; Result::Ok(value) } fn make[T: Default]() -> T { Default::default() }",
    );
    testing::assert_eq(valid.len(), 0);
    let ambiguous = checked_diagnostics(
        "trait Default { fn default() -> Self; } fn value() -> unit { let result = Default::default(); () }",
    );
    testing::assert(
        has_diagnostic(
            ambiguous,
            "Could not infer the Self type for associated function Default::default",
        ),
    );
    let mismatched = checked_diagnostics(
        "trait Default { fn default() -> Self; } struct Value {} impl Default for Value { fn default(self: Value) -> Value { self } }",
    );
    testing::assert(
        has_diagnostic(mismatched, "Trait Default::default expects 0 parameters but impl has 1"),
    )
}

#[test]
fn rejects_trait_associated_functions_in_dyn_traits() -> unit {
    let diagnostics = checked_diagnostics(
        "trait Factory { fn create(seed: int32) -> Self; } fn use_factory(value: dyn Factory) -> unit {}",
    );
    testing::assert(
        has_diagnostic(
            diagnostics,
            "Trait Factory::create is not dyn-safe: associated functions are not supported",
        ),
    )
}

#[test]
fn rejects_unsafe_dyn_body_annotations() -> unit {
    let diagnostics = checked_diagnostics(
        "trait Cloneish { fn clone(self: Self) -> Self; } struct Value { value: int32 } impl Cloneish for Value { fn clone(self: Value) -> Value { self } } fn main() -> unit { let _value: dyn Cloneish = Value { value: 1 }; }",
    );
    testing::assert(
        has_diagnostic(
            diagnostics,
            "Trait Cloneish::clone is not dyn-safe: Self is not allowed in return type",
        ),
    )
}

#[test]
fn resolves_dyn_dot_methods_and_reports_unavailable_methods() -> unit {
    let _ = checked_file(
        "trait Parent { fn parent(self: Self) -> string; } trait Child: Parent { fn child(self: Self) -> string; } fn render(value: dyn Child) -> string { value.child() + value.parent() }",
    );
    let diagnostics = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } trait Debug { fn debug(self: Self) -> string; } fn render(value: dyn Display) -> string { value.debug() }",
    );
    testing::assert(has_diagnostic(diagnostics, "Method debug not found for type dyn Display"))
}

#[test]
fn rejects_dyn_patterns_and_marks_recovery_arms_unreachable() -> unit {
    let diagnostics = checked_diagnostics(
        "trait Label { fn label(self: Self) -> string; } impl Label for int32 { fn label(self: int32) -> string { self.to_string() } } fn main() -> unit { let concrete: int32 = 1; let value: dyn Label = concrete; let _ = match value { 1 => 2, _ => 3 }; }",
    );
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert_eq(diagnostics.get(0).message, "Pattern matching on dyn Label is not supported");
    match diagnostics.get(0).severity {
        Error => (),
        Warning => testing::fail("expected dyn pattern error"),
    };
    testing::assert_eq(diagnostics.get(1).message, "Unreachable match arm");
    match diagnostics.get(1).severity {
        Warning => (),
        Error => testing::fail("expected unreachable arm warning"),
    }
}

#[test]
fn warns_for_unstructured_go_and_honors_allow_attribute() -> unit {
    let diagnostics = checked_diagnostics("fn main() -> unit { go || {}; }");
    testing::assert_eq(diagnostics.len(), 1);
    testing::assert(
        diagnostics.get(0).message.starts_with("unstructured_go: `go` starts detached work"),
    );
    match diagnostics.get(0).severity {
        Warning => (),
        Error => testing::fail("expected unstructured go warning"),
    };
    let allowed = checked_diagnostics("#[allow(unstructured_go)] fn main() -> unit { go || {}; }");
    testing::assert_eq(allowed.len(), 0)
}

#[test]
fn rejects_recursive_struct_layouts() -> unit {
    let direct = checked_diagnostics("struct Tree { left: Tree } fn main() -> unit {}");
    testing::assert(
        has_diagnostic(
            direct,
            "Struct Tree has infinite size due to recursive field; use Ref[Tree] for indirection",
        ),
    );
    let generic = checked_diagnostics(
        "struct Wrap[T] { value: T } struct Loop { value: Wrap[Loop] } fn main() -> unit {}",
    );
    testing::assert(
        has_diagnostic(
            generic,
            "Struct Loop has infinite size due to recursive field; use Ref[Loop] for indirection",
        ),
    )
}

#[test]
fn propagates_generic_result_constraints_to_literals() -> unit {
    let diagnostics = checked_diagnostics(
        "fn main() -> unit { let value: Ref[uint8] = Ref::new(10); }",
    );
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn prefers_user_nominal_arities() -> unit {
    let diagnostics = checked_diagnostics(
        "enum Result { Ok(string), Err(string) } fn parse(value: bool) -> Result { if value { Result::Ok(\"ok\") } else { Result::Err(\"error\") } }",
    );
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn infers_nested_builtin_method_receivers() -> unit {
    let _ = checked_file(
        "fn main() -> unit { let log = Ref::new(Vec::new()); log.set(log.get().pushed(\"x\")); }",
    );
}

#[test]
fn checks_contextual_numeric_expressions_and_inherent_arguments() -> unit {
    let _ = checked_file(
        "struct Counter { value: uint8 } impl Counter { fn add(self: Counter, value: uint8) -> Counter { Counter { value: self.value + value } } } fn main() -> unit { let negative: int8 = -128; let total: uint8 = 10 + 20; let counter = Counter { value: total }.add(5); println(counter.value.to_string()) }",
    );
}

#[test]
fn qualified_struct_variants_win_over_same_named_structs() -> unit {
    let _ = checked_file(
        "struct Path { segment: string } struct Block { value: int } enum Expr { Path { path: Path, span: int }, Block { block: Block, span: int } } fn span(value: Expr) -> int { match value { Expr::Path { path: _, span } => span, Expr::Block { block: _, span } => span } } fn main() -> unit { let path = Path { segment: \"x\" }; let block = Block { value: 1 }; let _ = span(Expr::Path { path, span: 2 }); let _ = span(Expr::Block { block, span: 3 }); }",
    );
}

#[test]
fn accepts_transparent_aliases_bytes_and_forward_constants() -> unit {
    let source = "type Pair[T] = (T, T); type Marker = byte; type Label = string; struct Entry { marker: Marker, label: Label } enum Event { Mark(Marker), Pair(Pair[int32]) } trait Read { fn read(self: Self) -> Marker; } impl Read for Entry { fn read(self: Entry) -> Marker { self.marker } } const next: int32 = base + 2; const base: int32 = 0x28; const marker: Marker = b'\\xFF'; fn sum(value: Pair[int32]) -> int32 { value.0 + value.1 } fn main() -> unit { let entry = Entry { marker, label: \"ok\" }; let raw: uint8 = entry.read(); let pair: Pair[int32] = (next, 0b10); let _ = Event::Mark(raw); let _ = Event::Pair(pair); let _ = sum(pair) + raw as int32; }";
    let file = checked_file(source);
    testing::assert_eq(file.constants.len(), 3)
}

#[test]
fn diagnoses_type_alias_cycles_and_wrong_arity() -> unit {
    let cycle = checked_diagnostics(
        "type First = Second; type Second = First; fn main() -> unit {}",
    );
    testing::assert(has_diagnostic(cycle, "Cyclic type alias First"));
    let arity = checked_diagnostics(
        "type Pair[T] = (T, T); fn identity(value: Pair) -> Pair { value }",
    );
    testing::assert(has_diagnostic(arity, "Type alias Pair expects 1 type arguments, got 0"))
}

#[test]
fn diagnoses_constant_cycles_and_non_constant_expressions() -> unit {
    let cycle = checked_diagnostics(
        "const first: int = second; const second: int = first; fn main() -> unit {}",
    );
    testing::assert(has_diagnostic(cycle, "Cyclic constant first"));
    testing::assert(has_diagnostic(cycle, "Cyclic constant second"));
    let call = checked_diagnostics(
        "fn value() -> int { 1 } const answer: int = value(); fn main() -> unit {}",
    );
    testing::assert(has_diagnostic(call, "comptime function calls runtime-only function `value`"))
}

#[test]
fn direct_type_writer_matches_compact_document_rendering() -> unit {
    let values = Vec::[
        Type::Unit,
        Type::Never,
        Type::Bool,
        Type::Int,
        Type::Int8,
        Type::Int16,
        Type::Int32,
        Type::Int64,
        Type::Uint,
        Type::Uint8,
        Type::Uint16,
        Type::Uint32,
        Type::Uint64,
        Type::Float32,
        Type::Float64,
        Type::String,
        Type::Char,
        Type::Tuple { items: Vec::[Type::Int, Type::String] },
        Type::Con { name: "sample::Type" },
        Type::Dyn {
            trait_name: "sample::Trait",
            args: Vec::[],
            associated_types: Vec::[],
            additional_bounds: Vec::[],
        },
        Type::Projection {
            for_ty: Type::Con { name: "sample::Type" },
            name: "Item",
            trait_ref: Option::Some(TraitRef { name: "sample::Trait", args: Vec::[Type::Int] }),
        },
        Type::App { ty: Type::Con { name: "Option" }, args: Vec::[] },
        Type::App { ty: Type::Con { name: "Option" }, args: Vec::[Type::String] },
        Type::Array { len: 4, elem: Type::Uint8 },
        Type::Slice { elem: Type::Char },
        Type::VecType { elem: Type::String },
        Type::RefType { elem: Type::Bool },
        Type::HashMap { key: Type::String, value: Type::Int },
        Type::Channel { elem: Type::Uint64 },
        Type::Param { name: "T" },
        Type::Func { params: Vec::[Type::Int, Type::String], ret_ty: Type::Bool },
        Type::Var(Ref::new(TypeVar::Unbound { id: 1, kind: VarKind::Any })),
        Type::Var(Ref::new(TypeVar::Unbound { id: 2, kind: VarKind::Integer })),
        Type::Var(Ref::new(TypeVar::Unbound { id: 3, kind: VarKind::Float })),
        Type::Var(Ref::new(TypeVar::Link(Type::Char))),
        Type::Error,
    ];
    for value in values {
        testing::assert_eq(type_text(value), pretty::compact(type_doc(value)))
    }
}
