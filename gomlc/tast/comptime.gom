package tast;

use gomlc::ast;
use gomlc::ctfe;
use gomlc::ctir;
use gomlc::derive;
use std::text;

pub struct ComptimeFinalizeResult {
    pub file: File,
    pub module: ctir::CtModule,
    pub diagnostics: Vec[Diagnostic],
}

struct CtLowerContext {
    package_name: string,
    file: File,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    constant_names: Vec[string],
    locals: Vec[(string, int)],
    local_types: Vec[ctir::CtType],
    next_slot: Ref[int],
    loop_targets: Vec[int],
    next_loop: Ref[int],
    origin: int,
    source_path: string,
    origin_spans: Vec[ast::Span],
    origin_cursor: Ref[int],
    derive: bool,
}

fn comptime_diagnostic(message: string, source_path: string, start: int, end: int) -> Diagnostic {
    Diagnostic {
        severity: DiagnosticSeverity::Error,
        stage: "comptime",
        message,
        source_path,
        span: Option::Some(ast::span(start, end)),
        primary_label: Option::None,
        secondary_labels: Vec::[],
        sort_order: 0,
    }
}

fn comptime_function_diagnostic(function: Function, origin_cursor: int, message: string) -> Diagnostic {
    if origin_cursor < function.comptime_origins.len() {
        Diagnostic {
            severity: DiagnosticSeverity::Error,
            stage: "comptime",
            message: "function `" + function.name + "` is marked #[comptime] but " + message,
            source_path: function.source_path,
            span: Option::Some(function.comptime_origins[origin_cursor]),
            primary_label: Option::Some("operation is not available in comptime"),
            secondary_labels: Vec::[
                DiagnosticLabel {
                    message: "function is marked #[comptime] here",
                    source_path: function.source_path,
                    span: ast::span(function.start, function.end),
                },
            ],
            sort_order: 0,
        }
    } else {
        comptime_diagnostic(
            "function `" + function.name + "` is marked #[comptime] but " + message,
            function.source_path,
            function.start,
            function.end,
        )
    }
}

fn comptime_error_origin(
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    package_name: string,
    origin: int,
) -> Option[ctir::CtOrigin] {
    if module.package_name == package_name && origin >= 0 && origin < module.origins.len() {
        return Option::Some(module.origins[origin])
    } else {};
    for dependency in dependencies {
        if dependency.package_name == package_name && origin >= 0
            && origin < dependency.origins.len() {
            return Option::Some(dependency.origins[origin])
        } else {}
    }
    Option::None
}

fn comptime_error_text(
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    error: ctfe::CtError,
) -> string {
    if error.stack.is_empty() {
        return error.message
    } else {};
    let builder = text::StringBuilder::new();
    builder.write_string(error.message);
    builder.write_string("\ncomptime call stack:");
    for frame in error.stack {
        builder.write_string("\n  at ");
        builder.write_string(frame.function_name);
        match comptime_error_origin(module, dependencies, frame.package_name, frame.origin) {
            Some(origin) => {
                builder.write_string(" (");
                builder.write_string(origin.source_path);
                builder.write_char(':');
                builder.write_string(origin.start.to_string());
                builder.write_string("..");
                builder.write_string(origin.end.to_string());
                builder.write_char(')')
            },
            None => (),
        }
    }
    builder.finish()
}

fn comptime_evaluation_diagnostic(
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    error: ctfe::CtError,
    site_source_path: string,
    site_start: int,
    site_end: int,
) -> Diagnostic {
    let message = comptime_error_text(module, dependencies, error);
    match comptime_error_origin(module, dependencies, error.package_name, error.origin) {
        Some(origin) => Diagnostic {
            severity: DiagnosticSeverity::Error,
            stage: "comptime",
            message,
            source_path: origin.source_path,
            span: Option::Some(ast::span(origin.start, origin.end)),
            primary_label: Option::Some("comptime evaluation failed here"),
            secondary_labels: Vec::[
                DiagnosticLabel {
                    message: "comptime evaluation requested here",
                    source_path: site_source_path,
                    span: ast::span(site_start, site_end),
                },
            ],
            sort_order: 0,
        },
        None => comptime_diagnostic(message, site_source_path, site_start, site_end),
    }
}

fn short_comptime_name(value: string) -> string {
    let mut result = value;
    let mut index = 0;
    while index + 1 < value.byte_len() {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            result = value.byte_slice(index + 2, value.byte_len());
            index = index + 2;
        } else {
            index = index + 1;
        }
    }
    result
}

fn comptime_names_match(left: string, right: string) -> bool {
    left == right || short_comptime_name(left) == short_comptime_name(right)
}

fn add_origin(module: ctir::CtModule, source_path: string, start: int, end: int) -> int {
    let result = module.origins.len();
    module.origins.push(ctir::CtOrigin { source_path, start, end });
    result
}

fn next_expr_origin(ctx: CtLowerContext) -> int {
    let index = ctx.origin_cursor.get();
    if index < ctx.origin_spans.len() {
        let span = ctx.origin_spans[index];
        ctx.origin_cursor.set(index + 1);
        add_origin(ctx.module, ctx.source_path, span.start, span.end)
    } else {
        ctx.origin
    }
}

fn integer_type(ctx: CtLowerContext, value: Type) -> Option[(bool, int)] {
    match resolve_type(value) {
        Int => Option::Some((true, ctx.module.target.int_width)),
        Int8 => Option::Some((true, 8)),
        Int16 => Option::Some((true, 16)),
        Int32 => Option::Some((true, 32)),
        Int64 => Option::Some((true, 64)),
        Uint => Option::Some((false, ctx.module.target.int_width)),
        Uint8 => Option::Some((false, 8)),
        Uint16 => Option::Some((false, 16)),
        Uint32 => Option::Some((false, 32)),
        Uint64 => Option::Some((false, 64)),
        _ => Option::None,
    }
}

fn substitute_ct_type(value: Type, names: Vec[string], args: Vec[Type]) -> Type {
    match resolve_type(value) {
        Param { name } => {
            for index in 0..names.len() {
                if names[index] == name && index < args.len() {
                    return args[index]
                } else {}
            }
            Type::Param { name }
        },
        Tuple { items } => {
            let result: Vec[Type] = Vec::[];
            for item in items {
                result.push(substitute_ct_type(item, names, args))
            }
            Type::Tuple { items: result }
        },
        App { ty, args: values } => {
            let result: Vec[Type] = Vec::[];
            for value in values {
                result.push(substitute_ct_type(value, names, args))
            }
            Type::App { ty: substitute_ct_type(ty, names, args), args: result }
        },
        Array { len, elem } => {
            Type::Array { len, elem: substitute_ct_type(elem, names, args) }
        },
        other => other,
    }
}

fn find_ct_struct(file: File, name: string) -> Option[StructDef] {
    let result = Ref::new(Option::None);
    for value in file.structs {
        if value.name == name {
            return Option::Some(value)
        } else if short_comptime_name(value.name) == short_comptime_name(name) {
            if result.get().is_some() {
                return Option::None
            } else {
                result.set(Option::Some(value))
            }
        } else {}
    }
    result.get()
}

fn find_ct_enum(file: File, name: string) -> Option[EnumDef] {
    let result = Ref::new(Option::None);
    for value in file.enums {
        if value.name == name {
            return Option::Some(value)
        } else if short_comptime_name(value.name) == short_comptime_name(name) {
            if result.get().is_some() {
                return Option::None
            } else {
                result.set(Option::Some(value))
            }
        } else {}
    }
    result.get()
}

fn nominal_type_arguments(value: Type) -> Vec[Type] {
    match resolve_type(value) {
        Type::App { ty: _, args } => args,
        _ => Vec::[],
    }
}

fn nominal_ct_type(ctx: CtLowerContext, name: string, args: Vec[Type]) -> Result[
    ctir::CtType,
    string,
] {
    match find_ct_struct(ctx.file, name) {
        Some(definition) => {
            let fields: Vec[ctir::CtType] = Vec::[];
            for field in definition.fields {
                fields.push(
                    lower_ct_type(ctx, substitute_ct_type(field.1, definition.generics, args))?,
                )
            }
            Result::Ok(ctir::CtType::Struct { name: definition.name, fields })
        },
        None => match find_ct_enum(ctx.file, name) {
            Some(definition) => {
                let variants: Vec[Vec[ctir::CtType]] = Vec::[];
                for variant in definition.variants {
                    let fields: Vec[ctir::CtType] = Vec::[];
                    match variant.fields {
                        EnumVariantFields::Unit => (),
                        EnumVariantFields::Tuple(values) => for value in values {
                            fields.push(
                                lower_ct_type(
                                    ctx,
                                    substitute_ct_type(value, definition.generics, args),
                                )?,
                            )
                        },
                        EnumVariantFields::Struct(values) => for value in values {
                            fields.push(
                                lower_ct_type(
                                    ctx,
                                    substitute_ct_type(value.1, definition.generics, args),
                                )?,
                            )
                        },
                    }
                    variants.push(fields)
                }
                Result::Ok(ctir::CtType::Enum { name: definition.name, variants })
            },
            None => Result::Err("type `" + name + "` is not available in comptime"),
        },
    }
}

fn lower_ct_type(ctx: CtLowerContext, value: Type) -> Result[ctir::CtType, string] {
    match resolve_type(value) {
        Unit => Result::Ok(ctir::CtType::Unit),
        Never => Result::Ok(ctir::CtType::Never),
        Bool => Result::Ok(ctir::CtType::Bool),
        Int => Result::Ok(
            ctir::CtType::Integer { signed: true, width: ctx.module.target.int_width },
        ),
        Int8 => Result::Ok(ctir::CtType::Integer { signed: true, width: 8 }),
        Int16 => Result::Ok(ctir::CtType::Integer { signed: true, width: 16 }),
        Int32 => Result::Ok(ctir::CtType::Integer { signed: true, width: 32 }),
        Int64 => Result::Ok(ctir::CtType::Integer { signed: true, width: 64 }),
        Uint => Result::Ok(
            ctir::CtType::Integer { signed: false, width: ctx.module.target.int_width },
        ),
        Uint8 => Result::Ok(ctir::CtType::Integer { signed: false, width: 8 }),
        Uint16 => Result::Ok(ctir::CtType::Integer { signed: false, width: 16 }),
        Uint32 => Result::Ok(ctir::CtType::Integer { signed: false, width: 32 }),
        Uint64 => Result::Ok(ctir::CtType::Integer { signed: false, width: 64 }),
        String => Result::Ok(ctir::CtType::String),
        Char => Result::Ok(ctir::CtType::Char),
        Tuple { items } => {
            let result: Vec[ctir::CtType] = Vec::[];
            for item in items {
                result.push(lower_ct_type(ctx, item)?)
            }
            Result::Ok(ctir::CtType::Tuple(result))
        },
        Array { len, elem } => {
            Result::Ok(ctir::CtType::Array { len, elem: lower_ct_type(ctx, elem)? })
        },
        Con { name } => if derive::is_meta_type(name) {
            Result::Ok(ctir::CtType::Meta(name))
        } else {
            nominal_ct_type(ctx, name, Vec::[])
        },
        App { ty, args } => match resolve_type(ty) {
            Con { name } => nominal_ct_type(ctx, name, args),
            _ => Result::Err("comptime does not support this applied type"),
        },
        Float32 | Float64 => Result::Err("comptime floating-point evaluation is not supported"),
        _ => Result::Err("type is not available in comptime"),
    }
}

fn integer_literal_bits(value: string) -> Option[uint64] {
    let mut base = 10;
    let mut index = 0;
    if value.byte_len() >= 2 && value.byte_get(0) == b'0' {
        match value.byte_get(1) {
            b'b' | b'B' => {
                base = 2;
                index = 2;
            },
            b'o' | b'O' => {
                base = 8;
                index = 2;
            },
            b'x' | b'X' => {
                base = 16;
                index = 2;
            },
            _ => (),
        }
    } else {};
    let mut result = 0 as uint64;
    let mut found = false;
    while index < value.byte_len() {
        let digit = value.byte_get(index);
        if digit == b'_' {
            index = index + 1;
            continue
        } else {};
        let part = if digit >= b'0' && digit <= b'9' {
            (digit - b'0') as int
        } else if digit >= b'a' && digit <= b'f' {
            (digit - b'a' + 10) as int
        } else if digit >= b'A' && digit <= b'F' {
            (digit - b'A' + 10) as int
        } else {
            return Option::None
        };
        if part >= base {
            return Option::None
        } else {};
        result = result * (base as uint64) + (part as uint64);
        found = true;
        index = index + 1;
    }
    if found {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn primitive_ct_value(ctx: CtLowerContext, value: Primitive, ty: Type) -> Result[
    ctir::CtValue,
    string,
] {
    match value {
        Unit => Result::Ok(ctir::CtValue::Unit),
        Bool { value } => Result::Ok(ctir::CtValue::Bool(value)),
        String { value } => Result::Ok(ctir::CtValue::String(value)),
        Char { value } => Result::Ok(ctir::CtValue::Char(value)),
        Int { value } | Int8 { value } | Int16 { value } | Int32 { value } | Int64 { value } | Uint {
            value,
        } | Uint8 { value } | Uint16 { value } | Uint32 { value } | Uint64 { value } => {
            let Some(bits) = integer_literal_bits(value) else {
                return Result::Err("invalid comptime integer literal")
            };
            let Some((signed, width)) = integer_type(ctx, ty) else {
                return Result::Err("comptime integer literal has a non-integer type")
            };
            Result::Ok(ctir::CtValue::Integer { signed, width, bits })
        },
        Float { value: _ } | Float32 { value: _ } | Float64 { value: _ } => {
            Result::Err("comptime floating-point evaluation is not supported")
        },
    }
}

fn lower_unary_op(value: ast::UnaryOp) -> ctir::CtUnaryOp {
    match value {
        Neg => ctir::CtUnaryOp::Neg,
        Not => ctir::CtUnaryOp::Not,
        BitNot => ctir::CtUnaryOp::BitNot,
    }
}

fn lower_binary_op(value: ast::BinaryOp) -> ctir::CtBinaryOp {
    match value {
        Add => ctir::CtBinaryOp::Add,
        Sub => ctir::CtBinaryOp::Sub,
        Mul => ctir::CtBinaryOp::Mul,
        Div => ctir::CtBinaryOp::Div,
        Rem => ctir::CtBinaryOp::Rem,
        BitAnd => ctir::CtBinaryOp::BitAnd,
        BitOr => ctir::CtBinaryOp::BitOr,
        BitXor => ctir::CtBinaryOp::BitXor,
        Shl => ctir::CtBinaryOp::Shl,
        Shr => ctir::CtBinaryOp::Shr,
        And => ctir::CtBinaryOp::And,
        Or => ctir::CtBinaryOp::Or,
        Less => ctir::CtBinaryOp::Less,
        Greater => ctir::CtBinaryOp::Greater,
        LessEq => ctir::CtBinaryOp::LessEq,
        GreaterEq => ctir::CtBinaryOp::GreaterEq,
        Eq => ctir::CtBinaryOp::Eq,
        NotEq => ctir::CtBinaryOp::NotEq,
    }
}

fn find_local_slot(ctx: CtLowerContext, name: string) -> Option[int] {
    let mut index = ctx.locals.len();
    while index > 0 {
        index = index - 1;
        if ctx.locals[index].0 == name {
            return Option::Some(ctx.locals[index].1)
        } else {}
    }
    Option::None
}

fn bind_pattern_slot(ctx: CtLowerContext, name: string, ty: Type, pattern_base: int) -> Result[
    int,
    string,
] {
    let mut index = ctx.locals.len();
    while index > pattern_base {
        index = index - 1;
        if ctx.locals[index].0 == name {
            return Result::Ok(ctx.locals[index].1)
        } else {}
    }
    let value = ctx.next_slot.get();
    ctx.next_slot.set(value + 1);
    ctx.locals.push((name, value));
    ctx.local_types.push(lower_ct_type(ctx, ty)?);
    Result::Ok(value)
}

fn lower_ct_pattern_at(ctx: CtLowerContext, value: Pat, pattern_base: int) -> Result[
    ctir::CtPattern,
    string,
] {
    match value {
        Var { name, is_mut: _, ty } => {
            Result::Ok(
                ctir::CtPattern::Bind { slot: bind_pattern_slot(ctx, name, ty, pattern_base)? },
            )
        },
        Prim { value, ty } => {
            Result::Ok(ctir::CtPattern::Value(primitive_ct_value(ctx, value, ty)?))
        },
        Constr { constructor, args, ty } => {
            let fields: Vec[ctir::CtPattern] = Vec::[];
            for arg in args {
                fields.push(lower_ct_pattern_at(ctx, arg, pattern_base)?)
            }
            match constructor.tag {
                Some(variant) => match lower_ct_type(ctx, ty)? {
                    ctir::CtType::Enum { name, variants: _ } => {
                        Result::Ok(ctir::CtPattern::Enum { name, variant, fields })
                    },
                    _ => Result::Err("comptime enum pattern has a non-enum type"),
                },
                None => match lower_ct_type(ctx, ty)? {
                    ctir::CtType::Struct { name, fields: _ } => {
                        let result: Vec[(int, ctir::CtPattern)] = Vec::[];
                        for index in 0..fields.len() {
                            result.push((index, fields[index]))
                        }
                        Result::Ok(ctir::CtPattern::Struct { name, fields: result })
                    },
                    _ => Result::Err("comptime constructor pattern is unsupported"),
                },
            }
        },
        Tuple { items, ty: _ } => {
            let result: Vec[ctir::CtPattern] = Vec::[];
            for item in items {
                result.push(lower_ct_pattern_at(ctx, item, pattern_base)?)
            }
            Result::Ok(ctir::CtPattern::Tuple(result))
        },
        Array { prefix, rest, suffix, ty: _ } => {
            let lowered_prefix: Vec[ctir::CtPattern] = Vec::[];
            let lowered_suffix: Vec[ctir::CtPattern] = Vec::[];
            for item in prefix {
                lowered_prefix.push(lower_ct_pattern_at(ctx, item, pattern_base)?)
            }
            for item in suffix {
                lowered_suffix.push(lower_ct_pattern_at(ctx, item, pattern_base)?)
            }
            Result::Ok(
                ctir::CtPattern::Array {
                    prefix: lowered_prefix,
                    rest: match rest {
                        Some(value) => match value.binding {
                            Some(name) => Option::Some(
                                bind_pattern_slot(ctx, name, value.ty, pattern_base)?,
                            ),
                            None => Option::None,
                        },
                        None => Option::None,
                    },
                    suffix: lowered_suffix,
                },
            )
        },
        Alias { name, pat, ty } => Result::Ok(
            ctir::CtPattern::Alias {
                slot: bind_pattern_slot(ctx, name, ty, pattern_base)?,
                pattern: lower_ct_pattern_at(ctx, pat, pattern_base)?,
            },
        ),
        Or { pats, ty: _ } => {
            let result: Vec[ctir::CtPattern] = Vec::[];
            for pat in pats {
                result.push(lower_ct_pattern_at(ctx, pat, pattern_base)?)
            }
            Result::Ok(ctir::CtPattern::Or(result))
        },
        Range { start, end, inclusive, ty } => Result::Ok(
            ctir::CtPattern::Range {
                start: primitive_ct_value(ctx, start, ty)?,
                end: primitive_ct_value(ctx, end, ty)?,
                inclusive,
            },
        ),
        Wild { ty: _ } => Result::Ok(ctir::CtPattern::Wild),
    }
}

fn lower_ct_pattern(ctx: CtLowerContext, value: Pat) -> Result[ctir::CtPattern, string] {
    lower_ct_pattern_at(ctx, value, ctx.locals.len())
}

fn function_call_target(ctx: CtLowerContext, name: string) -> Option[ctir::CtCallTarget] {
    for entry in ctx.module.entries {
        if comptime_names_match(entry.name, name) {
            return Option::Some(ctir::CtCallTarget::Local(entry.function_id))
        } else {}
    }
    if ctx.derive {
        for entry in ctx.module.derive_entries {
            if comptime_names_match(entry.name, name) {
                return Option::Some(ctir::CtCallTarget::Local(entry.function_id))
            } else {}
        }
    } else {};
    for dependency in ctx.dependencies {
        for entry in dependency.entries {
            if comptime_names_match(entry.name, name) {
                return Option::Some(
                    ctir::CtCallTarget::External {
                        package_name: dependency.package_name,
                        entry_name: entry.name,
                    },
                )
            } else {}
        }
        if ctx.derive {
            for entry in dependency.derive_entries {
                if comptime_names_match(entry.name, name) {
                    return Option::Some(
                        ctir::CtCallTarget::External {
                            package_name: dependency.package_name,
                            entry_name: entry.name,
                        },
                    )
                } else {}
            }
        } else {}
    }
    Option::None
}

fn string_method_intrinsic(receiver_ty: Type, name: string) -> Option[string] {
    match resolve_type(receiver_ty) {
        Type::String => if name == "len" || name == "byte_len" || name == "get"
            || name == "byte_get"
            || name == "byte_slice"
            || name == "is_char_boundary"
            || name == "starts_with"
            || name == "ends_with"
            || name == "contains" {
            Option::Some("comptime.string." + name)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn external_call_return_type(ctx: CtLowerContext, target: ctir::CtCallTarget) -> Option[
    ctir::CtType,
] {
    match target {
        ctir::CtCallTarget::Local(_) | ctir::CtCallTarget::Intrinsic(_) => Option::None,
        ctir::CtCallTarget::External { package_name, entry_name } => {
            for dependency in ctx.dependencies {
                if dependency.package_name == package_name {
                    for entry in dependency.entries {
                        if entry.name == entry_name {
                            for function in dependency.functions {
                                if function.id == entry.function_id {
                                    return Option::Some(function.return_type)
                                } else {}
                            }
                        } else {}
                    }
                    if ctx.derive {
                        for entry in dependency.derive_entries {
                            if entry.name == entry_name {
                                for function in dependency.functions {
                                    if function.id == entry.function_id {
                                        return Option::Some(function.return_type)
                                    } else {}
                                }
                            } else {}
                        }
                    } else {}
                } else {}
            }
            Option::None
        },
    }
}

fn non_never_ct_type(primary: ctir::CtType, fallback: ctir::CtType) -> ctir::CtType {
    match primary {
        ctir::CtType::Never => fallback,
        _ => primary,
    }
}

fn lowered_expr_type(ctx: CtLowerContext, kind: ctir::CtExprKind, fallback: ctir::CtType) -> ctir::CtType {
    match kind {
        ctir::CtExprKind::Call { target, args: _ } => match external_call_return_type(ctx, target) {
            Some(value) => value,
            None => fallback,
        },
        ctir::CtExprKind::Tuple(values) => {
            let types: Vec[ctir::CtType] = Vec::[];
            for value in values {
                types.push(value.ty)
            }
            ctir::CtType::Tuple(types)
        },
        ctir::CtExprKind::Array(values) => if values.is_empty() {
            fallback
        } else {
            ctir::CtType::Array { len: values.len(), elem: values[0].ty }
        },
        ctir::CtExprKind::Block(value) => match value.tail {
            Some(value) => non_never_ct_type(value.ty, fallback),
            None => ctir::CtType::Unit,
        },
        ctir::CtExprKind::If { condition: _, then_branch, else_branch } => {
            non_never_ct_type(then_branch.ty, else_branch.ty)
        },
        ctir::CtExprKind::Match { value: _, arms } => {
            let mut result = ctir::CtType::Never;
            for arm in arms {
                result = non_never_ct_type(result, arm.body.ty);
            }
            non_never_ct_type(result, fallback)
        },
        _ => fallback,
    }
}

fn constant_package(ctx: CtLowerContext, name: string) -> Option[string] {
    for value in ctx.constant_names {
        if comptime_names_match(value, name) {
            return Option::Some(ctx.module.package_name)
        } else {}
    }
    for value in ctx.module.constants {
        if comptime_names_match(value.name, name) {
            return Option::Some(ctx.module.package_name)
        } else {}
    }
    for dependency in ctx.dependencies {
        for value in dependency.constants {
            if comptime_names_match(value.name, name) {
                return Option::Some(dependency.package_name)
            } else {}
        }
    }
    Option::None
}

fn comptime_constant_names(file: File, pending: Vec[PendingConstant]) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for value in file.constants {
        result.push(value.name)
    }
    for value in pending {
        result.push(value.name)
    }
    result
}

fn lower_ct_exprs(ctx: CtLowerContext, values: Vec[Expr]) -> Result[Vec[ctir::CtExpr], string] {
    let result: Vec[ctir::CtExpr] = Vec::[];
    for value in values {
        result.push(lower_ct_expr(ctx, value)?)
    }
    Result::Ok(result)
}

fn lower_ct_for_body(ctx: CtLowerContext, target: int, body: Expr) -> Result[ctir::CtExpr, string] {
    ctx.loop_targets.push(target);
    let result = lower_ct_expr(ctx, body);
    let _ = ctx.loop_targets.pop();
    result
}

fn lower_ct_for(ctx: CtLowerContext, pattern: Pat, iterator: Expr, body: Expr) -> Result[
    ctir::CtExprKind,
    string,
] {
    let target = ctx.next_loop.get();
    ctx.next_loop.set(target + 1);
    let pattern = lower_ct_pattern(ctx, pattern)?;
    match iterator {
        Call {
            func: Callable { callable: Callable::LangItem { item, function_name: _ }, ty: _ },
            args,
            ty: _,
        } => if item == "range" || item == "range_inclusive" {
            if args.len() != 2 {
                Result::Err("comptime range for expects two bounds")
            } else {
                Result::Ok(
                    ctir::CtExprKind::ForRange {
                        target,
                        pattern,
                        start: lower_ct_expr(ctx, args[0])?,
                        end: lower_ct_expr(ctx, args[1])?,
                        inclusive: item == "range_inclusive",
                        body: lower_ct_for_body(ctx, target, body)?,
                    },
                )
            }
        } else {
            Result::Err("comptime for only supports fixed arrays and builtin ranges")
        },
        other => match resolve_type(expr_type(other)) {
            Type::Array { len: _, elem: _ } => Result::Ok(
                ctir::CtExprKind::ForArray {
                    target,
                    pattern,
                    value: lower_ct_expr(ctx, other)?,
                    body: lower_ct_for_body(ctx, target, body)?,
                },
            ),
            _ => Result::Err("comptime for only supports fixed arrays and builtin ranges"),
        },
    }
}

fn ct_builtin_equality_type(ty: Type) -> bool {
    match resolve_type(ty) {
        Type::Unit | Type::Bool | Type::Int | Type::Int8 | Type::Int16 | Type::Int32 | Type::Int64 | Type::Uint | Type::Uint8 | Type::Uint16 | Type::Uint32 | Type::Uint64 | Type::String | Type::Char => true,
        Type::Tuple { items } => {
            for item in items {
                if !ct_builtin_equality_type(item) {
                    return false
                } else {}
            }
            true
        },
        Type::Array { len: _, elem } => ct_builtin_equality_type(elem),
        _ => false,
    }
}

fn lower_ct_expr(ctx: CtLowerContext, value: Expr) -> Result[ctir::CtExpr, string] {
    match value {
        Closure { .. } => return Result::Err("closures are not available in comptime"),
        _ => (),
    };
    let ty = lower_ct_type(ctx, expr_type(value))?;
    let kind = match value {
        Var { name, ty: _ } => match find_local_slot(ctx, name) {
            Some(slot) => ctir::CtExprKind::Local(slot),
            None => match constant_package(ctx, name) {
                Some(package_name) => ctir::CtExprKind::Constant { package_name, name },
                None => return Result::Err(
                    "comptime expression cannot capture runtime local `" + name + "`",
                ),
            },
        },
        Callable { callable: _, ty: _ } => {
            return Result::Err("function values are not available in comptime")
        },
        Prim { value, ty: source_ty } => {
            ctir::CtExprKind::Value(primitive_ct_value(ctx, value, source_ty)?)
        },
        Constr { constructor, args, ty: source_ty } => {
            let fields = lower_ct_exprs(ctx, args)?;
            match constructor.tag {
                Some(variant) => match lower_ct_type(ctx, source_ty)? {
                    ctir::CtType::Enum { name, variants: _ } => {
                        ctir::CtExprKind::Enum { name, variant, fields }
                    },
                    _ => return Result::Err("comptime enum constructor has a non-enum type"),
                },
                None => match lower_ct_type(ctx, source_ty)? {
                    ctir::CtType::Struct { name, fields: _ } => {
                        ctir::CtExprKind::Struct { name, fields }
                    },
                    _ => return Result::Err("comptime constructor is unsupported"),
                },
            }
        },
        Tuple { items, ty: _ } => ctir::CtExprKind::Tuple(lower_ct_exprs(ctx, items)?),
        Array { items, ty: _ } => ctir::CtExprKind::Array(lower_ct_exprs(ctx, items)?),
        Closure { .. } => return Result::Err("closures are not available in comptime"),
        Block { block, ty: _ } => ctir::CtExprKind::Block(lower_ct_block(ctx, block)?),
        Comptime { .. } => return Result::Err("nested comptime expressions are not supported"),
        Match { expr, arms, ty: _ } => {
            let source = lower_ct_expr(ctx, expr)?;
            let result: Vec[ctir::CtArm] = Vec::[];
            for arm in arms {
                result.push(
                    ctir::CtArm {
                        pattern: lower_ct_pattern(ctx, arm.pat)?,
                        guard: match arm.guard {
                            Some(value) => Option::Some(lower_ct_expr(ctx, value)?),
                            None => Option::None,
                        },
                        body: lower_ct_expr(ctx, arm.body)?,
                        origin: ctx.origin,
                    },
                )
            }
            ctir::CtExprKind::Match { value: source, arms: result }
        },
        If { cond, then_branch, else_branch, ty: _ } => ctir::CtExprKind::If {
            condition: lower_ct_expr(ctx, cond)?,
            then_branch: lower_ct_expr(ctx, then_branch)?,
            else_branch: lower_ct_expr(ctx, else_branch)?,
        },
        While { cond, body, ty: _ } => {
            let target = ctx.next_loop.get();
            ctx.next_loop.set(target + 1);
            let condition = lower_ct_expr(ctx, cond)?;
            ctx.loop_targets.push(target);
            let body = lower_ct_expr(ctx, body)?;
            let _ = ctx.loop_targets.pop();
            ctir::CtExprKind::While { target, condition, body }
        },
        Loop { body, ty: _ } => {
            let target = ctx.next_loop.get();
            ctx.next_loop.set(target + 1);
            ctx.loop_targets.push(target);
            let body = lower_ct_expr(ctx, body)?;
            let _ = ctx.loop_targets.pop();
            ctir::CtExprKind::Loop { target, body }
        },
        For {
            pat,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => lower_ct_for(ctx, pat, iterator, body)?,
        Break { target, value, ty: _ } => ctir::CtExprKind::Break {
            target: if target < ctx.loop_targets.len() {
                ctx.loop_targets[ctx.loop_targets.len() - target - 1]
            } else {
                return Result::Err("comptime break target is not in scope")
            },
            value: match value {
                Some(value) => Option::Some(lower_ct_expr(ctx, value)?),
                None => Option::None,
            },
        },
        Continue { target, ty: _ } => ctir::CtExprKind::Continue {
            target: if target < ctx.loop_targets.len() {
                ctx.loop_targets[ctx.loop_targets.len() - target - 1]
            } else {
                return Result::Err("comptime continue target is not in scope")
            },
        },
        Return { expr, ty: _ } => ctir::CtExprKind::Return(
            match expr {
                Some(value) => Option::Some(lower_ct_expr(ctx, value)?),
                None => Option::None,
            },
        ),
        Go { .. } => return Result::Err("go statements are not available in comptime"),
        Call { func, args, ty: _ } => match func {
            Expr::Callable { callable, ty: _ } => match callable {
                Callable::Intrinsic(name) => if name == "compile_error" {
                    if args.len() != 1 {
                        return Result::Err("compile_error expects one argument")
                    } else {};
                    ctir::CtExprKind::CompileError(lower_ct_expr(ctx, args[0])?)
                } else if ctx.derive && derive::is_intrinsic(name) {
                    ctir::CtExprKind::Call {
                        target: ctir::CtCallTarget::Intrinsic(name),
                        args: lower_ct_exprs(ctx, args)?,
                    }
                } else {
                    return Result::Err("comptime intrinsic `" + name + "` is not supported")
                },
                Callable::Function(name) => {
                    let Some(target) = function_call_target(ctx, name) else {
                        return Result::Err(
                            "comptime function calls runtime-only function `" + name + "`",
                        )
                    };
                    ctir::CtExprKind::Call { target, args: lower_ct_exprs(ctx, args)? }
                },
                Callable::InherentMethod { receiver_ty, method_name } => {
                    let Some(name) = string_method_intrinsic(receiver_ty, method_name) else {
                        return Result::Err("comptime only supports deterministic string methods")
                    };
                    ctir::CtExprKind::Call {
                        target: ctir::CtCallTarget::Intrinsic(name),
                        args: lower_ct_exprs(ctx, args)?,
                    }
                },
                _ => return Result::Err("comptime only supports direct #[comptime] function calls"),
            },
            _ => return Result::Err("comptime only supports direct function calls"),
        },
        Unary { op, expr, ty: _ } => ctir::CtExprKind::Unary {
            op: lower_unary_op(op),
            value: lower_ct_expr(ctx, expr)?,
        },
        Cast { expr, ty: target } => ctir::CtExprKind::Cast {
            value: lower_ct_expr(ctx, expr)?,
            target: lower_ct_type(ctx, target)?,
        },
        Proj { tuple, index, ty: _ } => {
            ctir::CtExprKind::Field { value: lower_ct_expr(ctx, tuple)?, index }
        },
        Field { expr, field_name, ty: _ } => {
            let source_ty = lower_ct_type(ctx, expr_type(expr))?;
            let index = match source_ty {
                ctir::CtType::Struct { name, fields: _ } => {
                    let Some(definition) = find_ct_struct(ctx.file, name) else {
                        return Result::Err("comptime struct field metadata is missing")
                    };
                    let mut found = -1;
                    for field_index in 0..definition.fields.len() {
                        if definition.fields[field_index].0 == field_name {
                            found = field_index;
                        } else {}
                    }
                    if found < 0 {
                        return Result::Err("comptime struct field is missing")
                    } else {
                        found
                    }
                },
                _ => return Result::Err("comptime field access requires a struct value"),
            };
            ctir::CtExprKind::Field { value: lower_ct_expr(ctx, expr)?, index }
        },
        Index { base, index, ty: _ } => ctir::CtExprKind::Index {
            value: lower_ct_expr(ctx, base)?,
            index: lower_ct_expr(ctx, index)?,
        },
        Binary { op, lhs, rhs, ty: _, resolution } => {
            match resolution {
                BinaryResolution::Builtin => (),
                BinaryResolution::Overloaded { trait_name } => if trait_name == "Eq"
                    && ct_builtin_equality_type(expr_type(lhs))
                    && ct_builtin_equality_type(expr_type(rhs)) {} else {
                    return Result::Err("overloaded operators are not available in comptime")
                },
            };
            ctir::CtExprKind::Binary {
                op: lower_binary_op(op),
                left: lower_ct_expr(ctx, lhs)?,
                right: lower_ct_expr(ctx, rhs)?,
            }
        },
        ToDyn { .. } => return Result::Err("dynamic trait values are not available in comptime"),
    };
    let ty = lowered_expr_type(ctx, kind, ty);
    Result::Ok(ctir::CtExpr { kind, ty, origin: next_expr_origin(ctx) })
}

fn lower_ct_stmt(ctx: CtLowerContext, value: Stmt) -> Result[ctir::CtStmt, string] {
    match value {
        Defer { expr: _ } => Result::Err("defer is not available in comptime"),
        Let { is_mut: _, pat, value } => {
            let value = lower_ct_expr(ctx, value)?;
            let pattern = lower_ct_pattern(ctx, pat)?;
            Result::Ok(ctir::CtStmt::Let { pattern, value })
        },
        LetElse { .. } => Result::Err("let-else is not available in comptime"),
        Assign { target, op, value } => match target {
            Expr::Var { name, ty } => {
                let _ = next_expr_origin(ctx);
                let Some(slot) = find_local_slot(ctx, name) else {
                    return Result::Err("comptime assignment target is not a local variable")
                };
                let lowered = match op {
                    ast::AssignmentOp::Plain => lower_ct_expr(ctx, value)?,
                    ast::AssignmentOp::Compound(op) => ctir::CtExpr {
                        kind: ctir::CtExprKind::Binary {
                            op: lower_binary_op(op),
                            left: ctir::CtExpr {
                                kind: ctir::CtExprKind::Local(slot),
                                ty: lower_ct_type(ctx, ty)?,
                                origin: ctx.origin,
                            },
                            right: lower_ct_expr(ctx, value)?,
                        },
                        ty: lower_ct_type(ctx, ty)?,
                        origin: ctx.origin,
                    },
                };
                Result::Ok(ctir::CtStmt::Assign { slot, value: lowered })
            },
            _ => Result::Err("comptime assignment requires a local variable target"),
        },
        Expr { expr } => Result::Ok(ctir::CtStmt::Expr(lower_ct_expr(ctx, expr)?)),
    }
}

fn lower_ct_block(ctx: CtLowerContext, value: Block) -> Result[ctir::CtBlock, string] {
    let statements: Vec[ctir::CtStmt] = Vec::[];
    for statement in value.stmts {
        statements.push(lower_ct_stmt(ctx, statement)?)
    }
    let tail = match value.tail {
        Some(value) => Option::Some(lower_ct_expr(ctx, value)?),
        None => Option::None,
    };
    Result::Ok(ctir::CtBlock { statements, tail, origin: ctx.origin })
}

fn capable_functions(file: File) -> Vec[Function] {
    let result: Vec[Function] = Vec::[];
    for item in file.items {
        match item {
            Item::Function(value) => match value.comptime {
                ComptimeCapability::Capable | ComptimeCapability::Derive => result.push(value),
                ComptimeCapability::RuntimeOnly => (),
            },
            Item::ImplBlock(_) => (),
        }
    }
    result
}

fn build_comptime_module(
    file: File,
    constant_names: Vec[string],
    package_name: string,
    dependencies: Vec[ctir::CtModule],
    diagnostics: Vec[Diagnostic],
) -> ctir::CtModule {
    let module = ctir::empty_module(package_name);
    let functions = capable_functions(file);
    for index in 0..functions.len() {
        let entry = ctir::CtEntry {
            name: functions[index].name,
            function_id: index,
            public: match functions[index].visibility {
                ast::Visibility::Public => true,
                ast::Visibility::Private => false,
            },
        };
        match functions[index].comptime {
            ComptimeCapability::Capable => module.entries.push(entry),
            ComptimeCapability::Derive => module.derive_entries.push(entry),
            ComptimeCapability::RuntimeOnly => (),
        }
    }
    for index in 0..functions.len() {
        let function = functions[index];
        let origin = add_origin(module, function.source_path, function.start, function.end);
        let locals: Vec[(string, int)] = Vec::[];
        let local_types: Vec[ctir::CtType] = Vec::[];
        let parameter_slots: Vec[int] = Vec::[];
        let parameter_source_types: Vec[Type] = Vec::[];
        let next_slot = Ref::new(0);
        for parameter in function.params {
            let slot = next_slot.get();
            next_slot.set(slot + 1);
            locals.push((parameter.0, slot));
            parameter_slots.push(slot);
            parameter_source_types.push(parameter.1)
        }
        let ctx = CtLowerContext {
            package_name,
            file,
            module,
            dependencies,
            constant_names,
            locals,
            local_types,
            next_slot,
            loop_targets: Vec::[],
            next_loop: Ref::new(0),
            origin,
            source_path: function.source_path,
            origin_spans: function.comptime_origins,
            origin_cursor: Ref::new(0),
            derive: match function.comptime {
                ComptimeCapability::Derive => true,
                _ => false,
            },
        };
        let parameter_types: Vec[ctir::CtType] = Vec::[];
        let parameter_error = Ref::new(Option::None);
        for parameter_type in parameter_source_types {
            match lower_ct_type(ctx, parameter_type) {
                Ok(value) => {
                    parameter_types.push(value);
                    local_types.push(value)
                },
                Err(message) => parameter_error.set(Option::Some(message)),
            }
        }
        match parameter_error.get() {
            Some(message) => diagnostics.push(
                comptime_diagnostic(
                    "function `" + function.name + "` is marked #[comptime] but " + message,
                    function.source_path,
                    function.start,
                    function.end,
                ),
            ),
            None => match lower_ct_type(ctx, function.ret_ty) {
                Err(message) => diagnostics.push(
                    comptime_diagnostic(
                        "function `" + function.name + "` is marked #[comptime] but " + message,
                        function.source_path,
                        function.start,
                        function.end,
                    ),
                ),
                Ok(return_type) => match lower_ct_block(ctx, function.body) {
                    Ok(body) => module.functions.push(
                        ctir::CtFunction {
                            id: index,
                            name: function.name,
                            parameter_slots,
                            parameter_types,
                            local_count: next_slot.get(),
                            local_types,
                            return_type,
                            body,
                            origin,
                        },
                    ),
                    Err(message) => diagnostics.push(
                        comptime_function_diagnostic(function, ctx.origin_cursor.get(), message),
                    ),
                },
            },
        }
    }
    module
}

struct CtConstantCandidate {
    name: string,
    ty: Type,
    expression: ctir::CtExpr,
    origin: int,
    source_path: string,
    start: int,
    end: int,
    pending: bool,
}

fn lower_const_expr(ctx: CtLowerContext, value: ConstExpr) -> Result[ctir::CtExpr, string] {
    let ty = lower_ct_type(
        ctx,
        match value {
            ConstExpr::Prim { ty, .. } | ConstExpr::Ref { ty, .. } | ConstExpr::Unary { ty, .. } | ConstExpr::Cast {
                ty,
                ..,
            } | ConstExpr::Binary { ty, .. } | ConstExpr::Error { ty } => ty,
        },
    )?;
    let kind = match value {
        ConstExpr::Prim { value, ty } => {
            ctir::CtExprKind::Value(primitive_ct_value(ctx, value, ty)?)
        },
        ConstExpr::Ref { name, ty: _ } => {
            let Some(package_name) = constant_package(ctx, name) else {
                return Result::Err("unknown comptime constant " + name)
            };
            ctir::CtExprKind::Constant { package_name, name }
        },
        ConstExpr::Unary { op, expr, ty: _ } => ctir::CtExprKind::Unary {
            op: lower_unary_op(op),
            value: lower_const_expr(ctx, expr)?,
        },
        ConstExpr::Cast { expr, ty: target } => ctir::CtExprKind::Cast {
            value: lower_const_expr(ctx, expr)?,
            target: lower_ct_type(ctx, target)?,
        },
        ConstExpr::Binary { op, lhs, rhs, ty: _ } => ctir::CtExprKind::Binary {
            op: lower_binary_op(op),
            left: lower_const_expr(ctx, lhs)?,
            right: lower_const_expr(ctx, rhs)?,
        },
        ConstExpr::Error { ty: _ } => return Result::Err("invalid constant expression"),
    };
    Result::Ok(ctir::CtExpr { kind, ty, origin: ctx.origin })
}

fn constant_expr_from_value(value: ctir::CtValue, ty: Type) -> Result[ConstExpr, string] {
    match reify_ct_value(
        File { items: Vec::[], enums: Vec::[], structs: Vec::[], constants: Vec::[] },
        value,
        ty,
    )? {
        Expr::Prim { value, ty } => Result::Ok(ConstExpr::Prim { value, ty }),
        _ => Result::Err("top-level comptime constants must produce scalar values"),
    }
}

fn constant_candidates(
    file: File,
    pending: Vec[PendingConstant],
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    constant_names: Vec[string],
    diagnostics: Vec[Diagnostic],
) -> Vec[CtConstantCandidate] {
    let result: Vec[CtConstantCandidate] = Vec::[];
    for value in file.constants {
        let origin = add_origin(module, "<" + module.package_name + ">", 0, 0);
        let ctx = CtLowerContext {
            package_name: module.package_name,
            file,
            module,
            dependencies,
            constant_names,
            locals: Vec::[],
            local_types: Vec::[],
            next_slot: Ref::new(0),
            loop_targets: Vec::[],
            next_loop: Ref::new(0),
            origin,
            source_path: "<" + module.package_name + ">",
            origin_spans: Vec::[],
            origin_cursor: Ref::new(0),
            derive: false,
        };
        match lower_const_expr(ctx, value.value) {
            Ok(expression) => result.push(
                CtConstantCandidate {
                    name: value.name,
                    ty: value.ty,
                    expression,
                    origin,
                    source_path: "<" + module.package_name + ">",
                    start: 0,
                    end: 0,
                    pending: false,
                },
            ),
            Err(_) => (),
        }
    }
    for value in pending {
        let origin = add_origin(module, value.source_path, value.start, value.end);
        let ctx = CtLowerContext {
            package_name: module.package_name,
            file,
            module,
            dependencies,
            constant_names,
            locals: Vec::[],
            local_types: Vec::[],
            next_slot: Ref::new(0),
            loop_targets: Vec::[],
            next_loop: Ref::new(0),
            origin,
            source_path: value.source_path,
            origin_spans: value.comptime_origins,
            origin_cursor: Ref::new(0),
            derive: false,
        };
        match lower_ct_expr(ctx, value.value) {
            Ok(expression) => result.push(
                CtConstantCandidate {
                    name: value.name,
                    ty: value.ty,
                    expression,
                    origin,
                    source_path: value.source_path,
                    start: value.start,
                    end: value.end,
                    pending: true,
                },
            ),
            Err(message) => diagnostics.push(
                comptime_diagnostic(message, value.source_path, value.start, value.end),
            ),
        }
    }
    result
}

fn evaluate_constants(
    file: File,
    pending: Vec[PendingConstant],
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    constant_names: Vec[string],
    diagnostics: Vec[Diagnostic],
) -> Vec[Constant] {
    let candidates = constant_candidates(
        file,
        pending,
        module,
        dependencies,
        constant_names,
        diagnostics,
    );
    let states: Vec[int] = Vec::[];
    for index in 0..candidates.len() {
        states.push(0);
        module.sites.push(
            ctir::CtSite {
                id: index,
                kind: ctir::CtSiteKind::Constant { name: candidates[index].name },
                local_count: 0,
                local_types: Vec::[],
                expression: candidates[index].expression,
                origin: candidates[index].origin,
            },
        )
    }
    let finalized = file.constants;
    let mut remaining = candidates.len();
    while remaining > 0 {
        let mut progress = false;
        for index in 0..candidates.len() {
            if states[index] == 0 {
                let candidate = candidates[index];
                match ctfe::evaluate_site(module, dependencies, index, ctfe::default_limits()) {
                    Ok(value) => {
                        module.constants.push(ctir::CtConstant { name: candidate.name, value });
                        if candidate.pending {
                            match constant_expr_from_value(value, candidate.ty) {
                                Ok(value) => finalized.push(
                                    Constant { name: candidate.name, ty: candidate.ty, value },
                                ),
                                Err(message) => diagnostics.push(
                                    comptime_diagnostic(
                                        message,
                                        candidate.source_path,
                                        candidate.start,
                                        candidate.end,
                                    ),
                                ),
                            }
                        } else {};
                        states[index] = 1;
                        remaining = remaining - 1;
                        progress = true;
                    },
                    Err(error) => match error.kind {
                        ctfe::CtErrorKind::MissingConstant => (),
                        ctfe::CtErrorKind::Failure => {
                            diagnostics.push(
                                comptime_evaluation_diagnostic(
                                    module,
                                    dependencies,
                                    error,
                                    candidate.source_path,
                                    candidate.start,
                                    candidate.end,
                                ),
                            );
                            states[index] = 2;
                            remaining = remaining - 1;
                            progress = true;
                        },
                    },
                }
            } else {}
        }
        if !progress {
            for index in 0..candidates.len() {
                if states[index] == 0 {
                    let candidate = candidates[index];
                    diagnostics.push(
                        comptime_diagnostic(
                            "Cyclic constant " + short_comptime_name(candidate.name),
                            candidate.source_path,
                            candidate.start,
                            candidate.end,
                        ),
                    );
                    states[index] = 2;
                    remaining = remaining - 1;
                } else {}
            }
        } else {}
    }
    module.sites.truncate(0);
    finalized
}

fn signed_ct_integer(width: int, bits: uint64) -> int64 {
    if width >= 64 {
        bits as int64
    } else {
        let shift = 64 - width;
        ((bits << shift) as int64) >> shift
    }
}

fn reify_integer(value: ctir::CtValue, ty: Type) -> Result[Primitive, string] {
    match value {
        ctir::CtValue::Integer { signed, width, bits } => {
            let text = if signed {
                signed_ct_integer(width, bits).to_string()
            } else {
                bits.to_string()
            };
            Result::Ok(
                match resolve_type(ty) {
                    Type::Int => Primitive::Int { value: text },
                    Type::Int8 => Primitive::Int8 { value: text },
                    Type::Int16 => Primitive::Int16 { value: text },
                    Type::Int32 => Primitive::Int32 { value: text },
                    Type::Int64 => Primitive::Int64 { value: text },
                    Type::Uint => Primitive::Uint { value: text },
                    Type::Uint8 => Primitive::Uint8 { value: text },
                    Type::Uint16 => Primitive::Uint16 { value: text },
                    Type::Uint32 => Primitive::Uint32 { value: text },
                    Type::Uint64 => Primitive::Uint64 { value: text },
                    _ => return Result::Err("comptime integer result type mismatch"),
                },
            )
        },
        _ => Result::Err("comptime value is not an integer"),
    }
}

fn reify_ct_value(file: File, value: ctir::CtValue, ty: Type) -> Result[Expr, string] {
    match value {
        ctir::CtValue::Unit => Result::Ok(Expr::Prim { value: Primitive::Unit, ty }),
        ctir::CtValue::Bool(value) => {
            Result::Ok(Expr::Prim { value: Primitive::Bool { value }, ty })
        },
        ctir::CtValue::Integer { .. } => {
            Result::Ok(Expr::Prim { value: reify_integer(value, ty)?, ty })
        },
        ctir::CtValue::String(value) => {
            Result::Ok(Expr::Prim { value: Primitive::String { value }, ty })
        },
        ctir::CtValue::Char(value) => {
            Result::Ok(Expr::Prim { value: Primitive::Char { value }, ty })
        },
        ctir::CtValue::Tuple(values) => match resolve_type(ty) {
            Type::Tuple { items: types } => {
                let result: Vec[Expr] = Vec::[];
                for index in 0..values.len() {
                    result.push(reify_ct_value(file, values[index], types[index])?)
                }
                Result::Ok(Expr::Tuple { items: result, ty })
            },
            _ => Result::Err("comptime tuple result type mismatch"),
        },
        ctir::CtValue::Array(values) => match resolve_type(ty) {
            Type::Array { len: _, elem } => {
                let result: Vec[Expr] = Vec::[];
                for value in values {
                    result.push(reify_ct_value(file, value, elem)?)
                }
                Result::Ok(Expr::Array { items: result, ty })
            },
            _ => Result::Err("comptime array result type mismatch"),
        },
        ctir::CtValue::Struct { name, fields } => {
            let Some(definition) = find_ct_struct(file, name) else {
                return Result::Err("comptime struct result metadata is missing")
            };
            if definition.has_hidden_fields {
                return Result::Err("comptime cannot reify a struct with hidden fields")
            } else {};
            let type_args = nominal_type_arguments(ty);
            let args: Vec[Expr] = Vec::[];
            for index in 0..fields.len() {
                args.push(
                    reify_ct_value(
                        file,
                        fields[index],
                        substitute_ct_type(
                            definition.fields[index].1,
                            definition.generics,
                            type_args,
                        ),
                    )?,
                )
            }
            let names: Vec[string] = Vec::[];
            for field in definition.fields {
                names.push(field.0)
            }
            Result::Ok(
                Expr::Constr {
                    constructor: Constructor {
                        name,
                        fields: names,
                        is_struct: true,
                        tag: Option::None,
                    },
                    args,
                    ty,
                },
            )
        },
        ctir::CtValue::Enum { name, variant, fields } => {
            let Some(definition) = find_ct_enum(file, name) else {
                return Result::Err("comptime enum result metadata is missing")
            };
            if variant < 0 || variant >= definition.variants.len() {
                return Result::Err("comptime enum result has an invalid variant")
            } else {};
            let selected = definition.variants[variant];
            let type_args = nominal_type_arguments(ty);
            let field_types: Vec[Type] = Vec::[];
            let field_names: Vec[string] = Vec::[];
            let is_struct = match selected.fields {
                EnumVariantFields::Unit => false,
                EnumVariantFields::Tuple(values) => {
                    for value in values {
                        field_types.push(substitute_ct_type(value, definition.generics, type_args))
                    }
                    false
                },
                EnumVariantFields::Struct(values) => {
                    for value in values {
                        field_names.push(value.0);
                        field_types.push(
                            substitute_ct_type(value.1, definition.generics, type_args),
                        )
                    }
                    true
                },
            };
            let args: Vec[Expr] = Vec::[];
            for index in 0..fields.len() {
                args.push(reify_ct_value(file, fields[index], field_types[index])?)
            }
            Result::Ok(
                Expr::Constr {
                    constructor: Constructor {
                        name: definition.name + "::" + selected.name,
                        fields: field_names,
                        is_struct,
                        tag: Option::Some(variant),
                    },
                    args,
                    ty,
                },
            )
        },
        ctir::CtValue::Meta { .. } => {
            Result::Err("derive metadata cannot be reified as a runtime value")
        },
    }
}

fn rewrite_comptime_exprs(
    file: File,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    diagnostics: Vec[Diagnostic],
    next_site: Ref[int],
    values: Vec[Expr],
) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::[];
    for value in values {
        result.push(
            rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, value),
        )
    }
    result
}

fn contains_comptime_exprs(values: Vec[Expr]) -> bool {
    for value in values {
        if contains_comptime_expr(value) {
            return true
        } else {}
    }
    false
}

fn contains_comptime_block(value: Block) -> bool {
    for statement in value.stmts {
        let found = match statement {
            Defer { expr } | Expr { expr } => contains_comptime_expr(expr),
            Let { is_mut: _, pat: _, value } => contains_comptime_expr(value),
            LetElse { is_mut: _, pat: _, value, else_branch } => {
                contains_comptime_expr(value) || contains_comptime_expr(else_branch)
            },
            Assign { target, op: _, value } => {
                contains_comptime_expr(target) || contains_comptime_expr(value)
            },
        };
        if found {
            return true
        } else {}
    }
    match value.tail {
        Some(value) => contains_comptime_expr(value),
        None => false,
    }
}

fn contains_comptime_expr(value: Expr) -> bool {
    match value {
        Comptime { .. } => true,
        Var { .. } | Callable { .. } | Prim { .. } | Continue { .. } => false,
        Constr { args, .. } | Tuple { items: args, .. } | Array { items: args, .. } => {
            contains_comptime_exprs(args)
        },
        Closure { body, .. } => contains_comptime_expr(body),
        Block { block, .. } => contains_comptime_block(block),
        Match { expr, arms, .. } => {
            if contains_comptime_expr(expr) {
                return true
            } else {};
            for arm in arms {
                let guard_found = match arm.guard {
                    Some(value) => contains_comptime_expr(value),
                    None => false,
                };
                if guard_found || contains_comptime_expr(arm.body) {
                    return true
                } else {}
            }
            false
        },
        If { cond, then_branch, else_branch, .. } => {
            contains_comptime_expr(cond) || contains_comptime_expr(then_branch)
                || contains_comptime_expr(else_branch)
        },
        While { cond, body, .. } => {
            contains_comptime_expr(cond) || contains_comptime_expr(body)
        },
        Loop { body, .. } | Go { expr: body, .. } | Unary { expr: body, .. } | Cast {
            expr: body,
            ..,
        } | ToDyn { expr: body, .. } => contains_comptime_expr(body),
        For { iterator, body, .. } => {
            contains_comptime_expr(iterator) || contains_comptime_expr(body)
        },
        Break { value, .. } | Return { expr: value, .. } => match value {
            Some(value) => contains_comptime_expr(value),
            None => false,
        },
        Call { func, args, .. } => {
            contains_comptime_expr(func) || contains_comptime_exprs(args)
        },
        Proj { tuple, .. } => contains_comptime_expr(tuple),
        Field { expr, .. } => contains_comptime_expr(expr),
        Index { base, index, .. } | Binary { lhs: base, rhs: index, .. } => {
            contains_comptime_expr(base) || contains_comptime_expr(index)
        },
    }
}

pub fn contains_comptime(value: File) -> bool {
    for item in value.items {
        match item {
            Item::Function(value) => if contains_comptime_block(value.body) {
                return true
            } else {},
            Item::ImplBlock(value) => for method in value.methods {
                if contains_comptime_block(method.body) {
                    return true
                } else {}
            },
        }
    }
    false
}

fn rewrite_comptime_block(
    file: File,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    diagnostics: Vec[Diagnostic],
    next_site: Ref[int],
    value: Block,
) -> Block {
    let stmts: Vec[Stmt] = Vec::[];
    for statement in value.stmts {
        stmts.push(
            match statement {
                Defer { expr } => Stmt::Defer {
                    expr: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        expr,
                    ),
                },
                Let { is_mut, pat, value } => Stmt::Let {
                    is_mut,
                    pat,
                    value: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        value,
                    ),
                },
                LetElse { is_mut, pat, value, else_branch } => Stmt::LetElse {
                    is_mut,
                    pat,
                    value: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        value,
                    ),
                    else_branch: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        else_branch,
                    ),
                },
                Assign { target, op, value } => Stmt::Assign {
                    target: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        target,
                    ),
                    op,
                    value: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        value,
                    ),
                },
                Expr { expr } => Stmt::Expr {
                    expr: rewrite_comptime_expr(
                        file,
                        module,
                        dependencies,
                        diagnostics,
                        next_site,
                        expr,
                    ),
                },
            },
        )
    }
    Block {
        stmts,
        tail: match value.tail {
            Some(value) => Option::Some(
                rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, value),
            ),
            None => Option::None,
        },
    }
}

fn rewrite_comptime_expr(
    file: File,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    diagnostics: Vec[Diagnostic],
    next_site: Ref[int],
    value: Expr,
) -> Expr {
    match value {
        Comptime { site_id: _, source_path, start, end, origins, body, ty } => {
            let site_id = next_site.get();
            next_site.set(site_id + 1);
            let origin = add_origin(module, source_path, start, end);
            let ctx = CtLowerContext {
                package_name: module.package_name,
                file,
                module,
                dependencies,
                constant_names: comptime_constant_names(file, Vec::[]),
                locals: Vec::[],
                local_types: Vec::[],
                next_slot: Ref::new(0),
                loop_targets: Vec::[],
                next_loop: Ref::new(0),
                origin,
                source_path,
                origin_spans: origins,
                origin_cursor: Ref::new(0),
                derive: false,
            };
            match lower_ct_expr(ctx, body) {
                Ok(expression) => {
                    module.sites.push(
                        ctir::CtSite {
                            id: site_id,
                            kind: ctir::CtSiteKind::Expression,
                            local_count: ctx.next_slot.get(),
                            local_types: ctx.local_types,
                            expression,
                            origin,
                        },
                    );
                    match ctfe::evaluate_site(module, dependencies, site_id, ctfe::default_limits()) {
                        Ok(value) => match reify_ct_value(file, value, ty) {
                            Ok(value) => value,
                            Err(message) => {
                                diagnostics.push(
                                    comptime_diagnostic(message, source_path, start, end),
                                );
                                Expr::Prim { value: Primitive::Unit, ty: Type::Error }
                            },
                        },
                        Err(error) => {
                            diagnostics.push(
                                comptime_evaluation_diagnostic(
                                    module,
                                    dependencies,
                                    error,
                                    source_path,
                                    start,
                                    end,
                                ),
                            );
                            Expr::Prim { value: Primitive::Unit, ty: Type::Error }
                        },
                    }
                },
                Err(message) => {
                    diagnostics.push(comptime_diagnostic(message, source_path, start, end));
                    Expr::Prim { value: Primitive::Unit, ty: Type::Error }
                },
            }
        },
        Var { .. } | Callable { .. } | Prim { .. } => value,
        Constr { constructor, args, ty } => Expr::Constr {
            constructor,
            args: rewrite_comptime_exprs(file, module, dependencies, diagnostics, next_site, args),
            ty,
        },
        Tuple { items, ty } => Expr::Tuple {
            items: rewrite_comptime_exprs(file, module, dependencies, diagnostics, next_site, items),
            ty,
        },
        Array { items, ty } => Expr::Array {
            items: rewrite_comptime_exprs(file, module, dependencies, diagnostics, next_site, items),
            ty,
        },
        Closure { params, body, ty } => Expr::Closure {
            params,
            body: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, body),
            ty,
        },
        Block { block, ty } => Expr::Block {
            block: rewrite_comptime_block(file, module, dependencies, diagnostics, next_site, block),
            ty,
        },
        Match { expr, arms, ty } => {
            let result: Vec[Arm] = Vec::[];
            for arm in arms {
                result.push(
                    Arm {
                        pat: arm.pat,
                        guard: match arm.guard {
                            Some(value) => Option::Some(
                                rewrite_comptime_expr(
                                    file,
                                    module,
                                    dependencies,
                                    diagnostics,
                                    next_site,
                                    value,
                                ),
                            ),
                            None => Option::None,
                        },
                        body: rewrite_comptime_expr(
                            file,
                            module,
                            dependencies,
                            diagnostics,
                            next_site,
                            arm.body,
                        ),
                    },
                )
            }
            Expr::Match {
                expr: rewrite_comptime_expr(
                    file,
                    module,
                    dependencies,
                    diagnostics,
                    next_site,
                    expr,
                ),
                arms: result,
                ty,
            }
        },
        If { cond, then_branch, else_branch, ty } => Expr::If {
            cond: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, cond),
            then_branch: rewrite_comptime_expr(
                file,
                module,
                dependencies,
                diagnostics,
                next_site,
                then_branch,
            ),
            else_branch: rewrite_comptime_expr(
                file,
                module,
                dependencies,
                diagnostics,
                next_site,
                else_branch,
            ),
            ty,
        },
        While { cond, body, ty } => Expr::While {
            cond: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, cond),
            body: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, body),
            ty,
        },
        Loop { body, ty } => Expr::Loop {
            body: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, body),
            ty,
        },
        For { pat, iterator, into_iter_trait_ref, iterator_trait_ref, iterator_ty, body, ty } => {
            Expr::For {
                pat,
                iterator: rewrite_comptime_expr(
                    file,
                    module,
                    dependencies,
                    diagnostics,
                    next_site,
                    iterator,
                ),
                into_iter_trait_ref,
                iterator_trait_ref,
                iterator_ty,
                body: rewrite_comptime_expr(
                    file,
                    module,
                    dependencies,
                    diagnostics,
                    next_site,
                    body,
                ),
                ty,
            }
        },
        Break { target, value, ty } => Expr::Break {
            target,
            value: match value {
                Some(value) => Option::Some(
                    rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, value),
                ),
                None => Option::None,
            },
            ty,
        },
        Continue { .. } => value,
        Return { expr, ty } => Expr::Return {
            expr: match expr {
                Some(value) => Option::Some(
                    rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, value),
                ),
                None => Option::None,
            },
            ty,
        },
        Go { expr, ty } => Expr::Go {
            expr: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, expr),
            ty,
        },
        Call { func, args, ty } => Expr::Call {
            func: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, func),
            args: rewrite_comptime_exprs(file, module, dependencies, diagnostics, next_site, args),
            ty,
        },
        Unary { op, expr, ty } => Expr::Unary {
            op,
            expr: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, expr),
            ty,
        },
        Cast { expr, ty } => Expr::Cast {
            expr: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, expr),
            ty,
        },
        Proj { tuple, index, ty } => Expr::Proj {
            tuple: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, tuple),
            index,
            ty,
        },
        Field { expr, field_name, ty } => Expr::Field {
            expr: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, expr),
            field_name,
            ty,
        },
        Index { base, index, ty } => Expr::Index {
            base: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, base),
            index: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, index),
            ty,
        },
        Binary { op, lhs, rhs, ty, resolution } => Expr::Binary {
            op,
            lhs: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, lhs),
            rhs: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, rhs),
            ty,
            resolution,
        },
        ToDyn { trait_name, for_ty, expr, ty } => Expr::ToDyn {
            trait_name,
            for_ty,
            expr: rewrite_comptime_expr(file, module, dependencies, diagnostics, next_site, expr),
            ty,
        },
    }
}

pub fn finalize_comptime(
    file: File,
    pending_constants: Vec[PendingConstant],
    package_name: string,
    dependencies: Vec[ctir::CtModule],
    dependency_enums: Vec[EnumDef],
    dependency_structs: Vec[StructDef],
) -> ComptimeFinalizeResult {
    let diagnostics: Vec[Diagnostic] = Vec::[];
    let metadata_enums: Vec[EnumDef] = Vec::[];
    for value in file.enums {
        metadata_enums.push(value)
    }
    for value in dependency_enums {
        metadata_enums.push(value)
    }
    let metadata_structs: Vec[StructDef] = Vec::[];
    for value in file.structs {
        metadata_structs.push(value)
    }
    for value in dependency_structs {
        metadata_structs.push(value)
    }
    let metadata_file = File {
        items: file.items,
        enums: metadata_enums,
        structs: metadata_structs,
        constants: file.constants,
    };
    let constant_names = comptime_constant_names(metadata_file, pending_constants);
    let module = build_comptime_module(
        metadata_file,
        constant_names,
        package_name,
        dependencies,
        diagnostics,
    );
    let constants = evaluate_constants(
        metadata_file,
        pending_constants,
        module,
        dependencies,
        constant_names,
        diagnostics,
    );
    let items: Vec[Item] = Vec::[];
    let next_site = Ref::new(0);
    for item in file.items {
        items.push(
            match item {
                Item::Function(value) => Item::Function(
                    Function {
                        visibility: value.visibility,
                        name: value.name,
                        comptime: value.comptime,
                        source_path: value.source_path,
                        start: value.start,
                        end: value.end,
                        comptime_origins: value.comptime_origins,
                        generics: value.generics,
                        predicates: value.predicates,
                        params: value.params,
                        ret_ty: value.ret_ty,
                        body: rewrite_comptime_block(
                            metadata_file,
                            module,
                            dependencies,
                            diagnostics,
                            next_site,
                            value.body,
                        ),
                    },
                ),
                Item::ImplBlock(value) => {
                    let methods: Vec[Function] = Vec::[];
                    for method in value.methods {
                        methods.push(
                            Function {
                                visibility: method.visibility,
                                name: method.name,
                                comptime: method.comptime,
                                source_path: method.source_path,
                                start: method.start,
                                end: method.end,
                                comptime_origins: method.comptime_origins,
                                generics: method.generics,
                                predicates: method.predicates,
                                params: method.params,
                                ret_ty: method.ret_ty,
                                body: rewrite_comptime_block(
                                    metadata_file,
                                    module,
                                    dependencies,
                                    diagnostics,
                                    next_site,
                                    method.body,
                                ),
                            },
                        )
                    }
                    Item::ImplBlock(
                        ImplBlock {
                            generics: value.generics,
                            predicates: value.predicates,
                            trait_ref: value.trait_ref,
                            for_type: value.for_type,
                            associated_types: value.associated_types,
                            methods,
                        },
                    )
                },
            },
        )
    }
    if diagnostics.is_empty() {
        match ctfe::verify_module(module, dependencies) {
            Ok(()) => (),
            Err(message) => diagnostics.push(
                comptime_diagnostic(message, "<" + package_name + ">", 0, 0),
            ),
        }
    } else {};
    module.sites.truncate(0);
    let finalized_file = File { items, enums: file.enums, structs: file.structs, constants };
    if contains_comptime(finalized_file) {
        diagnostics.push(
            comptime_diagnostic(
                "comptime finalization did not eliminate every comptime expression",
                "<" + package_name + ">",
                0,
                0,
            ),
        )
    } else {};
    ComptimeFinalizeResult { file: finalized_file, module, diagnostics }
}
