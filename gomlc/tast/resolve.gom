package tast;

use gomlc::ast;
use gomlc::hir;
use std::collections;
use std::text;

struct ResolvedConstructor {
    constructor: Constructor,
    fields: Vec[Type],
    ty: Type,
    named: bool,
}

struct ResolvedStruct {
    constructor: Constructor,
    fields: Vec[(string, Type)],
    ty: Type,
    has_hidden_fields: bool,
}

enum NamedFieldConstructorResolution {
    Found(ResolvedStruct),
    WrongStyle,
    Ambiguous,
    Missing,
}

struct ResolvedCallable {
    callable: Callable,
    ty: Type,
    predicates: Vec[TypePredicate],
}

struct MethodCandidate {
    owner: Type,
    callable: ResolvedCallable,
    owner_predicates: Vec[TypePredicate],
}

fn short_name(value: string) -> string {
    match text::rfind(value, "::") {
        Some(index) => value.byte_slice(index + 2, value.byte_len()),
        None => value,
    }
}

fn names_match(left: string, right: string) -> bool {
    left == right || (!left.contains("::") && short_name(left) == short_name(right))
        || (!right.contains("::") && short_name(left) == short_name(right))
}

fn add_name_index(
    exact: HashMap[string, int],
    short: HashMap[string, int],
    name: string,
    index: int,
) -> unit {
    exact[name] = index;
    let short_name = short_name(name);
    match short[short_name] {
        Some(_) => short.set(short_name, -1),
        None => short.set(short_name, index),
    }
}

fn enum_name_index(values: Vec[EnumInfo], short: bool) -> HashMap[string, int] {
    let result: HashMap[string, int] = HashMap::{};
    for index in 0..values.len() {
        let name = if short {
            short_name(values[index].name)
        } else {
            values[index].name
        };
        match result[name] {
            Some(_) => if short {
                result[name] = -1;
            } else {
                result[name] = index;
            },
            None => result.set(name, index),
        }
    };
    result
}

fn index_enum_name(ctx: Checker, value: EnumInfo, index: int) -> unit {
    add_name_index(ctx.enum_names, ctx.enum_short_names, value.name, index)
}

fn index_struct_name(ctx: Checker, value: StructInfo, index: int) -> unit {
    add_name_index(ctx.struct_names, ctx.struct_short_names, value.name, index)
}

fn struct_name_index(values: Vec[StructInfo], short: bool) -> HashMap[string, int] {
    let result: HashMap[string, int] = HashMap::{};
    for index in 0..values.len() {
        let name = if short {
            short_name(values[index].name)
        } else {
            values[index].name
        };
        match result[name] {
            Some(_) => if short {
                result[name] = -1;
            } else {
                result[name] = index;
            },
            None => result.set(name, index),
        }
    };
    result
}

fn find_enum_by_def(ctx: Checker, id: hir::DefId) -> Option[EnumInfo] {
    for value in ctx.enums {
        if same_def(value.def_id, id) {
            return Option::Some(value)
        } else {
            ()
        }
    };
    Option::None
}

fn find_enum_by_name(ctx: Checker, name: string) -> Option[EnumInfo] {
    match ctx.enum_names[name] {
        Some(index) => Option::Some(ctx.enums[index]),
        None => match ctx.enum_short_names[short_name(name)] {
            Some(index) => if index >= 0 {
                Option::Some(ctx.enums[index])
            } else {
                Option::None
            },
            None => Option::None,
        },
    }
}

fn find_enum_by_exact_name(ctx: Checker, name: string) -> Option[EnumInfo] {
    for value in ctx.enums {
        if value.name == name {
            return Option::Some(value)
        } else {
            ()
        }
    };
    Option::None
}

fn find_struct_by_name(ctx: Checker, name: string) -> Option[StructInfo] {
    match ctx.struct_names[name] {
        Some(index) => Option::Some(ctx.structs[index]),
        None => match ctx.struct_short_names[short_name(name)] {
            Some(index) => if index >= 0 {
                Option::Some(ctx.structs[index])
            } else {
                Option::None
            },
            None => Option::None,
        },
    }
}

fn find_struct_by_exact_name(ctx: Checker, name: string) -> Option[StructInfo] {
    for value in ctx.structs {
        if value.name == name {
            return Option::Some(value)
        } else {
            ()
        }
    };
    Option::None
}

fn find_expected_enum(ctx: Checker, name: string) -> Option[EnumInfo] {
    match find_enum_by_exact_name(ctx, name) {
        Some(value) => Option::Some(value),
        None => match find_struct_by_exact_name(ctx, name) {
            Some(_) => Option::None,
            None => find_enum_by_name(ctx, name),
        },
    }
}

fn find_expected_struct(ctx: Checker, name: string) -> Option[StructInfo] {
    match find_struct_by_exact_name(ctx, name) {
        Some(value) => Option::Some(value),
        None => match find_enum_by_exact_name(ctx, name) {
            Some(_) => Option::None,
            None => find_struct_by_name(ctx, name),
        },
    }
}

fn pattern_owner_is_builtin_enum(ctx: Checker, name: string) -> bool {
    (name == "Option" || name == "Result") && find_enum_by_exact_name(ctx, name).is_none()
        && find_struct_by_exact_name(ctx, name).is_none()
}

fn nominal_type_is_defined(ctx: Checker, name: string) -> bool {
    find_struct_by_name(ctx, name).is_some() || find_enum_by_name(ctx, name).is_some()
}

fn find_variant(value: EnumInfo, index: int) -> Option[EnumVariantInfo] {
    if index >= 0 && index < value.variants.len() {
        Option::Some(value.variants[index])
    } else {
        Option::None
    }
}

fn instantiate_enum(ctx: Checker, value: EnumInfo) -> (Type, Vec[TypeSubst]) {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, Vec::[]);
    let args: Vec[Type] = Vec::[];
    for generic in value.generics {
        match find_substitution(substitutions, generic) {
            Some(ty) => args.push(ty),
            None => (),
        }
    };
    (nominal_type(value.name, args), substitutions)
}

fn resolve_user_constructor(ctx: Checker, value: EnumInfo, variant_index: int) -> Option[
    ResolvedConstructor,
] {
    match find_variant(value, variant_index) {
        Some(variant) => {
            let (ty, substitutions) = instantiate_enum(ctx, value);
            let fields: Vec[Type] = Vec::[];
            for field in enum_variant_field_types(variant.fields) {
                fields.push(substitute_type(field, substitutions))
            };
            Option::Some(
                ResolvedConstructor {
                    constructor: Constructor {
                        name: f"{value.name}::{variant.name}",
                        fields: Vec::[],
                        is_struct: false,
                        tag: Option::Some(variant_index),
                    },
                    fields,
                    ty,
                    named: match variant.fields {
                        Struct(_) => true,
                        _ => false,
                    },
                },
            )
        },
        None => Option::None,
    }
}

fn resolve_named_constructor(ctx: Checker, enum_name: string, variant_name: string) -> Option[
    ResolvedConstructor,
] {
    match find_enum_by_name(ctx, enum_name) {
        Some(value) => {
            for index in 0..value.variants.len() {
                if value.variants[index].name == variant_name {
                    return resolve_user_constructor(ctx, value, index)
                } else {
                    ()
                }
            };
            Option::None
        },
        None => Option::None,
    }
}

fn split_constructor_name(value: string) -> Option[(string, string)] {
    match text::rfind(value, "::") {
        Some(index) => if index > 0 && index + 2 < value.byte_len() {
            Option::Some(
                (value.byte_slice(0, index), value.byte_slice(index + 2, value.byte_len())),
            )
        } else {
            Option::None
        },
        None => Option::None,
    }
}

fn resolve_builtin_constructor(ctx: Checker, name: string) -> Option[ResolvedConstructor] {
    let t = fresh_type(ctx.counter, VarKind::Any);
    let e = fresh_type(ctx.counter, VarKind::Any);
    let fields: Vec[Type] = Vec::[];
    let ty = if name == "Option::None" {
        nominal_type("Option", one_type(t))
    } else if name == "Option::Some" {
        fields.push(t);
        nominal_type("Option", one_type(t))
    } else if name == "Result::Ok" {
        fields.push(t);
        nominal_type("Result", two_types(t, e))
    } else if name == "Result::Err" {
        fields.push(e);
        nominal_type("Result", two_types(t, e))
    } else {
        Type::Error
    };
    if name == "Option::None" || name == "Option::Some" || name == "Result::Ok"
        || name == "Result::Err" {
        Option::Some(
            ResolvedConstructor {
                constructor: Constructor {
                    name,
                    fields: Vec::[],
                    is_struct: false,
                    tag: if name == "Option::None" || name == "Result::Ok" {
                        Option::Some(0)
                    } else {
                        Option::Some(1)
                    },
                },
                fields,
                ty,
                named: false,
            },
        )
    } else {
        Option::None
    }
}

fn resolve_constructor(ctx: Checker, value: hir::ConstructorRef) -> Option[ResolvedConstructor] {
    match value {
        Resolved { enum_def: id, variant_index: variant } => match find_enum_by_def(ctx, id) {
            Some(info) => resolve_user_constructor(ctx, info, variant),
            None => Option::None,
        },
        Unresolved(name) => match resolve_builtin_constructor(ctx, name) {
            Some(value) => Option::Some(value),
            None => match split_constructor_name(name) {
                Some(parts) => resolve_named_constructor(ctx, parts.0, parts.1),
                None => Option::None,
            },
        },
    }
}

fn pattern_head_span(value: hir::PatternHead) -> ast::Span {
    match value {
        Resolved { enum_def: _, variant_index: _, span } | Qualified { name: _, span } | Contextual {
            name: _,
            span,
        } => span,
    }
}

fn pattern_head_name(ctx: Checker, value: hir::PatternHead) -> string {
    match value {
        Resolved { enum_def, variant_index, span: _ } => match find_enum_by_def(ctx, enum_def) {
            Some(info) => match find_variant(info, variant_index) {
                Some(variant) => f"{info.name}::{variant.name}",
                None => "<resolved>",
            },
            None => "<resolved>",
        },
        Qualified { name, span: _ } | Contextual { name, span: _ } => name,
    }
}

fn normalized_pattern_expected(ctx: Checker, expected: Type) -> Type {
    normalize_type(ctx, expand_type_aliases(ctx, expected, false))
}

fn pattern_expected_owner(ctx: Checker, expected: Type) -> Option[string] {
    type_constructor_name(normalized_pattern_expected(ctx, expected))
}

fn resolve_contextual_constructor(ctx: Checker, name: string, expected: Type) -> Option[
    ResolvedConstructor,
] {
    match pattern_expected_owner(ctx, expected) {
        Some(owner) => match find_expected_enum(ctx, owner) {
            Some(value) => {
                for index in 0..value.variants.len() {
                    if value.variants[index].name == name {
                        return resolve_user_constructor(ctx, value, index)
                    } else {
                        ()
                    }
                };
                Option::None
            },
            None => if pattern_owner_is_builtin_enum(ctx, owner) {
                resolve_builtin_constructor(ctx, f"{owner}::{name}")
            } else {
                Option::None
            },
        },
        None => Option::None,
    }
}

fn resolve_pattern_constructor(ctx: Checker, head: hir::PatternHead, expected: Type) -> Option[
    ResolvedConstructor,
] {
    match head {
        Resolved { enum_def, variant_index, span: _ } => resolve_constructor(
            ctx,
            hir::ConstructorRef::Resolved { enum_def, variant_index },
        ),
        Qualified { name, span: _ } => {
            resolve_constructor(ctx, hir::ConstructorRef::Unresolved(name))
        },
        Contextual { name, span: _ } => {
            resolve_contextual_constructor(ctx, name, expected)
        },
    }
}

fn instantiate_struct(ctx: Checker, value: StructInfo) -> ResolvedStruct {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, Vec::[]);
    let args: Vec[Type] = Vec::[];
    for generic in value.generics {
        match find_substitution(substitutions, generic) {
            Some(ty) => args.push(ty),
            None => (),
        }
    };
    let fields: Vec[(string, Type)] = Vec::[];
    let names: Vec[string] = Vec::[];
    for field in value.fields {
        fields.push((field.0, substitute_type(field.1, substitutions)));
        names.push(field.0)
    };
    ResolvedStruct {
        constructor: Constructor {
            name: value.name,
            fields: names,
            is_struct: true,
            tag: Option::None,
        },
        fields,
        ty: nominal_type(value.name, args),
        has_hidden_fields: value.has_hidden_fields,
    }
}

fn resolve_struct(ctx: Checker, name: string) -> Option[ResolvedStruct] {
    match find_struct_by_name(ctx, name) {
        Some(value) => Option::Some(instantiate_struct(ctx, value)),
        None => Option::None,
    }
}

fn instantiate_named_variant(
    ctx: Checker,
    value: EnumInfo,
    variant_index: int,
    named: Vec[(string, Type)],
) -> ResolvedStruct {
    let (ty, substitutions) = instantiate_enum(ctx, value);
    let fields: Vec[(string, Type)] = Vec::[];
    let names: Vec[string] = Vec::[];
    for field in named {
        fields.push((field.0, substitute_type(field.1, substitutions)));
        names.push(field.0)
    };
    let variant = value.variants[variant_index];
    ResolvedStruct {
        constructor: Constructor {
            name: f"{value.name}::{variant.name}",
            fields: names,
            is_struct: false,
            tag: Option::Some(variant_index),
        },
        fields,
        ty,
        has_hidden_fields: false,
    }
}

fn resolve_named_variant_in(ctx: Checker, value: EnumInfo, variant_name: string) -> NamedFieldConstructorResolution {
    for index in 0..value.variants.len() {
        let variant = value.variants[index];
        if variant.name == variant_name {
            return match enum_variant_named_fields(variant.fields) {
                Some(fields) => NamedFieldConstructorResolution::Found(
                    instantiate_named_variant(ctx, value, index, fields),
                ),
                None => NamedFieldConstructorResolution::WrongStyle,
            }
        } else {
            ()
        }
    };
    NamedFieldConstructorResolution::Missing
}

fn resolve_named_variant_at(ctx: Checker, value: EnumInfo, variant_index: int) -> NamedFieldConstructorResolution {
    match find_variant(value, variant_index) {
        Some(variant) => match enum_variant_named_fields(variant.fields) {
            Some(fields) => NamedFieldConstructorResolution::Found(
                instantiate_named_variant(ctx, value, variant_index, fields),
            ),
            None => NamedFieldConstructorResolution::WrongStyle,
        },
        None => NamedFieldConstructorResolution::Missing,
    }
}

fn resolve_named_field_constructor(ctx: Checker, name: string) -> NamedFieldConstructorResolution {
    match split_constructor_name(name) {
        Some(parts) => match find_enum_by_name(ctx, parts.0) {
            Some(value) => match resolve_named_variant_in(ctx, value, parts.1) {
                Missing => (),
                result => return result,
            },
            None => (),
        },
        None => (),
    };
    match resolve_struct(ctx, name) {
        Some(value) => return NamedFieldConstructorResolution::Found(value),
        None => (),
    };
    let candidates: Vec[(EnumInfo, int)] = Vec::[];
    for value in ctx.enums {
        for index in 0..value.variants.len() {
            if value.variants[index].name == name {
                candidates.push((value, index))
            } else {
                ()
            }
        }
    };
    if candidates.len() > 1 {
        NamedFieldConstructorResolution::Ambiguous
    } else if candidates.is_empty() {
        NamedFieldConstructorResolution::Missing
    } else {
        let candidate = candidates[0];
        let value = candidate.0;
        let variant = value.variants[candidate.1];
        match enum_variant_named_fields(variant.fields) {
            Some(fields) => NamedFieldConstructorResolution::Found(
                instantiate_named_variant(ctx, value, candidate.1, fields),
            ),
            None => NamedFieldConstructorResolution::WrongStyle,
        }
    }
}

fn resolve_contextual_named_field_constructor(ctx: Checker, name: string, expected: Type) -> NamedFieldConstructorResolution {
    match pattern_expected_owner(ctx, expected) {
        Some(owner) => match find_expected_enum(ctx, owner) {
            Some(value) => resolve_named_variant_in(ctx, value, name),
            None => match find_expected_struct(ctx, owner) {
                Some(value) => if names_match(value.name, name) {
                    NamedFieldConstructorResolution::Found(instantiate_struct(ctx, value))
                } else {
                    NamedFieldConstructorResolution::Missing
                },
                None => NamedFieldConstructorResolution::Missing,
            },
        },
        None => NamedFieldConstructorResolution::Missing,
    }
}

fn resolve_pattern_named_field_constructor(ctx: Checker, head: hir::PatternHead, expected: Type) -> NamedFieldConstructorResolution {
    match head {
        Resolved { enum_def, variant_index, span: _ } => match find_enum_by_def(ctx, enum_def) {
            Some(value) => {
                resolve_named_variant_at(ctx, value, variant_index)
            },
            None => NamedFieldConstructorResolution::Missing,
        },
        Qualified { name, span: _ } => {
            resolve_named_field_constructor(ctx, name)
        },
        Contextual { name, span: _ } => {
            resolve_contextual_named_field_constructor(ctx, name, expected)
        },
    }
}

fn nominal_arguments(value: Type) -> Vec[Type] {
    match prune(value) {
        App { ty: _, args } => args,
        VecType { elem } | Slice { elem } | RefType { elem } | Channel { elem } => one_type(elem),
        HashMap { key, value: item } => two_types(key, item),
        _ => Vec::[],
    }
}

fn substitutions_for_nominal(params: Vec[string], value: Type) -> Vec[TypeSubst] {
    let args = nominal_arguments(value);
    let result: Vec[TypeSubst] = Vec::[];
    for index in 0..params.len() {
        if index < args.len() {
            result.push(TypeSubst { name: params[index], ty: args[index] })
        } else {
            ()
        }
    };
    result
}

fn resolve_field_type(ctx: Checker, receiver: Type, name: string) -> Option[Type] {
    let receiver = normalize_type(ctx, receiver);
    match type_constructor_name(receiver) {
        Some(owner) => match find_struct_by_name(ctx, owner) {
            Some(info) => {
                let substitutions = substitutions_for_nominal(info.generics, receiver);
                for offset in 0..info.fields.len() {
                    let field = info.fields[info.fields.len() - 1 - offset];
                    if field.0 == name {
                        return Option::Some(substitute_type(field.1, substitutions))
                    } else {
                        ()
                    }
                };
                Option::None
            },
            None => Option::None,
        },
        None => Option::None,
    }
}

fn find_named_field(values: Vec[(string, hir::Expr)], name: string) -> Option[hir::Expr] {
    for offset in 0..values.len() {
        let value = values[values.len() - 1 - offset];
        if value.0 == name {
            return Option::Some(value.1)
        } else {
            ()
        }
    };
    Option::None
}

fn find_named_pattern(values: Vec[(string, hir::Pat)], name: string) -> Option[hir::Pat] {
    for value in values {
        if value.0 == name {
            return Option::Some(value.1)
        } else {
            ()
        }
    };
    Option::None
}

fn receiver_matches(owner: Type, receiver: Type) -> bool {
    match prune(owner) {
        Param { name: _ } | Var(_) => true,
        owner => match (type_constructor_name(owner), type_constructor_name(receiver)) {
            (Some(first), Some(second)) => names_match(first, second),
            _ => false,
        },
    }
}

fn call_type_lists_compatible(left: Vec[Type], right: Vec[Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if !call_types_compatible(left[index], right[index]) {
                return false
            } else {
                ()
            }
        };
        true
    }
}

fn variable_accepts_type(variable: Ref[TypeVar], value: Type) -> bool {
    match variable.get() {
        Link(inner) => call_types_compatible(inner, value),
        Unbound { id: _, kind } => match prune(value) {
            Var(other) => match other.get() {
                Link(inner) => variable_accepts_type(variable, inner),
                Unbound { id: _, kind: other_kind } => merge_var_kind(kind, other_kind).is_some(),
            },
            Param { name: _ } | Projection { for_ty: _, name: _, trait_ref: _ } => true,
            other => kind_accepts(kind, other),
        },
    }
}

fn call_types_compatible(left: Type, right: Type) -> bool {
    match (prune(left), prune(right)) {
        (Error, _) | (_, Error) => true,
        (Var(variable), value) => variable_accepts_type(variable, value),
        (value, Var(variable)) => variable_accepts_type(variable, value),
        (Param { name: _ }, _) | (_, Param { name: _ }) => true,
        (Projection { for_ty: _, name: _, trait_ref: _ }, _) | (
            _,
            Projection { for_ty: _, name: _, trait_ref: _ },
        ) => true,
        (Unit, Unit) | (Bool, Bool) | (Int, Int) | (Int8, Int8) | (Int16, Int16) | (Int32, Int32) | (
            Int64,
            Int64,
        ) | (Uint, Uint) | (Uint8, Uint8) | (Uint16, Uint16) | (Uint32, Uint32) | (Uint64, Uint64) | (
            Float32,
            Float32,
        ) | (Float64, Float64) | (String, String) | (Char, Char) => true,
        (Tuple { items: left }, Tuple { items: right }) => {
            call_type_lists_compatible(left, right)
        },
        (Con { name: left }, Con { name: right }) | (
            Dyn { trait_name: left },
            Dyn { trait_name: right },
        ) => {
            names_match(left, right)
        },
        (App { ty: left_base, args: left_args }, App { ty: right_base, args: right_args }) => {
            call_types_compatible(left_base, right_base)
                && call_type_lists_compatible(left_args, right_args)
        },
        (Array { len: left_len, elem: left_elem }, Array { len: right_len, elem: right_elem }) => {
            (left_len < 0 || right_len < 0 || left_len == right_len)
                && call_types_compatible(left_elem, right_elem)
        },
        (Slice { elem: left }, Slice { elem: right }) | (
            VecType { elem: left },
            VecType { elem: right },
        ) | (RefType { elem: left }, RefType { elem: right }) | (
            Channel { elem: left },
            Channel { elem: right },
        ) => {
            call_types_compatible(left, right)
        },
        (
            HashMap { key: left_key, value: left_value },
            HashMap { key: right_key, value: right_value },
        ) => {
            call_types_compatible(left_key, right_key)
                && call_types_compatible(left_value, right_value)
        },
        (
            Func { params: left_params, ret_ty: left_ret },
            Func { params: right_params, ret_ty: right_ret },
        ) => {
            call_type_lists_compatible(left_params, right_params)
                && call_types_compatible(left_ret, right_ret)
        },
        _ => false,
    }
}

fn append_type_substitutions(first: Vec[TypeSubst], second: Vec[TypeSubst]) -> Vec[TypeSubst] {
    let result = first;
    for substitution in second {
        result.push(substitution)
    };
    result
}

fn validate_explicit_method_type_arguments(
    ctx: Checker,
    name: string,
    label: string,
    params: Vec[string],
    explicit: Vec[Type],
) -> unit {
    if !explicit.is_empty() && explicit.len() != params.len() {
        push_diagnostic(
            ctx,
            f"Method {name} expects {params.len()} {label} type arguments, but got {explicit.len()}",
        )
    } else {
        ()
    }
}

fn method_substitutions(
    ctx: Checker,
    value: MethodInfo,
    owner_explicit: Vec[Type],
    method_explicit: Vec[Type],
) -> Vec[TypeSubst] {
    validate_explicit_method_type_arguments(
        ctx,
        value.function.name,
        "owner",
        value.owner_generics,
        owner_explicit,
    );
    validate_explicit_method_type_arguments(
        ctx,
        value.function.name,
        "method",
        value.method_generics,
        method_explicit,
    );
    append_type_substitutions(
        instantiate_substitutions(ctx.counter, value.owner_generics, owner_explicit),
        instantiate_substitutions(ctx.counter, value.method_generics, method_explicit),
    )
}

fn instantiate_method_candidate(
    ctx: Checker,
    value: MethodInfo,
    owner_explicit: Vec[Type],
    method_explicit: Vec[Type],
) -> MethodCandidate {
    let substitutions = method_substitutions(ctx, value, owner_explicit, method_explicit);
    let predicates = substitute_predicates(value.function.predicates, substitutions);
    let owner_declared: Vec[TypePredicate] = Vec::[];
    let method_declared: Vec[TypePredicate] = Vec::[];
    for index in 0..predicates.len() {
        if index < value.owner_predicate_count {
            owner_declared.push(predicates[index])
        } else {
            method_declared.push(predicates[index])
        }
    };
    let owner_predicates = expand_implied_predicates(ctx, owner_declared);
    let method_predicates = expand_implied_predicates(ctx, method_declared);
    apply_predicate_equalities(owner_predicates);
    apply_predicate_equalities(method_predicates);
    let owner = substitute_type(value.for_type, substitutions);
    let params: Vec[Type] = Vec::[];
    for param in value.function.params {
        params.push(substitute_type(param, substitutions))
    };
    MethodCandidate {
        owner,
        callable: ResolvedCallable {
            callable: substitute_callable(value.function.callable, substitutions),
            ty: Type::Func { params, ret_ty: substitute_type(value.function.ret_ty, substitutions) },
            predicates: method_predicates,
        },
        owner_predicates,
    }
}

fn resolve_user_method(
    ctx: Checker,
    receiver: Type,
    name: string,
    trait_name: Option[string],
    allow_bare_owner: bool,
    owner_explicit: Vec[Type],
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    for value in ctx.methods {
        let trait_matches = match (trait_name, value.trait_ref) {
            (Some(expected), Some(reference)) => {
                names_match(expected, reference.name)
            },
            (None, _) => true,
            _ => false,
        };
        if trait_matches && value.function.name == name
            && receiver_matches(value.for_type, receiver) {
            let candidate = instantiate_method_candidate(
                ctx,
                value,
                owner_explicit,
                method_explicit,
            );
            if (allow_bare_owner && !value.owner_generics.is_empty()
                && match prune(receiver) {
                    Con { name: _ } => true,
                    _ => false,
                })
                || unify(candidate.owner, receiver) {
                return Option::Some(
                    ResolvedCallable {
                        callable: candidate.callable.callable,
                        ty: candidate.callable.ty,
                        predicates: append_predicates(
                            candidate.owner_predicates,
                            candidate.callable.predicates,
                        ),
                    },
                )
            } else {
                ()
            }
        } else {
            ()
        }
    };
    Option::None
}

fn method_matches_call(
    ctx: Checker,
    value: ResolvedCallable,
    receiver: Type,
    args: Vec[Type],
    expected: Option[Type],
) -> bool {
    match prune(value.ty) {
        Func { params, ret_ty } => if params.len() == args.len() + 1 {
            let mut matches = call_types_compatible(
                normalize_type(ctx, params[0]),
                normalize_type(ctx, receiver),
            );
            for index in 0..args.len() {
                if !call_types_compatible(
                    normalize_type(ctx, params[index + 1]),
                    normalize_type(ctx, args[index]),
                ) {
                    matches = false;
                } else {
                    ()
                }
            };
            match expected {
                Some(ty) => if !call_types_compatible(
                    normalize_type(ctx, ret_ty),
                    normalize_type(ctx, ty),
                ) {
                    matches = false;
                } else {
                    ()
                },
                None => (),
            };
            matches
        } else {
            false
        },
        _ => false,
    }
}

fn context_trait_bound_satisfied(ctx: Checker, bound_ty: Type, reference: TraitRef) -> bool {
    let bound_ty = normalize_type(ctx, bound_ty);
    let reference = normalize_trait_ref(ctx, reference);
    for predicate in ctx.predicates {
        match predicate {
            Trait { for_ty: candidate_ty, trait_ref: candidate_ref } => {
                if types_equal(normalize_type(ctx, candidate_ty), bound_ty)
                    && trait_ref_equal(normalize_trait_ref(ctx, candidate_ref), reference) {
                    return true
                } else {
                    ()
                }
            },
            Equality { lhs: _, rhs: _ } => (),
        }
    };
    false
}

fn predicates_satisfied_at(ctx: Checker, predicates: Vec[TypePredicate], goals: Vec[string]) -> bool {
    for predicate in predicates {
        match predicate {
            Trait { for_ty: bound_ty, trait_ref: reference } => {
                if !trait_bound_satisfied_at(ctx, bound_ty, reference, goals) {
                    return false
                } else {
                    ()
                }
            },
            Equality { lhs: left, rhs: right } => {
                if !unify(normalize_type(ctx, left), normalize_type(ctx, right)) {
                    return false
                } else {
                    ()
                }
            },
        }
    };
    true
}

fn require_predicates(ctx: Checker, predicates: Vec[TypePredicate]) -> unit {
    for predicate in predicates {
        ctx.required_predicates.push(
            PredicateRequirement {
                predicate,
                message: "type predicate not satisfied",
                span: ctx.current_span.get(),
            },
        )
    }
}

fn require_predicate(ctx: Checker, predicate: TypePredicate, message: string) -> unit {
    ctx.required_predicates.push(
        PredicateRequirement { predicate, message, span: ctx.current_span.get() },
    )
}

fn contains_unbound_any_variable(value: Type) -> bool {
    match prune(value) {
        Var(variable) => match variable.get() {
            Unbound { id: _, kind: Any } => true,
            Unbound { id: _, kind: _ } => false,
            Link(inner) => contains_unbound_any_variable(inner),
        },
        Tuple { items: values } => {
            for value in values {
                if contains_unbound_any_variable(value) {
                    return true
                } else {
                    ()
                }
            };
            false
        },
        Projection { for_ty: base, name: _, trait_ref: reference } => {
            if contains_unbound_any_variable(base) {
                true
            } else {
                match reference {
                    Some(reference) => for value in reference.args {
                        if contains_unbound_any_variable(value) {
                            return true
                        } else {
                            ()
                        }
                    },
                    None => (),
                };
                false
            }
        },
        App { ty: base, args } => {
            if contains_unbound_any_variable(base) {
                true
            } else {
                for value in args {
                    if contains_unbound_any_variable(value) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        Array { len: _, elem } | Slice { elem } | VecType { elem } | RefType { elem } | Channel {
            elem,
        } => contains_unbound_any_variable(elem),
        HashMap { key, value } => {
            contains_unbound_any_variable(key) || contains_unbound_any_variable(value)
        },
        Func { params, ret_ty } => {
            if contains_unbound_any_variable(ret_ty) {
                true
            } else {
                for value in params {
                    if contains_unbound_any_variable(value) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        _ => false,
    }
}

fn predicate_requirement_message(ctx: Checker, value: TypePredicate, fallback: string) -> string {
    if fallback == "type predicate not satisfied" {
        match value {
            Trait { for_ty, trait_ref: reference } => {
                let mut unresolved = contains_unbound_type_variable(for_ty);
                let mut ambiguous = contains_unbound_any_variable(for_ty);
                for value in reference.args {
                    if contains_unbound_type_variable(value) {
                        unresolved = true;
                    } else {
                        ()
                    };
                    if contains_unbound_any_variable(value) {
                        ambiguous = true;
                    } else {
                        ()
                    }
                };
                if unresolved && ambiguous {
                    f"Could not infer the type required to prove {trait_ref_text(diagnostic_trait_ref(reference))}<{diagnostic_type_text(for_ty)}>"
                } else {
                    f"No instance found for trait {trait_ref_text(reference)}<{type_text(normalize_type(ctx, for_ty))}>"
                }
            },
            Equality { lhs: _, rhs: _ } => fallback,
        }
    } else {
        fallback
    }
}

fn type_contains_error(value: Type) -> bool {
    match prune(value) {
        Error => true,
        Tuple { items: values } => {
            for value in values {
                if type_contains_error(value) {
                    return true
                } else {
                    ()
                }
            };
            false
        },
        Projection { for_ty: base, name: _, trait_ref: _ } => type_contains_error(base),
        App { ty: base, args } => {
            if type_contains_error(base) {
                true
            } else {
                for value in args {
                    if type_contains_error(value) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        Array { len: _, elem } | Slice { elem } | VecType { elem } | RefType { elem } | Channel {
            elem,
        } => type_contains_error(elem),
        HashMap { key, value } => {
            type_contains_error(key) || type_contains_error(value)
        },
        Func { params, ret_ty } => {
            if type_contains_error(ret_ty) {
                true
            } else {
                for value in params {
                    if type_contains_error(value) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        _ => false,
    }
}

fn predicate_contains_error(value: TypePredicate) -> bool {
    match value {
        Trait { for_ty, trait_ref: reference } => {
            if type_contains_error(for_ty) {
                true
            } else {
                for value in reference.args {
                    if type_contains_error(value) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        Equality { lhs: left, rhs: right } => {
            type_contains_error(left) || type_contains_error(right)
        },
    }
}

fn mark_unresolved_inference_type(ctx: Checker, value: Type) -> unit {
    match prune(value) {
        Var(variable) => match variable.get() {
            Unbound { id: _, kind: Any } => {
                if unresolved_inference_var(ctx, variable) {
                    ()
                } else {
                    ctx.unresolved_inference_vars.push(variable)
                }
            },
            Link(inner) => mark_unresolved_inference_type(ctx, inner),
            _ => (),
        },
        Tuple { items } => for item in items {
            mark_unresolved_inference_type(ctx, item)
        },
        Projection { for_ty, name: _, trait_ref } => {
            mark_unresolved_inference_type(ctx, for_ty);
            match trait_ref {
                Some(reference) => for arg in reference.args {
                    mark_unresolved_inference_type(ctx, arg)
                },
                None => (),
            }
        },
        App { ty, args } => {
            mark_unresolved_inference_type(ctx, ty);
            for arg in args {
                mark_unresolved_inference_type(ctx, arg)
            }
        },
        Array { len: _, elem } | Slice { elem } | VecType { elem } | RefType { elem } | Channel {
            elem,
        } => {
            mark_unresolved_inference_type(ctx, elem)
        },
        HashMap { key, value } => {
            mark_unresolved_inference_type(ctx, key);
            mark_unresolved_inference_type(ctx, value)
        },
        Func { params, ret_ty } => {
            for param in params {
                mark_unresolved_inference_type(ctx, param)
            };
            mark_unresolved_inference_type(ctx, ret_ty)
        },
        _ => (),
    }
}

fn mark_unresolved_inference_predicate(ctx: Checker, value: TypePredicate) -> unit {
    match value {
        Trait { for_ty, trait_ref } => {
            mark_unresolved_inference_type(ctx, for_ty);
            for arg in trait_ref.args {
                mark_unresolved_inference_type(ctx, arg)
            }
        },
        Equality { lhs, rhs } => {
            mark_unresolved_inference_type(ctx, lhs);
            mark_unresolved_inference_type(ctx, rhs)
        },
    }
}

fn predicate_message_present(
    messages: Vec[string],
    spans: Vec[Option[ast::Span]],
    message: string,
    span: Option[ast::Span],
) -> bool {
    for index in 0..messages.len() {
        if messages[index] == message && optional_spans_equal(spans[index], span) {
            return true
        } else {
            ()
        }
    };
    false
}

fn resolve_required_predicates(ctx: Checker) -> bool {
    for requirement in ctx.required_predicates {
        match requirement.predicate {
            Trait { for_ty, trait_ref } => {
                let _ = default_numeric_type(for_ty);
                for arg in trait_ref.args {
                    let _ = default_numeric_type(arg);
                };
            },
            Equality { lhs, rhs } => {
                let _ = default_numeric_type(lhs);
                let _ = default_numeric_type(rhs);
            },
        }
    };
    for _ in 0..ctx.required_predicates.len() + 1 {
        for requirement in ctx.required_predicates {
            let _ = predicates_satisfied_at(ctx, Vec::[requirement.predicate], Vec::[]);
        };
    };
    let messages: Vec[string] = Vec::[];
    let spans: Vec[Option[ast::Span]] = Vec::[];
    for requirement in ctx.required_predicates {
        match requirement.predicate {
            Trait { for_ty, trait_ref: _ } => {
                if contains_unbound_type_variable(for_ty) && is_numeric_type(for_ty) {
                    let _ = resolve_type(for_ty);
                } else {
                    ()
                }
            },
            Equality { lhs: _, rhs: _ } => (),
        };
        if predicate_contains_error(requirement.predicate)
            || predicates_satisfied_at(ctx, Vec::[requirement.predicate], Vec::[]) {
            ()
        } else {
            let message = predicate_requirement_message(
                ctx,
                requirement.predicate,
                requirement.message,
            );
            if predicate_message_present(messages, spans, message, requirement.span) {
                ()
            } else {
                let inference_prefix = "Could not infer the type required to prove";
                if message.starts_with(inference_prefix) {
                    mark_unresolved_inference_predicate(ctx, requirement.predicate)
                } else {
                    ()
                };
                messages.push(message);
                spans.push(requirement.span);
                push_diagnostic_at(ctx, message, requirement.span)
            }
        }
    };
    for message in messages {
        if message.starts_with("Could not infer the type required to prove") {
            return true
        } else {
            ()
        }
    };
    false
}

fn builtin_value_trait_type(value: Type) -> bool {
    match prune(value) {
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        Var(variable) => match variable.get() {
            Unbound { id: _, kind: Integer } | Unbound { id: _, kind: Float } => true,
            Link(inner) => builtin_value_trait_type(inner),
            Unbound { id: _, kind: Any } => false,
        },
        _ => false,
    }
}

fn iterator_trait_ref() -> TraitRef {
    TraitRef { name: "Iterator", args: Vec::[] }
}

fn iterator_item_type(value: Type) -> Type {
    Type::Projection { for_ty: value, name: "Item", trait_ref: Option::Some(iterator_trait_ref()) }
}

fn builtin_iterator_bound_satisfied(ctx: Checker, bound_ty: Type, goals: Vec[string]) -> bool {
    match prune(normalize_type(ctx, bound_ty)) {
        App { ty: Con { name }, args } => if name == "FnIterator" && args.len() == 1 {
            true
        } else if name == "MapIterator" && args.len() == 3 {
            let iterator = args[2];
            trait_bound_satisfied_at(ctx, iterator, iterator_trait_ref(), goals)
                && unify(
                    normalize_type(ctx, iterator_item_type(iterator)),
                    normalize_type(ctx, args[0]),
                )
        } else if name == "FilterIterator" && args.len() == 2 {
            let iterator = args[1];
            trait_bound_satisfied_at(ctx, iterator, iterator_trait_ref(), goals)
                && unify(
                    normalize_type(ctx, iterator_item_type(iterator)),
                    normalize_type(ctx, args[0]),
                )
        } else if name == "TakeIterator" && args.len() == 1 {
            trait_bound_satisfied_at(ctx, args[0], iterator_trait_ref(), goals)
        } else if (name == "EnumerateIterator" || name == "SkipIterator") && args.len() == 1 {
            trait_bound_satisfied_at(ctx, args[0], iterator_trait_ref(), goals)
        } else if name == "ZipIterator" && args.len() == 2 {
            trait_bound_satisfied_at(ctx, args[0], iterator_trait_ref(), goals)
                && trait_bound_satisfied_at(ctx, args[1], iterator_trait_ref(), goals)
        } else if name == "ChainIterator" && args.len() == 3 {
            let first = args[1];
            let second = args[2];
            trait_bound_satisfied_at(ctx, first, iterator_trait_ref(), goals)
                && trait_bound_satisfied_at(ctx, second, iterator_trait_ref(), goals)
                && unify(
                    normalize_type(ctx, iterator_item_type(first)),
                    normalize_type(ctx, args[0]),
                )
                && unify(
                    normalize_type(ctx, iterator_item_type(second)),
                    normalize_type(ctx, args[0]),
                )
        } else {
            false
        },
        _ => false,
    }
}

fn builtin_trait_bound_satisfied(
    ctx: Checker,
    bound_ty: Type,
    reference: TraitRef,
    goals: Vec[string],
) -> bool {
    if !reference.args.is_empty() {
        false
    } else {
        let trait_name = short_name(reference.name);
        let bound_ty = prune(normalize_type(ctx, bound_ty));
        match bound_ty {
            Dyn { trait_name: name } => {
                for application in trait_ref_closure(ctx, TraitRef { name, args: Vec::[] }) {
                    if names_match(application.name, trait_name) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            },
            _ => if trait_name == "ToString" {
                if builtin_value_trait_type(bound_ty) {
                    true
                } else {
                    match bound_ty {
                        RefType { elem: inner } => trait_bound_satisfied_at(
                            ctx,
                            inner,
                            TraitRef { name: "ToString", args: Vec::[] },
                            goals,
                        ),
                        _ => false,
                    }
                }
            } else if trait_name == "Eq" || trait_name == "Hash" {
                if trait_name == "Eq" {
                    if builtin_value_trait_type(bound_ty) {
                        true
                    } else {
                        match bound_ty {
                            RefType { elem: _ } => true,
                            Tuple { items: values } => {
                                for value in values {
                                    if !trait_bound_satisfied_at(
                                        ctx,
                                        value,
                                        TraitRef { name: "Eq", args: Vec::[] },
                                        goals,
                                    ) {
                                        return false
                                    } else {
                                        ()
                                    }
                                };
                                true
                            },
                            Array { len: _, elem: element } => trait_bound_satisfied_at(
                                ctx,
                                element,
                                TraitRef { name: "Eq", args: Vec::[] },
                                goals,
                            ),
                            _ => false,
                        }
                    }
                } else {
                    builtin_value_trait_type(bound_ty)
                        || match bound_ty {
                            RefType { elem: _ } => true,
                            _ => false,
                        }
                }
            } else if trait_name == "Iterator" {
                builtin_iterator_bound_satisfied(ctx, bound_ty, goals)
            } else if trait_name == "IntoIterator" {
                match bound_ty {
                    VecType { elem: _ } | Slice { elem: _ } => true,
                    _ => trait_bound_satisfied_at(ctx, bound_ty, iterator_trait_ref(), goals),
                }
            } else {
                false
            },
        }
    }
}

fn trait_goal_key(bound_ty: Type, reference: TraitRef) -> string {
    let builder = text::StringBuilder::new();
    write_type(builder, bound_ty);
    builder.write_string(": ");
    write_trait_ref(builder, reference);
    builder.finish()
}

fn extend_trait_goals(goals: Vec[string], goal: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for value in goals {
        result.push(value)
    };
    result.push(goal);
    result
}

fn trait_bound_satisfied_at(ctx: Checker, bound_ty: Type, reference: TraitRef, goals: Vec[string]) -> bool {
    let bound_ty = normalize_type(ctx, bound_ty);
    let reference = normalize_trait_ref(ctx, reference);
    if types_equal(bound_ty, Type::Error) {
        true
    } else if context_trait_bound_satisfied(ctx, bound_ty, reference) {
        true
    } else if collections::contains(goals, trait_goal_key(bound_ty, reference)) {
        false
    } else {
        let goals = extend_trait_goals(goals, trait_goal_key(bound_ty, reference));
        if builtin_trait_bound_satisfied(ctx, bound_ty, reference, goals) {
            true
        } else {
            let ambiguous = if contains_unbound_any_variable(bound_ty) {
                compatible_impl_count(ctx, bound_ty, reference) > 1
            } else {
                false
            };
            if ambiguous {
                return false
            } else {
                ()
            };
            for impl_info in ctx.impls {
                if !collections::contains(ctx.invalid_impl_origins, impl_info.origin)
                    && names_match(impl_info.trait_ref.name, reference.name) {
                    let substitutions = instantiate_substitutions(
                        ctx.counter,
                        impl_info.generics,
                        Vec::[],
                    );
                    let owner = substitute_type(impl_info.for_type, substitutions);
                    let application = substitute_trait_ref(impl_info.trait_ref, substitutions);
                    if unify(owner, bound_ty) {
                        let application = normalize_trait_ref(ctx, application);
                        if unify_types(application.args, reference.args) {
                            let predicates = expand_implied_predicates(
                                ctx,
                                substitute_predicates(impl_info.predicates, substitutions),
                            );
                            apply_predicate_equalities(predicates);
                            if predicates_satisfied_at(ctx, predicates, goals) {
                                return true
                            } else {
                                ()
                            }
                        } else {
                            ()
                        }
                    } else {
                        ()
                    }
                } else {
                    ()
                }
            };
            false
        }
    }
}

fn compatible_impl_count(ctx: Checker, bound_ty: Type, reference: TraitRef) -> int {
    let mut count = 0;
    for impl_info in ctx.impls {
        if !collections::contains(ctx.invalid_impl_origins, impl_info.origin)
            && names_match(impl_info.trait_ref.name, reference.name) {
            let substitutions = instantiate_substitutions(ctx.counter, impl_info.generics, Vec::[]);
            let owner = substitute_type(impl_info.for_type, substitutions);
            let application = substitute_trait_ref(impl_info.trait_ref, substitutions);
            if call_types_compatible(owner, bound_ty)
                && call_type_lists_compatible(application.args, reference.args) {
                count += 1;
            } else {
                ()
            }
        } else {
            ()
        }
    };
    count
}

fn instantiated_impl_parts(ctx: Checker, value: ImplInfo) -> (Type, TraitRef, Vec[TypePredicate]) {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, Vec::[]);
    (
        substitute_type(value.for_type, substitutions),
        substitute_trait_ref(value.trait_ref, substitutions),
        substitute_predicates(value.predicates, substitutions),
    )
}

fn impls_overlap(ctx: Checker, left: ImplInfo, right: ImplInfo) -> bool {
    if !names_match(left.trait_ref.name, right.trait_ref.name) {
        false
    } else {
        let left = instantiated_impl_parts(ctx, left);
        let right = instantiated_impl_parts(ctx, right);
        if !unify(left.0, right.0) || !unify_types(left.1.args, right.1.args) {
            false
        } else {
            let predicates = append_predicates(left.2, right.2);
            predicates_satisfied_at(ctx, expand_implied_predicates(ctx, predicates), Vec::[])
        }
    }
}

fn validate_impl_overlaps(ctx: Checker) -> unit {
    for left in 0..ctx.impls.len() {
        for right in left + 1..ctx.impls.len() {
            let left_impl = ctx.impls[left];
            let right_impl = ctx.impls[right];
            if impls_overlap(ctx, left_impl, right_impl) {
                if !collections::contains(ctx.invalid_impl_origins, right_impl.origin) {
                    ctx.invalid_impl_origins.push(right_impl.origin)
                } else {
                    ()
                };
                if left_impl.generics.is_empty() && right_impl.generics.is_empty()
                    && types_equal(left_impl.for_type, right_impl.for_type)
                    && trait_ref_equal(left_impl.trait_ref, right_impl.trait_ref) {
                    push_diagnostic(
                        ctx,
                        f"Trait {trait_ref_text(left_impl.trait_ref)} implementation for {type_text(left_impl.for_type)} is already defined",
                    )
                } else {
                    let origin = if !left_impl.generics.is_empty() {
                        f"{left_impl.origin} at source range {left_impl.span.start}..{left_impl.span.end}"
                    } else {
                        left_impl.origin
                    };
                    push_diagnostic_at(
                        ctx,
                        f"Trait {short_name(right_impl.trait_ref.name)} implementation for {type_text(right_impl.for_type)} overlaps with implementation {origin}",
                        Option::Some(right_impl.span),
                    )
                }
            } else {
                ()
            }
        }
    }
}

fn builtin_ref_impl_trait(name: string) -> bool {
    if names_match(name, "Eq") {
        true
    } else if names_match(name, "Hash") {
        true
    } else {
        false
    }
}

fn validate_builtin_impl_overlaps(ctx: Checker, value: hir::File) -> unit {
    if value.package_name != "builtin" {
        for item in value.items {
            match item {
                ImplBlock(block) => match block.trait_ref {
                    Some(reference) => {
                        let for_type = type_from_hir(block.for_type, block.generics, Option::None);
                        match for_type {
                            RefType { elem: _ } => if builtin_ref_impl_trait(reference.name) {
                                push_diagnostic_at(
                                    ctx,
                                    f"Trait {short_name(reference.name)} implementation for {type_text(for_type)} overlaps with builtin implementation",
                                    Option::Some(block.for_type_span),
                                )
                            } else {
                                ()
                            },
                            _ => (),
                        }
                    },
                    None => (),
                },
                _ => (),
            }
        }
    } else {
        ()
    }
}

fn method_predicates_satisfied(ctx: Checker, predicates: Vec[TypePredicate]) -> bool {
    predicates_satisfied_at(ctx, predicates, Vec::[])
}

fn method_trait_in_scope(ctx: Checker, value: MethodInfo) -> bool {
    match value.trait_ref {
        Some(reference) => if collections::contains(ctx.in_scope_traits, reference.name) {
            true
        } else if collections::contains(ctx.imported_items, reference.name) {
            true
        } else if short_name(reference.name) == reference.name {
            let mut found = false;
            for name in ctx.in_scope_traits {
                if short_name(name) == reference.name {
                    found = true;
                } else {
                    ()
                }
            };
            for name in ctx.imported_items {
                if short_name(name) == reference.name {
                    found = true;
                } else {
                    ()
                }
            };
            found
        } else {
            false
        },
        None => true,
    }
}

fn deferred_method_candidate(
    ctx: Checker,
    receiver: Type,
    name: string,
    args: Vec[Type],
    expected: Option[Type],
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    let mut matches = 0;
    let mut candidate_ty = Type::Error;
    for value in ctx.methods {
        if value.function.name == name && method_trait_in_scope(ctx, value)
            && value.trait_ref.is_some() {
            let candidate = instantiate_method_candidate(ctx, value, Vec::[], method_explicit);
            if method_matches_call(ctx, candidate.callable, receiver, args, expected) {
                matches += 1;
                if matches == 1 {
                    candidate_ty = candidate.callable.ty;
                } else {
                    ()
                }
            } else {
                ()
            }
        } else {
            ()
        }
    };
    if matches > 1 {
        match prune(candidate_ty) {
            Func { params, ret_ty } => {
                params[0] = receiver;
                Option::Some(
                    ResolvedCallable {
                        callable: Callable::Function(f"__goml_deferred_method:{name}"),
                        ty: Type::Func { params, ret_ty },
                        predicates: Vec::[],
                    },
                )
            },
            _ => Option::None,
        }
    } else {
        Option::None
    }
}

fn resolve_user_method_for_call(
    ctx: Checker,
    receiver: Type,
    name: string,
    args: Vec[Type],
    expected: Option[Type],
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    let inherent: Vec[ResolvedCallable] = Vec::[];
    let trait_methods: Vec[ResolvedCallable] = Vec::[];
    for value in ctx.methods {
        if value.function.name == name && receiver_matches(value.for_type, receiver)
            && method_trait_in_scope(ctx, value) {
            let candidate = instantiate_method_candidate(ctx, value, Vec::[], method_explicit);
            let matches = match value.trait_ref {
                Some(_) => {
                    method_matches_call(ctx, candidate.callable, receiver, args, expected)
                        && unify(candidate.owner, receiver)
                        && method_predicates_satisfied(ctx, candidate.owner_predicates)
                },
                None => {
                    unify(candidate.owner, receiver)
                        && method_matches_call(ctx, candidate.callable, receiver, args, expected)
                        && method_predicates_satisfied(ctx, candidate.owner_predicates)
                },
            };
            if matches {
                match value.trait_ref {
                    Some(_) => trait_methods.push(candidate.callable),
                    None => inherent.push(candidate.callable),
                }
            } else {
                ()
            }
        } else {
            ()
        }
    };
    let matches = if !inherent.is_empty() {
        inherent
    } else {
        trait_methods
    };
    if matches.len() == 1 {
        Option::Some(matches[0])
    } else {
        if matches.len() > 1 {
            push_diagnostic(ctx, f"ambiguous method: {name}")
        } else {
            ()
        };
        Option::None
    }
}

fn callable_type(params: Vec[Type], ret_ty: Type) -> Type {
    Type::Func { params, ret_ty }
}

fn inherent_callable(owner: Type, name: string, params: Vec[Type], ret_ty: Type) -> ResolvedCallable {
    ResolvedCallable {
        callable: Callable::InherentMethod { receiver_ty: owner, method_name: name },
        ty: callable_type(params, ret_ty),
        predicates: Vec::[],
    }
}

fn trait_callable(
    trait_name: string,
    args: Vec[Type],
    name: string,
    params: Vec[Type],
    ret_ty: Type,
) -> ResolvedCallable {
    ResolvedCallable {
        callable: Callable::TraitMethod {
            trait_ref: TraitRef { name: trait_name, args },
            method_name: name,
        },
        ty: callable_type(params, ret_ty),
        predicates: Vec::[],
    }
}

fn resolve_builtin_method(ctx: Checker, receiver: Type, name: string, method_explicit: Vec[Type]) -> Option[
    ResolvedCallable,
] {
    let receiver = prune(normalize_type(ctx, receiver));
    if name == "to_string" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], method_explicit);
        if is_integer_type(receiver) {
            if match receiver {
                Var(_) => true,
                _ => false,
            } {
                expect_type(ctx, receiver, Type::Int)
            } else {
                ()
            };
            let owner = resolve_type(receiver);
            if match owner {
                Int | Int32 => true,
                _ => false,
            } {
                Option::Some(inherent_callable(owner, name, one_type(owner), Type::String))
            } else {
                Option::Some(
                    trait_callable("ToString", Vec::[], name, one_type(owner), Type::String),
                )
            }
        } else if match receiver {
            Char => true,
            _ => false,
        } {
            Option::Some(inherent_callable(Type::Char, name, one_type(Type::Char), Type::String))
        } else {
            let reference = TraitRef { name: "ToString", args: Vec::[] };
            if trait_bound_satisfied_at(ctx, receiver, reference, Vec::[]) {
                Option::Some(
                    trait_callable("ToString", Vec::[], name, one_type(receiver), Type::String),
                )
            } else {
                Option::None
            }
        }
    } else {
        resolve_builtin_container_method(ctx, receiver, name, method_explicit)
    }
}

fn resolve_builtin_container_method(
    ctx: Checker,
    receiver: Type,
    name: string,
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    let result = match receiver {
        VecType { elem } => resolve_vec_method(receiver, elem, name),
        Slice { elem } => resolve_slice_method(receiver, elem, name),
        RefType { elem } => resolve_ref_method(receiver, elem, name),
        Channel { elem } => resolve_channel_method(receiver, elem, name),
        HashMap { key, value } => {
            resolve_hashmap_method(ctx, receiver, key, value, name)
        },
        String => resolve_string_method(receiver, name),
        App { ty: Con { name: owner }, args } => {
            resolve_option_result_method(ctx, receiver, owner, args, name, method_explicit)
        },
        _ => Option::None,
    };
    match result {
        Some(value) => {
            match receiver {
                App { ty: Con { name: owner }, args: _ } => {
                    if short_name(owner) == "Option" || short_name(owner) == "Result" {
                        ()
                    } else {
                        validate_explicit_method_type_arguments(
                            ctx,
                            name,
                            "method",
                            Vec::[],
                            method_explicit,
                        )
                    }
                },
                _ => validate_explicit_method_type_arguments(
                    ctx,
                    name,
                    "method",
                    Vec::[],
                    method_explicit,
                ),
            };
            Option::Some(value)
        },
        None => Option::None,
    }
}

fn builtin_method_type_parameter(ctx: Checker, name: string, parameter: string, explicit: Vec[Type]) -> Type {
    validate_explicit_method_type_arguments(ctx, name, "method", Vec::[parameter], explicit);
    if explicit.len() == 1 {
        explicit[0]
    } else {
        fresh_type(ctx.counter, VarKind::Any)
    }
}

fn resolve_option_method(
    ctx: Checker,
    receiver: Type,
    elem: Type,
    name: string,
    explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    if name == "is_some" || name == "is_none" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], explicit);
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Bool))
    } else if name == "unwrap_or" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], explicit);
        Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), elem))
    } else if name == "unwrap_or_else" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], explicit);
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: Vec::[], ret_ty: elem }),
                elem,
            ),
        )
    } else if name == "map" {
        let mapped = builtin_method_type_parameter(ctx, name, "U", explicit);
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: one_type(elem), ret_ty: mapped }),
                nominal_type("Option", one_type(mapped)),
            ),
        )
    } else if name == "and_then" {
        let mapped = builtin_method_type_parameter(ctx, name, "U", explicit);
        let result = nominal_type("Option", one_type(mapped));
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: one_type(elem), ret_ty: result }),
                result,
            ),
        )
    } else if name == "ok_or" {
        let error = builtin_method_type_parameter(ctx, name, "E", explicit);
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, error),
                nominal_type("Result", two_types(elem, error)),
            ),
        )
    } else {
        Option::None
    }
}

fn resolve_result_method(
    ctx: Checker,
    receiver: Type,
    ok: Type,
    error: Type,
    name: string,
    explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    if name == "is_ok" || name == "is_err" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], explicit);
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Bool))
    } else if name == "unwrap_or" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], explicit);
        Option::Some(inherent_callable(receiver, name, two_types(receiver, ok), ok))
    } else if name == "unwrap_or_else" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], explicit);
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: one_type(error), ret_ty: ok }),
                ok,
            ),
        )
    } else if name == "map" {
        let mapped = builtin_method_type_parameter(ctx, name, "U", explicit);
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: one_type(ok), ret_ty: mapped }),
                nominal_type("Result", two_types(mapped, error)),
            ),
        )
    } else if name == "map_err" {
        let mapped = builtin_method_type_parameter(ctx, name, "F", explicit);
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: one_type(error), ret_ty: mapped }),
                nominal_type("Result", two_types(ok, mapped)),
            ),
        )
    } else if name == "and_then" {
        let mapped = builtin_method_type_parameter(ctx, name, "U", explicit);
        let result = nominal_type("Result", two_types(mapped, error));
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Func { params: one_type(ok), ret_ty: result }),
                result,
            ),
        )
    } else {
        Option::None
    }
}

fn resolve_option_result_method(
    ctx: Checker,
    receiver: Type,
    owner: string,
    args: Vec[Type],
    name: string,
    explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    if short_name(owner) == "Option" && args.len() == 1 {
        resolve_option_method(ctx, receiver, args[0], name, explicit)
    } else if short_name(owner) == "Result" && args.len() == 2 {
        resolve_result_method(ctx, receiver, args[0], args[1], name, explicit)
    } else {
        Option::None
    }
}

fn resolve_vec_method(receiver: Type, elem: Type, name: string) -> Option[ResolvedCallable] {
    if name == "push" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), Type::Unit))
    } else if name == "get" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), elem))
    } else if name == "set" {
        Option::Some(
            inherent_callable(receiver, name, three_types(receiver, Type::Int, elem), Type::Unit),
        )
    } else if name == "len" || name == "capacity" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
    } else if name == "is_empty" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Bool))
    } else if name == "reserve" || name == "truncate" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Unit))
    } else if name == "clear" || name == "reverse" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Unit))
    } else if name == "last" || name == "pop" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("Option", one_type(elem)),
            ),
        )
    } else if name == "swap" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                Type::Unit,
            ),
        )
    } else if name == "swap_remove" || name == "remove" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), elem))
    } else if name == "insert" {
        Option::Some(
            inherent_callable(receiver, name, three_types(receiver, Type::Int, elem), Type::Unit),
        )
    } else if name == "extend" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, receiver), Type::Unit))
    } else if name == "pushed" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), receiver))
    } else if name == "slice" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                Type::Slice { elem },
            ),
        )
    } else if name == "iter" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("FnIterator", one_type(elem)),
            ),
        )
    } else {
        Option::None
    }
}

fn resolve_slice_method(receiver: Type, elem: Type, name: string) -> Option[ResolvedCallable] {
    if name == "get" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), elem))
    } else if name == "len" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
    } else if name == "sub" {
        Option::Some(
            inherent_callable(receiver, name, three_types(receiver, Type::Int, Type::Int), receiver),
        )
    } else if name == "iter" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("FnIterator", one_type(elem)),
            ),
        )
    } else {
        Option::None
    }
}

fn resolve_ref_method(receiver: Type, elem: Type, name: string) -> Option[ResolvedCallable] {
    if name == "get" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), elem))
    } else if name == "set" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), Type::Unit))
    } else {
        Option::None
    }
}

fn resolve_channel_method(receiver: Type, elem: Type, name: string) -> Option[ResolvedCallable] {
    if name == "send" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), Type::Unit))
    } else if name == "recv" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("Option", one_type(elem)),
            ),
        )
    } else if name == "close" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Unit))
    } else {
        Option::None
    }
}

fn resolve_hashmap_method(ctx: Checker, receiver: Type, key: Type, value: Type, name: string) -> Option[
    ResolvedCallable,
] {
    if name == "get" {
        if hashmap_option_shape_is_valid(ctx) {
            ()
        } else {
            push_diagnostic(
                ctx,
                "HashMap::get requires Option[T] to define exactly one empty variant and one payload variant containing T",
            )
        };
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, key),
                nominal_type("Option", one_type(value)),
            ),
        )
    } else if name == "set" {
        Option::Some(
            inherent_callable(receiver, name, three_types(receiver, key, value), Type::Unit),
        )
    } else if name == "len" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
    } else if name == "contains" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, key), Type::Bool))
    } else if name == "remove" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, key), Type::Unit))
    } else if name == "entries" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                Type::VecType { elem: Type::Tuple { items: two_types(key, value) } },
            ),
        )
    } else {
        Option::None
    }
}

fn resolve_string_method(receiver: Type, name: string) -> Option[ResolvedCallable] {
    if name == "len" || name == "byte_len" {
        Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
    } else if name == "get" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Char))
    } else if name == "byte_get" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Uint8))
    } else if name == "byte_slice" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                Type::String,
            ),
        )
    } else if name == "is_char_boundary" {
        Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Bool))
    } else if name == "decode_at" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Int),
                nominal_type(
                    "Option",
                    one_type(Type::Tuple { items: two_types(Type::Char, Type::Int) }),
                ),
            ),
        )
    } else if name == "to_bytes" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                Type::VecType { elem: Type::Uint8 },
            ),
        )
    } else if name == "chars" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("FnIterator", one_type(Type::Char)),
            ),
        )
    } else if name == "char_indices" {
        Option::Some(
            inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type(
                    "FnIterator",
                    one_type(Type::Tuple { items: two_types(Type::Int, Type::Char) }),
                ),
            ),
        )
    } else if name == "starts_with" || name == "ends_with" || name == "contains" {
        Option::Some(
            inherent_callable(receiver, name, two_types(receiver, Type::String), Type::Bool),
        )
    } else {
        Option::None
    }
}

fn dyn_method_callable(owner: string, name: string, value: ResolvedCallable) -> ResolvedCallable {
    let dispatch = match value.callable {
        TraitMethod { trait_ref: reference, method_name: _ } => reference.name,
        _ => owner,
    };
    ResolvedCallable {
        callable: Callable::DynTraitMethod {
            trait_name: owner,
            dispatch_name: dispatch,
            method_name: name,
        },
        ty: value.ty,
        predicates: value.predicates,
    }
}

fn resolve_dyn_method(
    ctx: Checker,
    owner: string,
    receiver: Type,
    name: string,
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    let applications = trait_ref_closure(ctx, TraitRef { name: owner, args: Vec::[] });
    if applications.is_empty() {
        Option::None
    } else {
        match resolve_trait_reference_method(
            ctx,
            applications[0],
            name,
            Option::Some(receiver),
            method_explicit,
        ) {
            Some(value) => Option::Some(dyn_method_callable(owner, name, value)),
            None => {
                let resolved: Vec[ResolvedCallable] = Vec::[];
                let candidates: Vec[string] = Vec::[];
                for index in 1..applications.len() {
                    match resolve_trait_reference_method(
                        ctx,
                        applications[index],
                        name,
                        Option::Some(receiver),
                        method_explicit,
                    ) {
                        Some(value) => {
                            candidates.push(short_name(applications[index].name));
                            resolved.push(dyn_method_callable(owner, name, value))
                        },
                        None => (),
                    }
                };
                if resolved.len() == 1 {
                    Option::Some(resolved[0])
                } else {
                    if resolved.len() > 1 {
                        push_diagnostic(
                            ctx,
                            f"Ambiguous method {name} for type {type_text(receiver)} (candidates: {text::join(candidates, ", ")}). Use UFCS like Trait::{name}(...) to disambiguate",
                        );
                        Option::Some(
                            ResolvedCallable {
                                callable: Callable::Function("<error>"),
                                ty: Type::Func { params: Vec::[receiver], ret_ty: Type::Error },
                                predicates: Vec::[],
                            },
                        )
                    } else {
                        Option::None
                    }
                }
            },
        }
    }
}

fn resolve_method(
    ctx: Checker,
    receiver: Type,
    name: string,
    args: Vec[Type],
    expected: Option[Type],
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    let receiver = normalize_type(ctx, receiver);
    match receiver {
        Dyn { trait_name: owner } => resolve_dyn_method(ctx, owner, receiver, name, method_explicit),
        _ => match resolve_predicate_method(ctx, receiver, name, method_explicit) {
            Some(value) => Option::Some(value),
            None => match resolve_builtin_container_method(ctx, receiver, name, method_explicit) {
                Some(value) => Option::Some(value),
                None => match resolve_user_method_for_call(
                    ctx,
                    receiver,
                    name,
                    args,
                    expected,
                    method_explicit,
                ) {
                    Some(value) => Option::Some(value),
                    None => resolve_builtin_method(ctx, receiver, name, method_explicit),
                },
            },
        },
    }
}

fn hashmap_option_shape_is_valid(ctx: Checker) -> bool {
    match find_enum_by_name(ctx, "Option") {
        Some(info) => if info.generics.len() == 1 && info.variants.len() == 2 {
            let mut empty = 0;
            let mut payload = 0;
            for variant in info.variants {
                let fields = enum_variant_field_types(variant.fields);
                if fields.is_empty() {
                    empty += 1;
                } else if fields.len() == 1
                    && types_equal(fields[0], Type::Param { name: info.generics[0] }) {
                    payload += 1;
                } else {
                    ()
                }
            };
            empty == 1 && payload == 1
        } else {
            false
        },
        None => true,
    }
}

fn require_hashmap_type(ctx: Checker, value: Type) -> unit {
    match prune(normalize_type(ctx, value)) {
        HashMap { key, value: _ } => {
            require_predicate(
                ctx,
                TypePredicate::Trait {
                    for_ty: key,
                    trait_ref: TraitRef { name: "Eq", args: Vec::[] },
                },
                "type predicate not satisfied",
            );
            require_predicate(
                ctx,
                TypePredicate::Trait {
                    for_ty: key,
                    trait_ref: TraitRef { name: "Hash", args: Vec::[] },
                },
                "type predicate not satisfied",
            )
        },
        _ => (),
    }
}

fn find_trait(ctx: Checker, name: string) -> Option[TraitInfo] {
    for offset in 0..ctx.traits.len() {
        let value = ctx.traits[ctx.traits.len() - 1 - offset];
        if names_match(value.name, name) {
            return Option::Some(value)
        } else {
            ()
        }
    };
    builtin_trait_info(short_name(name))
}

fn find_trait_method(value: TraitInfo, name: string) -> Option[TraitMethodInfo] {
    for offset in 0..value.methods.len() {
        let method = value.methods[value.methods.len() - 1 - offset];
        if method.name == name {
            return Option::Some(method)
        } else {
            ()
        }
    };
    Option::None
}

fn builtin_associated_type(name: string, bounds: Vec[TraitRef]) -> AssociatedTypeInfo {
    AssociatedTypeInfo { name, bounds }
}

fn builtin_trait_method(name: string, params: Vec[Type], ret_ty: Type) -> TraitMethodInfo {
    TraitMethodInfo {
        name,
        generics: Vec::[],
        predicates: Vec::[],
        params,
        ret_ty,
        default_name: Option::None,
    }
}

pub fn builtin_trait_info(name: string) -> Option[TraitInfo] {
    let self_ty = Type::Param { name: "Self" };
    if name == "Iterator" {
        let associated_types: Vec[AssociatedTypeInfo] = Vec::[];
        associated_types.push(builtin_associated_type("Item", Vec::[]));
        let item = Type::Projection {
            for_ty: self_ty,
            name: "Item",
            trait_ref: Option::Some(TraitRef { name: "Iterator", args: Vec::[] }),
        };
        let methods: Vec[TraitMethodInfo] = Vec::[];
        methods.push(
            builtin_trait_method("next", one_type(self_ty), nominal_type("Option", one_type(item))),
        );
        Option::Some(
            TraitInfo {
                name,
                generics: Vec::[],
                predicates: Vec::[],
                supertraits: Vec::[],
                associated_types,
                methods,
            },
        )
    } else if name == "IntoIterator" {
        let into_iterator = TraitRef { name: "IntoIterator", args: Vec::[] };
        let item = Type::Projection {
            for_ty: self_ty,
            name: "Item",
            trait_ref: Option::Some(into_iterator),
        };
        let into_iter = Type::Projection {
            for_ty: self_ty,
            name: "IntoIter",
            trait_ref: Option::Some(into_iterator),
        };
        let iterator = TraitRef { name: "Iterator", args: Vec::[] };
        let iterator_item = Type::Projection {
            for_ty: into_iter,
            name: "Item",
            trait_ref: Option::Some(iterator),
        };
        let predicates: Vec[TypePredicate] = Vec::[];
        predicates.push(TypePredicate::Equality { lhs: item, rhs: iterator_item });
        let into_iter_bounds: Vec[TraitRef] = Vec::[];
        into_iter_bounds.push(iterator);
        let associated_types: Vec[AssociatedTypeInfo] = Vec::[];
        associated_types.push(builtin_associated_type("Item", Vec::[]));
        associated_types.push(builtin_associated_type("IntoIter", into_iter_bounds));
        let methods: Vec[TraitMethodInfo] = Vec::[];
        methods.push(builtin_trait_method("into_iter", one_type(self_ty), into_iter));
        Option::Some(
            TraitInfo {
                name,
                generics: Vec::[],
                predicates,
                supertraits: Vec::[],
                associated_types,
                methods,
            },
        )
    } else if name == "Eq" {
        Option::Some(
            TraitInfo {
                name,
                generics: Vec::[],
                predicates: Vec::[],
                supertraits: Vec::[],
                associated_types: Vec::[],
                methods: Vec::[builtin_trait_method("eq", two_types(self_ty, self_ty), Type::Bool)],
            },
        )
    } else if name == "Hash" {
        Option::Some(
            TraitInfo {
                name,
                generics: Vec::[],
                predicates: Vec::[],
                supertraits: Vec::[],
                associated_types: Vec::[],
                methods: Vec::[builtin_trait_method("hash", one_type(self_ty), Type::Uint64)],
            },
        )
    } else if name == "ToString" {
        Option::Some(
            TraitInfo {
                name,
                generics: Vec::[],
                predicates: Vec::[],
                supertraits: Vec::[],
                associated_types: Vec::[],
                methods: Vec::[builtin_trait_method("to_string", one_type(self_ty), Type::String)],
            },
        )
    } else {
        Option::None
    }
}

fn trait_ref_equal(left: TraitRef, right: TraitRef) -> bool {
    names_match(left.name, right.name) && type_lists_equal(left.args, right.args)
}

fn contains_trait_ref(values: Vec[TraitRef], expected: TraitRef) -> bool {
    for value in values {
        if trait_ref_equal(value, expected) {
            return true
        } else {
            ()
        }
    };
    false
}

fn predicate_equal(left: TypePredicate, right: TypePredicate) -> bool {
    match (left, right) {
        (
            Trait { for_ty: left_ty, trait_ref: left_ref },
            Trait { for_ty: right_ty, trait_ref: right_ref },
        ) => types_equal(left_ty, right_ty) && trait_ref_equal(left_ref, right_ref),
        (Equality { lhs: left_lhs, rhs: left_rhs }, Equality { lhs: right_lhs, rhs: right_rhs }) => types_equal(
            left_lhs,
            right_lhs,
        )
            && types_equal(left_rhs, right_rhs),
        _ => false,
    }
}

fn push_predicate(values: Vec[TypePredicate], value: TypePredicate) -> unit {
    for existing in values {
        if predicate_equal(existing, value) {
            return
        } else {
            ()
        }
    };
    values.push(value)
}

fn trait_ref_closure(ctx: Checker, reference: TraitRef) -> Vec[TraitRef] {
    let result: Vec[TraitRef] = Vec::[];
    result.push(reference);
    let mut index = 0;
    while index < result.len() {
        let current = result[index];
        index += 1;
        match find_trait(ctx, current.name) {
            Some(info) => if info.generics.len() == current.args.len() {
                let substitutions = instantiate_substitutions(
                    ctx.counter,
                    info.generics,
                    current.args,
                );
                for supertrait in info.supertraits {
                    let resolved = substitute_trait_ref(supertrait, substitutions);
                    if contains_trait_ref(result, resolved) {
                        ()
                    } else {
                        result.push(resolved)
                    }
                }
            } else {
                ()
            },
            None => (),
        }
    };
    result
}

fn trait_substitutions(ctx: Checker, info: TraitInfo, reference: TraitRef, self_ty: Option[Type]) -> Vec[
    TypeSubst,
] {
    let params = append_names(info.generics, Vec::["Self"]);
    let explicit: Vec[Type] = Vec::[];
    for arg in reference.args {
        explicit.push(arg)
    };
    match self_ty {
        Some(ty) => explicit.push(ty),
        None => (),
    };
    instantiate_substitutions(ctx.counter, params, explicit)
}

struct ProjectionCandidate {
    for_ty: Type,
    trait_ref: TraitRef,
    associated_names: Vec[string],
}

fn projection_candidates_from_predicates(ctx: Checker, predicates: Vec[TypePredicate]) -> Vec[
    ProjectionCandidate,
] {
    let result: Vec[ProjectionCandidate] = Vec::[];
    for predicate in predicates {
        match predicate {
            Trait { for_ty, trait_ref } => match find_trait(ctx, trait_ref.name) {
                Some(info) => {
                    let associated_names: Vec[string] = Vec::[];
                    for associated in info.associated_types {
                        associated_names.push(associated.name)
                    };
                    result.push(ProjectionCandidate { for_ty, trait_ref, associated_names })
                },
                None => (),
            },
            Equality { lhs: _, rhs: _ } => (),
        }
    };
    result
}

fn resolve_projection_trait_ref(
    ctx: Checker,
    value: TraitRef,
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> TraitRef {
    let args: Vec[Type] = Vec::[];
    for arg in value.args {
        args.push(resolve_projection_type(ctx, arg, candidates, report))
    };
    TraitRef { name: value.name, args }
}

fn resolve_projection_types(
    ctx: Checker,
    values: Vec[Type],
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> Vec[Type] {
    let result: Vec[Type] = Vec::[];
    for value in values {
        result.push(resolve_projection_type(ctx, value, candidates, report))
    };
    result
}

fn resolve_projection_type(
    ctx: Checker,
    value: Type,
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> Type {
    match resolve_type(value) {
        Projection { for_ty, name, trait_ref } => {
            let for_ty = resolve_projection_type(ctx, for_ty, candidates, report);
            let trait_ref = match trait_ref {
                Some(value) => Option::Some(
                    resolve_projection_trait_ref(ctx, value, candidates, report),
                ),
                None => {
                    let matches: Vec[TraitRef] = Vec::[];
                    for candidate in candidates {
                        if types_equal(candidate.for_ty, for_ty)
                            && collections::contains(candidate.associated_names, name) {
                            matches.push(candidate.trait_ref)
                        } else {
                            ()
                        }
                    };
                    if matches.len() == 1 {
                        Option::Some(
                            resolve_projection_trait_ref(ctx, matches[0], candidates, report),
                        )
                    } else {
                        if report {
                            let projection = f"{type_text(for_ty)}::{name}";
                            if matches.is_empty() {
                                let message = f"Associated type {projection} is not provided by a trait bound";
                                push_diagnostic_at(ctx, message, Option::None);
                                push_diagnostic(ctx, message)
                            } else {
                                let candidates: Vec[string] = Vec::[];
                                for candidate in matches {
                                    candidates.push(short_name(candidate.name))
                                };
                                let message = f"Associated type {projection} is ambiguous between {text::join(candidates, ", ")}";
                                push_diagnostic_at(ctx, message, Option::None);
                                push_diagnostic(ctx, message)
                            }
                        } else {
                            ()
                        };
                        Option::None
                    }
                },
            };
            Type::Projection { for_ty, name, trait_ref }
        },
        Tuple { items: values } => Type::Tuple {
            items: resolve_projection_types(ctx, values, candidates, report),
        },
        App { ty: base, args } => Type::App {
            ty: resolve_projection_type(ctx, base, candidates, report),
            args: resolve_projection_types(ctx, args, candidates, report),
        },
        Array { len: length, elem } => Type::Array {
            len: length,
            elem: resolve_projection_type(ctx, elem, candidates, report),
        },
        Slice { elem } => Type::Slice {
            elem: resolve_projection_type(ctx, elem, candidates, report),
        },
        VecType { elem } => Type::VecType {
            elem: resolve_projection_type(ctx, elem, candidates, report),
        },
        RefType { elem } => Type::RefType {
            elem: resolve_projection_type(ctx, elem, candidates, report),
        },
        Channel { elem } => Type::Channel {
            elem: resolve_projection_type(ctx, elem, candidates, report),
        },
        HashMap { key, value } => Type::HashMap {
            key: resolve_projection_type(ctx, key, candidates, report),
            value: resolve_projection_type(ctx, value, candidates, report),
        },
        Func { params, ret_ty } => Type::Func {
            params: resolve_projection_types(ctx, params, candidates, report),
            ret_ty: resolve_projection_type(ctx, ret_ty, candidates, report),
        },
        other => other,
    }
}

fn resolve_projection_predicates(
    ctx: Checker,
    predicates: Vec[TypePredicate],
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::[];
    for predicate in predicates {
        result.push(
            match predicate {
                Trait { for_ty, trait_ref } => TypePredicate::Trait {
                    for_ty: resolve_projection_type(ctx, for_ty, candidates, report),
                    trait_ref: resolve_projection_trait_ref(ctx, trait_ref, candidates, report),
                },
                Equality { lhs: left, rhs: right } => TypePredicate::Equality {
                    lhs: resolve_projection_type(ctx, left, candidates, report),
                    rhs: resolve_projection_type(ctx, right, candidates, report),
                },
            },
        )
    };
    result
}

fn resolve_signature_predicates(ctx: Checker, predicates: Vec[TypePredicate], report: bool) -> Vec[
    TypePredicate,
] {
    let predicates = expand_type_alias_predicates(ctx, predicates, report);
    if report {
        for predicate in predicates {
            match predicate {
                Trait { for_ty, trait_ref: reference } => {
                    validate_signature_type(ctx, for_ty);
                    validate_trait_reference(ctx, reference)
                },
                Equality { lhs: left, rhs: right } => {
                    validate_signature_type(ctx, left);
                    validate_signature_type(ctx, right)
                },
            }
        }
    } else {
        ()
    };
    let candidates = projection_candidates_from_predicates(ctx, predicates);
    expand_implied_predicates(
        ctx,
        resolve_projection_predicates(ctx, predicates, candidates, report),
    )
}

fn builtin_nominal_arity(name: string) -> Option[int] {
    if name == "Option" || name == "Vec" || name == "Slice" || name == "Ref" || name == "Channel"
        || name == "FnIterator"
        || name == "TakeIterator"
        || name == "EnumerateIterator"
        || name == "SkipIterator" {
        Option::Some(1)
    } else if name == "Result" || name == "HashMap" || name == "FilterIterator"
        || name == "ZipIterator" {
        Option::Some(2)
    } else if name == "MapIterator" || name == "ChainIterator" {
        Option::Some(3)
    } else {
        Option::None
    }
}

fn nominal_arity(ctx: Checker, name: string) -> Option[int] {
    match find_enum_by_name(ctx, name) {
        Some(value) => Option::Some(value.generics.len()),
        None => match find_struct_by_name(ctx, name) {
            Some(value) => Option::Some(value.generics.len()),
            None => if short_name(name) == name {
                builtin_nominal_arity(name)
            } else {
                Option::None
            },
        },
    }
}

fn nominal_application_has_wrong_arity(ctx: Checker, value: Type) -> bool {
    match prune(value) {
        Con { name } => match nominal_arity(ctx, name) {
            Some(expected) => expected != 0,
            None => false,
        },
        App { ty: base, args } => match prune(base) {
            Con { name } => match nominal_arity(ctx, name) {
                Some(expected) => expected != args.len(),
                None => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn validate_nominal_application(ctx: Checker, name: string, args: Vec[Type]) -> unit {
    match nominal_arity(ctx, name) {
        Some(expected) => if expected != args.len() {
            let category = if expected == 0 && !args.is_empty() {
                match find_struct_by_name(ctx, name) {
                    Some(_) => "Struct",
                    None => "Type",
                }
            } else {
                "Type"
            };
            push_diagnostic(
                ctx,
                f"{category} {short_name(name)} expects {expected} type arguments, but got {args.len()}",
            )
        } else {
            ()
        },
        None => match split_constructor_name(name) {
            Some(parts) => {
                let span = match ctx.current_span.get() {
                    Some(value) => Option::Some(
                        ast::span(
                            value.start + parts.0.byte_len() + 2,
                            value.start + parts.0.byte_len() + 2 + short_name(name).byte_len(),
                        ),
                    ),
                    None => Option::None,
                };
                push_diagnostic_at(ctx, f"Unknown type constructor {name}", span);
                push_diagnostic_at(
                    ctx,
                    f"package {parts.0} not imported in package main",
                    Option::None,
                )
            },
            None => push_diagnostic(ctx, f"Unknown type constructor {name}"),
        },
    };
    for arg in args {
        validate_signature_type(ctx, arg)
    }
}

fn validate_trait_reference(ctx: Checker, reference: TraitRef) -> unit {
    match find_trait(ctx, reference.name) {
        Some(info) => if info.generics.len() != reference.args.len() {
            push_diagnostic(
                ctx,
                f"Trait {short_name(reference.name)} expects {info.generics.len()} type arguments, but got {reference.args.len()}",
            )
        } else {
            ()
        },
        None => push_diagnostic(ctx, f"Unknown trait {reference.name}"),
    };
    for arg in reference.args {
        validate_signature_type(ctx, arg)
    }
}

fn type_contains_parameter(value: Type, expected: string) -> bool {
    match prune(value) {
        Param { name } => name == expected,
        Tuple { items: values } => {
            for value in values {
                if type_contains_parameter(value, expected) {
                    return true
                } else {
                    ()
                }
            };
            false
        },
        Projection { for_ty: base, name: _, trait_ref: qualifier } => {
            if type_contains_parameter(base, expected) {
                true
            } else {
                match qualifier {
                    Some(reference) => for arg in reference.args {
                        if type_contains_parameter(arg, expected) {
                            return true
                        } else {
                            ()
                        }
                    },
                    None => (),
                };
                false
            }
        },
        App { ty: base, args } => {
            if type_contains_parameter(base, expected) {
                true
            } else {
                for arg in args {
                    if type_contains_parameter(arg, expected) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        Array { len: _, elem } | Slice { elem } | VecType { elem } | RefType { elem } | Channel {
            elem,
        } => type_contains_parameter(elem, expected),
        HashMap { key, value } => {
            type_contains_parameter(key, expected) || type_contains_parameter(value, expected)
        },
        Func { params, ret_ty } => {
            if type_contains_parameter(ret_ty, expected) {
                true
            } else {
                for param in params {
                    if type_contains_parameter(param, expected) {
                        return true
                    } else {
                        ()
                    }
                };
                false
            }
        },
        _ => false,
    }
}

fn parameter_types_contain_from(values: Vec[Type], start: int, expected: string) -> bool {
    for index in start..values.len() {
        if type_contains_parameter(values[index], expected) {
            return true
        } else {
            ()
        }
    };
    false
}

fn validate_dyn_trait(ctx: Checker, info: TraitInfo) -> unit {
    if !info.associated_types.is_empty() {
        push_diagnostic_at(
            ctx,
            f"Trait {info.name} cannot be used as dyn because it declares associated types",
            Option::None,
        )
    } else {
        for method in info.methods {
            if !method.generics.is_empty() {
                push_diagnostic_at(
                    ctx,
                    f"Trait {info.name}::{method.name} is not dyn-safe: generic methods are not supported",
                    Option::None,
                )
            } else {
                ()
            };
            if method.params.is_empty() {
                push_diagnostic_at(
                    ctx,
                    f"Trait {info.name}::{method.name} is not dyn-safe: missing receiver parameter",
                    Option::None,
                )
            } else {
                if !types_equal(method.params[0], Type::Param { name: "Self" }) {
                    push_diagnostic_at(
                        ctx,
                        f"Trait {info.name}::{method.name} is not dyn-safe: receiver must be Self",
                        Option::None,
                    )
                } else {
                    ()
                };
                if parameter_types_contain_from(method.params, 1, "Self") {
                    push_diagnostic_at(
                        ctx,
                        f"Trait {info.name}::{method.name} is not dyn-safe: Self is not allowed in non-receiver parameters",
                        Option::None,
                    )
                } else {
                    ()
                }
            };
            if type_contains_parameter(method.ret_ty, "Self") {
                push_diagnostic_at(
                    ctx,
                    f"Trait {info.name}::{method.name} is not dyn-safe: Self is not allowed in return type",
                    Option::None,
                )
            } else {
                ()
            }
        }
    }
}

fn validate_signature_type(ctx: Checker, value: Type) -> unit {
    match prune(value) {
        Con { name } => validate_nominal_application(ctx, name, Vec::[]),
        App { ty: base, args } => match prune(base) {
            Con { name } => validate_nominal_application(ctx, name, args),
            _ => {
                push_diagnostic(ctx, f"Expected a type constructor, got {type_text(base)}");
                validate_signature_type(ctx, base);
                for arg in args {
                    validate_signature_type(ctx, arg)
                }
            },
        },
        Dyn { trait_name: name } => match find_trait(ctx, name) {
            Some(info) => if !info.generics.is_empty() {
                push_diagnostic_at(
                    ctx,
                    f"Generic trait {short_name(name)} cannot be used as dyn",
                    Option::None,
                )
            } else {
                validate_dyn_trait(ctx, info)
            },
            None => push_diagnostic(ctx, f"Unknown trait {name}"),
        },
        Projection { for_ty: base, name: _, trait_ref: qualifier } => {
            validate_signature_type(ctx, base);
            match qualifier {
                Some(reference) => validate_trait_reference(ctx, reference),
                None => (),
            }
        },
        Tuple { items: values } => for value in values {
            validate_signature_type(ctx, value)
        },
        Array { len: _, elem: element } | Slice { elem: element } | VecType { elem: element } | RefType {
            elem: element,
        } | Channel { elem: element } => validate_signature_type(ctx, element),
        HashMap { key, value } => {
            validate_signature_type(ctx, key);
            validate_signature_type(ctx, value)
        },
        Func { params, ret_ty } => {
            for param in params {
                validate_signature_type(ctx, param)
            };
            validate_signature_type(ctx, ret_ty)
        },
        _ => (),
    }
}

fn find_type_alias(ctx: Checker, name: string) -> Option[TypeAliasInfo] {
    let canonical = canonical_imported_name(ctx, name);
    for value in ctx.type_aliases {
        if value.name == canonical {
            return Option::Some(value)
        } else {
            ()
        }
    };
    let mut found = Option::None;
    for value in ctx.type_aliases {
        if short_name(value.name) == short_name(canonical) {
            match found {
                Some(_) => return Option::None,
                None => {
                    found = Option::Some(value);
                },
            }
        } else {
            ()
        }
    };
    found
}

fn expand_type_alias_inner(ctx: Checker, value: Type, stack: Vec[string], report: bool) -> Type {
    match prune(value) {
        Con { name } => match find_type_alias(ctx, name) {
            Some(alias) => if collections::contains(stack, alias.name) {
                if report {
                    push_diagnostic(ctx, f"Cyclic type alias {short_name(alias.name)}")
                } else {
                    ()
                };
                Type::Error
            } else if alias.generics.len() != 0 {
                if report {
                    push_diagnostic(
                        ctx,
                        f"Type alias {short_name(alias.name)} expects {alias.generics.len()} type arguments, got 0",
                    )
                } else {
                    ()
                };
                Type::Error
            } else {
                let next: Vec[string] = Vec::[];
                for item in stack {
                    next.push(item)
                };
                next.push(alias.name);
                expand_type_alias_inner(ctx, alias.ty, next, report)
            },
            None => Type::Con { name: canonical_imported_name(ctx, name) },
        },
        App { ty: base, args } => {
            let expanded_args: Vec[Type] = Vec::[];
            for arg in args {
                expanded_args.push(expand_type_alias_inner(ctx, arg, stack, report))
            };
            match prune(base) {
                Con { name } => match find_type_alias(ctx, name) {
                    Some(alias) => if collections::contains(stack, alias.name) {
                        if report {
                            push_diagnostic(ctx, f"Cyclic type alias {short_name(alias.name)}")
                        } else {
                            ()
                        };
                        Type::Error
                    } else if alias.generics.len() != expanded_args.len() {
                        if report {
                            push_diagnostic(
                                ctx,
                                f"Type alias {short_name(alias.name)} expects {alias.generics.len()} type arguments, got {expanded_args.len()}",
                            )
                        } else {
                            ()
                        };
                        Type::Error
                    } else {
                        let substitutions: Vec[TypeSubst] = Vec::[];
                        for index in 0..alias.generics.len() {
                            substitutions.push(
                                TypeSubst { name: alias.generics[index], ty: expanded_args[index] },
                            )
                        };
                        let next: Vec[string] = Vec::[];
                        for item in stack {
                            next.push(item)
                        };
                        next.push(alias.name);
                        expand_type_alias_inner(
                            ctx,
                            substitute_type(alias.ty, substitutions),
                            next,
                            report,
                        )
                    },
                    None => Type::App {
                        ty: expand_type_alias_inner(ctx, base, stack, report),
                        args: expanded_args,
                    },
                },
                _ => Type::App {
                    ty: expand_type_alias_inner(ctx, base, stack, report),
                    args: expanded_args,
                },
            }
        },
        Tuple { items: values } => {
            let result: Vec[Type] = Vec::[];
            for item in values {
                result.push(expand_type_alias_inner(ctx, item, stack, report))
            };
            Type::Tuple { items: result }
        },
        Projection { for_ty, name, trait_ref } => Type::Projection {
            for_ty: expand_type_alias_inner(ctx, for_ty, stack, report),
            name,
            trait_ref: match trait_ref {
                Some(reference) => Option::Some(
                    TraitRef {
                        name: reference.name,
                        args: expand_type_alias_types(ctx, reference.args, stack, report),
                    },
                ),
                None => Option::None,
            },
        },
        Array { len, elem } => Type::Array {
            len,
            elem: expand_type_alias_inner(ctx, elem, stack, report),
        },
        Slice { elem } => Type::Slice { elem: expand_type_alias_inner(ctx, elem, stack, report) },
        VecType { elem } => Type::VecType {
            elem: expand_type_alias_inner(ctx, elem, stack, report),
        },
        RefType { elem } => Type::RefType {
            elem: expand_type_alias_inner(ctx, elem, stack, report),
        },
        Channel { elem } => Type::Channel {
            elem: expand_type_alias_inner(ctx, elem, stack, report),
        },
        HashMap { key, value } => Type::HashMap {
            key: expand_type_alias_inner(ctx, key, stack, report),
            value: expand_type_alias_inner(ctx, value, stack, report),
        },
        Func { params, ret_ty } => {
            let result: Vec[Type] = Vec::[];
            for param in params {
                result.push(expand_type_alias_inner(ctx, param, stack, report))
            };
            Type::Func {
                params: result,
                ret_ty: expand_type_alias_inner(ctx, ret_ty, stack, report),
            }
        },
        other => other,
    }
}

fn expand_type_alias_types(ctx: Checker, values: Vec[Type], stack: Vec[string], report: bool) -> Vec[
    Type,
] {
    let result: Vec[Type] = Vec::[];
    for value in values {
        result.push(expand_type_alias_inner(ctx, value, stack, report))
    };
    result
}

fn expand_type_aliases(ctx: Checker, value: Type, report: bool) -> Type {
    expand_type_alias_inner(ctx, value, Vec::[], report)
}

fn expand_type_alias_trait_ref(ctx: Checker, value: TraitRef, report: bool) -> TraitRef {
    TraitRef { name: value.name, args: expand_type_alias_types(ctx, value.args, Vec::[], report) }
}

fn expand_type_alias_predicates(ctx: Checker, values: Vec[TypePredicate], report: bool) -> Vec[
    TypePredicate,
] {
    let result: Vec[TypePredicate] = Vec::[];
    for value in values {
        result.push(
            match value {
                Trait { for_ty, trait_ref } => TypePredicate::Trait {
                    for_ty: expand_type_aliases(ctx, for_ty, report),
                    trait_ref: expand_type_alias_trait_ref(ctx, trait_ref, report),
                },
                Equality { lhs, rhs } => TypePredicate::Equality {
                    lhs: expand_type_aliases(ctx, lhs, report),
                    rhs: expand_type_aliases(ctx, rhs, report),
                },
            },
        )
    };
    result
}

fn normalized_type_alias_target(ctx: Checker, value: TypeAliasInfo) -> Type {
    expand_type_alias_inner(ctx, value.ty, Vec::[value.name], false)
}

fn resolve_signature_type(ctx: Checker, value: Type, predicates: Vec[TypePredicate], report: bool) -> Type {
    let value = expand_type_aliases(ctx, value, report);
    if report {
        validate_signature_type(ctx, value)
    } else {
        ()
    };
    resolve_projection_type(
        ctx,
        value,
        projection_candidates_from_predicates(ctx, predicates),
        report,
    )
}

fn resolve_trait_reference_method(
    ctx: Checker,
    reference: TraitRef,
    name: string,
    self_ty: Option[Type],
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    match find_trait(ctx, reference.name) {
        Some(info) => if info.generics.len() == reference.args.len() {
            match find_trait_method(info, name) {
                Some(method) => {
                    let resolved_self_ty = match self_ty {
                        Some(ty) => Option::Some(ty),
                        None => if method.params.is_empty() {
                            Option::Some(Type::Unit)
                        } else {
                            Option::None
                        },
                    };
                    validate_explicit_method_type_arguments(
                        ctx,
                        method.name,
                        "method",
                        method.generics,
                        method_explicit,
                    );
                    let substitutions = append_type_substitutions(
                        trait_substitutions(ctx, info, reference, resolved_self_ty),
                        instantiate_substitutions(ctx.counter, method.generics, method_explicit),
                    );
                    let params: Vec[Type] = Vec::[];
                    for param in method.params {
                        params.push(substitute_type(param, substitutions))
                    };
                    let callable = trait_callable(
                        reference.name,
                        reference.args,
                        name,
                        params,
                        substitute_type(method.ret_ty, substitutions),
                    );
                    let predicates = expand_implied_predicates(
                        ctx,
                        substitute_predicates(method.predicates, substitutions),
                    );
                    apply_predicate_equalities(predicates);
                    Option::Some(
                        ResolvedCallable {
                            callable: callable.callable,
                            ty: callable.ty,
                            predicates,
                        },
                    )
                },
                None => Option::None,
            }
        } else {
            Option::None
        },
        None => Option::None,
    }
}

fn expand_implied_predicates(ctx: Checker, predicates: Vec[TypePredicate]) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::[];
    for predicate in predicates {
        push_predicate(result, predicate)
    };
    let mut index = 0;
    while index < result.len() {
        let predicate = result[index];
        index += 1;
        match predicate {
            Trait { for_ty, trait_ref: reference } => {
                for application in trait_ref_closure(ctx, reference) {
                    push_predicate(result, TypePredicate::Trait { for_ty, trait_ref: application });
                    match find_trait(ctx, application.name) {
                        Some(info) => if info.generics.len() == application.args.len() {
                            let substitutions = trait_substitutions(
                                ctx,
                                info,
                                application,
                                Option::Some(for_ty),
                            );
                            for declared in info.predicates {
                                push_predicate(
                                    result,
                                    substitute_predicate(declared, substitutions),
                                )
                            };
                            for associated in info.associated_types {
                                let projection = Type::Projection {
                                    for_ty,
                                    name: associated.name,
                                    trait_ref: Option::Some(application),
                                };
                                for bound in associated.bounds {
                                    push_predicate(
                                        result,
                                        TypePredicate::Trait {
                                            for_ty: projection,
                                            trait_ref: substitute_trait_ref(bound, substitutions),
                                        },
                                    )
                                }
                            }
                        } else {
                            ()
                        },
                        None => (),
                    }
                }
            },
            Equality { lhs: _, rhs: _ } => (),
        }
    };
    result
}

fn resolve_predicate_method(ctx: Checker, receiver: Type, name: string, method_explicit: Vec[Type]) -> Option[
    ResolvedCallable,
] {
    let resolved: Vec[ResolvedCallable] = Vec::[];
    let candidates = text::StringBuilder::new();
    for predicate in ctx.predicates {
        match predicate {
            Trait { for_ty: bound_ty, trait_ref: reference } => {
                if types_equal(normalize_type(ctx, bound_ty), receiver) {
                    match resolve_trait_reference_method(
                        ctx,
                        reference,
                        name,
                        Option::Some(receiver),
                        method_explicit,
                    ) {
                        Some(value) => {
                            if candidates.is_empty() {
                                ()
                            } else {
                                candidates.write_string(", ")
                            };
                            candidates.write_string(short_name(reference.name));
                            resolved.push(value)
                        },
                        None => (),
                    }
                } else {
                    ()
                }
            },
            Equality { lhs: _, rhs: _ } => (),
        }
    };
    if resolved.len() == 1 {
        Option::Some(resolved[0])
    } else {
        if resolved.len() > 1 {
            push_diagnostic(
                ctx,
                f"Ambiguous method {name} for type {type_text(receiver)} (candidates: {candidates.finish()}). Use UFCS like Trait::{name}(...) to disambiguate",
            )
        } else {
            ()
        };
        if resolved.len() > 1 {
            Option::Some(
                ResolvedCallable {
                    callable: Callable::Function("<error>"),
                    ty: Type::Error,
                    predicates: Vec::[],
                },
            )
        } else {
            Option::None
        }
    }
}

fn resolve_trait_static(
    ctx: Checker,
    owner: string,
    name: string,
    explicit: Vec[Type],
    method_explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    if owner == "ToString" && name == "to_string" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], method_explicit);
        let receiver = fresh_type(ctx.counter, VarKind::Any);
        Option::Some(trait_callable(owner, explicit, name, one_type(receiver), Type::String))
    } else if owner == "Eq" && name == "eq" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], method_explicit);
        let receiver = fresh_type(ctx.counter, VarKind::Any);
        Option::Some(
            trait_callable(owner, explicit, name, two_types(receiver, receiver), Type::Bool),
        )
    } else if owner == "Hash" && name == "hash" {
        validate_explicit_method_type_arguments(ctx, name, "method", Vec::[], method_explicit);
        let receiver = fresh_type(ctx.counter, VarKind::Any);
        Option::Some(trait_callable(owner, explicit, name, one_type(receiver), Type::Uint64))
    } else {
        match find_trait(ctx, owner) {
            Some(info) => {
                let diagnostics_start = ctx.diagnostics.len();
                for value in explicit {
                    validate_signature_type(ctx, value)
                };
                if explicit.len() != info.generics.len() {
                    push_diagnostic(
                        ctx,
                        f"Trait {short_name(info.name)} expects {info.generics.len()} type arguments, but got {explicit.len()}",
                    )
                } else {
                    ()
                };
                if ctx.diagnostics.len() > diagnostics_start {
                    return Option::Some(
                        ResolvedCallable {
                            callable: Callable::Function("<error>"),
                            ty: fresh_unresolved_inference(ctx),
                            predicates: Vec::[],
                        },
                    )
                } else {
                    ()
                };
                let substitutions = instantiate_substitutions(ctx.counter, info.generics, explicit);
                let args: Vec[Type] = Vec::[];
                for generic in info.generics {
                    match find_substitution(substitutions, generic) {
                        Some(ty) => args.push(ty),
                        None => (),
                    }
                };
                let reference = TraitRef { name: info.name, args };
                match resolve_trait_reference_method(
                    ctx,
                    reference,
                    name,
                    Option::None,
                    method_explicit,
                ) {
                    Some(value) => Option::Some(value),
                    None => {
                        let resolved: Vec[ResolvedCallable] = Vec::[];
                        for candidate in trait_ref_closure(ctx, reference) {
                            if trait_ref_equal(candidate, reference) {
                                ()
                            } else {
                                match resolve_trait_reference_method(
                                    ctx,
                                    candidate,
                                    name,
                                    Option::None,
                                    method_explicit,
                                ) {
                                    Some(value) => resolved.push(value),
                                    None => (),
                                }
                            }
                        };
                        if resolved.len() == 1 {
                            Option::Some(resolved[0])
                        } else {
                            if resolved.len() > 1 {
                                push_diagnostic(ctx, f"ambiguous method: {name}")
                            } else {
                                ()
                            };
                            Option::None
                        }
                    },
                }
            },
            None => Option::None,
        }
    }
}

fn explicit_types(ctx: Checker, values: Vec[hir::TypeExpr]) -> Vec[Type] {
    let result: Vec[Type] = Vec::[];
    for value in values {
        result.push(type_from_hir(value, ctx.type_params, ctx.self_ty))
    };
    result
}

fn resolve_static_member(
    ctx: Checker,
    owner: string,
    member: string,
    owner_type_args: Vec[hir::TypeExpr],
    member_type_args: Vec[hir::TypeExpr],
) -> Option[ResolvedCallable] {
    let owner_explicit = explicit_types(ctx, owner_type_args);
    let method_explicit = explicit_types(ctx, member_type_args);
    let bare_owner = owner_explicit.is_empty();
    match explicit_function_scheme(ctx, owner, member) {
        Some(scheme) => {
            let value = instantiate_scheme_candidate(ctx, scheme, method_explicit);
            Option::Some(
                ResolvedCallable {
                    callable: value.callable,
                    ty: value.ty,
                    predicates: value.predicates,
                },
            )
        },
        None => match resolve_trait_static(ctx, owner, member, owner_explicit, method_explicit) {
            Some(value) => Option::Some(value),
            None => {
                let owner_ty = nominal_type(owner, owner_explicit);
                match resolve_user_method(
                    ctx,
                    owner_ty,
                    member,
                    Option::None,
                    true,
                    owner_explicit,
                    method_explicit,
                ) {
                    Some(value) => if bare_owner && nominal_type_is_defined(ctx, owner) {
                        Option::Some(
                            ResolvedCallable {
                                callable: match value.callable {
                                    InherentMethod { receiver_ty: _, method_name: name } => {
                                        Callable::InherentMethod {
                                            receiver_ty: owner_ty,
                                            method_name: name,
                                        }
                                    },
                                    other => other,
                                },
                                ty: value.ty,
                                predicates: value.predicates,
                            },
                        )
                    } else {
                        Option::Some(value)
                    },
                    None => resolve_builtin_static(ctx, owner_ty, member, method_explicit),
                }
            },
        },
    }
}

fn resolve_builtin_static(ctx: Checker, owner: Type, name: string, method_explicit: Vec[Type]) -> Option[
    ResolvedCallable,
] {
    let owner = match prune(owner) {
        Con { name: owner_name } => if owner_name == "Vec" {
            Type::VecType { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "Ref" {
            Type::RefType { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "Slice" {
            Type::Slice { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "HashMap" {
            Type::HashMap {
                key: fresh_type(ctx.counter, VarKind::Any),
                value: fresh_type(ctx.counter, VarKind::Any),
            }
        } else if owner_name == "Channel" {
            Type::Channel { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "FnIterator" {
            nominal_type(owner_name, one_type(fresh_type(ctx.counter, VarKind::Any)))
        } else {
            Type::Con { name: owner_name }
        },
        other => other,
    };
    match owner {
        VecType { elem } => if name == "new" {
            Option::Some(inherent_callable(owner, name, Vec::[], owner))
        } else if name == "with_capacity" {
            Option::Some(inherent_callable(owner, name, one_type(Type::Int), owner))
        } else {
            Option::None
        },
        RefType { elem } => if name == "new" {
            Option::Some(inherent_callable(owner, name, one_type(elem), owner))
        } else {
            Option::None
        },
        Channel { elem: _ } => if name == "new" {
            Option::Some(inherent_callable(owner, name, one_type(Type::Int), owner))
        } else {
            Option::None
        },
        HashMap { key: _, value: _ } => if name == "new" {
            Option::Some(inherent_callable(owner, name, Vec::[], owner))
        } else {
            Option::None
        },
        App { ty: base, args } => match type_constructor_name(base) {
            Some(owner_name) => if short_name(owner_name) == "Option"
                || short_name(owner_name) == "Result" {
                resolve_option_result_method(ctx, owner, owner_name, args, name, method_explicit)
            } else if owner_name == "FnIterator" && args.len() == 1 && name == "from_fn" {
                let item = args[0];
                Option::Some(
                    ResolvedCallable {
                        callable: Callable::InherentMethod { receiver_ty: owner, method_name: name },
                        ty: callable_type(
                            one_type(
                                Type::Func {
                                    params: Vec::[],
                                    ret_ty: nominal_type("Option", one_type(item)),
                                },
                            ),
                            owner,
                        ),
                        predicates: Vec::[],
                    },
                )
            } else {
                Option::None
            },
            None => Option::None,
        },
        _ => Option::None,
    }
}
