package anf;

use gomlc::ast;
use gomlc::core;
use gomlc::hir;
use gomlc::lift;
use gomlc::mono;
use gomlc::parser;
use gomlc::strings;
use gomlc::tast;
use std::testing;

fn lower_source(source: string) -> File {
    lower(
        lift::lower(
            mono::lower(
                core::lower(tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom"))),
            ),
        ),
    )
}

fn verifier_file(body: Block, ret_ty: tast::Type) -> File {
    let functions: Vec[Function] = Vec::[];
    functions.push(
        Function {
            name: "verify_test",
            origin: core::FunctionOrigin::Source,
            root: true,
            trait_impl: Option::None,
            params: Vec::[],
            ret_ty,
            body,
        },
    );
    File {
        functions,
        enums: Vec::[],
        structs: Vec::[],
        type_instances: Vec::[],
        constants: Vec::[],
    }
}

fn verifier_error_contains(result: Result[unit, string], expected: string) -> unit {
    match result {
        Ok(_) => testing::fail("expected ANF verification failure"),
        Err(message) => testing::assert(strings::contains(message, expected)),
    }
}

#[test]
fn verifies_lowered_anf() -> unit {
    match verify(lower_source("fn choose(flag: bool) -> int32 { if flag { 1 } else { 2 } }")) {
        Ok(_) => (),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn rejects_out_of_scope_join_jumps() -> unit {
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds: Vec::[],
                    term: Term::Jump { target: "missing", args: Vec::[], ret_ty: tast::Type::Unit },
                },
                tast::Type::Unit,
            ),
        ),
        "jump to out-of-scope join missing",
    )
}

#[test]
fn rejects_nonrecursive_self_jumps() -> unit {
    let join = JoinBind {
        name: "again",
        role: JoinRole::Continuation,
        params: Vec::[],
        ret_ty: tast::Type::Unit,
        body: Block {
            binds: Vec::[],
            term: Term::Jump { target: "again", args: Vec::[], ret_ty: tast::Type::Unit },
        },
    };
    let binds: Vec[Bind] = Vec::[];
    binds.push(Bind::Join(join));
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds,
                    term: Term::Jump { target: "again", args: Vec::[], ret_ty: tast::Type::Unit },
                },
                tast::Type::Unit,
            ),
        ),
        "jump to out-of-scope join again",
    )
}

#[test]
fn rejects_join_argument_mismatches() -> unit {
    let params: Vec[(string, tast::Type)] = Vec::[];
    params.push(("value", tast::Type::Int32));
    let join = JoinBind {
        name: "done",
        role: JoinRole::Continuation,
        params,
        ret_ty: tast::Type::Int32,
        body: Block {
            binds: Vec::[],
            term: Term::Return(Imm::Var { name: "value", ty: tast::Type::Int32 }),
        },
    };
    let binds: Vec[Bind] = Vec::[];
    binds.push(Bind::Join(join));
    verifier_error_contains(
        verify(
            verifier_file(
                Block {
                    binds,
                    term: Term::Jump { target: "done", args: Vec::[], ret_ty: tast::Type::Int32 },
                },
                tast::Type::Int32,
            ),
        ),
        "jump argument count does not match join done",
    )
}

#[test]
fn accepts_recursive_self_jumps() -> unit {
    let joins: Vec[JoinBind] = Vec::[];
    joins.push(
        JoinBind {
            name: "loop",
            role: JoinRole::Continuation,
            params: Vec::[],
            ret_ty: tast::Type::Unit,
            body: Block {
                binds: Vec::[],
                term: Term::Jump { target: "loop", args: Vec::[], ret_ty: tast::Type::Unit },
            },
        },
    );
    let binds: Vec[Bind] = Vec::[];
    binds.push(Bind::JoinRec(joins));
    match verify(
        verifier_file(
            Block {
                binds,
                term: Term::Jump { target: "loop", args: Vec::[], ret_ty: tast::Type::Unit },
            },
            tast::Type::Unit,
        ),
    ) {
        Ok(_) => (),
        Err(message) => testing::fail(message),
    }
}

#[test]
fn preserves_loop_exit_joins() -> unit {
    let join = JoinBind {
        name: "exit",
        role: JoinRole::LoopExit,
        params: Vec::[],
        ret_ty: tast::Type::Unit,
        body: Block {
            binds: Vec::[],
            term: Term::Return(Imm::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit }),
        },
    };
    let binds: Vec[Bind] = Vec::[];
    binds.push(Bind::Join(join));
    let optimized = simplify(
        verifier_file(
            Block {
                binds,
                term: Term::Jump { target: "exit", args: Vec::[], ret_ty: tast::Type::Unit },
            },
            tast::Type::Unit,
        ),
    );
    match optimized.functions[0].body.binds.get(0) {
        Join(value) => match value.role {
            LoopExit => (),
            _ => testing::fail("expected loop exit join"),
        },
        _ => testing::fail("expected loop exit join"),
    }
}

#[test]
fn does_not_propagate_assigned_bindings() -> unit {
    let binds: Vec[Bind] = Vec::[];
    binds.push(
        Bind::Let(
            LetBind {
                name: "value",
                value: Value::Imm(
                    Imm::Prim {
                        value: tast::Primitive::Int32 { value: "1" },
                        ty: tast::Type::Int32,
                    },
                ),
                ty: tast::Type::Int32,
            },
        ),
    );
    binds.push(
        Bind::Let(
            LetBind {
                name: "assigned",
                value: Value::Assign {
                    name: "value",
                    value: Imm::Prim {
                        value: tast::Primitive::Int32 { value: "2" },
                        ty: tast::Type::Int32,
                    },
                    target_ty: tast::Type::Int32,
                    ty: tast::Type::Unit,
                },
                ty: tast::Type::Unit,
            },
        ),
    );
    let optimized = simplify(
        verifier_file(
            Block { binds, term: Term::Return(Imm::Var { name: "value", ty: tast::Type::Int32 }) },
            tast::Type::Int32,
        ),
    );
    match optimized.functions[0].body.term {
        Return(Var { name, ty: _ }) => testing::assert_eq(name, "value"),
        _ => testing::fail("expected assigned binding reference"),
    }
}

#[test]
fn advances_shared_counter_before_simplification() -> unit {
    let lowered = lift::lower(
        mono::lower(
            core::lower(
                tast::check(
                    hir::lower(
                        ast::lower(parser::parse("fn main() -> unit { println(1) }")),
                        "main.gom",
                    ),
                ),
            ),
        ),
    );
    let counter = Ref::new(61);
    let _ = lower_with_counter(lowered, counter);
    testing::assert_eq(counter.get(), 63)
}

#[test]
fn simplifies_linear_aliases_and_tuple_projections() -> unit {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let mtmp0 = () in\n  let t8 = (true, false) in\n  let a/0 = (true, false, t8) in\n  let x1 = true in\n  let x2 = false in\n  let x3 = t8 in\n  let x4 = true in\n  let x5 = false in\n  let w/4 = false in\n  let z/3 = true in\n  let y/2 = false in\n  let x/1 = true in\n  let b/5 = false in\n  let mtmp6 = print(false) in\n  ()\n}",
    )
}

#[test]
fn simplifies_if_continuation_and_return_joins() -> unit {
    let source = "fn choose(flag: bool, x: int32, y: int32) -> int32 { if flag { x } else { y } } fn main() { let yes = choose(true, 10, 99); let no = choose(false, 10, 99); let _ = println(\"yes=\" + yes.to_string()); let _ = println(\"no=\" + no.to_string()); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn choose(flag/0: bool, x/1: int32, y/2: int32) -> int32 {\n  if flag/0 {\n    x/1\n  } else {\n    y/2\n  }\n}\n\nfn main() -> unit {\n  let yes/3 = choose(true, 10, 99) in\n  let no/4 = choose(false, 10, 99) in\n  let t7 = inherent#int32#int32#to_string(yes/3) in\n  let t8 = (\"yes=\" + t7) in\n  let mtmp0 = println(t8) in\n  let t9 = inherent#int32#int32#to_string(no/4) in\n  let t10 = (\"no=\" + t9) in\n  let mtmp1 = println(t10) in\n  ()\n}",
    )
}

#[test]
fn simplifies_known_constructor_matches_and_projections() -> unit {
    let source = "enum T { A, B(bool, unit) } fn main() { let t = B(true, ()); match t { A => println((1).to_string()), B(true, ()) => println((2).to_string()), B(false, ()) => println((3).to_string()), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let t/0 = T::B(true, ()) in\n  let x0 = true in\n  let x1 = () in\n  let t8 = inherent#int#int#to_string(2) in\n  let t9 = println(t8) in\n  ()\n}",
    )
}

#[test]
fn lowers_while_loops_through_recursive_joins() -> unit {
    let source = "fn main() { let i = Ref::new(0); while i.get() < 10 { if i.get() == 5 { break } else { () }; let _ = println(i.get()); i.set(i.get() + 1); }; let _ = println(\"done\"); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let i/0 = inherent#Ref#Ref[int]#new(0) in\n  join exit6() -> unit {\n    let _wild3 = () in\n    let mtmp4 = println(\"done\") in\n    ()\n  } in\n  joinrec {\n    join loop7() -> unit {\n      let t8 = inherent#Ref#Ref[int]#get(i/0) in\n      let t9 = (t8 < 10) in\n      if t9 {\n        let t14 = inherent#Ref#Ref[int]#get(i/0) in\n        let t15 = trait_impl#Eq#int#eq(t14, 5) in\n        join k10() -> unit {\n          let _wild0 = () in\n          let t11 = inherent#Ref#Ref[int]#get(i/0) in\n          let mtmp1 = println(t11) in\n          let t12 = inherent#Ref#Ref[int]#get(i/0) in\n          let t13 = (t12 + 1) in\n          let _wild2 = inherent#Ref#Ref[int]#set(i/0, t13) in\n          jump loop7()\n        } in\n        if t15 {\n          jump exit6()\n        } else {\n          jump k10()\n        }\n      } else {\n        jump exit6()\n      }\n    } in\n  } in\n  jump loop7()\n}",
    )
}

#[test]
fn uses_unreachable_continuations_for_exiting_branches() -> unit {
    let source = "fn f(flag: int32) -> int32 { while true { if flag == 0 { return 1 } else { break }; }; 2 } fn main() -> unit { println(f(0).to_string()); println(f(1).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn f(flag/0: int32) -> int32 {\n  join exit6() -> int32 {\n    let _wild1 = () in\n    2\n  } in\n  joinrec {\n    join loop7() -> int32 {\n      let t9 = trait_impl#Eq#int32#eq(flag/0, 0) in\n      if t9 {\n        1\n      } else {\n        jump exit6()\n      }\n    } in\n  } in\n  jump loop7()\n}\n\nfn main() -> unit {\n  let t11 = f(0) in\n  let t12 = inherent#int32#int32#to_string(t11) in\n  let _wild2 = println(t12) in\n  let t13 = f(1) in\n  let t14 = inherent#int32#int32#to_string(t13) in\n  let _wild3 = println(t14) in\n  ()\n}",
    )
}

#[test]
fn preserves_typed_exiting_loop_conditions() -> unit {
    let source = "fn loop_return_unit(flag: bool) -> unit { while if flag { return } else { return } { println(\"unreachable\"); }; } fn loop_return() -> int32 { while match 0 { _ => return 5, } { println(\"unreachable\"); }; 0 } fn main() -> unit { loop_return_unit(true); println(loop_return()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn loop_return_unit(flag/0: bool) -> unit {\n  joinrec {\n    join loop9() -> unit {\n      if flag/0 {\n        ()\n      } else {\n        ()\n      }\n    } in\n  } in\n  jump loop9()\n}\n\nfn loop_return() -> int32 {\n  joinrec {\n    join loop15() -> int32 {\n      let mtmp2 = 0 in\n      5\n    } in\n  } in\n  jump loop15()\n}\n\nfn main() -> unit {\n  let _wild5 = loop_return_unit(true) in\n  let t17 = loop_return() in\n  let _wild6 = println(t17) in\n  ()\n}",
    )
}

#[test]
fn retains_failed_linear_probe_names() -> unit {
    let source = "fn main() { let x = Ref::new(0); let result = Ref::new(\"\"); while x.get() < 5 { let current = x.get(); result.set(result.get() + match current { 0 => \"zero\", 1 => \"one\", 2 => \"two\", _ => \"many\", } + \" \" ); x.set(current + 1); }; println(result.get()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let x/0 = inherent#Ref#Ref[int]#new(0) in\n  let result/1 = inherent#Ref#Ref[string]#new(\"\") in\n  join exit5() -> unit {\n    let _wild2 = () in\n    let t6 = inherent#Ref#Ref[string]#get(result/1) in\n    let _wild3 = println(t6) in\n    ()\n  } in\n  joinrec {\n    join loop7() -> unit {\n      let t8 = inherent#Ref#Ref[int]#get(x/0) in\n      let t9 = (t8 < 5) in\n      if t9 {\n        let current/2 = inherent#Ref#Ref[int]#get(x/0) in\n        let t11 = inherent#Ref#Ref[string]#get(result/1) in\n        join k12(jp13: string) -> unit {\n          let t14 = (t11 + jp13) in\n          let t15 = (t14 + \" \") in\n          let _wild0 = inherent#Ref#Ref[string]#set(result/1, t15) in\n          let t16 = (current/2 + 1) in\n          let _wild1 = inherent#Ref#Ref[int]#set(x/0, t16) in\n          jump loop7()\n        } in\n        match current/2 {\n          0 => {\n            jump k12(\"zero\")\n          },\n          1 => {\n            jump k12(\"one\")\n          },\n          2 => {\n            jump k12(\"two\")\n          },\n          _ => {\n            jump k12(\"many\")\n          },\n        }\n      } else {\n        jump exit5()\n      }\n    } in\n  } in\n  jump loop7()\n}",
    )
}
