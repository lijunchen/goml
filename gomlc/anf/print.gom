package anf;

use gomlc::strings;
use gomlc::tast;
use std::text;

fn write_spaces(builder: text::StringBuilder, count: int) -> unit {
    for _ in range(0, count) {
        builder.write_char(' ')
    }
}

fn newline(builder: text::StringBuilder, indent: int) -> unit {
    builder.write_char('\n');
    write_spaces(builder, indent)
}

fn dyn_method_name(value: string) -> string {
    match strings::rfind(value, "#") {
        Some(index) => value.byte_slice(index + 1, value.byte_len()),
        None => value,
    }
}

fn write_callable(builder: text::StringBuilder, value: tast::Callable) -> unit {
    match value {
        Function(name) => builder.write_string(name),
        Runtime(name) => {
            builder.write_string("@runtime(");
            builder.write_string(name);
            builder.write_char(')')
        },
        Intrinsic(name) => {
            builder.write_string("@intrinsic(");
            builder.write_string(name);
            builder.write_char(')')
        },
        TraitMethod { trait_ref: reference, method_name: name } => {
            tast::write_trait_ref(builder, reference);
            builder.write_string("::");
            builder.write_string(name)
        },
        DynTraitMethod { trait_name: owner, dispatch_name: dispatch, method_name: name } => {
            builder.write_string("dyn ");
            builder.write_string(owner);
            builder.write_string(" via ");
            builder.write_string(dispatch);
            builder.write_string("::");
            builder.write_string(name)
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            tast::write_type(builder, owner);
            builder.write_string("::");
            builder.write_string(name)
        },
    }
}

fn write_imm(builder: text::StringBuilder, value: Imm) -> unit {
    match value {
        Var { name, ty: _ } => builder.write_string(name),
        Callable { callable, ty: _ } => write_callable(builder, callable),
        Prim { value, ty: _ } => tast::write_primitive(builder, value),
        Tag { index, ty: _ } => {
            builder.write_string("Tag_");
            builder.write_string(index.to_string())
        },
    }
}

fn write_imms(builder: text::StringBuilder, values: Vec[Imm]) -> unit {
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        write_imm(builder, values[index])
    }
}

fn write_constructor(builder: text::StringBuilder, constructor: tast::Constructor, args: Vec[Imm]) -> unit {
    builder.write_string(constructor.name);
    if constructor.is_struct {
        if constructor.fields.len() == 0 && args.len() == 0 {
            builder.write_string(" {}")
        } else if constructor.fields.len() == args.len() {
            builder.write_string(" { ");
            for index in range(0, args.len()) {
                if index > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                builder.write_string(constructor.fields[index]);
                builder.write_string(": ");
                write_imm(builder, args[index])
            };
            builder.write_string(" }")
        } else if args.len() > 0 {
            builder.write_char('(');
            write_imms(builder, args);
            builder.write_char(')')
        } else {
            ()
        }
    } else if args.len() > 0 {
        builder.write_char('(');
        write_imms(builder, args);
        builder.write_char(')')
    } else {
        ()
    }
}

fn write_value(builder: text::StringBuilder, value: Value) -> unit {
    match value {
        Imm(value) => write_imm(builder, value),
        Constr { constructor, args, ty: _ } => {
            write_constructor(builder, constructor, args)
        },
        Tuple { items, ty: _ } => {
            builder.write_char('(');
            write_imms(builder, items);
            builder.write_char(')')
        },
        Array { items, ty: _ } => {
            builder.write_char('[');
            write_imms(builder, items);
            builder.write_char(']')
        },
        ConstrGet { expr, constructor, field_index: index, ty: _ } => {
            if constructor.is_struct && index < constructor.fields.len() {
                builder.write_string(constructor.name);
                builder.write_char('.');
                builder.write_string(constructor.fields[index])
            } else {
                builder.write_string(constructor.name);
                builder.write_string("._");
                builder.write_string(index.to_string())
            };
            builder.write_char('(');
            write_imm(builder, expr);
            builder.write_char(')')
        },
        Unary { op, expr, ty: _ } => {
            builder.write_char('(');
            builder.write_string(tast::unary_symbol(op));
            write_imm(builder, expr);
            builder.write_char(')')
        },
        Cast { expr, ty } => {
            builder.write_char('(');
            write_imm(builder, expr);
            builder.write_string(" as ");
            tast::write_type(builder, ty);
            builder.write_char(')')
        },
        Binary { op, lhs, rhs, ty: _ } => {
            builder.write_char('(');
            write_imm(builder, lhs);
            builder.write_char(' ');
            builder.write_string(tast::binary_symbol(op));
            builder.write_char(' ');
            write_imm(builder, rhs);
            builder.write_char(')')
        },
        Assign { name, value, target_ty: _, ty: _ } => {
            builder.write_string(name);
            builder.write_string(" = ");
            write_imm(builder, value)
        },
        Call { func, args, ty: _ } => {
            write_imm(builder, func);
            builder.write_char('(');
            write_imms(builder, args);
            builder.write_char(')')
        },
        ToDyn { trait_name, for_ty, expr, ty: _ } => {
            builder.write_string("to_dyn[");
            builder.write_string(trait_name);
            builder.write_string("]{");
            tast::write_type(builder, for_ty);
            builder.write_string("}(");
            write_imm(builder, expr);
            builder.write_char(')')
        },
        DynCall { trait_name, method_name, receiver, args, ty: _ } => {
            builder.write_string("dyn_call[");
            builder.write_string(trait_name);
            builder.write_string("::");
            builder.write_string(dyn_method_name(method_name));
            builder.write_string("](");
            write_imm(builder, receiver);
            if args.len() > 0 {
                builder.write_string(", ");
                write_imms(builder, args)
            } else {
                ()
            };
            builder.write_char(')')
        },
        Go { closure, ty: _ } => {
            builder.write_string("go ");
            write_imm(builder, closure)
        },
        Proj { tuple, index, ty: _ } => {
            write_imm(builder, tuple);
            builder.write_char('.');
            builder.write_string(index.to_string())
        },
    }
}

fn write_params(builder: text::StringBuilder, values: Vec[(string, tast::Type)]) -> unit {
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        let value = values[index];
        builder.write_string(value.0);
        builder.write_string(": ");
        tast::write_type(builder, value.1)
    }
}

fn write_join(builder: text::StringBuilder, value: JoinBind, indent: int) -> unit {
    builder.write_string("join ");
    builder.write_string(value.name);
    builder.write_char('(');
    write_params(builder, value.params);
    builder.write_string(") -> ");
    tast::write_type(builder, value.ret_ty);
    builder.write_string(" {");
    newline(builder, indent + 2);
    write_block(builder, value.body, indent + 2);
    newline(builder, indent);
    builder.write_string("} in")
}

fn write_bind(builder: text::StringBuilder, value: Bind, indent: int) -> unit {
    match value {
        Let(value) => {
            builder.write_string("let ");
            builder.write_string(value.name);
            builder.write_string(" = ");
            write_value(builder, value.value);
            builder.write_string(" in")
        },
        Join(value) => write_join(builder, value, indent),
        JoinRec(values) => {
            builder.write_string("joinrec {");
            for value in values {
                newline(builder, indent + 2);
                write_join(builder, value, indent + 2)
            };
            newline(builder, indent);
            builder.write_string("} in")
        },
    }
}

fn write_arm(builder: text::StringBuilder, value: Arm, indent: int) -> unit {
    write_imm(builder, value.lhs);
    builder.write_string(" => {");
    newline(builder, indent + 2);
    write_block(builder, value.body, indent + 2);
    newline(builder, indent);
    builder.write_string("},")
}

fn write_term(builder: text::StringBuilder, value: Term, indent: int) -> unit {
    match value {
        Return(value) => write_imm(builder, value),
        Jump { target, args, ret_ty: _ } => {
            builder.write_string("jump ");
            builder.write_string(target);
            builder.write_char('(');
            write_imms(builder, args);
            builder.write_char(')')
        },
        If { cond, then_, else_, ret_ty: _ } => {
            builder.write_string("if ");
            write_imm(builder, cond);
            builder.write_string(" {");
            newline(builder, indent + 2);
            write_block(builder, then_, indent + 2);
            newline(builder, indent);
            builder.write_string("} else {");
            newline(builder, indent + 2);
            write_block(builder, else_, indent + 2);
            newline(builder, indent);
            builder.write_char('}')
        },
        Match { scrutinee, arms, default, ret_ty: _ } => {
            builder.write_string("match ");
            write_imm(builder, scrutinee);
            builder.write_string(" {");
            for arm in arms {
                newline(builder, indent + 2);
                write_arm(builder, arm, indent + 2)
            };
            match default {
                Some(default) => {
                    newline(builder, indent + 2);
                    builder.write_string("_ => {");
                    newline(builder, indent + 4);
                    write_block(builder, default, indent + 4);
                    newline(builder, indent + 2);
                    builder.write_string("},")
                },
                None => (),
            };
            newline(builder, indent);
            builder.write_char('}')
        },
        Unreachable { ty: _ } => builder.write_string("unreachable"),
    }
}

fn write_block(builder: text::StringBuilder, value: Block, indent: int) -> unit {
    for bind in value.binds {
        write_bind(builder, bind, indent);
        newline(builder, indent)
    };
    write_term(builder, value.term, indent)
}

fn write_function(builder: text::StringBuilder, value: Function) -> unit {
    builder.write_string("fn ");
    builder.write_string(value.name);
    builder.write_char('(');
    write_params(builder, value.params);
    builder.write_string(") -> ");
    tast::write_type(builder, value.ret_ty);
    builder.write_string(" {");
    newline(builder, 2);
    write_block(builder, value.body, 2);
    newline(builder, 0);
    builder.write_char('}')
}

pub fn encode(value: File) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, value.constants.len()) {
        if index > 0 {
            builder.write_char('\n')
        } else {
            ()
        };
        tast::write_constant(builder, value.constants[index])
    };
    if value.constants.len() > 0 && value.functions.len() > 0 {
        builder.write_string("\n\n")
    } else {
        ()
    };
    for index in range(0, value.functions.len()) {
        if index > 0 {
            builder.write_string("\n\n")
        } else {
            ()
        };
        write_function(builder, value.functions[index])
    };
    builder.finish()
}
