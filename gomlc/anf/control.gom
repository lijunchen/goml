package anf;

use gomlc::core;
use gomlc::tast;

fn reify_k_with_name(
    state: State,
    name: string,
    role: JoinRole,
    value_ty: tast::Type,
    k: (Imm) -> Block,
) -> (JoinBind, tast::Type) {
    if type_is_unit(value_ty) {
        let body = k(unit_imm());
        let ret_ty = block_type(body);
        (JoinBind { name, role, params: Vec::[], ret_ty, body }, ret_ty)
    } else {
        let param = fresh(state, "jp");
        let body = k(Imm::Var { name: param, ty: value_ty });
        let ret_ty = block_type(body);
        let params: Vec[(string, tast::Type)] = Vec::[];
        params.push((param, value_ty));
        (JoinBind { name, role, params, ret_ty, body }, ret_ty)
    }
}

fn reify_k(state: State, value_ty: tast::Type, k: (Imm) -> Block) -> (JoinBind, tast::Type) {
    reify_k_with_name(state, fresh(state, "k"), JoinRole::Continuation, value_ty, k)
}

fn reify_k_for_expr(state: State, value: core::Expr, k: (Imm) -> Block) -> (JoinBind, tast::Type) {
    let value_ty = if type_is_error(core::expr_type(value)) && expr_always_exits(value) {
        tast::Type::Unit
    } else {
        core::expr_type(value)
    };
    if type_is_unit_or_never(value_ty) && expr_always_exits(value) {
        let name = fresh(state, "k");
        let ret_ty = block_type(k(unit_imm()));
        (
            JoinBind {
                name,
                role: JoinRole::Continuation,
                params: Vec::[],
                ret_ty,
                body: Block { binds: no_binds(), term: Term::Unreachable { ty: ret_ty } },
            },
            ret_ty,
        )
    } else {
        reify_k(state, value_ty, k)
    }
}

fn lower_core_stmts(
    state: State,
    stmts: Vec[core::LetStmt],
    index: int,
    tail: Option[core::Expr],
    k: (Imm) -> Block,
) -> Block {
    if index >= stmts.len() {
        match tail {
            Some(value) => lower_expr(state, value, k),
            None => k(unit_imm()),
        }
    } else {
        let stmt = stmts[index];
        let value_ty = core::expr_type(stmt.value);
        if expr_is_control(stmt.value) {
            lower_expr(
                state,
                stmt.value,
                |value| {
                    let block = lower_core_stmts(state, stmts, index + 1, tail, k);
                    prepend_bind(
                        Bind::Let(
                            LetBind { name: stmt.name, value: Value::Imm(value), ty: value_ty },
                        ),
                        block,
                    )
                },
            )
        } else {
            lower_value(
                state,
                stmt.value,
                |value| {
                    let ty = value_type(value);
                    let block = lower_core_stmts(state, stmts, index + 1, tail, k);
                    prepend_bind(Bind::Let(LetBind { name: stmt.name, value, ty }), block)
                },
            )
        }
    }
}

fn lower_core_block(state: State, value: core::Block, k: (Imm) -> Block) -> Block {
    lower_core_stmts(state, value.stmts, 0, value.tail, k)
}

fn lower_branch(
    state: State,
    value: core::Expr,
    join_id: string,
    join_ret_ty: tast::Type,
    join_takes_arg: bool,
) -> Block {
    lower_expr(
        state,
        value,
        |value| {
            jump_block(join_id, value, join_takes_arg, join_ret_ty)
        },
    )
}

fn lower_if(
    state: State,
    cond: core::Expr,
    then_: core::Expr,
    else_: core::Expr,
    ty: tast::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = core::Expr::If { cond, then_branch: then_, else_branch: else_, ty };
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_id = join.name;
    let takes_arg = !join.params.is_empty();
    lower_expr(
        state,
        cond,
        |cond| {
            let then_block = lower_branch(state, then_, join_id, ret_ty, takes_arg);
            let else_block = lower_branch(state, else_, join_id, ret_ty, takes_arg);
            Block {
                binds: one_bind(Bind::Join(join)),
                term: Term::If { cond, then_: then_block, else_: else_block, ret_ty },
            }
        },
    )
}

fn lower_arms(
    state: State,
    values: Vec[core::Arm],
    join_id: string,
    join_ret_ty: tast::Type,
    join_takes_arg: bool,
) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::[];
    for value in values {
        result.push(
            Arm {
                lhs: match_imm(value.lhs),
                body: lower_branch(state, value.body, join_id, join_ret_ty, join_takes_arg),
            },
        )
    };
    result
}

fn lower_match(
    state: State,
    scrutinee: core::Expr,
    arms: Vec[core::Arm],
    default: Option[core::Expr],
    ty: tast::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = core::Expr::Match { expr: scrutinee, arms, default, ty };
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_id = join.name;
    let takes_arg = !join.params.is_empty();
    lower_expr(
        state,
        scrutinee,
        |scrutinee| {
            let lowered_arms = lower_arms(state, arms, join_id, ret_ty, takes_arg);
            let lowered_default = match default {
                Some(value) => Option::Some(lower_branch(state, value, join_id, ret_ty, takes_arg)),
                None => Option::None,
            };
            Block {
                binds: one_bind(Bind::Join(join)),
                term: Term::Match {
                    scrutinee,
                    arms: lowered_arms,
                    default: lowered_default,
                    ret_ty,
                },
            }
        },
    )
}

fn lower_while(state: State, cond: core::Expr, body: core::Expr, k: (Imm) -> Block) -> Block {
    let exit_id = fresh(state, "exit");
    let exit_body = k(unit_imm());
    let exit_ret_ty = block_type(exit_body);
    let exit = JoinBind {
        name: exit_id,
        role: JoinRole::LoopExit,
        params: Vec::[],
        ret_ty: exit_ret_ty,
        body: exit_body,
    };
    let loop_id = fresh(state, "loop");
    state.loop_ctxs.push(LoopCtx { loop_id, exit_id, exit_ret_ty, exit_takes_arg: false });
    let loop_body = lower_expr(
        state,
        cond,
        |cond| {
            let then_block = lower_expr(
                state,
                body,
                |_| {
                    Block {
                        binds: no_binds(),
                        term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty },
                    }
                },
            );
            let else_block = Block {
                binds: no_binds(),
                term: Term::Jump { target: exit_id, args: no_imms(), ret_ty: exit_ret_ty },
            };
            Block {
                binds: no_binds(),
                term: Term::If { cond, then_: then_block, else_: else_block, ret_ty: exit_ret_ty },
            }
        },
    );
    let _ = state.loop_ctxs.pop();
    let recursive: Vec[JoinBind] = Vec::[];
    recursive.push(
        JoinBind {
            name: loop_id,
            role: JoinRole::Continuation,
            params: Vec::[],
            ret_ty: exit_ret_ty,
            body: loop_body,
        },
    );
    let binds: Vec[Bind] = Vec::[];
    binds.push(Bind::Join(exit));
    binds.push(Bind::JoinRec(recursive));
    Block { binds, term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty } }
}

fn lower_loop(state: State, body: core::Expr, ty: tast::Type, k: (Imm) -> Block) -> Block {
    let exit_result = reify_k_with_name(state, fresh(state, "exit"), JoinRole::LoopExit, ty, k);
    let exit = exit_result.0;
    let exit_ret_ty = exit_result.1;
    let exit_id = exit.name;
    let exit_takes_arg = !exit.params.is_empty();
    let loop_id = fresh(state, "loop_expr");
    state.loop_ctxs.push(LoopCtx { loop_id, exit_id, exit_ret_ty, exit_takes_arg });
    let loop_body = lower_expr(
        state,
        body,
        |_| {
            Block {
                binds: no_binds(),
                term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty },
            }
        },
    );
    let _ = state.loop_ctxs.pop();
    let recursive: Vec[JoinBind] = Vec::[];
    recursive.push(
        JoinBind {
            name: loop_id,
            role: JoinRole::Continuation,
            params: Vec::[],
            ret_ty: exit_ret_ty,
            body: loop_body,
        },
    );
    let binds: Vec[Bind] = Vec::[];
    binds.push(Bind::Join(exit));
    binds.push(Bind::JoinRec(recursive));
    Block { binds, term: Term::Jump { target: loop_id, args: no_imms(), ret_ty: exit_ret_ty } }
}

fn lower_return(state: State, value: Option[core::Expr]) -> Block {
    match state.return_ctx.get() {
        Some(ctx) => match value {
            Some(value) => lower_expr(
                state,
                value,
                |value| {
                    jump_block(ctx.join_id, value, ctx.takes_arg, ctx.ret_ty)
                },
            ),
            None => Block {
                binds: no_binds(),
                term: Term::Jump { target: ctx.join_id, args: no_imms(), ret_ty: ctx.ret_ty },
            },
        },
        None => Block { binds: no_binds(), term: Term::Unreachable { ty: tast::Type::Error } },
    }
}

fn loop_context(state: State, target: int) -> Option[LoopCtx] {
    if target < 0 || target >= state.loop_ctxs.len() {
        Option::None
    } else {
        Option::Some(state.loop_ctxs[state.loop_ctxs.len() - 1 - target])
    }
}

fn lower_expr(state: State, value: core::Expr, k: (Imm) -> Block) -> Block {
    match try_imm(value) {
        Some(value) => k(value),
        None => match value {
            Block { block, ty: _ } => lower_core_block(state, block, k),
            If { cond, then_branch: then_, else_branch: else_, ty } => {
                lower_if(state, cond, then_, else_, ty, k)
            },
            Match { expr: scrutinee, arms, default, ty } => {
                lower_match(state, scrutinee, arms, default, ty, k)
            },
            While { cond, body, ty: _ } => lower_while(state, cond, body, k),
            Loop { body, ty } => lower_loop(state, body, ty, k),
            Break { target, value, ty: _ } => match loop_context(state, target) {
                Some(ctx) => match value {
                    Some(expr) => lower_expr(
                        state,
                        expr,
                        |value| {
                            jump_block(ctx.exit_id, value, ctx.exit_takes_arg, ctx.exit_ret_ty)
                        },
                    ),
                    None => jump_block(ctx.exit_id, unit_imm(), ctx.exit_takes_arg, ctx.exit_ret_ty),
                },
                None => Block {
                    binds: no_binds(),
                    term: Term::Unreachable { ty: tast::Type::Error },
                },
            },
            Continue { target, ty: _ } => match loop_context(state, target) {
                Some(ctx) => Block {
                    binds: no_binds(),
                    term: Term::Jump {
                        target: ctx.loop_id,
                        args: no_imms(),
                        ret_ty: ctx.exit_ret_ty,
                    },
                },
                None => Block {
                    binds: no_binds(),
                    term: Term::Unreachable { ty: tast::Type::Error },
                },
            },
            Return { expr: value, ty: _ } => lower_return(state, value),
            Closure { params: _, body: _, ty: _ } | TraitCall { .. } => {
                k(unit_imm())
            },
            other => lower_imm(state, other, k),
        },
    }
}
