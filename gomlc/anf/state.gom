package anf;

use gomlc::ast;
use gomlc::core;
use gomlc::tast;

struct LoopCtx {
    loop_id: string,
    exit_id: string,
    exit_ret_ty: tast::Type,
    exit_takes_arg: bool,
}

struct ReturnCtx {
    join_id: string,
    ret_ty: tast::Type,
    takes_arg: bool,
}

struct State {
    counter: Ref[int],
    loop_ctx: Ref[Option[LoopCtx]],
    return_ctx: Ref[Option[ReturnCtx]],
}

fn fresh(state: State, prefix: string) -> string {
    let index = state.counter.get();
    state.counter.set(index + 1);
    prefix + index.to_string()
}

fn unit_imm() -> Imm {
    Imm::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit }
}

fn type_is_unit(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        Unit => true,
        _ => false,
    }
}

fn type_is_unit_or_never(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        Unit | Never => true,
        _ => false,
    }
}

fn type_is_error(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        Error => true,
        _ => false,
    }
}

fn no_imms() -> Vec[Imm] {
    Vec::[]
}

fn one_imm(value: Imm) -> Vec[Imm] {
    let result: Vec[Imm] = Vec::[];
    result.push(value);
    result
}

fn no_binds() -> Vec[Bind] {
    Vec::[]
}

fn one_bind(value: Bind) -> Vec[Bind] {
    let result: Vec[Bind] = Vec::[];
    result.push(value);
    result
}

fn prepend_bind(value: Bind, block: Block) -> Block {
    let binds: Vec[Bind] = Vec::[];
    binds.push(value);
    for bind in block.binds {
        binds.push(bind)
    };
    Block { binds, term: block.term }
}

fn jump_block(target: string, value: Imm, takes_arg: bool, ret_ty: tast::Type) -> Block {
    Block {
        binds: no_binds(),
        term: Term::Jump {
            target,
            args: if takes_arg {
                one_imm(value)
            } else {
                no_imms()
            },
            ret_ty,
        },
    }
}

fn expr_is_control(value: core::Expr) -> bool {
    match value {
        Block { block: _, ty: _ } | If { cond: _, then_branch: _, else_branch: _, ty: _ } | Match {
            expr: _,
            arms: _,
            default: _,
            ty: _,
        } | While { cond: _, body: _, ty: _ } | Loop { body: _, ty: _ } | Break { ty: _, .. } | Continue {
            ty: _,
        } | Return { expr: _, ty: _ } => true,
        _ => false,
    }
}

fn match_has_catch_all(arms: Vec[core::Arm], default: Option[core::Expr]) -> bool {
    match default {
        Some(_) => return true,
        None => (),
    };
    for arm in arms {
        match arm.lhs {
            Var { name: _, ty: _ } => return true,
            _ => (),
        }
    };
    false
}

fn expr_always_exits(value: core::Expr) -> bool {
    match value {
        Break { ty: _, .. } | Continue { ty: _ } | Return { expr: _, ty: _ } => true,
        Constr { constructor: _, args, ty: _ } => exprs_always_exit(args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            exprs_always_exit(items)
        },
        Closure { params: _, body, ty: _ } => expr_always_exits(body),
        Block { block, ty: _ } => block_always_exits(block),
        If { cond: _, then_branch: then_, else_branch: else_, ty: _ } => {
            expr_always_exits(then_) && expr_always_exits(else_)
        },
        Match { expr: _, arms, default, ty: _ } => {
            if !match_has_catch_all(arms, default) {
                return false
            } else {
                ()
            };
            for arm in arms {
                if expr_always_exits(arm.body) {
                    ()
                } else {
                    return false
                }
            };
            match default {
                Some(value) => if expr_always_exits(value) {
                    ()
                } else {
                    return false
                },
                None => (),
            };
            true
        },
        While { cond, body: _, ty: _ } => expr_always_exits(cond),
        Loop { body: _, ty } => match tast::resolve_type(ty) {
            Never => true,
            _ => false,
        },
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => expr_always_exits(expr),
        Binary { op, lhs, rhs, ty: _ } => {
            expr_always_exits(lhs)
                || match op {
                    And | Or => false,
                    _ => expr_always_exits(rhs),
                }
        },
        Assign { name: _, value: expr, target_ty: _, ty: _ } => expr_always_exits(expr),
        Call { func, args, ty: _ } => {
            expr_always_exits(func) || exprs_always_exit(args)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } | TraitCall {
            receiver,
            args,
            ..,
        } => {
            expr_always_exits(receiver) || exprs_always_exit(args)
        },
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } => false,
    }
}

fn exprs_always_exit(values: Vec[core::Expr]) -> bool {
    for value in values {
        if expr_always_exits(value) {
            return true
        } else {
            ()
        }
    };
    false
}

fn block_always_exits(value: core::Block) -> bool {
    for stmt in value.stmts {
        if expr_always_exits(stmt.value) {
            return true
        } else {
            ()
        }
    };
    match value.tail {
        Some(value) => expr_always_exits(value),
        None => false,
    }
}
