package interface_codec;

use gomlc::artifact_wire as wire;

use gomlc::artifact_model;
use gomlc::artifact_type_codec as type_codec;
use gomlc::artifact_callable_codec as callable_codec;

use gomlc::tast;

pub fn artifact_decode_predicates(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[tast::TypePredicate],
    string,
] {
    let values = type_codec::artifact_json_array(value, "type predicates")?;
    let result: Vec[tast::TypePredicate] = Vec::[];
    for value in values {
        result.push(type_codec::artifact_decode_predicate(context, value)?)
    };
    Result::Ok(result)
}

pub fn artifact_decode_trait_refs(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[tast::TraitRef],
    string,
] {
    let values = type_codec::artifact_json_array(value, "trait references")?;
    let result: Vec[tast::TraitRef] = Vec::[];
    for value in values {
        result.push(type_codec::artifact_decode_trait_ref(context, value)?)
    };
    Result::Ok(result)
}

pub fn artifact_decode_fn_scheme(context: type_codec::ArtifactDecodeContext, name: string, value: wire::ArtifactValue) -> Result[
    artifact_model::ArtifactFnScheme,
    string,
] {
    let object = type_codec::artifact_json_object(value, "function scheme")?;
    let type_params = type_codec::artifact_decode_string_array(
        type_codec::artifact_json_required_field(object, "type_params")?,
        "type parameters",
    )?;
    let constraints = artifact_decode_predicates(
        context,
        type_codec::artifact_json_required_field(object, "constraints")?,
    )?;
    let ty = type_codec::artifact_decode_type(context, type_codec::artifact_json_required_field(object, "ty")?)?;
    let body = match type_codec::artifact_json_optional_field(object, "body")? {
        Some(value) => callable_codec::artifact_decode_callable_body(name, value)?,
        None => tast::Callable::Function(name),
    };
    Result::Ok(artifact_model::ArtifactFnScheme { name, type_params, constraints, ty, body })
}

pub fn artifact_decode_fn_map(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactFnScheme],
    string,
] {
    let object = type_codec::artifact_json_object(value, "function map")?;
    let result: Vec[artifact_model::ArtifactFnScheme] = Vec::[];
    for item in object {
        result.push(artifact_decode_fn_scheme(context, item.0, item.1)?)
    };
    Result::Ok(result)
}

pub fn artifact_decode_type_pairs(
    context: type_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
    expected: string,
) -> Result[Vec[(string, tast::Type)], string] {
    let values = type_codec::artifact_json_array(value, expected)?;
    let result: Vec[(string, tast::Type)] = Vec::[];
    for value in values {
        let pair = type_codec::artifact_json_array(value, expected)?;
        if pair.len() != 2 {
            return Result::Err(type_codec::artifact_decode_error(expected))
        } else {
            ()
        };
        let name = type_codec::artifact_json_string_value(pair[0], expected)?;
        result.push((name, type_codec::artifact_decode_type(context, pair[1])?))
    };
    Result::Ok(result)
}

pub fn artifact_decode_enum_variant_fields(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::EnumVariantFields,
    string,
] {
    match value {
        String(name) => if name == "Unit" {
            Result::Ok(tast::EnumVariantFields::Unit)
        } else {
            Result::Err(type_codec::artifact_decode_error("enum variant fields"))
        },
        Object(object) => if object.len() == 1 {
            let item = object[0];
            if item.0 == "Tuple" {
                match type_codec::artifact_decode_type_array(context, item.1, "enum tuple fields") {
                    Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Tuple(fields))
                    },
                    Err(error) => Result::Err(error),
                }
            } else if item.0 == "Struct" {
                match artifact_decode_type_pairs(context, item.1, "enum struct fields") {
                    Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Struct(fields))
                    },
                    Err(error) => Result::Err(error),
                }
            } else {
                Result::Err(type_codec::artifact_decode_error("enum variant fields"))
            }
        } else {
            Result::Err(type_codec::artifact_decode_error("enum variant fields"))
        },
        _ => Result::Err(type_codec::artifact_decode_error("enum variant fields")),
    }
}

pub fn artifact_decode_enum_def(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::EnumDef,
    string,
] {
    let object = type_codec::artifact_json_object(value, "enum definition")?;
    let name = type_codec::artifact_json_field_string(object, "name")?;
    type_codec::artifact_add_type_name(context.enum_names, name);
    let generics = type_codec::artifact_decode_string_array(
        type_codec::artifact_json_required_field(object, "generics")?,
        "enum generics",
    )?;
    let values = type_codec::artifact_json_field_array(object, "variants")?;
    let variants: Vec[tast::EnumVariantDef] = Vec::[];
    for value in values {
        let variant = type_codec::artifact_json_object(value, "enum variant")?;
        let variant_name = type_codec::artifact_json_field_string(variant, "name")?;
        let fields_value = type_codec::artifact_json_required_field(variant, "fields")?;
        let fields = artifact_decode_enum_variant_fields(context, fields_value)?;
        variants.push(tast::EnumVariantDef { name: variant_name, fields })
    };
    Result::Ok(tast::EnumDef { name, generics, variants })
}

pub fn artifact_decode_struct_def(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::StructDef,
    string,
] {
    let object = type_codec::artifact_json_object(value, "struct definition")?;
    let name = type_codec::artifact_json_field_string(object, "name")?;
    type_codec::artifact_add_type_name(context.struct_names, name);
    let generics = type_codec::artifact_decode_string_array(
        type_codec::artifact_json_required_field(object, "generics")?,
        "struct generics",
    )?;
    let fields = artifact_decode_type_pairs(
        context,
        type_codec::artifact_json_required_field(object, "fields")?,
        "struct fields",
    )?;
    let public_fields: Vec[string] = Vec::[];
    for field in fields {
        public_fields.push(field.0)
    };
    let has_hidden_fields = type_codec::artifact_json_bool_value(
        type_codec::artifact_json_required_field(object, "has_hidden_fields")?,
        "struct hidden fields flag",
    )?;
    Result::Ok(tast::StructDef { name, generics, fields, public_fields, has_hidden_fields })
}

pub fn artifact_decode_type_alias(context: type_codec::ArtifactDecodeContext, name: string, value: wire::ArtifactValue) -> Result[
    tast::TypeAliasInfo,
    string,
] {
    let object = type_codec::artifact_json_object(value, "type alias")?;
    let generics = type_codec::artifact_decode_string_array(
        type_codec::artifact_json_required_field(object, "generics")?,
        "type alias generics",
    )?;
    let ty = type_codec::artifact_decode_type(context, type_codec::artifact_json_required_field(object, "ty")?)?;
    Result::Ok(tast::TypeAliasInfo { name, generics, ty })
}

pub fn artifact_decode_associated_type_defs(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactAssociatedTypeDef],
    string,
] {
    let object = type_codec::artifact_json_object(value, "associated type definitions")?;
    let result: Vec[artifact_model::ArtifactAssociatedTypeDef] = Vec::[];
    for item in object {
        let definition = type_codec::artifact_json_object(item.1, "associated type definition")?;
        let bounds = artifact_decode_trait_refs(
            context,
            type_codec::artifact_json_required_field(definition, "bounds")?,
        )?;
        result.push(artifact_model::ArtifactAssociatedTypeDef { name: item.0, bounds })
    };
    Result::Ok(result)
}

pub fn artifact_decode_trait_def(context: type_codec::ArtifactDecodeContext, name: string, value: wire::ArtifactValue) -> Result[
    artifact_model::ArtifactTraitDef,
    string,
] {
    let object = type_codec::artifact_json_object(value, "trait definition")?;
    let params = type_codec::artifact_decode_string_array(
        type_codec::artifact_json_required_field(object, "params")?,
        "trait parameters",
    )?;
    let predicates = artifact_decode_predicates(
        context,
        type_codec::artifact_json_required_field(object, "predicates")?,
    )?;
    let supertraits = artifact_decode_trait_refs(
        context,
        type_codec::artifact_json_required_field(object, "supertraits")?,
    )?;
    let associated_types = artifact_decode_associated_type_defs(
        context,
        type_codec::artifact_json_required_field(object, "associated_types")?,
    )?;
    let methods = artifact_decode_fn_map(context, type_codec::artifact_json_required_field(object, "methods")?)?;
    Result::Ok(
        artifact_model::ArtifactTraitDef { name, params, predicates, supertraits, associated_types, methods },
    )
}

pub fn artifact_decode_associated_types(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[(string, tast::Type)],
    string,
] {
    let object = type_codec::artifact_json_object(value, "associated types")?;
    let result: Vec[(string, tast::Type)] = Vec::[];
    for item in object {
        result.push((item.0, type_codec::artifact_decode_type(context, item.1)?))
    };
    Result::Ok(result)
}

pub fn artifact_decode_impl_def(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    artifact_model::ArtifactImplDef,
    string,
] {
    let object = type_codec::artifact_json_object(value, "implementation definition")?;
    let params = type_codec::artifact_decode_string_array(
        type_codec::artifact_json_required_field(object, "params")?,
        "implementation parameters",
    )?;
    let constraints = artifact_decode_predicates(
        context,
        type_codec::artifact_json_required_field(object, "constraints")?,
    )?;
    let associated_types = artifact_decode_associated_types(
        context,
        type_codec::artifact_json_required_field(object, "associated_types")?,
    )?;
    let methods = artifact_decode_fn_map(context, type_codec::artifact_json_required_field(object, "methods")?)?;
    let valid = match type_codec::artifact_json_optional_field(object, "valid")? {
        Some(value) => type_codec::artifact_json_bool_value(value, "implementation validity")?,
        None => true,
    };
    Result::Ok(artifact_model::ArtifactImplDef { params, constraints, associated_types, methods, valid })
}

pub fn artifact_decode_trait_impls(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactTraitImpl],
    string,
] {
    let values = type_codec::artifact_json_array(value, "trait implementations")?;
    let result: Vec[artifact_model::ArtifactTraitImpl] = Vec::[];
    for value in values {
        let pair = type_codec::artifact_json_array(value, "trait implementation")?;
        if pair.len() != 2 {
            return Result::Err(type_codec::artifact_decode_error("trait implementation pair"))
        } else {
            ()
        };
        let key = type_codec::artifact_json_object(pair[0], "trait implementation key")?;
        let trait_ref = type_codec::artifact_decode_trait_ref(
            context,
            type_codec::artifact_json_required_field(key, "trait_ref")?,
        )?;
        let for_ty = type_codec::artifact_decode_type(context, type_codec::artifact_json_required_field(key, "for_ty")?)?;
        let definition = artifact_decode_impl_def(context, pair[1])?;
        result.push(artifact_model::ArtifactTraitImpl { trait_ref, for_ty, definition })
    };
    Result::Ok(result)
}

pub fn artifact_decode_inherent_impl_key(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    artifact_model::ArtifactInherentImplKey,
    string,
] {
    let object = type_codec::artifact_json_object(value, "inherent implementation key")?;
    if object.len() != 1 {
        Result::Err(type_codec::artifact_decode_error("inherent implementation key variant"))
    } else if object[0].0 == "Exact" {
        match type_codec::artifact_decode_type(context, object[0].1) {
            Ok(value) => Result::Ok(artifact_model::ArtifactInherentImplKey::Exact(value)),
            Err(error) => Result::Err(error),
        }
    } else if object[0].0 == "Constr" {
        match type_codec::artifact_json_string_value(object[0].1, "inherent constructor") {
            Ok(value) => Result::Ok(artifact_model::ArtifactInherentImplKey::Constr(value)),
            Err(error) => Result::Err(error),
        }
    } else {
        Result::Err(type_codec::artifact_decode_error("inherent implementation key"))
    }
}

pub fn artifact_decode_inherent_impls(context: type_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[artifact_model::ArtifactInherentImpl],
    string,
] {
    let values = type_codec::artifact_json_array(value, "inherent implementations")?;
    let result: Vec[artifact_model::ArtifactInherentImpl] = Vec::[];
    for value in values {
        let pair = type_codec::artifact_json_array(value, "inherent implementation")?;
        if pair.len() != 2 {
            return Result::Err(type_codec::artifact_decode_error("inherent implementation pair"))
        } else {
            ()
        };
        let key = artifact_decode_inherent_impl_key(context, pair[0])?;
        let definition = artifact_decode_impl_def(context, pair[1])?;
        result.push(artifact_model::ArtifactInherentImpl { key, definition })
    };
    Result::Ok(result)
}

pub fn artifact_decode_package_exports(value: wire::ArtifactValue) -> Result[artifact_model::ArtifactPackageExports, string] {
    let context = type_codec::new_artifact_decode_context();
    let object = type_codec::artifact_json_object(value, "package exports")?;
    let type_env = type_codec::artifact_json_field_object(object, "type_env")?;
    let enum_map = type_codec::artifact_json_field_object(type_env, "enums")?;
    let struct_map = type_codec::artifact_json_field_object(type_env, "structs")?;
    for item in enum_map {
        type_codec::artifact_add_type_name(context.enum_names, item.0)
    };
    for item in struct_map {
        type_codec::artifact_add_type_name(context.struct_names, item.0)
    };
    let enums: Vec[tast::EnumDef] = Vec::[];
    for item in enum_map {
        let value = artifact_decode_enum_def(context, item.1)?;
        if value.name == item.0 {
            enums.push(value)
        } else {
            return Result::Err(type_codec::artifact_decode_error("matching enum name"))
        }
    };
    let structs: Vec[tast::StructDef] = Vec::[];
    for item in struct_map {
        let value = artifact_decode_struct_def(context, item.1)?;
        if value.name == item.0 {
            structs.push(value)
        } else {
            return Result::Err(type_codec::artifact_decode_error("matching struct name"))
        }
    };
    let alias_map = type_codec::artifact_json_field_object(type_env, "aliases")?;
    let type_aliases: Vec[tast::TypeAliasInfo] = Vec::[];
    for item in alias_map {
        type_aliases.push(artifact_decode_type_alias(context, item.0, item.1)?)
    };
    let trait_env = type_codec::artifact_json_field_object(object, "trait_env")?;
    let trait_map = type_codec::artifact_json_field_object(trait_env, "trait_defs")?;
    let traits: Vec[artifact_model::ArtifactTraitDef] = Vec::[];
    for item in trait_map {
        traits.push(artifact_decode_trait_def(context, item.0, item.1)?)
    };
    let trait_impls = artifact_decode_trait_impls(
        context,
        type_codec::artifact_json_required_field(trait_env, "trait_impls")?,
    )?;
    let inherent_impls = artifact_decode_inherent_impls(
        context,
        type_codec::artifact_json_required_field(trait_env, "inherent_impls")?,
    )?;
    let value_env = type_codec::artifact_json_field_object(object, "value_env")?;
    let functions = artifact_decode_fn_map(
        context,
        type_codec::artifact_json_required_field(value_env, "funcs")?,
    )?;
    let constant_map = type_codec::artifact_json_field_object(value_env, "consts")?;
    let constants: Vec[tast::ConstantScheme] = Vec::[];
    for item in constant_map {
        let definition = type_codec::artifact_json_object(item.1, "constant scheme")?;
        let ty = type_codec::artifact_decode_type(context, type_codec::artifact_json_required_field(definition, "ty")?)?;
        constants.push(tast::ConstantScheme { def_id: Option::None, name: item.0, ty })
    };
    Result::Ok(
        artifact_model::ArtifactPackageExports {
            enum_type_names: context.enum_names,
            struct_type_names: context.struct_names,
            type_aliases,
            enums,
            structs,
            traits,
            trait_impls,
            inherent_impls,
            functions,
            constants,
        },
    )
}

pub fn artifact_decode_package_interface(value: wire::ArtifactValue) -> Result[
    artifact_model::ArtifactPackageInterface,
    string,
] {
    let object = type_codec::artifact_json_object(value, "package interface")?;
    let package_name = type_codec::artifact_json_field_string(object, "package")?;
    let name = type_codec::artifact_json_field_string(object, "name")?;
    let value_map = type_codec::artifact_json_field_object(object, "value_exports")?;
    let value_exports: Vec[(string, int)] = Vec::[];
    for item in value_map {
        let number = type_codec::artifact_json_number_value(item.1, "value export index")?;
        value_exports.push((item.0, type_codec::artifact_parse_nonnegative_int(number)?))
    };
    let enum_map = type_codec::artifact_json_field_object(object, "enum_variants")?;
    let enum_variants: Vec[(string, Vec[string])] = Vec::[];
    for item in enum_map {
        enum_variants.push((item.0, type_codec::artifact_decode_string_array(item.1, "enum variant names")?))
    };
    Result::Ok(artifact_model::ArtifactPackageInterface { package_name, name, value_exports, enum_variants })
}

pub fn artifact_decode_string_map(value: wire::ArtifactValue, expected: string) -> Result[
    Vec[(string, string)],
    string,
] {
    let object = type_codec::artifact_json_object(value, expected)?;
    let result: Vec[(string, string)] = Vec::[];
    for item in object {
        result.push((item.0, type_codec::artifact_json_string_value(item.1, expected)?))
    };
    Result::Ok(result)
}

pub fn artifact_decode_interface_value(value: wire::ArtifactValue) -> Result[artifact_model::ArtifactInterfaceUnit, string] {
    let object = type_codec::artifact_json_object(value, "interface unit")?;
    let package_name = type_codec::artifact_json_field_string(object, "package")?;
    let exports = artifact_decode_package_exports(type_codec::artifact_json_required_field(object, "exports")?)?;
    let package_interface = artifact_decode_package_interface(
        type_codec::artifact_json_required_field(object, "interface")?,
    )?;
    let deps = artifact_decode_string_map(
        type_codec::artifact_json_required_field(object, "deps")?,
        "dependency hashes",
    )?;
    let interface_hash = type_codec::artifact_json_field_string(object, "interface_hash")?;
    let result = artifact_model::ArtifactInterfaceUnit {
        package_name,
        exports,
        package_interface,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(type_codec::artifact_decode_error("matching interface package"))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(type_codec::artifact_decode_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}
