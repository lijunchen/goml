        spec("meta_pattern_or", one_type("MetaPatternList"), "MetaPattern"),
        spec("meta_pattern_range", three_types("MetaPattern", "MetaPattern", "bool"), "MetaPattern"),
        spec("meta_pattern_list_new", no_types(), "MetaPatternList"),
        spec("meta_pattern_list_push", two_types("MetaPatternList", "MetaPattern"), "unit"),
        spec("meta_arm", two_types("MetaPattern", "MetaExpr"), "MetaArm"),
        spec("meta_arm_guarded", three_types("MetaPattern", "MetaExpr", "MetaExpr"), "MetaArm"),
        spec("meta_arm_list_new", no_types(), "MetaArmList"),
        spec("meta_arm_list_push", two_types("MetaArmList", "MetaArm"), "unit"),
        spec("meta_block_new", no_types(), "MetaBlock"),
        spec("meta_block_let", three_types("MetaBlock", "string", "MetaExpr"), "unit"),
        spec("meta_block_let_mut", three_types("MetaBlock", "string", "MetaExpr"), "unit"),
        spec("meta_block_let_pattern", three_types("MetaBlock", "MetaPattern", "MetaExpr"), "unit"),
        spec("meta_block_assign", three_types("MetaBlock", "MetaExpr", "MetaExpr"), "unit"),
        spec("meta_block_expr", two_types("MetaBlock", "MetaExpr"), "unit"),
        spec("meta_block_finish", two_types("MetaBlock", "MetaExpr"), "MetaExpr"),
        spec("meta_block_finish_unit", one_type("MetaBlock"), "MetaExpr"),
        spec("meta_param_list_new", no_types(), "MetaParamList"),
        spec("meta_param_list_push", three_types("MetaParamList", "string", "MetaType"), "unit"),
        spec(
            "meta_method",
            four_types("string", "MetaParamList", "MetaType", "MetaExpr"),
            "MetaMethod",
        ),
        spec("derive_output_new", two_types("DeriveInput", "string"), "DeriveOutput"),
        spec("derive_output_new_call_site", two_types("DeriveInput", "string"), "DeriveOutput"),
        spec(
            "derive_output_add_predicate",
            three_types("DeriveOutput", "MetaType", "string"),
            "unit",
        ),
        spec(
            "derive_output_add_call_site_predicate",
