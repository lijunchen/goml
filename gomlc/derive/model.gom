package derive;

use gomlc::ast;
use gomlc::ctir;
use std::num;
use std::text;

pub struct DeriveIntrinsicSpec {
    pub name: string,
    pub params: Vec[string],
    pub ret: string,
}

fn spec(name: string, params: Vec[string], ret: string) -> DeriveIntrinsicSpec {
    DeriveIntrinsicSpec { name, params, ret }
}

fn no_types() -> Vec[string] {
    Vec::[]
}

fn one_type(first: string) -> Vec[string] {
    Vec::[first]
}

fn two_types(first: string, second: string) -> Vec[string] {
    Vec::[first, second]
}

fn three_types(first: string, second: string, third: string) -> Vec[string] {
    Vec::[first, second, third]
}

fn four_types(first: string, second: string, third: string, fourth: string) -> Vec[string] {
    Vec::[first, second, third, fourth]
}

pub fn intrinsic_specs() -> Vec[DeriveIntrinsicSpec] {
    Vec::[
        spec("derive_item_name", one_type("DeriveInput"), "string"),
        spec("derive_item_kind", one_type("DeriveInput"), "int"),
        spec("derive_generic_count", one_type("DeriveInput"), "int"),
        spec("derive_generic_name", two_types("DeriveInput", "int"), "string"),
        spec("derive_field_count", one_type("DeriveInput"), "int"),
        spec("derive_field_name", two_types("DeriveInput", "int"), "string"),
        spec("derive_field_type", two_types("DeriveInput", "int"), "MetaType"),
        spec("derive_field_attribute_count", two_types("DeriveInput", "int"), "int"),
        spec("derive_field_attribute_name", three_types("DeriveInput", "int", "int"), "string"),
        spec("derive_field_attribute_text", three_types("DeriveInput", "int", "int"), "string"),
