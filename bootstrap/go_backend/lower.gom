package go_backend;

use gomlc::anf;
use gomlc::ast;
use gomlc::core;
use gomlc::tast;

pub struct FunctionNames {
    pub by_source: HashMap[string, string],
    pub reserved: HashMap[string, unit],
    pub variant_names: HashMap[string, string],
}

struct LowerEnv {
    joins: Vec[anf::JoinBind],
    emitted_loop_labels: Vec[string],
    variants: VariantInfos,
    closures: Vec[ClosureInfo],
    structs: Vec[tast::StructDef],
    instances: Vec[core::TypeInstance],
    functions: Vec[anf::Function],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
}

struct CompiledValue {
    stmts: Vec[Stmt],
    expr: Expr,
}

struct JoinRecResult {
    stmts: Vec[Stmt],
    loop_names: Vec[string],
}

fn append_stmts(target: Vec[Stmt], values: Vec[Stmt]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn append_items(target: Vec[Item], values: Vec[Item]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn contains_string(values: Vec[string], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn function_name(value: string) -> string {
    if value == "main" {
        "main0"
    } else if value == "init" {
        go_generated_ident("_goml_user_init")
    } else {
        go_ident(value)
    }
}

fn new_function_names() -> FunctionNames {
    FunctionNames {
        by_source: HashMap::new(),
        reserved: HashMap::new(),
        variant_names: HashMap::new(),
    }
}

fn add_function_name(values: FunctionNames, source: string, generated: string) -> unit {
    values.by_source.set(source, generated);
    values.reserved.set(generated, ())
}

fn mapped_function_name(values: FunctionNames, value: string) -> Option[string] {
    values.by_source.get(value)
}

fn env_function_name(env: LowerEnv, value: string) -> string {
    match mapped_function_name(env.function_names, value) {
        Option::Some(name) => name,
        Option::None => function_name(value),
    }
}

fn function_type_names(
    function_names: FunctionNames,
    structs: Vec[tast::StructDef],
    enums: Vec[tast::EnumDef],
    instances: Vec[core::TypeInstance],
) -> HashMap[string, unit] {
    let result: HashMap[string, unit] = HashMap::new();
    for definition in structs {
        let name = go_user_type_name(definition.name);
        result.set(name, ());
        function_names.reserved.set(name, ())
    };
    for definition in enums {
        let name = go_user_type_name(definition.name);
        result.set(name, ());
        function_names.reserved.set(name, ())
    };
    for instance in instances {
        let name = go_user_type_name(instance.name);
        result.set(name, ());
        function_names.reserved.set(name, ())
    };
    result
}

fn resolve_function_name(
    value: string,
    type_names: HashMap[string, unit],
) -> string {
    if value == "main" {
        "main"
    } else {
        let candidate = go_ident(value);
        if candidate == "init"
            || is_generated_tuple_type_name(candidate)
            || type_names.contains(candidate)
        {
            go_generated_ident("_goml_user_" + candidate)
        } else {
            candidate
        }
    }
}

fn add_entry_variant_names(
    used: NameSet,
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    instances: Vec[core::TypeInstance],
    function_names: FunctionNames,
) -> unit {
    for definition in enums {
        if definition.generics.len() == 0 {
            for variant in definition.variants {
                let name = variant_go_name(
                    definition.name,
                    variant.name,
                    enums,
                    structs,
                    instances,
                    function_names,
                );
                add_reachable(used, name)
            }
        } else {
            for instance in instances {
                if instance.base_name == definition.name {
                    for variant in definition.variants {
                        let name = variant_go_name(
                            instance.name,
                            variant.name,
                            enums,
                            structs,
                            instances,
                            function_names,
                        );
                        add_reachable(used, name)
                    }
                } else {
                    ()
                }
            }
        }
    }
}

fn entry_wrapper_name(
    functions: Vec[anf::Function],
    structs: Vec[tast::StructDef],
    enums: Vec[tast::EnumDef],
    instances: Vec[core::TypeInstance],
    function_names: FunctionNames,
) -> string {
    let used = new_name_set();
    for function in functions {
        if function.name != "main" {
            add_reachable(used, go_ident(function.name))
        } else {
            ()
        }
    };
    for definition in structs {
        add_reachable(used, go_user_type_name(definition.name))
    };
    for definition in enums {
        add_reachable(used, go_user_type_name(definition.name))
    };
    for instance in instances {
        add_reachable(used, go_user_type_name(instance.name))
    };
    add_entry_variant_names(
        used,
        enums,
        structs,
        instances,
        function_names,
    );
    if !name_present(used, "main0") {
        "main0"
    } else {
        let index = Ref::new(1);
        let result = Ref::new("main0__" + index.get().to_string());
        while name_present(used, result.get()) {
            index.set(index.get() + 1);
            result.set("main0__" + index.get().to_string())
        };
        result.get()
    }
}

fn build_function_names(
    functions: Vec[anf::Function],
    structs: Vec[tast::StructDef],
    enums: Vec[tast::EnumDef],
    instances: Vec[core::TypeInstance],
) -> FunctionNames {
    let resolved = new_function_names();
    let type_names = function_type_names(resolved, structs, enums, instances);
    for function in functions {
        add_function_name(
            resolved,
            function.name,
            resolve_function_name(function.name, type_names),
        )
    };
    let entry_name = entry_wrapper_name(
        functions,
        structs,
        enums,
        instances,
        resolved,
    );
    let result = FunctionNames {
        by_source: HashMap::new(),
        reserved: resolved.reserved,
        variant_names: resolved.variant_names,
    };
    for function in functions {
        let name = if function.name == "main" {
            entry_name
        } else {
            match mapped_function_name(resolved, function.name) {
                Option::Some(name) => name,
                Option::None => function_name(function.name),
            }
        };
        add_function_name(result, function.name, name)
    };
    result
}

fn callable_name(env: LowerEnv, value: tast::Callable) -> string {
    match value {
        tast::Callable::Function(name) => env_function_name(env, name),
        tast::Callable::Runtime(name) => runtime_hook_name(name),
        tast::Callable::Intrinsic(name) => go_ident(name),
        tast::Callable::TraitMethod(reference, name) => {
            go_ident(reference.name + "#" + name)
        },
        tast::Callable::DynTraitMethod(owner, dispatch, name) => {
            go_ident("dyn#" + owner + "#" + dispatch + "#" + name)
        },
        tast::Callable::InherentMethod(owner, name) => {
            go_ident("inherent#" + encode_type(owner) + "#" + name)
        },
    }
}

fn go_float_literal(value: string, ty: tast::Type) -> string {
    match tast::resolve_type(ty) {
        tast::Type::Float32 => {
            let (valid, parsed) = string_parse_float32(value);
            if valid { parsed.to_string() } else { value }
        },
        tast::Type::Float64 => {
            let (valid, parsed) = string_parse_float64(value);
            if valid { parsed.to_string() } else { value }
        },
        _ => value,
    }
}

fn compile_primitive(value: tast::Primitive, ty: tast::Type) -> Expr {
    match value {
        tast::Primitive::Unit => Expr::Unit,
        tast::Primitive::Bool(value) => Expr::Bool(value),
        tast::Primitive::Int(value)
        | tast::Primitive::Int8(value)
        | tast::Primitive::Int16(value)
        | tast::Primitive::Int32(value)
        | tast::Primitive::Int64(value)
        | tast::Primitive::Uint8(value)
        | tast::Primitive::Uint16(value)
        | tast::Primitive::Uint32(value)
        | tast::Primitive::Uint64(value) => Expr::Int(value),
        tast::Primitive::Float(value)
        | tast::Primitive::Float32(value)
        | tast::Primitive::Float64(value) => Expr::Float(go_float_literal(value, ty)),
        tast::Primitive::String(value) => Expr::String(value),
        tast::Primitive::Char(value) => Expr::Int((value as uint32).to_string()),
    }
}

fn compile_imm(env: LowerEnv, value: anf::Imm) -> Expr {
    match value {
        anf::Imm::Var(name, _) => {
            match mapped_function_name(env.function_names, name) {
                Option::Some(value) => Expr::Var(value),
                Option::None => Expr::Var(go_local_ident(name)),
            }
        },
        anf::Imm::Callable(tast::Callable::Intrinsic(key), function_ty) => {
            compile_intrinsic_callable(key, function_ty)
        },
        anf::Imm::Callable(value, _) => Expr::Var(callable_name(env, value)),
        anf::Imm::Prim(value, ty) => compile_primitive(value, ty),
        anf::Imm::Tag(index, owner_ty) => {
            match find_variant_info(env.variants, owner_ty, index) {
                Option::Some(info) => {
                    if info.tag_only {
                        Expr::Var(info.variant_name)
                    } else {
                        Expr::Int(index.to_string())
                    }
                },
                Option::None => Expr::Int(index.to_string()),
            }
        },
    }
}

fn compile_runtime_imm(
    env: LowerEnv,
    value: anf::Imm,
    name: string,
) -> CompiledValue {
    let expr = compile_imm(env, value);
    match value {
        anf::Imm::Prim(_, ty) => {
            let stmts = Vec::new();
            stmts.push(Stmt::Var(name, lower_type(ty), Option::Some(expr)));
            CompiledValue {
                stmts,
                expr: Expr::Var(name),
            }
        },
        _ => CompiledValue {
            stmts: Vec::new(),
            expr,
        },
    }
}

fn is_closure_struct_name(value: string) -> bool {
    value.byte_len() >= 12 && value.byte_slice(0, 12) == "closure_env_"
}

fn closure_info_from_function(value: anf::Function) -> Option[ClosureInfo] {
    let segments = hash_segments(value.name);
    if segments.len() == 4
        && segments.get(0) == "inherent"
        && segments.get(1) == segments.get(2)
        && segments.get(3) == "apply"
        && is_closure_struct_name(segments.get(1))
        && value.params.len() > 0
    {
        match tast::resolve_type(value.params.get(0).1) {
            tast::Type::Con(name) => {
                if name == segments.get(1) {
                    let params: Vec[tast::Type] = Vec::new();
                    for index in range(1, value.params.len()) {
                        params.push(value.params.get(index).1)
                    };
                    Option::Some(ClosureInfo {
                        struct_name: name,
                        apply_name: value.name,
                        params,
                        ret_ty: value.ret_ty,
                    })
                } else {
                    Option::None
                }
            },
            _ => Option::None,
        }
    } else {
        Option::None
    }
}

fn collect_closure_infos(values: Vec[anf::Function]) -> Vec[ClosureInfo] {
    let result: Vec[ClosureInfo] = Vec::new();
    for value in values {
        match closure_info_from_function(value) {
            Option::Some(info) => result.push(info),
            Option::None => (),
        }
    };
    result
}

fn find_closure_info(values: Vec[ClosureInfo], ty: tast::Type) -> Option[ClosureInfo] {
    match tast::resolve_type(ty) {
        tast::Type::Con(name) => {
            let result: Ref[Option[ClosureInfo]] = Ref::new(Option::None);
            for value in values {
                if value.struct_name == name {
                    result.set(Option::Some(value))
                } else {
                    ()
                }
            };
            result.get()
        },
        _ => Option::None,
    }
}

fn compile_closure_function(
    env: LowerEnv,
    value: anf::Imm,
    target_ty: tast::Type,
    info: ClosureInfo,
) -> Expr {
    match tast::resolve_type(target_ty) {
        tast::Type::Func(param_types, ret_ty) => {
            let params: Vec[(string, Type)] = Vec::new();
            let args: Vec[Expr] = Vec::new();
            args.push(compile_imm(env, value));
            for index in range(0, param_types.len()) {
                let name = "p" + index.to_string();
                params.push((name, lower_type(param_types.get(index))));
                args.push(Expr::Var(name))
            };
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(Stmt::Return(Option::Some(Expr::Call(
                Expr::Var(env_function_name(env, info.apply_name)),
                args,
            ))));
            Expr::FuncLit(params, lower_type(ret_ty), Block { stmts })
        },
        _ => compile_imm(env, value),
    }
}

fn compile_imm_expected(env: LowerEnv, value: anf::Imm, expected_ty: tast::Type) -> Expr {
    match value {
        anf::Imm::Tag(tag, owner_ty) => match variant_type(env.variants, owner_ty, tag) {
            Option::Some(ty) => Expr::StructLiteral(ty, Vec::new()),
            Option::None => compile_imm(env, value),
        },
        _ => match find_closure_info(env.closures, anf::imm_type(value)) {
            Option::Some(info) => match tast::resolve_type(expected_ty) {
                tast::Type::Func(_, _) => compile_closure_function(env, value, expected_ty, info),
                _ => compile_imm(env, value),
            },
            Option::None => compile_imm(env, value),
        },
    }
}

fn compile_imms_expected(
    env: LowerEnv,
    values: Vec[anf::Imm],
    expected: Vec[tast::Type],
) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::new();
    for index in range(0, values.len()) {
        if index < expected.len() {
            result.push(compile_imm_expected(env, values.get(index), expected.get(index)))
        } else {
            result.push(compile_imm(env, values.get(index)))
        }
    };
    result
}

fn find_dyn_method(
    functions: Vec[anf::Function],
    trait_name: string,
    method_name: string,
) -> Option[DynMethod] {
    let result: Ref[Option[DynMethod]] = Ref::new(Option::None);
    for method in dyn_methods(functions, trait_name) {
        if method.name == method_name {
            result.set(Option::Some(method))
        } else {
            ()
        }
    };
    result.get()
}

fn intrinsic_source_name(key: string) -> string {
    if key == "array.get" {
        "array_get"
    } else if key == "array.set" {
        "array_set"
    } else if key == "ref.new" {
        "ref"
    } else if key == "ref.get" {
        "ref_get"
    } else if key == "ref.set" {
        "ref_set"
    } else if key == "ref.ptr_eq" {
        "ptr_eq"
    } else if key == "ref.ptr_hash" {
        "ptr_hash"
    } else if key == "vec.new" {
        "vec_new"
    } else if key == "vec.with_capacity" {
        "vec_with_capacity"
    } else if key == "vec.push" {
        "vec_push"
    } else if key == "vec.get" {
        "vec_get"
    } else if key == "vec.set" {
        "vec_set"
    } else if key == "vec.len" {
        "vec_len"
    } else if key == "vec.capacity" {
        "vec_capacity"
    } else if key == "vec.reserve" {
        "vec_reserve"
    } else if key == "vec.truncate" {
        "vec_truncate"
    } else if key == "hashmap.new" {
        "hashmap_new"
    } else if key == "hashmap.get" {
        "hashmap_get"
    } else if key == "hashmap.set" {
        "hashmap_set"
    } else if key == "hashmap.remove" {
        "hashmap_remove"
    } else if key == "hashmap.len" {
        "hashmap_len"
    } else if key == "hashmap.contains" {
        "hashmap_contains"
    } else if key == "hashmap.entries" {
        "hashmap_entries"
    } else if key == "compiler.missing" {
        "missing"
    } else {
        key
    }
}

fn intrinsic_owner_type(
    key: string,
    function_ty: tast::Type,
    args: Vec[anf::Imm],
) -> Option[tast::Type] {
    if key == "ref.new" || key == "vec.new" || key == "vec.with_capacity"
        || key == "hashmap.new" || key == "compiler.missing"
    {
        match tast::resolve_type(function_ty) {
            tast::Type::Func(_, ret_ty) => Option::Some(ret_ty),
            _ => Option::None,
        }
    } else if args.len() > 0 {
        Option::Some(anf::imm_type(args.get(0)))
    } else {
        match tast::resolve_type(function_ty) {
            tast::Type::Func(params, _) => {
                if params.len() > 0 {
                    Option::Some(params.get(0))
                } else {
                    Option::None
                }
            },
            _ => Option::None,
        }
    }
}

fn intrinsic_helper_call_name(
    key: string,
    function_ty: tast::Type,
    args: Vec[anf::Imm],
) -> Option[string] {
    let supported = key == "array.get"
        || key == "array.set"
        || key == "ref.new"
        || key == "ref.get"
        || key == "ref.set"
        || key == "ref.ptr_eq"
        || key == "ref.ptr_hash"
        || key == "vec.new"
        || key == "vec.with_capacity"
        || key == "vec.push"
        || key == "vec.get"
        || key == "vec.set"
        || key == "vec.len"
        || key == "vec.capacity"
        || key == "vec.reserve"
        || key == "vec.truncate"
        || key == "hashmap.new"
        || key == "hashmap.get"
        || key == "hashmap.set"
        || key == "hashmap.remove"
        || key == "hashmap.len"
        || key == "hashmap.contains"
        || key == "hashmap.entries"
        || key == "compiler.missing";
    if supported {
        match intrinsic_owner_type(key, function_ty, args) {
            Option::Some(owner) => Option::Some(runtime_helper_name(
                intrinsic_source_name(key),
                owner,
            )),
            Option::None => Option::None,
        }
    } else {
        Option::None
    }
}

fn compile_slice_callable(key: string, function_ty: tast::Type) -> Expr {
    match tast::resolve_type(function_ty) {
        tast::Type::Func(param_types, ret_ty) => {
            let params: Vec[(string, Type)] = Vec::new();
            let vars: Vec[Expr] = Vec::new();
            for index in range(0, param_types.len()) {
                let name = "p" + index.to_string();
                params.push((name, lower_type(param_types.get(index))));
                vars.push(Expr::Var(name))
            };
            let value = if key == "slice.new" {
                Expr::Slice(
                    Expr::Field(vars.get(0), "items"),
                    vars.get(1),
                    vars.get(2),
                )
            } else if key == "slice.get" {
                Expr::Index(vars.get(0), vars.get(1))
            } else if key == "slice.len" {
                let args: Vec[Expr] = Vec::new();
                args.push(vars.get(0));
                Expr::Convert(Type::Int32, Expr::Call(Expr::Var("len"), args))
            } else {
                Expr::Slice(vars.get(0), vars.get(1), vars.get(2))
            };
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(Stmt::Return(Option::Some(value)));
            Expr::FuncLit(params, lower_type(ret_ty), Block { stmts })
        },
        _ => Expr::Var(go_ident(key)),
    }
}

fn compile_intrinsic_callable(key: string, function_ty: tast::Type) -> Expr {
    if key == "slice.new"
        || key == "slice.get"
        || key == "slice.len"
        || key == "slice.sub"
    {
        compile_slice_callable(key, function_ty)
    } else {
        match intrinsic_helper_call_name(key, function_ty, Vec::new()) {
            Option::Some(name) => Expr::Var(name),
            Option::None => Expr::Var(go_ident(key)),
        }
    }
}

fn compile_callable(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    match func {
        anf::Imm::Callable(tast::Callable::Intrinsic(key), function_ty) => {
            match intrinsic_helper_call_name(key, function_ty, args) {
                Option::Some(name) => Expr::Var(name),
                Option::None => compile_imm(env, func),
            }
        },
        _ => compile_imm(env, func),
    }
}

fn compile_call(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    match find_closure_info(env.closures, anf::imm_type(func)) {
        Option::Some(info) => {
            let values: Vec[Expr] = Vec::new();
            values.push(compile_imm(env, func));
            for value in compile_imms_expected(env, args, info.params) {
                values.push(value)
            };
            Expr::Call(Expr::Var(env_function_name(env, info.apply_name)), values)
        },
        Option::None => {
            let expected = match tast::resolve_type(anf::imm_type(func)) {
                tast::Type::Func(params, _) => params,
                _ => Vec::new(),
            };
            let compiled = compile_imms_expected(env, args, expected);
            match func {
                anf::Imm::Callable(tast::Callable::Intrinsic(key), _) => {
                    if key == "eq.primitive" {
                        Expr::Binary(BinaryOp::Eq, compiled.get(0), compiled.get(1))
                    } else if key == "slice.new" {
                        Expr::Slice(
                            Expr::Field(compiled.get(0), "items"),
                            compiled.get(1),
                            compiled.get(2),
                        )
                    } else if key == "slice.get" {
                        Expr::Index(compiled.get(0), compiled.get(1))
                    } else if key == "slice.len" {
                        let len_args: Vec[Expr] = Vec::new();
                        len_args.push(compiled.get(0));
                        Expr::Convert(
                            Type::Int32,
                            Expr::Call(Expr::Var("len"), len_args),
                        )
                    } else if key == "slice.sub" {
                        Expr::Slice(compiled.get(0), compiled.get(1), compiled.get(2))
                    } else {
                        Expr::Call(compile_callable(env, func, args), compiled)
                    }
                },
                _ => Expr::Call(compile_callable(env, func, args), compiled),
            }
        },
    }
}

fn compile_unary(value: ast::UnaryOp) -> UnaryOp {
    match value {
        ast::UnaryOp::Neg => UnaryOp::Neg,
        ast::UnaryOp::Not => UnaryOp::Not,
        ast::UnaryOp::BitNot => UnaryOp::BitNot,
    }
}

fn compile_binary(value: ast::BinaryOp) -> BinaryOp {
    match value {
        ast::BinaryOp::Add => BinaryOp::Add,
        ast::BinaryOp::Sub => BinaryOp::Sub,
        ast::BinaryOp::Mul => BinaryOp::Mul,
        ast::BinaryOp::Div => BinaryOp::Div,
        ast::BinaryOp::Rem => BinaryOp::Rem,
        ast::BinaryOp::BitAnd => BinaryOp::BitAnd,
        ast::BinaryOp::BitOr => BinaryOp::BitOr,
        ast::BinaryOp::BitXor => BinaryOp::BitXor,
        ast::BinaryOp::Shl => BinaryOp::Shl,
        ast::BinaryOp::Shr => BinaryOp::Shr,
        ast::BinaryOp::And => BinaryOp::And,
        ast::BinaryOp::Or => BinaryOp::Or,
        ast::BinaryOp::Less => BinaryOp::Less,
        ast::BinaryOp::Greater => BinaryOp::Greater,
        ast::BinaryOp::LessEq => BinaryOp::LessEq,
        ast::BinaryOp::GreaterEq => BinaryOp::GreaterEq,
        ast::BinaryOp::Eq => BinaryOp::Eq,
        ast::BinaryOp::NotEq => BinaryOp::NotEq,
    }
}

fn materializes_binary_operands(value: ast::BinaryOp) -> bool {
    match value {
        ast::BinaryOp::Rem
        | ast::BinaryOp::BitAnd
        | ast::BinaryOp::BitOr
        | ast::BinaryOp::BitXor
        | ast::BinaryOp::Shl
        | ast::BinaryOp::Shr => true,
        _ => false,
    }
}

fn append_struct_field_types(
    result: Vec[tast::Type],
    definition: tast::StructDef,
    args: Vec[tast::Type],
    instances: Vec[core::TypeInstance],
) -> unit {
    for field in definition.fields {
        result.push(instantiate_type(
            field.1,
            definition.generics,
            args,
            instances,
        ))
    }
}

fn struct_field_types(env: LowerEnv, value: tast::Type) -> Vec[tast::Type] {
    let result: Vec[tast::Type] = Vec::new();
    match tast::resolve_type(value) {
        tast::Type::Con(name) => match find_struct(env.structs, name) {
            Option::Some(definition) => append_struct_field_types(
                result,
                definition,
                Vec::new(),
                env.instances,
            ),
            Option::None => match instance_by_name(env.instances, name) {
                Option::Some(instance) => match find_struct(env.structs, instance.base_name) {
                    Option::Some(definition) => append_struct_field_types(
                        result,
                        definition,
                        instance.args,
                        env.instances,
                    ),
                    Option::None => (),
                },
                Option::None => (),
            },
        },
        tast::Type::App(tast::Type::Con(name), args) => {
            match find_struct(env.structs, name) {
                Option::Some(definition) => append_struct_field_types(
                    result,
                    definition,
                    args,
                    env.instances,
                ),
                Option::None => (),
            }
        },
        _ => (),
    };
    result
}

fn compile_constructor(
    env: LowerEnv,
    constructor: tast::Constructor,
    args: Vec[anf::Imm],
    ty: tast::Type,
) -> Expr {
    let expected: Vec[tast::Type] = Vec::new();
    if constructor.is_struct {
        for field_ty in struct_field_types(env, ty) {
            expected.push(field_ty)
        }
    } else {
        match constructor.tag {
            Option::Some(tag) => match find_variant_info(env.variants, ty, tag) {
                Option::Some(info) => {
                    for field_ty in info.field_types {
                        expected.push(field_ty)
                    }
                },
                Option::None => (),
            },
            Option::None => (),
        }
    };
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in range(0, args.len()) {
        let name = if constructor.is_struct && index < constructor.fields.len() {
            go_ident(constructor.fields.get(index))
        } else {
            "_" + index.to_string()
        };
        let compiled = if index < expected.len() {
            compile_imm_expected(env, args.get(index), expected.get(index))
        } else {
            compile_imm(env, args.get(index))
        };
        fields.push((name, compiled))
    };
    let go_ty = if constructor.is_struct {
        lower_type(ty)
    } else {
        match constructor.tag {
            Option::Some(tag) => match variant_type(env.variants, ty, tag) {
                Option::Some(ty) => ty,
                Option::None => constructor_type(constructor),
            },
            Option::None => constructor_type(constructor),
        }
    };
    Expr::StructLiteral(go_ty, fields)
}

fn compile_value(
    env: LowerEnv,
    bind_name: string,
    value: anf::Value,
    expected_ty: tast::Type,
) -> CompiledValue {
    let stmts: Vec[Stmt] = Vec::new();
    let expr = match value {
        anf::Value::Imm(value) => compile_imm_expected(env, value, expected_ty),
        anf::Value::Constr(constructor, args, ty) => compile_constructor(env, constructor, args, ty),
        anf::Value::Tuple(items, ty) => {
            let fields: Vec[(string, Expr)] = Vec::new();
            match tast::resolve_type(ty) {
                tast::Type::Tuple(item_types) => {
                    for index in range(0, items.len()) {
                        fields.push((
                            "_" + index.to_string(),
                            compile_imm_expected(env, items.get(index), item_types.get(index)),
                        ))
                    }
                },
                _ => {
                    for index in range(0, items.len()) {
                        fields.push(("_" + index.to_string(), compile_imm(env, items.get(index))))
                    }
                },
            };
            Expr::StructLiteral(lower_type(ty), fields)
        },
        anf::Value::Array(items, ty) => {
            let expected = match tast::resolve_type(ty) {
                tast::Type::Array(_, elem) => {
                    let values: Vec[tast::Type] = Vec::new();
                    for _ in items {
                        values.push(elem)
                    };
                    values
                },
                _ => Vec::new(),
            };
            Expr::ArrayLiteral(lower_type(ty), compile_imms_expected(env, items, expected))
        },
        anf::Value::ConstrGet(expr, constructor, index, _) => {
            let field = if constructor.is_struct && index < constructor.fields.len() {
                go_ident(constructor.fields.get(index))
            } else {
                "_" + index.to_string()
            };
            let target = if constructor.is_struct {
                compile_imm(env, expr)
            } else {
                let owner_ty = anf::imm_type(expr);
                let go_ty = match constructor.tag {
                    Option::Some(tag) => match variant_type(env.variants, owner_ty, tag) {
                        Option::Some(ty) => ty,
                        Option::None => constructor_type(constructor),
                    },
                    Option::None => constructor_type(constructor),
                };
                Expr::Cast(compile_imm(env, expr), go_ty)
            };
            Expr::Field(target, field)
        },
        anf::Value::Unary(op, operand, _) => {
            let compiled = match op {
                ast::UnaryOp::BitNot => compile_runtime_imm(
                    env,
                    operand,
                    go_local_ident(bind_name) + "_operand",
                ),
                _ => CompiledValue {
                    stmts: Vec::new(),
                    expr: compile_imm(env, operand),
                },
            };
            append_stmts(stmts, compiled.stmts);
            Expr::Unary(compile_unary(op), compiled.expr)
        },
        anf::Value::Cast(source, ty) => {
            let source_ty = lower_type(anf::imm_type(source));
            let compiled = compile_runtime_imm(
                env,
                source,
                go_local_ident(bind_name) + "_source",
            );
            append_stmts(stmts, compiled.stmts);
            Expr::Convert(
                lower_type(ty),
                Expr::Convert(source_ty, compiled.expr),
            )
        },
        anf::Value::Binary(op, lhs, rhs, _) => {
            let compiled_lhs = if materializes_binary_operands(op) {
                compile_runtime_imm(
                    env,
                    lhs,
                    go_local_ident(bind_name) + "_lhs",
                )
            } else {
                CompiledValue {
                    stmts: Vec::new(),
                    expr: compile_imm(env, lhs),
                }
            };
            let compiled_rhs = if materializes_binary_operands(op) {
                compile_runtime_imm(
                    env,
                    rhs,
                    go_local_ident(bind_name) + "_rhs",
                )
            } else {
                CompiledValue {
                    stmts: Vec::new(),
                    expr: compile_imm(env, rhs),
                }
            };
            append_stmts(stmts, compiled_lhs.stmts);
            append_stmts(stmts, compiled_rhs.stmts);
            Expr::Binary(
                compile_binary(op),
                compiled_lhs.expr,
                compiled_rhs.expr,
            )
        },
        anf::Value::Assign(name, value, target_ty, _) => {
            stmts.push(Stmt::Assign(
                go_local_ident(name),
                compile_imm_expected(env, value, target_ty),
            ));
            Expr::Unit
        },
        anf::Value::Call(func, args, _) => compile_call(env, func, args),
        anf::Value::ToDyn(trait_name, for_ty, expr, ty) => {
            let fields: Vec[(string, Expr)] = Vec::new();
            let compiled = compile_imm_expected(env, expr, for_ty);
            let data = match tast::resolve_type(for_ty) {
                tast::Type::Bool
                | tast::Type::Int8
                | tast::Type::Int16
                | tast::Type::Int32
                | tast::Type::Int64
                | tast::Type::Uint8
                | tast::Type::Uint16
                | tast::Type::Uint32
                | tast::Type::Uint64
                | tast::Type::Float32
                | tast::Type::Float64
                | tast::Type::Char => Expr::Convert(lower_type(for_ty), compiled),
                _ => compiled,
            };
            fields.push(("data", data));
            fields.push((
                "vtable",
                Expr::Call(Expr::Var(dyn_factory_name(
                    env.dyn_helper_names,
                    trait_name,
                    for_ty,
                )), Vec::new()),
            ));
            Expr::StructLiteral(lower_type(ty), fields)
        },
        anf::Value::DynCall(trait_name, method, receiver, args, _) => {
            let method_name = dyn_method_parts(method, trait_name).1;
            let receiver = compile_imm(env, receiver);
            let values: Vec[Expr] = Vec::new();
            values.push(Expr::Field(receiver, "data"));
            let expected = match find_dyn_method(env.functions, trait_name, method_name) {
                Option::Some(info) => info.params,
                Option::None => Vec::new(),
            };
            for arg in compile_imms_expected(env, args, expected) {
                values.push(arg)
            };
            Expr::Call(
                Expr::Field(Expr::Field(receiver, "vtable"), go_ident(method_name)),
                values,
            )
        },
        anf::Value::Go(value, _) => {
            let call = compile_call(env, value, Vec::new());
            stmts.push(Stmt::Go(call));
            Expr::Unit
        },
        anf::Value::Proj(tuple, index, _) => {
            Expr::Field(compile_imm(env, tuple), "_" + index.to_string())
        },
    };
    CompiledValue { stmts, expr }
}

fn compile_let(env: LowerEnv, value: anf::LetBind) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    let compiled = compile_value(env, value.name, value.value, value.ty);
    append_stmts(result, compiled.stmts);
    result.push(Stmt::Var(
        go_local_ident(value.name),
        lower_type(value.ty),
        Option::Some(compiled.expr),
    ));
    result
}

fn collect_joins_term(result: Vec[anf::JoinBind], value: anf::Term) -> unit {
    match value {
        anf::Term::If(_, then_, else_, _) => {
            collect_joins_block(result, then_);
            collect_joins_block(result, else_)
        },
        anf::Term::Match(_, arms, default, _) => {
            for arm in arms {
                collect_joins_block(result, arm.body)
            };
            match default {
                Option::Some(body) => collect_joins_block(result, body),
                Option::None => (),
            }
        },
        anf::Term::Return(_)
        | anf::Term::Jump(_, _, _)
        | anf::Term::Unreachable(_) => (),
    }
}

fn collect_joins_block(result: Vec[anf::JoinBind], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(_) => (),
            anf::Bind::Join(join) => {
                result.push(join);
                collect_joins_block(result, join.body)
            },
            anf::Bind::JoinRec(joins) => {
                for join in joins {
                    collect_joins_block(result, join.body)
                }
            },
        }
    };
    collect_joins_term(result, value.term)
}

fn find_join(values: Vec[anf::JoinBind], name: string) -> Option[anf::JoinBind] {
    let result: Ref[Option[anf::JoinBind]] = Ref::new(Option::None);
    for value in values {
        if value.name == name {
            result.set(Option::Some(value))
        } else {
            ()
        }
    };
    result.get()
}

fn same_target(lhs: Option[string], rhs: Option[string]) -> Option[string] {
    match lhs {
        Option::Some(left) => match rhs {
            Option::Some(right) => {
                if left == right { Option::Some(left) } else { Option::None }
            },
            Option::None => Option::None,
        },
        Option::None => Option::None,
    }
}

fn term_target(value: anf::Term) -> Option[string] {
    match value {
        anf::Term::Jump(target, _, _) => Option::Some(target),
        anf::Term::If(_, then_, else_, _) => {
            same_target(block_target(then_), block_target(else_))
        },
        anf::Term::Match(_, arms, default, _) => {
            let result: Ref[Option[string]] = Ref::new(Option::None);
            let initialized = Ref::new(false);
            let valid = Ref::new(true);
            for arm in arms {
                match block_target(arm.body) {
                    Option::Some(target) => {
                        if initialized.get() {
                            match result.get() {
                                Option::Some(current) => {
                                    if current != target {
                                        valid.set(false)
                                    } else {
                                        ()
                                    }
                                },
                                Option::None => valid.set(false),
                            }
                        } else {
                            result.set(Option::Some(target));
                            initialized.set(true)
                        }
                    },
                    Option::None => valid.set(false),
                }
            };
            match default {
                Option::Some(body) => match block_target(body) {
                    Option::Some(target) => {
                        if initialized.get() {
                            match result.get() {
                                Option::Some(current) => {
                                    if current != target {
                                        valid.set(false)
                                    } else {
                                        ()
                                    }
                                },
                                Option::None => valid.set(false),
                            }
                        } else {
                            result.set(Option::Some(target));
                            initialized.set(true)
                        }
                    },
                    Option::None => valid.set(false),
                },
                Option::None => (),
            };
            if valid.get() { result.get() } else { Option::None }
        },
        anf::Term::Return(_) | anf::Term::Unreachable(_) => Option::None,
    }
}

fn find_block_join(value: anf::Block, name: string) -> Option[anf::JoinBind] {
    let result: Ref[Option[anf::JoinBind]] = Ref::new(Option::None);
    for bind in value.binds {
        match bind {
            anf::Bind::Join(join) => {
                if join.name == name {
                    result.set(Option::Some(join))
                } else {
                    ()
                }
            },
            anf::Bind::Let(_) | anf::Bind::JoinRec(_) => (),
        }
    };
    result.get()
}

fn block_target(value: anf::Block) -> Option[string] {
    let result = Ref::new(term_target(value.term));
    let visited: Vec[string] = Vec::new();
    let done = Ref::new(false);
    while done.get() == false {
        match result.get() {
            Option::Some(target) => {
                if contains_string(visited, target) {
                    result.set(Option::None);
                    done.set(true)
                } else {
                    match find_block_join(value, target) {
                        Option::Some(join) => {
                            visited.push(target);
                            result.set(block_target(join.body))
                        },
                        Option::None => done.set(true),
                    }
                }
            },
            Option::None => done.set(true),
        }
    };
    result.get()
}

fn compile_jump_args(
    env: LowerEnv,
    value: anf::JoinBind,
    args: Vec[anf::Imm],
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    for index in range(0, args.len()) {
        if index < value.params.len() && value.params.get(index).0 != "_" {
            result.push(Stmt::Assign(
                go_local_ident(value.params.get(index).0),
                compile_imm_expected(env, args.get(index), value.params.get(index).1),
            ))
        } else {
            ()
        }
    };
    result
}

fn compile_branch_to_join(
    env: LowerEnv,
    value: anf::Block,
    target: string,
    join: anf::JoinBind,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                };
                pending.push(value)
            },
            anf::Bind::JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    };
    let suppress = match value.term {
        anf::Term::Jump(target, args, _) => {
            args.len() == 0 && contains_string(loop_names, target)
        },
        _ => false,
    };
    if !suppress {
        match term_target(value.term) {
            Option::Some(inner_target) => {
                if inner_target == target {
                    append_stmts(stmts, compile_term_to_join(env, value.term, target, join))
                } else {
                    match find_join(pending, inner_target) {
                        Option::Some(inner_join) => {
                            append_stmts(stmts, compile_term_to_join(
                                env,
                                value.term,
                                inner_target,
                                inner_join,
                            ));
                            append_stmts(stmts, compile_branch_to_join(
                                env,
                                inner_join.body,
                                target,
                                join,
                            ).stmts)
                        },
                        Option::None => append_stmts(
                            stmts,
                            compile_term_with_pending(env, value.term, pending),
                        ),
                    }
                }
            },
            Option::None => append_stmts(
                stmts,
                compile_term_with_pending(env, value.term, pending),
            ),
        }
    } else {
        ()
    };
    Block { stmts }
}

fn match_scrutinee_is_unit(value: anf::Imm) -> bool {
    match tast::resolve_type(anf::imm_type(value)) {
        tast::Type::Unit => true,
        _ => false,
    }
}

fn first_match_body(
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
) -> Option[anf::Block] {
    if arms.len() > 0 {
        Option::Some(arms.get(0).body)
    } else {
        default
    }
}

fn compile_match_leaf(
    env: LowerEnv,
    scrut: anf::Imm,
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    if match_scrutinee_is_unit(scrut) {
        match first_match_body(arms, default) {
            Option::Some(body) => append_stmts(result, compile_block(env, body).stmts),
            Option::None => append_stmts(result, non_exhaustive_block().stmts),
        }
    } else if match_uses_types(env, arms) {
        let cases: Vec[TypeSwitchCase] = Vec::new();
        for arm in arms {
            match arm_type(env, arm.lhs) {
                Option::Some(ty) => cases.push(TypeSwitchCase {
                    ty,
                    body: compile_block(env, arm.body),
                }),
                Option::None => (),
            }
        };
        let lowered_default = match default {
            Option::Some(body) => Option::Some(compile_block(env, body)),
            Option::None => Option::Some(non_exhaustive_block()),
        };
        result.push(Stmt::TypeSwitch(
            Option::None,
            compile_imm(env, scrut),
            cases,
            lowered_default,
        ))
    } else {
        let cases: Vec[SwitchCase] = Vec::new();
        for arm in arms {
            cases.push(SwitchCase {
                value: compile_imm(env, arm.lhs),
                body: compile_block(env, arm.body),
            })
        };
        let lowered_default = match default {
            Option::Some(body) => Option::Some(compile_block(env, body)),
            Option::None => Option::Some(non_exhaustive_block()),
        };
        result.push(Stmt::Switch(compile_imm(env, scrut), cases, lowered_default))
    };
    result
}

fn arm_type(env: LowerEnv, value: anf::Imm) -> Option[Type] {
    match value {
        anf::Imm::Tag(tag, owner_ty) => variant_type(env.variants, owner_ty, tag),
        _ => Option::None,
    }
}

fn match_uses_types(env: LowerEnv, values: Vec[anf::Arm]) -> bool {
    let found = Ref::new(false);
    for value in values {
        match arm_type(env, value.lhs) {
            Option::Some(_) => found.set(true),
            Option::None => (),
        }
    };
    found.get()
}

fn non_exhaustive_block() -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Panic("non-exhaustive match"));
    Block { stmts }
}

fn compile_term_leaf(env: LowerEnv, value: anf::Term) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        anf::Term::Return(value) => result.push(Stmt::Return(Option::Some(
            compile_imm_expected(env, value, anf::imm_type(value)),
        ))),
        anf::Term::Jump(target, args, _) => match find_join(env.joins, target) {
            Option::Some(join) => {
                append_stmts(result, compile_jump_args(env, join, args));
                append_stmts(result, compile_block(env, join.body).stmts)
            },
            Option::None => result.push(Stmt::Unreachable),
        },
        anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
            compile_imm(env, cond),
            compile_block(env, then_),
            Option::Some(compile_block(env, else_)),
        )),
        anf::Term::Match(scrut, arms, default, _) => {
            append_stmts(result, compile_match_leaf(env, scrut, arms, default))
        },
        anf::Term::Unreachable(_) => result.push(Stmt::Unreachable),
    };
    result
}

fn compile_term_to_join(
    env: LowerEnv,
    value: anf::Term,
    target: string,
    join: anf::JoinBind,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        anf::Term::Jump(_, args, _) => {
            append_stmts(result, compile_jump_args(env, join, args))
        },
        anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
            compile_imm(env, cond),
            compile_branch_to_join(env, then_, target, join),
            Option::Some(compile_branch_to_join(env, else_, target, join)),
        )),
        anf::Term::Match(scrut, arms, default, _) => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Option::Some(body) => append_stmts(
                        result,
                        compile_branch_to_join(env, body, target, join).stmts,
                    ),
                    Option::None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::new();
                for arm in arms {
                    match arm_type(env, arm.lhs) {
                        Option::Some(ty) => cases.push(TypeSwitchCase {
                            ty,
                            body: compile_branch_to_join(env, arm.body, target, join),
                        }),
                        Option::None => (),
                    }
                };
                let lowered_default = match default {
                    Option::Some(body) => Option::Some(compile_branch_to_join(
                        env,
                        body,
                        target,
                        join,
                    )),
                    Option::None => Option::Some(non_exhaustive_block()),
                };
                result.push(Stmt::TypeSwitch(
                    Option::None,
                    compile_imm(env, scrut),
                    cases,
                    lowered_default,
                ))
            } else {
                let cases: Vec[SwitchCase] = Vec::new();
                for arm in arms {
                    cases.push(SwitchCase {
                        value: compile_imm(env, arm.lhs),
                        body: compile_branch_to_join(env, arm.body, target, join),
                    })
                };
                let lowered_default = match default {
                    Option::Some(body) => Option::Some(compile_branch_to_join(
                        env,
                        body,
                        target,
                        join,
                    )),
                    Option::None => Option::Some(non_exhaustive_block()),
                };
                result.push(Stmt::Switch(
                    compile_imm(env, scrut),
                    cases,
                    lowered_default,
                ))
            }
        },
        _ => append_stmts(result, compile_term_leaf(env, value)),
    };
    result
}

fn compile_term_with_pending(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
) -> Vec[Stmt] {
    match term_target(value) {
        Option::Some(target) => match find_join(pending, target) {
            Option::Some(join) => {
                let result: Vec[Stmt] = Vec::new();
                append_stmts(result, compile_term_to_join(env, value, target, join));
                append_stmts(result, compile_block(env, join.body).stmts);
                result
            },
            Option::None => compile_term_leaf(env, value),
        },
        Option::None => compile_term_leaf(env, value),
    }
}

fn loop_label(value: string) -> string {
    "Loop_" + go_local_ident(value)
}

fn fresh_loop_label_with_suffix(
    emitted: Vec[string],
    base: string,
    suffix: int32,
) -> string {
    let candidate = if suffix == 1 {
        base
    } else {
        base + "__" + suffix.to_string()
    };
    if contains_string(emitted, candidate) {
        fresh_loop_label_with_suffix(emitted, base, suffix + 1)
    } else {
        emitted.push(candidate);
        candidate
    }
}

fn fresh_loop_label(env: LowerEnv, value: string) -> string {
    fresh_loop_label_with_suffix(env.emitted_loop_labels, loop_label(value), 1)
}

fn scoped_joins(parent: Vec[anf::JoinBind], value: anf::Block) -> Vec[anf::JoinBind] {
    let result: Vec[anf::JoinBind] = Vec::new();
    for join in parent {
        result.push(join)
    };
    for bind in value.binds {
        match bind {
            anf::Bind::Join(join) => result.push(join),
            anf::Bind::JoinRec(joins) => {
                for join in joins {
                    result.push(join)
                }
            },
            anf::Bind::Let(_) => (),
        }
    };
    result
}

fn block_reaches_target(
    value: anf::Block,
    target: string,
    parent: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    let joins = scoped_joins(parent, value);
    term_reaches_target(value.term, target, joins, visited)
}

fn term_reaches_target(
    value: anf::Term,
    target: string,
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    match value {
        anf::Term::Jump(name, args, _) => {
            if name == target && args.len() == 0 {
                true
            } else if contains_string(visited, name) {
                false
            } else {
                match find_join(joins, name) {
                    Option::Some(join) => {
                        visited.push(name);
                        block_reaches_target(join.body, target, joins, visited)
                    },
                    Option::None => false,
                }
            }
        },
        anf::Term::If(_, then_, else_, _) => {
            block_reaches_target(then_, target, joins, visited)
                || block_reaches_target(else_, target, joins, visited)
        },
        anf::Term::Match(_, arms, default, _) => {
            let reaches = Ref::new(false);
            for arm in arms {
                if block_reaches_target(arm.body, target, joins, visited) {
                    reaches.set(true)
                } else {
                    ()
                }
            };
            match default {
                Option::Some(body) => {
                    if block_reaches_target(body, target, joins, visited) {
                        reaches.set(true)
                    } else {
                        ()
                    }
                },
                Option::None => (),
            };
            reaches.get()
        },
        anf::Term::Return(_) | anf::Term::Unreachable(_) => false,
    }
}

fn block_tail_target_through_joins(
    value: anf::Block,
    parent: Vec[anf::JoinBind],
    visited: Vec[string],
) -> Option[string] {
    let joins = scoped_joins(parent, value);
    term_tail_target_through_joins(value.term, joins, visited)
}

fn term_tail_target_through_joins(
    value: anf::Term,
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> Option[string] {
    match value {
        anf::Term::Jump(target, args, _) => {
            if args.len() == 0 {
                Option::Some(target)
            } else if contains_string(visited, target) {
                Option::None
            } else {
                match find_join(joins, target) {
                    Option::Some(join) => {
                        visited.push(target);
                        let result = block_tail_target_through_joins(
                            join.body,
                            joins,
                            visited,
                        );
                        let _ = visited.remove(visited.len() - 1);
                        result
                    },
                    Option::None => Option::None,
                }
            }
        },
        anf::Term::If(_, then_, else_, _) => {
            same_target(
                block_tail_target_through_joins(then_, joins, visited),
                block_tail_target_through_joins(else_, joins, visited),
            )
        },
        anf::Term::Match(_, arms, default, _) => {
            let result: Ref[Option[string]] = Ref::new(Option::None);
            let valid = Ref::new(true);
            for arm in arms {
                match block_tail_target_through_joins(arm.body, joins, visited) {
                    Option::Some(target) => match result.get() {
                        Option::Some(current) => {
                            if current != target {
                                valid.set(false)
                            } else {
                                ()
                            }
                        },
                        Option::None => result.set(Option::Some(target)),
                    },
                    Option::None => valid.set(false),
                }
            };
            match default {
                Option::Some(body) => {
                    match block_tail_target_through_joins(body, joins, visited) {
                        Option::Some(target) => match result.get() {
                            Option::Some(current) => {
                                if current != target {
                                    valid.set(false)
                                } else {
                                    ()
                                }
                            },
                            Option::None => result.set(Option::Some(target)),
                        },
                        Option::None => valid.set(false),
                    }
                },
                Option::None => (),
            };
            if valid.get() { result.get() } else { Option::None }
        },
        anf::Term::Return(_) | anf::Term::Unreachable(_) => Option::None,
    }
}

fn block_all_paths_reach_or_terminate(
    value: anf::Block,
    target: string,
    parent: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    let joins = scoped_joins(parent, value);
    term_all_paths_reach_or_terminate(value.term, target, joins, visited)
}

fn term_all_paths_reach_or_terminate(
    value: anf::Term,
    target: string,
    joins: Vec[anf::JoinBind],
    visited: Vec[string],
) -> bool {
    match value {
        anf::Term::Jump(name, _, _) => {
            if name == target {
                true
            } else if contains_string(visited, name) {
                false
            } else {
                match find_join(joins, name) {
                    Option::Some(join) => {
                        visited.push(name);
                        let result = block_all_paths_reach_or_terminate(
                            join.body,
                            target,
                            joins,
                            visited,
                        );
                        let _ = visited.remove(visited.len() - 1);
                        result
                    },
                    Option::None => true,
                }
            }
        },
        anf::Term::If(_, then_, else_, _) => {
            block_all_paths_reach_or_terminate(then_, target, joins, visited)
                && block_all_paths_reach_or_terminate(else_, target, joins, visited)
        },
        anf::Term::Match(_, arms, default, _) => {
            let result = Ref::new(true);
            for arm in arms {
                if !block_all_paths_reach_or_terminate(arm.body, target, joins, visited) {
                    result.set(false)
                } else {
                    ()
                }
            };
            match default {
                Option::Some(body) => {
                    if !block_all_paths_reach_or_terminate(body, target, joins, visited) {
                        result.set(false)
                    } else {
                        ()
                    }
                },
                Option::None => (),
            };
            result.get()
        },
        anf::Term::Return(_) | anf::Term::Unreachable(_) => true,
    }
}

fn all_paths_reach_or_terminate(value: anf::Block, target: string) -> bool {
    block_all_paths_reach_or_terminate(value, target, Vec::new(), Vec::new())
}

fn loop_exit_target(value: anf::Block, loop_name: string) -> Option[string] {
    let joins = scoped_joins(Vec::new(), value);
    match value.term {
        anf::Term::If(_, then_, else_, _) => {
            let then_reaches = block_reaches_target(then_, loop_name, joins, Vec::new());
            let else_reaches = block_reaches_target(else_, loop_name, joins, Vec::new());
            if then_reaches && !else_reaches {
                block_tail_target_through_joins(else_, joins, Vec::new())
            } else if else_reaches && !then_reaches {
                block_tail_target_through_joins(then_, joins, Vec::new())
            } else {
                Option::None
            }
        },
        anf::Term::Match(_, arms, default, _) => {
            let saw_continue = Ref::new(false);
            let exit_target: Ref[Option[string]] = Ref::new(Option::None);
            let valid = Ref::new(true);
            for arm in arms {
                if block_reaches_target(arm.body, loop_name, joins, Vec::new()) {
                    saw_continue.set(true)
                } else {
                    match block_tail_target_through_joins(arm.body, joins, Vec::new()) {
                        Option::Some(target) => match exit_target.get() {
                            Option::Some(current) => {
                                if current != target {
                                    valid.set(false)
                                } else {
                                    ()
                                }
                            },
                            Option::None => exit_target.set(Option::Some(target)),
                        },
                        Option::None => valid.set(false),
                    }
                }
            };
            match default {
                Option::Some(body) => {
                    if block_reaches_target(body, loop_name, joins, Vec::new()) {
                        saw_continue.set(true)
                    } else {
                        match block_tail_target_through_joins(body, joins, Vec::new()) {
                            Option::Some(target) => match exit_target.get() {
                                Option::Some(current) => {
                                    if current != target {
                                        valid.set(false)
                                    } else {
                                        ()
                                    }
                                },
                                Option::None => exit_target.set(Option::Some(target)),
                            },
                            Option::None => valid.set(false),
                        }
                    }
                },
                Option::None => (),
            };
            if saw_continue.get() && valid.get() {
                exit_target.get()
            } else {
                Option::None
            }
        },
        _ => Option::None,
    }
}

fn find_loop_exit(value: anf::Block, loop_name: string) -> Option[string] {
    match loop_exit_target(value, loop_name) {
        Option::Some(target) => Option::Some(target),
        Option::None => {
            let result: Ref[Option[string]] = Ref::new(Option::None);
            for bind in value.binds {
                match bind {
                    anf::Bind::Join(dispatch) => {
                        let pending = match result.get() {
                            Option::Some(_) => false,
                            Option::None => true,
                        };
                        if pending && all_paths_reach_or_terminate(value, dispatch.name) {
                            result.set(find_loop_exit(dispatch.body, loop_name))
                        } else {
                            ()
                        }
                    },
                    _ => (),
                }
            };
            result.get()
        },
    }
}

fn compile_loop_branch_to_join(
    env: LowerEnv,
    value: anf::Block,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                };
                pending.push(value)
            },
            anf::Bind::JoinRec(values) => {
                let compiled = compile_joinrec_in_loop(
                    env,
                    values,
                    loop_name,
                    exit_name,
                    label,
                );
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    };
    let suppress = match value.term {
        anf::Term::Jump(target, args, _) => {
            args.len() == 0 && contains_string(loop_names, target)
        },
        _ => false,
    };
    if !suppress {
        match term_target(value.term) {
            Option::Some(inner_target) => {
                if inner_target == target {
                    append_stmts(stmts, compile_loop_term_to_join(
                        env,
                        value.term,
                        target,
                        join,
                        loop_name,
                        exit_name,
                        label,
                    ))
                } else {
                    match find_join(pending, inner_target) {
                        Option::Some(inner_join) => {
                            append_stmts(stmts, compile_loop_term_to_join(
                                env,
                                value.term,
                                inner_target,
                                inner_join,
                                loop_name,
                                exit_name,
                                label,
                            ));
                            append_stmts(stmts, compile_loop_branch_to_join(
                                env,
                                inner_join.body,
                                target,
                                join,
                                loop_name,
                                exit_name,
                                label,
                            ).stmts)
                        },
                        Option::None => append_stmts(stmts, compile_loop_term_with_pending(
                            env,
                            value.term,
                            pending,
                            loop_name,
                            exit_name,
                            label,
                        )),
                    }
                }
            },
            Option::None => append_stmts(stmts, compile_loop_term_with_pending(
                env,
                value.term,
                pending,
                loop_name,
                exit_name,
                label,
            )),
        }
    } else {
        ()
    };
    Block { stmts }
}

fn compile_loop_term_leaf(
    env: LowerEnv,
    value: anf::Term,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        anf::Term::Jump(target, _, _) => {
            if target == loop_name {
                result.push(Stmt::Continue)
            } else if target == exit_name {
                result.push(Stmt::BreakLabel(label))
            } else {
                match find_join(env.joins, target) {
                    Option::Some(join) => {
                        match value {
                            anf::Term::Jump(_, args, _) => {
                                append_stmts(result, compile_jump_args(env, join, args))
                            },
                            _ => (),
                        };
                        append_stmts(
                            result,
                            compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                        )
                    },
                    Option::None => append_stmts(result, compile_term_leaf(env, value)),
                }
            }
        },
        anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
            compile_imm(env, cond),
            compile_loop_block(env, then_, loop_name, exit_name, label),
            Option::Some(compile_loop_block(env, else_, loop_name, exit_name, label)),
        )),
        anf::Term::Match(scrut, arms, default, _) => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Option::Some(body) => append_stmts(
                        result,
                        compile_loop_block(env, body, loop_name, exit_name, label).stmts,
                    ),
                    Option::None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::new();
                for arm in arms {
                    match arm_type(env, arm.lhs) {
                        Option::Some(ty) => cases.push(TypeSwitchCase {
                            ty,
                            body: compile_loop_block(
                                env,
                                arm.body,
                                loop_name,
                                exit_name,
                                label,
                            ),
                        }),
                        Option::None => (),
                    }
                };
                let lowered_default = match default {
                    Option::Some(body) => Option::Some(compile_loop_block(
                        env,
                        body,
                        loop_name,
                        exit_name,
                        label,
                    )),
                    Option::None => Option::Some(non_exhaustive_block()),
                };
                result.push(Stmt::TypeSwitch(
                    Option::None,
                    compile_imm(env, scrut),
                    cases,
                    lowered_default,
                ))
            } else {
                let cases: Vec[SwitchCase] = Vec::new();
                for arm in arms {
                    cases.push(SwitchCase {
                        value: compile_imm(env, arm.lhs),
                        body: compile_loop_block(
                            env,
                            arm.body,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    })
                };
                let lowered_default = match default {
                    Option::Some(body) => Option::Some(compile_loop_block(
                        env,
                        body,
                        loop_name,
                        exit_name,
                        label,
                    )),
                    Option::None => Option::Some(non_exhaustive_block()),
                };
                result.push(Stmt::Switch(
                    compile_imm(env, scrut),
                    cases,
                    lowered_default,
                ))
            }
        },
        _ => append_stmts(result, compile_term_leaf(env, value)),
    };
    result
}

fn compile_loop_term_to_join(
    env: LowerEnv,
    value: anf::Term,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        anf::Term::Jump(_, args, _) => {
            append_stmts(result, compile_jump_args(env, join, args))
        },
        anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
            compile_imm(env, cond),
            compile_loop_branch_to_join(
                env,
                then_,
                target,
                join,
                loop_name,
                exit_name,
                label,
            ),
            Option::Some(compile_loop_branch_to_join(
                env,
                else_,
                target,
                join,
                loop_name,
                exit_name,
                label,
            )),
        )),
        anf::Term::Match(scrut, arms, default, _) => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Option::Some(body) => append_stmts(
                        result,
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ).stmts,
                    ),
                    Option::None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::new();
                for arm in arms {
                    match arm_type(env, arm.lhs) {
                        Option::Some(ty) => cases.push(TypeSwitchCase {
                            ty,
                            body: compile_loop_branch_to_join(
                                env,
                                arm.body,
                                target,
                                join,
                                loop_name,
                                exit_name,
                                label,
                            ),
                        }),
                        Option::None => (),
                    }
                };
                let lowered_default = match default {
                    Option::Some(body) => Option::Some(compile_loop_branch_to_join(
                        env,
                        body,
                        target,
                        join,
                        loop_name,
                        exit_name,
                        label,
                    )),
                    Option::None => Option::Some(non_exhaustive_block()),
                };
                result.push(Stmt::TypeSwitch(
                    Option::None,
                    compile_imm(env, scrut),
                    cases,
                    lowered_default,
                ))
            } else {
                let cases: Vec[SwitchCase] = Vec::new();
                for arm in arms {
                    cases.push(SwitchCase {
                        value: compile_imm(env, arm.lhs),
                        body: compile_loop_branch_to_join(
                            env,
                            arm.body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    })
                };
                let lowered_default = match default {
                    Option::Some(body) => Option::Some(compile_loop_branch_to_join(
                        env,
                        body,
                        target,
                        join,
                        loop_name,
                        exit_name,
                        label,
                    )),
                    Option::None => Option::Some(non_exhaustive_block()),
                };
                result.push(Stmt::Switch(
                    compile_imm(env, scrut),
                    cases,
                    lowered_default,
                ))
            }
        },
        _ => append_stmts(
            result,
            compile_loop_term_leaf(env, value, loop_name, exit_name, label),
        ),
    };
    result
}

fn compile_loop_term_with_pending(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    match term_target(value) {
        Option::Some(target) => match find_join(pending, target) {
            Option::Some(join) => {
                let result: Vec[Stmt] = Vec::new();
                append_stmts(result, compile_loop_term_to_join(
                    env,
                    value,
                    target,
                    join,
                    loop_name,
                    exit_name,
                    label,
                ));
                append_stmts(
                    result,
                    compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                );
                result
            },
            Option::None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
        },
        Option::None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
    }
}

fn compile_loop_block(
    env: LowerEnv,
    value: anf::Block,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                };
                pending.push(value)
            },
            anf::Bind::JoinRec(values) => {
                let compiled = compile_joinrec_in_loop(
                    env,
                    values,
                    loop_name,
                    exit_name,
                    label,
                );
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    };
    let suppress = match value.term {
        anf::Term::Jump(target, args, _) => {
            args.len() == 0 && contains_string(loop_names, target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(
            stmts,
            compile_loop_term_with_pending(env, value.term, pending, loop_name, exit_name, label),
        )
    } else {
        ()
    };
    Block { stmts }
}

fn compile_joinrec_in_loop(
    env: LowerEnv,
    values: Vec[anf::JoinBind],
    outer_loop_name: string,
    outer_exit_name: string,
    outer_label: string,
) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    let single = values.len() == 1;
    for value in values {
        match find_loop_exit(value.body, value.name) {
            Option::Some(exit_name) => {
                let label = fresh_loop_label(env, value.name);
                let body = compile_loop_block(env, value.body, value.name, exit_name, label);
                stmts.push(loop_stmt(label, body));
                match find_join(env.joins, exit_name) {
                    Option::Some(exit) => {
                        append_stmts(stmts, compile_loop_block(
                            env,
                            exit.body,
                            outer_loop_name,
                            outer_exit_name,
                            outer_label,
                        ).stmts)
                    },
                    Option::None => (),
                };
                loop_names.push(value.name)
            },
            Option::None => if single
                && block_reaches_target(value.body, value.name, Vec::new(), Vec::new()) == false
            {
                append_stmts(stmts, compile_loop_block(
                    env,
                    value.body,
                    outer_loop_name,
                    outer_exit_name,
                    outer_label,
                ).stmts);
                loop_names.push(value.name)
            } else {
                stmts.push(Stmt::Unreachable)
            },
        }
    };
    JoinRecResult { stmts, loop_names }
}

fn block_contains_break_label(value: Block, label: string) -> bool {
    let found = Ref::new(false);
    for stmt in value.stmts {
        if stmt_contains_break_label(stmt, label) {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn stmt_contains_break_label(value: Stmt, label: string) -> bool {
    match value {
        Stmt::BreakLabel(actual) => actual == label,
        Stmt::If(_, then_, else_) => {
            block_contains_break_label(then_, label) || match else_ {
                Option::Some(body) => block_contains_break_label(body, label),
                Option::None => false,
            }
        },
        Stmt::Loop(body) | Stmt::LabeledLoop(_, body) => {
            block_contains_break_label(body, label)
        },
        Stmt::Switch(_, cases, default) => {
            let found = Ref::new(false);
            for case in cases {
                if block_contains_break_label(case.body, label) {
                    found.set(true)
                } else {
                    ()
                }
            };
            match default {
                Option::Some(body) => if block_contains_break_label(body, label) {
                    found.set(true)
                } else {
                    ()
                },
                Option::None => (),
            };
            found.get()
        },
        Stmt::TypeSwitch(_, _, cases, default) => {
            let found = Ref::new(false);
            for case in cases {
                if block_contains_break_label(case.body, label) {
                    found.set(true)
                } else {
                    ()
                }
            };
            match default {
                Option::Some(body) => if block_contains_break_label(body, label) {
                    found.set(true)
                } else {
                    ()
                },
                Option::None => (),
            };
            found.get()
        },
        _ => false,
    }
}

fn loop_stmt(label: string, body: Block) -> Stmt {
    if block_contains_break_label(body, label) {
        Stmt::LabeledLoop(label, body)
    } else {
        Stmt::Loop(body)
    }
}

fn compile_joinrec(env: LowerEnv, values: Vec[anf::JoinBind]) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    let single = values.len() == 1;
    for value in values {
        match find_loop_exit(value.body, value.name) {
            Option::Some(exit_name) => {
                let label = fresh_loop_label(env, value.name);
                let body = compile_loop_block(env, value.body, value.name, exit_name, label);
                stmts.push(loop_stmt(label, body));
                match find_join(env.joins, exit_name) {
                    Option::Some(exit) => {
                        append_stmts(stmts, compile_block(env, exit.body).stmts)
                    },
                    Option::None => (),
                };
                loop_names.push(value.name)
            },
            Option::None => if single
                && block_reaches_target(value.body, value.name, Vec::new(), Vec::new()) == false
            {
                append_stmts(stmts, compile_block(env, value.body).stmts);
                loop_names.push(value.name)
            } else {
                stmts.push(Stmt::Unreachable)
            },
        }
    };
    JoinRecResult { stmts, loop_names }
}

fn compile_block(env: LowerEnv, value: anf::Block) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                };
                pending.push(value)
            },
            anf::Bind::JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    };
    let suppress = match value.term {
        anf::Term::Jump(target, args, _) => {
            args.len() == 0 && contains_string(loop_names, target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(stmts, compile_term_with_pending(env, value.term, pending))
    } else {
        ()
    };
    Block { stmts }
}

struct CollectedTypes {
    values: Vec[tast::Type],
    names: HashMap[string, unit],
}

fn new_collected_types() -> CollectedTypes {
    CollectedTypes {
        values: Vec::new(),
        names: HashMap::new(),
    }
}

fn add_collected_type(result: CollectedTypes, value: tast::Type) -> unit {
    let name = type_name(value);
    if result.names.contains(name) == false {
        result.names.set(name, ());
        result.values.push(value)
    } else {
        ()
    }
}

fn collect_type(result: CollectedTypes, value: tast::Type) -> unit {
    match tast::resolve_type(value) {
        tast::Type::Tuple(values) => {
            add_collected_type(result, value);
            for inner in values {
                collect_type(result, inner)
            }
        },
        tast::Type::Con(_) => add_collected_type(result, value),
        tast::Type::Dyn(_) => add_collected_type(result, value),
        tast::Type::Projection(base, _, _) => collect_type(result, base),
        tast::Type::App(base, args) => {
            collect_type(result, base);
            for arg in args {
                collect_type(result, arg)
            }
        },
        tast::Type::Array(_, elem) => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        tast::Type::Slice(elem) => collect_type(result, elem),
        tast::Type::VecType(elem) => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        tast::Type::RefType(elem) => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        tast::Type::HashMap(key, value) => {
            add_collected_type(result, tast::Type::HashMap(key, value));
            collect_type(result, key);
            collect_type(result, value);
        },
        tast::Type::Func(params, ret_ty) => {
            for param in params {
                collect_type(result, param)
            };
            collect_type(result, ret_ty)
        },
        _ => (),
    }
}

fn collect_imm_type(result: CollectedTypes, value: anf::Imm) -> unit {
    collect_type(result, anf::imm_type(value))
}

fn collect_runtime_imm(
    result: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    value: anf::Imm,
) -> unit {
    match value {
        anf::Imm::Callable(tast::Callable::Runtime(key), _) => {
            if contains_string(result, key) == false {
                result.push(key)
            } else {
                ()
            }
        },
        anf::Imm::Callable(tast::Callable::Intrinsic(key), function_ty) => {
            if contains_string(intrinsics, key) == false {
                intrinsics.push(key)
            } else {
                ()
            };
            if key == "compiler.missing" {
                match tast::resolve_type(function_ty) {
                    tast::Type::Func(_, ret_ty) => add_collected_type(missing_types, ret_ty),
                    _ => (),
                }
            } else {
                ()
            }
        },
        _ => (),
    }
}

fn collect_runtime_value(
    result: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    value: anf::Value,
) -> unit {
    match value {
        anf::Value::Imm(value) => {
            collect_runtime_imm(result, missing_types, intrinsics, value)
        },
        anf::Value::Constr(_, args, _)
        | anf::Value::Tuple(args, _)
        | anf::Value::Array(args, _) => {
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, arg)
            }
        },
        anf::Value::ConstrGet(expr, _, _, _)
        | anf::Value::Unary(_, expr, _)
        | anf::Value::Cast(expr, _)
        | anf::Value::Go(expr, _)
        | anf::Value::Proj(expr, _, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, expr)
        },
        anf::Value::Binary(_, lhs, rhs, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, lhs);
            collect_runtime_imm(result, missing_types, intrinsics, rhs)
        },
        anf::Value::Assign(_, expr, _, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, expr)
        },
        anf::Value::Call(func, args, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, func);
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, arg)
            }
        },
        anf::Value::ToDyn(_, _, expr, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, expr)
        },
        anf::Value::DynCall(_, _, receiver, args, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, receiver);
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, arg)
            }
        },
    }
}

fn collect_runtime_block(
    result: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    value: anf::Block,
) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => {
                collect_runtime_value(result, missing_types, intrinsics, value.value)
            },
            anf::Bind::Join(value) => {
                collect_runtime_block(result, missing_types, intrinsics, value.body)
            },
            anf::Bind::JoinRec(values) => {
                for value in values {
                    collect_runtime_block(result, missing_types, intrinsics, value.body)
                }
            },
        }
    };
    match value.term {
        anf::Term::Return(value) => {
            collect_runtime_imm(result, missing_types, intrinsics, value)
        },
        anf::Term::Jump(_, args, _) => {
            for arg in args {
                collect_runtime_imm(result, missing_types, intrinsics, arg)
            }
        },
        anf::Term::If(cond, then_, else_, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, cond);
            collect_runtime_block(result, missing_types, intrinsics, then_);
            collect_runtime_block(result, missing_types, intrinsics, else_)
        },
        anf::Term::Match(scrut, arms, default, _) => {
            collect_runtime_imm(result, missing_types, intrinsics, scrut);
            for arm in arms {
                collect_runtime_imm(result, missing_types, intrinsics, arm.lhs);
                collect_runtime_block(result, missing_types, intrinsics, arm.body)
            };
            match default {
                Option::Some(body) => {
                    collect_runtime_block(result, missing_types, intrinsics, body)
                },
                Option::None => (),
            }
        },
        anf::Term::Unreachable(_) => (),
    }
}

fn collect_value_type(result: CollectedTypes, value: anf::Value) -> unit {
    collect_type(result, anf::value_type(value));
    match value {
        anf::Value::Imm(value) => collect_imm_type(result, value),
        anf::Value::Constr(_, args, _)
        | anf::Value::Tuple(args, _)
        | anf::Value::Array(args, _) => {
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        anf::Value::ConstrGet(expr, _, _, _)
        | anf::Value::Unary(_, expr, _)
        | anf::Value::Cast(expr, _)
        | anf::Value::Go(expr, _)
        | anf::Value::Proj(expr, _, _) => collect_imm_type(result, expr),
        anf::Value::Binary(_, lhs, rhs, _) => {
            collect_imm_type(result, lhs);
            collect_imm_type(result, rhs)
        },
        anf::Value::Assign(_, expr, target_ty, _) => {
            collect_imm_type(result, expr);
            collect_type(result, target_ty)
        },
        anf::Value::Call(func, args, _) => {
            collect_imm_type(result, func);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        anf::Value::ToDyn(_, for_ty, expr, _) => {
            collect_type(result, for_ty);
            collect_imm_type(result, expr)
        },
        anf::Value::DynCall(_, _, receiver, args, _) => {
            collect_imm_type(result, receiver);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
    }
}

fn collect_block_types(result: CollectedTypes, value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => {
                collect_type(result, value.ty);
                collect_value_type(result, value.value)
            },
            anf::Bind::Join(value) => {
                for param in value.params {
                    collect_type(result, param.1)
                };
                collect_type(result, value.ret_ty);
                collect_block_types(result, value.body)
            },
            anf::Bind::JoinRec(values) => {
                for value in values {
                    for param in value.params {
                        collect_type(result, param.1)
                    };
                    collect_type(result, value.ret_ty);
                    collect_block_types(result, value.body)
                }
            },
        }
    };
    match value.term {
        anf::Term::Return(value) => collect_imm_type(result, value),
        anf::Term::Jump(_, args, ty) => {
            collect_type(result, ty);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        anf::Term::If(cond, then_, else_, ty) => {
            collect_imm_type(result, cond);
            collect_type(result, ty);
            collect_block_types(result, then_);
            collect_block_types(result, else_)
        },
        anf::Term::Match(scrut, arms, default, ty) => {
            collect_imm_type(result, scrut);
            collect_type(result, ty);
            for arm in arms {
                collect_imm_type(result, arm.lhs);
                collect_block_types(result, arm.body)
            };
            match default {
                Option::Some(body) => collect_block_types(result, body),
                Option::None => (),
            }
        },
        anf::Term::Unreachable(ty) => collect_type(result, ty),
    }
}

fn collect_type_definition_fields(
    result: CollectedTypes,
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    instances: Vec[core::TypeInstance],
) -> unit {
    for definition in structs {
        if definition.generics.len() == 0 {
            for field in definition.fields {
                collect_type(result, instantiate_type(
                    field.1,
                    definition.generics,
                    Vec::new(),
                    instances,
                ))
            }
        } else {
            ()
        }
    };
    for definition in enums {
        if definition.generics.len() == 0 {
            for variant in definition.variants {
                for field in tast::enum_variant_field_types(variant.fields) {
                    collect_type(result, instantiate_type(
                        field,
                        definition.generics,
                        Vec::new(),
                        instances,
                    ))
                }
            }
        } else {
            ()
        }
    };
    for instance in instances {
        match find_struct(structs, instance.base_name) {
            Option::Some(definition) => {
                for field in definition.fields {
                    collect_type(result, instantiate_type(
                        field.1,
                        definition.generics,
                        instance.args,
                        instances,
                    ))
                }
            },
            Option::None => match find_enum(enums, instance.base_name) {
                Option::Some(definition) => {
                    for variant in definition.variants {
                        for field in tast::enum_variant_field_types(variant.fields) {
                            collect_type(result, instantiate_type(
                                field,
                                definition.generics,
                                instance.args,
                                instances,
                            ))
                        }
                    }
                },
                Option::None => (),
            },
        }
    }
}

fn runtime_struct(value: tast::Type) -> StructDef {
    match tast::resolve_type(value) {
        tast::Type::Tuple(values) => {
            let fields: Vec[(string, Type)] = Vec::new();
            for index in range(0, values.len()) {
                fields.push(("_" + index.to_string(), lower_type(values.get(index))))
            };
            StructDef { name: type_name(value), fields }
        },
        tast::Type::RefType(elem) => {
            let fields: Vec[(string, Type)] = Vec::new();
            fields.push(("value", lower_type(elem)));
            StructDef {
                name: go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x"),
                fields,
            }
        },
        tast::Type::VecType(elem) => {
            let fields: Vec[(string, Type)] = Vec::new();
            fields.push(("items", Type::Slice(lower_type(elem))));
            StructDef {
                name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                fields,
            }
        },
        _ => StructDef { name: "Error", fields: Vec::new() },
    }
}

fn add_dyn_coercion(
    result: Vec[DynCoercion],
    trait_name: string,
    for_ty: tast::Type,
) -> unit {
    let found = Ref::new(false);
    for value in result {
        if value.trait_name == trait_name && encode_type(value.for_ty) == encode_type(for_ty) {
            found.set(true)
        } else {
            ()
        }
    };
    if found.get() == false {
        result.push(DynCoercion { trait_name, for_ty })
    } else {
        ()
    }
}

fn collect_dyn_value(result: Vec[DynCoercion], value: anf::Value) -> unit {
    match value {
        anf::Value::ToDyn(trait_name, for_ty, _, _) => {
            add_dyn_coercion(result, trait_name, for_ty)
        },
        _ => (),
    }
}

fn collect_dyn_block(result: Vec[DynCoercion], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => collect_dyn_value(result, value.value),
            anf::Bind::Join(value) => collect_dyn_block(result, value.body),
            anf::Bind::JoinRec(values) => {
                for value in values {
                    collect_dyn_block(result, value.body)
                }
            },
        }
    };
    match value.term {
        anf::Term::If(_, then_, else_, _) => {
            collect_dyn_block(result, then_);
            collect_dyn_block(result, else_)
        },
        anf::Term::Match(_, arms, default, _) => {
            for arm in arms {
                collect_dyn_block(result, arm.body)
            };
            match default {
                Option::Some(body) => collect_dyn_block(result, body),
                Option::None => (),
            }
        },
        _ => (),
    }
}

fn compile_function(
    value: anf::Function,
    variants: VariantInfos,
    closures: Vec[ClosureInfo],
    structs: Vec[tast::StructDef],
    instances: Vec[core::TypeInstance],
    functions: Vec[anf::Function],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
) -> Function {
    let joins: Vec[anf::JoinBind] = Vec::new();
    collect_joins_block(joins, value.body);
    let params: Vec[(string, Type)] = Vec::new();
    for param in value.params {
        params.push((go_local_ident(param.0), lower_type(param.1)))
    };
    let env = LowerEnv {
        joins,
        emitted_loop_labels: Vec::new(),
        variants,
        closures,
        structs,
        instances,
        functions,
        function_names,
        dyn_helper_names,
    };
    Function {
        name: env_function_name(env, value.name),
        params,
        ret_ty: Option::Some(lower_type(value.ret_ty)),
        body: eliminate_dead_vars(compile_block(env, value.body)),
    }
}

fn test_main_function(
    function_names: FunctionNames,
    test_cases: Vec[(string, string)],
) -> Function {
    let cases: Vec[SwitchCase] = Vec::new();
    for test_case in test_cases {
        let function_name = match mapped_function_name(function_names, test_case.1) {
            Option::Some(name) => name,
            Option::None => function_name(test_case.1),
        };
        let body_stmts: Vec[Stmt] = Vec::new();
        body_stmts.push(Stmt::Expr(Expr::Call(
            Expr::Var(function_name),
            Vec::new(),
        )));
        cases.push(SwitchCase {
            value: Expr::String(test_case.0),
            body: Block { stmts: body_stmts },
        })
    };
    let default_stmts: Vec[Stmt] = Vec::new();
    let fail_args: Vec[Expr] = Vec::new();
    fail_args.push(Expr::String("unknown test id"));
    default_stmts.push(Stmt::Expr(Expr::Call(
        Expr::Var(runtime_hook_name("std.testing.fail")),
        fail_args,
    )));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Switch(
        Expr::Index(
            Expr::Var("_goml_os.Args"),
            Expr::Int("1"),
        ),
        cases,
        Option::Some(Block { stmts: default_stmts }),
    ));
    Function {
        name: "main",
        params: Vec::new(),
        ret_ty: Option::None,
        body: Block { stmts },
    }
}

fn lower_with_test_cases(
    value: anf::File,
    testing: bool,
    test_cases: Vec[(string, string)],
) -> File {
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let closures = collect_closure_infos(value.functions);
    let function_names = build_function_names(
        value.functions,
        structs,
        enums,
        type_instances,
    );
    let items: Vec[Item] = Vec::new();
    let types = new_collected_types();
    let runtime_hooks: Vec[string] = Vec::new();
    let intrinsics: Vec[string] = Vec::new();
    let missing_types = new_collected_types();
    let coercions: Vec[DynCoercion] = Vec::new();
    let variants = new_variant_infos();
    for function in value.functions {
        for param in function.params {
            collect_type(types, param.1)
        };
        collect_type(types, function.ret_ty);
        collect_block_types(types, function.body);
        collect_runtime_block(
            runtime_hooks,
            missing_types,
            intrinsics,
            function.body,
        );
        collect_dyn_block(coercions, function.body)
    };
    if testing {
        runtime_hooks.push("std.testing.fail")
    } else {
        ()
    };
    let dyn_helper_names = build_dyn_helper_names(coercions, value.functions);
    collect_type_definition_fields(types, enums, structs, type_instances);
    emit_runtime_hook_items(items, runtime_hooks, intrinsics);
    emit_missing_base_item(items, missing_types.values);
    emit_builtin_runtime_items(
        items,
        types.values,
        missing_types.values,
        type_instances,
        enums,
        structs,
        function_names,
    );
    emit_user_type_items(
        items,
        variants,
        enums,
        structs,
        type_instances,
        function_names,
    );
    emit_dyn_runtime_items(
        items,
        types.values,
        coercions,
        enums,
        type_instances,
        value.functions,
        dyn_helper_names,
    );
    for function in value.functions {
        items.push(Item::Function(compile_function(
            function,
            variants,
            closures,
            structs,
            type_instances,
            value.functions,
            function_names,
            dyn_helper_names,
        )))
    };
    if testing {
        items.push(Item::Function(test_main_function(
            function_names,
            test_cases,
        )))
    } else {
        let stmts: Vec[Stmt] = Vec::new();
        let entry_name = match mapped_function_name(function_names, "main") {
            Option::Some(name) => name,
            Option::None => "main0",
        };
        stmts.push(Stmt::Expr(Expr::Call(Expr::Var(entry_name), Vec::new())));
        items.push(Item::Function(Function {
            name: "main",
            params: Vec::new(),
            ret_ty: Option::None,
            body: Block { stmts },
        }))
    };
    prune_functions(File { items })
}

pub fn lower(value: anf::File) -> File {
    lower_with_test_cases(value, false, Vec::new())
}

pub fn lower_tests(value: anf::File, test_cases: Vec[(string, string)]) -> File {
    lower_with_test_cases(value, true, test_cases)
}
