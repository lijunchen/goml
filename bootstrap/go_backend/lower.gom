package go_backend;

use gomlang::parser::anf;
use gomlang::parser::ast;
use gomlang::parser::core;
use gomlang::parser::tast;

struct LowerEnv {
    joins: Vec[anf::JoinBind],
    variants: Vec[VariantInfo],
    closures: Vec[ClosureInfo],
    structs: Vec[tast::StructDef],
}

struct CompiledValue {
    stmts: Vec[Stmt],
    expr: Expr,
}

struct JoinRecResult {
    stmts: Vec[Stmt],
    loop_names: Vec[string],
}

fn append_stmts(target: Vec[Stmt], values: Vec[Stmt]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn append_items(target: Vec[Item], values: Vec[Item]) -> unit {
    for value in values {
        target.push(value)
    }
}

fn contains_string(values: Vec[string], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn function_name(value: string) -> string {
    if value == "main" {
        "main0"
    } else if value == "init" {
        go_generated_ident("_goml_user_init")
    } else {
        go_ident(value)
    }
}

fn callable_name(value: tast::Callable) -> string {
    match value {
        tast::Callable::Function(name) => function_name(name),
        tast::Callable::Runtime(name) | tast::Callable::Intrinsic(name) => go_ident(name),
        tast::Callable::TraitMethod(reference, name) => {
            go_ident(reference.name + "#" + name)
        },
        tast::Callable::DynTraitMethod(owner, name) => go_ident("dyn#" + owner + "#" + name),
        tast::Callable::InherentMethod(owner, name) => {
            go_ident("inherent#" + encode_type(owner) + "#" + name)
        },
    }
}

fn compile_primitive(value: tast::Primitive) -> Expr {
    match value {
        tast::Primitive::Unit => Expr::Unit,
        tast::Primitive::Bool(value) => Expr::Bool(value),
        tast::Primitive::Int(value)
        | tast::Primitive::Int8(value)
        | tast::Primitive::Int16(value)
        | tast::Primitive::Int32(value)
        | tast::Primitive::Int64(value)
        | tast::Primitive::Uint8(value)
        | tast::Primitive::Uint16(value)
        | tast::Primitive::Uint32(value)
        | tast::Primitive::Uint64(value) => Expr::Int(value),
        tast::Primitive::Float(value)
        | tast::Primitive::Float32(value)
        | tast::Primitive::Float64(value) => Expr::Float(value),
        tast::Primitive::String(value) => Expr::String(value),
        tast::Primitive::Char(value) => Expr::Int((value as uint32).to_string()),
    }
}

fn compile_imm(value: anf::Imm) -> Expr {
    match value {
        anf::Imm::Var(name, _) => {
            if name == "init" || name == "main" {
                Expr::Var(function_name(name))
            } else {
                Expr::Var(go_local_ident(name))
            }
        },
        anf::Imm::Callable(value, _) => Expr::Var(callable_name(value)),
        anf::Imm::Prim(value, _) => compile_primitive(value),
        anf::Imm::Tag(index, _) => Expr::Int(index.to_string()),
    }
}

fn is_closure_struct_name(value: string) -> bool {
    value.byte_len() >= 12 && value.byte_slice(0, 12) == "closure_env_"
}

fn closure_info_from_function(value: anf::Function) -> Option[ClosureInfo] {
    let segments = hash_segments(value.name);
    if segments.len() == 4
        && segments.get(0) == "inherent"
        && segments.get(1) == segments.get(2)
        && segments.get(3) == "apply"
        && is_closure_struct_name(segments.get(1))
        && value.params.len() > 0
    {
        match tast::resolve_type(value.params.get(0).1) {
            tast::Type::Con(name) => {
                if name == segments.get(1) {
                    let params: Vec[tast::Type] = Vec::new();
                    for index in range(1, value.params.len()) {
                        params.push(value.params.get(index).1)
                    };
                    Option::Some(ClosureInfo {
                        struct_name: name,
                        apply_name: value.name,
                        params,
                        ret_ty: value.ret_ty,
                    })
                } else {
                    Option::None
                }
            },
            _ => Option::None,
        }
    } else {
        Option::None
    }
}

fn collect_closure_infos(values: Vec[anf::Function]) -> Vec[ClosureInfo] {
    let result: Vec[ClosureInfo] = Vec::new();
    for value in values {
        match closure_info_from_function(value) {
            Option::Some(info) => result.push(info),
            Option::None => (),
        }
    };
    result
}

fn find_closure_info(values: Vec[ClosureInfo], ty: tast::Type) -> Option[ClosureInfo] {
    match tast::resolve_type(ty) {
        tast::Type::Con(name) => {
            let result: Ref[Option[ClosureInfo]] = Ref::new(Option::None);
            for value in values {
                if value.struct_name == name {
                    result.set(Option::Some(value))
                } else {
                    ()
                }
            };
            result.get()
        },
        _ => Option::None,
    }
}

fn compile_closure_function(
    env: LowerEnv,
    value: anf::Imm,
    target_ty: tast::Type,
    info: ClosureInfo,
) -> Expr {
    match tast::resolve_type(target_ty) {
        tast::Type::Func(param_types, ret_ty) => {
            let params: Vec[(string, Type)] = Vec::new();
            let args: Vec[Expr] = Vec::new();
            args.push(compile_imm(value));
            for index in range(0, param_types.len()) {
                let name = "p" + index.to_string();
                params.push((name, lower_type(param_types.get(index))));
                args.push(Expr::Var(name))
            };
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(Stmt::Return(Option::Some(Expr::Call(
                Expr::Var(function_name(info.apply_name)),
                args,
            ))));
            Expr::FuncLit(params, lower_type(ret_ty), Block { stmts })
        },
        _ => compile_imm(value),
    }
}

fn compile_imm_expected(env: LowerEnv, value: anf::Imm, expected_ty: tast::Type) -> Expr {
    match value {
        anf::Imm::Tag(tag, owner_ty) => match variant_type(env.variants, owner_ty, tag) {
            Option::Some(ty) => Expr::StructLiteral(ty, Vec::new()),
            Option::None => compile_imm(value),
        },
        _ => match find_closure_info(env.closures, anf::imm_type(value)) {
            Option::Some(info) => match tast::resolve_type(expected_ty) {
                tast::Type::Func(_, _) => compile_closure_function(env, value, expected_ty, info),
                _ => compile_imm(value),
            },
            Option::None => compile_imm(value),
        },
    }
}

fn compile_imms_expected(
    env: LowerEnv,
    values: Vec[anf::Imm],
    expected: Vec[tast::Type],
) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::new();
    for index in range(0, values.len()) {
        if index < expected.len() {
            result.push(compile_imm_expected(env, values.get(index), expected.get(index)))
        } else {
            result.push(compile_imm(values.get(index)))
        }
    };
    result
}

fn ref_intrinsic_call_name(
    key: string,
    function_ty: tast::Type,
    args: Vec[anf::Imm],
) -> Option[string] {
    if key == "ref.new" {
        match tast::resolve_type(function_ty) {
            tast::Type::Func(_, ret_ty) => {
                Option::Some(ref_helper_name("ref", ret_ty))
            },
            _ => Option::None,
        }
    } else if key == "ref.get" && args.len() > 0 {
        Option::Some(ref_helper_name("ref_get", anf::imm_type(args.get(0))))
    } else if key == "ref.set" && args.len() > 0 {
        Option::Some(ref_helper_name("ref_set", anf::imm_type(args.get(0))))
    } else {
        Option::None
    }
}

fn compile_callable(func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    match func {
        anf::Imm::Callable(tast::Callable::Intrinsic(key), function_ty) => {
            match ref_intrinsic_call_name(key, function_ty, args) {
                Option::Some(name) => Expr::Var(name),
                Option::None => compile_imm(func),
            }
        },
        _ => compile_imm(func),
    }
}

fn compile_call(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    match find_closure_info(env.closures, anf::imm_type(func)) {
        Option::Some(info) => {
            let values: Vec[Expr] = Vec::new();
            values.push(compile_imm(func));
            for value in compile_imms_expected(env, args, info.params) {
                values.push(value)
            };
            Expr::Call(Expr::Var(function_name(info.apply_name)), values)
        },
        Option::None => {
            let expected = match tast::resolve_type(anf::imm_type(func)) {
                tast::Type::Func(params, _) => params,
                _ => Vec::new(),
            };
            Expr::Call(compile_callable(func, args), compile_imms_expected(env, args, expected))
        },
    }
}

fn compile_unary(value: ast::UnaryOp) -> UnaryOp {
    match value {
        ast::UnaryOp::Neg => UnaryOp::Neg,
        ast::UnaryOp::Not => UnaryOp::Not,
        ast::UnaryOp::BitNot => UnaryOp::BitNot,
    }
}

fn compile_binary(value: ast::BinaryOp) -> BinaryOp {
    match value {
        ast::BinaryOp::Add => BinaryOp::Add,
        ast::BinaryOp::Sub => BinaryOp::Sub,
        ast::BinaryOp::Mul => BinaryOp::Mul,
        ast::BinaryOp::Div => BinaryOp::Div,
        ast::BinaryOp::Rem => BinaryOp::Rem,
        ast::BinaryOp::BitAnd => BinaryOp::BitAnd,
        ast::BinaryOp::BitOr => BinaryOp::BitOr,
        ast::BinaryOp::BitXor => BinaryOp::BitXor,
        ast::BinaryOp::Shl => BinaryOp::Shl,
        ast::BinaryOp::Shr => BinaryOp::Shr,
        ast::BinaryOp::And => BinaryOp::And,
        ast::BinaryOp::Or => BinaryOp::Or,
        ast::BinaryOp::Less => BinaryOp::Less,
        ast::BinaryOp::Greater => BinaryOp::Greater,
        ast::BinaryOp::LessEq => BinaryOp::LessEq,
        ast::BinaryOp::GreaterEq => BinaryOp::GreaterEq,
        ast::BinaryOp::Eq => BinaryOp::Eq,
        ast::BinaryOp::NotEq => BinaryOp::NotEq,
    }
}

fn compile_constructor(
    env: LowerEnv,
    constructor: tast::Constructor,
    args: Vec[anf::Imm],
    ty: tast::Type,
) -> Expr {
    let expected: Vec[tast::Type] = Vec::new();
    if constructor.is_struct {
        match tast::resolve_type(ty) {
            tast::Type::Con(name) => match find_struct(env.structs, name) {
                Option::Some(definition) => {
                    for field in definition.fields {
                        expected.push(field.1)
                    }
                },
                Option::None => (),
            },
            _ => (),
        }
    } else {
        match constructor.tag {
            Option::Some(tag) => match find_variant_info(env.variants, ty, tag) {
                Option::Some(info) => {
                    for field_ty in info.field_types {
                        expected.push(field_ty)
                    }
                },
                Option::None => (),
            },
            Option::None => (),
        }
    };
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in range(0, args.len()) {
        let name = if constructor.is_struct && index < constructor.fields.len() {
            go_ident(constructor.fields.get(index))
        } else {
            "_" + index.to_string()
        };
        let compiled = if index < expected.len() {
            compile_imm_expected(env, args.get(index), expected.get(index))
        } else {
            compile_imm(args.get(index))
        };
        fields.push((name, compiled))
    };
    let go_ty = if constructor.is_struct {
        lower_type(ty)
    } else {
        match constructor.tag {
            Option::Some(tag) => match variant_type(env.variants, ty, tag) {
                Option::Some(ty) => ty,
                Option::None => constructor_type(constructor),
            },
            Option::None => constructor_type(constructor),
        }
    };
    Expr::StructLiteral(go_ty, fields)
}

fn compile_value(env: LowerEnv, value: anf::Value, expected_ty: tast::Type) -> CompiledValue {
    let stmts: Vec[Stmt] = Vec::new();
    let expr = match value {
        anf::Value::Imm(value) => compile_imm_expected(env, value, expected_ty),
        anf::Value::Constr(constructor, args, ty) => compile_constructor(env, constructor, args, ty),
        anf::Value::Tuple(items, ty) => {
            let fields: Vec[(string, Expr)] = Vec::new();
            match tast::resolve_type(ty) {
                tast::Type::Tuple(item_types) => {
                    for index in range(0, items.len()) {
                        fields.push((
                            "_" + index.to_string(),
                            compile_imm_expected(env, items.get(index), item_types.get(index)),
                        ))
                    }
                },
                _ => {
                    for index in range(0, items.len()) {
                        fields.push(("_" + index.to_string(), compile_imm(items.get(index))))
                    }
                },
            };
            Expr::StructLiteral(lower_type(ty), fields)
        },
        anf::Value::Array(items, ty) => {
            let expected = match tast::resolve_type(ty) {
                tast::Type::Array(_, elem) => {
                    let values: Vec[tast::Type] = Vec::new();
                    for _ in items {
                        values.push(elem)
                    };
                    values
                },
                _ => Vec::new(),
            };
            Expr::ArrayLiteral(lower_type(ty), compile_imms_expected(env, items, expected))
        },
        anf::Value::ConstrGet(expr, constructor, index, _) => {
            let field = if constructor.is_struct && index < constructor.fields.len() {
                go_ident(constructor.fields.get(index))
            } else {
                "_" + index.to_string()
            };
            let target = if constructor.is_struct {
                compile_imm(expr)
            } else {
                let owner_ty = anf::imm_type(expr);
                let go_ty = match constructor.tag {
                    Option::Some(tag) => match variant_type(env.variants, owner_ty, tag) {
                        Option::Some(ty) => ty,
                        Option::None => constructor_type(constructor),
                    },
                    Option::None => constructor_type(constructor),
                };
                Expr::Cast(compile_imm(expr), go_ty)
            };
            Expr::Field(target, field)
        },
        anf::Value::Unary(op, expr, _) => Expr::Unary(compile_unary(op), compile_imm(expr)),
        anf::Value::Cast(expr, ty) => Expr::Convert(lower_type(ty), compile_imm(expr)),
        anf::Value::Binary(op, lhs, rhs, _) => {
            Expr::Binary(compile_binary(op), compile_imm(lhs), compile_imm(rhs))
        },
        anf::Value::Assign(name, value, target_ty, _) => {
            stmts.push(Stmt::Assign(
                go_local_ident(name),
                compile_imm_expected(env, value, target_ty),
            ));
            Expr::Unit
        },
        anf::Value::Call(func, args, _) => compile_call(env, func, args),
        anf::Value::ToDyn(trait_name, for_ty, expr, ty) => {
            let fields: Vec[(string, Expr)] = Vec::new();
            let compiled = compile_imm_expected(env, expr, for_ty);
            let data = match tast::resolve_type(for_ty) {
                tast::Type::Bool
                | tast::Type::Int8
                | tast::Type::Int16
                | tast::Type::Int32
                | tast::Type::Int64
                | tast::Type::Uint8
                | tast::Type::Uint16
                | tast::Type::Uint32
                | tast::Type::Uint64
                | tast::Type::Float32
                | tast::Type::Float64
                | tast::Type::Char => Expr::Convert(lower_type(for_ty), compiled),
                _ => compiled,
            };
            fields.push(("data", data));
            fields.push((
                "vtable",
                Expr::Call(Expr::Var(dyn_factory_name(trait_name, for_ty)), Vec::new()),
            ));
            Expr::StructLiteral(lower_type(ty), fields)
        },
        anf::Value::DynCall(_, method, receiver, args, _) => {
            let receiver = compile_imm(receiver);
            let values: Vec[Expr] = Vec::new();
            values.push(Expr::Field(receiver, "data"));
            for arg in args {
                values.push(compile_imm(arg))
            };
            Expr::Call(
                Expr::Field(Expr::Field(receiver, "vtable"), go_ident(method)),
                values,
            )
        },
        anf::Value::Go(value, _) => {
            let call = compile_call(env, value, Vec::new());
            stmts.push(Stmt::Go(call));
            Expr::Unit
        },
        anf::Value::Proj(tuple, index, _) => {
            Expr::Field(compile_imm(tuple), "_" + index.to_string())
        },
    };
    CompiledValue { stmts, expr }
}

fn compile_let(env: LowerEnv, value: anf::LetBind) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    let compiled = compile_value(env, value.value, value.ty);
    append_stmts(result, compiled.stmts);
    result.push(Stmt::Var(
        go_local_ident(value.name),
        lower_type(value.ty),
        Option::Some(compiled.expr),
    ));
    result
}

fn collect_joins_term(result: Vec[anf::JoinBind], value: anf::Term) -> unit {
    match value {
        anf::Term::If(_, then_, else_, _) => {
            collect_joins_block(result, then_);
            collect_joins_block(result, else_)
        },
        anf::Term::Match(_, arms, default, _) => {
            for arm in arms {
                collect_joins_block(result, arm.body)
            };
            match default {
                Option::Some(body) => collect_joins_block(result, body),
                Option::None => (),
            }
        },
        anf::Term::Return(_)
        | anf::Term::Jump(_, _, _)
        | anf::Term::Unreachable(_) => (),
    }
}

fn collect_joins_block(result: Vec[anf::JoinBind], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(_) => (),
            anf::Bind::Join(join) => {
                result.push(join);
                collect_joins_block(result, join.body)
            },
            anf::Bind::JoinRec(joins) => {
                for join in joins {
                    collect_joins_block(result, join.body)
                }
            },
        }
    };
    collect_joins_term(result, value.term)
}

fn find_join(values: Vec[anf::JoinBind], name: string) -> Option[anf::JoinBind] {
    let result: Ref[Option[anf::JoinBind]] = Ref::new(Option::None);
    for value in values {
        if value.name == name {
            result.set(Option::Some(value))
        } else {
            ()
        }
    };
    result.get()
}

fn same_target(lhs: Option[string], rhs: Option[string]) -> Option[string] {
    match lhs {
        Option::Some(left) => match rhs {
            Option::Some(right) => {
                if left == right { Option::Some(left) } else { Option::None }
            },
            Option::None => Option::None,
        },
        Option::None => Option::None,
    }
}

fn term_target(value: anf::Term) -> Option[string] {
    match value {
        anf::Term::Jump(target, _, _) => Option::Some(target),
        anf::Term::If(_, then_, else_, _) => {
            same_target(term_target(then_.term), term_target(else_.term))
        },
        anf::Term::Match(_, arms, default, _) => {
            let result: Ref[Option[string]] = Ref::new(Option::None);
            let valid = Ref::new(true);
            for arm in arms {
                match result.get() {
                    Option::None => result.set(term_target(arm.body.term)),
                    Option::Some(current) => match term_target(arm.body.term) {
                        Option::Some(target) => {
                            if current != target {
                                valid.set(false)
                            } else {
                                ()
                            }
                        },
                        Option::None => valid.set(false),
                    },
                }
            };
            match default {
                Option::Some(body) => match result.get() {
                    Option::None => result.set(term_target(body.term)),
                    Option::Some(current) => match term_target(body.term) {
                        Option::Some(target) => {
                            if current != target {
                                valid.set(false)
                            } else {
                                ()
                            }
                        },
                        Option::None => valid.set(false),
                    },
                },
                Option::None => (),
            };
            if valid.get() { result.get() } else { Option::None }
        },
        anf::Term::Return(_) | anf::Term::Unreachable(_) => Option::None,
    }
}

fn compile_jump_args(
    env: LowerEnv,
    value: anf::JoinBind,
    args: Vec[anf::Imm],
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    for index in range(0, args.len()) {
        if index < value.params.len() && value.params.get(index).0 != "_" {
            result.push(Stmt::Assign(
                go_local_ident(value.params.get(index).0),
                compile_imm_expected(env, args.get(index), value.params.get(index).1),
            ))
        } else {
            ()
        }
    };
    result
}

fn compile_branch_to_join(
    env: LowerEnv,
    value: anf::Block,
    target: string,
    join: anf::JoinBind,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                }
            },
            anf::Bind::JoinRec(_) => (),
        }
    };
    match value.term {
        anf::Term::Jump(name, args, _) => {
            if name == target {
                append_stmts(stmts, compile_jump_args(env, join, args))
            } else {
                append_stmts(stmts, compile_term_leaf(env, value.term))
            }
        },
        anf::Term::If(cond, then_, else_, _) => {
            stmts.push(Stmt::If(
                compile_imm(cond),
                compile_branch_to_join(env, then_, target, join),
                Option::Some(compile_branch_to_join(env, else_, target, join)),
            ))
        },
        _ => append_stmts(stmts, compile_term_leaf(env, value.term)),
    };
    Block { stmts }
}

fn compile_match_leaf(
    env: LowerEnv,
    scrut: anf::Imm,
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    if match_uses_types(env, arms) {
        let cases: Vec[TypeSwitchCase] = Vec::new();
        for arm in arms {
            match arm_type(env, arm.lhs) {
                Option::Some(ty) => cases.push(TypeSwitchCase {
                    ty,
                    body: compile_block(env, arm.body),
                }),
                Option::None => (),
            }
        };
        let lowered_default = match default {
            Option::Some(body) => Option::Some(compile_block(env, body)),
            Option::None => Option::Some(non_exhaustive_block()),
        };
        result.push(Stmt::TypeSwitch(compile_imm(scrut), cases, lowered_default))
    } else {
        let cases: Vec[SwitchCase] = Vec::new();
        for arm in arms {
            cases.push(SwitchCase {
                value: compile_imm(arm.lhs),
                body: compile_block(env, arm.body),
            })
        };
        let lowered_default = match default {
            Option::Some(body) => Option::Some(compile_block(env, body)),
            Option::None => Option::None,
        };
        result.push(Stmt::Switch(compile_imm(scrut), cases, lowered_default))
    };
    result
}

fn arm_type(env: LowerEnv, value: anf::Imm) -> Option[Type] {
    match value {
        anf::Imm::Tag(tag, owner_ty) => variant_type(env.variants, owner_ty, tag),
        _ => Option::None,
    }
}

fn match_uses_types(env: LowerEnv, values: Vec[anf::Arm]) -> bool {
    let found = Ref::new(false);
    for value in values {
        match arm_type(env, value.lhs) {
            Option::Some(_) => found.set(true),
            Option::None => (),
        }
    };
    found.get()
}

fn non_exhaustive_block() -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Panic("non-exhaustive match"));
    Block { stmts }
}

fn compile_term_leaf(env: LowerEnv, value: anf::Term) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        anf::Term::Return(value) => result.push(Stmt::Return(Option::Some(
            compile_imm_expected(env, value, anf::imm_type(value)),
        ))),
        anf::Term::Jump(target, args, _) => match find_join(env.joins, target) {
            Option::Some(join) => {
                append_stmts(result, compile_jump_args(env, join, args));
                append_stmts(result, compile_block(env, join.body).stmts)
            },
            Option::None => result.push(Stmt::Unreachable),
        },
        anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
            compile_imm(cond),
            compile_block(env, then_),
            Option::Some(compile_block(env, else_)),
        )),
        anf::Term::Match(scrut, arms, default, _) => {
            append_stmts(result, compile_match_leaf(env, scrut, arms, default))
        },
        anf::Term::Unreachable(_) => result.push(Stmt::Unreachable),
    };
    result
}

fn compile_term_with_pending(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
) -> Vec[Stmt] {
    match term_target(value) {
        Option::Some(target) => match find_join(pending, target) {
            Option::Some(join) => {
                let result: Vec[Stmt] = Vec::new();
                match value {
                    anf::Term::Jump(_, args, _) => {
                        append_stmts(result, compile_jump_args(env, join, args))
                    },
                    anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
                        compile_imm(cond),
                        compile_branch_to_join(env, then_, target, join),
                        Option::Some(compile_branch_to_join(env, else_, target, join)),
                    )),
                    anf::Term::Match(scrut, arms, default, _) => {
                        if match_uses_types(env, arms) {
                            let cases: Vec[TypeSwitchCase] = Vec::new();
                            for arm in arms {
                                match arm_type(env, arm.lhs) {
                                    Option::Some(ty) => cases.push(TypeSwitchCase {
                                        ty,
                                        body: compile_branch_to_join(
                                            env,
                                            arm.body,
                                            target,
                                            join,
                                        ),
                                    }),
                                    Option::None => (),
                                }
                            };
                            let lowered_default = match default {
                                Option::Some(body) => Option::Some(compile_branch_to_join(
                                    env,
                                    body,
                                    target,
                                    join,
                                )),
                                Option::None => Option::Some(non_exhaustive_block()),
                            };
                            result.push(Stmt::TypeSwitch(
                                compile_imm(scrut),
                                cases,
                                lowered_default,
                            ))
                        } else {
                            let cases: Vec[SwitchCase] = Vec::new();
                            for arm in arms {
                                cases.push(SwitchCase {
                                    value: compile_imm(arm.lhs),
                                    body: compile_branch_to_join(env, arm.body, target, join),
                                })
                            };
                            let lowered_default = match default {
                                Option::Some(body) => Option::Some(compile_branch_to_join(
                                    env,
                                    body,
                                    target,
                                    join,
                                )),
                                Option::None => Option::None,
                            };
                            result.push(Stmt::Switch(compile_imm(scrut), cases, lowered_default))
                        }
                    },
                    _ => append_stmts(result, compile_term_leaf(env, value)),
                };
                append_stmts(result, compile_block(env, join.body).stmts);
                result
            },
            Option::None => compile_term_leaf(env, value),
        },
        Option::None => compile_term_leaf(env, value),
    }
}

fn loop_label(value: string) -> string {
    "Loop_" + go_local_ident(value)
}

fn term_reaches_target(
    env: LowerEnv,
    value: anf::Term,
    target: string,
    visited: Vec[string],
) -> bool {
    match value {
        anf::Term::Jump(name, _, _) => {
            if name == target {
                true
            } else if contains_string(visited, name) {
                false
            } else {
                match find_join(env.joins, name) {
                    Option::Some(join) => {
                        visited.push(name);
                        term_reaches_target(env, join.body.term, target, visited)
                    },
                    Option::None => false,
                }
            }
        },
        anf::Term::If(_, then_, else_, _) => {
            term_reaches_target(env, then_.term, target, visited)
                || term_reaches_target(env, else_.term, target, visited)
        },
        anf::Term::Match(_, arms, default, _) => {
            let reaches = Ref::new(false);
            for arm in arms {
                if term_reaches_target(env, arm.body.term, target, visited) {
                    reaches.set(true)
                } else {
                    ()
                }
            };
            match default {
                Option::Some(body) => {
                    if term_reaches_target(env, body.term, target, visited) {
                        reaches.set(true)
                    } else {
                        ()
                    }
                },
                Option::None => (),
            };
            reaches.get()
        },
        anf::Term::Return(_) | anf::Term::Unreachable(_) => false,
    }
}

fn find_loop_exit(value: anf::Term, loop_name: string) -> Option[string] {
    match value {
        anf::Term::If(_, then_, else_, _) => {
            match term_target(else_.term) {
                Option::Some(target) => {
                    if target != loop_name { Option::Some(target) } else { term_target(then_.term) }
                },
                Option::None => match term_target(then_.term) {
                    Option::Some(target) => {
                        if target != loop_name { Option::Some(target) } else { Option::None }
                    },
                    Option::None => Option::None,
                },
            }
        },
        _ => Option::None,
    }
}

fn compile_loop_branch_to_join(
    env: LowerEnv,
    value: anf::Block,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                }
            },
            anf::Bind::JoinRec(_) => (),
        }
    };
    match value.term {
        anf::Term::Jump(name, args, _) => {
            if name == target {
                append_stmts(stmts, compile_jump_args(env, join, args))
            } else {
                append_stmts(
                    stmts,
                    compile_loop_term_leaf(env, value.term, loop_name, exit_name, label),
                )
            }
        },
        anf::Term::If(cond, then_, else_, _) => stmts.push(Stmt::If(
            compile_imm(cond),
            compile_loop_branch_to_join(
                env,
                then_,
                target,
                join,
                loop_name,
                exit_name,
                label,
            ),
            Option::Some(compile_loop_branch_to_join(
                env,
                else_,
                target,
                join,
                loop_name,
                exit_name,
                label,
            )),
        )),
        _ => append_stmts(
            stmts,
            compile_loop_term_leaf(env, value.term, loop_name, exit_name, label),
        ),
    };
    Block { stmts }
}

fn compile_loop_term_leaf(
    env: LowerEnv,
    value: anf::Term,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        anf::Term::Jump(target, _, _) => {
            if target == loop_name {
                result.push(Stmt::Continue)
            } else if target == exit_name {
                result.push(Stmt::BreakLabel(label))
            } else {
                match find_join(env.joins, target) {
                    Option::Some(join) => {
                        match value {
                            anf::Term::Jump(_, args, _) => {
                                append_stmts(result, compile_jump_args(env, join, args))
                            },
                            _ => (),
                        };
                        append_stmts(
                            result,
                            compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                        )
                    },
                    Option::None => append_stmts(result, compile_term_leaf(env, value)),
                }
            }
        },
        anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
            compile_imm(cond),
            compile_loop_block(env, then_, loop_name, exit_name, label),
            Option::Some(compile_loop_block(env, else_, loop_name, exit_name, label)),
        )),
        anf::Term::Match(scrut, arms, default, _) => {
            let cases: Vec[SwitchCase] = Vec::new();
            for arm in arms {
                cases.push(SwitchCase {
                    value: compile_imm(arm.lhs),
                    body: compile_loop_block(env, arm.body, loop_name, exit_name, label),
                })
            };
            let lowered_default = match default {
                Option::Some(body) => Option::Some(compile_loop_block(
                    env,
                    body,
                    loop_name,
                    exit_name,
                    label,
                )),
                Option::None => Option::None,
            };
            result.push(Stmt::Switch(compile_imm(scrut), cases, lowered_default))
        },
        _ => append_stmts(result, compile_term_leaf(env, value)),
    };
    result
}

fn compile_loop_term_with_pending(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    match term_target(value) {
        Option::Some(target) => match find_join(pending, target) {
            Option::Some(join) => {
                let result: Vec[Stmt] = Vec::new();
                match value {
                    anf::Term::Jump(_, args, _) => {
                        append_stmts(result, compile_jump_args(env, join, args))
                    },
                    anf::Term::If(cond, then_, else_, _) => result.push(Stmt::If(
                        compile_imm(cond),
                        compile_loop_branch_to_join(
                            env,
                            then_,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                        Option::Some(compile_loop_branch_to_join(
                            env,
                            else_,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        )),
                    )),
                    _ => append_stmts(
                        result,
                        compile_loop_term_leaf(env, value, loop_name, exit_name, label),
                    ),
                };
                append_stmts(
                    result,
                    compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                );
                result
            },
            Option::None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
        },
        Option::None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
    }
}

fn compile_loop_block(
    env: LowerEnv,
    value: anf::Block,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                };
                pending.push(value)
            },
            anf::Bind::JoinRec(_) => (),
        }
    };
    append_stmts(
        stmts,
        compile_loop_term_with_pending(env, value.term, pending, loop_name, exit_name, label),
    );
    Block { stmts }
}

fn compile_joinrec(env: LowerEnv, values: Vec[anf::JoinBind]) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    let single = values.len() == 1;
    for value in values {
        if single && term_reaches_target(env, value.body.term, value.name, Vec::new()) == false {
            append_stmts(stmts, compile_block(env, value.body).stmts);
            loop_names.push(value.name)
        } else {
            match find_loop_exit(value.body.term, value.name) {
                Option::Some(exit_name) => {
                    let label = loop_label(value.name);
                    stmts.push(Stmt::LabeledLoop(
                        label,
                        compile_loop_block(env, value.body, value.name, exit_name, label),
                    ));
                    match find_join(env.joins, exit_name) {
                        Option::Some(exit) => {
                            append_stmts(stmts, compile_block(env, exit.body).stmts)
                        },
                        Option::None => (),
                    };
                    loop_names.push(value.name)
                },
                Option::None => stmts.push(Stmt::Unreachable),
            }
        }
    };
    JoinRecResult { stmts, loop_names }
}

fn compile_block(env: LowerEnv, value: anf::Block) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => append_stmts(stmts, compile_let(env, value)),
            anf::Bind::Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(Stmt::Var(go_local_ident(param.0), lower_type(param.1), Option::None))
                    } else {
                        ()
                    }
                };
                pending.push(value)
            },
            anf::Bind::JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    };
    let suppress = match value.term {
        anf::Term::Jump(target, args, _) => {
            args.len() == 0 && contains_string(loop_names, target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(stmts, compile_term_with_pending(env, value.term, pending))
    } else {
        ()
    };
    Block { stmts }
}

fn add_collected_type(result: Vec[tast::Type], value: tast::Type) -> unit {
    let name = type_name(value);
    let found = Ref::new(false);
    for previous in result {
        if type_name(previous) == name {
            found.set(true)
        } else {
            ()
        }
    };
    if found.get() == false {
        result.push(value)
    } else {
        ()
    }
}

fn collect_type(result: Vec[tast::Type], value: tast::Type) -> unit {
    match tast::resolve_type(value) {
        tast::Type::Tuple(values) => {
            for inner in values {
                collect_type(result, inner)
            };
            add_collected_type(result, value)
        },
        tast::Type::Con(_) => add_collected_type(result, value),
        tast::Type::Dyn(_) => add_collected_type(result, value),
        tast::Type::Projection(base, _, _) => collect_type(result, base),
        tast::Type::App(base, args) => {
            collect_type(result, base);
            for arg in args {
                collect_type(result, arg)
            }
        },
        tast::Type::Array(_, elem)
        | tast::Type::Slice(elem) => collect_type(result, elem),
        tast::Type::VecType(elem) => {
            collect_type(result, elem);
            add_collected_type(result, value)
        },
        tast::Type::RefType(elem) => {
            collect_type(result, elem);
            add_collected_type(result, value)
        },
        tast::Type::HashMap(key, value) => {
            collect_type(result, key);
            collect_type(result, value);
            add_collected_type(result, tast::Type::HashMap(key, value))
        },
        tast::Type::Func(params, ret_ty) => {
            for param in params {
                collect_type(result, param)
            };
            collect_type(result, ret_ty)
        },
        _ => (),
    }
}

fn collect_imm_type(result: Vec[tast::Type], value: anf::Imm) -> unit {
    collect_type(result, anf::imm_type(value))
}

fn collect_value_type(result: Vec[tast::Type], value: anf::Value) -> unit {
    collect_type(result, anf::value_type(value));
    match value {
        anf::Value::Imm(value) => collect_imm_type(result, value),
        anf::Value::Constr(_, args, _)
        | anf::Value::Tuple(args, _)
        | anf::Value::Array(args, _) => {
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        anf::Value::ConstrGet(expr, _, _, _)
        | anf::Value::Unary(_, expr, _)
        | anf::Value::Cast(expr, _)
        | anf::Value::Go(expr, _)
        | anf::Value::Proj(expr, _, _) => collect_imm_type(result, expr),
        anf::Value::Binary(_, lhs, rhs, _) => {
            collect_imm_type(result, lhs);
            collect_imm_type(result, rhs)
        },
        anf::Value::Assign(_, expr, target_ty, _) => {
            collect_imm_type(result, expr);
            collect_type(result, target_ty)
        },
        anf::Value::Call(func, args, _) => {
            collect_imm_type(result, func);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        anf::Value::ToDyn(_, for_ty, expr, _) => {
            collect_type(result, for_ty);
            collect_imm_type(result, expr)
        },
        anf::Value::DynCall(_, _, receiver, args, _) => {
            collect_imm_type(result, receiver);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
    }
}

fn collect_block_types(result: Vec[tast::Type], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => {
                collect_type(result, value.ty);
                collect_value_type(result, value.value)
            },
            anf::Bind::Join(value) => {
                for param in value.params {
                    collect_type(result, param.1)
                };
                collect_type(result, value.ret_ty);
                collect_block_types(result, value.body)
            },
            anf::Bind::JoinRec(values) => {
                for value in values {
                    for param in value.params {
                        collect_type(result, param.1)
                    };
                    collect_type(result, value.ret_ty);
                    collect_block_types(result, value.body)
                }
            },
        }
    };
    match value.term {
        anf::Term::Return(value) => collect_imm_type(result, value),
        anf::Term::Jump(_, args, ty) => {
            collect_type(result, ty);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        anf::Term::If(cond, then_, else_, ty) => {
            collect_imm_type(result, cond);
            collect_type(result, ty);
            collect_block_types(result, then_);
            collect_block_types(result, else_)
        },
        anf::Term::Match(scrut, arms, default, ty) => {
            collect_imm_type(result, scrut);
            collect_type(result, ty);
            for arm in arms {
                collect_imm_type(result, arm.lhs);
                collect_block_types(result, arm.body)
            };
            match default {
                Option::Some(body) => collect_block_types(result, body),
                Option::None => (),
            }
        },
        anf::Term::Unreachable(ty) => collect_type(result, ty),
    }
}

fn collect_type_definition_fields(
    result: Vec[tast::Type],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    instances: Vec[core::TypeInstance],
) -> unit {
    for definition in structs {
        if definition.generics.len() == 0 {
            for field in definition.fields {
                collect_type(result, field.1)
            }
        } else {
            ()
        }
    };
    for definition in enums {
        if definition.generics.len() == 0 {
            for variant in definition.variants {
                for field in variant.fields {
                    collect_type(result, field)
                }
            }
        } else {
            ()
        }
    };
    for instance in instances {
        match find_struct(structs, instance.base_name) {
            Option::Some(definition) => {
                for field in definition.fields {
                    collect_type(result, instantiate_type(
                        field.1,
                        definition.generics,
                        instance.args,
                        instances,
                    ))
                }
            },
            Option::None => match find_enum(enums, instance.base_name) {
                Option::Some(definition) => {
                    for variant in definition.variants {
                        for field in variant.fields {
                            collect_type(result, instantiate_type(
                                field,
                                definition.generics,
                                instance.args,
                                instances,
                            ))
                        }
                    }
                },
                Option::None => (),
            },
        }
    }
}

fn runtime_struct(value: tast::Type) -> StructDef {
    match tast::resolve_type(value) {
        tast::Type::Tuple(values) => {
            let fields: Vec[(string, Type)] = Vec::new();
            for index in range(0, values.len()) {
                fields.push(("_" + index.to_string(), lower_type(values.get(index))))
            };
            StructDef { name: type_name(value), fields }
        },
        tast::Type::RefType(elem) => {
            let fields: Vec[(string, Type)] = Vec::new();
            fields.push(("value", lower_type(elem)));
            StructDef {
                name: go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x"),
                fields,
            }
        },
        tast::Type::VecType(elem) => {
            let fields: Vec[(string, Type)] = Vec::new();
            fields.push(("items", Type::Slice(lower_type(elem))));
            StructDef {
                name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                fields,
            }
        },
        _ => StructDef { name: "Error", fields: Vec::new() },
    }
}

fn add_dyn_coercion(
    result: Vec[DynCoercion],
    trait_name: string,
    for_ty: tast::Type,
) -> unit {
    let found = Ref::new(false);
    for value in result {
        if value.trait_name == trait_name && encode_type(value.for_ty) == encode_type(for_ty) {
            found.set(true)
        } else {
            ()
        }
    };
    if found.get() == false {
        result.push(DynCoercion { trait_name, for_ty })
    } else {
        ()
    }
}

fn collect_dyn_value(result: Vec[DynCoercion], value: anf::Value) -> unit {
    match value {
        anf::Value::ToDyn(trait_name, for_ty, _, _) => {
            add_dyn_coercion(result, trait_name, for_ty)
        },
        _ => (),
    }
}

fn collect_dyn_block(result: Vec[DynCoercion], value: anf::Block) -> unit {
    for bind in value.binds {
        match bind {
            anf::Bind::Let(value) => collect_dyn_value(result, value.value),
            anf::Bind::Join(value) => collect_dyn_block(result, value.body),
            anf::Bind::JoinRec(values) => {
                for value in values {
                    collect_dyn_block(result, value.body)
                }
            },
        }
    };
    match value.term {
        anf::Term::If(_, then_, else_, _) => {
            collect_dyn_block(result, then_);
            collect_dyn_block(result, else_)
        },
        anf::Term::Match(_, arms, default, _) => {
            for arm in arms {
                collect_dyn_block(result, arm.body)
            };
            match default {
                Option::Some(body) => collect_dyn_block(result, body),
                Option::None => (),
            }
        },
        _ => (),
    }
}

fn compile_function(
    value: anf::Function,
    variants: Vec[VariantInfo],
    closures: Vec[ClosureInfo],
    structs: Vec[tast::StructDef],
) -> Function {
    let joins: Vec[anf::JoinBind] = Vec::new();
    collect_joins_block(joins, value.body);
    let params: Vec[(string, Type)] = Vec::new();
    for param in value.params {
        params.push((go_local_ident(param.0), lower_type(param.1)))
    };
    Function {
        name: function_name(value.name),
        params,
        ret_ty: Option::Some(lower_type(value.ret_ty)),
        body: eliminate_dead_vars(compile_block(
            LowerEnv { joins, variants, closures, structs },
            value.body,
        )),
    }
}

pub fn lower(value: anf::File) -> File {
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let closures = collect_closure_infos(value.functions);
    let items: Vec[Item] = Vec::new();
    let types: Vec[tast::Type] = Vec::new();
    let coercions: Vec[DynCoercion] = Vec::new();
    let variants: Vec[VariantInfo] = Vec::new();
    let has_main = Ref::new(false);
    for function in value.functions {
        for param in function.params {
            collect_type(types, param.1)
        };
        collect_type(types, function.ret_ty);
        collect_block_types(types, function.body);
        collect_dyn_block(coercions, function.body);
        if function.name == "main" {
            has_main.set(true)
        } else {
            ()
        }
    };
    collect_type_definition_fields(types, enums, structs, type_instances);
    emit_builtin_runtime_items(items, types);
    emit_user_type_items(
        items,
        variants,
        enums,
        structs,
        types,
        type_instances,
    );
    emit_dyn_runtime_items(items, types, coercions, value.functions);
    for function in value.functions {
        items.push(Item::Function(compile_function(
            function,
            variants,
            closures,
            structs,
        )))
    };
    if has_main.get() {
        let stmts: Vec[Stmt] = Vec::new();
        stmts.push(Stmt::Expr(Expr::Call(Expr::Var("main0"), Vec::new())));
        items.push(Item::Function(Function {
            name: "main",
            params: Vec::new(),
            ret_ty: Option::None,
            body: Block { stmts },
        }))
    } else {
        ()
    };
    prune_functions(File { items })
}
