package go_backend;

struct NameSet {
    values: Vec[string],
    present: HashMap[string, unit],
}

fn new_name_set() -> NameSet {
    NameSet {
        values: Vec::new(),
        present: HashMap::new(),
    }
}

fn name_present(values: NameSet, expected: string) -> bool {
    values.present.contains(expected)
}

fn add_reachable(values: NameSet, value: string) -> unit {
    if values.present.contains(value) == false {
        values.present.set(value, ());
        values.values.push(value)
    } else {
        ()
    }
}

fn collect_type_names(result: NameSet, value: Type) -> unit {
    match value {
        Type::Named(name) => add_reachable(result, name),
        Type::Pointer(inner) | Type::Array(_, inner) | Type::Slice(inner) | Type::Chan(inner) => {
            collect_type_names(result, inner)
        },
        Type::Map(key, value) => {
            collect_type_names(result, key);
            collect_type_names(result, value)
        },
        Type::Func(params, ret_ty) => {
            for param in params {
                collect_type_names(result, param)
            };
            collect_type_names(result, ret_ty)
        },
        Type::Multi(values) => {
            for value in values {
                collect_type_names(result, value)
            }
        },
        Type::Void
        | Type::Any
        | Type::Unit
        | Type::Bool
        | Type::Int
        | Type::Int8
        | Type::Int16
        | Type::Int32
        | Type::Int64
        | Type::Uint8
        | Type::Uint16
        | Type::Uint32
        | Type::Uint64
        | Type::Float32
        | Type::Float64
        | Type::String
        | Type::Char => (),
    }
}

fn collect_expr_names(result: NameSet, value: Expr) -> unit {
    match value {
        Expr::Var(name) => add_reachable(result, name),
        Expr::Call(func, args) => {
            collect_expr_names(result, func);
            for arg in args {
                collect_expr_names(result, arg)
            }
        },
        Expr::Unary(_, expr) => collect_expr_names(result, expr),
        Expr::Binary(_, lhs, rhs) => {
            collect_expr_names(result, lhs);
            collect_expr_names(result, rhs)
        },
        Expr::Field(expr, _) => collect_expr_names(result, expr),
        Expr::Index(expr, index) => {
            collect_expr_names(result, expr);
            collect_expr_names(result, index)
        },
        Expr::Slice(expr, start, end) => {
            collect_expr_names(result, expr);
            collect_expr_names(result, start);
            collect_expr_names(result, end)
        },
        Expr::Cast(expr, ty) | Expr::Convert(ty, expr) => {
            collect_expr_names(result, expr);
            collect_type_names(result, ty)
        },
        Expr::Make(ty, args) => {
            collect_type_names(result, ty);
            for arg in args {
                collect_expr_names(result, arg)
            }
        },
        Expr::Send(channel, value) => {
            collect_expr_names(result, channel);
            collect_expr_names(result, value)
        },
        Expr::Receive(channel) => collect_expr_names(result, channel),
        Expr::StructLiteral(ty, fields) => {
            collect_type_names(result, ty);
            for field in fields {
                collect_expr_names(result, field.1)
            }
        },
        Expr::ArrayLiteral(ty, values) => {
            collect_type_names(result, ty);
            for value in values {
                collect_expr_names(result, value)
            }
        },
        Expr::FuncLit(params, ret_ty, body) => {
            for param in params {
                collect_type_names(result, param.1)
            };
            collect_type_names(result, ret_ty);
            collect_block_names(result, body)
        },
        Expr::Nil
        | Expr::Unit
        | Expr::Bool(_)
        | Expr::Int(_)
        | Expr::Float(_)
        | Expr::String(_) => (),
    }
}

fn collect_stmt_names(result: NameSet, value: Stmt) -> unit {
    match value {
        Stmt::Expr(expr) | Stmt::Go(expr) => collect_expr_names(result, expr),
        Stmt::Var(_, ty, initial) => {
            collect_type_names(result, ty);
            match initial {
                Option::Some(expr) => collect_expr_names(result, expr),
                Option::None => (),
            }
        },
        Stmt::Assign(_, expr) => collect_expr_names(result, expr),
        Stmt::FieldAssign(target, _, expr) => {
            collect_expr_names(result, target);
            collect_expr_names(result, expr)
        },
        Stmt::IndexAssign(target, index, expr) => {
            collect_expr_names(result, target);
            collect_expr_names(result, index);
            collect_expr_names(result, expr)
        },
        Stmt::MultiAssign(_, expr) => collect_expr_names(result, expr),
        Stmt::Return(expr) => match expr {
            Option::Some(expr) => collect_expr_names(result, expr),
            Option::None => (),
        },
        Stmt::ReturnMulti(values) => {
            for value in values {
                collect_expr_names(result, value)
            }
        },
        Stmt::If(cond, then_, else_) => {
            collect_expr_names(result, cond);
            collect_block_names(result, then_);
            match else_ {
                Option::Some(body) => collect_block_names(result, body),
                Option::None => (),
            }
        },
        Stmt::Loop(body) | Stmt::LabeledLoop(_, body) => collect_block_names(result, body),
        Stmt::Range(_, expr, body) => {
            collect_expr_names(result, expr);
            collect_block_names(result, body)
        },
        Stmt::Switch(expr, cases, default) => {
            collect_expr_names(result, expr);
            for case in cases {
                collect_expr_names(result, case.value);
                collect_block_names(result, case.body)
            };
            match default {
                Option::Some(body) => collect_block_names(result, body),
                Option::None => (),
            }
        },
        Stmt::TypeSwitch(_, expr, cases, default) => {
            collect_expr_names(result, expr);
            for case in cases {
                collect_type_names(result, case.ty);
                collect_block_names(result, case.body)
            };
            match default {
                Option::Some(body) => collect_block_names(result, body),
                Option::None => (),
            }
        },
        Stmt::Break
        | Stmt::BreakLabel(_)
        | Stmt::Continue
        | Stmt::Panic(_)
        | Stmt::Unreachable => (),
    }
}

fn collect_block_names(result: NameSet, value: Block) -> unit {
    for stmt in value.stmts {
        collect_stmt_names(result, stmt)
    }
}

fn name_uses_import(name: string, alias: string) -> bool {
    if name == alias {
        true
    } else if name.byte_len() <= alias.byte_len() {
        false
    } else {
        name.byte_slice(0, alias.byte_len()) == alias
            && name.byte_get(alias.byte_len()) == 46
    }
}

fn import_is_used(names: NameSet, alias: string) -> bool {
    let used = Ref::new(false);
    for name in names.values {
        if name_uses_import(name, alias) {
            used.set(true)
        } else {
            ()
        }
    };
    used.get()
}

fn collect_item_names(result: NameSet, value: Item) -> unit {
    match value {
        Item::TypeDef(definition) => collect_type_names(result, definition.ty),
        Item::ConstGroup(group) => {
            for spec in group.specs {
                collect_type_names(result, spec.ty);
                collect_expr_names(result, spec.value)
            }
        },
        Item::Interface(definition) => {
            for method in definition.methods {
                for param in method.params {
                    collect_type_names(result, param)
                };
                match method.ret_ty {
                    Option::Some(ty) => collect_type_names(result, ty),
                    Option::None => (),
                }
            }
        },
        Item::Struct(definition) => {
            for field in definition.fields {
                collect_type_names(result, field.1)
            }
        },
        Item::Function(function) => {
            for param in function.params {
                collect_type_names(result, param.1)
            };
            match function.ret_ty {
                Option::Some(ty) => collect_type_names(result, ty),
                Option::None => (),
            };
            collect_block_names(result, function.body)
        },
        Item::Method(method) => {
            collect_type_names(result, method.receiver.1);
            for param in method.params {
                collect_type_names(result, param.1)
            };
            match method.ret_ty {
                Option::Some(ty) => collect_type_names(result, ty),
                Option::None => (),
            };
            collect_block_names(result, method.body)
        },
        Item::ImportGroup(_) => (),
    }
}

fn prune_imports(values: Vec[Item]) -> Vec[Item] {
    let names = new_name_set();
    for value in values {
        collect_item_names(names, value)
    };
    let result: Vec[Item] = Vec::new();
    for value in values {
        match value {
            Item::ImportGroup(imports) => {
                let retained: Vec[(string, string)] = Vec::new();
                for entry in imports {
                    if import_is_used(names, entry.0) {
                        retained.push(entry)
                    } else {
                        ()
                    }
                };
                if retained.len() > 0 {
                    result.push(Item::ImportGroup(retained))
                } else {
                    ()
                }
            },
            other => result.push(other),
        }
    };
    result
}

pub fn prune_functions(value: File) -> File {
    let reachable = new_name_set();
    let expanded = new_name_set();
    add_reachable(reachable, "main");
    let changed = Ref::new(true);
    while changed.get() {
        changed.set(false);
        for item in value.items {
            match item {
                Item::Function(function) => {
                    if name_present(reachable, function.name)
                        && name_present(expanded, function.name) == false
                    {
                        add_reachable(expanded, function.name);
                        collect_block_names(reachable, function.body);
                        changed.set(true)
                    } else {
                        ()
                    }
                },
                _ => (),
            }
        }
    };
    let items: Vec[Item] = Vec::new();
    for item in value.items {
        match item {
            Item::Function(function) => {
                if name_present(reachable, function.name) {
                    items.push(Item::Function(function))
                } else {
                    ()
                }
            },
            _ => items.push(item),
        }
    };
    File { items: prune_imports(items) }
}
