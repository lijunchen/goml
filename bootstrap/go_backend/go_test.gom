ld()\n    var t11 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t10)\n    _goml_m_println(t11)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn preserves_user_struct_order_before_closure_environments() -> unit {
    let source = "struct _goml_inherent_closure_env_f_0_closure_env_f_0_apply { value: int32, } fn main() -> unit { let y = 1i32; let f = |x: int32| x + y; let c = _goml_inherent_closure_env_f_0_closure_env_f_0_apply { value: 2i32 }; println((f(3i32) + c.value).to_string()) }";
    testing::assert_eq(
        encode(lower_source(source)),
