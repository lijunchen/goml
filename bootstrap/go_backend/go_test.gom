#[test]
fn preserves_user_structs_before_mono_instances() -> unit {
    let source = "struct Box[T] { value: T, } struct Box__int32 { value: int32, } fn main() -> unit { let a = Box { value: 10i32 }; let b = Box__int32 { value: 20i32 }; println(a.value + b.value) }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Box__int32 struct {\n    value int32\n}\n\ntype Box__int32__mono1 struct {\n    value int32\n}\n\nfunc main0() struct{} {\n    var a__0 Box__int32__mono1 = Box__int32__mono1{\n        value: 10,\n    }\n    var b__1 Box__int32 = Box__int32{\n        value: 20,\n    }\n    var t1 int32 = a__0.value\n    var t2 int32 = b__1.value\n    var t3 int32 = t1 + t2\n    _goml_m_println(t3)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn disambiguates_enum_variants_from_user_types() -> unit {
    let source = "struct E__int32_A { value: int32, } enum E[T] { A(T), B, } fn main() -> unit { let c = E__int32_A { value: 3i32 }; let _: E[string] = E::A(\"x\"); let y: E[int32] = E::A(4i32); match y { E::A(v) => println(v + c.value), E::B => println(0i32), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype E__int32_A struct {\n    value int32\n}\n\ntype E__string interface {\n    isE__string()\n}\n\ntype E__string_A struct {\n    _0 string\n}\n\nfunc (_ E__string_A) isE__string() {}\n\ntype E__string_B struct {}\n\nfunc (_ E__string_B) isE__string() {}\n\ntype E__int32 interface {\n    isE__int32()\n}\n\ntype E__int32_A__variant1 struct {\n    _0 int32\n}\n\nfunc (_ E__int32_A__variant1) isE__int32() {}\n\ntype E__int32_B struct {}\n\nfunc (_ E__int32_B) isE__int32() {}\n\nfunc main0() struct{} {\n    var c__0 E__int32_A = E__int32_A{\n        value: 3,\n    }\n    var y__1 E__int32 = E__int32_A__variant1{\n        _0: 4,\n    }\n    switch y__1.(type) {\n    case E__int32_A__variant1:\n        var x1 int32 = y__1.(E__int32_A__variant1)._0\n        var v__2 int32 = x1\n        var t4 int32 = c__0.value\n        var t5 int32 = v__2 + t4\n        _goml_m_println(t5)\n    case E__int32_B:\n        _goml_m_println(0)\n    default:\n        panic(\"non-exhaustive match\")\n    }\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn disambiguates_dyn_helper_names() -> unit {
    let source = "trait A { fn foo(Self) -> int32; fn B__foo(Self) -> int32; } struct C {} struct C__B {} impl A for C { fn foo(self: C) -> int32 { 1i32 } fn B__foo(self: C) -> int32 { 2i32 } } impl A for C__B { fn foo(self: C__B) -> int32 { 10i32 } fn B__foo(self: C__B) -> int32 { 20i32 } } fn main() -> unit { let left: dyn A = C {}; let right: dyn A = C__B {}; println(A::B__foo(left)); println(A::foo(right)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype C struct {}\n\ntype C__B struct {}\n\ntype dyn__A_vtable struct {\n    foo func(any) int32\n    B__foo func(any) int32\n}\n\ntype dyn__A struct {\n    data any\n    vtable *dyn__A_vtable\n}\n\nfunc dyn__A__wrap__C__foo(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C_i_foo(self.(C))\n}\n\nfunc _goml_fn_dyn__wrap_i_A_i_C_i_B____foo_h26f349dec639f96e5d307f4f602d1c13(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C_i_B____foo(self.(C))\n}\n\nfunc dyn__A__vtable__C() *dyn__A_vtable {\n    return &dyn__A_vtable{\n        foo: dyn__A__wrap__C__foo,\n        B__foo: _goml_fn_dyn__wrap_i_A_i_C_i_B____foo_h26f349dec639f96e5d307f4f602d1c13,\n    }\n}\n\nfunc _goml_fn_dyn__wrap_i_A_i_C____B_i_foo_ha2787c3d72ace29eacc6922105f9a2f0(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C____B_i_foo(self.(C__B))\n}\n\nfunc dyn__A__wrap__C__B__B__foo(self any) int32 {\n    return _goml_m_trait__impl_i_A_i_C____B_i_B____foo(self.(C__B))\n}\n\nfunc dyn__A__vtable__C__B() *dyn__A_vtable {\n    return &dyn__A_vtable{\n        foo: _goml_fn_dyn__wrap_i_A_i_C____B_i_foo_ha2787c3d72ace29eacc6922105f9a2f0,\n        B__foo: dyn__A__wrap__C__B__B__foo,\n    }\n}\n\nfunc _goml_m_trait__impl_i_A_i_C_i_foo(self__0 C) int32 {\n    var retv3 int32\n    retv3 = 1\n    return retv3\n}\n\nfunc _goml_m_trait__impl_i_A_i_C_i_B____foo(self__1 C) int32 {\n    var retv5 int32\n    retv5 = 2\n    return retv5\n}\n\nfunc _goml_m_trait__impl_i_A_i_C____B_i_foo(self__2 C__B) int32 {\n    var retv7 int32\n    retv7 = 10\n    return retv7\n}\n\nfunc _goml_m_trait__impl_i_A_i_C____B_i_B____foo(self__3 C__B) int32 {\n    var retv9 int32\n    retv9 = 20\n    return retv9\n}\n\nfunc main0() struct{} {\n    var t11 C = C{}\n    var left__4 dyn__A = dyn__A{\n        data: t11,\n        vtable: dyn__A__vtable__C(),\n    }\n    var t12 C__B = C__B{}\n    var right__5 dyn__A = dyn__A{\n        data: t12,\n        vtable: dyn__A__vtable__C__B(),\n    }\n    var t13 int32 = left__4.vtable.B__foo(left__4.data)\n    _goml_m_println(t13)\n    var t14 int32 = right__5.vtable.foo(right__5.data)\n    _goml_m_println(t14)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn protects_index_intrinsics_from_user_functions() -> unit {
    let source = "fn array_get(arr: [int32; 2], index: int32) -> int32 { 90i32 + index } fn array_set(arr: [int32; 2], index: int32, value: int32) -> [int32; 2] { [77i32, 88i32] } fn vec_get(v: Vec[int32], index: int32) -> int32 { 70i32 + index } fn vec_set(v: Vec[int32], index: int32, value: int32) -> unit { () } fn slice_get(s: Slice[int32], index: int32) -> int32 { 60i32 + index } fn hashmap_get(m: HashMap[string, int32], key: string) -> Option[int32] { Option::Some(55i32) } fn hashmap_set(m: HashMap[string, int32], key: string, value: int32) -> unit { () } fn main() -> unit { let a = [4i32, 5i32]; println(array_get(a, 1i32)); println(a[1i32]); let c: [int32; 2] = array_set(a, 0i32, 9i32); println(c[0i32]); let mut b = [1i32, 2i32]; b[0i32] = 9i32; println(array_get(b, 0i32)); println(b[0i32]); let v: Vec[int32] = Vec::new().pushed(8i32).pushed(9i32); println(vec_get(v, 1i32)); println(v[1i32]); let mut v2: Vec[int32] = Vec::new().pushed(1i32).pushed(2i32); vec_set(v2, 0i32, 99i32); println(v2[0i32]); v2[1i32] = 99i32; println(v2[1i32]); let s = v.slice(0i32, 2i32); println(slice_get(s, 1i32)); println(s[1i32]); let m: HashMap[string, int32] = HashMap::new(); hashmap_set(m, \"b\", 11i32); match m[\"b\"] { Option::Some(x) => println(x), Option::None => println(0i32), }; m[\"a\"] = 42i32; match hashmap_get(m, \"a\") { Option::Some(x) => println(x), Option::None => println(0i32), }; match m[\"a\"] { Option::Some(x) => println(x), Option::None => println(0i32), }; }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func array_get__Array_2_5int32("));
    testing::assert(string_contains(output, "func array_set__Array_2_5int32("));
    testing::assert(string_contains(output, "func vec_get__Vec_5int32("));
    testing::assert(string_contains(output, "func vec_set__Vec_5int32("));
    testing::assert(string_contains(output, "func hashmap_lookup__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func hashmap_get__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func hashmap_set__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func array_get(arr__0 [2]int32"));
    testing::assert(string_contains(output, "array_get__Array_2_5int32(a__17, 1)"));
    testing::assert(string_contains(output, "s__22[1]"));
    testing::assert(string_contains(output, "hashmap_get__HashMap_6string_5int32(m__23, \"b\")"));
    testing::assert(!string_contains(output, "_goml_m_array_t_get"));
    testing::assert(!string_contains(output, "_goml_m_vec_t_get"));
    testing::assert(!string_contains(output, "_goml_m_hashmap_t_get"))
}

#[test]
fn emits_unused_non_generic_enums() -> unit {
    testing::assert_eq(
        encode(lower_source("enum Status { Idle, Busy(int32), }")),
        "package main\n\ntype Status interface {\n    isStatus()\n}\n\ntype Idle struct {}\n\nfunc (_ Idle) isStatus() {}\n\ntype Busy struct {\n    _0 int32\n}\n\nfunc (_ Busy) isStatus() {}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn orders_runtime_types_before_tuples() -> unit {
    let source = "fn make_counter() -> (() -> int32, () -> unit) { let cell = Ref::new(0); let next = || cell.get(); let reset = || cell.set(0); (next, reset) } fn main() -> unit { let _ = make_counter(); }";
    testing::assert(string_contains(
        encode(lower_source(source)),
        "type ref_int32_x struct {\n    value int32\n}\n\ntype Tuple2_17TFunc0_ret_5int32_16TFunc0_ret_4unit struct",
    ))
}
