package go_backend;

use gomlang::parser::anf;
use gomlang::parser::ast;
use gomlang::parser::core;
use gomlang::parser::hir;
use gomlang::parser::lift;
use gomlang::parser::mono;
use gomlang::parser::parser;
use gomlang::parser::tast;
use std::testing;

fn lower_source(source: string) -> File {
    lower(anf::lower(lift::lower(mono::lower(core::lower(tast::check(hir::lower(
        ast::lower(parser::parse(source)),
        "main.gom",
    )))))))
}

#[test]
fn emits_if_continuations() -> unit {
    let source = "fn choose(flag: bool, x: int32, y: int32) -> int32 { if flag { x } else { y } } fn main() { let yes = choose(true, 10, 99); let no = choose(false, 10, 99); let _ = println(\"yes=\" + yes.to_string()); let _ = println(\"no=\" + no.to_string()); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc choose(flag__0 bool, x__1 int32, y__2 int32) int32 {\n    var retv3 int32\n    var jp5 int32\n    if flag__0 {\n        jp5 = x__1\n    } else {\n        jp5 = y__2\n    }\n    retv3 = jp5\n    return retv3\n}\n\nfunc main0() struct{} {\n    var yes__3 int32 = choose(true, 10, 99)\n    var no__4 int32 = choose(false, 10, 99)\n    var t7 string = _goml_m_inherent_i_int32_i_int32_i_to__string(yes__3)\n    var t8 string = \"yes=\" + t7\n    _goml_m_println(t8)\n    var t9 string = _goml_m_inherent_i_int32_i_int32_i_to__string(no__4)\n    var t10 string = \"no=\" + t9\n    _goml_m_println(t10)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_tuple_types_and_prunes_dead_bindings() -> unit {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Tuple2_4bool_4bool struct {\n    _0 bool\n    _1 bool\n}\n\ntype Tuple3_4bool_4bool_18Tuple2_4bool_4bool struct {\n    _0 bool\n    _1 bool\n    _2 Tuple2_4bool_4bool\n}\n\nfunc main0() struct{} {\n    var t8 Tuple2_4bool_4bool = Tuple2_4bool_4bool{\n        _0: true,\n        _1: false,\n    }\n    var a__0 Tuple3_4bool_4bool_18Tuple2_4bool_4bool = Tuple3_4bool_4bool_18Tuple2_4bool_4bool{\n        _0: true,\n        _1: false,\n        _2: t8,\n    }\n    var x3 Tuple2_4bool_4bool = a__0._2\n    var x5 bool = x3._1\n    var w__4 bool = x5\n    var b__5 bool = w__4\n    _goml_m_print(b__5)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_primitive_matches() -> unit {
    let source = "fn main() { let x: uint8 = 5; let y: string = match x { 0 => \"zero\", 1 => \"one\", _ => \"other\", }; println(y); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc main0() struct{} {\n    var x__0 uint8 = 5\n    var jp3 string\n    switch x__0 {\n    case 0:\n        jp3 = \"zero\"\n    case 1:\n        jp3 = \"one\"\n    default:\n        jp3 = \"other\"\n    }\n    var y__1 string = jp3\n    _goml_m_println(y__1)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_breaking_while_loops() -> unit {
    let source = "fn main() { let i = Ref::new(0i32); while i.get() < 10i32 { if i.get() == 5i32 { break } else { () }; let _ = println(i.get()); i.set(i.get() + 1i32); }; let _ = println(\"done\"); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_int32_x struct {\n    value int32\n}\n\nfunc main0() struct{} {\n    var i__0 *ref_int32_x = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_new(0)\n    Loop_loop7:\n    for {\n        var t8 int32 = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_get(i__0)\n        var t9 bool = t8 < 10\n        if t9 {\n            var t14 int32 = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_get(i__0)\n            var t15 bool = t14 == 5\n            if t15 {\n                break Loop_loop7\n            } else {\n                var t11 int32 = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_get(i__0)\n                _goml_m_println(t11)\n                var t12 int32 = _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_get(i__0)\n                var t13 int32 = t12 + 1\n                _goml_m_inherent_i_Ref_i_Ref_l_int32_r__i_set(i__0, t13)\n                continue\n            }\n        } else {\n            break Loop_loop7\n        }\n    }\n    _goml_m_println(\"done\")\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_vec_runtime_structs() -> unit {
    let source = "fn one() -> Vec[int32] { let v: Vec[int32] = Vec::new(); v.push(1i32); v } fn main() -> unit { let xs: Vec[int32] = one(); xs.push(2i32); println(xs.len()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype _goml_vec_int32 struct {\n    items []int32\n}\n\nfunc one() *_goml_vec_int32 {\n    var retv4 *_goml_vec_int32\n    var v__0 *_goml_vec_int32 = _goml_m_inherent_i_Vec_i_Vec_l_int32_r__i_new()\n    _goml_m_inherent_i_Vec_i_Vec_l_int32_r__i_push(v__0, 1)\n    retv4 = v__0\n    return retv4\n}\n\nfunc main0() struct{} {\n    var xs__1 *_goml_vec_int32 = one()\n    _goml_m_inherent_i_Vec_i_Vec_l_int32_r__i_push(xs__1, 2)\n    var t6 int32 = _goml_m_inherent_i_Vec_i_Vec_l_int32_r__i_len(xs__1)\n    _goml_m_println(t6)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_hashmap_and_dyn_hash_runtime() -> unit {
    let source = "impl Eq for dyn Hash { fn eq(self: dyn Hash, other: dyn Hash) -> bool { Hash::hash(self) == Hash::hash(other) } } fn main() -> unit { let h: HashMap[Ref[dyn Hash], string] = HashMap::new(); let inner: dyn Hash = 1i32; let r = Ref::new(inner); h.set(r, \"one\"); println(h.contains(r).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref_Dyn_Hash_x struct {\n    value dyn__Hash\n}\n\ntype hashmap_Ref_8Dyn_Hash_string_x_entry struct {\n    active bool\n    key *ref_Dyn_Hash_x\n    value string\n}\n\ntype hashmap_Ref_8Dyn_Hash_string_x struct {\n    buckets map[uint64][]hashmap_Ref_8Dyn_Hash_string_x_entry\n    hashes []uint64\n    len int32\n}\n\ntype _goml_synthetic__goml_option__string interface {\n    is_goml_synthetic__goml_option__string()\n}\n\ntype _goml_synthetic__goml_option__string_Some struct {\n    _0 string\n}\n\nfunc (_ _goml_synthetic__goml_option__string_Some) is_goml_synthetic__goml_option__string() {}\n\ntype _goml_synthetic__goml_option__string_None struct {}\n\nfunc (_ _goml_synthetic__goml_option__string_None) is_goml_synthetic__goml_option__string() {}\n\ntype dyn__Hash_vtable struct {\n    hash func(any) uint64\n}\n\ntype dyn__Hash struct {\n    data any\n    vtable *dyn__Hash_vtable\n}\n\nfunc dyn__Hash__wrap__int32__hash(self any) uint64 {\n    return _goml_m_trait__impl_i_Hash_i_int32_i_hash(self.(int32))\n}\n\nfunc dyn__Hash__vtable__int32() *dyn__Hash_vtable {\n    return &dyn__Hash_vtable{\n        hash: dyn__Hash__wrap__int32__hash,\n    }\n}\n\nfunc main0() struct{} {\n    var h__2 *hashmap_Ref_8Dyn_Hash_string_x = _goml_m_inherent_i_HashMap_i_HashMap_l_Ref_l_dynHash_r__c_string_r__i_new()\n    var inner__3 dyn__Hash = dyn__Hash{\n        data: int32(1),\n        vtable: dyn__Hash__vtable__int32(),\n    }\n    var r__4 *ref_Dyn_Hash_x = _goml_m_inherent_i_Ref_i_Ref_l_dynHash_r__i_new(inner__3)\n    _goml_m_inherent_i_HashMap_i_HashMap_l_Ref_l_dynHash_r__c_string_r__i_set(h__2, r__4, \"one\")\n    var t8 bool = _goml_m_inherent_i_HashMap_i_HashMap_l_Ref_l_dynHash_r__c_string_r__i_contains(h__2, r__4)\n    var t9 string = _goml_m_trait__impl_i_ToString_i_bool_i_to__string(t8)\n    _goml_m_println(t9)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_generic_enum_instances_and_type_switches() -> unit {
    let source = "enum Weird[T] { Next(Ref[Weird[(int32) -> int32]]), Done(T), } fn main() -> unit { let x: Weird[int32] = Weird::Done(1i32); match x { Weird::Done(v) => println(v.to_string()), Weird::Next(_) => println(\"next\"), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype ref__goml_m_Weird_____o_int32_q__m__z_int32_x struct {\n    value _goml_m_Weird_____o_int32_q__m__z_int32\n}\n\ntype _goml_m_Weird_____o_int32_q__m__z_int32 interface {\n    is_goml_m_Weird_____o_int32_q__m__z_int32()\n}\n\ntype _goml_m_Weird_____o_int32_q__m__z_int32_Next struct {\n    _0 *ref__goml_m_Weird_____o_int32_q__m__z_int32_x\n}\n\nfunc (_ _goml_m_Weird_____o_int32_q__m__z_int32_Next) is_goml_m_Weird_____o_int32_q__m__z_int32() {}\n\ntype _goml_m_Weird_____o_int32_q__m__z_int32_Done struct {\n    _0 func(int32) int32\n}\n\nfunc (_ _goml_m_Weird_____o_int32_q__m__z_int32_Done) is_goml_m_Weird_____o_int32_q__m__z_int32() {}\n\ntype Weird__int32 interface {\n    isWeird__int32()\n}\n\ntype Weird__int32_Next struct {\n    _0 *ref__goml_m_Weird_____o_int32_q__m__z_int32_x\n}\n\nfunc (_ Weird__int32_Next) isWeird__int32() {}\n\ntype Weird__int32_Done struct {\n    _0 int32\n}\n\nfunc (_ Weird__int32_Done) isWeird__int32() {}\n\nfunc main0() struct{} {\n    var x__0 Weird__int32 = Weird__int32_Done{\n        _0: 1,\n    }\n    switch x__0.(type) {\n    case Weird__int32_Next:\n        _goml_m_println(\"next\")\n    case Weird__int32_Done:\n        var x1 int32 = x__0.(Weird__int32_Done)._0\n        var v__1 int32 = x1\n        var t5 string = _goml_m_inherent_i_int32_i_int32_i_to__string(v__1)\n        _goml_m_println(t5)\n    default:\n        panic(\"non-exhaustive match\")\n    }\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_user_trait_objects_without_name_collisions() -> unit {
    let source = "trait Display { fn display(Self) -> string; } fn dyn__Display() -> int32 { 1i32 } struct Box { text: string, } impl Display for Box { fn display(self: Self) -> string { self.text } } fn main() -> unit { let d: dyn Display = Box { text: \"ok\" }; println(Display::display(d) + dyn__Display().to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype Box struct {\n    text string\n}\n\ntype dyn__Display_vtable struct {\n    display func(any) string\n}\n\ntype dyn__Display struct {\n    data any\n    vtable *dyn__Display_vtable\n}\n\nfunc dyn__Display__wrap__Box__display(self any) string {\n    return _goml_m_trait__impl_i_Display_i_Box_i_display(self.(Box))\n}\n\nfunc dyn__Display__vtable__Box() *dyn__Display_vtable {\n    return &dyn__Display_vtable{\n        display: dyn__Display__wrap__Box__display,\n    }\n}\n\nfunc _goml_user_dyn__Display() int32 {\n    var retv2 int32\n    retv2 = 1\n    return retv2\n}\n\nfunc _goml_m_trait__impl_i_Display_i_Box_i_display(self__0 Box) string {\n    var retv4 string\n    var t5 string = self__0.text\n    retv4 = t5\n    return retv4\n}\n\nfunc main0() struct{} {\n    var t7 Box = Box{\n        text: \"ok\",\n    }\n    var d__1 dyn__Display = dyn__Display{\n        data: t7,\n        vtable: dyn__Display__vtable__Box(),\n    }\n    var t8 string = d__1.vtable.display(d__1.data)\n    var t9 int32 = _goml_user_dyn__Display()\n    var t10 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t9)\n    var t11 string = t8 + t10\n    _goml_m_println(t11)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_non_repeating_joinrec_as_straight_line_control_flow() -> unit {
    let source = "fn f(flag: int32) -> int32 { while true { if flag == 0 { return 1 } else { break }; }; 2 } fn main() -> unit { println(f(0).to_string()); println(f(1).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\nfunc f(flag__0 int32) int32 {\n    var retv5 int32\n    if true {\n        var t9 bool = flag__0 == 0\n        if t9 {\n            retv5 = 1\n            return retv5\n        } else {\n            retv5 = 2\n            return retv5\n        }\n    } else {\n        retv5 = 2\n        return retv5\n    }\n}\n\nfunc main0() struct{} {\n    var t11 int32 = f(0)\n    var t12 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t11)\n    _goml_m_println(t12)\n    var t13 int32 = f(1)\n    var t14 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t13)\n    _goml_m_println(t14)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn emits_closures_inside_enum_payloads() -> unit {
    let source = "enum MaybeFn { Some((int32) -> int32), None, } fn next(flag: bool) -> MaybeFn { if flag { MaybeFn::Some(|x| x + 1i32) } else { MaybeFn::None } } fn main() -> unit { match next(true) { MaybeFn::Some(f) => println(f(41i32).to_string()), MaybeFn::None => println(\"none\"), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "package main\n\ntype closure_env_next_0 struct {}\n\ntype MaybeFn interface {\n    isMaybeFn()\n}\n\ntype Some struct {\n    _0 func(int32) int32\n}\n\nfunc (_ Some) isMaybeFn() {}\n\ntype None struct {}\n\nfunc (_ None) isMaybeFn() {}\n\nfunc next(flag__0 bool) MaybeFn {\n    var retv4 MaybeFn\n    var jp6 MaybeFn\n    if flag__0 {\n        var t7 closure_env_next_0 = closure_env_next_0{}\n        var t8 MaybeFn = Some{\n            _0: func(p0 int32) int32 {\n                return _goml_m_inherent_i_closure__env__next__0_i_closure__env__next__0_i_apply(t7, p0)\n            },\n        }\n        jp6 = t8\n    } else {\n        jp6 = None{}\n    }\n    retv4 = jp6\n    return retv4\n}\n\nfunc main0() struct{} {\n    var mtmp0 MaybeFn = next(true)\n    switch mtmp0.(type) {\n    case Some:\n        var x1 func(int32) int32 = mtmp0.(Some)._0\n        var f__2 func(int32) int32 = x1\n        var t11 int32 = f__2(41)\n        var t12 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t11)\n        _goml_m_println(t12)\n    case None:\n        _goml_m_println(\"none\")\n    default:\n        panic(\"non-exhaustive match\")\n    }\n    return struct{}{}\n}\n\nfunc _goml_m_inherent_i_closure__env__next__0_i_closure__env__next__0_i_apply(env2 closure_env_next_0, x__1 int32) int32 {\n    var retv16 int32\n    var t17 int32 = x__1 + 1\n    retv16 = t17\n    return retv16\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}
