        encode(lower_source(source)),
        "package main\n\ntype Tuple2_12dyn__Display_5int32 struct {\n    _0 dyn__Display\n    _1 int32\n}\n\ntype Boxed__dynDisplay interface {\n    isBoxed__dynDisplay()\n}\n\ntype One struct {\n    _0 Tuple2_12dyn__Display_5int32\n}\n\nfunc (_ One) isBoxed__dynDisplay() {}\n\ntype dyn__Display_vtable struct {\n    show func(any) string\n}\n\ntype dyn__Display struct {\n    data any\n    vtable *dyn__Display_vtable\n}\n\nfunc build() int32 {\n    var retv5 int32\n    retv5 = 7\n    return retv5\n}\n\nfunc main0() struct{} {\n    var t7 int32 = build()\n    var t8 string = _goml_m_inherent_i_int32_i_int32_i_to__string(t7)\n    _goml_m_println(t8)\n    return struct{}{}\n}\n\nfunc main() {\n    main0()\n}\n",
    )
}

#[test]
fn compacts_dyn_names_in_synthetic_options() -> unit {
    let source = "trait Display { fn show(Self) -> string; } impl Display for int32 { fn show(self: int32) -> string { self.to_string() } } fn build() -> int32 { let m: HashMap[int32, dyn Display] = HashMap::new(); m.set(1i32, if true { return 7i32 } else { 1i32 }); 0i32 } fn main() -> unit { println(build().to_string()) }";
