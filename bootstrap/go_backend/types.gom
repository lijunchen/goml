package go_backend;

use gomlc::tast;
use std::text;

pub fn compact_type(value: tast::Type) -> string {
    let type_builder = text::StringBuilder::new();
    tast::write_type(type_builder, value);
    let builder = text::StringBuilder::new();
    for character in type_builder.finish().chars() {
        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {
            ()
        } else {
            builder.write_char(character)
        }
    };
    builder.finish()
}

fn join_type_parts(values: Vec[tast::Type]) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_char('_')
        } else {
            ()
        };
        let encoded = encode_type(values.get(index));
        builder.write_string(encoded.byte_len().to_string());
        builder.write_string(encoded)
    };
    builder.finish()
}

pub fn encode_type(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        tast::Type::Unit => "unit",
        tast::Type::Never => "never",
        tast::Type::Bool => "bool",
        tast::Type::Int => "int",
        tast::Type::Int8 => "int8",
        tast::Type::Int16 => "int16",
        tast::Type::Int32 => "int32",
        tast::Type::Int64 => "int64",
        tast::Type::Uint8 => "uint8",
        tast::Type::Uint16 => "uint16",
        tast::Type::Uint32 => "uint32",
        tast::Type::Uint64 => "uint64",
        tast::Type::Float32 => "float32",
        tast::Type::Float64 => "float64",
        tast::Type::String => "string",
        tast::Type::Char => "char",
        tast::Type::Tuple { items: values } => "Tuple" + values.len().to_string() + "_" + join_type_parts(values),
        tast::Type::Con { name } => name,
        tast::Type::Dyn { trait_name: name } => "Dyn_" + name,
        tast::Type::Projection { for_ty: base, name, trait_ref: _ } => {
            let encoded = encode_type(base);
            "Projection_" + encoded.byte_len().to_string() + encoded + "_" + name
        },
        tast::Type::App { ty: base, args } => {
            let base_name = encode_type(base);
            if args.len() == 0 {
                base_name
            } else {
                "App_"
                    + base_name.byte_len().to_string()
                    + base_name
                    + "__"
                    + join_type_parts(args)
            }
        },
        tast::Type::Array { len: length, elem } => {
            let encoded = encode_type(elem);
            "Array_" + length.to_string() + "_" + encoded.byte_len().to_string() + encoded
        },
        tast::Type::Slice { elem } => {
            let encoded = encode_type(elem);
            "Slice_" + encoded.byte_len().to_string() + encoded
        },
        tast::Type::VecType { elem } => {
            let encoded = encode_type(elem);
            "Vec_" + encoded.byte_len().to_string() + encoded
        },
        tast::Type::RefType { elem } => {
            let encoded = encode_type(elem);
            "Ref_" + encoded.byte_len().to_string() + encoded
        },
        tast::Type::HashMap { key, value } => {
            let key_name = encode_type(key);
            let value_name = encode_type(value);
            "HashMap_"
                + key_name.byte_len().to_string()
                + key_name
                + "_"
                + value_name.byte_len().to_string()
                + value_name
        },
        tast::Type::Channel { elem } => {
            let encoded = encode_type(elem);
            "Channel_" + encoded.byte_len().to_string() + encoded
        },
        tast::Type::Param { name } => "TParam_" + name,
        tast::Type::Func { params, ret_ty } => {
            let ret_name = encode_type(ret_ty);
            "Fn"
                + params.len().to_string()
                + "_"
                + join_type_parts(params)
                + "_to_"
                + ret_name.byte_len().to_string()
                + ret_name
        },
        tast::Type::Var(_) => "Var",
        tast::Type::Error => "Error",
    }
}

fn type_name_part(value: tast::Type) -> string {
    let name = type_name(value);
    name.byte_len().to_string() + name
}

pub fn type_name(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        tast::Type::Unit => "unit",
        tast::Type::Never => "never",
        tast::Type::Bool => "bool",
        tast::Type::Int => "int",
        tast::Type::Int8 => "int8",
        tast::Type::Int16 => "int16",
        tast::Type::Int32 => "int32",
        tast::Type::Int64 => "int64",
        tast::Type::Uint8 => "uint8",
        tast::Type::Uint16 => "uint16",
        tast::Type::Uint32 => "uint32",
        tast::Type::Uint64 => "uint64",
        tast::Type::Float32 => "float32",
        tast::Type::Float64 => "float64",
        tast::Type::String => "string",
        tast::Type::Char => "char",
        tast::Type::Tuple { items: values } => {
            let builder = text::StringBuilder::new();
            builder.write_string("Tuple");
            builder.write_string(values.len().to_string());
            for value in values {
                builder.write_char('_');
                builder.write_string(type_name_part(value))
            };
            go_generated_ident(builder.finish())
        },
        tast::Type::Con { name } => go_user_type_name(name),
        tast::Type::Dyn { trait_name: name } => go_dyn_struct_name(name),
        tast::Type::Projection { for_ty: base, name, trait_ref: _ } => {
            go_generated_ident("Projection_" + type_name_part(base) + "_" + name)
        },
        tast::Type::App { ty: base, args } => {
            let builder = text::StringBuilder::new();
            builder.write_string(type_name(base));
            for value in args {
                builder.write_char('_');
                builder.write_string(type_name_part(value))
            };
            go_generated_ident(builder.finish())
        },
        tast::Type::Array { len: length, elem } => {
            go_generated_ident("Array" + length.to_string() + "_" + type_name_part(elem))
        },
        tast::Type::Slice { elem } => go_generated_ident("Slice_" + type_name_part(elem)),
        tast::Type::VecType { elem } => go_generated_ident("Vec_" + type_name_part(elem)),
        tast::Type::RefType { elem } => go_generated_ident("Ptr_" + type_name_part(elem)),
        tast::Type::HashMap { key, value } => {
            go_generated_ident("HashMap_" + type_name_part(key) + "_" + type_name_part(value))
        },
        tast::Type::Channel { elem } => go_generated_ident("Channel_" + type_name_part(elem)),
        tast::Type::Param { name } => go_ident(name),
        tast::Type::Func { params, ret_ty } => {
            let builder = text::StringBuilder::new();
            builder.write_string("TFunc");
            builder.write_string(params.len().to_string());
            for value in params {
                builder.write_char('_');
                builder.write_string(type_name_part(value))
            };
            builder.write_string("_ret_");
            builder.write_string(type_name_part(ret_ty));
            go_generated_ident(builder.finish())
        },
        tast::Type::Var(_) => "Var",
        tast::Type::Error => "Error",
    }
}

pub fn lower_type(value: tast::Type) -> Type {
    match tast::resolve_type(value) {
        tast::Type::Unit | tast::Type::Never => Type::Unit,
        tast::Type::Bool => Type::Bool,
        tast::Type::Int => Type::Int,
        tast::Type::Int8 => Type::Int8,
        tast::Type::Int16 => Type::Int16,
        tast::Type::Int32 => Type::Int32,
        tast::Type::Int64 => Type::Int64,
        tast::Type::Uint8 => Type::Uint8,
        tast::Type::Uint16 => Type::Uint16,
        tast::Type::Uint32 => Type::Uint32,
        tast::Type::Uint64 => Type::Uint64,
        tast::Type::Float32 => Type::Float32,
        tast::Type::Float64 => Type::Float64,
        tast::Type::String => Type::String,
        tast::Type::Char => Type::Char,
        tast::Type::Tuple { items: _ } => Type::Named(type_name(value)),
        tast::Type::Con { name } => Type::Named(go_user_type_name(name)),
        tast::Type::Dyn { trait_name: name } => Type::Named(go_dyn_struct_name(name)),
        tast::Type::Projection { for_ty: _, name: _, trait_ref: _ } => Type::Named(type_name(value)),
        tast::Type::App { ty: _, args: _ } => Type::Named(type_name(value)),
        tast::Type::Array { len: length, elem } => Type::Array(length, lower_type(elem)),
        tast::Type::Slice { elem } => Type::Slice(lower_type(elem)),
        tast::Type::VecType { elem } => {
            Type::Pointer(Type::Named(go_generated_ident("_goml_vec_" + go_ident(encode_type(elem)))))
        },
        tast::Type::RefType { elem } => {
            Type::Pointer(Type::Named(go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x")))
        },
        tast::Type::HashMap { key, value } => {
            Type::Pointer(Type::Named(go_generated_ident(
                "hashmap_" + go_ident(encode_type(key) + "_" + encode_type(value)) + "_x",
            )))
        },
        tast::Type::Channel { elem } => Type::Chan(lower_type(elem)),
        tast::Type::Param { name } => Type::Named(go_ident(name)),
        tast::Type::Func { params, ret_ty } => {
            let lowered: Vec[Type] = Vec::new();
            for value in params {
                lowered.push(lower_type(value))
            };
            Type::Func(lowered, lower_type(ret_ty))
        },
        tast::Type::Var(_) | tast::Type::Error => Type::Named(type_name(value)),
    }
}
