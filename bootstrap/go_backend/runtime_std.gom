package go_backend;

use gomlc::tast;

fn std_function_item(
    key: string,
    params: Vec[(string, Type)],
    ret_ty: Type,
    stmts: Vec[Stmt],
) -> Item {
    Item::Function(Function {
        name: runtime_hook_name(key),
        params,
        ret_ty: Option::Some(ret_ty),
        body: Block { stmts },
    })
}

fn std_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call(Expr::Var(name), args)
}

fn std_method_call(value: Expr, name: string, args: Vec[Expr]) -> Expr {
    Expr::Call(Expr::Field(value, name), args)
}

fn std_tuple_type(values: Vec[tast::Type]) -> Type {
    lower_type(tast::Type::Tuple(values))
}

fn std_tuple_expr(ty: Type, values: Vec[Expr]) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in range(0, values.len()) {
        fields.push(("_" + index.to_string(), values.get(index)))
    };
    Expr::StructLiteral(ty, fields)
}

fn std_vec_type(elem: tast::Type) -> tast::Type {
    tast::Type::VecType(elem)
}

fn std_vec_expr(elem: tast::Type, items: Expr) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(("items", items));
    Expr::Unary(
        UnaryOp::Address,
        Expr::StructLiteral(
            Type::Named(go_generated_ident(
                "_goml_vec_" + go_ident(encode_type(elem)),
            )),
            fields,
        ),
    )
}

fn std_error_string() -> Expr {
    std_method_call(Expr::Var("err"), "Error", Vec::new())
}

fn std_error_condition() -> Expr {
    Expr::Binary(BinaryOp::NotEq, Expr::Var("err"), Expr::Nil)
}

fn std_bool_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_string_expr(valid: bool, value: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool(valid));
    values.push(value);
    std_tuple_expr(std_bool_string_type(), values)
}

fn std_bool_string_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(tast::Type::String);
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_string_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool(valid));
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_string_string_type(), values)
}

fn std_bool_bytes_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(std_vec_type(tast::Type::Uint8));
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_bytes_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool(valid));
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_bytes_string_type(), values)
}

fn std_bool_strings_string_type() -> Type {
    let values: Vec[tast::Type] = Vec::new();
    values.push(tast::Type::Bool);
    values.push(std_vec_type(tast::Type::String));
    values.push(tast::Type::String);
    std_tuple_type(values)
}

fn std_bool_strings_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool(valid));
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_strings_string_type(), values)
}

fn std_env_args_item() -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return(Option::Some(std_vec_expr(
        tast::Type::String,
        Expr::Var("_goml_os.Args"),
    ))));
    std_function_item(
        "std.env.args",
        Vec::new(),
        lower_type(std_vec_type(tast::Type::String)),
        stmts,
    )
}

fn std_string_result_item(key: string, function: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("value", Type::String, Option::None));
    stmts.push(Stmt::Var("err", Type::Named("error"), Option::None));
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("err");
    stmts.push(Stmt::MultiAssign(names, std_call(function, Vec::new())));
    let failed: Vec[Stmt] = Vec::new();
    failed.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        false,
        Expr::String(""),
        std_error_string(),
    ))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: failed },
        Option::None,
    ));
    stmts.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        true,
        Expr::Var("value"),
        Expr::String(""),
    ))));
    std_function_item(key, Vec::new(), std_bool_string_string_type(), stmts)
}

fn std_env_var_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("name", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("value", Type::String, Option::None));
    stmts.push(Stmt::Var("found", Type::Bool, Option::None));
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("found");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var("name"));
    stmts.push(Stmt::MultiAssign(names, std_call("_goml_os.LookupEnv", args)));
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Var("found"));
    values.push(Expr::Var("value"));
    stmts.push(Stmt::Return(Option::Some(std_tuple_expr(
        std_bool_string_type(),
        values,
    ))));
    std_function_item("std.env.var", params, std_bool_string_type(), stmts)
}

fn std_fs_read_file_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let bytes = Type::Slice(Type::Uint8);
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("data", bytes, Option::None));
    stmts.push(Stmt::Var("err", Type::Named("error"), Option::None));
    let names: Vec[string] = Vec::new();
    names.push("data");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var("path"));
    stmts.push(Stmt::MultiAssign(names, std_call("_goml_os.ReadFile", args)));
    let failed: Vec[Stmt] = Vec::new();
    failed.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        false,
        Expr::String(""),
        std_error_string(),
    ))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: failed },
        Option::None,
    ));
    stmts.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        true,
        Expr::Convert(Type::String, Expr::Var("data")),
        Expr::String(""),
    ))));
    std_function_item(
        "std.fs.read_file",
        params,
        std_bool_string_string_type(),
        stmts,
    )
}

fn std_fs_write_file_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    params.push(("content", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var("path"));
    args.push(Expr::Convert(Type::Named("[]byte"), Expr::Var("content")));
    args.push(Expr::Int("0644"));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var(
        "err",
        Type::Named("error"),
        Option::Some(std_call("_goml_os.WriteFile", args)),
    ));
    let failed: Vec[Stmt] = Vec::new();
    failed.push(Stmt::Return(Option::Some(std_bool_string_expr(
        false,
        std_error_string(),
    ))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: failed },
        Option::None,
    ));
    stmts.push(Stmt::Return(Option::Some(std_bool_string_expr(
        true,
        Expr::String(""),
    ))));
    std_function_item(
        "std.fs.write_file",
        params,
        std_bool_string_type(),
        stmts,
    )
}

