fn std_fs_file_exists_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("err", Type::Named("error"), Option::None));
    let names: Vec[string] = Vec::new();
    names.push("_");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var("path"));
    stmts.push(Stmt::MultiAssign(names, std_call("_goml_os.Stat", args)));
    stmts.push(Stmt::Return(Option::Some(Expr::Binary(
        BinaryOp::Eq,
        Expr::Var("err"),
        Expr::Nil,
    ))));
    std_function_item("std.fs.file_exists", params, Type::Bool, stmts)
}

fn std_fs_stat_kind_item(key: string, directory: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var(
        "info",
        Type::Named("_goml_os.FileInfo"),
        Option::None,
    ));
    stmts.push(Stmt::Var("err", Type::Named("error"), Option::None));
    let names: Vec[string] = Vec::new();
    names.push("info");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var("path"));
    stmts.push(Stmt::MultiAssign(names, std_call("_goml_os.Stat", args)));
    let failed: Vec[Stmt] = Vec::new();
    failed.push(Stmt::Return(Option::Some(Expr::Bool(false))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: failed },
        Option::None,
    ));
    let predicate = if directory {
        std_method_call(Expr::Var("info"), "IsDir", Vec::new())
    } else {
        std_method_call(
            std_method_call(Expr::Var("info"), "Mode", Vec::new()),
            "IsRegular",
            Vec::new(),
        )
    };
    stmts.push(Stmt::Return(Option::Some(predicate)));
    std_function_item(key, params, Type::Bool, stmts)
}

fn std_fs_canonicalize_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("absolute", Type::String, Option::None));
    stmts.push(Stmt::Var("result", Type::String, Option::None));
    stmts.push(Stmt::Var("err", Type::Named("error"), Option::None));
    let absolute_names: Vec[string] = Vec::new();
    absolute_names.push("absolute");
    absolute_names.push("err");
    let absolute_args: Vec[Expr] = Vec::new();
    absolute_args.push(Expr::Var("path"));
    stmts.push(Stmt::MultiAssign(
        absolute_names,
        std_call("_goml_filepath.Abs", absolute_args),
    ));
    let absolute_failed: Vec[Stmt] = Vec::new();
    absolute_failed.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        false,
        Expr::String(""),
        std_error_string(),
    ))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: absolute_failed },
        Option::None,
    ));
    let result_names: Vec[string] = Vec::new();
    result_names.push("result");
    result_names.push("err");
    let result_args: Vec[Expr] = Vec::new();
    result_args.push(Expr::Var("absolute"));
    stmts.push(Stmt::MultiAssign(
        result_names,
        std_call("_goml_filepath.EvalSymlinks", result_args),
    ));
    let result_failed: Vec[Stmt] = Vec::new();
    result_failed.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        false,
        Expr::String(""),
        std_error_string(),
    ))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: result_failed },
        Option::None,
    ));
    stmts.push(Stmt::Return(Option::Some(std_bool_string_string_expr(
        true,
        Expr::Var("result"),
        Expr::String(""),
    ))));
    std_function_item(
        "std.fs.canonicalize",
        params,
        std_bool_string_string_type(),
        stmts,
    )
}

fn std_fs_read_dir_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let entries_type = Type::Slice(Type::Named("_goml_os.DirEntry"));
    let names_type = Type::Slice(Type::String);
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("entries", entries_type, Option::None));
    stmts.push(Stmt::Var("err", Type::Named("error"), Option::None));
    let assignment_names: Vec[string] = Vec::new();
    assignment_names.push("entries");
    assignment_names.push("err");
    let read_args: Vec[Expr] = Vec::new();
    read_args.push(Expr::Var("path"));
    stmts.push(Stmt::MultiAssign(
        assignment_names,
        std_call("_goml_os.ReadDir", read_args),
    ));
    let failed: Vec[Stmt] = Vec::new();
    failed.push(Stmt::Return(Option::Some(std_bool_strings_string_expr(
        false,
        std_vec_expr(tast::Type::String, Expr::Nil),
        std_error_string(),
    ))));
    stmts.push(Stmt::If(
        std_error_condition(),
        Block { stmts: failed },
        Option::None,
    ));
    stmts.push(Stmt::Var("names", names_type, Option::None));
    stmts.push(Stmt::Var("i", Type::Int, Option::Some(Expr::Int("0"))));
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var("entries"));
    let finished: Vec[Stmt] = Vec::new();
    finished.push(Stmt::Break);
    loop_stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::GreaterEq,
            Expr::Var("i"),
            Expr::Convert(Type::Int, std_call("len", len_args)),
        ),
        Block { stmts: finished },
        Option::None,
    ));
    loop_stmts.push(Stmt::Var(
        "entry",
        Type::Named("_goml_os.DirEntry"),
        Option::Some(Expr::Index(Expr::Var("entries"), Expr::Var("i"))),
    ));
    let append_args: Vec[Expr] = Vec::new();
    append_args.push(Expr::Var("names"));
    append_args.push(std_method_call(
        Expr::Var("entry"),
        "Name",
        Vec::new(),
    ));
    loop_stmts.push(Stmt::Assign("names", std_call("append", append_args)));
    loop_stmts.push(Stmt::Assign(
        "i",
        Expr::Binary(BinaryOp::Add, Expr::Var("i"), Expr::Int("1")),
    ));
    stmts.push(Stmt::Loop(Block { stmts: loop_stmts }));
    stmts.push(Stmt::Return(Option::Some(std_bool_strings_string_expr(
        true,
        std_vec_expr(tast::Type::String, Expr::Var("names")),
        Expr::String(""),
    ))));
    std_function_item(
        "std.fs.read_dir",
        params,
        std_bool_strings_string_type(),
        stmts,
    )
}

fn std_io_output_item(key: string, function: string, stderr: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("value", Type::String));
    let args: Vec[Expr] = Vec::new();
    if stderr {
        args.push(Expr::Var("_goml_os.Stderr"))
    } else {
        ()
    };
    args.push(Expr::Var("value"));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Expr(std_call(function, args)));
    stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
    std_function_item(key, params, Type::Unit, stmts)
}

