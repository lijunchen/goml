package go_backend;

use gomlc::tast;

pub enum Type {
    Void,
    Any,
    Unit,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Named(string),
    Pointer(Type),
    Array(int, Type),
    Slice(Type),
    Map(Type, Type),
    Chan(Type),
    Func(Vec[Type], Type),
    Multi(Vec[Type]),
}

pub enum UnaryOp {
    Neg,
    Not,
    BitNot,
    Address,
    Deref,
}

pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Less,
    Greater,
    LessEq,
    GreaterEq,
    Eq,
    NotEq,
    And,
    Or,
}

pub enum Expr {
    Nil,
    Unit,
    Var(string),
    Bool(bool),
    Int(string),
    Float(string),
    String(string),
    Call(Expr, Vec[Expr]),
    Unary(UnaryOp, Expr),
    Binary(BinaryOp, Expr, Expr),
    Field(Expr, string),
    Index(Expr, Expr),
    Slice(Expr, Expr, Expr),
    Cast(Expr, Type),
    Convert(Type, Expr),
    Make(Type, Vec[Expr]),
    Send(Expr, Expr),
    Receive(Expr),
    StructLiteral(Type, Vec[(string, Expr)]),
    ArrayLiteral(Type, Vec[Expr]),
    FuncLit(Vec[(string, Type)], Type, Block),
}

pub struct Block {
    pub stmts: Vec[Stmt],
}

pub struct SwitchCase {
    pub value: Expr,
    pub body: Block,
}

pub struct TypeSwitchCase {
    pub ty: Type,
    pub body: Block,
}

pub enum Stmt {
    Expr(Expr),
    Go(Expr),
    Var(string, Type, Option[Expr]),
    Assign(string, Expr),
    FieldAssign(Expr, string, Expr),
    IndexAssign(Expr, Expr, Expr),
    MultiAssign(Vec[string], Expr),
    Return(Option[Expr]),
    ReturnMulti(Vec[Expr]),
    If(Expr, Block, Option[Block]),
    Loop(Block),
    LabeledLoop(string, Block),
    Range(Vec[string], Expr, Block),
    Break,
    BreakLabel(string),
    Continue,
    Switch(Expr, Vec[SwitchCase], Option[Block]),
    TypeSwitch(Option[string], Expr, Vec[TypeSwitchCase], Option[Block]),
    Panic(string),
    Unreachable,
}

pub struct StructDef {
    pub name: string,
    pub fields: Vec[(string, Type)],
}

pub struct InterfaceMethod {
    pub name: string,
    pub params: Vec[Type],
    pub ret_ty: Option[Type],
}

pub struct InterfaceDef {
    pub name: string,
    pub methods: Vec[InterfaceMethod],
}

pub struct TypeDef {
    pub name: string,
    pub ty: Type,
}

pub struct ConstSpec {
    pub name: string,
    pub ty: Type,
    pub value: Expr,
}

pub struct ConstGroup {
    pub specs: Vec[ConstSpec],
}

pub struct Function {
    pub name: string,
    pub params: Vec[(string, Type)],
    pub ret_ty: Option[Type],
    pub body: Block,
}

pub struct Method {
    pub receiver: (string, Type),
    pub name: string,
    pub params: Vec[(string, Type)],
    pub ret_ty: Option[Type],
    pub body: Block,
}

pub enum Item {
    ImportGroup(Vec[(string, string)]),
    TypeDef(TypeDef),
    ConstGroup(ConstGroup),
    Interface(InterfaceDef),
    Struct(StructDef),
    Function(Function),
    Method(Method),
}

pub struct File {
    pub items: Vec[Item],
}

pub struct DynCoercion {
    pub trait_name: string,
    pub for_ty: tast::Type,
}

pub struct DynHelperNames {
    pub factories: Vec[(string, string, string)],
    pub wrappers: Vec[(string, string, string, string)],
}

pub struct VariantInfo {
    pub owner_name: string,
    pub tag: int,
    pub variant_name: string,
    pub field_types: Vec[tast::Type],
    pub tag_only: bool,
}

pub struct VariantInfos {
    pub by_owner: HashMap[string, Vec[VariantInfo]],
}

pub struct ClosureInfo {
    pub struct_name: string,
    pub apply_name: string,
    pub params: Vec[tast::Type],
    pub ret_ty: tast::Type,
}
