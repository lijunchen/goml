package go_backend;

use gomlang::parser::anf;
use gomlang::parser::core;
use gomlang::parser::tast;

struct DynMethod {
    name: string,
    params: Vec[tast::Type],
    ret_ty: tast::Type,
}

fn hashmap_name(key: tast::Type, value: tast::Type) -> string {
    go_generated_ident(
        "hashmap_" + go_ident(encode_type(key) + "_" + encode_type(value)) + "_x",
    )
}

fn ref_struct_name(elem: tast::Type) -> string {
    go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x")
}

pub fn runtime_helper_name(prefix: string, ty: tast::Type) -> string {
    go_generated_ident(prefix + "__" + go_ident(encode_type(ty)))
}

pub fn ref_helper_name(prefix: string, ref_ty: tast::Type) -> string {
    runtime_helper_name(prefix, ref_ty)
}

fn array_runtime_items(array_ty: tast::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    match tast::resolve_type(array_ty) {
        tast::Type::Array(_, elem) => {
            let lowered_array = lower_type(array_ty);
            let lowered_elem = lower_type(elem);
            let get_params: Vec[(string, Type)] = Vec::new();
            get_params.push(("arr", lowered_array));
            get_params.push(("index", Type::Int32));
            let get_stmts: Vec[Stmt] = Vec::new();
            get_stmts.push(Stmt::Return(Option::Some(Expr::Index(
                Expr::Var("arr"),
                Expr::Var("index"),
            ))));
            result.push(Item::Function(Function {
                name: runtime_helper_name("array_get", array_ty),
                params: get_params,
                ret_ty: Option::Some(lowered_elem),
                body: Block { stmts: get_stmts },
            }));
            let set_params: Vec[(string, Type)] = Vec::new();
            set_params.push(("arr", lowered_array));
            set_params.push(("index", Type::Int32));
            set_params.push(("value", lowered_elem));
            let set_stmts: Vec[Stmt] = Vec::new();
            set_stmts.push(Stmt::IndexAssign(
                Expr::Var("arr"),
                Expr::Var("index"),
                Expr::Var("value"),
            ));
            set_stmts.push(Stmt::Return(Option::Some(Expr::Var("arr"))));
            result.push(Item::Function(Function {
                name: runtime_helper_name("array_set", array_ty),
                params: set_params,
                ret_ty: Option::Some(lowered_array),
                body: Block { stmts: set_stmts },
            }))
        },
        _ => (),
    };
    result
}

fn vec_runtime_items(vec_ty: tast::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    match tast::resolve_type(vec_ty) {
        tast::Type::VecType(elem) => {
            let lowered_vec = lower_type(vec_ty);
            let lowered_elem = lower_type(elem);
            let get_params: Vec[(string, Type)] = Vec::new();
            get_params.push(("vec", lowered_vec));
            get_params.push(("index", Type::Int32));
            let get_stmts: Vec[Stmt] = Vec::new();
            get_stmts.push(Stmt::Return(Option::Some(Expr::Index(
                Expr::Field(Expr::Var("vec"), "items"),
                Expr::Var("index"),
            ))));
            result.push(Item::Function(Function {
                name: runtime_helper_name("vec_get", vec_ty),
                params: get_params,
                ret_ty: Option::Some(lowered_elem),
                body: Block { stmts: get_stmts },
            }));
            let set_params: Vec[(string, Type)] = Vec::new();
            set_params.push(("vec", lowered_vec));
            set_params.push(("index", Type::Int32));
            set_params.push(("value", lowered_elem));
            let set_stmts: Vec[Stmt] = Vec::new();
            set_stmts.push(Stmt::IndexAssign(
                Expr::Field(Expr::Var("vec"), "items"),
                Expr::Var("index"),
                Expr::Var("value"),
            ));
            set_stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
            result.push(Item::Function(Function {
                name: runtime_helper_name("vec_set", vec_ty),
                params: set_params,
                ret_ty: Option::Some(Type::Unit),
                body: Block { stmts: set_stmts },
            }))
        },
        _ => (),
    };
    result
}

fn ref_runtime_items(ref_ty: tast::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    match tast::resolve_type(ref_ty) {
        tast::Type::RefType(elem) => {
            let elem_ty = lower_type(elem);
            let lowered_ref_ty = lower_type(ref_ty);
            let struct_ty = Type::Named(ref_struct_name(elem));
            let new_fields: Vec[(string, Expr)] = Vec::new();
            new_fields.push(("value", Expr::Var("value")));
            let new_stmts: Vec[Stmt] = Vec::new();
            new_stmts.push(Stmt::Return(Option::Some(Expr::Unary(
                UnaryOp::Address,
                Expr::StructLiteral(struct_ty, new_fields),
            ))));
            let new_params: Vec[(string, Type)] = Vec::new();
            new_params.push(("value", elem_ty));
            result.push(Item::Function(Function {
                name: ref_helper_name("ref", ref_ty),
                params: new_params,
                ret_ty: Option::Some(lowered_ref_ty),
                body: Block { stmts: new_stmts },
            }));
            let get_params: Vec[(string, Type)] = Vec::new();
            get_params.push(("reference", lowered_ref_ty));
            let get_stmts: Vec[Stmt] = Vec::new();
            get_stmts.push(Stmt::Return(Option::Some(Expr::Field(
                Expr::Var("reference"),
                "value",
            ))));
            result.push(Item::Function(Function {
                name: ref_helper_name("ref_get", ref_ty),
                params: get_params,
                ret_ty: Option::Some(elem_ty),
                body: Block { stmts: get_stmts },
            }));
            let set_params: Vec[(string, Type)] = Vec::new();
            set_params.push(("reference", lowered_ref_ty));
            set_params.push(("value", elem_ty));
            let set_stmts: Vec[Stmt] = Vec::new();
            set_stmts.push(Stmt::FieldAssign(
                Expr::Var("reference"),
                "value",
                Expr::Var("value"),
            ));
            set_stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
            result.push(Item::Function(Function {
                name: ref_helper_name("ref_set", ref_ty),
                params: set_params,
                ret_ty: Option::Some(Type::Unit),
                body: Block { stmts: set_stmts },
            }))
        },
        _ => (),
    };
    result
}

fn synthetic_option_base(value: tast::Type) -> string {
    "_goml_option__" + compact_type(value)
}

fn synthetic_option_items(value: tast::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let option_name = go_generated_ident("_goml_synthetic_" + synthetic_option_base(value));
    let method_name = go_generated_ident("is" + option_name);
    let some_name = go_generated_ident(option_name + "_Some");
    let none_name = go_generated_ident(option_name + "_None");
    let methods: Vec[InterfaceMethod] = Vec::new();
    methods.push(InterfaceMethod {
        name: method_name,
        params: Vec::new(),
        ret_ty: Option::None,
    });
    result.push(Item::Interface(InterfaceDef { name: option_name, methods }));
    let some_fields: Vec[(string, Type)] = Vec::new();
    some_fields.push(("_0", lower_type(value)));
    result.push(Item::Struct(StructDef { name: some_name, fields: some_fields }));
    result.push(Item::Method(Method {
        receiver: ("_", Type::Named(some_name)),
        name: method_name,
        params: Vec::new(),
        ret_ty: Option::None,
        body: Block { stmts: Vec::new() },
    }));
    result.push(Item::Struct(StructDef { name: none_name, fields: Vec::new() }));
    result.push(Item::Method(Method {
        receiver: ("_", Type::Named(none_name)),
        name: method_name,
        params: Vec::new(),
        ret_ty: Option::None,
        body: Block { stmts: Vec::new() },
    }));
    result
}

fn hashmap_option_info(
    value: tast::Type,
    instances: Vec[core::TypeInstance],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    function_names: Vec[(string, string)],
) -> (Type, Type, Type, bool) {
    let args: Vec[tast::Type] = Vec::new();
    args.push(value);
    match find_instance(instances, "Option", args) {
        Option::Some(instance) => (
            Type::Named(go_user_type_name(instance.name)),
            Type::Named(variant_go_name(
                instance.name,
                "Some",
                enums,
                structs,
                instances,
                function_names,
            )),
            Type::Named(variant_go_name(
                instance.name,
                "None",
                enums,
                structs,
                instances,
                function_names,
            )),
            false,
        ),
        Option::None => {
            let option_name = go_generated_ident(
                "_goml_synthetic_" + synthetic_option_base(value),
            );
            (
                Type::Named(option_name),
                Type::Named(go_generated_ident(option_name + "_Some")),
                Type::Named(go_generated_ident(option_name + "_None")),
                true,
            )
        },
    }
}

fn hashmap_trait_impl_name(trait_name: string, key: tast::Type, method: string) -> string {
    go_ident("trait_impl#" + trait_name + "#" + compact_type(key) + "#" + method)
}

fn hashmap_lookup_item(key: tast::Type, value: tast::Type) -> Item {
    let map_ty = tast::Type::HashMap(key, value);
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named(go_generated_ident(hashmap_name(key, value) + "_entry"));
    let bucket_ty = Type::Slice(entry_ty);
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::new();
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Var("zero", lowered_value, Option::None));
    let nil_values: Vec[Expr] = Vec::new();
    nil_values.push(Expr::Var("zero"));
    nil_values.push(Expr::Bool(false));
    nil_stmts.push(Stmt::ReturnMulti(nil_values));
    stmts.push(Stmt::If(
        Expr::Binary(BinaryOp::Eq, Expr::Var("m"), Expr::Nil),
        Block { stmts: nil_stmts },
        Option::None,
    ));
    let hash_args: Vec[Expr] = Vec::new();
    hash_args.push(Expr::Var("key"));
    stmts.push(Stmt::Var(
        "h",
        Type::Uint64,
        Option::Some(Expr::Call(
            Expr::Var(hashmap_trait_impl_name("Hash", key, "hash")),
            hash_args,
        )),
    ));
    stmts.push(Stmt::Var(
        "bucket",
        bucket_ty,
        Option::Some(Expr::Index(
            Expr::Field(Expr::Var("m"), "buckets"),
            Expr::Var("h"),
        )),
    ));
    stmts.push(Stmt::Var(
        "i",
        Type::Int32,
        Option::Some(Expr::Int("0")),
    ));
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var("bucket"));
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::GreaterEq,
            Expr::Var("i"),
            Expr::Convert(
                Type::Int32,
                Expr::Call(Expr::Var("len"), len_args),
            ),
        ),
        Block { stmts: break_stmts },
        Option::None,
    ));
    loop_stmts.push(Stmt::Var(
        "entry",
        entry_ty,
        Option::Some(Expr::Index(
            Expr::Var("bucket"),
            Expr::Var("i"),
        )),
    ));
    let eq_args: Vec[Expr] = Vec::new();
    eq_args.push(Expr::Field(Expr::Var("entry"), "key"));
    eq_args.push(Expr::Var("key"));
    let found_stmts: Vec[Stmt] = Vec::new();
    let found_values: Vec[Expr] = Vec::new();
    found_values.push(Expr::Field(Expr::Var("entry"), "value"));
    found_values.push(Expr::Bool(true));
    found_stmts.push(Stmt::ReturnMulti(found_values));
    loop_stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::And,
            Expr::Field(Expr::Var("entry"), "active"),
            Expr::Call(
                Expr::Var(hashmap_trait_impl_name("Eq", key, "eq")),
                eq_args,
            ),
        ),
        Block { stmts: found_stmts },
        Option::None,
    ));
    loop_stmts.push(Stmt::Assign(
        "i",
        Expr::Binary(BinaryOp::Add, Expr::Var("i"), Expr::Int("1")),
    ));
    stmts.push(Stmt::Loop(Block { stmts: loop_stmts }));
    stmts.push(Stmt::Var("zero", lowered_value, Option::None));
    let missing_values: Vec[Expr] = Vec::new();
    missing_values.push(Expr::Var("zero"));
    missing_values.push(Expr::Bool(false));
    stmts.push(Stmt::ReturnMulti(missing_values));
    let returns: Vec[Type] = Vec::new();
    returns.push(lowered_value);
    returns.push(Type::Bool);
    Item::Function(Function {
        name: runtime_helper_name("hashmap_lookup", map_ty),
        params,
        ret_ty: Option::Some(Type::Multi(returns)),
        body: Block { stmts },
    })
}

fn hashmap_get_item(
    key: tast::Type,
    value: tast::Type,
    option_ty: Type,
    some_ty: Type,
    none_ty: Type,
) -> Item {
    let map_ty = tast::Type::HashMap(key, value);
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lower_type(map_ty)));
    params.push(("key", lower_type(key)));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var("value", lower_type(value), Option::None));
    stmts.push(Stmt::Var("ok", Type::Bool, Option::None));
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("ok");
    let lookup_args: Vec[Expr] = Vec::new();
    lookup_args.push(Expr::Var("m"));
    lookup_args.push(Expr::Var("key"));
    stmts.push(Stmt::MultiAssign(
        names,
        Expr::Call(
            Expr::Var(runtime_helper_name("hashmap_lookup", map_ty)),
            lookup_args,
        ),
    ));
    let some_fields: Vec[(string, Expr)] = Vec::new();
    some_fields.push(("_0", Expr::Var("value")));
    let some_stmts: Vec[Stmt] = Vec::new();
    some_stmts.push(Stmt::Return(Option::Some(Expr::StructLiteral(
        some_ty,
        some_fields,
    ))));
    stmts.push(Stmt::If(
        Expr::Var("ok"),
        Block { stmts: some_stmts },
        Option::None,
    ));
    stmts.push(Stmt::Return(Option::Some(Expr::StructLiteral(
        none_ty,
        Vec::new(),
    ))));
    Item::Function(Function {
        name: runtime_helper_name("hashmap_get", map_ty),
        params,
        ret_ty: Option::Some(option_ty),
        body: Block { stmts },
    })
}

fn hashmap_entry_expr(entry_ty: Type) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(("active", Expr::Bool(true)));
    fields.push(("key", Expr::Var("key")));
    fields.push(("value", Expr::Var("value")));
    Expr::StructLiteral(entry_ty, fields)
}

fn hashmap_increment_len() -> Stmt {
    Stmt::FieldAssign(
        Expr::Var("m"),
        "len",
        Expr::Binary(
            BinaryOp::Add,
            Expr::Field(Expr::Var("m"), "len"),
            Expr::Int("1"),
        ),
    )
}

fn hashmap_set_item(key: tast::Type, value: tast::Type) -> Item {
    let map_ty = tast::Type::HashMap(key, value);
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named(go_generated_ident(hashmap_name(key, value) + "_entry"));
    let bucket_ty = Type::Slice(entry_ty);
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    params.push(("value", lowered_value));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var(
        "reuse_index",
        Type::Int32,
        Option::Some(Expr::Int("-1")),
    ));
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
    stmts.push(Stmt::If(
        Expr::Binary(BinaryOp::Eq, Expr::Var("m"), Expr::Nil),
        Block { stmts: nil_stmts },
        Option::None,
    ));
    let hash_args: Vec[Expr] = Vec::new();
    hash_args.push(Expr::Var("key"));
    stmts.push(Stmt::Var(
        "h",
        Type::Uint64,
        Option::Some(Expr::Call(
            Expr::Var(hashmap_trait_impl_name("Hash", key, "hash")),
            hash_args,
        )),
    ));
    stmts.push(Stmt::Var(
        "bucket",
        bucket_ty,
        Option::Some(Expr::Index(
            Expr::Field(Expr::Var("m"), "buckets"),
            Expr::Var("h"),
        )),
    ));
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var("bucket"));
    let empty_stmts: Vec[Stmt] = Vec::new();
    let append_hash_args: Vec[Expr] = Vec::new();
    append_hash_args.push(Expr::Field(Expr::Var("m"), "hashes"));
    append_hash_args.push(Expr::Var("h"));
    empty_stmts.push(Stmt::FieldAssign(
        Expr::Var("m"),
        "hashes",
        Expr::Call(Expr::Var("append"), append_hash_args),
    ));
    stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::Eq,
            Expr::Call(Expr::Var("len"), len_args),
            Expr::Int("0"),
        ),
        Block { stmts: empty_stmts },
        Option::None,
    ));
    stmts.push(Stmt::Var(
        "i",
        Type::Int32,
        Option::Some(Expr::Int("0")),
    ));
    let loop_stmts: Vec[Stmt] = Vec::new();
    let loop_len_args: Vec[Expr] = Vec::new();
    loop_len_args.push(Expr::Var("bucket"));
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::GreaterEq,
            Expr::Var("i"),
            Expr::Convert(
                Type::Int32,
                Expr::Call(Expr::Var("len"), loop_len_args),
            ),
        ),
        Block { stmts: break_stmts },
        Option::None,
    ));
    loop_stmts.push(Stmt::Var(
        "entry",
        entry_ty,
        Option::Some(Expr::Index(
            Expr::Var("bucket"),
            Expr::Var("i"),
        )),
    ));
    let eq_args: Vec[Expr] = Vec::new();
    eq_args.push(Expr::Field(Expr::Var("entry"), "key"));
    eq_args.push(Expr::Var("key"));
    let update_stmts: Vec[Stmt] = Vec::new();
    update_stmts.push(Stmt::FieldAssign(
        Expr::Index(Expr::Var("bucket"), Expr::Var("i")),
        "value",
        Expr::Var("value"),
    ));
    update_stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
    loop_stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::And,
            Expr::Field(Expr::Var("entry"), "active"),
            Expr::Call(
                Expr::Var(hashmap_trait_impl_name("Eq", key, "eq")),
                eq_args,
            ),
        ),
        Block { stmts: update_stmts },
        Option::None,
    ));
    let reuse_stmts: Vec[Stmt] = Vec::new();
    reuse_stmts.push(Stmt::Assign("reuse_index", Expr::Var("i")));
    loop_stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::And,
            Expr::Unary(
                UnaryOp::Not,
                Expr::Field(Expr::Var("entry"), "active"),
            ),
            Expr::Binary(
                BinaryOp::Less,
                Expr::Var("reuse_index"),
                Expr::Int("0"),
            ),
        ),
        Block { stmts: reuse_stmts },
        Option::None,
    ));
    loop_stmts.push(Stmt::Assign(
        "i",
        Expr::Binary(BinaryOp::Add, Expr::Var("i"), Expr::Int("1")),
    ));
    stmts.push(Stmt::Loop(Block { stmts: loop_stmts }));
    let replace_stmts: Vec[Stmt] = Vec::new();
    replace_stmts.push(Stmt::IndexAssign(
        Expr::Var("bucket"),
        Expr::Var("reuse_index"),
        hashmap_entry_expr(entry_ty),
    ));
    replace_stmts.push(hashmap_increment_len());
    replace_stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
    stmts.push(Stmt::If(
        Expr::Binary(
            BinaryOp::GreaterEq,
            Expr::Var("reuse_index"),
            Expr::Int("0"),
        ),
        Block { stmts: replace_stmts },
        Option::None,
    ));
    let append_entry_args: Vec[Expr] = Vec::new();
    append_entry_args.push(Expr::Var("bucket"));
    append_entry_args.push(hashmap_entry_expr(entry_ty));
    stmts.push(Stmt::Assign(
        "bucket",
        Expr::Call(Expr::Var("append"), append_entry_args),
    ));
    stmts.push(Stmt::IndexAssign(
        Expr::Field(Expr::Var("m"), "buckets"),
        Expr::Var("h"),
        Expr::Var("bucket"),
    ));
    stmts.push(hashmap_increment_len());
    stmts.push(Stmt::Return(Option::Some(Expr::Unit)));
    Item::Function(Function {
        name: runtime_helper_name("hashmap_set", map_ty),
        params,
        ret_ty: Option::Some(Type::Unit),
        body: Block { stmts },
    })
}

fn hashmap_items(
    key: tast::Type,
    value: tast::Type,
    instances: Vec[core::TypeInstance],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    function_names: Vec[(string, string)],
    include_option: bool,
) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let name = hashmap_name(key, value);
    let entry_name = go_generated_ident(name + "_entry");
    let entry_fields: Vec[(string, Type)] = Vec::new();
    entry_fields.push(("active", Type::Bool));
    entry_fields.push(("key", lower_type(key)));
    entry_fields.push(("value", lower_type(value)));
    result.push(Item::Struct(StructDef { name: entry_name, fields: entry_fields }));
    let fields: Vec[(string, Type)] = Vec::new();
    fields.push((
        "buckets",
        Type::Map(Type::Uint64, Type::Slice(Type::Named(entry_name))),
    ));
    fields.push(("hashes", Type::Slice(Type::Uint64)));
    fields.push(("len", Type::Int32));
    result.push(Item::Struct(StructDef { name, fields }));
    let option = hashmap_option_info(
        value,
        instances,
        enums,
        structs,
        function_names,
    );
    if include_option && option.3 {
        for item in synthetic_option_items(value) {
            result.push(item)
        }
    } else {
        ()
    };
    result.push(hashmap_lookup_item(key, value));
    result.push(hashmap_get_item(key, value, option.0, option.1, option.2));
    result.push(hashmap_set_item(key, value));
    result
}

fn option_available(instances: Vec[core::TypeInstance], value: tast::Type) -> bool {
    let args: Vec[tast::Type] = Vec::new();
    args.push(value);
    match find_instance(instances, "Option", args) {
        Option::Some(_) => true,
        Option::None => false,
    }
}

fn dyn_vtable_name(trait_name: string) -> string {
    go_generated_ident("dyn__" + trait_name + "_vtable")
}

fn dyn_object_name(trait_name: string) -> string {
    go_dyn_struct_name(trait_name)
}

fn raw_dyn_wrapper_name(trait_name: string, for_ty: tast::Type, method: string) -> string {
    go_generated_ident(
        "dyn__" + trait_name + "__wrap__" + encode_type(for_ty) + "__" + method,
    )
}

fn dyn_wrapper_name(
    names: DynHelperNames,
    trait_name: string,
    for_ty: tast::Type,
    method: string,
) -> string {
    let key = compact_type(for_ty);
    let result = Ref::new(raw_dyn_wrapper_name(trait_name, for_ty, method));
    for entry in names.wrappers {
        if entry.0 == trait_name && entry.1 == key && entry.2 == method {
            result.set(entry.3)
        } else {
            ()
        }
    };
    result.get()
}

fn raw_dyn_factory_name(trait_name: string, for_ty: tast::Type) -> string {
    go_generated_ident("dyn__" + trait_name + "__vtable__" + encode_type(for_ty))
}

pub fn dyn_factory_name(
    names: DynHelperNames,
    trait_name: string,
    for_ty: tast::Type,
) -> string {
    let key = compact_type(for_ty);
    let result = Ref::new(raw_dyn_factory_name(trait_name, for_ty));
    for entry in names.factories {
        if entry.0 == trait_name && entry.1 == key {
            result.set(entry.2)
        } else {
            ()
        }
    };
    result.get()
}

fn hash_segments(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let start = Ref::new(0);
    for index in range(0, value.byte_len()) {
        if value.byte_slice(index, index + 1) == "#" {
            result.push(value.byte_slice(start.get(), index));
            start.set(index + 1)
        } else {
            ()
        }
    };
    result.push(value.byte_slice(start.get(), value.byte_len()));
    result
}

fn trait_impl_method_name(value: string) -> Option[string] {
    let segments = hash_segments(value);
    if segments.len() == 4 && segments.get(0) == "trait_impl" {
        Option::Some(segments.get(3))
    } else {
        Option::None
    }
}

fn contains_method(values: Vec[DynMethod], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.name == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn dyn_methods(functions: Vec[anf::Function], trait_name: string) -> Vec[DynMethod] {
    let result: Vec[DynMethod] = Vec::new();
    for function in functions {
        match (function.trait_impl, trait_impl_method_name(function.name)) {
            (Option::Some(metadata), Option::Some(method_name)) => {
                if metadata.trait_ref.name == trait_name
                    && contains_method(result, method_name) == false
                {
                    let params: Vec[tast::Type] = Vec::new();
                    for index in range(1, function.params.len()) {
                        params.push(function.params.get(index).1)
                    };
                    result.push(DynMethod {
                        name: method_name,
                        params,
                        ret_ty: function.ret_ty,
                    })
                } else {
                    ()
                }
            },
            _ => (),
        }
    };
    if trait_name == "Hash" && contains_method(result, "hash") == false {
        result.push(DynMethod {
            name: "hash",
            params: Vec::new(),
            ret_ty: tast::Type::Uint64,
        })
    } else if trait_name == "ToString"
        && contains_method(result, "to_string") == false
    {
        result.push(DynMethod {
            name: "to_string",
            params: Vec::new(),
            ret_ty: tast::Type::String,
        })
    } else {
        ()
    };
    result
}

fn dyn_factory_name_count(coercions: Vec[DynCoercion], expected: string) -> int32 {
    let count = Ref::new(0);
    for coercion in coercions {
        if raw_dyn_factory_name(coercion.trait_name, coercion.for_ty) == expected {
            count.set(count.get() + 1)
        } else {
            ()
        }
    };
    count.get()
}

fn dyn_wrapper_name_count(
    coercions: Vec[DynCoercion],
    functions: Vec[anf::Function],
    expected: string,
) -> int32 {
    let count = Ref::new(0);
    for coercion in coercions {
        for method in dyn_methods(functions, coercion.trait_name) {
            if raw_dyn_wrapper_name(
                coercion.trait_name,
                coercion.for_ty,
                method.name,
            ) == expected
            {
                count.set(count.get() + 1)
            } else {
                ()
            }
        }
    };
    count.get()
}

pub fn build_dyn_helper_names(
    coercions: Vec[DynCoercion],
    functions: Vec[anf::Function],
) -> DynHelperNames {
    let factories: Vec[(string, string, string)] = Vec::new();
    let wrappers: Vec[(string, string, string, string)] = Vec::new();
    for coercion in coercions {
        let key = compact_type(coercion.for_ty);
        let raw_factory = raw_dyn_factory_name(coercion.trait_name, coercion.for_ty);
        if dyn_factory_name_count(coercions, raw_factory) > 1 {
            factories.push((
                coercion.trait_name,
                key,
                go_hashed_ident(
                    "fn",
                    "dyn_vtable#" + coercion.trait_name + "#" + key,
                ),
            ))
        } else {
            ()
        };
        for method in dyn_methods(functions, coercion.trait_name) {
            let raw_wrapper = raw_dyn_wrapper_name(
                coercion.trait_name,
                coercion.for_ty,
                method.name,
            );
            if dyn_wrapper_name_count(coercions, functions, raw_wrapper) > 1 {
                wrappers.push((
                    coercion.trait_name,
                    key,
                    method.name,
                    go_hashed_ident(
                        "fn",
                        "dyn_wrap#"
                            + coercion.trait_name
                            + "#"
                            + key
                            + "#"
                            + method.name,
                    ),
                ))
            } else {
                ()
            }
        }
    };
    DynHelperNames { factories, wrappers }
}

fn dyn_type_items(trait_name: string, methods: Vec[DynMethod]) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let fields: Vec[(string, Type)] = Vec::new();
    for method in methods {
        let params: Vec[Type] = Vec::new();
        params.push(Type::Any);
        for param in method.params {
            params.push(lower_type(param))
        };
        fields.push((go_ident(method.name), Type::Func(params, lower_type(method.ret_ty))))
    };
    result.push(Item::Struct(StructDef { name: dyn_vtable_name(trait_name), fields }));
    let object_fields: Vec[(string, Type)] = Vec::new();
    object_fields.push(("data", Type::Any));
    object_fields.push((
        "vtable",
        Type::Pointer(Type::Named(dyn_vtable_name(trait_name))),
    ));
    result.push(Item::Struct(StructDef { name: dyn_object_name(trait_name), fields: object_fields }));
    result
}

fn find_dyn_impl_name(
    functions: Vec[anf::Function],
    trait_name: string,
    for_ty: tast::Type,
    method_name: string,
) -> string {
    let result: Ref[Option[string]] = Ref::new(Option::None);
    for function in functions {
        match (function.trait_impl, trait_impl_method_name(function.name)) {
            (Option::Some(metadata), Option::Some(candidate_method)) => {
                if metadata.trait_ref.name == trait_name
                    && encode_type(metadata.for_ty) == encode_type(for_ty)
                    && candidate_method == method_name
                {
                    result.set(Option::Some(go_ident(function.name)))
                } else {
                    ()
                }
            },
            _ => (),
        }
    };
    match result.get() {
        Option::Some(name) => name,
        Option::None => go_ident(
            "trait_impl#" + trait_name + "#" + compact_type(for_ty) + "#" + method_name,
        ),
    }
}

fn runtime_string_precedes(left: string, right: string) -> bool {
    let length = if left.byte_len() < right.byte_len() {
        left.byte_len()
    } else {
        right.byte_len()
    };
    let index = Ref::new(0);
    while index.get() < length
        && left.byte_get(index.get()) == right.byte_get(index.get())
    {
        index.set(index.get() + 1)
    };
    if index.get() == length {
        left.byte_len() < right.byte_len()
    } else {
        left.byte_get(index.get()) < right.byte_get(index.get())
    }
}

fn dyn_coercion_precedes(left: DynCoercion, right: DynCoercion) -> bool {
    if left.trait_name == right.trait_name {
        runtime_string_precedes(encode_type(left.for_ty), encode_type(right.for_ty))
    } else {
        runtime_string_precedes(left.trait_name, right.trait_name)
    }
}

fn sorted_dyn_coercions(values: Vec[DynCoercion]) -> Vec[DynCoercion] {
    let result = Vec::new();
    for value in values {
        let index = Ref::new(0);
        while index.get() < result.len()
            && !dyn_coercion_precedes(value, result.get(index.get()))
        {
            index.set(index.get() + 1)
        };
        result.insert(index.get(), value)
    };
    result
}

fn dyn_coercion_items(
    functions: Vec[anf::Function],
    coercion: DynCoercion,
    methods: Vec[DynMethod],
    names: DynHelperNames,
) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    for method in methods {
        let wrapper = dyn_wrapper_name(
            names,
            coercion.trait_name,
            coercion.for_ty,
            method.name,
        );
        let wrapper_params: Vec[(string, Type)] = Vec::new();
        wrapper_params.push(("self", Type::Any));
        let wrapper_args: Vec[Expr] = Vec::new();
        wrapper_args.push(Expr::Cast(Expr::Var("self"), lower_type(coercion.for_ty)));
        for index in range(0, method.params.len()) {
            let name = "p" + index.to_string();
            wrapper_params.push((name, lower_type(method.params.get(index))));
            wrapper_args.push(Expr::Var(name))
        };
        let wrapper_stmts: Vec[Stmt] = Vec::new();
        wrapper_stmts.push(Stmt::Return(Option::Some(Expr::Call(
            Expr::Var(find_dyn_impl_name(
                functions,
                coercion.trait_name,
                coercion.for_ty,
                method.name,
            )),
            wrapper_args,
        ))));
        result.push(Item::Function(Function {
            name: wrapper,
            params: wrapper_params,
            ret_ty: Option::Some(lower_type(method.ret_ty)),
            body: Block { stmts: wrapper_stmts },
        }))
    };
    let factory_stmts: Vec[Stmt] = Vec::new();
    let factory_fields: Vec[(string, Expr)] = Vec::new();
    for method in methods {
        factory_fields.push((
            go_ident(method.name),
            Expr::Var(dyn_wrapper_name(
                names,
                coercion.trait_name,
                coercion.for_ty,
                method.name,
            )),
        ))
    };
    factory_stmts.push(Stmt::Return(Option::Some(Expr::Unary(
        UnaryOp::Address,
        Expr::StructLiteral(Type::Named(dyn_vtable_name(coercion.trait_name)), factory_fields),
    ))));
    result.push(Item::Function(Function {
        name: dyn_factory_name(names, coercion.trait_name, coercion.for_ty),
        params: Vec::new(),
        ret_ty: Option::Some(Type::Pointer(Type::Named(dyn_vtable_name(coercion.trait_name)))),
        body: Block { stmts: factory_stmts },
    }));
    result
}

fn contains_text(values: Vec[string], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

pub fn emit_builtin_runtime_items(
    items: Vec[Item],
    types: Vec[tast::Type],
    instances: Vec[core::TypeInstance],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    function_names: Vec[(string, string)],
) -> unit {
    for ty in types {
        match tast::resolve_type(ty) {
            tast::Type::Array(_, _) => {
                for item in array_runtime_items(ty) {
                    items.push(item)
                }
            },
            _ => (),
        }
    };
    for ty in types {
        match tast::resolve_type(ty) {
            tast::Type::VecType(_) => {
                items.push(Item::Struct(runtime_struct(ty)));
                for item in vec_runtime_items(ty) {
                    items.push(item)
                }
            },
            _ => (),
        }
    };
    for ty in types {
        match tast::resolve_type(ty) {
            tast::Type::RefType(_) => {
                items.push(Item::Struct(runtime_struct(ty)));
                for item in ref_runtime_items(ty) {
                    items.push(item)
                }
            },
            _ => (),
        }
    };
    let options: Vec[string] = Vec::new();
    for ty in types {
        match tast::resolve_type(ty) {
            tast::Type::HashMap(key, value) => {
                let option = synthetic_option_base(value);
                let include_option = contains_text(options, option) == false
                    && option_available(instances, value) == false;
                for item in hashmap_items(
                    key,
                    value,
                    instances,
                    enums,
                    structs,
                    function_names,
                    include_option,
                ) {
                    items.push(item)
                };
                if include_option {
                    options.push(option)
                } else {
                    ()
                }
            },
            _ => (),
        }
    };
    for ty in types {
        match tast::resolve_type(ty) {
            tast::Type::Tuple(_) => items.push(Item::Struct(runtime_struct(ty))),
            _ => (),
        }
    };
}

pub fn emit_dyn_runtime_items(
    items: Vec[Item],
    types: Vec[tast::Type],
    coercions: Vec[DynCoercion],
    functions: Vec[anf::Function],
    names: DynHelperNames,
) -> unit {
    let dyn_traits: Vec[string] = Vec::new();
    for ty in types {
        match tast::resolve_type(ty) {
            tast::Type::Dyn(name) => {
                if contains_text(dyn_traits, name) == false {
                    for item in dyn_type_items(name, dyn_methods(functions, name)) {
                        items.push(item)
                    };
                    dyn_traits.push(name)
                } else {
                    ()
                }
            },
            _ => (),
        }
    };
    for coercion in sorted_dyn_coercions(coercions) {
        for item in dyn_coercion_items(
            functions,
            coercion,
            dyn_methods(functions, coercion.trait_name),
            names,
        ) {
            items.push(item)
        }
    }
}
