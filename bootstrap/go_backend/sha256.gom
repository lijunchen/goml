fn rotate_right(value: uint32, count: uint32) -> uint32 {
    (value >> count) | (value << (32u32 - count))
}

fn padded_byte(
    value: string,
    index: int32,
    padded_len: int32,
    bit_len: uint64,
) -> uint8 {
    if index < value.byte_len() {
        value.byte_get(index)
    } else if index == value.byte_len() {
        128u8
    } else if index >= padded_len - 8 {
        let shift = ((padded_len - 1 - index) * 8) as uint64;
        ((bit_len >> shift) & 255u64) as uint8
    } else {
        0u8
    }
}

fn message_word(
    value: string,
    offset: int32,
    padded_len: int32,
    bit_len: uint64,
) -> uint32 {
    ((padded_byte(value, offset, padded_len, bit_len) as uint32) << 24u32)
        | ((padded_byte(value, offset + 1, padded_len, bit_len) as uint32) << 16u32)
        | ((padded_byte(value, offset + 2, padded_len, bit_len) as uint32) << 8u32)
        | (padded_byte(value, offset + 3, padded_len, bit_len) as uint32)
}

fn write_hex_word(builder: text::StringBuilder, value: uint32) -> unit {
    let digits = "0123456789abcdef";
    for index in range(0, 8) {
        let shift = ((7 - index) * 4) as uint32;
        builder.write_char(digits.get(((value >> shift) & 15u32) as int32))
    }
}

pub fn sha256_hex(value: string) -> string {
    let constants = sha256_constants();
    let padded_len = Ref::new(value.byte_len() + 9);
    while padded_len.get() % 64 != 0 {
        padded_len.set(padded_len.get() + 1)
    };
    let bit_len = (value.byte_len() as uint64) * 8u64;
    let h0 = Ref::new(1779033703u32);
    let h1 = Ref::new(3144134277u32);
    let h2 = Ref::new(1013904242u32);
    let h3 = Ref::new(2773480762u32);
    let h4 = Ref::new(1359893119u32);
    let h5 = Ref::new(2600822924u32);
    let h6 = Ref::new(528734635u32);
    let h7 = Ref::new(1541459225u32);
    for chunk in range(0, padded_len.get() / 64) {
        let words: Vec[uint32] = Vec::new();
        for index in range(0, 16) {
            words.push(message_word(
                value,
                chunk * 64 + index * 4,
                padded_len.get(),
                bit_len,
            ))
        };
        for index in range(16, 64) {
            let first = words.get(index - 15);
            let second = words.get(index - 2);
            let sigma0 = rotate_right(first, 7u32)
                ^ rotate_right(first, 18u32)
                ^ (first >> 3u32);
            let sigma1 = rotate_right(second, 17u32)
                ^ rotate_right(second, 19u32)
                ^ (second >> 10u32);
            words.push(
                words.get(index - 16) + sigma0 + words.get(index - 7) + sigma1,
            )
        };
        let a = Ref::new(h0.get());
        let b = Ref::new(h1.get());
        let c = Ref::new(h2.get());
        let d = Ref::new(h3.get());
        let e = Ref::new(h4.get());
        let f = Ref::new(h5.get());
        let g = Ref::new(h6.get());
        let h = Ref::new(h7.get());
        for index in range(0, 64) {
            let sigma1 = rotate_right(e.get(), 6u32)
                ^ rotate_right(e.get(), 11u32)
                ^ rotate_right(e.get(), 25u32);
            let choice = (e.get() & f.get()) ^ (~(e.get()) & g.get());
            let temp1 = h.get()
                + sigma1
                + choice
                + array_get(constants, index)
                + words.get(index);
            let sigma0 = rotate_right(a.get(), 2u32)
                ^ rotate_right(a.get(), 13u32)
                ^ rotate_right(a.get(), 22u32);
            let majority = (a.get() & b.get())
                ^ (a.get() & c.get())
                ^ (b.get() & c.get());
            let temp2 = sigma0 + majority;
            h.set(g.get());
            g.set(f.get());
            f.set(e.get());
            e.set(d.get() + temp1);
            d.set(c.get());
            c.set(b.get());
            b.set(a.get());
            a.set(temp1 + temp2)
        };
        h0.set(h0.get() + a.get());
        h1.set(h1.get() + b.get());
        h2.set(h2.get() + c.get());
        h3.set(h3.get() + d.get());
        h4.set(h4.get() + e.get());
        h5.set(h5.get() + f.get());
        h6.set(h6.get() + g.get());
        h7.set(h7.get() + h.get())
    };
    let builder = text::StringBuilder::new();
    write_hex_word(builder, h0.get());
    write_hex_word(builder, h1.get());
    write_hex_word(builder, h2.get());
    write_hex_word(builder, h3.get());
    write_hex_word(builder, h4.get());
    write_hex_word(builder, h5.get());
    write_hex_word(builder, h6.get());
    write_hex_word(builder, h7.get());
    builder.finish()
}

pub fn sha256_prefix(value: string) -> string {
    sha256_hex(value).byte_slice(0, 32)
}
