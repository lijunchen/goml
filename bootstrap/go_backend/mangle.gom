package go_backend;

use std::text;

fn has_prefix(value: string, prefix: string) -> bool {
    value.byte_len() >= prefix.byte_len()
        && value.byte_slice(0, prefix.byte_len()) == prefix
}

fn is_ascii_letter(value: char) -> bool {
    (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z')
}

fn is_ascii_digit(value: char) -> bool {
    value >= '0' && value <= '9'
}

fn is_valid_ident(value: string) -> bool {
    if value.len() == 0 {
        false
    } else {
        let first = value.get(0);
        let valid = Ref::new(is_ascii_letter(first) || first == '_');
        for index in range(1, value.len()) {
            let character = value.get(index);
            if !(is_ascii_letter(character) || is_ascii_digit(character) || character == '_') {
                valid.set(false)
            } else {
                ()
            }
        };
        valid.get()
    }
}

fn is_keyword(value: string) -> bool {
    value == "break"
        || value == "default"
        || value == "func"
        || value == "interface"
        || value == "select"
        || value == "case"
        || value == "defer"
        || value == "go"
        || value == "map"
        || value == "struct"
        || value == "chan"
        || value == "else"
        || value == "goto"
        || value == "package"
        || value == "switch"
        || value == "const"
        || value == "fallthrough"
        || value == "if"
        || value == "range"
        || value == "type"
        || value == "continue"
        || value == "for"
        || value == "import"
        || value == "return"
        || value == "var"
}

fn is_predeclared(value: string) -> bool {
    value == "any"
        || value == "append"
        || value == "cap"
        || value == "clear"
        || value == "close"
        || value == "comparable"
        || value == "complex"
        || value == "copy"
        || value == "delete"
        || value == "error"
        || value == "false"
        || value == "imag"
        || value == "iota"
        || value == "len"
        || value == "make"
        || value == "max"
        || value == "min"
        || value == "new"
        || value == "nil"
        || value == "panic"
        || value == "print"
        || value == "println"
        || value == "real"
        || value == "recover"
        || value == "true"
}

fn is_generated_value(value: string) -> bool {
    has_prefix(value, "_goml_")
        || has_prefix(value, "dyn__")
        || has_prefix(value, "array_get__")
        || has_prefix(value, "array_set__")
        || has_prefix(value, "vec_new__")
        || has_prefix(value, "vec_push__")
        || has_prefix(value, "vec_get__")
        || has_prefix(value, "vec_set__")
        || has_prefix(value, "vec_len__")
        || has_prefix(value, "ref__")
        || has_prefix(value, "ref_get__")
        || has_prefix(value, "ref_set__")
        || has_prefix(value, "ptr_eq__")
        || has_prefix(value, "ptr_hash__")
        || has_prefix(value, "hashmap_new__")
        || has_prefix(value, "hashmap_len__")
        || has_prefix(value, "hashmap_contains__")
        || has_prefix(value, "hashmap_lookup__")
        || has_prefix(value, "hashmap_get__")
        || has_prefix(value, "hashmap_set__")
        || has_prefix(value, "hashmap_remove__")
        || has_prefix(value, "missing__")
}

fn write_encoded_char(builder: text::StringBuilder, value: char) -> unit {
    if is_ascii_letter(value) || is_ascii_digit(value) {
        builder.write_char(value)
    } else if value == '_' {
        builder.write_string("__")
    } else if value == '#' {
        builder.write_string("_i_")
    } else if value == '[' {
        builder.write_string("_l_")
    } else if value == ']' {
        builder.write_string("_r_")
    } else if value == '(' {
        builder.write_string("_o_")
    } else if value == ')' {
        builder.write_string("_q_")
    } else if value == '{' {
        builder.write_string("_b_")
    } else if value == '}' {
        builder.write_string("_e_")
    } else if value == ',' {
        builder.write_string("_c_")
    } else if value == ':' {
        builder.write_string("_k_")
    } else if value == '$' {
        builder.write_string("_d_")
    } else if value == '-' {
        builder.write_string("_m_")
    } else if value == '.' {
        builder.write_string("_t_")
    } else if value == '/' {
        builder.write_string("_f_")
    } else if value == '*' {
        builder.write_string("_a_")
    } else if value == '&' {
        builder.write_string("_n_")
    } else if value == '+' {
        builder.write_string("_u_")
    } else if value == '<' {
        builder.write_string("_v_")
    } else if value == '>' {
        builder.write_string("_z_")
    } else {
        builder.write_string("_x");
        builder.write_string((value as uint32).to_string());
        builder.write_char('_')
    }
}

fn encode_name(value: string) -> string {
    let builder = text::StringBuilder::new();
    let index = Ref::new(0);
    while index.get() < value.len() {
        let character = value.get(index.get());
        if character == ':'
            && index.get() + 1 < value.len()
            && value.get(index.get() + 1) == ':'
        {
            builder.write_string("_p_");
            index.set(index.get() + 2)
        } else {
            write_encoded_char(builder, character);
            index.set(index.get() + 1)
        }
    };
    builder.finish()
}

fn go_ident_impl(value: string, protect_generated: bool) -> string {
    if is_valid_ident(value) && !is_keyword(value) && !is_predeclared(value) {
        if protect_generated && is_generated_value(value) {
            "_goml_user_" + value
        } else {
            value
        }
    } else {
        "_goml_m_" + encode_name(value)
    }
}

pub fn go_ident(value: string) -> string {
    go_ident_impl(value, true)
}

pub fn go_local_ident(value: string) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, value.len()) {
        let character = value.get(index);
        if character == '/' {
            builder.write_string("__")
        } else {
            builder.write_char(character)
        }
    };
    go_ident(builder.finish())
}

pub fn go_generated_ident(value: string) -> string {
    go_ident_impl(value, false)
}

fn generated_type_name(value: string) -> bool {
    has_prefix(value, "Tuple")
        || has_prefix(value, "Array")
        || has_prefix(value, "Slice_")
        || has_prefix(value, "Vec_")
        || has_prefix(value, "Ptr_")
        || has_prefix(value, "HashMap_")
        || has_prefix(value, "TFunc")
}

pub fn go_user_type_name(value: string) -> string {
    let ident = go_ident(value);
    if generated_type_name(ident) || ident == "main" || ident == "init" {
        go_generated_ident("_goml_user_" + ident)
    } else {
        ident
    }
}
