    let needs_root = imports_package(ast_value, "std");
    let needs_fs = needs_root || imports_package(ast_value, "std::fs");
    let needs_io = needs_root || imports_package(ast_value, "std::io");
    let needs_process = needs_root || imports_package(ast_value, "std::process");
    let needs_text = needs_root || imports_package(ast_value, "std::text");
    let needs_bytes = imports_package(ast_value, "std::bytes")
        || needs_root
        || needs_fs
        || needs_io
        || needs_process
        || needs_text;
    let result: Vec[core::File] = Vec::new();
    if needs_bytes {
        result.push(standard.bytes.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::collections") {
        result.push(standard.collections.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::env") {
        result.push(standard.env.core_value)
    } else {
        ()
    };
    if needs_fs {
        result.push(standard.fs.core_value)
    } else {
        ()
    };
    if needs_io {
        result.push(standard.io.core_value)
    } else {
        ()
    };
    if needs_root || imports_package(ast_value, "std::path") {
        result.push(standard.path.core_value)
    } else {
        ()
    };
    if needs_process {
        result.push(standard.process.core_value)
    } else {
        ()
    };
    if imports_package(ast_value, "std::testing") {
        result.push(standard.testing.core_value)
    } else {
        ()
    };
    if needs_text {
        result.push(standard.text.core_value)
    } else {
        ()
    };
    if needs_root {
        result.push(standard.root.core_value)
    } else {
        ()
    };
    result
}

fn hir_diagnostics(
    diagnostics: Vec[hir::Diagnostic],
    source_path: string,
) -> Vec[tast::Diagnostic] {
    let result = Vec::new();
    for diagnostic in diagnostics {
        result.push(tast::Diagnostic {
            severity: tast::DiagnosticSeverity::Error,
            stage: "typer",
            message: diagnostic.message,
            source_path,
            span: diagnostic.span,
            primary_label: Option::None,
            secondary_labels: Vec::new(),
            sort_order: 0,
        })
    };
    result
}

fn fail_on_compilation_diagnostics(
    diagnostics: Vec[hir::Diagnostic],
    source_path: string,
    source: string,
) -> unit {
    if diagnostics.len() > 0 {
        fail(render_typer_diagnostics(
            hir_diagnostics(diagnostics, source_path),
            source_path,
            source,
        ))
    } else {
        ()
    }
}

fn diagnostic_span_start(value: tast::Diagnostic) -> int {
    match value.span {
        Option::Some(span) => span.start,
        Option::None => if value.source_path == "" { 2147483647 } else { 0 },
    }
}

fn diagnostic_span_end(value: tast::Diagnostic) -> int {
    match value.span {
        Option::Some(span) => span.end,
        Option::None => if value.source_path == "" { 2147483647 } else { 0 },
    }
}

fn diagnostic_precedes(left: tast::Diagnostic, right: tast::Diagnostic) -> bool {
    if left.source_path != right.source_path {
        left.source_path < right.source_path
    } else if diagnostic_span_start(left) != diagnostic_span_start(right) {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else if diagnostic_span_end(left) != diagnostic_span_end(right) {
        diagnostic_span_end(left) < diagnostic_span_end(right)
    } else if left.stage != right.stage {
        left.stage < right.stage
    } else {
        left.message < right.message
    }
}

fn sorted_typer_diagnostics(values: Vec[tast::Diagnostic]) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for value in values {
        result.push(value)
    };
    for index in range(1, result.len()) {
        let value = result.get(index);
        let target = Ref::new(index);
        while target.get() > 0
            && diagnostic_precedes(value, result.get(target.get() - 1))
        {
            result.set(target.get(), result.get(target.get() - 1));
            target.set(target.get() - 1)
        };
        result.set(target.get(), value)
    };
    result
}

fn diagnostic_source(
    source_path: string,
    fallback_path: string,
    fallback_source: string,
) -> string {
    if source_path == fallback_path {
        fallback_source
    } else {
        match fs::read_file(source_path) {
            Result::Ok(source) => source,
            Result::Err(_) => "",
        }
    }
}

fn source_position(source: string, offset: int) -> DiagnosticPosition {
    let limit = if offset < 0 {
        0
    } else if offset > source.byte_len() {
        source.byte_len()
    } else {
        offset
    };
    let line = Ref::new(0);
    let column = Ref::new(0);
    let line_start = Ref::new(0);
    for index in range(0, limit) {
        let byte = source.byte_get(index);
        if byte == 10 {
            line.set(line.get() + 1);
            column.set(0);
            line_start.set(index + 1)
        } else if byte < 128 || byte >= 192 {
            column.set(column.get() + 1)
        } else {
            ()
        }
    };
    let line_end = Ref::new(line_start.get());
    let scanning = Ref::new(true);
    while scanning.get() && line_end.get() < source.byte_len() {
        let byte = source.byte_get(line_end.get());
        if byte == 10 || byte == 13 {
            scanning.set(false)
        } else {
            line_end.set(line_end.get() + 1)
        }
    };
    DiagnosticPosition {
        line: line.get(),
        column: column.get(),
        line_start: line_start.get(),
        line_end: line_end.get(),
    }
}

fn repeat_char(value: char, count: int) -> string {
    let builder = text::StringBuilder::new();
    for _ in range(0, count) {
        builder.write_char(value)
    };
    builder.finish()
}

fn diagnostic_visual_width(value: string) -> int {
    let width = Ref::new(0);
    for index in range(0, value.len()) {
        if value.get(index) == '\t' {
            width.set(width.get() + 4 - width.get() % 4)
        } else {
            width.set(width.get() + 1)
        }
    };
    width.get()
}

fn expand_diagnostic_tabs(value: string) -> string {
    let builder = text::StringBuilder::new();
    let width = Ref::new(0);
    for index in range(0, value.len()) {
        let ch = value.get(index);
        if ch == '\t' {
            let spaces = 4 - width.get() % 4;
            builder.write_string(repeat_char(' ', spaces));
            width.set(width.get() + spaces)
        } else {
            builder.write_char(ch);
            width.set(width.get() + 1)
        }
    };
    builder.finish()
}

fn render_diagnostic_label(
    builder: text::StringBuilder,
    kind: string,
    source_path: string,
    span: ast::Span,
    message: Option[string],
    fallback_path: string,
    fallback_source: string,
) -> unit {
    let source = diagnostic_source(source_path, fallback_path, fallback_source);
    builder.write_char('\n');
    builder.write_string(kind);
    builder.write_string(": ");
    builder.write_string(source_path);
    builder.write_char(':');
    if source.byte_len() == 0 {
        builder.write_string(span.start.to_string());
        builder.write_string("..");
        builder.write_string(span.end.to_string());
        match message {
            Option::Some(value) => {
                builder.write_string(": ");
                builder.write_string(value)
            },
            Option::None => (),
        }
    } else {
        let start = source_position(source, span.start);
        let end = source_position(source, span.end);
        builder.write_string((start.line + 1).to_string());
        builder.write_char(':');
        builder.write_string((start.column + 1).to_string());
        if span.start != span.end {
            builder.write_char('-');
            builder.write_string((end.line + 1).to_string());
            builder.write_char(':');
            builder.write_string((end.column + 1).to_string())
        } else {
            ()
        };
        match message {
            Option::Some(value) => {
                builder.write_string(": ");
                builder.write_string(value)
            },
            Option::None => (),
        };
        let line_number = (start.line + 1).to_string();
        let gutter = line_number.len();
        let line_text = source.byte_slice(start.line_start, start.line_end);
        let highlight_start = if span.start < start.line_start {
            start.line_start
        } else if span.start > start.line_end {
            start.line_end
        } else {
            span.start
        };
        let highlight_end = if span.end < highlight_start {
            highlight_start
        } else if span.end > start.line_end {
            start.line_end
        } else {
            span.end
        };
        let indentation = diagnostic_visual_width(
            source.byte_slice(start.line_start, highlight_start),
        );
        let measured = diagnostic_visual_width(
            source.byte_slice(highlight_start, highlight_end),
        );
        let marker_width = if measured > 0 { measured } else { 1 };
        builder.write_char('\n');
        builder.write_string(line_number);
        builder.write_string(" | ");
        builder.write_string(expand_diagnostic_tabs(line_text));
        builder.write_char('\n');
        builder.write_string(repeat_char(' ', gutter));
        builder.write_string(" | ");
        builder.write_string(repeat_char(' ', indentation));
        builder.write_string(repeat_char('^', marker_width))
    }
}

fn render_typer_diagnostic(
    value: tast::Diagnostic,
    fallback_path: string,
    fallback_source: string,
) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(match value.severity {
        tast::DiagnosticSeverity::Error => "error[",
        tast::DiagnosticSeverity::Warning => "warning[",
    });
    builder.write_string(value.stage);
    builder.write_string("]: ");
    builder.write_string(value.message);
    match value.span {
        Option::Some(span) => render_diagnostic_label(
            builder,
            "primary",
            value.source_path,
            span,
            value.primary_label,
            fallback_path,
            fallback_source,
        ),
        Option::None => if value.source_path != "" {
            builder.write_string("\nat: ");
            builder.write_string(value.source_path)
        } else {
            ()
        },
    };
    for label in value.secondary_labels {
        render_diagnostic_label(
            builder,
            "secondary",
            label.source_path,
            label.span,
            Option::Some(label.message),
            fallback_path,
            fallback_source,
        )
    };
    builder.finish()
}

fn render_typer_diagnostics(
    values: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> string {
    let builder = text::StringBuilder::new();
    let index = Ref::new(0);
    for value in sorted_typer_diagnostics(values) {
        if index.get() > 0 {
            builder.write_string("\n\n")
        } else {
            ()
        };
        builder.write_string(render_typer_diagnostic(
            value,
            fallback_path,
            fallback_source,
        ));
        index.set(index.get() + 1)
    };
    builder.finish()
}

fn fail_on_typer_diagnostics(
    diagnostics: Vec[tast::Diagnostic],
    fallback_path: string,
    fallback_source: string,
) -> unit {
    let has_error = Ref::new(false);
    for diagnostic in diagnostics {
        match diagnostic.severity {
            tast::DiagnosticSeverity::Error => has_error.set(true),
            tast::DiagnosticSeverity::Warning => (),
        }
    };
    if has_error.get() {
        fail(render_typer_diagnostics(
            diagnostics,
            fallback_path,
            fallback_source,
        ))
    } else if diagnostics.len() > 0 {
        io::eprintln(render_typer_diagnostics(
            diagnostics,
            fallback_path,
            fallback_source,
        ))
    } else {
        ()
    }
}

fn ast_diagnostics(
    diagnostics: Vec[cst::Diagnostic],
    stage: string,
    source_path: string,
) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for diagnostic in diagnostics {
        result.push(tast::Diagnostic {
            severity: tast::DiagnosticSeverity::Error,
            stage,
            message: diagnostic.message,
            source_path,
            span: Option::Some(ast::Span {
                start: diagnostic.start,
                end: diagnostic.end,
            }),
            primary_label: Option::None,
            secondary_labels: Vec::new(),
            sort_order: 0,
        })
    };
    result
}

fn fail_on_ast_diagnostics(
    diagnostics: Vec[cst::Diagnostic],
    stage: string,
    source_path: string,
    source: string,
) -> unit {
    if diagnostics.len() > 0 {
        fail(render_typer_diagnostics(
            ast_diagnostics(diagnostics, stage, source_path),
            source_path,
            source,
        ))
    } else {
        ()
    }
}

fn compact_diagnostic_line(
    builder: text::StringBuilder,
    message: string,
    span: Option[ast::Span],
    source: string,
) -> unit {
    match span {
        Option::Some(value) => {
            let position = source_position(source, value.start);
            builder.write_string((position.line + 1).to_string());
            builder.write_char(':');
            builder.write_string((position.column + 1).to_string());
            builder.write_string(": ")
        },
        Option::None => (),
    };
    builder.write_string(message);
    builder.write_char('\n')
}

fn compact_ast_diagnostics(
    diagnostics: Vec[cst::Diagnostic],
    source: string,
    with_locations: bool,
) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            if with_locations {
                Option::Some(ast::Span {
                    start: diagnostic.start,
                    end: diagnostic.end,
                })
            } else {
                Option::None
            },
            source,
        )
    };
    builder.finish()
}

fn compact_messages(diagnostics: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(builder, diagnostic, Option::None, "")
    };
    builder.finish()
}

fn compact_hir_diagnostics(
    diagnostics: Vec[hir::Diagnostic],
    source: string,
) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in diagnostics {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            diagnostic.span,
            source,
        )
    };
    builder.finish()
}

fn diagnostic_message_starts_with(value: string, prefix: string) -> bool {
    value.byte_len() >= prefix.byte_len()
        && value.byte_slice(0, prefix.byte_len()) == prefix
}

fn compact_diagnostic_phase(value: tast::Diagnostic) -> int {
    if value.message == "Could not infer type" {
        4
    } else if diagnostic_message_starts_with(value.message, "Could not infer the ") {
        if diagnostic_message_starts_with(
            value.message,
            "Could not infer the type required to prove",
        ) {
            2
        } else {
            3
        }
    } else if diagnostic_message_starts_with(value.message, "No instance found for trait ") {
        2
    } else if diagnostic_message_starts_with(value.message, "Struct ")
        && artifact_string_contains(value.message, " type arguments, but got ")
    {
        1
    } else {
        0
    }
}

fn specialized_inference_priority(value: string) -> int {
    if diagnostic_message_starts_with(value, "Could not infer the base type") {
        0
    } else if diagnostic_message_starts_with(value, "Could not infer the operand type") {
        1
    } else {
        2
    }
}

fn compact_diagnostic_precedes(
    left: tast::Diagnostic,
    right: tast::Diagnostic,
) -> bool {
    let left_phase = compact_diagnostic_phase(left);
    let right_phase = compact_diagnostic_phase(right);
    if left_phase != right_phase {
        left_phase < right_phase
    } else if diagnostic_message_starts_with(
        left.message,
        "extern ",
    ) && diagnostic_message_starts_with(right.message, "Internal error: ") {
        true
    } else if left_phase == 0
        && diagnostic_message_starts_with(left.message, "Unknown type constructor ")
        && diagnostic_message_starts_with(right.message, "Unknown type constructor ")
    {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else if left_phase == 2
        && diagnostic_message_starts_with(left.message, "No instance found for trait ")
        && diagnostic_message_starts_with(right.message, "No instance found for trait ")
        && diagnostic_span_start(left) == diagnostic_span_start(right)
    {
        left.message > right.message
    } else if left_phase == 3 {
        specialized_inference_priority(left.message)
            < specialized_inference_priority(right.message)
    } else if left_phase == 4
        && left.sort_order != right.sort_order
        && (left.sort_order > 0 || right.sort_order > 0)
    {
        left.sort_order < right.sort_order
    } else if left_phase == 4 {
        diagnostic_span_start(left) < diagnostic_span_start(right)
    } else {
        false
    }
}

fn compact_sorted_diagnostics(values: Vec[tast::Diagnostic]) -> Vec[tast::Diagnostic] {
    let result: Vec[tast::Diagnostic] = Vec::new();
    for value in values {
        match value.severity {
            tast::DiagnosticSeverity::Error => result.push(value),
            tast::DiagnosticSeverity::Warning => (),
        }
    };
    for index in range(1, result.len()) {
        let value = result.get(index);
        let target = Ref::new(index);
        while target.get() > 0
            && compact_diagnostic_precedes(value, result.get(target.get() - 1))
        {
            result.set(target.get(), result.get(target.get() - 1));
            target.set(target.get() - 1)
        };
        result.set(target.get(), value)
    };
    result
}

fn typer_diagnostics_have_errors(diagnostics: Vec[tast::Diagnostic]) -> bool {
    let result = Ref::new(false);
    for diagnostic in diagnostics {
        match diagnostic.severity {
            tast::DiagnosticSeverity::Error => result.set(true),
            tast::DiagnosticSeverity::Warning => (),
        }
    };
    result.get()
}

fn compact_typer_diagnostics(
    diagnostics: Vec[tast::Diagnostic],
    source_path: string,
    source: string,
) -> string {
    let builder = text::StringBuilder::new();
    for diagnostic in compact_sorted_diagnostics(diagnostics) {
        compact_diagnostic_line(
            builder,
            diagnostic.message,
            diagnostic.span,
            diagnostic_source(diagnostic.source_path, source_path, source),
        )
    };
    builder.finish()
}

pub fn diagnostic_output(source_path: string, source: string) -> string {
    let parsed = parser::parse(source);
    if parsed.diagnostics.len() > 0 {
        return compact_ast_diagnostics(parsed.diagnostics, source, true)
    } else {
        ()
    };
    let ast_value = ast::lower(parsed);
    if ast_value.diagnostics.len() > 0 {
        return compact_ast_diagnostics(ast_value.diagnostics, source, false)
    } else {
        ()
    };
    match single_file_project_import(ast_value) {
        Option::Some(package_path) => return "single-file compilation cannot use project package "
            + package_path
            + "\n",
        Option::None => (),
    };
    let ast_value = hir::expand_derives(ast_value);
    if ast_value.diagnostics.len() > 0 {
        return compact_ast_diagnostics(ast_value.diagnostics, source, false)
    } else {
        ()
    };
    let hir_value = hir::lower_expanded(ast_value, source_path);
    if hir_value.diagnostics.len() > 0 {
        return compact_hir_diagnostics(hir_value.diagnostics, source)
    } else {
        ()
    };
    let counter = Ref::new(0);
    let builtins = core::lower_builtins(counter);
    let standard = if has_standard_import(ast_value) {
        Option::Some(compile_standard_library(builtins))
    } else {
        Option::None
    };
    let hir_dependencies = match standard {
        Option::Some(value) => selected_standard_hir(ast_value, value),
        Option::None => Vec::new(),
    };
    let core_dependencies = match standard {
        Option::Some(value) => selected_standard_core(ast_value, value),
        Option::None => Vec::new(),
    };
    let tast_value = tast::check_for_link_with_dependencies(
        hir_value,
        hir_dependencies,
    );
    if typer_diagnostics_have_errors(tast_value.diagnostics) {
        return compact_typer_diagnostics(tast_value.diagnostics, source_path, source)
    } else {
        ()
    };
    if !has_single_file_entrypoint(tast_value) {
        return "main function is required\n"
    } else {
        ()
    };
    let core_value = core::link_with_dependencies(
        builtins,
        core_dependencies,
        core::lower_with_counter_and_types(
            tast_value,
            counter,
            dependency_enums(builtins, core_dependencies),
            dependency_structs(builtins, core_dependencies),
        ),
    );
    let mono_result = mono::lower_checked(core_value);
    match mono_result.error {
        Option::Some(error) => error + "\n",
        Option::None => "",
    }
}

fn run_test_diagnostics(args: Vec[string]) -> unit {
    if args.len() != 3 {
        fail("usage: gomlc __test-diagnostics <FILE>")
    } else {
        let source_path = args.get(2);
        io::print(diagnostic_output(
            source_path,
            read_source(source_path),
        ))
    }
}

fn lower_mono_or_fail(value: core::File) -> core::File {
    let result = mono::lower_checked(value);
    match result.error {
        Option::Some(error) => {
            fail("error[compile]: " + error);
            result.file
        },
        Option::None => result.file,
    }
}

fn has_single_file_entrypoint(value: tast::CheckResult) -> bool {
    match value.tast {
        Option::Some(file) => {
            let found = Ref::new(false);
            for item in file.items {
                match item {
                    tast::Item::Function(function) => if function.name == "main" {
                        found.set(true)
                    } else {
                        ()
                    },
                    _ => (),
                }
            };
            found.get()
        },
        Option::None => false,
    }
}

fn fail_on_missing_single_file_entrypoint(value: tast::CheckResult) -> unit {
    if has_single_file_entrypoint(value) {
        ()
    } else {
        fail("error[typer]: main function is required")
    }
}

pub fn compile_source(source_path: string, source: string) -> Compilation {
    let parsed = parser::parse(source);
    fail_on_ast_diagnostics(parsed.diagnostics, "parser", source_path, source);
    let ast_value = ast::lower(parsed);
    fail_on_ast_diagnostics(ast_value.diagnostics, "lower", source_path, source);
    match single_file_project_import(ast_value) {
        Option::Some(package_path) => fail(
            "error[compile]: single-file compilation cannot use project package " + package_path,
        ),
        Option::None => (),
    };
    let ast_value = hir::expand_derives(ast_value);
    fail_on_ast_diagnostics(ast_value.diagnostics, "derive", source_path, source);
    let hir_value = hir::lower_expanded(ast_value, source_path);
    fail_on_compilation_diagnostics(hir_value.diagnostics, source_path, source);
    let counter = Ref::new(0);
    let builtins = core::lower_builtins(counter);
    let standard = if has_standard_import(ast_value) {
        Option::Some(compile_standard_library(builtins))
    } else {
        Option::None
    };
    let hir_dependencies = match standard {
        Option::Some(value) => selected_standard_hir(ast_value, value),
        Option::None => Vec::new(),
    };
    let core_dependencies = match standard {
        Option::Some(value) => selected_standard_core(ast_value, value),
        Option::None => Vec::new(),
    };
    let tast_value = tast::check_for_link_with_dependencies(
        hir_value,
        hir_dependencies,
    );
    fail_on_typer_diagnostics(tast_value.diagnostics, source_path, source);
    fail_on_missing_single_file_entrypoint(tast_value);
    let core_value = core::link_with_dependencies(
        builtins,
        core_dependencies,
        core::lower_with_counter_and_types(
            tast_value,
            counter,
            dependency_enums(builtins, core_dependencies),
            dependency_structs(builtins, core_dependencies),
        ),
    );
    let mono_value = lower_mono_or_fail(core_value);
    let lift_value = lift::lower_with_counter(mono_value, counter);
    let anf_value = anf::lower_with_counter(lift_value, counter);
    let go_value = go_backend::lower(anf_value);
    Compilation {
        ast_value,
        hir_value,
        tast_value,
        core_value,
        mono_value,
        lift_value,
        anf_value,
        go_value,
    }
}

fn pipeline_stage_output(stage: string, source_path: string, source: string) -> string {
    if stage == "cst" {
        cst::debug_tree(parser::parse(source))
    } else {
        let compilation = compile_source(source_path, source);
        if stage == "ast" {
            ast::pretty(compilation.ast_value)
        } else if stage == "hir" {
            hir::encode(compilation.hir_value)
        } else if stage == "tast" {
            tast::encode(compilation.tast_value)
        } else if stage == "core" {
            core::encode(compilation.core_value)
        } else if stage == "mono" {
            mono::encode(compilation.mono_value)
        } else if stage == "lift" {
            lift::encode(compilation.lift_value)
        } else if stage == "anf" {
            anf::encode(compilation.anf_value)
        } else if stage == "go" {
            go_backend::encode(compilation.go_value)
        } else {
            fail("unknown pipeline stage: " + stage);
            ""
        }
    }
}

fn print_dump(printed: Ref[bool], label: string, content: string) -> unit {
    if printed.get() {
        io::println("")
    } else {
        ()
    };
    io::println("== " + label + " ==");
    io::println(content);
    printed.set(true)
}

fn print_dumps(compilation: Compilation, args: RunArgs, go_source: string) -> unit {
    let printed = Ref::new(false);
    if args.dump_ast {
        print_dump(printed, "AST", ast::pretty(compilation.ast_value))
    } else {
        ()
    };
    if args.dump_hir {
        print_dump(printed, "HIR", hir::encode(compilation.hir_value))
    } else {
        ()
    };
    if args.dump_tast {
        print_dump(printed, "Typed AST", tast::encode(compilation.tast_value))
    } else {
        ()
    };
    if args.dump_core {
        print_dump(printed, "Core", core::encode(compilation.core_value))
    } else {
        ()
    };
    if args.dump_mono {
        print_dump(printed, "Mono", mono::encode(compilation.mono_value))
    } else {
        ()
    };
    if args.dump_lift {
        print_dump(printed, "Lifted", lift::encode(compilation.lift_value))
    } else {
        ()
    };
    if args.dump_anf {
        print_dump(printed, "ANF", anf::encode(compilation.anf_value))
    } else {
        ()
    };
    if args.dump_go {
        print_dump(printed, "Go", go_source)
    } else {
        ()
    }
}

fn write_stdout(data: bytes::Bytes) -> unit {
    match io::write_stdout(data) {
        Result::Ok(()) => (),
        Result::Err(error) => fail(error),
    }
}

fn bytes_to_string(data: bytes::Bytes) -> string {
    match data.to_string() {
        Result::Ok(value) => value,
        Result::Err(error) => fail_string(error),
    }
}

fn fail_string(message: string) -> string {
    fail(message);
    ""
}

fn ascii_whitespace_at(value: string, index: int) -> bool {
    let character = value.byte_slice(index, index + 1);
    character == " " || character == "\n" || character == "\r" || character == "\t"
}

fn trim_ascii(value: string) -> string {
    let start = Ref::new(0);
    let end = Ref::new(value.byte_len());
    while start.get() < end.get() && ascii_whitespace_at(value, start.get()) {
        start.set(start.get() + 1)
    };
    while end.get() > start.get() && ascii_whitespace_at(value, end.get() - 1) {
        end.set(end.get() - 1)
    };
    value.byte_slice(start.get(), end.get())
}

fn temp_root() -> string {
    match env::var("TMPDIR") {
        Option::Some(value) => if value == "" { "/tmp" } else { value },
        Option::None => "/tmp",
    }
}

fn temp_go_path(source_path: string, source: string) -> string {
    let directory = path::join(temp_root(), "gomlc-selfhost");
    match fs::create_dir_all(directory) {
        Result::Ok(()) => (),
        Result::Err(error) => fail(error),
    };
    let name = Hash::hash(source_path + "\n" + source).to_string() + ".go";
    path::join(directory, name)
}

fn command_succeeded(output: process::Output) -> bool {
    process::ExitStatus::success(process::Output::status(output))
}

fn try_execute_with_yaegi(directory: string, go_file: string) -> bool {
    let available = match process::Command::new("yaegi").arg("help").output() {
        Result::Ok(output) => command_succeeded(output),
        Result::Err(_) => false,
    };
    if !available {
        false
    } else {
        match process::Command::new("yaegi")
            .arg("run")
            .arg(go_file)
            .current_dir(directory)
            .env("TZ", "UTC")
            .output()
        {
            Result::Ok(output) => if command_succeeded(output) {
                write_stdout(process::Output::stdout(output));
                true
            } else {
                false
            },
            Result::Err(_) => false,
        }
    }
}

fn cleanup_temp_file(go_file: string) -> unit {
    let _ = process::Command::new("rm").arg("-f").arg(go_file).output();
    ()
}

fn execute_with_go_run(directory: string, go_file: string) -> unit {
    match process::Command::new("go")
        .arg("run")
        .arg(go_file)
        .current_dir(directory)
        .env("TZ", "UTC")
        .env("GOWORK", "off")
        .env("GO111MODULE", "off")
        .output()
    {
        Result::Ok(output) => if command_succeeded(output) {
            write_stdout(process::Output::stdout(output))
        } else {
            fail(
                "go run failed: "
                    + trim_ascii(bytes_to_string(process::Output::stderr(output))),
            )
        },
        Result::Err(error) => fail("failed to execute go run: " + error),
    }
}

fn execute_go_source(source_path: string, source: string) -> unit {
    let go_file = temp_go_path(source_path, source);
    match fs::write_file(go_file, source) {
        Result::Ok(()) => (),
        Result::Err(error) => fail(error),
    };
    let directory = match path::parent(go_file) {
        Option::Some(value) => value,
        Option::None => temp_root(),
    };
    if try_execute_with_yaegi(directory, go_file) {
        ()
    } else {
        execute_with_go_run(directory, go_file)
    };
    cleanup_temp_file(go_file)
}

fn run_single(args: RunArgs) -> unit {
    let source = read_source(args.file);
    let compilation = compile_source(args.file, source);
    let go_source = go_backend::encode(compilation.go_value);
    print_dumps(compilation, args, go_source);
    execute_go_source(args.file, go_source)
}
