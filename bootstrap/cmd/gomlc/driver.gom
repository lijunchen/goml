package main;

use gomlc::anf;
use gomlc::ast;
use gomlc::core;
use gomlc::cst;
use gomlc::go_backend;
use gomlc::hir;
use gomlc::lift;
use gomlc::mono;
use gomlc::parser;
use gomlc::stdlib;
