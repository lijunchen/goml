package main;

use std::io;

enum VersionFormat {
    Text,
    Json,
}

fn parse_version_format(value: string) -> Result[VersionFormat, string] {
    if value == "text" {
        Result::Ok(VersionFormat::Text)
    } else if value == "json" {
        Result::Ok(VersionFormat::Json)
    } else {
        Result::Err(invalid_value_error(
            value,
            "--format <FORMAT>",
            "text, json",
        ))
    }
}

fn parse_version_args(args: Vec[string]) -> Result[VersionFormat, string] {
    let format: Ref[Option[string]] = Ref::new(Option::None);
    let positional = Ref::new(false);
    let index = Ref::new(2);
    while index.get() < args.len() {
        let argument = args.get(index.get());
        if positional.get() == false && argument == "--" {
            positional.set(true);
            index.set(index.get() + 1)
        } else if positional.get() == false && cli_help_argument(argument) {
            return Result::Err(cli_help_signal())
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--help"))
        {
            let value = match inline_cli_value(argument, "--help") {
                Option::Some(value) => value,
                Option::None => "",
            };
            return Result::Err(unexpected_value_error_with_usage(
                value,
                "--help",
                "gomlc version --help",
            ))
        } else if positional.get() == false
            && cli_value_option("version", argument)
            && index.get() + 1 < args.len()
            && cli_option(args.get(index.get() + 1))
            && !known_cli_option("version", args.get(index.get() + 1))
        {
            return Result::Err(unexpected_cli_option_error_with_usage(
                "version",
                args.get(index.get() + 1),
                command_usage("version"),
            ))
        } else if positional.get() == false && argument == "--format" {
            if index.get() + 1 >= args.len()
                || cli_option(args.get(index.get() + 1))
            {
                return Result::Err(value_required_error(
                    "--format <FORMAT>",
                    Option::Some("text, json"),
                ))
            } else if option_string_present(format.get()) {
                return Result::Err(repeated_argument_error(
                    "version",
                    "--format <FORMAT>",
                ))
            } else {
                let value = args.get(index.get() + 1);
                match parse_version_format(value) {
                    Result::Ok(_) => {
                        format.set(Option::Some(value));
                        index.set(index.get() + 2)
                    },
                    Result::Err(error) => return Result::Err(error),
                }
            }
        } else if positional.get() == false
            && option_string_present(inline_cli_value(argument, "--format"))
        {
            if option_string_present(format.get()) {
                return Result::Err(repeated_argument_error(
                    "version",
                    "--format <FORMAT>",
                ))
            } else {
                match inline_cli_value(argument, "--format") {
                    Option::Some(value) => if value == "" {
                        return Result::Err(value_required_error(
                            "--format <FORMAT>",
                            Option::Some("text, json"),
                        ))
                    } else {
                        match parse_version_format(value) {
                            Result::Ok(_) => format.set(Option::Some(value)),
                            Result::Err(error) => return Result::Err(error),
                        }
                    },
                    Option::None => (),
                };
                index.set(index.get() + 1)
            }
        } else {
            if positional.get() {
                return Result::Err(unexpected_argument_error(
                    "version",
                    argument,
                    false,
                ))
            } else {
                ()
            };
            match similar_cli_argument("version", argument) {
                Option::Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(
                        argument,
                        similar,
                        similar_cli_argument_usage("version", similar),
                    ),
                ),
                Option::None => return Result::Err(unexpected_argument_error(
                    "version",
                    argument,
                    false,
                )),
            }
        }
    };
    match format.get() {
        Option::Some(value) => parse_version_format(value),
        Option::None => Result::Ok(VersionFormat::Text),
    }
}

fn version_output(format: VersionFormat) -> string {
    match format {
        VersionFormat::Text => "gomlc 0.0.0 (a3c94540a 2026-07-22)",
        VersionFormat::Json => "{\"artifact_format\":15,\"compiler_abi\":3,\"driver_protocol\":1,\"git_date\":\"2026-07-22\",\"git_hash\":\"a3c94540a\",\"tool\":\"gomlc\",\"version\":\"0.0.0\"}",
    }
}

fn run_version(args: Vec[string]) -> unit {
    match parse_version_args(args) {
        Result::Ok(format) => io::println(version_output(format)),
        Result::Err(error) => handle_cli_parse_error("version", error),
    }
}
