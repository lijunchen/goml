}

fn run_package_command(
    args: Vec[string],
    build: bool,
    emit_tests: bool,
) -> unit {
    let command = match parse_package_command_args(args) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            handle_cli_parse_error(args.get(1), error);
            PackageCommandArgs {
                package_name: "main",
                inputs: Vec::new(),
                interface_paths: Vec::new(),
                output: "package",
            }
        },
    };
    let artifact = match compile_artifact_package(
        package_world(),
        command,
        build,
        emit_tests,
    ) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            ArtifactCoreUnit {
                package_name: command.package_name,
                interface_unit: new_artifact_interface_unit(
                    command.package_name,
                    empty_artifact_package_exports(),
                    ArtifactPackageInterface {
                        package_name: command.package_name,
                        name: "main",
                        value_exports: Vec::new(),
                        enum_variants: Vec::new(),
                    },
                    Vec::new().pushed(builtin_artifact_dependency()),
                ),
                exports: empty_artifact_package_exports(),
                core_ir: empty_core_file(),
                deps: Vec::new().pushed(builtin_artifact_dependency()),
                sources: Vec::new(),
                tests: Vec::new(),
            }
        },
    };
    match ensure_parent(interface_output_path(command.output)) {
        Result::Ok(()) => match fs::write_file(
            interface_output_path(command.output),
            encode_artifact_interface_unit(artifact.interface_unit, true),
        ) {
            Result::Ok(()) => (),
            Result::Err(error) => fail(error),
        },
        Result::Err(error) => fail(error),
    };
    if build {
        match ensure_parent(core_output_path(command.output)) {
            Result::Ok(()) => match fs::write_file(
                core_output_path(command.output),
                encode_artifact_core_unit(artifact, true),
            ) {
                Result::Ok(()) => (),
                Result::Err(error) => fail(error),
            },
            Result::Err(error) => fail(error),
        }
    } else {
        ()
    }
}

fn run_link_command(args: Vec[string]) -> unit {
    let command = match parse_link_command_args(args) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            handle_cli_parse_error("link", error);
            LinkCommandArgs {
                inputs: Vec::new(),
                entry: "main",
                output: "main.go",
            }
        },
    };
    let world = package_world();
    let core_units = match artifact_read_core_units(command.inputs) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            Vec::new()
        },
    };
    let roots = Vec::new().pushed(command.entry);
    let core_units = match artifact_reachable_core_units(roots, core_units) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            Vec::new()
        },
    };
    match artifact_validate_link_core_units(world, core_units) {
        Result::Ok(()) => (),
        Result::Err(error) => fail("error[compile]: " + error),
    };
    artifact_prepare_core_units(world, core_units);
    match artifact_find_core_unit(core_units, command.entry) {
        Option::Some(value) => if value.interface_unit.package_interface.name == ""
            || value.interface_unit.package_interface.name == "main"
        {
            ()
        } else {
            fail(
                "error[compile]: entry package "
                    + command.entry
                    + " declares package "
                    + value.interface_unit.package_interface.name
                    + ", expected main",
            )
        },
        Option::None => fail("error[compile]: missing entry package " + command.entry),
    };
    let dependencies = Vec::new();
    let entry: Ref[Option[ArtifactCompilation]] = Ref::new(Option::None);
    let needs = artifact_core_standard_needs(core_units);
    let compilations = match artifact_core_compilations(core_units) {
        Result::Ok(values) => values,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            Vec::new()
        },
    };
    for compilation in compilations {
        if compilation.package_name == command.entry {
            entry.set(Option::Some(compilation))
        } else {
            dependencies.push(compilation.core_value)
        }
    };
    let entry = match entry.get() {
        Option::Some(value) => value,
        Option::None => {
            fail("error[compile]: missing entry package " + command.entry);
            ArtifactCompilation {
                package_name: command.entry,
                dependency_names: Vec::new(),
                core_value: core::File {
                    functions: Vec::new(),
                    enums: Vec::new(),
                    structs: Vec::new(),
                    type_instances: Vec::new(),
                },
            }
        },
    };
    let linked_dependencies = selected_link_standard_core(world.standard, needs);
    append_core_files(linked_dependencies, dependencies);
    let linked = core::link_with_dependencies(
        world.builtins,
        linked_dependencies,
        entry_core(entry.core_value, command.entry),
    );
    let mono_value = lower_mono_or_fail(linked);
    let lift_value = lift::lower_with_counter(mono_value, world.counter);
    let anf_value = anf::lower_with_counter(lift_value, world.counter);
    let go_source = go_backend::encode(go_backend::lower(anf_value));
    match ensure_parent(command.output) {
        Result::Ok(()) => match fs::write_file(command.output, go_source) {
            Result::Ok(()) => (),
            Result::Err(error) => fail(error),
        },
        Result::Err(error) => fail(error),
    }
}

fn empty_core_file() -> core::File {
    core::File {
        functions: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
    }
}

fn run_test_link_command(args: Vec[string]) -> unit {
    let command = match parse_test_link_command_args(args) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            handle_cli_parse_error("test-link", error);
            TestLinkCommandArgs {
                inputs: Vec::new(),
                packages: Vec::new(),
                output: "main.go",
                manifest: "tests.json",
            }
        },
    };
    let world = package_world();
    let core_units = match artifact_read_core_units(command.inputs) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            Vec::new()
        },
    };
    let core_units = match artifact_reachable_core_units(
        command.packages,
        core_units,
    ) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            Vec::new()
        },
    };
    match artifact_validate_link_core_units(world, core_units) {
        Result::Ok(()) => (),
        Result::Err(error) => fail("error[compile]: " + error),
    };
    artifact_prepare_core_units(world, core_units);
    let package_cores = Vec::new();
    let needs = artifact_core_standard_needs(core_units);
    let compilations = match artifact_core_compilations(core_units) {
        Result::Ok(values) => values,
        Result::Err(error) => {
            fail("error[compile]: " + error);
            Vec::new()
        },
    };
    for compilation in compilations {
        package_cores.push(compilation.core_value)
    };
    let tests = Vec::new();
    for package_name in command.packages {
        match artifact_find_core_unit(core_units, package_name) {
            Option::Some(core_unit) => for test in core_unit.tests {
                tests.push(test)
            },
            Option::None => fail(
                "error[compile]: missing test package " + package_name,
            ),
        }
    };
    let linked_dependencies = selected_link_standard_core(world.standard, needs);
    append_core_files(linked_dependencies, package_cores);
    let linked = core::link_with_dependencies(
        world.builtins,
        linked_dependencies,
        empty_core_file(),
    );
    let mono_value = lower_mono_or_fail(linked);
    let lift_value = lift::lower_with_counter(mono_value, world.counter);
    let anf_value = anf::lower_with_counter(lift_value, world.counter);
    let go_source = go_backend::encode(go_backend::lower_tests(
        anf_value,
        test_link_cases(tests),
    ));
    match ensure_parent(command.output) {
        Result::Ok(()) => match fs::write_file(command.output, go_source) {
            Result::Ok(()) => (),
            Result::Err(error) => fail(error),
        },
        Result::Err(error) => fail(error),
    };
    match ensure_parent(command.manifest) {
        Result::Ok(()) => match fs::write_file(
            command.manifest,
            encode_test_manifest(tests),
        ) {
            Result::Ok(()) => (),
            Result::Err(error) => fail(error),
        },
        Result::Err(error) => fail(error),
    }
}
