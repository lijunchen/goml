package main;

use gomlang::parser::ast;
use gomlang::parser::core;
use gomlang::parser::parser;
use gomlang::parser::tast;
use std::testing;

fn args_with(values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push("run-single");
    for value in values {
        args.push(value)
    };
    args
}

fn version_args_with(values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push("version");
    for value in values {
        args.push(value)
    };
    args
}

fn command_args_with(command: string, values: Vec[string]) -> Vec[string] {
    let args = Vec::new();
    args.push("gomlc");
    args.push(command);
    for value in values {
        args.push(value)
    };
    args
}

fn parse_ok(values: Vec[string]) -> RunArgs {
    match parse_run_args(args_with(values)) {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error);
            parse_ok(Vec::new())
        },
    }
}

fn assert_parse_error(values: Vec[string], expected: string) -> unit {
    match parse_run_args(args_with(values)) {
        Result::Ok(_) => testing::fail("expected argument error"),
        Result::Err(error) => testing::assert_eq(error, expected),
    }
}

fn core_function_index(value: core::File, expected: string) -> int32 {
    let result = Ref::new(-1);
    for index in range(0, value.functions.len()) {
        if value.functions.get(index).name == expected {
            result.set(index)
        } else {
            ()
        }
    };
    result.get()
}

#[test]
fn links_imported_standard_package_closure() -> unit {
    let source = "use std::fs; use std::io; fn main() -> unit { let _ = fs::write_file(\"out.txt\", \"ok\"); io::println(\"done\") }";
    let compilation = compile_source("main.gom", source);
    let bytes = core_function_index(
        compilation.core_value,
        "inherent#std::bytes::Bytes#std::bytes::Bytes#from_string",
    );
    let fs = core_function_index(compilation.core_value, "std::fs::read_file");
    let io = core_function_index(compilation.core_value, "std::io::println");
    let main = core_function_index(compilation.core_value, "main");
    testing::assert(bytes >= 0);
    testing::assert(bytes < fs);
    testing::assert(fs < io);
    testing::assert(io < main);
    testing::assert_eq(
        core_function_index(compilation.core_value, "std::env::args"),
        -1,
    )
}

#[test]
fn parses_run_single_dump_flags() -> unit {
    let values = Vec::new();
    values.push("--dump-go");
    values.push("main.gom");
    values.push("--dump-ast");
    values.push("--dump-tast");
    values.push("--dump-core");
    values.push("--dump-mono");
    values.push("--dump-lift");
    values.push("--dump-anf");
    values.push("--dump-hir");
    let args = parse_ok(values);
    testing::assert_eq(args.file, "main.gom");
    testing::assert(args.dump_ast);
    testing::assert(args.dump_hir);
    testing::assert(args.dump_tast);
    testing::assert(args.dump_core);
    testing::assert(args.dump_mono);
    testing::assert(args.dump_lift);
    testing::assert(args.dump_anf);
    testing::assert(args.dump_go)
}

#[test]
fn parses_run_single_without_dumps() -> unit {
    let values = Vec::new();
    values.push("main.gom");
    let args = parse_ok(values);
    testing::assert_eq(args.file, "main.gom");
    testing::assert(!args.dump_ast);
    testing::assert(!args.dump_hir);
    testing::assert(!args.dump_tast);
    testing::assert(!args.dump_core);
    testing::assert(!args.dump_mono);
    testing::assert(!args.dump_lift);
    testing::assert(!args.dump_anf);
    testing::assert(!args.dump_go)
}

#[test]
fn parses_version_formats() -> unit {
    match parse_version_args(version_args_with(Vec::new())) {
        Result::Ok(VersionFormat::Text) => (),
        _ => testing::fail("expected default text version format"),
    };
    let json_args = Vec::new();
    json_args.push("--format");
    json_args.push("json");
    match parse_version_args(version_args_with(json_args)) {
        Result::Ok(VersionFormat::Json) => (),
        _ => testing::fail("expected json version format"),
    };
    let inline_args = Vec::new();
    inline_args.push("--format=text");
    match parse_version_args(version_args_with(inline_args)) {
        Result::Ok(VersionFormat::Text) => (),
        _ => testing::fail("expected inline text version format"),
    }
}

#[test]
fn reports_driver_protocol_version() -> unit {
    testing::assert_eq(version_output(VersionFormat::Text), "gomlc 0.0.0");
    testing::assert_eq(
        version_output(VersionFormat::Json),
        "{\"artifact_format\":11,\"compiler_abi\":2,\"driver_protocol\":1,\"git_date\":null,\"git_hash\":null,\"tool\":\"gomlc\",\"version\":\"0.0.0\"}",
    );
    match parse_version_format("yaml") {
        Result::Err(error) => testing::assert_eq(error, "invalid version format: yaml"),
        Result::Ok(_) => testing::fail("expected invalid version format"),
    }
}

#[test]
fn parses_package_command_arguments() -> unit {
    let values = Vec::new();
    values.push("--package");
    values.push("alice::app");
    values.push("--input");
    values.push("main.gom");
    values.push("extra.gom");
    values.push("--interface-path");
    values.push("lib.interface");
    values.push("--output");
    values.push("artifact/package");
    match parse_package_command_args(command_args_with("build", values)) {
        Result::Ok(args) => {
            testing::assert_eq(args.package_name, "alice::app");
            testing::assert_eq(args.inputs.len(), 2);
            testing::assert_eq(args.inputs.get(0), "main.gom");
            testing::assert_eq(args.inputs.get(1), "extra.gom");
            testing::assert_eq(args.interface_paths.len(), 1);
            testing::assert_eq(args.interface_paths.get(0), "lib.interface");
            testing::assert_eq(args.output, "artifact/package")
        },
        Result::Err(error) => testing::fail(error),
    }
}

#[test]
fn parses_link_command_arguments() -> unit {
    let values = Vec::new();
    values.push("--input");
    values.push("lib.core");
    values.push("main.core");
    values.push("--output");
    values.push("artifact/main.go");
    values.push("--entry");
    values.push("alice::app");
    match parse_link_command_args(command_args_with("link", values)) {
        Result::Ok(args) => {
            testing::assert_eq(args.inputs.len(), 2);
            testing::assert_eq(args.inputs.get(0), "lib.core");
            testing::assert_eq(args.inputs.get(1), "main.core");
            testing::assert_eq(args.entry, "alice::app");
            testing::assert_eq(args.output, "artifact/main.go")
        },
        Result::Err(error) => testing::fail(error),
    }
}

#[test]
fn round_trips_source_artifacts() -> unit {
    let sources = Vec::new();
    sources.push("/project/main.gom");
    sources.push("/project/extra.gom");
    let dependencies = Vec::new();
    dependencies.push("/project/lib.interface");
    let encoded = encode_source_artifact(SourceArtifact {
        package_name: "alice::app",
        sources,
        dependencies,
    });
    match decode_source_artifact(encoded) {
        Result::Ok(artifact) => {
            testing::assert_eq(artifact.package_name, "alice::app");
            testing::assert_eq(artifact.sources.len(), 2);
            testing::assert_eq(artifact.sources.get(0), "/project/main.gom");
            testing::assert_eq(artifact.sources.get(1), "/project/extra.gom");
            testing::assert_eq(artifact.dependencies.len(), 1);
            testing::assert_eq(
                artifact.dependencies.get(0),
                "/project/lib.interface",
            )
        },
        Result::Err(error) => testing::fail(error),
    }
}

#[test]
fn adds_canonical_entry_wrapper() -> unit {
    let functions = Vec::new();
    functions.push(core::Function {
        name: "alice::app::main",
        root: true,
        generics: Vec::new(),
        predicates: Vec::new(),
        trait_impl: Option::None,
        params: Vec::new(),
        ret_ty: tast::Type::Unit,
        body: core::Block {
            stmts: Vec::new(),
            tail: Option::Some(core::Expr::Prim(
                tast::Primitive::Unit,
                tast::Type::Unit,
            )),
        },
    });
    let wrapped = add_entry_wrapper(core::File {
        functions,
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
    }, "alice::app");
    testing::assert_eq(wrapped.functions.len(), 2);
    testing::assert_eq(wrapped.functions.get(0).name, "alice::app::main");
    testing::assert_eq(wrapped.functions.get(1).name, "main");
    match wrapped.functions.get(1).body.tail {
        Option::Some(core::Expr::Call(
            core::Expr::Var(name, tast::Type::Func(params, tast::Type::Unit)),
            args,
            tast::Type::Unit,
        )) => {
            testing::assert_eq(name, "alice::app::main");
            testing::assert_eq(params.len(), 0);
            testing::assert_eq(args.len(), 0)
        },
        _ => testing::fail("expected canonical entry call"),
    }
}

#[test]
fn rejects_invalid_run_single_arguments() -> unit {
    assert_parse_error(Vec::new(), "missing input file");
    let unknown = Vec::new();
    unknown.push("--unknown");
    assert_parse_error(unknown, "unknown argument: --unknown");
    let multiple = Vec::new();
    multiple.push("one.gom");
    multiple.push("two.gom");
    assert_parse_error(multiple, "multiple input files")
}

#[test]
fn rejects_project_imports_in_single_file_mode() -> unit {
    let source = "use std::io; use packages_basic::Lib; fn main() -> unit {}";
    match single_file_project_import(ast::lower(parser::parse(source))) {
        Option::Some(value) => testing::assert_eq(value, "packages_basic::Lib"),
        Option::None => testing::fail("expected project import"),
    };
    match single_file_project_import(ast::lower(parser::parse(
        "use std::fs; use std::io; fn main() -> unit {}",
    ))) {
        Option::Some(_) => testing::fail("expected standard imports to be accepted"),
        Option::None => (),
    }
}
