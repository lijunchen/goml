package tast;

use gomlang::parser::hir;

fn function_context(
    base: Checker,
    ret_ty: Type,
    self_ty: Option[Type],
    type_params: Vec[string],
    predicates: Vec[TypePredicate],
) -> Checker {
    let predicates = expand_implied_predicates(base, predicates);
    Checker {
        counter: base.counter,
        diagnostics: base.diagnostics,
        enums: base.enums,
        structs: base.structs,
        traits: base.traits,
        functions: base.functions,
        methods: base.methods,
        impls: base.impls,
        predicates,
        locals: Vec::new(),
        return_ty: ret_ty,
        self_ty,
        type_params,
    }
}

fn check_function(
    base: Checker,
    value: hir::Function,
    inherited_generics: Vec[string],
    inherited_predicates: Vec[TypePredicate],
    self_ty: Option[Type],
) -> Function {
    let type_params = append_names(inherited_generics, value.generics);
    let ret_ty = match value.ret_ty {
        Option::Some(ty) => type_from_hir(ty, type_params, self_ty),
        Option::None => Type::Unit,
    };
    let predicates = append_predicates(
        inherited_predicates,
        predicates_from_hir(
            value.generic_bounds,
            value.predicates,
            type_params,
            self_ty,
        ),
    );
    let ctx = function_context(base, ret_ty, self_ty, type_params, predicates);
    let params: Vec[(string, Type)] = Vec::new();
    for param in value.params {
        let ty = type_from_hir(param.1, type_params, self_ty);
        insert_local(ctx, param.0, ty);
        params.push((local_name(param.0), ty))
    };
    let body = check_block(ctx, value.body, Option::Some(ret_ty));
    Function {
        name: value.name,
        generics: type_params,
        predicates,
        params,
        ret_ty,
        body: body.0,
    }
}

fn check_impl(base: Checker, value: hir::ImplBlock) -> ImplBlock {
    let for_type = type_from_hir(value.for_type, value.generics, Option::None);
    let predicates = predicates_from_hir(
        value.generic_bounds,
        value.predicates,
        value.generics,
        Option::Some(for_type),
    );
    let trait_ref = match value.trait_ref {
        Option::Some(reference) => Option::Some(trait_ref_from_hir(
            reference,
            value.generics,
            Option::Some(for_type),
        )),
        Option::None => Option::None,
    };
    let associated_types: Vec[(string, Type)] = Vec::new();
    for associated in value.associated_types {
        associated_types.push((
            associated.0,
            type_from_hir(
                associated.1,
                value.generics,
                Option::Some(for_type),
            ),
        ))
    };
    let methods: Vec[Function] = Vec::new();
    for method in value.methods {
        methods.push(check_function(
            base,
            method,
            value.generics,
            predicates,
            Option::Some(for_type),
        ))
    };
    ImplBlock {
        generics: value.generics,
        trait_ref,
        for_type,
        associated_types,
        methods,
    }
}

fn builtin_enum_definitions() -> Vec[EnumDef] {
    let result: Vec[EnumDef] = Vec::new();
    result.push(EnumDef {
        name: "Option",
        generics: Vec::new().pushed("T"),
        variants: Vec::new()
            .pushed(EnumVariantDef {
                name: "None",
                fields: Vec::new(),
            })
            .pushed(EnumVariantDef {
                name: "Some",
                fields: Vec::new().pushed(Type::Param("T")),
            }),
    });
    result.push(EnumDef {
        name: "Result",
        generics: Vec::new().pushed("T").pushed("E"),
        variants: Vec::new()
            .pushed(EnumVariantDef {
                name: "Ok",
                fields: Vec::new().pushed(Type::Param("T")),
            })
            .pushed(EnumVariantDef {
                name: "Err",
                fields: Vec::new().pushed(Type::Param("E")),
            }),
    });
    result
}

fn check_file(value: hir::File, include_builtin_types: bool) -> CheckResult {
    let ctx = collect_environment(value);
    let items: Vec[Item] = Vec::new();
    for item in value.items {
        match item {
            hir::Item::ImplBlock(value) => items.push(Item::ImplBlock(check_impl(ctx, value))),
            hir::Item::Function(value) => items.push(Item::Function(check_function(
                ctx,
                value,
                Vec::new(),
                Vec::new(),
                Option::None,
            ))),
            _ => (),
        }
    };
    let enums = if include_builtin_types {
        builtin_enum_definitions()
    } else {
        Vec::new()
    };
    for value in ctx.enums {
        let variants: Vec[EnumVariantDef] = Vec::new();
        for variant in value.variants {
            variants.push(EnumVariantDef {
                name: variant.name,
                fields: variant.fields,
            })
        };
        enums.push(EnumDef {
            name: value.name,
            generics: value.generics,
            variants,
        })
    };
    let structs: Vec[StructDef] = Vec::new();
    for value in ctx.structs {
        structs.push(StructDef {
            name: value.name,
            generics: value.generics,
            fields: value.fields,
        })
    };
    CheckResult {
        tast: Option::Some(File {
            items,
            enums,
            structs,
        }),
        diagnostics: ctx.diagnostics,
    }
}

pub fn check(value: hir::LowerResult) -> CheckResult {
    match value.hir {
        Option::Some(file) => check_file(file, true),
        Option::None => CheckResult {
            tast: Option::None,
            diagnostics: value.diagnostics,
        },
    }
}

pub fn check_for_link(value: hir::LowerResult) -> CheckResult {
    match value.hir {
        Option::Some(file) => check_file(file, false),
        Option::None => CheckResult {
            tast: Option::None,
            diagnostics: value.diagnostics,
        },
    }
}
