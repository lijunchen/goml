package tast;

struct TypeSubst {
    name: string,
    ty: Type,
}

fn merge_var_kind(left: VarKind, right: VarKind) -> Option[VarKind] {
    match (left, right) {
        (VarKind::Any, value) => Option::Some(value),
        (value, VarKind::Any) => Option::Some(value),
        (VarKind::Integer, VarKind::Integer) => Option::Some(VarKind::Integer),
        (VarKind::Float, VarKind::Float) => Option::Some(VarKind::Float),
        _ => Option::None,
    }
}

fn is_integer_type(value: Type) -> bool {
    match prune(value) {
        Type::Int8
        | Type::Int16
        | Type::Int32
        | Type::Int64
        | Type::Uint8
        | Type::Uint16
        | Type::Uint32
        | Type::Uint64 => true,
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound(_, VarKind::Integer) => true,
            TypeVar::Link(inner) => is_integer_type(inner),
            _ => false,
        },
        _ => false,
    }
}

fn is_float_type(value: Type) -> bool {
    match prune(value) {
        Type::Float32 | Type::Float64 => true,
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound(_, VarKind::Float) => true,
            TypeVar::Link(inner) => is_float_type(inner),
            _ => false,
        },
        _ => false,
    }
}

fn is_numeric_type(value: Type) -> bool {
    is_integer_type(value) || is_float_type(value)
}

fn kind_accepts(kind: VarKind, value: Type) -> bool {
    match kind {
        VarKind::Any => true,
        VarKind::Integer => is_integer_type(value),
        VarKind::Float => is_float_type(value),
    }
}

fn fresh_type(counter: Ref[int32], kind: VarKind) -> Type {
    let index = counter.get();
    counter.set(index + 1);
    Type::Var(Ref::new(TypeVar::Unbound(index, kind)))
}

fn prune(value: Type) -> Type {
    match value {
        Type::Var(variable) => match variable.get() {
            TypeVar::Link(inner) => {
                let resolved = prune(inner);
                variable.set(TypeVar::Link(resolved));
                resolved
            },
            TypeVar::Unbound(_, _) => Type::Var(variable),
        },
        _ => value,
    }
}

fn occurs(variable: Ref[TypeVar], value: Type) -> bool {
    match prune(value) {
        Type::Var(other) => ptr_eq(variable, other),
        Type::Tuple(values) => {
            let found = Ref::new(false);
            for item in values {
                if occurs(variable, item) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Projection(base, _, qualifier) => {
            let found = Ref::new(occurs(variable, base));
            match qualifier {
                Option::Some(reference) => for arg in reference.args {
                    if occurs(variable, arg) {
                        found.set(true)
                    } else {
                        ()
                    }
                },
                Option::None => (),
            };
            found.get()
        },
        Type::App(base, args) => {
            let found = Ref::new(occurs(variable, base));
            for arg in args {
                if occurs(variable, arg) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Array(_, elem)
        | Type::Slice(elem)
        | Type::VecType(elem)
        | Type::RefType(elem) => occurs(variable, elem),
        Type::HashMap(key, item) => occurs(variable, key) || occurs(variable, item),
        Type::Func(params, ret_ty) => {
            let found = Ref::new(occurs(variable, ret_ty));
            for param in params {
                if occurs(variable, param) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        _ => false,
    }
}

fn bind_variable(variable: Ref[TypeVar], value: Type) -> bool {
    if occurs(variable, value) {
        false
    } else {
        match variable.get() {
            TypeVar::Link(inner) => unify(inner, value),
            TypeVar::Unbound(_, kind) => if kind_accepts(kind, value) {
                variable.set(TypeVar::Link(value));
                true
            } else {
                false
            },
        }
    }
}

fn unify_types(left: Vec[Type], right: Vec[Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        let valid = Ref::new(true);
        for index in range(0, left.len()) {
            if !unify(left.get(index), right.get(index)) {
                valid.set(false)
            } else {
                ()
            }
        };
        valid.get()
    }
}

fn unify_trait_refs(left: Option[TraitRef], right: Option[TraitRef]) -> bool {
    match (left, right) {
        (Option::Some(first), Option::Some(second)) => {
            names_match(first.name, second.name) && unify_types(first.args, second.args)
        },
        _ => true,
    }
}

fn unify(left: Type, right: Type) -> bool {
    let left = prune(left);
    let right = prune(right);
    match (left, right) {
        (Type::Error, _) | (_, Type::Error) => true,
        (Type::Var(first), Type::Var(second)) => if ptr_eq(first, second) {
            true
        } else {
            match (first.get(), second.get()) {
                (TypeVar::Link(inner), _) => unify(inner, Type::Var(second)),
                (_, TypeVar::Link(inner)) => unify(Type::Var(first), inner),
                (TypeVar::Unbound(_, first_kind), TypeVar::Unbound(second_id, second_kind)) => {
                    match merge_var_kind(first_kind, second_kind) {
                        Option::Some(kind) => {
                            second.set(TypeVar::Unbound(second_id, kind));
                            first.set(TypeVar::Link(Type::Var(second)));
                            true
                        },
                        Option::None => false,
                    }
                },
            }
        },
        (Type::Var(variable), value) => bind_variable(variable, value),
        (value, Type::Var(variable)) => bind_variable(variable, value),
        (Type::Unit, Type::Unit)
        | (Type::Bool, Type::Bool)
        | (Type::Int8, Type::Int8)
        | (Type::Int16, Type::Int16)
        | (Type::Int32, Type::Int32)
        | (Type::Int64, Type::Int64)
        | (Type::Uint8, Type::Uint8)
        | (Type::Uint16, Type::Uint16)
        | (Type::Uint32, Type::Uint32)
        | (Type::Uint64, Type::Uint64)
        | (Type::Float32, Type::Float32)
        | (Type::Float64, Type::Float64)
        | (Type::String, Type::String)
        | (Type::Char, Type::Char) => true,
        (Type::Tuple(first), Type::Tuple(second)) => unify_types(first, second),
        (Type::Con(first), Type::Con(second)) => first == second,
        (Type::Dyn(first), Type::Dyn(second)) => first == second,
        (
            Type::Projection(first_base, first_name, first_trait),
            Type::Projection(second_base, second_name, second_trait),
        ) => {
            first_name == second_name
                && unify_trait_refs(first_trait, second_trait)
                && unify(first_base, second_base)
        },
        (Type::App(first_base, first_args), Type::App(second_base, second_args)) => {
            unify(first_base, second_base) && unify_types(first_args, second_args)
        },
        (Type::Array(first_len, first_elem), Type::Array(second_len, second_elem)) => {
            (first_len < 0 || second_len < 0 || first_len == second_len)
                && unify(first_elem, second_elem)
        },
        (Type::Slice(first), Type::Slice(second))
        | (Type::VecType(first), Type::VecType(second))
        | (Type::RefType(first), Type::RefType(second)) => unify(first, second),
        (Type::HashMap(first_key, first_value), Type::HashMap(second_key, second_value)) => {
            unify(first_key, second_key) && unify(first_value, second_value)
        },
        (Type::Param(first), Type::Param(second)) => first == second,
        (Type::Func(first_params, first_ret), Type::Func(second_params, second_ret)) => {
            unify_types(first_params, second_params) && unify(first_ret, second_ret)
        },
        _ => false,
    }
}

fn type_lists_equal(left: Vec[Type], right: Vec[Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        let equal = Ref::new(true);
        for index in range(0, left.len()) {
            if !types_equal(left.get(index), right.get(index)) {
                equal.set(false)
            } else {
                ()
            }
        };
        equal.get()
    }
}

fn trait_refs_equal(left: Option[TraitRef], right: Option[TraitRef]) -> bool {
    match (left, right) {
        (Option::Some(first), Option::Some(second)) => {
            names_match(first.name, second.name) && type_lists_equal(first.args, second.args)
        },
        _ => true,
    }
}

fn types_equal(left: Type, right: Type) -> bool {
    match (prune(left), prune(right)) {
        (Type::Var(first), Type::Var(second)) => ptr_eq(first, second),
        (Type::Unit, Type::Unit)
        | (Type::Bool, Type::Bool)
        | (Type::Int8, Type::Int8)
        | (Type::Int16, Type::Int16)
        | (Type::Int32, Type::Int32)
        | (Type::Int64, Type::Int64)
        | (Type::Uint8, Type::Uint8)
        | (Type::Uint16, Type::Uint16)
        | (Type::Uint32, Type::Uint32)
        | (Type::Uint64, Type::Uint64)
        | (Type::Float32, Type::Float32)
        | (Type::Float64, Type::Float64)
        | (Type::String, Type::String)
        | (Type::Char, Type::Char)
        | (Type::Error, Type::Error) => true,
        (Type::Tuple(first), Type::Tuple(second)) => type_lists_equal(first, second),
        (Type::Con(first), Type::Con(second))
        | (Type::Dyn(first), Type::Dyn(second))
        | (Type::Param(first), Type::Param(second)) => first == second,
        (
            Type::Projection(first_base, first_name, first_trait),
            Type::Projection(second_base, second_name, second_trait),
        ) => {
            first_name == second_name
                && trait_refs_equal(first_trait, second_trait)
                && types_equal(first_base, second_base)
        },
        (Type::App(first_base, first_args), Type::App(second_base, second_args)) => {
            types_equal(first_base, second_base) && type_lists_equal(first_args, second_args)
        },
        (Type::Array(first_len, first_elem), Type::Array(second_len, second_elem)) => {
            first_len == second_len && types_equal(first_elem, second_elem)
        },
        (Type::Slice(first), Type::Slice(second))
        | (Type::VecType(first), Type::VecType(second))
        | (Type::RefType(first), Type::RefType(second)) => types_equal(first, second),
        (Type::HashMap(first_key, first_value), Type::HashMap(second_key, second_value)) => {
            types_equal(first_key, second_key) && types_equal(first_value, second_value)
        },
        (Type::Func(first_params, first_ret), Type::Func(second_params, second_ret)) => {
            type_lists_equal(first_params, second_params) && types_equal(first_ret, second_ret)
        },
        _ => false,
    }
}

fn projection_equality(
    ctx: Checker,
    base: Type,
    name: string,
    qualifier: Option[TraitRef],
) -> Option[Type] {
    let result = Ref::new(Option::None);
    let matches = Ref::new(0);
    for predicate in ctx.predicates {
        let candidate = match predicate {
            TypePredicate::Equality(
                Type::Projection(left_base, left_name, left_trait),
                right,
            ) => {
                if left_name == name
                    && trait_refs_equal(left_trait, qualifier)
                    && types_equal(left_base, base) {
                    Option::Some(right)
                } else {
                    Option::None
                }
            },
            TypePredicate::Equality(
                left,
                Type::Projection(right_base, right_name, right_trait),
            ) => {
                if right_name == name
                    && trait_refs_equal(right_trait, qualifier)
                    && types_equal(right_base, base) {
                    Option::Some(left)
                } else {
                    Option::None
                }
            },
            _ => Option::None,
        };
        match candidate {
            Option::Some(value) => {
                matches.set(matches.get() + 1);
                result.set(Option::Some(value))
            },
            Option::None => (),
        }
    };
    if matches.get() == 1 {
        result.get()
    } else {
        Option::None
    }
}

fn associated_binding(value: ImplInfo, name: string) -> Option[Type] {
    let result = Ref::new(Option::None);
    for associated in value.associated_types {
        if associated.0 == name {
            result.set(Option::Some(associated.1))
        } else {
            ()
        }
    };
    result.get()
}

fn builtin_iterator_item(base: Type) -> Option[Type] {
    match prune(base) {
        Type::App(Type::Con(owner), args) => if owner == "FnIterator" && args.len() == 1 {
            Option::Some(args.get(0))
        } else if owner == "MapIterator" && args.len() == 3 {
            Option::Some(args.get(1))
        } else if owner == "FilterIterator" && args.len() == 2 {
            Option::Some(args.get(0))
        } else if owner == "TakeIterator" && args.len() == 1 {
            Option::Some(Type::Projection(
                args.get(0),
                "Item",
                Option::Some(TraitRef {
                    name: "Iterator",
                    args: Vec::new(),
                }),
            ))
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn projection_trait_matches(qualifier: Option[TraitRef], expected: string) -> bool {
    match qualifier {
        Option::Some(reference) => names_match(reference.name, expected),
        Option::None => true,
    }
}

fn builtin_projection(
    base: Type,
    name: string,
    qualifier: Option[TraitRef],
) -> Option[Type] {
    if name == "Item"
        && (projection_trait_matches(qualifier, "Iterator")
            || projection_trait_matches(qualifier, "IntoIterator")) {
        builtin_iterator_item(base)
    } else if name == "IntoIter" && projection_trait_matches(qualifier, "IntoIterator") {
        match builtin_iterator_item(base) {
            Option::Some(_) => Option::Some(base),
            Option::None => Option::None,
        }
    } else {
        Option::None
    }
}

fn impl_projection(
    ctx: Checker,
    base: Type,
    name: string,
    qualifier: Option[TraitRef],
) -> Option[Type] {
    let result = Ref::new(Option::None);
    let matches = Ref::new(0);
    for impl_info in ctx.impls {
        match associated_binding(impl_info, name) {
            Option::Some(associated) => {
                let substitutions = instantiate_substitutions(
                    ctx.counter,
                    impl_info.generics,
                    Vec::new(),
                );
                let owner = substitute_type(impl_info.for_type, substitutions);
                let application = substitute_trait_ref(impl_info.trait_ref, substitutions);
                if unify(owner, base) {
                    let trait_matches = match qualifier {
                        Option::Some(reference) => trait_refs_equal(
                            Option::Some(reference),
                            Option::Some(application),
                        ),
                        Option::None => true,
                    };
                    if trait_matches {
                        let candidate = substitute_type(associated, substitutions);
                        match result.get() {
                            Option::Some(previous) => if !types_equal(previous, candidate) {
                                matches.set(matches.get() + 1)
                            } else {
                                ()
                            },
                            Option::None => {
                                matches.set(1);
                                result.set(Option::Some(candidate))
                            },
                        }
                    } else {
                        ()
                    }
                } else {
                    ()
                }
            },
            Option::None => (),
        }
    };
    if matches.get() == 1 {
        result.get()
    } else {
        Option::None
    }
}

fn normalize_types(ctx: Checker, values: Vec[Type]) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    for value in values {
        result.push(normalize_type(ctx, value))
    };
    result
}

fn normalize_type(ctx: Checker, value: Type) -> Type {
    match prune(value) {
        Type::Tuple(values) => Type::Tuple(normalize_types(ctx, values)),
        Type::Projection(base, name, qualifier) => {
            let base = normalize_type(ctx, base);
            let qualifier = match qualifier {
                Option::Some(reference) => Option::Some(normalize_trait_ref(ctx, reference)),
                Option::None => Option::None,
            };
            let projection = Type::Projection(base, name, qualifier);
            let candidate = match projection_equality(ctx, base, name, qualifier) {
                Option::Some(value) => Option::Some(value),
                Option::None => match builtin_projection(base, name, qualifier) {
                    Option::Some(value) => Option::Some(value),
                    Option::None => match base {
                        Type::Param(_) | Type::Var(_) => Option::None,
                        _ => impl_projection(ctx, base, name, qualifier),
                    },
                },
            };
            match candidate {
                Option::Some(value) => if types_equal(value, projection) {
                    projection
                } else {
                    normalize_type(ctx, value)
                },
                Option::None => projection,
            }
        },
        Type::App(base, args) => {
            Type::App(normalize_type(ctx, base), normalize_types(ctx, args))
        },
        Type::Array(length, elem) => Type::Array(length, normalize_type(ctx, elem)),
        Type::Slice(elem) => Type::Slice(normalize_type(ctx, elem)),
        Type::VecType(elem) => Type::VecType(normalize_type(ctx, elem)),
        Type::RefType(elem) => Type::RefType(normalize_type(ctx, elem)),
        Type::HashMap(key, item) => {
            Type::HashMap(normalize_type(ctx, key), normalize_type(ctx, item))
        },
        Type::Func(params, ret_ty) => {
            Type::Func(normalize_types(ctx, params), normalize_type(ctx, ret_ty))
        },
        other => other,
    }
}

fn normalize_trait_ref(ctx: Checker, value: TraitRef) -> TraitRef {
    TraitRef {
        name: value.name,
        args: normalize_types(ctx, value.args),
    }
}

fn normalize_callable(ctx: Checker, value: Callable) -> Callable {
    match value {
        Callable::TraitMethod(reference, name) => {
            Callable::TraitMethod(reference, name)
        },
        Callable::InherentMethod(owner, name) => {
            Callable::InherentMethod(normalize_type(ctx, owner), name)
        },
        other => other,
    }
}

fn find_substitution(values: Vec[TypeSubst], name: string) -> Option[Type] {
    let result = Ref::new(Option::None);
    for value in values {
        if value.name == name {
            result.set(Option::Some(value.ty))
        } else {
            ()
        }
    };
    result.get()
}

fn substitute_type(value: Type, substitutions: Vec[TypeSubst]) -> Type {
    match prune(value) {
        Type::Param(name) => match find_substitution(substitutions, name) {
            Option::Some(ty) => ty,
            Option::None => Type::Param(name),
        },
        Type::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(substitute_type(item, substitutions))
            };
            Type::Tuple(result)
        },
        Type::Projection(base, name, qualifier) => {
            let qualifier = match qualifier {
                Option::Some(reference) => {
                    Option::Some(substitute_trait_ref(reference, substitutions))
                },
                Option::None => Option::None,
            };
            Type::Projection(substitute_type(base, substitutions), name, qualifier)
        },
        Type::App(base, args) => {
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(substitute_type(arg, substitutions))
            };
            Type::App(substitute_type(base, substitutions), result)
        },
        Type::Array(length, elem) => {
            Type::Array(length, substitute_type(elem, substitutions))
        },
        Type::Slice(elem) => Type::Slice(substitute_type(elem, substitutions)),
        Type::VecType(elem) => Type::VecType(substitute_type(elem, substitutions)),
        Type::RefType(elem) => Type::RefType(substitute_type(elem, substitutions)),
        Type::HashMap(key, item) => Type::HashMap(
            substitute_type(key, substitutions),
            substitute_type(item, substitutions),
        ),
        Type::Func(params, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for param in params {
                result.push(substitute_type(param, substitutions))
            };
            Type::Func(result, substitute_type(ret_ty, substitutions))
        },
        other => other,
    }
}

pub fn substitute_params(value: Type, names: Vec[string], args: Vec[Type]) -> Type {
    let substitutions: Vec[TypeSubst] = Vec::new();
    for index in range(0, names.len()) {
        if index < args.len() {
            substitutions.push(TypeSubst {
                name: names.get(index),
                ty: args.get(index),
            })
        } else {
            ()
        }
    };
    substitute_type(value, substitutions)
}

fn instantiate_substitutions(
    counter: Ref[int32],
    params: Vec[string],
    explicit: Vec[Type],
) -> Vec[TypeSubst] {
    let result: Vec[TypeSubst] = Vec::new();
    for index in range(0, params.len()) {
        result.push(TypeSubst {
            name: params.get(index),
            ty: if index < explicit.len() {
                explicit.get(index)
            } else {
                fresh_type(counter, VarKind::Any)
            },
        })
    };
    result
}

pub fn resolve_type(value: Type) -> Type {
    match prune(value) {
        Type::Var(variable) => match variable.get() {
            TypeVar::Link(inner) => resolve_type(inner),
            TypeVar::Unbound(_, VarKind::Integer) => {
                variable.set(TypeVar::Link(Type::Int32));
                Type::Int32
            },
            TypeVar::Unbound(_, VarKind::Float) => {
                variable.set(TypeVar::Link(Type::Float64));
                Type::Float64
            },
            TypeVar::Unbound(_, VarKind::Any) => Type::Error,
        },
        Type::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(resolve_type(item))
            };
            Type::Tuple(result)
        },
        Type::Projection(base, name, qualifier) => {
            let qualifier = match qualifier {
                Option::Some(reference) => {
                    let args: Vec[Type] = Vec::new();
                    for arg in reference.args {
                        args.push(resolve_type(arg))
                    };
                    Option::Some(TraitRef {
                        name: reference.name,
                        args,
                    })
                },
                Option::None => Option::None,
            };
            Type::Projection(resolve_type(base), name, qualifier)
        },
        Type::App(base, args) => {
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(resolve_type(arg))
            };
            Type::App(resolve_type(base), result)
        },
        Type::Array(length, elem) => Type::Array(length, resolve_type(elem)),
        Type::Slice(elem) => Type::Slice(resolve_type(elem)),
        Type::VecType(elem) => Type::VecType(resolve_type(elem)),
        Type::RefType(elem) => Type::RefType(resolve_type(elem)),
        Type::HashMap(key, item) => Type::HashMap(resolve_type(key), resolve_type(item)),
        Type::Func(params, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for param in params {
                result.push(resolve_type(param))
            };
            Type::Func(result, resolve_type(ret_ty))
        },
        other => other,
    }
}

fn type_constructor_name(value: Type) -> Option[string] {
    match prune(value) {
        Type::Con(name) => Option::Some(name),
        Type::App(base, _) => type_constructor_name(base),
        Type::Slice(_) => Option::Some("Slice"),
        Type::VecType(_) => Option::Some("Vec"),
        Type::RefType(_) => Option::Some("Ref"),
        Type::HashMap(_, _) => Option::Some("HashMap"),
        Type::Unit => Option::Some("unit"),
        Type::Bool => Option::Some("bool"),
        Type::Int8 => Option::Some("int8"),
        Type::Int16 => Option::Some("int16"),
        Type::Int32 => Option::Some("int32"),
        Type::Int64 => Option::Some("int64"),
        Type::Uint8 => Option::Some("uint8"),
        Type::Uint16 => Option::Some("uint16"),
        Type::Uint32 => Option::Some("uint32"),
        Type::Uint64 => Option::Some("uint64"),
        Type::Float32 => Option::Some("float32"),
        Type::Float64 => Option::Some("float64"),
        Type::String => Option::Some("string"),
        Type::Char => Option::Some("char"),
        Type::Param(name) => Option::Some(name),
        _ => Option::None,
    }
}

fn nominal_type(name: string, args: Vec[Type]) -> Type {
    if name == "Vec" && args.len() == 1 {
        Type::VecType(args.get(0))
    } else if name == "Slice" && args.len() == 1 {
        Type::Slice(args.get(0))
    } else if name == "Ref" && args.len() == 1 {
        Type::RefType(args.get(0))
    } else if name == "HashMap" && args.len() == 2 {
        Type::HashMap(args.get(0), args.get(1))
    } else if args.len() == 0 {
        Type::Con(name)
    } else {
        Type::App(Type::Con(name), args)
    }
}

fn parse_array_length(value: string) -> int32 {
    let result = Ref::new(0);
    for index in range(0, value.byte_len()) {
        let byte = value.byte_get(index);
        if byte >= 48u8 && byte <= 57u8 {
            result.set(result.get() * 10 + (byte - 48u8) as int32)
        } else {
            ()
        }
    };
    result.get()
}
