package tast;

struct TypeSubst {
    name: string,
    ty: Type,
}

fn merge_var_kind(left: VarKind, right: VarKind) -> Option[VarKind] {
    match (left, right) {
        (VarKind::Any, value) => Option::Some(value),
        (value, VarKind::Any) => Option::Some(value),
        (VarKind::Integer, VarKind::Integer) => Option::Some(VarKind::Integer),
        (VarKind::Float, VarKind::Float) => Option::Some(VarKind::Float),
        _ => Option::None,
    }
}

fn is_integer_type(value: Type) -> bool {
    match prune(value) {
        Type::Int8
        | Type::Int16
        | Type::Int32
        | Type::Int64
        | Type::Uint8
        | Type::Uint16
        | Type::Uint32
        | Type::Uint64 => true,
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound(_, VarKind::Integer) => true,
            TypeVar::Link(inner) => is_integer_type(inner),
            _ => false,
        },
        _ => false,
    }
}

fn is_float_type(value: Type) -> bool {
    match prune(value) {
        Type::Float32 | Type::Float64 => true,
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound(_, VarKind::Float) => true,
            TypeVar::Link(inner) => is_float_type(inner),
            _ => false,
        },
        _ => false,
    }
}

fn is_numeric_type(value: Type) -> bool {
    is_integer_type(value) || is_float_type(value)
}

fn kind_accepts(kind: VarKind, value: Type) -> bool {
    match kind {
        VarKind::Any => true,
        VarKind::Integer => is_integer_type(value),
        VarKind::Float => is_float_type(value),
    }
}

fn fresh_type(counter: Ref[int32], kind: VarKind) -> Type {
    let index = counter.get();
    counter.set(index + 1);
    Type::Var(Ref::new(TypeVar::Unbound(index, kind)))
}

fn prune(value: Type) -> Type {
    match value {
        Type::Var(variable) => match variable.get() {
            TypeVar::Link(inner) => {
                let resolved = prune(inner);
                variable.set(TypeVar::Link(resolved));
                resolved
            },
            TypeVar::Unbound(_, _) => Type::Var(variable),
        },
        _ => value,
    }
}

fn occurs(variable: Ref[TypeVar], value: Type) -> bool {
    match prune(value) {
        Type::Var(other) => ptr_eq(variable, other),
        Type::Tuple(values) => {
            let found = Ref::new(false);
            for item in values {
                if occurs(variable, item) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Projection(base, _) => occurs(variable, base),
        Type::App(base, args) => {
            let found = Ref::new(occurs(variable, base));
            for arg in args {
                if occurs(variable, arg) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Array(_, elem)
        | Type::Slice(elem)
        | Type::VecType(elem)
        | Type::RefType(elem) => occurs(variable, elem),
        Type::HashMap(key, item) => occurs(variable, key) || occurs(variable, item),
        Type::Func(params, ret_ty) => {
            let found = Ref::new(occurs(variable, ret_ty));
            for param in params {
                if occurs(variable, param) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        _ => false,
    }
}

fn bind_variable(variable: Ref[TypeVar], value: Type) -> bool {
    if occurs(variable, value) {
        false
    } else {
        match variable.get() {
            TypeVar::Link(inner) => unify(inner, value),
            TypeVar::Unbound(_, kind) => if kind_accepts(kind, value) {
                variable.set(TypeVar::Link(value));
                true
            } else {
                false
            },
        }
    }
}

fn unify_types(left: Vec[Type], right: Vec[Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        let valid = Ref::new(true);
        for index in range(0, left.len()) {
            if !unify(left.get(index), right.get(index)) {
                valid.set(false)
            } else {
                ()
            }
        };
        valid.get()
    }
}

fn unify(left: Type, right: Type) -> bool {
    let left = prune(left);
    let right = prune(right);
    match (left, right) {
        (Type::Error, _) | (_, Type::Error) => true,
        (Type::Var(first), Type::Var(second)) => if ptr_eq(first, second) {
            true
        } else {
            match (first.get(), second.get()) {
                (TypeVar::Link(inner), _) => unify(inner, Type::Var(second)),
                (_, TypeVar::Link(inner)) => unify(Type::Var(first), inner),
                (TypeVar::Unbound(_, first_kind), TypeVar::Unbound(second_id, second_kind)) => {
                    match merge_var_kind(first_kind, second_kind) {
                        Option::Some(kind) => {
                            second.set(TypeVar::Unbound(second_id, kind));
                            first.set(TypeVar::Link(Type::Var(second)));
                            true
                        },
                        Option::None => false,
                    }
                },
            }
        },
        (Type::Var(variable), value) => bind_variable(variable, value),
        (value, Type::Var(variable)) => bind_variable(variable, value),
        (Type::Unit, Type::Unit)
        | (Type::Bool, Type::Bool)
        | (Type::Int8, Type::Int8)
        | (Type::Int16, Type::Int16)
        | (Type::Int32, Type::Int32)
        | (Type::Int64, Type::Int64)
        | (Type::Uint8, Type::Uint8)
        | (Type::Uint16, Type::Uint16)
        | (Type::Uint32, Type::Uint32)
        | (Type::Uint64, Type::Uint64)
        | (Type::Float32, Type::Float32)
        | (Type::Float64, Type::Float64)
        | (Type::String, Type::String)
        | (Type::Char, Type::Char) => true,
        (Type::Tuple(first), Type::Tuple(second)) => unify_types(first, second),
        (Type::Con(first), Type::Con(second)) => first == second,
        (Type::Dyn(first), Type::Dyn(second)) => first == second,
        (Type::Projection(first_base, first_name), Type::Projection(second_base, second_name)) => {
            first_name == second_name && unify(first_base, second_base)
        },
        (Type::App(first_base, first_args), Type::App(second_base, second_args)) => {
            unify(first_base, second_base) && unify_types(first_args, second_args)
        },
        (Type::Array(first_len, first_elem), Type::Array(second_len, second_elem)) => {
            (first_len < 0 || second_len < 0 || first_len == second_len)
                && unify(first_elem, second_elem)
        },
        (Type::Slice(first), Type::Slice(second))
        | (Type::VecType(first), Type::VecType(second))
        | (Type::RefType(first), Type::RefType(second)) => unify(first, second),
        (Type::HashMap(first_key, first_value), Type::HashMap(second_key, second_value)) => {
            unify(first_key, second_key) && unify(first_value, second_value)
        },
        (Type::Param(first), Type::Param(second)) => first == second,
        (Type::Func(first_params, first_ret), Type::Func(second_params, second_ret)) => {
            unify_types(first_params, second_params) && unify(first_ret, second_ret)
        },
        _ => false,
    }
}

fn find_substitution(values: Vec[TypeSubst], name: string) -> Option[Type] {
    let result = Ref::new(Option::None);
    for value in values {
        if value.name == name {
            result.set(Option::Some(value.ty))
        } else {
            ()
        }
    };
    result.get()
}

fn substitute_type(value: Type, substitutions: Vec[TypeSubst]) -> Type {
    match prune(value) {
        Type::Param(name) => match find_substitution(substitutions, name) {
            Option::Some(ty) => ty,
            Option::None => Type::Param(name),
        },
        Type::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(substitute_type(item, substitutions))
            };
            Type::Tuple(result)
        },
        Type::Projection(base, name) => {
            Type::Projection(substitute_type(base, substitutions), name)
        },
        Type::App(base, args) => {
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(substitute_type(arg, substitutions))
            };
            Type::App(substitute_type(base, substitutions), result)
        },
        Type::Array(length, elem) => {
            Type::Array(length, substitute_type(elem, substitutions))
        },
        Type::Slice(elem) => Type::Slice(substitute_type(elem, substitutions)),
        Type::VecType(elem) => Type::VecType(substitute_type(elem, substitutions)),
        Type::RefType(elem) => Type::RefType(substitute_type(elem, substitutions)),
        Type::HashMap(key, item) => Type::HashMap(
            substitute_type(key, substitutions),
            substitute_type(item, substitutions),
        ),
        Type::Func(params, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for param in params {
                result.push(substitute_type(param, substitutions))
            };
            Type::Func(result, substitute_type(ret_ty, substitutions))
        },
        other => other,
    }
}

fn instantiate_substitutions(
    counter: Ref[int32],
    params: Vec[string],
    explicit: Vec[Type],
) -> Vec[TypeSubst] {
    let result: Vec[TypeSubst] = Vec::new();
    for index in range(0, params.len()) {
        result.push(TypeSubst {
            name: params.get(index),
            ty: if index < explicit.len() {
                explicit.get(index)
            } else {
                fresh_type(counter, VarKind::Any)
            },
        })
    };
    result
}

fn resolve_type(value: Type) -> Type {
    match prune(value) {
        Type::Var(variable) => match variable.get() {
            TypeVar::Link(inner) => resolve_type(inner),
            TypeVar::Unbound(_, VarKind::Integer) => {
                variable.set(TypeVar::Link(Type::Int32));
                Type::Int32
            },
            TypeVar::Unbound(_, VarKind::Float) => {
                variable.set(TypeVar::Link(Type::Float64));
                Type::Float64
            },
            TypeVar::Unbound(_, VarKind::Any) => Type::Error,
        },
        Type::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(resolve_type(item))
            };
            Type::Tuple(result)
        },
        Type::Projection(base, name) => Type::Projection(resolve_type(base), name),
        Type::App(base, args) => {
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(resolve_type(arg))
            };
            Type::App(resolve_type(base), result)
        },
        Type::Array(length, elem) => Type::Array(length, resolve_type(elem)),
        Type::Slice(elem) => Type::Slice(resolve_type(elem)),
        Type::VecType(elem) => Type::VecType(resolve_type(elem)),
        Type::RefType(elem) => Type::RefType(resolve_type(elem)),
        Type::HashMap(key, item) => Type::HashMap(resolve_type(key), resolve_type(item)),
        Type::Func(params, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for param in params {
                result.push(resolve_type(param))
            };
            Type::Func(result, resolve_type(ret_ty))
        },
        other => other,
    }
}

fn type_constructor_name(value: Type) -> Option[string] {
    match prune(value) {
        Type::Con(name) => Option::Some(name),
        Type::App(base, _) => type_constructor_name(base),
        Type::Slice(_) => Option::Some("Slice"),
        Type::VecType(_) => Option::Some("Vec"),
        Type::RefType(_) => Option::Some("Ref"),
        Type::HashMap(_, _) => Option::Some("HashMap"),
        Type::Unit => Option::Some("unit"),
        Type::Bool => Option::Some("bool"),
        Type::Int8 => Option::Some("int8"),
        Type::Int16 => Option::Some("int16"),
        Type::Int32 => Option::Some("int32"),
        Type::Int64 => Option::Some("int64"),
        Type::Uint8 => Option::Some("uint8"),
        Type::Uint16 => Option::Some("uint16"),
        Type::Uint32 => Option::Some("uint32"),
        Type::Uint64 => Option::Some("uint64"),
        Type::Float32 => Option::Some("float32"),
        Type::Float64 => Option::Some("float64"),
        Type::String => Option::Some("string"),
        Type::Char => Option::Some("char"),
        Type::Param(name) => Option::Some(name),
        _ => Option::None,
    }
}

fn nominal_type(name: string, args: Vec[Type]) -> Type {
    if name == "Vec" && args.len() == 1 {
        Type::VecType(args.get(0))
    } else if name == "Slice" && args.len() == 1 {
        Type::Slice(args.get(0))
    } else if name == "Ref" && args.len() == 1 {
        Type::RefType(args.get(0))
    } else if name == "HashMap" && args.len() == 2 {
        Type::HashMap(args.get(0), args.get(1))
    } else if args.len() == 0 {
        Type::Con(name)
    } else {
        Type::App(Type::Con(name), args)
    }
}

fn parse_array_length(value: string) -> int32 {
    let result = Ref::new(0);
    for index in range(0, value.byte_len()) {
        let byte = value.byte_get(index);
        if byte >= 48u8 && byte <= 57u8 {
            result.set(result.get() * 10 + (byte - 48u8) as int32)
        } else {
            ()
        }
    };
    result.get()
}
