package tast;

use gomlc::ast;

pub enum VarKind {
    Any,
    Integer,
    Float,
}

pub enum TypeVar {
    Unbound(int, VarKind),
    Link(Type),
}

pub enum Type {
    Var(Ref[TypeVar]),
    Unit,
    Never,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Tuple(Vec[Type]),
    Con(string),
    Dyn(string),
    Projection(Type, string, Option[TraitRef]),
    App(Type, Vec[Type]),
    Array(int, Type),
    Slice(Type),
    VecType(Type),
    RefType(Type),
    HashMap(Type, Type),
    Channel(Type),
    Param(string),
    Func(Vec[Type], Type),
    Error,
}

pub struct TraitRef {
    pub name: string,
    pub args: Vec[Type],
}

pub enum Primitive {
    Unit,
    Bool(bool),
    Int(string),
    Int8(string),
    Int16(string),
    Int32(string),
    Int64(string),
    Uint8(string),
    Uint16(string),
    Uint32(string),
    Uint64(string),
    Float(string),
    Float32(string),
    Float64(string),
    String(string),
    Char(char),
}

pub struct Constructor {
    pub name: string,
    pub fields: Vec[string],
    pub is_struct: bool,
    pub tag: Option[int],
}

pub enum Callable {
    Function(string),
    Runtime(string),
    Intrinsic(string),
    TraitMethod(TraitRef, string),
    DynTraitMethod(string, string, string),
    InherentMethod(Type, string),
}

pub enum BinaryResolution {
    Builtin,
    EqTrait,
}

pub struct ClosureParam {
    pub name: string,
    pub ty: Type,
}

pub enum Expr {
    Var(string, Type),
    Callable(Callable, Type),
    Prim(Primitive, Type),
    Constr(Constructor, Vec[Expr], Type),
    Tuple(Vec[Expr], Type),
    Array(Vec[Expr], Type),
    Closure(Vec[ClosureParam], Expr, Type),
    Block(Block, Type),
    Match(Expr, Vec[Arm], Type),
    If(Expr, Expr, Expr, Type),
    While(Expr, Expr, Type),
    For(Pat, Expr, TraitRef, TraitRef, Type, Expr, Type),
    Break(Type),
    Continue(Type),
    Return(Option[Expr], Type),
    Go(Expr, Type),
    Call(Expr, Vec[Expr], Type),
    Unary(ast::UnaryOp, Expr, Type),
    Cast(Expr, Type),
    Proj(Expr, int, Type),
    Field(Expr, string, Type),
    Index(Expr, Expr, Type),
    Binary(ast::BinaryOp, Expr, Expr, Type, BinaryResolution),
    ToDyn(string, Type, Expr, Type),
}

pub struct Block {
    pub stmts: Vec[Stmt],
    pub tail: Option[Expr],
}

pub enum Stmt {
    Let(bool, Pat, Expr),
    Assign(Expr, Expr),
    Expr(Expr),
}

pub struct Arm {
    pub pat: Pat,
    pub guard: Option[Expr],
    pub body: Expr,
}

pub struct ArrayPatRest {
    pub binding: Option[string],
    pub ty: Type,
}

pub enum Pat {
    Var(string, Type),
    Prim(Primitive, Type),
    Constr(Constructor, Vec[Pat], Type),
    Tuple(Vec[Pat], Type),
    Array(Vec[Pat], Option[ArrayPatRest], Vec[Pat], Type),
    Alias(string, Pat, Type),
    Or(Vec[Pat], Type),
    Range(Primitive, Primitive, bool, Type),
    Wild(Type),
}

pub struct Function {
    pub visibility: ast::Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub params: Vec[(string, Type)],
    pub ret_ty: Type,
    pub body: Block,
}

pub struct ImplBlock {
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub trait_ref: Option[TraitRef],
    pub for_type: Type,
    pub associated_types: Vec[(string, Type)],
    pub methods: Vec[Function],
}

pub enum Item {
    ImplBlock(ImplBlock),
    Function(Function),
}

pub struct EnumVariantDef {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[Type]),
    Struct(Vec[(string, Type)]),
}

pub struct EnumDef {
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariantDef],
}

pub struct StructDef {
    pub name: string,
    pub generics: Vec[string],
    pub fields: Vec[(string, Type)],
    pub public_fields: Vec[string],
    pub has_hidden_fields: bool,
}

pub struct File {
    pub items: Vec[Item],
    pub enums: Vec[EnumDef],
    pub structs: Vec[StructDef],
}

pub struct DiagnosticLabel {
    pub message: string,
    pub source_path: string,
    pub span: ast::Span,
}

pub enum DiagnosticSeverity {
    Error,
    Warning,
}

pub struct Diagnostic {
    pub severity: DiagnosticSeverity,
    pub stage: string,
    pub message: string,
    pub source_path: string,
    pub span: Option[ast::Span],
    pub primary_label: Option[string],
    pub secondary_labels: Vec[DiagnosticLabel],
}

pub struct CheckResult {
    pub tast: Option[File],
    pub diagnostics: Vec[Diagnostic],
}

pub fn diagnostic_message(value: Diagnostic) -> string {
    value.message
}

pub fn expr_type(value: Expr) -> Type {
    match value {
        Expr::Var(_, ty) => ty,
        Expr::Callable(_, ty) => ty,
        Expr::Prim(_, ty) => ty,
        Expr::Constr(_, _, ty) => ty,
        Expr::Tuple(_, ty) => ty,
        Expr::Array(_, ty) => ty,
        Expr::Closure(_, _, ty) => ty,
        Expr::Block(_, ty) => ty,
        Expr::Match(_, _, ty) => ty,
        Expr::If(_, _, _, ty) => ty,
        Expr::While(_, _, ty) => ty,
        Expr::For(_, _, _, _, _, _, ty) => ty,
        Expr::Break(ty) => ty,
        Expr::Continue(ty) => ty,
        Expr::Return(_, ty) => ty,
        Expr::Go(_, ty) => ty,
        Expr::Call(_, _, ty) => ty,
        Expr::Unary(_, _, ty) => ty,
        Expr::Cast(_, ty) => ty,
        Expr::Proj(_, _, ty) => ty,
        Expr::Field(_, _, ty) => ty,
        Expr::Index(_, _, ty) => ty,
        Expr::Binary(_, _, _, ty, _) => ty,
        Expr::ToDyn(_, _, _, ty) => ty,
    }
}

pub fn pat_type(value: Pat) -> Type {
    match value {
        Pat::Var(_, ty) => ty,
        Pat::Prim(_, ty) => ty,
        Pat::Constr(_, _, ty) => ty,
        Pat::Tuple(_, ty) => ty,
        Pat::Array(_, _, _, ty) => ty,
        Pat::Alias(_, _, ty) => ty,
        Pat::Or(_, ty) => ty,
        Pat::Range(_, _, _, ty) => ty,
        Pat::Wild(ty) => ty,
    }
}
