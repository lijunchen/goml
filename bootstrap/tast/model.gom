package tast;

use gomlang::parser::ast;

pub enum VarKind {
    Any,
    Integer,
    Float,
}

pub enum TypeVar {
    Unbound(int32, VarKind),
    Link(Type),
}

pub enum Type {
    Var(Ref[TypeVar]),
    Unit,
    Bool,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Tuple(Vec[Type]),
    Con(string),
    Dyn(string),
    Projection(Type, string, Option[TraitRef]),
    App(Type, Vec[Type]),
    Array(int32, Type),
    Slice(Type),
    VecType(Type),
    RefType(Type),
    HashMap(Type, Type),
    Param(string),
    Func(Vec[Type], Type),
    Error,
}

pub struct TraitRef {
    name: string,
    args: Vec[Type],
}

pub enum Primitive {
    Unit,
    Bool(bool),
    Int(string),
    Int8(string),
    Int16(string),
    Int32(string),
    Int64(string),
    Uint8(string),
    Uint16(string),
    Uint32(string),
    Uint64(string),
    Float(string),
    Float32(string),
    Float64(string),
    String(string),
    Char(char),
}

pub struct Constructor {
    name: string,
    fields: Vec[string],
    is_struct: bool,
}

pub enum Callable {
    Function(string),
    Runtime(string),
    Intrinsic(string),
    TraitMethod(TraitRef, string),
    DynTraitMethod(string, string),
    InherentMethod(Type, string),
}

pub struct ClosureParam {
    name: string,
    ty: Type,
}

pub enum Expr {
    Var(string, Type),
    Callable(Callable, Type),
    Prim(Primitive, Type),
    Constr(Constructor, Vec[Expr], Type),
    Tuple(Vec[Expr], Type),
    Array(Vec[Expr], Type),
    Closure(Vec[ClosureParam], Expr, Type),
    Block(Block, Type),
    Match(Expr, Vec[Arm], Type),
    If(Expr, Expr, Expr, Type),
    While(Expr, Expr, Type),
    For(Pat, Expr, TraitRef, TraitRef, Type, Expr, Type),
    Break(Type),
    Continue(Type),
    Return(Option[Expr], Type),
    Go(Expr, Type),
    Call(Expr, Vec[Expr], Type),
    Unary(ast::UnaryOp, Expr, Type),
    Cast(Expr, Type),
    Proj(Expr, int32, Type),
    Field(Expr, string, Type),
    Index(Expr, Expr, Type),
    Binary(ast::BinaryOp, Expr, Expr, Type),
    ToDyn(string, Type, Expr, Type),
}

pub struct Block {
    stmts: Vec[Stmt],
    tail: Option[Expr],
}

pub enum Stmt {
    Let(bool, Pat, Expr),
    Assign(Expr, Expr),
    Expr(Expr),
}

pub struct Arm {
    pat: Pat,
    guard: Option[Expr],
    body: Expr,
}

pub struct ArrayPatRest {
    binding: Option[string],
    ty: Type,
}

pub enum Pat {
    Var(string, Type),
    Prim(Primitive, Type),
    Constr(Constructor, Vec[Pat], Type),
    Tuple(Vec[Pat], Type),
    Array(Vec[Pat], Option[ArrayPatRest], Vec[Pat], Type),
    Alias(string, Pat, Type),
    Or(Vec[Pat], Type),
    Range(Primitive, Primitive, bool, Type),
    Wild(Type),
}

pub struct Function {
    name: string,
    params: Vec[(string, Type)],
    ret_ty: Type,
    body: Block,
}

pub struct ImplBlock {
    generics: Vec[string],
    trait_ref: Option[TraitRef],
    for_type: Type,
    methods: Vec[Function],
}

pub enum Item {
    ImplBlock(ImplBlock),
    Function(Function),
}

pub struct EnumVariantDef {
    name: string,
    fields: Vec[Type],
}

pub struct EnumDef {
    name: string,
    generics: Vec[string],
    variants: Vec[EnumVariantDef],
}

pub struct StructDef {
    name: string,
    generics: Vec[string],
    fields: Vec[(string, Type)],
}

pub struct File {
    items: Vec[Item],
    enums: Vec[EnumDef],
    structs: Vec[StructDef],
}

pub struct CheckResult {
    tast: Option[File],
    diagnostics: Vec[string],
}

pub fn expr_type(value: Expr) -> Type {
    match value {
        Expr::Var(_, ty) => ty,
        Expr::Callable(_, ty) => ty,
        Expr::Prim(_, ty) => ty,
        Expr::Constr(_, _, ty) => ty,
        Expr::Tuple(_, ty) => ty,
        Expr::Array(_, ty) => ty,
        Expr::Closure(_, _, ty) => ty,
        Expr::Block(_, ty) => ty,
        Expr::Match(_, _, ty) => ty,
        Expr::If(_, _, _, ty) => ty,
        Expr::While(_, _, ty) => ty,
        Expr::For(_, _, _, _, _, _, ty) => ty,
        Expr::Break(ty) => ty,
        Expr::Continue(ty) => ty,
        Expr::Return(_, ty) => ty,
        Expr::Go(_, ty) => ty,
        Expr::Call(_, _, ty) => ty,
        Expr::Unary(_, _, ty) => ty,
        Expr::Cast(_, ty) => ty,
        Expr::Proj(_, _, ty) => ty,
        Expr::Field(_, _, ty) => ty,
        Expr::Index(_, _, ty) => ty,
        Expr::Binary(_, _, _, ty) => ty,
        Expr::ToDyn(_, _, _, ty) => ty,
    }
}

pub fn pat_type(value: Pat) -> Type {
    match value {
        Pat::Var(_, ty) => ty,
        Pat::Prim(_, ty) => ty,
        Pat::Constr(_, _, ty) => ty,
        Pat::Tuple(_, ty) => ty,
        Pat::Array(_, _, _, ty) => ty,
        Pat::Alias(_, _, ty) => ty,
        Pat::Or(_, ty) => ty,
        Pat::Range(_, _, _, ty) => ty,
        Pat::Wild(ty) => ty,
    }
}
