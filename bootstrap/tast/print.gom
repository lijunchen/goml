package tast;

use gomlc::ast;
use std::text;

fn write_spaces(builder: text::StringBuilder, count: int32) -> unit {
    for _ in range(0, count) {
        builder.write_char(' ')
    }
}

fn newline(builder: text::StringBuilder, indent: int32) -> unit {
    builder.write_char('\n');
    write_spaces(builder, indent)
}

fn utf8_width(value: uint8) -> int32 {
    if value < 128u8 {
        1
    } else if value < 224u8 {
        2
    } else if value < 240u8 {
        3
    } else {
        4
    }
}

fn hex_digit(value: uint8) -> char {
    match value {
        0u8 => '0',
        1u8 => '1',
        2u8 => '2',
        3u8 => '3',
        4u8 => '4',
        5u8 => '5',
        6u8 => '6',
        7u8 => '7',
        8u8 => '8',
        9u8 => '9',
        10u8 => 'a',
        11u8 => 'b',
        12u8 => 'c',
        13u8 => 'd',
        14u8 => 'e',
        _ => 'f',
    }
}

fn write_control_escape(builder: text::StringBuilder, value: uint8) -> unit {
    builder.write_string("\\u{");
    if value >= 16u8 {
        builder.write_char(hex_digit(value / 16u8))
    } else {
        ()
    };
    builder.write_char(hex_digit(value % 16u8));
    builder.write_char('}')
}

fn write_quoted_string(builder: text::StringBuilder, value: string) -> unit {
    builder.write_char('"');
    let index = Ref::new(0);
    while index.get() < value.byte_len() {
        let byte = value.byte_get(index.get());
        if byte == 34u8 {
            builder.write_string("\\\"")
        } else if byte == 92u8 {
            builder.write_string("\\\\")
        } else if byte == 10u8 {
            builder.write_string("\\n")
        } else if byte == 13u8 {
            builder.write_string("\\r")
        } else if byte == 9u8 {
            builder.write_string("\\t")
        } else if byte == 0u8 {
            builder.write_string("\\0")
        } else if byte < 32u8 || byte == 127u8 {
            write_control_escape(builder, byte)
        } else {
            let width = utf8_width(byte);
            builder.write_string(value.byte_slice(index.get(), index.get() + width))
        };
        index.set(index.get() + utf8_width(byte))
    };
    builder.write_char('"')
}

fn write_quoted_char(builder: text::StringBuilder, value: char) -> unit {
    builder.write_char('\'');
    let code = value as uint32;
    if value == '\'' {
        builder.write_string("\\'")
    } else if value == '\\' {
        builder.write_string("\\\\")
    } else if value == '\n' {
        builder.write_string("\\n")
    } else if value == '\r' {
        builder.write_string("\\r")
    } else if value == '\t' {
        builder.write_string("\\t")
    } else if code == 0u32 {
        builder.write_string("\\0")
    } else if code < 32u32 || code == 127u32 {
        write_control_escape(builder, code as uint8)
    } else {
        builder.write_char(value)
    };
    builder.write_char('\'')
}

fn write_types(builder: text::StringBuilder, values: Vec[Type]) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        write_type(builder, value);
        index.set(index.get() + 1)
    }
}

pub fn write_type(builder: text::StringBuilder, value: Type) -> unit {
    match resolve_type(value) {
        Type::Unit => builder.write_string("unit"),
        Type::Never => builder.write_string("never"),
        Type::Bool => builder.write_string("bool"),
        Type::Int8 => builder.write_string("int8"),
        Type::Int16 => builder.write_string("int16"),
        Type::Int32 => builder.write_string("int32"),
        Type::Int64 => builder.write_string("int64"),
        Type::Uint8 => builder.write_string("uint8"),
        Type::Uint16 => builder.write_string("uint16"),
        Type::Uint32 => builder.write_string("uint32"),
        Type::Uint64 => builder.write_string("uint64"),
        Type::Float32 => builder.write_string("float32"),
        Type::Float64 => builder.write_string("float64"),
        Type::String => builder.write_string("string"),
        Type::Char => builder.write_string("char"),
        Type::Tuple(values) => {
            builder.write_char('(');
            write_types(builder, values);
            builder.write_char(')')
        },
        Type::Con(name) => builder.write_string(name),
        Type::Dyn(name) => {
            builder.write_string("dyn ");
            builder.write_string(name)
        },
        Type::Projection(base, name, _) => {
            write_type(builder, base);
            builder.write_string("::");
            builder.write_string(name)
        },
        Type::App(base, args) => {
            write_type(builder, base);
            if args.len() > 0 {
                builder.write_char('[');
                write_types(builder, args);
                builder.write_char(']')
            } else {
                ()
            }
        },
        Type::Array(length, elem) => {
            builder.write_char('[');
            write_type(builder, elem);
            builder.write_string("; ");
            builder.write_string(length.to_string());
            builder.write_char(']')
        },
        Type::Slice(elem) => {
            builder.write_string("Slice[");
            write_type(builder, elem);
            builder.write_char(']')
        },
        Type::VecType(elem) => {
            builder.write_string("Vec[");
            write_type(builder, elem);
            builder.write_char(']')
        },
        Type::RefType(elem) => {
            builder.write_string("Ref[");
            write_type(builder, elem);
            builder.write_char(']')
        },
        Type::HashMap(key, value) => {
            builder.write_string("HashMap[");
            write_type(builder, key);
            builder.write_string(", ");
            write_type(builder, value);
            builder.write_char(']')
        },
        Type::Param(name) => builder.write_string(name),
        Type::Func(params, ret_ty) => {
            builder.write_char('(');
            write_types(builder, params);
            builder.write_string(") -> ");
            write_type(builder, ret_ty)
        },
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound(index, _) => {
                builder.write_string("TypeVar(");
                builder.write_string(index.to_string());
                builder.write_char(')')
            },
            TypeVar::Link(inner) => write_type(builder, inner),
        },
        Type::Error => builder.write_string("<error>"),
    }
}

fn type_text(value: Type) -> string {
    let builder = text::StringBuilder::new();
    write_type(builder, value);
    builder.finish()
}

fn diagnostic_type(value: Type) -> Type {
    match prune(value) {
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound(_, VarKind::Integer) => Type::Int32,
            TypeVar::Unbound(_, VarKind::Float) => Type::Float64,
            TypeVar::Unbound(_, VarKind::Any) => Type::Con("unknown"),
            TypeVar::Link(inner) => diagnostic_type(inner),
        },
        Type::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for value in values {
                result.push(diagnostic_type(value))
            };
            Type::Tuple(result)
        },
        Type::Projection(base, name, qualifier) => {
            let qualifier = match qualifier {
                Option::Some(reference) => Option::Some(diagnostic_trait_ref(reference)),
                Option::None => Option::None,
            };
            Type::Projection(diagnostic_type(base), name, qualifier)
        },
        Type::App(base, args) => {
            let result: Vec[Type] = Vec::new();
            for value in args {
                result.push(diagnostic_type(value))
            };
            Type::App(diagnostic_type(base), result)
        },
        Type::Array(length, elem) => Type::Array(length, diagnostic_type(elem)),
        Type::Slice(elem) => Type::Slice(diagnostic_type(elem)),
        Type::VecType(elem) => Type::VecType(diagnostic_type(elem)),
        Type::RefType(elem) => Type::RefType(diagnostic_type(elem)),
        Type::HashMap(key, value) => {
            Type::HashMap(diagnostic_type(key), diagnostic_type(value))
        },
        Type::Func(params, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for value in params {
                result.push(diagnostic_type(value))
            };
            Type::Func(result, diagnostic_type(ret_ty))
        },
        other => other,
    }
}

fn diagnostic_trait_ref(value: TraitRef) -> TraitRef {
    let args: Vec[Type] = Vec::new();
    for value in value.args {
        args.push(diagnostic_type(value))
    };
    TraitRef {
        name: value.name,
        args,
    }
}

pub fn diagnostic_type_text(value: Type) -> string {
    type_text(diagnostic_type(value))
}

pub fn write_trait_ref(builder: text::StringBuilder, value: TraitRef) -> unit {
    builder.write_string(value.name);
    if value.args.len() > 0 {
        builder.write_char('[');
        write_types(builder, value.args);
        builder.write_char(']')
    } else {
        ()
    }
}

fn trait_ref_text(value: TraitRef) -> string {
    let builder = text::StringBuilder::new();
    write_trait_ref(builder, value);
    builder.finish()
}

pub fn write_primitive(builder: text::StringBuilder, value: Primitive) -> unit {
    match value {
        Primitive::Unit => builder.write_string("()"),
        Primitive::Bool(value) => builder.write_string(if value { "true" } else { "false" }),
        Primitive::Int(value)
        | Primitive::Int8(value)
        | Primitive::Int16(value)
        | Primitive::Int32(value)
        | Primitive::Int64(value)
        | Primitive::Uint8(value)
        | Primitive::Uint16(value)
        | Primitive::Uint32(value)
        | Primitive::Uint64(value)
        | Primitive::Float(value)
        | Primitive::Float32(value)
        | Primitive::Float64(value) => builder.write_string(value),
        Primitive::String(value) => write_quoted_string(builder, value),
        Primitive::Char(value) => write_quoted_char(builder, value),
    }
}

pub fn unary_symbol(value: ast::UnaryOp) -> string {
    match value {
        ast::UnaryOp::Neg => "-",
        ast::UnaryOp::Not => "!",
        ast::UnaryOp::BitNot => "~",
    }
}

pub fn binary_symbol(value: ast::BinaryOp) -> string {
    match value {
        ast::BinaryOp::Add => "+",
        ast::BinaryOp::Sub => "-",
        ast::BinaryOp::Mul => "*",
        ast::BinaryOp::Div => "/",
        ast::BinaryOp::Rem => "%",
        ast::BinaryOp::BitAnd => "&",
        ast::BinaryOp::BitOr => "|",
        ast::BinaryOp::BitXor => "^",
        ast::BinaryOp::Shl => "<<",
        ast::BinaryOp::Shr => ">>",
        ast::BinaryOp::And => "&&",
        ast::BinaryOp::Or => "||",
        ast::BinaryOp::Less => "<",
        ast::BinaryOp::Greater => ">",
        ast::BinaryOp::LessEq => "<=",
        ast::BinaryOp::GreaterEq => ">=",
        ast::BinaryOp::Eq => "==",
        ast::BinaryOp::NotEq => "!=",
    }
}

fn write_callable(builder: text::StringBuilder, value: Callable) -> unit {
    match value {
        Callable::Function(name) => builder.write_string(name),
        Callable::Runtime(name) => {
            builder.write_string("@runtime(");
            builder.write_string(name);
            builder.write_char(')')
        },
        Callable::Intrinsic(name) => {
            builder.write_string("@intrinsic(");
            builder.write_string(name);
            builder.write_char(')')
        },
        Callable::TraitMethod(reference, name) => {
            write_trait_ref(builder, reference);
            builder.write_string("::");
            builder.write_string(name)
        },
        Callable::DynTraitMethod(owner, _, name) => {
            builder.write_string("dyn ");
            builder.write_string(owner);
            builder.write_string("::");
            builder.write_string(name)
        },
        Callable::InherentMethod(owner, name) => {
            write_type(builder, owner);
            builder.write_string("::");
            builder.write_string(name)
        },
    }
}

fn write_exprs(
    builder: text::StringBuilder,
    values: Vec[Expr],
    indent: int32,
) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        write_expr(builder, value, indent);
        index.set(index.get() + 1)
    }
}

fn write_constructor_expr(
    builder: text::StringBuilder,
    constructor: Constructor,
    args: Vec[Expr],
    indent: int32,
) -> unit {
    builder.write_string(constructor.name);
    if constructor.is_struct {
        if args.len() == 0 {
            builder.write_string(" {}")
        } else {
            builder.write_string(" { ");
            for index in range(0, args.len()) {
                if index > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                if index < constructor.fields.len() {
                    builder.write_string(constructor.fields.get(index));
                    builder.write_string(": ")
                } else {
                    ()
                };
                write_expr(builder, args.get(index), indent)
            };
            builder.write_string(" }")
        }
    } else if args.len() > 0 {
        builder.write_char('(');
        write_exprs(builder, args, indent);
        builder.write_char(')')
    } else {
        ()
    }
}

fn write_block(builder: text::StringBuilder, value: Block, indent: int32) -> unit {
    if value.stmts.len() == 0 {
        match value.tail {
            Option::None => builder.write_string("{}"),
            Option::Some(tail) => {
                builder.write_char('{');
                newline(builder, indent + 4);
                write_expr(builder, tail, indent + 4);
                newline(builder, indent);
                builder.write_char('}')
            },
        }
    } else {
        builder.write_char('{');
        for stmt in value.stmts {
            newline(builder, indent + 4);
            write_stmt(builder, stmt, indent + 4);
            builder.write_char(';')
        };
        match value.tail {
            Option::Some(tail) => {
                newline(builder, indent + 4);
                write_expr(builder, tail, indent + 4)
            },
            Option::None => (),
        };
        newline(builder, indent);
        builder.write_char('}')
    }
}

fn write_stmt(builder: text::StringBuilder, value: Stmt, indent: int32) -> unit {
    match value {
        Stmt::Let(is_mut, pat, expr) => {
            builder.write_string("let ");
            if is_mut {
                builder.write_string("mut ")
            } else {
                ()
            };
            write_pat(builder, pat, indent);
            builder.write_string(" = ");
            write_expr(builder, expr, indent)
        },
        Stmt::Assign(target, value) => {
            write_expr(builder, target, indent);
            builder.write_string(" = ");
            write_expr(builder, value, indent)
        },
        Stmt::Expr(value) => write_expr(builder, value, indent),
    }
}

fn write_expr(builder: text::StringBuilder, value: Expr, indent: int32) -> unit {
    match value {
        Expr::Var(name, ty) => {
            builder.write_char('(');
            builder.write_string(name);
            builder.write_string(" : ");
            write_type(builder, ty);
            builder.write_char(')')
        },
        Expr::Callable(callable, ty) => {
            builder.write_char('(');
            write_callable(builder, callable);
            builder.write_string(" : ");
            write_type(builder, ty);
            builder.write_char(')')
        },
        Expr::Prim(value, _) => write_primitive(builder, value),
        Expr::Constr(constructor, args, _) => {
            write_constructor_expr(builder, constructor, args, indent)
        },
        Expr::Tuple(values, _) => {
            builder.write_char('(');
            write_exprs(builder, values, indent);
            builder.write_char(')')
        },
        Expr::Array(values, _) => {
            builder.write_char('[');
            write_exprs(builder, values, indent + 2);
            builder.write_char(']')
        },
        Expr::Closure(params, body, _) => {
            if params.len() == 0 {
                builder.write_string("||")
            } else {
                builder.write_char('|');
                for index in range(0, params.len()) {
                    if index > 0 {
                        builder.write_string(", ")
                    } else {
                        ()
                    };
                    let param = params.get(index);
                    builder.write_string(param.name);
                    builder.write_string(": ");
                    write_type(builder, param.ty)
                };
                builder.write_char('|')
            };
            builder.write_string(" => ");
            write_expr(builder, body, indent)
        },
        Expr::Block(block, _) => write_block(builder, block, indent),
        Expr::Match(source, arms, _) => {
            builder.write_string("match ");
            write_expr(builder, source, indent);
            builder.write_string(" {");
            for arm in arms {
                newline(builder, indent + 4);
                write_arm(builder, arm, indent + 4)
            };
            newline(builder, indent);
            builder.write_char('}')
        },
        Expr::If(cond, then_branch, else_branch, _) => {
            builder.write_string("if ");
            write_expr(builder, cond, indent);
            builder.write_string(" {");
            newline(builder, indent + 4);
            write_expr(builder, then_branch, indent + 4);
            newline(builder, indent);
            builder.write_string("} else {");
            newline(builder, indent + 4);
            write_expr(builder, else_branch, indent + 4);
            newline(builder, indent);
            builder.write_char('}')
        },
        Expr::While(cond, body, _) => {
            builder.write_string("while ");
            write_expr(builder, cond, indent);
            builder.write_string(" {");
            newline(builder, indent + 4);
            write_expr(builder, body, indent + 4);
            newline(builder, indent);
            builder.write_char('}')
        },
        Expr::For(pat, iterator, _, _, _, body, _) => {
            builder.write_string("for ");
            write_pat(builder, pat, indent);
            builder.write_string(" in ");
            write_expr(builder, iterator, indent);
            builder.write_char(' ');
            write_expr(builder, body, indent)
        },
        Expr::Break(_) => builder.write_string("break"),
        Expr::Continue(_) => builder.write_string("continue"),
        Expr::Return(value, _) => {
            builder.write_string("return");
            match value {
                Option::Some(expr) => {
                    builder.write_char(' ');
                    write_expr(builder, expr, indent)
                },
                Option::None => (),
            }
        },
        Expr::Go(value, _) => {
            builder.write_string("go ");
            write_expr(builder, value, indent)
        },
        Expr::Call(function, args, _) => {
            write_expr(builder, function, indent);
            builder.write_char('(');
            write_exprs(builder, args, indent);
            builder.write_char(')')
        },
        Expr::Unary(op, value, _) => {
            builder.write_string(unary_symbol(op));
            write_expr(builder, value, indent)
        },
        Expr::Cast(value, ty) => {
            write_expr(builder, value, indent);
            builder.write_string(" as ");
            write_type(builder, ty)
        },
        Expr::Proj(value, index, _) => {
            write_expr(builder, value, indent);
            builder.write_char('.');
            builder.write_string(index.to_string())
        },
        Expr::Field(value, name, _) => {
            write_expr(builder, value, indent);
            builder.write_char('.');
            builder.write_string(name)
        },
        Expr::Index(base, index, _) => {
            write_expr(builder, base, indent);
            builder.write_char('[');
            write_expr(builder, index, indent);
            builder.write_char(']')
        },
        Expr::Binary(op, left, right, _, _) => {
            write_expr(builder, left, indent);
            builder.write_char(' ');
            builder.write_string(binary_symbol(op));
            builder.write_char(' ');
            write_expr(builder, right, indent)
        },
        Expr::ToDyn(trait_name, for_ty, value, _) => {
            builder.write_string("to_dyn[");
            builder.write_string(trait_name);
            builder.write_string("]{");
            write_type(builder, for_ty);
            builder.write_string("}(");
            write_expr(builder, value, indent);
            builder.write_char(')')
        },
    }
}

fn write_pats(builder: text::StringBuilder, values: Vec[Pat], indent: int32) -> unit {
    for index in range(0, values.len()) {
        if index > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        write_pat(builder, values.get(index), indent)
    }
}

fn pat_is_or(value: Pat) -> bool {
    match value {
        Pat::Or(_, _) => true,
        _ => false,
    }
}

fn write_constructor_pat(
    builder: text::StringBuilder,
    constructor: Constructor,
    args: Vec[Pat],
    indent: int32,
) -> unit {
    builder.write_string(constructor.name);
    if constructor.is_struct {
        if args.len() == 0 {
            builder.write_string(" {}")
        } else {
            builder.write_string(" { ");
            for index in range(0, args.len()) {
                if index > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                if index < constructor.fields.len() {
                    builder.write_string(constructor.fields.get(index));
                    builder.write_string(": ")
                } else {
                    ()
                };
                write_pat(builder, args.get(index), indent)
            };
            builder.write_string(" }")
        }
    } else if args.len() > 0 {
        builder.write_char('(');
        write_pats(builder, args, indent);
        builder.write_char(')')
    } else {
        ()
    }
}

fn write_pat(builder: text::StringBuilder, value: Pat, indent: int32) -> unit {
    match value {
        Pat::Var(name, ty) => {
            builder.write_string(name);
            builder.write_string(": ");
            write_type(builder, ty)
        },
        Pat::Prim(value, _) => write_primitive(builder, value),
        Pat::Constr(constructor, args, _) => {
            write_constructor_pat(builder, constructor, args, indent)
        },
        Pat::Tuple(values, _) => {
            builder.write_char('(');
            write_pats(builder, values, indent);
            builder.write_char(')')
        },
        Pat::Array(prefix, rest, suffix, _) => {
            builder.write_char('[');
            let count = Ref::new(0);
            for value in prefix {
                if count.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                write_pat(builder, value, indent);
                count.set(count.get() + 1)
            };
            match rest {
                Option::Some(value) => {
                    if count.get() > 0 {
                        builder.write_string(", ")
                    } else {
                        ()
                    };
                    match value.binding {
                        Option::Some(name) => {
                            builder.write_string(name);
                            builder.write_string(" @ ..")
                        },
                        Option::None => builder.write_string(".."),
                    };
                    count.set(count.get() + 1)
                },
                Option::None => (),
            };
            for value in suffix {
                if count.get() > 0 {
                    builder.write_string(", ")
                } else {
                    ()
                };
                write_pat(builder, value, indent);
                count.set(count.get() + 1)
            };
            builder.write_char(']')
        },
        Pat::Alias(name, pat, _) => {
            builder.write_string(name);
            builder.write_string(" @ ");
            if pat_is_or(pat) {
                builder.write_char('(');
                write_pat(builder, pat, indent);
                builder.write_char(')')
            } else {
                write_pat(builder, pat, indent)
            }
        },
        Pat::Or(values, _) => {
            for index in range(0, values.len()) {
                if index > 0 {
                    builder.write_string(" | ")
                } else {
                    ()
                };
                write_pat(builder, values.get(index), indent)
            }
        },
        Pat::Range(start, end, inclusive, _) => {
            write_primitive(builder, start);
            builder.write_string(if inclusive { "..=" } else { ".." });
            write_primitive(builder, end)
        },
        Pat::Wild(ty) => {
            builder.write_string("_ : ");
            write_type(builder, ty)
        },
    }
}

fn write_arm(builder: text::StringBuilder, value: Arm, indent: int32) -> unit {
    write_pat(builder, value.pat, indent);
    match value.guard {
        Option::Some(guard) => {
            builder.write_string(" if ");
            write_expr(builder, guard, indent)
        },
        Option::None => (),
    };
    builder.write_string(" => ");
    write_expr(builder, value.body, indent + 2);
    builder.write_char(',')
}

fn write_function(builder: text::StringBuilder, value: Function, indent: int32) -> unit {
    builder.write_string("fn ");
    builder.write_string(value.name);
    builder.write_char('(');
    for index in range(0, value.params.len()) {
        if index > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        let param = value.params.get(index);
        builder.write_string(param.0);
        builder.write_string(": ");
        write_type(builder, param.1)
    };
    builder.write_string(") -> ");
    write_type(builder, value.ret_ty);
    builder.write_char(' ');
    write_block(builder, value.body, indent)
}

fn write_impl(builder: text::StringBuilder, value: ImplBlock, indent: int32) -> unit {
    builder.write_string("impl ");
    match value.trait_ref {
        Option::Some(reference) => {
            write_trait_ref(builder, reference);
            builder.write_string(" for ")
        },
        Option::None => (),
    };
    write_type(builder, value.for_type);
    builder.write_char('{');
    for method in value.methods {
        newline(builder, indent + 2);
        write_function(builder, method, indent + 2)
    };
    newline(builder, indent);
    builder.write_char('}')
}

fn write_item(builder: text::StringBuilder, value: Item) -> unit {
    match value {
        Item::ImplBlock(value) => write_impl(builder, value, 0),
        Item::Function(value) => write_function(builder, value, 0),
    }
}

fn encode_file(value: File) -> string {
    let builder = text::StringBuilder::new();
    for index in range(0, value.items.len()) {
        if index > 0 {
            builder.write_string("\n\n")
        } else {
            ()
        };
        write_item(builder, value.items.get(index))
    };
    builder.finish()
}

pub fn encode(value: CheckResult) -> string {
    match value.tast {
        Option::Some(file) => encode_file(file),
        Option::None => {
            let builder = text::StringBuilder::new();
            for diagnostic in value.diagnostics {
                builder.write_string(diagnostic.message);
                builder.write_char('\n')
            };
            builder.finish()
        },
    }
}
