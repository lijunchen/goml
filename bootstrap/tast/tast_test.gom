package tast;

use gomlang::parser::ast;
use gomlang::parser::hir;
use gomlang::parser::parser;
use std::testing;
use std::text;

fn checked_file(source: string) -> File {
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Option::Some(file) => file,
        Option::None => {
            testing::fail("expected TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
            }
        },
    }
}

fn primitive_text(value: Primitive) -> string {
    let builder = text::StringBuilder::new();
    write_primitive(builder, value);
    builder.finish()
}

#[test]
fn erases_indexed_assignment_read_types() -> unit {
    let file = checked_file("fn main() -> unit { let map: HashMap[int32, string] = HashMap::new(); map[1] = \"ok\"; }");
    match file.items.get(0) {
        Item::Function(value) => match value.body.stmts.get(1) {
            Stmt::Assign(Expr::Index(_, _, target_ty), value) => {
                match resolve_type(target_ty) {
                    Type::Unit => (),
                    _ => testing::fail("expected unit assignment target read type"),
                };
                match resolve_type(expr_type(value)) {
                    Type::String => (),
                    _ => testing::fail("expected string assignment value type"),
                }
            },
            _ => testing::fail("expected indexed assignment"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn infers_shift_operands_independently() -> unit {
    let file = checked_file("fn shift(value: uint8) -> uint8 { value << 4 }");
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Binary(ast::BinaryOp::Shl, left, right, ty)) => {
                match resolve_type(expr_type(left)) {
                    Type::Uint8 => (),
                    _ => testing::fail("expected uint8 left operand"),
                };
                match resolve_type(expr_type(right)) {
                    Type::Int32 => (),
                    _ => testing::fail("expected int32 shift count"),
                };
                match resolve_type(ty) {
                    Type::Uint8 => (),
                    _ => testing::fail("expected uint8 shift result"),
                }
            },
            _ => testing::fail("expected shift expression"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn infers_generic_function_calls() -> unit {
    let source = "fn id[T](value: T) -> T { value } fn main() -> string { id(\"ok\") }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(function, args, ty)) => {
                testing::assert_eq(args.len(), 1);
                match resolve_type(ty) {
                    Type::String => (),
                    _ => testing::fail("expected string call result"),
                };
                match function {
                    Expr::Callable(Callable::Function(name), Type::Func(params, ret_ty)) => {
                        testing::assert_eq(name, "id");
                        testing::assert_eq(params.len(), 1);
                        match resolve_type(params.get(0)) {
                            Type::String => (),
                            _ => testing::fail("expected instantiated string parameter"),
                        };
                        match resolve_type(ret_ty) {
                            Type::String => (),
                            _ => testing::fail("expected instantiated string return"),
                        }
                    },
                    _ => testing::fail("expected function callable"),
                }
            },
            _ => testing::fail("expected call tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_reordered_result_try_tags() -> unit {
    let source = "enum Result[T, E] { Err(E), Ok(T), } fn parse(flag: bool) -> Result[int32, string] { if flag { Result::Ok(1) } else { Result::Err(\"bad\") } } fn compute(flag: bool) -> Result[int32, string] { let value = parse(flag)?; Result::Ok(value) }";
    let file = checked_file(source);
    match file.items.get(1) {
        Item::Function(value) => match value.body.stmts.get(0) {
            Stmt::Let(_, _, Expr::Match(_, arms, _)) => {
                match arms.get(0).pat {
                    Pat::Constr(constructor, _, _) => {
                        match constructor.tag {
                            Option::Some(tag) => testing::assert_eq(tag, 1),
                            Option::None => testing::fail("expected success tag"),
                        }
                    },
                    _ => testing::fail("expected success constructor pattern"),
                };
                match arms.get(1).pat {
                    Pat::Constr(constructor, _, _) => {
                        match constructor.tag {
                            Option::Some(tag) => testing::assert_eq(tag, 0),
                            Option::None => testing::fail("expected residual tag"),
                        }
                    },
                    _ => testing::fail("expected residual constructor pattern"),
                };
                match arms.get(1).body {
                    Expr::Return(Option::Some(Expr::Constr(constructor, _, _)), _) => {
                        match constructor.tag {
                            Option::Some(tag) => testing::assert_eq(tag, 0),
                            Option::None => testing::fail("expected return tag"),
                        }
                    },
                    _ => testing::fail("expected residual return constructor"),
                }
            },
            _ => testing::fail("expected try match binding"),
        },
        _ => testing::fail("expected compute function"),
    }
}

#[test]
fn checks_closures_with_call_context() -> unit {
    let source = "fn zip_with[A, B, C](a: A, b: B, f: (A, B) -> C) -> C { f(a, b) } fn main() -> string { zip_with(10, \"hello\", |number, text| text + \"=\" + number.to_string()) }";
    let file = checked_file(source);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(_, args, Type::String)) => match args.get(2) {
                Expr::Closure(params, body, closure_ty) => {
                    match resolve_type(closure_ty) {
                        Type::Func(_, Type::String) => (),
                        _ => testing::fail("expected contextual closure return"),
                    };
                    match (resolve_type(params.get(0).ty), resolve_type(params.get(1).ty)) {
                        (Type::Int32, Type::String) => (),
                        _ => testing::fail("expected contextual closure parameters"),
                    };
                    match body {
                        Expr::Binary(
                            _,
                            _,
                            Expr::Call(
                                Expr::Callable(
                                    Callable::InherentMethod(owner, name),
                                    _,
                                ),
                                _,
                                call_ty,
                            ),
                            body_ty,
                        ) => {
                            testing::assert_eq(name, "to_string");
                            match (
                                resolve_type(owner),
                                resolve_type(call_ty),
                                resolve_type(body_ty),
                            ) {
                                (Type::Int32, Type::String, Type::String) => (),
                                _ => testing::fail("expected contextual int32 method types"),
                            }
                        },
                        _ => testing::fail("expected contextual int32 method"),
                    }
                },
                _ => testing::fail("expected contextual closure argument"),
            },
            _ => testing::fail("expected zip_with call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn infers_trait_goals_from_function_calls() -> unit {
    let source = "trait Measure { fn measure(Self) -> int32; } impl Measure for Vec[int32] { fn measure(self: Vec[int32]) -> int32 { self.len() } } fn read_measure[T: Measure](value: T) -> int32 { Measure::measure(value) } fn main() -> int32 { let values = vec_new(); read_measure(values) }";
    let file = checked_file(source);
    match file.items.get(2) {
        Item::Function(value) => {
            match value.body.stmts.get(0) {
                Stmt::Let(_, Pat::Var(_, pattern_ty), expression) => {
                    match (resolve_type(pattern_ty), resolve_type(expr_type(expression))) {
                        (Type::VecType(Type::Int32), Type::VecType(Type::Int32)) => (),
                        _ => testing::fail("expected inferred Vec[int32] binding"),
                    }
                },
                _ => testing::fail("expected inferred vector binding"),
            };
            match value.body.tail {
                Option::Some(Expr::Call(
                    Expr::Callable(Callable::Function(name), Type::Func(params, Type::Int32)),
                    args,
                    Type::Int32,
                )) => {
                    testing::assert_eq(name, "read_measure");
                    match (
                        resolve_type(params.get(0)),
                        resolve_type(expr_type(args.get(0))),
                    ) {
                        (Type::VecType(Type::Int32), Type::VecType(Type::Int32)) => (),
                        _ => testing::fail("expected inferred trait goal argument"),
                    }
                },
                _ => testing::fail("expected trait constrained function call"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn checks_positional_struct_constructors() -> unit {
    let source = "struct Point { x: int32, y: int32 } struct Wrapper[T] { value: T } fn point() -> Point { Point(1, 2) } fn wrapper() -> Wrapper[string] { Wrapper(\"ok\") }";
    let file = checked_file(source);
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Constr(constructor, values, Type::Con(owner))) => {
                testing::assert_eq(owner, "Point");
                testing::assert_eq(constructor.name, "Point");
                testing::assert_eq(constructor.fields.get(0), "x");
                testing::assert_eq(constructor.fields.get(1), "y");
                match (resolve_type(expr_type(values.get(0))), resolve_type(expr_type(values.get(1)))) {
                    (Type::Int32, Type::Int32) => (),
                    _ => testing::fail("expected int32 positional fields"),
                }
            },
            _ => testing::fail("expected positional Point constructor"),
        },
        _ => testing::fail("expected point function"),
    };
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Constr(
                constructor,
                values,
                Type::App(Type::Con(owner), args),
            )) => {
                testing::assert_eq(owner, "Wrapper");
                testing::assert_eq(constructor.name, "Wrapper");
                match (resolve_type(args.get(0)), resolve_type(expr_type(values.get(0)))) {
                    (Type::String, Type::String) => (),
                    _ => testing::fail("expected string Wrapper field"),
                }
            },
            _ => testing::fail("expected positional Wrapper constructor"),
        },
        _ => testing::fail("expected wrapper function"),
    }
}

#[test]
fn checks_enum_patterns_and_default_integer_literals() -> unit {
    let source = "enum Choice { None, Some(int32) } fn unwrap(value: Choice) -> int32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1);
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Match(_, arms, ty)) => {
                testing::assert_eq(arms.len(), 2);
                match ty {
                    Type::Int32 => (),
                    _ => testing::fail("expected int32 match result"),
                };
                match arms.get(0).pat {
                    Pat::Constr(constructor, args, Type::Con(name)) => {
                        testing::assert_eq(constructor.name, "Choice::Some");
                        testing::assert_eq(args.len(), 1);
                        testing::assert_eq(name, "Choice")
                    },
                    _ => testing::fail("expected constructor pattern"),
                };
                match arms.get(1).body {
                    Expr::Prim(Primitive::Int(value), literal_ty) => {
                        testing::assert_eq(value, "0");
                        match resolve_type(literal_ty) {
                            Type::Int32 => (),
                            _ => testing::fail("expected defaulted int32 literal"),
                        }
                    },
                    _ => testing::fail("expected defaulted int32 literal"),
                }
            },
            _ => testing::fail("expected match tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_associated_types_and_bound_methods() -> unit {
    let source = "trait Provider { type Item; fn get(Self) -> Self::Item; } struct Number { value: int32 } impl Provider for Number { type Item = int32; fn get(self: Number) -> int32 { self.value } } fn read[P: Provider](provider: P) -> P::Item { provider.get() } fn main() -> int32 { read(Number { value: 42 }) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 3);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::TraitMethod(reference, name), _),
                _,
                Type::Projection(Type::Param(owner), associated, _),
            )) => {
                testing::assert_eq(reference.name, "Provider");
                testing::assert_eq(name, "get");
                testing::assert_eq(owner, "P");
                testing::assert_eq(associated, "Item")
            },
            _ => testing::fail("expected bound trait method call"),
        },
        _ => testing::fail("expected read function"),
    };
    match file.items.get(2) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::Function(name), Type::Func(_, ret_ty)),
                _,
                ty,
            )) => {
                testing::assert_eq(name, "read");
                match (resolve_type(ret_ty), resolve_type(ty)) {
                    (Type::Int32, Type::Int32) => (),
                    _ => testing::fail("expected normalized associated type"),
                }
            },
            _ => testing::fail("expected read call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn preserves_projection_equality_owners() -> unit {
    let source = "trait Source { type Item; fn get(Self) -> Self::Item; } struct LeftSource {} struct RightSource {} impl Source for LeftSource { type Item = int32; fn get(self: LeftSource) -> int32 { 1 } } impl Source for RightSource { type Item = int32; fn get(self: RightSource) -> int32 { 2 } } fn combine[A: Source, B: Source](left: A, right: B) -> unit where A::Item == B::Item { () } fn main() -> unit { combine(LeftSource {}, RightSource {}) }";
    let file = checked_file(source);
    match file.items.get(3) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::Function(name), Type::Func(params, Type::Unit)),
                _,
                Type::Unit,
            )) => {
                testing::assert_eq(name, "combine");
                match (resolve_type(params.get(0)), resolve_type(params.get(1))) {
                    (Type::Con(left), Type::Con(right)) => {
                        testing::assert_eq(left, "LeftSource");
                        testing::assert_eq(right, "RightSource")
                    },
                    _ => testing::fail("expected distinct projection equality owners"),
                }
            },
            _ => testing::fail("expected combine call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn checks_extended_builtin_method_catalog() -> unit {
    let source = "fn exercise(text: string, values: Vec[int32], map: HashMap[string, int32]) -> unit { let _ = text.decode_at(0); let _ = text.to_bytes(); let _ = text.chars(); let _ = text.char_indices(); values.reserve(1); values.insert(0, 1); let _ = values.remove(0); let _ = values.swap_remove(0); values.reverse(); let _ = values.last(); let _ = values.pop(); values.truncate(0); values.clear(); let _ = map.entries(); }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1)
}

#[test]
fn prefers_builtin_inherent_methods() -> unit {
    let source = "trait Container { fn is_empty(Self) -> bool; } impl Container for Vec[int32] { fn is_empty(self: Vec[int32]) -> bool { false } } fn main() -> bool { let values: Vec[int32] = Vec::new(); values.is_empty() }";
    let file = checked_file(source);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::InherentMethod(owner, name), _),
                _,
                Type::Bool,
            )) => {
                testing::assert_eq(name, "is_empty");
                match resolve_type(owner) {
                    Type::VecType(Type::Int32) => (),
                    _ => testing::fail("expected Vec[int32] inherent owner"),
                }
            },
            _ => testing::fail("expected builtin inherent method call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn specializes_array_builtin_lengths() -> unit {
    let file = checked_file("fn exercise(values: [int32; 2]) -> int32 { array_set(values, 0, 7); array_get(values, 0) }");
    match file.items.get(0) {
        Item::Function(value) => {
            match value.body.stmts.get(0) {
                Stmt::Expr(Expr::Call(
                    Expr::Callable(Callable::Intrinsic(name), Type::Func(params, Type::Unit)),
                    _,
                    Type::Unit,
                )) => {
                    testing::assert_eq(name, "array.set");
                    match resolve_type(params.get(0)) {
                        Type::Array(2, Type::Int32) => (),
                        _ => testing::fail("expected specialized array.set length"),
                    }
                },
                _ => testing::fail("expected array.set call"),
            };
            match value.body.tail {
                Option::Some(Expr::Call(
                    Expr::Callable(
                        Callable::Intrinsic(name),
                        Type::Func(params, Type::Int32),
                    ),
                    _,
                    Type::Int32,
                )) => {
                    testing::assert_eq(name, "array.get");
                    match resolve_type(params.get(0)) {
                        Type::Array(2, Type::Int32) => (),
                        _ => testing::fail("expected specialized array.get length"),
                    }
                },
                _ => testing::fail("expected array.get call"),
            }
        },
        _ => testing::fail("expected array function"),
    }
}

