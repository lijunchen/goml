package tast;

use gomlang::parser::ast;
use gomlang::parser::hir;
use gomlang::parser::parser;
use std::testing;
use std::text;

fn checked_file(source: string) -> File {
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Option::Some(file) => file,
        Option::None => {
            testing::fail("expected TAST");
            File { items: Vec::new() }
        },
    }
}

fn primitive_text(value: Primitive) -> string {
    let builder = text::StringBuilder::new();
    write_primitive(builder, value);
    builder.finish()
}

#[test]
fn infers_generic_function_calls() -> unit {
    let source = "fn id[T](value: T) -> T { value } fn main() -> string { id(\"ok\") }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(function, args, ty)) => {
                testing::assert_eq(args.len(), 1);
                match resolve_type(ty) {
                    Type::String => (),
                    _ => testing::fail("expected string call result"),
                };
                match function {
                    Expr::Callable(Callable::Function(name), Type::Func(params, ret_ty)) => {
                        testing::assert_eq(name, "id");
                        testing::assert_eq(params.len(), 1);
                        match resolve_type(params.get(0)) {
                            Type::String => (),
                            _ => testing::fail("expected instantiated string parameter"),
                        };
                        match resolve_type(ret_ty) {
                            Type::String => (),
                            _ => testing::fail("expected instantiated string return"),
                        }
                    },
                    _ => testing::fail("expected function callable"),
                }
            },
            _ => testing::fail("expected call tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn checks_enum_patterns_and_default_integer_literals() -> unit {
    let source = "enum Choice { None, Some(int32) } fn unwrap(value: Choice) -> int32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1);
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Match(_, arms, ty)) => {
                testing::assert_eq(arms.len(), 2);
                match ty {
                    Type::Int32 => (),
                    _ => testing::fail("expected int32 match result"),
                };
                match arms.get(0).pat {
                    Pat::Constr(constructor, args, Type::Con(name)) => {
                        testing::assert_eq(constructor.name, "Choice::Some");
                        testing::assert_eq(args.len(), 1);
                        testing::assert_eq(name, "Choice")
                    },
                    _ => testing::fail("expected constructor pattern"),
                };
                match arms.get(1).body {
                    Expr::Prim(Primitive::Int(value), literal_ty) => {
                        testing::assert_eq(value, "0");
                        match resolve_type(literal_ty) {
                            Type::Int32 => (),
                            _ => testing::fail("expected defaulted int32 literal"),
                        }
                    },
                    _ => testing::fail("expected defaulted int32 literal"),
                }
            },
            _ => testing::fail("expected match tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_associated_types_and_bound_methods() -> unit {
    let source = "trait Provider { type Item; fn get(Self) -> Self::Item; } struct Number { value: int32 } impl Provider for Number { type Item = int32; fn get(self: Number) -> int32 { self.value } } fn read[P: Provider](provider: P) -> P::Item { provider.get() } fn main() -> int32 { read(Number { value: 42 }) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 3);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::TraitMethod(reference, name), _),
                _,
                Type::Projection(Type::Param(owner), associated, _),
            )) => {
                testing::assert_eq(reference.name, "Provider");
                testing::assert_eq(name, "get");
                testing::assert_eq(owner, "P");
                testing::assert_eq(associated, "Item")
            },
            _ => testing::fail("expected bound trait method call"),
        },
        _ => testing::fail("expected read function"),
    };
    match file.items.get(2) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::Function(name), Type::Func(_, ret_ty)),
                _,
                ty,
            )) => {
                testing::assert_eq(name, "read");
                match (resolve_type(ret_ty), resolve_type(ty)) {
                    (Type::Int32, Type::Int32) => (),
                    _ => testing::fail("expected normalized associated type"),
                }
            },
            _ => testing::fail("expected read call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn checks_extended_builtin_method_catalog() -> unit {
    let source = "fn exercise(text: string, values: Vec[int32], map: HashMap[string, int32]) -> unit { let _ = text.decode_at(0); let _ = text.to_bytes(); let _ = text.chars(); let _ = text.char_indices(); values.reserve(1); values.insert(0, 1); let _ = values.remove(0); let _ = values.swap_remove(0); values.reverse(); let _ = values.last(); let _ = values.pop(); values.truncate(0); values.clear(); let _ = map.entries(); }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1)
}

#[test]
fn preserves_fn_iterator_static_owner() -> unit {
    let file = checked_file("fn iterator() -> FnIterator[int32] { FnIterator::from_fn(|| Option::None) }");
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::InherentMethod(Type::Con(owner), name), _),
                _,
                _,
            )) => {
                testing::assert_eq(owner, "FnIterator");
                testing::assert_eq(name, "from_fn")
            },
            _ => testing::fail("expected FnIterator static call"),
        },
        _ => testing::fail("expected iterator function"),
    }
}

#[test]
fn normalizes_and_escapes_char_literals() -> unit {
    match parse_char_literal("\\u0041") {
        Option::Some(value) => testing::assert(value == 'A'),
        Option::None => testing::fail("expected unicode char literal"),
    };
    testing::assert_eq(primitive_text(Primitive::Char('A')), "'A'");
    testing::assert_eq(primitive_text(Primitive::Char('\n')), "'\\n'");
    testing::assert_eq(primitive_text(Primitive::Char('\\')), "'\\\\'")
}

#[test]
fn resolves_generic_trait_associated_applications() -> unit {
    let source = "trait Convert[T] { type Output; fn convert(Self) -> Self::Output; } struct Value {} struct Wrapped[T] { value: T } impl Convert[int32] for Value { type Output = string; fn convert(self: Value) -> string { \"int\" } } impl Convert[string] for Value { type Output = int32; fn convert(self: Value) -> int32 { 7 } } impl[T] Convert[T] for Wrapped[T] { type Output = T; fn convert(self: Wrapped[T]) -> T { self.value } } fn main() -> unit { let text: string = Convert[int32]::convert(Value {}); let number: int32 = Convert[string]::convert(Value {}); let generic: string = Convert[string]::convert(Wrapped { value: \"ok\" }); }";
    let file = checked_file(source);
    match file.items.get(3) {
        Item::Function(value) => {
            match value.body.stmts.get(0) {
                Stmt::Let(_, Pat::Var(_, Type::String), Expr::Call(_, _, Type::String)) => (),
                _ => testing::fail("expected string associated output"),
            };
            match value.body.stmts.get(1) {
                Stmt::Let(_, Pat::Var(_, Type::Int32), Expr::Call(_, _, Type::Int32)) => (),
                _ => testing::fail("expected int32 associated output"),
            };
            match value.body.stmts.get(2) {
                Stmt::Let(_, Pat::Var(_, Type::String), Expr::Call(_, _, Type::String)) => (),
                _ => testing::fail("expected generic associated output"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn resolves_trait_methods_from_call_context() -> unit {
    let source = "trait Put[T] { fn put(Self, T) -> string; } struct Target {} impl Put[int32] for Target { fn put(self: Target, value: int32) -> string { value.to_string() } } impl Put[string] for Target { fn put(self: Target, value: string) -> string { value } } trait Convert[T] { type Output; fn convert(Self) -> Self::Output; } struct Convertible {} impl Convert[int32] for Convertible { type Output = string; fn convert(self: Convertible) -> string { \"text\" } } impl Convert[string] for Convertible { type Output = int32; fn convert(self: Convertible) -> int32 { 7 } } trait Source[T] where Self::Item == T { type Item; fn get(Self) -> Self::Item; } struct Number { value: int32 } impl Source[int32] for Number { type Item = int32; fn get(self: Number) -> int32 { self.value } } fn read[T, S: Source[T]](source: S) -> T { Source[T]::get(source) } trait ItemSource { type Item; fn item(Self) -> Self::Item; } trait Select[T] { fn select(Self) -> T; } impl[S: ItemSource, T] Select[T] for S where S::Item == T { fn select(self: S) -> T { ItemSource::item(self) } } fn invoke[T, S: Select[T]](source: S) -> T { source.select() } fn main() -> unit { let numeric: string = (Target {}).put(1); let textual: string = (Target {}).put(\"goml\"); let text: string = (Convertible {}).convert(); let number: int32 = (Convertible {}).convert(); let value: int32 = read(Number { value: 8 }); }";
    let file = checked_file(source);
    match file.items.get(7) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::TraitMethod(reference, name), _),
                _,
                Type::Param(result),
            )) => {
                testing::assert_eq(reference.name, "Select");
                testing::assert_eq(name, "select");
                match reference.args.get(0) {
                    Type::Param(arg) => testing::assert_eq(arg, "T"),
                    _ => testing::fail("expected contextual trait argument"),
                };
                testing::assert_eq(result, "T")
            },
            _ => testing::fail("expected contextual bound method"),
        },
        _ => testing::fail("expected invoke function"),
    };
    match file.items.get(8) {
        Item::Function(value) => {
            match value.body.stmts.get(0) {
                Stmt::Let(_, Pat::Var(_, Type::String), Expr::Call(_, _, Type::String)) => (),
                _ => testing::fail("expected integer overload"),
            };
            match value.body.stmts.get(1) {
                Stmt::Let(_, Pat::Var(_, Type::String), Expr::Call(_, _, Type::String)) => (),
                _ => testing::fail("expected string overload"),
            };
            match value.body.stmts.get(2) {
                Stmt::Let(_, Pat::Var(_, Type::String), Expr::Call(_, _, Type::String)) => (),
                _ => testing::fail("expected string return overload"),
            };
            match value.body.stmts.get(3) {
                Stmt::Let(_, Pat::Var(_, Type::Int32), Expr::Call(_, _, Type::Int32)) => (),
                _ => testing::fail("expected int32 return overload"),
            };
            match value.body.stmts.get(4) {
                Stmt::Let(_, Pat::Var(_, Type::Int32), Expr::Call(_, _, Type::Int32)) => (),
                _ => testing::fail("expected implied equality result"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn preserves_associated_into_iterator_item_projection() -> unit {
    let file = checked_file("trait Batch { type Items: IntoIterator; fn items(Self) -> Self::Items; } fn iterate[B: Batch](batch: B) -> unit { for _ in Batch::items(batch) {} }");
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::For(
                Pat::Wild(
                    Type::Projection(
                        Type::Projection(
                            Type::Projection(Type::Param(owner), items, _),
                            into_iter,
                            _,
                        ),
                        item,
                        _,
                    ),
                ),
                _,
                _,
                _,
                _,
                _,
                Type::Unit,
            )) => {
                testing::assert_eq(owner, "B");
                testing::assert_eq(items, "Items");
                testing::assert_eq(into_iter, "IntoIter");
                testing::assert_eq(item, "Item")
            },
            _ => testing::fail("expected associated iterator projection"),
        },
        _ => testing::fail("expected iterate function"),
    }
}

#[test]
fn resolves_projected_trait_impls() -> unit {
    let source = "trait Source { type Item; fn get(Self) -> Self::Item; } trait Pick[T] { fn pick(Self) -> T; } impl[S: Source] Pick[S::Item] for S { fn pick(self: S) -> S::Item { Source::get(self) } } struct Value { value: int32 } impl Source for Value { type Item = int32; fn get(self: Value) -> int32 { self.value } } fn main() -> int32 { (Value { value: 41 }).pick() }";
    let file = checked_file(source);
    match file.items.get(2) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::TraitMethod(reference, name), _),
                _,
                Type::Int32,
            )) => {
                testing::assert_eq(reference.name, "Pick");
                testing::assert_eq(name, "pick");
                match resolve_type(reference.args.get(0)) {
                    Type::Projection(Type::Con(owner), item, _) => {
                        testing::assert_eq(owner, "Value");
                        testing::assert_eq(item, "Item")
                    },
                    _ => testing::fail("expected projected trait argument"),
                }
            },
            _ => testing::fail("expected projected trait method call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn normalizes_float_pattern_literals() -> unit {
    let file = checked_file("fn signed_zero(value: float64) -> string { match value { -0.0 => \"zero\", _ => \"other\" } }");
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Match(_, arms, Type::String)) => match arms.get(0).pat {
                Pat::Prim(Primitive::Float(literal), Type::Float64) => {
                    testing::assert_eq(literal, "-0")
                },
                _ => testing::fail("expected normalized float pattern"),
            },
            _ => testing::fail("expected float match"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_supertraits_and_implied_predicates() -> unit {
    let source = "trait Parent[T] { fn parent(Self) -> T; } trait Render { fn render(Self) -> string; } trait Label { fn label(Self) -> string; } trait Marker { fn marker(Self) -> string; } trait Child[T: Label]: Parent[T] + Render where T: Marker { fn child(Self) -> string; } fn describe[T, B: Child[T]](value: B) -> string { value.parent().label() + value.parent().marker() + value.render() + value.child() } fn inherited[T, B: Child[T]](value: B) -> T { Child[T]::parent(value) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::TraitMethod(reference, name), _),
                _,
                Type::Param(result),
            )) => {
                testing::assert_eq(reference.name, "Parent");
                testing::assert_eq(reference.args.len(), 1);
                match reference.args.get(0) {
                    Type::Param(arg) => testing::assert_eq(arg, "T"),
                    _ => testing::fail("expected inherited trait argument"),
                };
                testing::assert_eq(name, "parent");
                testing::assert_eq(result, "T")
            },
            _ => testing::fail("expected inherited static trait call"),
        },
        _ => testing::fail("expected inherited function"),
    }
}
