}

#[test]
fn types_control_flow_member_subexpressions() -> unit {
    let source = "fn projected() -> int32 { let _: int32 = (return 1i32).0; 0i32 } fn indexed() -> int32 { let _: int32 = (return 1i32)[0i32]; 0i32 } fn field() -> int32 { let _: int32 = (return 1i32).value; 0i32 }";
    let file = checked_file(source);
    for index in range(0, 3) {
        match file.items.get(index) {
            Item::Function(value) => match value.body.stmts.get(0) {
                Stmt::Let(_, Pat::Wild(pattern_ty), expression) => {
                    match (resolve_type(pattern_ty), resolve_type(expr_type(expression))) {
                        (Type::Int32, Type::Int32) => (),
                        _ => testing::fail("expected contextual control flow type"),
                    }
                },
                _ => testing::fail("expected typed control flow binding"),
            },
            _ => testing::fail("expected control flow function"),
        }
    }
}

#[test]
fn preserves_fn_iterator_static_owner() -> unit {
