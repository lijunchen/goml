package tast;

use gomlang::parser::ast;
use gomlang::parser::hir;
use gomlang::parser::parser;
use std::testing;
use std::text;

fn checked_file(source: string) -> File {
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Option::Some(file) => file,
        Option::None => {
            testing::fail("expected TAST");
            File { items: Vec::new() }
        },
    }
}

fn primitive_text(value: Primitive) -> string {
    let builder = text::StringBuilder::new();
    write_primitive(builder, value);
    builder.finish()
}

#[test]
fn infers_generic_function_calls() -> unit {
    let source = "fn id[T](value: T) -> T { value } fn main() -> string { id(\"ok\") }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(function, args, ty)) => {
                testing::assert_eq(args.len(), 1);
                match resolve_type(ty) {
                    Type::String => (),
                    _ => testing::fail("expected string call result"),
                };
                match function {
                    Expr::Callable(Callable::Function(name), Type::Func(params, ret_ty)) => {
                        testing::assert_eq(name, "id");
                        testing::assert_eq(params.len(), 1);
                        match resolve_type(params.get(0)) {
                            Type::String => (),
                            _ => testing::fail("expected instantiated string parameter"),
                        };
                        match resolve_type(ret_ty) {
                            Type::String => (),
                            _ => testing::fail("expected instantiated string return"),
                        }
                    },
                    _ => testing::fail("expected function callable"),
                }
            },
            _ => testing::fail("expected call tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn checks_enum_patterns_and_default_integer_literals() -> unit {
    let source = "enum Choice { None, Some(int32) } fn unwrap(value: Choice) -> int32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1);
    match file.items.get(0) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Match(_, arms, ty)) => {
                testing::assert_eq(arms.len(), 2);
                match ty {
                    Type::Int32 => (),
                    _ => testing::fail("expected int32 match result"),
                };
                match arms.get(0).pat {
                    Pat::Constr(constructor, args, Type::Con(name)) => {
                        testing::assert_eq(constructor.name, "Choice::Some");
                        testing::assert_eq(args.len(), 1);
                        testing::assert_eq(name, "Choice")
                    },
                    _ => testing::fail("expected constructor pattern"),
                };
                match arms.get(1).body {
                    Expr::Prim(Primitive::Int(value), literal_ty) => {
                        testing::assert_eq(value, "0");
                        match resolve_type(literal_ty) {
                            Type::Int32 => (),
                            _ => testing::fail("expected defaulted int32 literal"),
                        }
                    },
                    _ => testing::fail("expected defaulted int32 literal"),
                }
            },
            _ => testing::fail("expected match tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_associated_types_and_bound_methods() -> unit {
    let source = "trait Provider { type Item; fn get(Self) -> Self::Item; } struct Number { value: int32 } impl Provider for Number { type Item = int32; fn get(self: Number) -> int32 { self.value } } fn read[P: Provider](provider: P) -> P::Item { provider.get() } fn main() -> int32 { read(Number { value: 42 }) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 3);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::TraitMethod(reference, name), _),
                _,
                Type::Projection(Type::Param(owner), associated),
            )) => {
                testing::assert_eq(reference.name, "Provider");
                testing::assert_eq(name, "get");
                testing::assert_eq(owner, "P");
                testing::assert_eq(associated, "Item")
            },
            _ => testing::fail("expected bound trait method call"),
        },
        _ => testing::fail("expected read function"),
    };
    match file.items.get(2) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Call(
                Expr::Callable(Callable::Function(name), Type::Func(_, ret_ty)),
                _,
                ty,
            )) => {
                testing::assert_eq(name, "read");
                match (resolve_type(ret_ty), resolve_type(ty)) {
                    (Type::Int32, Type::Int32) => (),
                    _ => testing::fail("expected normalized associated type"),
                }
            },
            _ => testing::fail("expected read call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn checks_extended_builtin_method_catalog() -> unit {
    let source = "fn exercise(text: string, values: Vec[int32], map: HashMap[string, int32]) -> unit { let _ = text.decode_at(0); let _ = text.to_bytes(); let _ = text.chars(); let _ = text.char_indices(); values.reserve(1); values.insert(0, 1); let _ = values.remove(0); let _ = values.swap_remove(0); values.reverse(); let _ = values.last(); let _ = values.pop(); values.truncate(0); values.clear(); let _ = map.entries(); }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1)
}

#[test]
fn normalizes_and_escapes_char_literals() -> unit {
    match parse_char_literal("\\u0041") {
        Option::Some(value) => testing::assert(value == 'A'),
        Option::None => testing::fail("expected unicode char literal"),
    };
    testing::assert_eq(primitive_text(Primitive::Char('A')), "'A'");
    testing::assert_eq(primitive_text(Primitive::Char('\n')), "'\\n'");
    testing::assert_eq(primitive_text(Primitive::Char('\\')), "'\\\\'")
}
