package tast;

use gomlc::ast;
use gomlc::hir;

struct ResolvedConstructor {
    constructor: Constructor,
    fields: Vec[Type],
    ty: Type,
    named: bool,
}

struct ResolvedStruct {
    constructor: Constructor,
    fields: Vec[(string, Type)],
    ty: Type,
    has_hidden_fields: bool,
}

enum NamedFieldConstructorResolution {
    Found(ResolvedStruct),
    WrongStyle,
    Ambiguous,
    Missing,
}

struct ResolvedCallable {
    callable: Callable,
    ty: Type,
}

struct MethodCandidate {
    owner: Type,
    callable: ResolvedCallable,
    predicates: Vec[TypePredicate],
}

fn short_name(value: string) -> string {
    let start = Ref::new(0);
    let index = Ref::new(0);
    while index.get() + 1 < value.byte_len() {
        if value.byte_get(index.get()) == 58 && value.byte_get(index.get() + 1) == 58 {
            start.set(index.get() + 2);
            index.set(index.get() + 2)
        } else {
            index.set(index.get() + 1)
        }
    };
    value.byte_slice(start.get(), value.byte_len())
}

fn names_match(left: string, right: string) -> bool {
    left == right || short_name(left) == short_name(right)
}

fn find_enum_by_def(ctx: Checker, id: hir::DefId) -> Option[EnumInfo] {
    let result = Ref::new(Option::None);
    for value in ctx.enums {
        if same_def(value.def_id, id) {
            result.set(Option::Some(value))
        } else {
            ()
        }
    };
    result.get()
}

fn find_enum_by_name(ctx: Checker, name: string) -> Option[EnumInfo] {
    let exact: Ref[Option[EnumInfo]] = Ref::new(Option::None);
    let short: Ref[Option[EnumInfo]] = Ref::new(Option::None);
    let short_ambiguous = Ref::new(false);
    for value in ctx.enums {
        if value.name == name {
            exact.set(Option::Some(value))
        } else if short_name(value.name) == short_name(name) {
            match short.get() {
                Option::Some(_) => short_ambiguous.set(true),
                Option::None => short.set(Option::Some(value)),
            }
        } else {
            ()
        }
    };
    match exact.get() {
        Option::Some(value) => Option::Some(value),
        Option::None => if short_ambiguous.get() {
            Option::None
        } else {
            short.get()
        },
    }
}

fn find_struct_by_name(ctx: Checker, name: string) -> Option[StructInfo] {
    let exact: Ref[Option[StructInfo]] = Ref::new(Option::None);
    let short: Ref[Option[StructInfo]] = Ref::new(Option::None);
    let short_ambiguous = Ref::new(false);
    for value in ctx.structs {
        if value.name == name {
            exact.set(Option::Some(value))
        } else if short_name(value.name) == short_name(name) {
            match short.get() {
                Option::Some(_) => short_ambiguous.set(true),
                Option::None => short.set(Option::Some(value)),
            }
        } else {
            ()
        }
    };
    match exact.get() {
        Option::Some(value) => Option::Some(value),
        Option::None => if short_ambiguous.get() {
            Option::None
        } else {
            short.get()
        },
    }
}

fn nominal_type_is_defined(ctx: Checker, name: string) -> bool {
    match find_struct_by_name(ctx, name) {
        Option::Some(_) => true,
        Option::None => match find_enum_by_name(ctx, name) {
            Option::Some(_) => true,
            Option::None => false,
        },
    }
}

fn find_variant(value: EnumInfo, index: int) -> Option[EnumVariantInfo] {
    if index >= 0 && index < value.variants.len() {
        Option::Some(value.variants.get(index))
    } else {
        Option::None
    }
}

fn instantiate_enum(ctx: Checker, value: EnumInfo) -> (Type, Vec[TypeSubst]) {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, Vec::new());
    let args: Vec[Type] = Vec::new();
    for generic in value.generics {
        match find_substitution(substitutions, generic) {
            Option::Some(ty) => args.push(ty),
            Option::None => (),
        }
    };
    (nominal_type(value.name, args), substitutions)
}

fn resolve_user_constructor(
    ctx: Checker,
    value: EnumInfo,
    variant_index: int,
) -> Option[ResolvedConstructor] {
    match find_variant(value, variant_index) {
        Option::Some(variant) => {
            let (ty, substitutions) = instantiate_enum(ctx, value);
            let fields: Vec[Type] = Vec::new();
            for field in enum_variant_field_types(variant.fields) {
                fields.push(substitute_type(field, substitutions))
            };
            Option::Some(ResolvedConstructor {
                constructor: Constructor {
                    name: value.name + "::" + variant.name,
                    fields: Vec::new(),
                    is_struct: false,
                    tag: Option::Some(variant_index),
                },
                fields,
                ty,
                named: match variant.fields {
                    EnumVariantFields::Struct(_) => true,
                    _ => false,
                },
            })
        },
        Option::None => Option::None,
    }
}

fn resolve_named_constructor(
    ctx: Checker,
    enum_name: string,
    variant_name: string,
) -> Option[ResolvedConstructor] {
    match find_enum_by_name(ctx, enum_name) {
        Option::Some(value) => {
            let result: Ref[Option[ResolvedConstructor]] = Ref::new(Option::None);
            let found = Ref::new(false);
            for index in range(0, value.variants.len()) {
                if found.get() == false && value.variants.get(index).name == variant_name {
                    result.set(resolve_user_constructor(ctx, value, index));
                    found.set(true)
                } else {
                    ()
                }
            };
            result.get()
        },
        Option::None => Option::None,
    }
}

fn split_constructor_name(value: string) -> Option[(string, string)] {
    let separator = Ref::new(Option::None);
    let index = Ref::new(0);
    while index.get() + 1 < value.byte_len() {
        if value.byte_get(index.get()) == 58
            && value.byte_get(index.get() + 1) == 58
        {
            separator.set(Option::Some(index.get()));
            index.set(index.get() + 2)
        } else {
            index.set(index.get() + 1)
        }
    };
    match separator.get() {
        Option::Some(index) => if index > 0 && index + 2 < value.byte_len() {
            Option::Some((
                value.byte_slice(0, index),
                value.byte_slice(index + 2, value.byte_len()),
            ))
        } else {
            Option::None
        },
        Option::None => Option::None,
    }
}

fn resolve_builtin_constructor(ctx: Checker, name: string) -> Option[ResolvedConstructor] {
    let t = fresh_type(ctx.counter, VarKind::Any);
    let e = fresh_type(ctx.counter, VarKind::Any);
    let fields: Vec[Type] = Vec::new();
    let ty = if name == "Option::None" {
        nominal_type("Option", one_type(t))
    } else if name == "Option::Some" {
        fields.push(t);
        nominal_type("Option", one_type(t))
    } else if name == "Result::Ok" {
        fields.push(t);
        nominal_type("Result", two_types(t, e))
    } else if name == "Result::Err" {
        fields.push(e);
        nominal_type("Result", two_types(t, e))
    } else {
        Type::Error
    };
    if name == "Option::None"
        || name == "Option::Some"
        || name == "Result::Ok"
        || name == "Result::Err" {
        Option::Some(ResolvedConstructor {
            constructor: Constructor {
                name,
                fields: Vec::new(),
                is_struct: false,
                tag: if name == "Option::None" || name == "Result::Ok" {
                    Option::Some(0)
                } else {
                    Option::Some(1)
                },
            },
            fields,
            ty,
            named: false,
        })
    } else {
        Option::None
    }
}

fn resolve_constructor(ctx: Checker, value: hir::ConstructorRef) -> Option[ResolvedConstructor] {
    match value {
        hir::ConstructorRef::Resolved(id, variant) => match find_enum_by_def(ctx, id) {
            Option::Some(info) => resolve_user_constructor(ctx, info, variant),
            Option::None => Option::None,
        },
        hir::ConstructorRef::Unresolved(name) => match resolve_builtin_constructor(ctx, name) {
            Option::Some(value) => Option::Some(value),
            Option::None => match split_constructor_name(name) {
                Option::Some(parts) => resolve_named_constructor(ctx, parts.0, parts.1),
                Option::None => Option::None,
            },
        },
    }
}

fn bare_constructor_match_count(ctx: Checker, name: string) -> int {
    let count = Ref::new(0);
    for info in ctx.enums {
        for variant in info.variants {
            if variant.name == name {
                count.set(count.get() + 1)
            } else {
                ()
            }
        }
    };
    count.get()
}

fn instantiate_struct(ctx: Checker, value: StructInfo) -> ResolvedStruct {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, Vec::new());
    let args: Vec[Type] = Vec::new();
    for generic in value.generics {
        match find_substitution(substitutions, generic) {
            Option::Some(ty) => args.push(ty),
            Option::None => (),
        }
    };
    let fields: Vec[(string, Type)] = Vec::new();
    let names: Vec[string] = Vec::new();
    for field in value.fields {
        fields.push((field.0, substitute_type(field.1, substitutions)));
        names.push(field.0)
    };
    ResolvedStruct {
        constructor: Constructor {
            name: value.name,
            fields: names,
            is_struct: true,
            tag: Option::None,
        },
        fields,
        ty: nominal_type(value.name, args),
        has_hidden_fields: value.has_hidden_fields,
    }
}

fn resolve_struct(ctx: Checker, name: string) -> Option[ResolvedStruct] {
    match find_struct_by_name(ctx, name) {
        Option::Some(value) => Option::Some(instantiate_struct(ctx, value)),
        Option::None => Option::None,
    }
}

fn instantiate_named_variant(
    ctx: Checker,
    value: EnumInfo,
    variant_index: int,
    named: Vec[(string, Type)],
) -> ResolvedStruct {
    let (ty, substitutions) = instantiate_enum(ctx, value);
    let fields: Vec[(string, Type)] = Vec::new();
    let names: Vec[string] = Vec::new();
    for field in named {
        fields.push((field.0, substitute_type(field.1, substitutions)));
        names.push(field.0)
    };
    let variant = value.variants.get(variant_index);
    ResolvedStruct {
        constructor: Constructor {
            name: value.name + "::" + variant.name,
            fields: names,
            is_struct: false,
            tag: Option::Some(variant_index),
        },
        fields,
        ty,
        has_hidden_fields: false,
    }
}

fn resolve_named_variant_in(
    ctx: Checker,
    value: EnumInfo,
    variant_name: string,
) -> NamedFieldConstructorResolution {
    for index in range(0, value.variants.len()) {
        let variant = value.variants.get(index);
        if variant.name == variant_name {
            return match enum_variant_named_fields(variant.fields) {
                Option::Some(fields) => NamedFieldConstructorResolution::Found(
                    instantiate_named_variant(ctx, value, index, fields),
                ),
                Option::None => NamedFieldConstructorResolution::WrongStyle,
            }
        } else {
            ()
        }
    };
    NamedFieldConstructorResolution::Missing
}

fn resolve_named_field_constructor(
    ctx: Checker,
    name: string,
) -> NamedFieldConstructorResolution {
    match resolve_struct(ctx, name) {
        Option::Some(value) => return NamedFieldConstructorResolution::Found(value),
        Option::None => (),
    };
    match split_constructor_name(name) {
        Option::Some(parts) => return match find_enum_by_name(ctx, parts.0) {
            Option::Some(value) => resolve_named_variant_in(ctx, value, parts.1),
            Option::None => NamedFieldConstructorResolution::Missing,
        },
        Option::None => (),
    };
    let found_enum: Ref[Option[EnumInfo]] = Ref::new(Option::None);
    let found_index = Ref::new(-1);
    let count = Ref::new(0);
    for value in ctx.enums {
        for index in range(0, value.variants.len()) {
            if value.variants.get(index).name == name {
                count.set(count.get() + 1);
                found_enum.set(Option::Some(value));
                found_index.set(index)
            } else {
                ()
            }
        }
    };
    if count.get() > 1 {
        NamedFieldConstructorResolution::Ambiguous
    } else {
        match found_enum.get() {
            Option::Some(value) => {
                let variant = value.variants.get(found_index.get());
                match enum_variant_named_fields(variant.fields) {
                    Option::Some(fields) => NamedFieldConstructorResolution::Found(
                        instantiate_named_variant(
                            ctx,
                            value,
                            found_index.get(),
                            fields,
                        ),
                    ),
                    Option::None => NamedFieldConstructorResolution::WrongStyle,
                }
            },
            Option::None => NamedFieldConstructorResolution::Missing,
        }
    }
}

fn nominal_arguments(value: Type) -> Vec[Type] {
    match prune(value) {
        Type::App { ty: _, args } => args,
        Type::VecType { elem }
        | Type::Slice { elem }
        | Type::RefType { elem }
        | Type::Channel { elem } => one_type(elem),
        Type::HashMap { key, value: item } => two_types(key, item),
        _ => Vec::new(),
    }
}

fn substitutions_for_nominal(
    params: Vec[string],
    value: Type,
) -> Vec[TypeSubst] {
    let args = nominal_arguments(value);
    let result: Vec[TypeSubst] = Vec::new();
    for index in range(0, params.len()) {
        if index < args.len() {
            result.push(TypeSubst {
                name: params.get(index),
                ty: args.get(index),
            })
        } else {
            ()
        }
    };
    result
}

fn resolve_field_type(ctx: Checker, receiver: Type, name: string) -> Option[Type] {
    let receiver = normalize_type(ctx, receiver);
    match type_constructor_name(receiver) {
        Option::Some(owner) => match find_struct_by_name(ctx, owner) {
            Option::Some(info) => {
                let substitutions = substitutions_for_nominal(info.generics, receiver);
                let result = Ref::new(Option::None);
                for field in info.fields {
                    if field.0 == name {
                        result.set(Option::Some(substitute_type(field.1, substitutions)))
                    } else {
                        ()
                    }
                };
                result.get()
            },
            Option::None => Option::None,
        },
        Option::None => Option::None,
    }
}

fn find_named_field(values: Vec[(string, hir::Expr)], name: string) -> Option[hir::Expr] {
    let result = Ref::new(Option::None);
    for value in values {
        if value.0 == name {
            result.set(Option::Some(value.1))
        } else {
            ()
        }
    };
    result.get()
}

fn find_named_pattern(values: Vec[(string, hir::Pat)], name: string) -> Option[hir::Pat] {
    let result = Ref::new(Option::None);
    let found = Ref::new(false);
    for value in values {
        if !(found.get()) && value.0 == name {
            result.set(Option::Some(value.1));
            found.set(true)
        } else {
            ()
        }
    };
    result.get()
}

fn receiver_matches(owner: Type, receiver: Type) -> bool {
    match prune(owner) {
        Type::Param { name: _ } | Type::Var(_) => true,
        owner => match (type_constructor_name(owner), type_constructor_name(receiver)) {
            (Option::Some(first), Option::Some(second)) => names_match(first, second),
            _ => false,
        },
    }
}

fn call_type_lists_compatible(left: Vec[Type], right: Vec[Type]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        let compatible = Ref::new(true);
        for index in range(0, left.len()) {
            if !call_types_compatible(left.get(index), right.get(index)) {
                compatible.set(false)
            } else {
                ()
            }
        };
        compatible.get()
    }
}

fn variable_accepts_type(variable: Ref[TypeVar], value: Type) -> bool {
    match variable.get() {
        TypeVar::Link(inner) => call_types_compatible(inner, value),
        TypeVar::Unbound { id: _, kind } => match prune(value) {
            Type::Var(other) => match other.get() {
                TypeVar::Link(inner) => variable_accepts_type(variable, inner),
                TypeVar::Unbound { id: _, kind: other_kind } => match merge_var_kind(kind, other_kind) {
                    Option::Some(_) => true,
                    Option::None => false,
                },
            },
            Type::Param { name: _ } | Type::Projection { for_ty: _, name: _, trait_ref: _ } => true,
            other => kind_accepts(kind, other),
        },
    }
}

fn call_types_compatible(left: Type, right: Type) -> bool {
    match (prune(left), prune(right)) {
        (Type::Error, _) | (_, Type::Error) => true,
        (Type::Var(variable), value) => variable_accepts_type(variable, value),
        (value, Type::Var(variable)) => variable_accepts_type(variable, value),
        (Type::Param { name: _ }, _) | (_, Type::Param { name: _ }) => true,
        (Type::Projection { for_ty: _, name: _, trait_ref: _ }, _) | (_, Type::Projection { for_ty: _, name: _, trait_ref: _ }) => true,
        (Type::Unit, Type::Unit)
        | (Type::Bool, Type::Bool)
        | (Type::Int, Type::Int)
        | (Type::Int8, Type::Int8)
        | (Type::Int16, Type::Int16)
        | (Type::Int32, Type::Int32)
        | (Type::Int64, Type::Int64)
        | (Type::Uint8, Type::Uint8)
        | (Type::Uint16, Type::Uint16)
        | (Type::Uint32, Type::Uint32)
        | (Type::Uint64, Type::Uint64)
        | (Type::Float32, Type::Float32)
        | (Type::Float64, Type::Float64)
        | (Type::String, Type::String)
        | (Type::Char, Type::Char) => true,
        (Type::Tuple { items: left }, Type::Tuple { items: right }) => {
            call_type_lists_compatible(left, right)
        },
        (Type::Con { name: left }, Type::Con { name: right }) | (Type::Dyn { trait_name: left }, Type::Dyn { trait_name: right }) => {
            names_match(left, right)
        },
        (Type::App { ty: left_base, args: left_args }, Type::App { ty: right_base, args: right_args }) => {
            call_types_compatible(left_base, right_base)
                && call_type_lists_compatible(left_args, right_args)
        },
        (Type::Array { len: left_len, elem: left_elem }, Type::Array { len: right_len, elem: right_elem }) => {
            (left_len < 0 || right_len < 0 || left_len == right_len)
                && call_types_compatible(left_elem, right_elem)
        },
        (Type::Slice { elem: left }, Type::Slice { elem: right })
        | (Type::VecType { elem: left }, Type::VecType { elem: right })
        | (Type::RefType { elem: left }, Type::RefType { elem: right })
        | (Type::Channel { elem: left }, Type::Channel { elem: right }) => {
            call_types_compatible(left, right)
        },
        (
            Type::HashMap { key: left_key, value: left_value },
            Type::HashMap { key: right_key, value: right_value },
        ) => {
            call_types_compatible(left_key, right_key)
                && call_types_compatible(left_value, right_value)
        },
        (Type::Func { params: left_params, ret_ty: left_ret }, Type::Func { params: right_params, ret_ty: right_ret }) => {
            call_type_lists_compatible(left_params, right_params)
                && call_types_compatible(left_ret, right_ret)
        },
        _ => false,
    }
}

fn instantiate_method_candidate(ctx: Checker, value: MethodInfo) -> MethodCandidate {
    let substitutions = instantiate_substitutions(ctx.counter, value.generics, Vec::new());
    let predicates = expand_implied_predicates(
        ctx,
        substitute_predicates(value.function.predicates, substitutions),
    );
    apply_predicate_equalities(predicates);
    let owner = substitute_type(value.for_type, substitutions);
    let params: Vec[Type] = Vec::new();
    for param in value.function.params {
        params.push(substitute_type(param, substitutions))
    };
    MethodCandidate {
        owner,
        callable: ResolvedCallable {
            callable: substitute_callable(value.function.callable, substitutions),
            ty: Type::Func {
                params,
                ret_ty: substitute_type(value.function.ret_ty, substitutions),
            },
        },
        predicates,
    }
}

fn instantiate_method(ctx: Checker, value: MethodInfo) -> (Type, ResolvedCallable) {
    let candidate = instantiate_method_candidate(ctx, value);
    (candidate.owner, candidate.callable)
}

fn resolve_user_method(
    ctx: Checker,
    receiver: Type,
    name: string,
    trait_name: Option[string],
    allow_bare_owner: bool,
) -> Option[ResolvedCallable] {
    let result = Ref::new(Option::None);
    let found = Ref::new(false);
    for value in ctx.methods {
        let trait_matches = match (trait_name, value.trait_ref) {
            (Option::Some(expected), Option::Some(reference)) => {
                names_match(expected, reference.name)
            },
            (Option::None, _) => true,
            _ => false,
        };
        if !(found.get()) && trait_matches && value.function.name == name
            && receiver_matches(value.for_type, receiver) {
            let (owner, callable) = instantiate_method(ctx, value);
            if (allow_bare_owner
                && value.generics.len() > 0
                && match prune(receiver) {
                    Type::Con { name: _ } => true,
                    _ => false,
                }) || unify(owner, receiver) {
                result.set(Option::Some(callable));
                found.set(true)
            } else {
                ()
            }
        } else {
            ()
        }
    };
    result.get()
}

fn method_matches_call(
    ctx: Checker,
    value: ResolvedCallable,
    receiver: Type,
    args: Vec[Type],
    expected: Option[Type],
) -> bool {
    match prune(value.ty) {
        Type::Func { params, ret_ty } => if params.len() == args.len() + 1 {
            let matches = Ref::new(call_types_compatible(
                normalize_type(ctx, params.get(0)),
                normalize_type(ctx, receiver),
            ));
            for index in range(0, args.len()) {
                if !call_types_compatible(
                    normalize_type(ctx, params.get(index + 1)),
                    normalize_type(ctx, args.get(index)),
                ) {
                    matches.set(false)
                } else {
                    ()
                }
            };
            match expected {
                Option::Some(ty) => if !call_types_compatible(
                    normalize_type(ctx, ret_ty),
                    normalize_type(ctx, ty),
                ) {
                    matches.set(false)
                } else {
                    ()
                },
                Option::None => (),
            };
            matches.get()
        } else {
            false
        },
        _ => false,
    }
}

fn context_trait_bound_satisfied(
    ctx: Checker,
    bound_ty: Type,
    reference: TraitRef,
) -> bool {
    let found = Ref::new(false);
    let bound_ty = normalize_type(ctx, bound_ty);
    let reference = normalize_trait_ref(ctx, reference);
    for predicate in ctx.predicates {
        match predicate {
            TypePredicate::Trait(candidate_ty, candidate_ref) => {
                if types_equal(normalize_type(ctx, candidate_ty), bound_ty)
                    && trait_ref_equal(normalize_trait_ref(ctx, candidate_ref), reference) {
                    found.set(true)
                } else {
                    ()
                }
            },
            TypePredicate::Equality(_, _) => (),
        }
    };
    found.get()
}

fn predicates_satisfied_at(
    ctx: Checker,
    predicates: Vec[TypePredicate],
    depth: int,
) -> bool {
    let satisfied = Ref::new(true);
    for predicate in predicates {
        if satisfied.get() {
            match predicate {
                TypePredicate::Trait(bound_ty, reference) => {
                    if !trait_bound_satisfied_at(ctx, bound_ty, reference, depth) {
                        satisfied.set(false)
                    } else {
                        ()
                    }
                },
                TypePredicate::Equality(left, right) => {
                    if !unify(normalize_type(ctx, left), normalize_type(ctx, right)) {
                        satisfied.set(false)
                    } else {
                        ()
                    }
                },
            }
        } else {
            ()
        }
    };
    satisfied.get()
}

fn require_predicates(ctx: Checker, predicates: Vec[TypePredicate]) -> unit {
    for predicate in predicates {
        ctx.required_predicates.push(PredicateRequirement {
            predicate,
            message: "type predicate not satisfied",
            span: ctx.current_span.get(),
        })
    }
}

fn require_predicate(
    ctx: Checker,
    predicate: TypePredicate,
    message: string,
) -> unit {
    ctx.required_predicates.push(PredicateRequirement {
        predicate,
        message,
        span: ctx.current_span.get(),
    })
}

fn contains_unbound_any_variable(value: Type) -> bool {
    match prune(value) {
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound { id: _, kind: VarKind::Any } => true,
            TypeVar::Unbound { id: _, kind: _ } => false,
            TypeVar::Link(inner) => contains_unbound_any_variable(inner),
        },
        Type::Tuple { items: values } => {
            let found = Ref::new(false);
            for value in values {
                if contains_unbound_any_variable(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Projection { for_ty: base, name: _, trait_ref: reference } => {
            let found = Ref::new(contains_unbound_any_variable(base));
            match reference {
                Option::Some(reference) => for value in reference.args {
                    if contains_unbound_any_variable(value) {
                        found.set(true)
                    } else {
                        ()
                    }
                },
                Option::None => (),
            };
            found.get()
        },
        Type::App { ty: base, args } => {
            let found = Ref::new(contains_unbound_any_variable(base));
            for value in args {
                if contains_unbound_any_variable(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Array { len: _, elem }
        | Type::Slice { elem }
        | Type::VecType { elem }
        | Type::RefType { elem }
        | Type::Channel { elem } => contains_unbound_any_variable(elem),
        Type::HashMap { key, value } => {
            contains_unbound_any_variable(key)
                || contains_unbound_any_variable(value)
        },
        Type::Func { params, ret_ty } => {
            let found = Ref::new(contains_unbound_any_variable(ret_ty));
            for value in params {
                if contains_unbound_any_variable(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        _ => false,
    }
}

fn predicate_requirement_message(
    ctx: Checker,
    value: TypePredicate,
    fallback: string,
) -> string {
    if fallback == "type predicate not satisfied" {
        match value {
            TypePredicate::Trait(for_ty, reference) => {
                let unresolved = Ref::new(contains_unbound_type_variable(for_ty));
                let ambiguous = Ref::new(contains_unbound_any_variable(for_ty));
                for value in reference.args {
                    if contains_unbound_type_variable(value) {
                        unresolved.set(true)
                    } else {
                        ()
                    };
                    if contains_unbound_any_variable(value) {
                        ambiguous.set(true)
                    } else {
                        ()
                    }
                };
                if unresolved.get() && ambiguous.get() {
                    "Could not infer the type required to prove "
                        + trait_ref_text(diagnostic_trait_ref(reference))
                        + "<"
                        + diagnostic_type_text(for_ty)
                        + ">"
                } else {
                    "No instance found for trait "
                        + trait_ref_text(reference)
                        + "<"
                        + type_text(normalize_type(ctx, for_ty))
                        + ">"
                }
            },
            TypePredicate::Equality(_, _) => fallback,
        }
    } else {
        fallback
    }
}

fn type_contains_error(value: Type) -> bool {
    match prune(value) {
        Type::Error => true,
        Type::Tuple { items: values } => {
            let found = Ref::new(false);
            for value in values {
                if type_contains_error(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Projection { for_ty: base, name: _, trait_ref: _ } => type_contains_error(base),
        Type::App { ty: base, args } => {
            let found = Ref::new(type_contains_error(base));
            for value in args {
                if type_contains_error(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Array { len: _, elem }
        | Type::Slice { elem }
        | Type::VecType { elem }
        | Type::RefType { elem }
        | Type::Channel { elem } => type_contains_error(elem),
        Type::HashMap { key, value } => {
            type_contains_error(key) || type_contains_error(value)
        },
        Type::Func { params, ret_ty } => {
            let found = Ref::new(type_contains_error(ret_ty));
            for value in params {
                if type_contains_error(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        _ => false,
    }
}

fn predicate_contains_error(value: TypePredicate) -> bool {
    match value {
        TypePredicate::Trait(for_ty, reference) => {
            let found = Ref::new(type_contains_error(for_ty));
            for value in reference.args {
                if type_contains_error(value) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        TypePredicate::Equality(left, right) => {
            type_contains_error(left) || type_contains_error(right)
        },
    }
}

fn resolve_required_predicates(ctx: Checker) -> unit {
    let messages: Vec[string] = Vec::new();
    let spans: Vec[Option[ast::Span]] = Vec::new();
    for requirement in ctx.required_predicates {
        match requirement.predicate {
            TypePredicate::Trait(for_ty, _) => {
                if contains_unbound_type_variable(for_ty)
                    && is_numeric_type(for_ty)
                {
                    let _ = resolve_type(for_ty);
                } else {
                    ()
                }
            },
            TypePredicate::Equality(_, _) => (),
        };
        if predicate_contains_error(requirement.predicate)
            || predicates_satisfied_at(
            ctx,
            Vec::new().pushed(requirement.predicate),
            0,
        ) {
            ()
        } else {
            let message = predicate_requirement_message(
                ctx,
                requirement.predicate,
                requirement.message,
            );
            let duplicate = Ref::new(false);
            for index in range(0, messages.len()) {
                if messages.get(index) == message
                    && optional_spans_equal(
                        spans.get(index),
                        requirement.span,
                    )
                {
                    duplicate.set(true)
                } else {
                    ()
                }
            };
            if duplicate.get() {
                ()
            } else {
                messages.push(message);
                spans.push(requirement.span);
                push_diagnostic_at(ctx, message, requirement.span)
            }
        }
    }
}

fn builtin_value_trait_type(value: Type) -> bool {
    match prune(value) {
        Type::Unit
        | Type::Bool
        | Type::Int
        | Type::Int8
        | Type::Int16
        | Type::Int32
        | Type::Int64
        | Type::Uint8
        | Type::Uint16
        | Type::Uint32
        | Type::Uint64
        | Type::Float32
        | Type::Float64
        | Type::String
        | Type::Char => true,
        Type::Var(variable) => match variable.get() {
            TypeVar::Unbound { id: _, kind: VarKind::Integer }
            | TypeVar::Unbound { id: _, kind: VarKind::Float } => true,
            TypeVar::Link(inner) => builtin_value_trait_type(inner),
            TypeVar::Unbound { id: _, kind: VarKind::Any } => false,
        },
        _ => false,
    }
}

fn iterator_trait_ref() -> TraitRef {
    TraitRef {
        name: "Iterator",
        args: Vec::new(),
    }
}

fn iterator_item_type(value: Type) -> Type {
    Type::Projection {
        for_ty: value,
        name: "Item",
        trait_ref: Option::Some(iterator_trait_ref()),
    }
}

fn builtin_iterator_bound_satisfied(
    ctx: Checker,
    bound_ty: Type,
    depth: int,
) -> bool {
    match prune(normalize_type(ctx, bound_ty)) {
        Type::App { ty: Type::Con { name }, args } => if name == "FnIterator" && args.len() == 1 {
            true
        } else if name == "MapIterator" && args.len() == 3 {
            let iterator = args.get(2);
            trait_bound_satisfied_at(ctx, iterator, iterator_trait_ref(), depth + 1)
                && unify(
                    normalize_type(ctx, iterator_item_type(iterator)),
                    normalize_type(ctx, args.get(0)),
                )
        } else if name == "FilterIterator" && args.len() == 2 {
            let iterator = args.get(1);
            trait_bound_satisfied_at(ctx, iterator, iterator_trait_ref(), depth + 1)
                && unify(
                    normalize_type(ctx, iterator_item_type(iterator)),
                    normalize_type(ctx, args.get(0)),
                )
        } else if name == "TakeIterator" && args.len() == 1 {
            trait_bound_satisfied_at(
                ctx,
                args.get(0),
                iterator_trait_ref(),
                depth + 1,
            )
        } else {
            false
        },
        _ => false,
    }
}

fn builtin_trait_bound_satisfied(
    ctx: Checker,
    bound_ty: Type,
    reference: TraitRef,
    depth: int,
) -> bool {
    if reference.args.len() > 0 {
        false
    } else {
        let trait_name = short_name(reference.name);
        let bound_ty = prune(normalize_type(ctx, bound_ty));
        match bound_ty {
            Type::Dyn { trait_name: name } => {
                let found = Ref::new(false);
                for application in trait_ref_closure(
                    ctx,
                    TraitRef {
                        name,
                        args: Vec::new(),
                    },
                ) {
                    if names_match(application.name, trait_name) {
                        found.set(true)
                    } else {
                        ()
                    }
                };
                found.get()
            },
            _ => if trait_name == "ToString" {
                if builtin_value_trait_type(bound_ty) {
                    true
                } else {
                    match bound_ty {
                        Type::RefType { elem: inner } => trait_bound_satisfied_at(
                            ctx,
                            inner,
                            TraitRef {
                                name: "ToString",
                                args: Vec::new(),
                            },
                            depth + 1,
                        ),
                        _ => false,
                    }
                }
            } else if trait_name == "Eq" || trait_name == "Hash" {
                if trait_name == "Eq" {
                    if builtin_value_trait_type(bound_ty) {
                        true
                    } else {
                        match bound_ty {
                            Type::RefType { elem: _ } => true,
                            Type::Tuple { items: values } => {
                                let satisfied = Ref::new(true);
                                for value in values {
                                    if !trait_bound_satisfied_at(
                                        ctx,
                                        value,
                                        TraitRef {
                                            name: "Eq",
                                            args: Vec::new(),
                                        },
                                        depth + 1,
                                    ) {
                                        satisfied.set(false)
                                    } else {
                                        ()
                                    }
                                };
                                satisfied.get()
                            },
                            Type::Array { len: _, elem: element } => trait_bound_satisfied_at(
                                ctx,
                                element,
                                TraitRef {
                                    name: "Eq",
                                    args: Vec::new(),
                                },
                                depth + 1,
                            ),
                            _ => false,
                        }
                    }
                } else {
                    builtin_value_trait_type(bound_ty) || match bound_ty {
                        Type::RefType { elem: _ } => true,
                        _ => false,
                    }
                }
            } else if trait_name == "Iterator" {
                builtin_iterator_bound_satisfied(ctx, bound_ty, depth)
            } else if trait_name == "IntoIterator" {
                match bound_ty {
                    Type::VecType { elem: _ } | Type::Slice { elem: _ } => true,
                    _ => trait_bound_satisfied_at(
                        ctx,
                        bound_ty,
                        iterator_trait_ref(),
                        depth + 1,
                    ),
                }
            } else {
                false
            },
        }
    }
}

fn trait_bound_satisfied_at(
    ctx: Checker,
    bound_ty: Type,
    reference: TraitRef,
    depth: int,
) -> bool {
    let bound_ty = normalize_type(ctx, bound_ty);
    let reference = normalize_trait_ref(ctx, reference);
    if types_equal(bound_ty, Type::Error) {
        true
    } else if context_trait_bound_satisfied(ctx, bound_ty, reference) {
        true
    } else if depth >= 16 {
        false
    } else if builtin_trait_bound_satisfied(ctx, bound_ty, reference, depth) {
        true
    } else {
        let found = Ref::new(false);
        for impl_info in ctx.impls {
            if !(found.get())
                && !contains_name(ctx.invalid_impl_origins, impl_info.origin)
                && names_match(impl_info.trait_ref.name, reference.name)
            {
                let substitutions = instantiate_substitutions(
                    ctx.counter,
                    impl_info.generics,
                    Vec::new(),
                );
                let owner = substitute_type(impl_info.for_type, substitutions);
                let application = substitute_trait_ref(impl_info.trait_ref, substitutions);
                if unify(owner, bound_ty) {
                    let application = normalize_trait_ref(ctx, application);
                    if unify_types(application.args, reference.args) {
                        let predicates = expand_implied_predicates(
                            ctx,
                            substitute_predicates(impl_info.predicates, substitutions),
                        );
                        apply_predicate_equalities(predicates);
                        if predicates_satisfied_at(ctx, predicates, depth + 1) {
                            found.set(true)
                        } else {
                            ()
                        }
                    } else {
                        ()
                    }
                } else {
                    ()
                }
            } else {
                ()
            }
        };
        found.get()
    }
}

fn instantiated_impl_parts(
    ctx: Checker,
    value: ImplInfo,
) -> (Type, TraitRef, Vec[TypePredicate]) {
    let substitutions = instantiate_substitutions(
        ctx.counter,
        value.generics,
        Vec::new(),
    );
    (
        substitute_type(value.for_type, substitutions),
        substitute_trait_ref(value.trait_ref, substitutions),
        substitute_predicates(value.predicates, substitutions),
    )
}

fn impls_overlap(ctx: Checker, left: ImplInfo, right: ImplInfo) -> bool {
    if !names_match(left.trait_ref.name, right.trait_ref.name) {
        false
    } else {
        let left = instantiated_impl_parts(ctx, left);
        let right = instantiated_impl_parts(ctx, right);
        if !unify(left.0, right.0) || !unify_types(left.1.args, right.1.args) {
            false
        } else {
            let predicates = append_predicates(left.2, right.2);
            predicates_satisfied_at(
                ctx,
                expand_implied_predicates(ctx, predicates),
                0,
            )
        }
    }
}

fn validate_impl_overlaps(ctx: Checker) -> unit {
    for left in range(0, ctx.impls.len()) {
        for right in range(left + 1, ctx.impls.len()) {
            let left_impl = ctx.impls.get(left);
            let right_impl = ctx.impls.get(right);
            if impls_overlap(ctx, left_impl, right_impl) {
                if !contains_name(ctx.invalid_impl_origins, right_impl.origin) {
                    ctx.invalid_impl_origins.push(right_impl.origin)
                } else {
                    ()
                };
                if left_impl.generics.len() == 0
                    && right_impl.generics.len() == 0
                    && types_equal(left_impl.for_type, right_impl.for_type)
                    && trait_ref_equal(left_impl.trait_ref, right_impl.trait_ref)
                {
                    push_diagnostic(
                        ctx,
                        "Trait "
                            + trait_ref_text(left_impl.trait_ref)
                            + " implementation for "
                            + type_text(left_impl.for_type)
                            + " is already defined",
                    )
                } else {
                    push_diagnostic_at(
                        ctx,
                        "Trait "
                            + trait_ref_text(right_impl.trait_ref)
                            + " implementation for "
                            + type_text(right_impl.for_type)
                            + " overlaps with implementation "
                            + left_impl.origin,
                        Option::Some(right_impl.span),
                    )
                }
            } else {
                ()
            }
        }
    }
}

fn builtin_ref_impl_origin(name: string) -> Option[string] {
    if names_match(name, "Eq") {
        Option::Some("builtin#45 at source range 14204..14207")
    } else if names_match(name, "Hash") {
        Option::Some("builtin#46 at source range 14317..14320")
    } else {
        Option::None
    }
}

fn validate_builtin_impl_overlaps(ctx: Checker, value: hir::File) -> unit {
    if value.package_name != "builtin" {
        for item in value.items {
            match item {
                hir::Item::ImplBlock(block) => match block.trait_ref {
                    Option::Some(reference) => {
                        let for_type = type_from_hir(
                            block.for_type,
                            block.generics,
                            Option::None,
                        );
                        match (for_type, builtin_ref_impl_origin(reference.name)) {
                            (Type::RefType { elem: _ }, Option::Some(origin)) => push_diagnostic_at(
                                ctx,
                                "Trait "
                                    + short_name(reference.name)
                                    + " implementation for "
                                    + type_text(for_type)
                                    + " overlaps with implementation "
                                    + origin,
                                Option::Some(block.for_type_span),
                            ),
                            _ => (),
                        }
                    },
                    Option::None => (),
                },
                _ => (),
            }
        }
    } else {
        ()
    }
}

fn method_predicates_satisfied(ctx: Checker, predicates: Vec[TypePredicate]) -> bool {
    predicates_satisfied_at(ctx, predicates, 0)
}

fn method_trait_in_scope(ctx: Checker, value: MethodInfo) -> bool {
    match value.trait_ref {
        Option::Some(reference) => contains_name(ctx.in_scope_traits, reference.name),
        Option::None => true,
    }
}

fn resolve_user_method_for_call(
    ctx: Checker,
    receiver: Type,
    name: string,
    args: Vec[Type],
    expected: Option[Type],
) -> Option[ResolvedCallable] {
    let inherent = Ref::new(Option::None);
    let inherent_matches = Ref::new(0);
    let trait_method = Ref::new(Option::None);
    let trait_matches = Ref::new(0);
    for value in ctx.methods {
        if value.function.name == name
            && receiver_matches(value.for_type, receiver)
            && method_trait_in_scope(ctx, value)
        {
            let candidate = instantiate_method_candidate(ctx, value);
            let matches = match value.trait_ref {
                Option::Some(_) => {
                    method_matches_call(
                        ctx,
                        candidate.callable,
                        receiver,
                        args,
                        expected,
                    ) && unify(candidate.owner, receiver)
                        && method_predicates_satisfied(ctx, candidate.predicates)
                },
                Option::None => {
                    unify(candidate.owner, receiver)
                        && method_predicates_satisfied(ctx, candidate.predicates)
                },
            };
            if matches {
                match value.trait_ref {
                    Option::Some(_) => {
                        trait_matches.set(trait_matches.get() + 1);
                        trait_method.set(Option::Some(candidate.callable))
                    },
                    Option::None => {
                        inherent_matches.set(inherent_matches.get() + 1);
                        inherent.set(Option::Some(candidate.callable))
                    },
                }
            } else {
                ()
            }
        } else {
            ()
        }
    };
    let matches = if inherent_matches.get() > 0 {
        inherent_matches.get()
    } else {
        trait_matches.get()
    };
    if matches == 1 {
        if inherent_matches.get() == 1 {
            inherent.get()
        } else {
            trait_method.get()
        }
    } else {
        if matches > 1 {
            push_diagnostic(ctx, "ambiguous method: " + name)
        } else {
            ()
        };
        Option::None
    }
}

fn callable_type(params: Vec[Type], ret_ty: Type) -> Type {
    Type::Func { params, ret_ty }
}

fn inherent_callable(owner: Type, name: string, params: Vec[Type], ret_ty: Type) -> ResolvedCallable {
    ResolvedCallable {
        callable: Callable::InherentMethod { receiver_ty: owner, method_name: name },
        ty: callable_type(params, ret_ty),
    }
}

fn trait_callable(
    trait_name: string,
    args: Vec[Type],
    name: string,
    params: Vec[Type],
    ret_ty: Type,
) -> ResolvedCallable {
    ResolvedCallable {
        callable: Callable::TraitMethod {
            trait_ref: TraitRef {
                            name: trait_name,
                            args,
                        },
            method_name: name,
        },
        ty: callable_type(params, ret_ty),
    }
}

fn resolve_builtin_method(ctx: Checker, receiver: Type, name: string) -> Option[ResolvedCallable] {
    let receiver = prune(normalize_type(ctx, receiver));
    if name == "to_string" {
        if is_integer_type(receiver) {
            if match receiver {
                Type::Var(_) => true,
                _ => false,
            } {
                expect_type(ctx, receiver, Type::Int)
            } else {
                ()
            };
            let owner = resolve_type(receiver);
            if match owner {
                Type::Int | Type::Int32 => true,
                _ => false,
            } {
                Option::Some(inherent_callable(
                    owner,
                    name,
                    one_type(owner),
                    Type::String,
                ))
            } else {
                Option::Some(trait_callable(
                    "ToString",
                    Vec::new(),
                    name,
                    one_type(owner),
                    Type::String,
                ))
            }
        } else if match receiver {
            Type::Char => true,
            _ => false,
        } {
            Option::Some(inherent_callable(
                Type::Char,
                name,
                one_type(Type::Char),
                Type::String,
            ))
        } else {
            let reference = TraitRef {
                name: "ToString",
                args: Vec::new(),
            };
            if trait_bound_satisfied_at(ctx, receiver, reference, 0) {
                Option::Some(trait_callable(
                    "ToString",
                    Vec::new(),
                    name,
                    one_type(receiver),
                    Type::String,
                ))
            } else {
                Option::None
            }
        }
    } else {
        resolve_builtin_container_method(ctx, receiver, name)
    }
}

fn resolve_builtin_container_method(
    ctx: Checker,
    receiver: Type,
    name: string,
) -> Option[ResolvedCallable] {
    match receiver {
        Type::VecType { elem } => resolve_vec_method(receiver, elem, name),
        Type::Slice { elem } => resolve_slice_method(receiver, elem, name),
        Type::RefType { elem } => resolve_ref_method(receiver, elem, name),
        Type::Channel { elem } => resolve_channel_method(receiver, elem, name),
        Type::HashMap { key, value } => {
            resolve_hashmap_method(ctx, receiver, key, value, name)
        },
        Type::String => resolve_string_method(receiver, name),
        _ => Option::None,
    }
}

fn resolve_vec_method(
    receiver: Type,
    elem: Type,
    name: string,
) -> Option[ResolvedCallable] {
    if name == "push" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), Type::Unit))
        } else if name == "get" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), elem))
        } else if name == "set" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, elem),
                Type::Unit,
            ))
        } else if name == "len" || name == "capacity" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
        } else if name == "is_empty" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Bool))
        } else if name == "reserve" || name == "truncate" {
            Option::Some(inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Int),
                Type::Unit,
            ))
        } else if name == "clear" || name == "reverse" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Unit))
        } else if name == "last" || name == "pop" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("Option", one_type(elem)),
            ))
        } else if name == "swap" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                Type::Unit,
            ))
        } else if name == "swap_remove" || name == "remove" {
            Option::Some(inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Int),
                elem,
            ))
        } else if name == "insert" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, elem),
                Type::Unit,
            ))
        } else if name == "extend" {
            Option::Some(inherent_callable(
                receiver,
                name,
                two_types(receiver, receiver),
                Type::Unit,
            ))
        } else if name == "pushed" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), receiver))
        } else if name == "slice" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                Type::Slice { elem },
            ))
        } else if name == "iter" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("FnIterator", one_type(elem)),
            ))
        } else {
            Option::None
        }
}

fn resolve_slice_method(
    receiver: Type,
    elem: Type,
    name: string,
) -> Option[ResolvedCallable] {
    if name == "get" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), elem))
        } else if name == "len" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
        } else if name == "sub" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                receiver,
            ))
        } else if name == "iter" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("FnIterator", one_type(elem)),
            ))
        } else {
            Option::None
        }
}

fn resolve_ref_method(
    receiver: Type,
    elem: Type,
    name: string,
) -> Option[ResolvedCallable] {
    if name == "get" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), elem))
        } else if name == "set" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, elem), Type::Unit))
        } else {
            Option::None
        }
}

fn resolve_channel_method(
    receiver: Type,
    elem: Type,
    name: string,
) -> Option[ResolvedCallable] {
    if name == "send" {
        Option::Some(inherent_callable(
            receiver,
            name,
            two_types(receiver, elem),
            Type::Unit,
        ))
    } else if name == "recv" {
        Option::Some(inherent_callable(
            receiver,
            name,
            one_type(receiver),
            nominal_type("Option", one_type(elem)),
        ))
    } else if name == "close" {
        Option::Some(inherent_callable(
            receiver,
            name,
            one_type(receiver),
            Type::Unit,
        ))
    } else {
        Option::None
    }
}

fn resolve_hashmap_method(
    ctx: Checker,
    receiver: Type,
    key: Type,
    value: Type,
    name: string,
) -> Option[ResolvedCallable] {
    if name == "get" {
            if hashmap_option_shape_is_valid(ctx) {
                ()
            } else {
                push_diagnostic(ctx,
                    "HashMap::get requires Option[T] to define exactly one empty variant and one payload variant containing T",
                )
            };
            Option::Some(inherent_callable(
                receiver,
                name,
                two_types(receiver, key),
                nominal_type("Option", one_type(value)),
            ))
        } else if name == "set" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, key, value),
                Type::Unit,
            ))
        } else if name == "len" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
        } else if name == "contains" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, key), Type::Bool))
        } else if name == "remove" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, key), Type::Unit))
        } else if name == "entries" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                Type::VecType { elem: Type::Tuple { items: two_types(key, value) } },
            ))
        } else {
            Option::None
        }
}

fn resolve_string_method(receiver: Type, name: string) -> Option[ResolvedCallable] {
    if name == "len" || name == "byte_len" {
            Option::Some(inherent_callable(receiver, name, one_type(receiver), Type::Int))
        } else if name == "get" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Char))
        } else if name == "byte_get" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Uint8))
        } else if name == "byte_slice" {
            Option::Some(inherent_callable(
                receiver,
                name,
                three_types(receiver, Type::Int, Type::Int),
                Type::String,
            ))
        } else if name == "is_char_boundary" {
            Option::Some(inherent_callable(receiver, name, two_types(receiver, Type::Int), Type::Bool))
        } else if name == "decode_at" {
            Option::Some(inherent_callable(
                receiver,
                name,
                two_types(receiver, Type::Int),
                nominal_type(
                    "Option",
                    one_type(Type::Tuple { items: two_types(Type::Char, Type::Int) }),
                ),
            ))
        } else if name == "to_bytes" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                Type::VecType { elem: Type::Uint8 },
            ))
        } else if name == "chars" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type("FnIterator", one_type(Type::Char)),
            ))
        } else if name == "char_indices" {
            Option::Some(inherent_callable(
                receiver,
                name,
                one_type(receiver),
                nominal_type(
                    "FnIterator",
                    one_type(Type::Tuple { items: two_types(Type::Int, Type::Char) }),
                ),
            ))
        } else {
            Option::None
    }
}

fn dyn_method_callable(
    owner: string,
    name: string,
    value: ResolvedCallable,
) -> ResolvedCallable {
    let dispatch = match value.callable {
        Callable::TraitMethod { trait_ref: reference, method_name: _ } => reference.name,
        _ => owner,
    };
    ResolvedCallable {
        callable: Callable::DynTraitMethod {
            trait_name: owner,
            dispatch_name: dispatch,
            method_name: name,
        },
        ty: value.ty,
    }
}

fn resolve_dyn_method(
    ctx: Checker,
    owner: string,
    receiver: Type,
    name: string,
) -> Option[ResolvedCallable] {
    let applications = trait_ref_closure(
        ctx,
        TraitRef {
            name: owner,
            args: Vec::new(),
        },
    );
    if applications.len() == 0 {
        Option::None
    } else {
        match resolve_trait_reference_method(
            ctx,
            applications.get(0),
            name,
            Option::Some(receiver),
        ) {
            Option::Some(value) => Option::Some(dyn_method_callable(owner, name, value)),
            Option::None => {
                let result: Ref[Option[ResolvedCallable]] = Ref::new(Option::None);
                let matches = Ref::new(0);
                for index in range(1, applications.len()) {
                    match resolve_trait_reference_method(
                        ctx,
                        applications.get(index),
                        name,
                        Option::Some(receiver),
                    ) {
                        Option::Some(value) => {
                            matches.set(matches.get() + 1);
                            result.set(Option::Some(dyn_method_callable(owner, name, value)))
                        },
                        Option::None => (),
                    }
                };
                if matches.get() == 1 {
                    result.get()
                } else {
                    if matches.get() > 1 {
                        push_diagnostic(ctx, "ambiguous method: " + name)
                    } else {
                        ()
                    };
                    Option::None
                }
            },
        }
    }
}

fn resolve_method(
    ctx: Checker,
    receiver: Type,
    name: string,
    args: Vec[Type],
    expected: Option[Type],
) -> Option[ResolvedCallable] {
    let receiver = normalize_type(ctx, receiver);
    match receiver {
        Type::Dyn { trait_name: owner } => resolve_dyn_method(ctx, owner, receiver, name),
        _ => match resolve_predicate_method(ctx, receiver, name) {
            Option::Some(value) => Option::Some(value),
            Option::None => match resolve_builtin_container_method(ctx, receiver, name) {
                Option::Some(value) => Option::Some(value),
                Option::None => match resolve_user_method_for_call(
                    ctx,
                    receiver,
                    name,
                    args,
                    expected,
                ) {
                    Option::Some(value) => Option::Some(value),
                    Option::None => resolve_builtin_method(ctx, receiver, name),
                },
            },
        },
    }
}

fn hashmap_option_shape_is_valid(ctx: Checker) -> bool {
    match find_enum_by_name(ctx, "Option") {
        Option::Some(info) => if info.generics.len() == 1 && info.variants.len() == 2 {
            let empty = Ref::new(0);
            let payload = Ref::new(0);
            for variant in info.variants {
                let fields = enum_variant_field_types(variant.fields);
                if fields.len() == 0 {
                    empty.set(empty.get() + 1)
                } else if fields.len() == 1
                    && types_equal(
                        fields.get(0),
                        Type::Param { name: info.generics.get(0) },
                    )
                {
                    payload.set(payload.get() + 1)
                } else {
                    ()
                }
            };
            empty.get() == 1 && payload.get() == 1
        } else {
            false
        },
        Option::None => true,
    }
}

fn require_hashmap_type(ctx: Checker, value: Type) -> unit {
    match prune(normalize_type(ctx, value)) {
        Type::HashMap { key, value: _ } => {
            require_predicate(
                ctx,
                TypePredicate::Trait(
                    key,
                    TraitRef {
                        name: "Eq",
                        args: Vec::new(),
                    },
                ),
                "type predicate not satisfied",
            );
            require_predicate(
                ctx,
                TypePredicate::Trait(
                    key,
                    TraitRef {
                        name: "Hash",
                        args: Vec::new(),
                    },
                ),
                "type predicate not satisfied",
            )
        },
        _ => (),
    }
}

fn find_trait(ctx: Checker, name: string) -> Option[TraitInfo] {
    let result = Ref::new(Option::None);
    for value in ctx.traits {
        if names_match(value.name, name) {
            result.set(Option::Some(value))
        } else {
            ()
        }
    };
    match result.get() {
        Option::Some(value) => Option::Some(value),
        Option::None => builtin_trait_info(short_name(name)),
    }
}

fn find_trait_method(value: TraitInfo, name: string) -> Option[TraitMethodInfo] {
    let result = Ref::new(Option::None);
    for method in value.methods {
        if method.name == name {
            result.set(Option::Some(method))
        } else {
            ()
        }
    };
    result.get()
}

fn builtin_associated_type(
    name: string,
    bounds: Vec[TraitRef],
) -> AssociatedTypeInfo {
    AssociatedTypeInfo {
        name,
        bounds,
    }
}

fn builtin_trait_method(
    name: string,
    params: Vec[Type],
    ret_ty: Type,
) -> TraitMethodInfo {
    TraitMethodInfo {
        name,
        params,
        ret_ty,
    }
}

fn builtin_trait_info(name: string) -> Option[TraitInfo] {
    let self_ty = Type::Param { name: "Self" };
    if name == "Iterator" {
        let associated_types = Vec::new();
        associated_types.push(builtin_associated_type("Item", Vec::new()));
        let item = Type::Projection {
            for_ty: self_ty,
            name: "Item",
            trait_ref: Option::Some(TraitRef {
                            name: "Iterator",
                            args: Vec::new(),
                        }),
        };
        let methods = Vec::new();
        methods.push(builtin_trait_method(
            "next",
            one_type(self_ty),
            nominal_type("Option", one_type(item)),
        ));
        Option::Some(TraitInfo {
            name,
            generics: Vec::new(),
            predicates: Vec::new(),
            supertraits: Vec::new(),
            associated_types,
            methods,
        })
    } else if name == "IntoIterator" {
        let into_iterator = TraitRef {
            name: "IntoIterator",
            args: Vec::new(),
        };
        let item = Type::Projection {
            for_ty: self_ty,
            name: "Item",
            trait_ref: Option::Some(into_iterator),
        };
        let into_iter = Type::Projection {
            for_ty: self_ty,
            name: "IntoIter",
            trait_ref: Option::Some(into_iterator),
        };
        let iterator = TraitRef {
            name: "Iterator",
            args: Vec::new(),
        };
        let iterator_item = Type::Projection {
            for_ty: into_iter,
            name: "Item",
            trait_ref: Option::Some(iterator),
        };
        let predicates = Vec::new();
        predicates.push(TypePredicate::Equality(item, iterator_item));
        let into_iter_bounds = Vec::new();
        into_iter_bounds.push(iterator);
        let associated_types = Vec::new();
        associated_types.push(builtin_associated_type("Item", Vec::new()));
        associated_types.push(builtin_associated_type(
            "IntoIter",
            into_iter_bounds,
        ));
        let methods = Vec::new();
        methods.push(builtin_trait_method(
            "into_iter",
            one_type(self_ty),
            into_iter,
        ));
        Option::Some(TraitInfo {
            name,
            generics: Vec::new(),
            predicates,
            supertraits: Vec::new(),
            associated_types,
            methods,
        })
    } else if name == "Eq" {
        Option::Some(TraitInfo {
            name,
            generics: Vec::new(),
            predicates: Vec::new(),
            supertraits: Vec::new(),
            associated_types: Vec::new(),
            methods: Vec::new().pushed(builtin_trait_method(
                "eq",
                two_types(self_ty, self_ty),
                Type::Bool,
            )),
        })
    } else if name == "Hash" {
        Option::Some(TraitInfo {
            name,
            generics: Vec::new(),
            predicates: Vec::new(),
            supertraits: Vec::new(),
            associated_types: Vec::new(),
            methods: Vec::new().pushed(builtin_trait_method(
                "hash",
                one_type(self_ty),
                Type::Uint64,
            )),
        })
    } else if name == "ToString" {
        Option::Some(TraitInfo {
            name,
            generics: Vec::new(),
            predicates: Vec::new(),
            supertraits: Vec::new(),
            associated_types: Vec::new(),
            methods: Vec::new().pushed(builtin_trait_method(
                "to_string",
                one_type(self_ty),
                Type::String,
            )),
        })
    } else {
        Option::None
    }
}

fn trait_ref_equal(left: TraitRef, right: TraitRef) -> bool {
    names_match(left.name, right.name) && type_lists_equal(left.args, right.args)
}

fn contains_trait_ref(values: Vec[TraitRef], expected: TraitRef) -> bool {
    let found = Ref::new(false);
    for value in values {
        if trait_ref_equal(value, expected) {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn predicate_equal(left: TypePredicate, right: TypePredicate) -> bool {
    match (left, right) {
        (
            TypePredicate::Trait(left_ty, left_ref),
            TypePredicate::Trait(right_ty, right_ref),
        ) => types_equal(left_ty, right_ty) && trait_ref_equal(left_ref, right_ref),
        (
            TypePredicate::Equality(left_lhs, left_rhs),
            TypePredicate::Equality(right_lhs, right_rhs),
        ) => types_equal(left_lhs, right_lhs) && types_equal(left_rhs, right_rhs),
        _ => false,
    }
}

fn push_predicate(values: Vec[TypePredicate], value: TypePredicate) -> unit {
    let found = Ref::new(false);
    for existing in values {
        if predicate_equal(existing, value) {
            found.set(true)
        } else {
            ()
        }
    };
    if found.get() {
        ()
    } else {
        values.push(value)
    }
}

fn trait_ref_closure(ctx: Checker, reference: TraitRef) -> Vec[TraitRef] {
    let result: Vec[TraitRef] = Vec::new();
    result.push(reference);
    let index = Ref::new(0);
    while index.get() < result.len() {
        let current = result.get(index.get());
        index.set(index.get() + 1);
        match find_trait(ctx, current.name) {
            Option::Some(info) => if info.generics.len() == current.args.len() {
                let substitutions = instantiate_substitutions(
                    ctx.counter,
                    info.generics,
                    current.args,
                );
                for supertrait in info.supertraits {
                    let resolved = substitute_trait_ref(supertrait, substitutions);
                    if contains_trait_ref(result, resolved) {
                        ()
                    } else {
                        result.push(resolved)
                    }
                }
            } else {
                ()
            },
            Option::None => (),
        }
    };
    result
}

fn trait_substitutions(
    ctx: Checker,
    info: TraitInfo,
    reference: TraitRef,
    self_ty: Option[Type],
) -> Vec[TypeSubst] {
    let params = append_names(info.generics, Vec::new().pushed("Self"));
    let explicit: Vec[Type] = Vec::new();
    for arg in reference.args {
        explicit.push(arg)
    };
    match self_ty {
        Option::Some(ty) => explicit.push(ty),
        Option::None => (),
    };
    instantiate_substitutions(ctx.counter, params, explicit)
}

struct ProjectionCandidate {
    for_ty: Type,
    trait_ref: TraitRef,
    associated_names: Vec[string],
}

fn projection_candidates_from_predicates(
    ctx: Checker,
    predicates: Vec[TypePredicate],
) -> Vec[ProjectionCandidate] {
    let result = Vec::new();
    for predicate in predicates {
        match predicate {
            TypePredicate::Trait(for_ty, trait_ref) => match find_trait(
                ctx,
                trait_ref.name,
            ) {
                Option::Some(info) => {
                    let associated_names = Vec::new();
                    for associated in info.associated_types {
                        associated_names.push(associated.name)
                    };
                    result.push(ProjectionCandidate {
                        for_ty,
                        trait_ref,
                        associated_names,
                    })
                },
                Option::None => (),
            },
            TypePredicate::Equality(_, _) => (),
        }
    };
    result
}

fn resolve_projection_trait_ref(
    ctx: Checker,
    value: TraitRef,
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> TraitRef {
    let args = Vec::new();
    for arg in value.args {
        args.push(resolve_projection_type(ctx, arg, candidates, report))
    };
    TraitRef {
        name: value.name,
        args,
    }
}

fn resolve_projection_types(
    ctx: Checker,
    values: Vec[Type],
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> Vec[Type] {
    let result = Vec::new();
    for value in values {
        result.push(resolve_projection_type(ctx, value, candidates, report))
    };
    result
}

fn resolve_projection_type(
    ctx: Checker,
    value: Type,
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> Type {
    match resolve_type(value) {
        Type::Projection { for_ty, name, trait_ref } => {
            let for_ty = resolve_projection_type(ctx, for_ty, candidates, report);
            let trait_ref = match trait_ref {
                Option::Some(value) => Option::Some(resolve_projection_trait_ref(
                    ctx,
                    value,
                    candidates,
                    report,
                )),
                Option::None => {
                    let matches = Vec::new();
                    for candidate in candidates {
                        if types_equal(candidate.for_ty, for_ty)
                            && contains_name(candidate.associated_names, name)
                        {
                            matches.push(candidate.trait_ref)
                        } else {
                            ()
                        }
                    };
                    if matches.len() == 1 {
                        Option::Some(resolve_projection_trait_ref(
                            ctx,
                            matches.get(0),
                            candidates,
                            report,
                        ))
                    } else {
                        if report {
                            if matches.len() == 0 {
                                push_diagnostic(ctx,
                                    "associated type "
                                        + name
                                        + " is not provided by a trait bound",
                                )
                            } else {
                                push_diagnostic(ctx,
                                    "associated type " + name + " is ambiguous",
                                )
                            }
                        } else {
                            ()
                        };
                        Option::None
                    }
                },
            };
            Type::Projection { for_ty, name, trait_ref }
        },
        Type::Tuple { items: values } => Type::Tuple {
            items: resolve_projection_types(
                        ctx,
                        values,
                        candidates,
                        report,
                    ),
        },
        Type::App { ty: base, args } => Type::App {
            ty: resolve_projection_type(ctx, base, candidates, report),
            args: resolve_projection_types(ctx, args, candidates, report),
        },
        Type::Array { len: length, elem } => Type::Array {
            len: length,
            elem: resolve_projection_type(ctx, elem, candidates, report),
        },
        Type::Slice { elem } => Type::Slice {
            elem: resolve_projection_type(
                        ctx,
                        elem,
                        candidates,
                        report,
                    ),
        },
        Type::VecType { elem } => Type::VecType {
            elem: resolve_projection_type(
                        ctx,
                        elem,
                        candidates,
                        report,
                    ),
        },
        Type::RefType { elem } => Type::RefType {
            elem: resolve_projection_type(
                        ctx,
                        elem,
                        candidates,
                        report,
                    ),
        },
        Type::Channel { elem } => Type::Channel {
            elem: resolve_projection_type(
                        ctx,
                        elem,
                        candidates,
                        report,
                    ),
        },
        Type::HashMap { key, value } => Type::HashMap {
            key: resolve_projection_type(ctx, key, candidates, report),
            value: resolve_projection_type(ctx, value, candidates, report),
        },
        Type::Func { params, ret_ty } => Type::Func {
            params: resolve_projection_types(ctx, params, candidates, report),
            ret_ty: resolve_projection_type(ctx, ret_ty, candidates, report),
        },
        other => other,
    }
}

fn resolve_projection_predicates(
    ctx: Checker,
    predicates: Vec[TypePredicate],
    candidates: Vec[ProjectionCandidate],
    report: bool,
) -> Vec[TypePredicate] {
    let result = Vec::new();
    for predicate in predicates {
        result.push(match predicate {
            TypePredicate::Trait(for_ty, trait_ref) => TypePredicate::Trait(
                resolve_projection_type(ctx, for_ty, candidates, report),
                resolve_projection_trait_ref(ctx, trait_ref, candidates, report),
            ),
            TypePredicate::Equality(left, right) => TypePredicate::Equality(
                resolve_projection_type(ctx, left, candidates, report),
                resolve_projection_type(ctx, right, candidates, report),
            ),
        })
    };
    result
}

fn resolve_signature_predicates(
    ctx: Checker,
    predicates: Vec[TypePredicate],
    report: bool,
) -> Vec[TypePredicate] {
    if report {
        for predicate in predicates {
            match predicate {
                TypePredicate::Trait(for_ty, reference) => {
                    validate_signature_type(ctx, for_ty);
                    validate_trait_reference(ctx, reference)
                },
                TypePredicate::Equality(left, right) => {
                    validate_signature_type(ctx, left);
                    validate_signature_type(ctx, right)
                },
            }
        }
    } else {
        ()
    };
    let candidates = projection_candidates_from_predicates(ctx, predicates);
    expand_implied_predicates(
        ctx,
        resolve_projection_predicates(ctx, predicates, candidates, report),
    )
}

fn builtin_nominal_arity(name: string) -> Option[int] {
    if name == "Option"
        || name == "Vec"
        || name == "Slice"
        || name == "Ref"
        || name == "Channel"
        || name == "FnIterator"
        || name == "TakeIterator"
    {
        Option::Some(1)
    } else if name == "Result" || name == "HashMap" || name == "FilterIterator" {
        Option::Some(2)
    } else if name == "MapIterator" {
        Option::Some(3)
    } else {
        Option::None
    }
}

fn nominal_arity(ctx: Checker, name: string) -> Option[int] {
    match find_enum_by_name(ctx, name) {
        Option::Some(value) => Option::Some(value.generics.len()),
        Option::None => match find_struct_by_name(ctx, name) {
            Option::Some(value) => Option::Some(value.generics.len()),
            Option::None => builtin_nominal_arity(short_name(name)),
        },
    }
}

fn nominal_application_has_wrong_arity(ctx: Checker, value: Type) -> bool {
    match prune(value) {
        Type::Con { name } => match nominal_arity(ctx, name) {
            Option::Some(expected) => expected != 0,
            Option::None => false,
        },
        Type::App { ty: base, args } => match prune(base) {
            Type::Con { name } => match nominal_arity(ctx, name) {
                Option::Some(expected) => expected != args.len(),
                Option::None => false,
            },
            _ => false,
        },
        _ => false,
    }
}

fn validate_nominal_application(
    ctx: Checker,
    name: string,
    args: Vec[Type],
) -> unit {
    match nominal_arity(ctx, name) {
        Option::Some(expected) => if expected != args.len() {
            let category = if expected == 0 && args.len() > 0 {
                match find_struct_by_name(ctx, name) {
                    Option::Some(_) => "Struct",
                    Option::None => "Type",
                }
            } else {
                "Type"
            };
            push_diagnostic(
                ctx,
                category
                    + " "
                    + short_name(name)
                    + " expects "
                    + expected.to_string()
                    + " type arguments, but got "
                    + args.len().to_string(),
            )
        } else {
            ()
        },
        Option::None => match split_constructor_name(name) {
            Option::Some(parts) => {
                let span = match ctx.current_span.get() {
                    Option::Some(value) => Option::Some(ast::span(
                        value.start + parts.0.byte_len() + 2,
                        value.start
                            + parts.0.byte_len()
                            + 2
                            + short_name(name).byte_len(),
                    )),
                    Option::None => Option::None,
                };
                push_diagnostic_at(
                    ctx,
                    "Unknown type constructor " + name,
                    span,
                );
                push_diagnostic_at(
                    ctx,
                    "package " + parts.0 + " not imported in package main",
                    Option::None,
                )
            },
            Option::None => push_diagnostic(
                ctx,
                "Unknown type constructor " + name,
            ),
        },
    };
    for arg in args {
        validate_signature_type(ctx, arg)
    }
}

fn validate_trait_reference(ctx: Checker, reference: TraitRef) -> unit {
    match find_trait(ctx, reference.name) {
        Option::Some(info) => if info.generics.len() != reference.args.len() {
            push_diagnostic(ctx,
                "trait argument count mismatch for " + reference.name,
            )
        } else {
            ()
        },
        Option::None => push_diagnostic(ctx, "Unknown trait " + reference.name),
    };
    for arg in reference.args {
        validate_signature_type(ctx, arg)
    }
}

fn type_contains_parameter(value: Type, expected: string) -> bool {
    match prune(value) {
        Type::Param { name } => name == expected,
        Type::Tuple { items: values } => {
            let found = Ref::new(false);
            for value in values {
                if type_contains_parameter(value, expected) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Projection { for_ty: base, name: _, trait_ref: qualifier } => {
            let found = Ref::new(type_contains_parameter(base, expected));
            match qualifier {
                Option::Some(reference) => for arg in reference.args {
                    if type_contains_parameter(arg, expected) {
                        found.set(true)
                    } else {
                        ()
                    }
                },
                Option::None => (),
            };
            found.get()
        },
        Type::App { ty: base, args } => {
            let found = Ref::new(type_contains_parameter(base, expected));
            for arg in args {
                if type_contains_parameter(arg, expected) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        Type::Array { len: _, elem }
        | Type::Slice { elem }
        | Type::VecType { elem }
        | Type::RefType { elem }
        | Type::Channel { elem } => type_contains_parameter(elem, expected),
        Type::HashMap { key, value } => {
            type_contains_parameter(key, expected)
                || type_contains_parameter(value, expected)
        },
        Type::Func { params, ret_ty } => {
            let found = Ref::new(type_contains_parameter(ret_ty, expected));
            for param in params {
                if type_contains_parameter(param, expected) {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        _ => false,
    }
}

fn validate_dyn_trait(ctx: Checker, info: TraitInfo) -> unit {
    if info.associated_types.len() > 0 {
        push_diagnostic_at(
            ctx,
            "Trait "
                + info.name
                + " cannot be used as dyn because it declares associated types",
            Option::None,
        )
    } else {
        for method in info.methods {
            if method.params.len() == 0 {
                push_diagnostic_at(ctx,
                    "Trait "
                        + info.name
                        + "::"
                        + method.name
                        + " is not dyn-safe: missing receiver parameter",
                    Option::None,
                )
            } else {
                if !types_equal(method.params.get(0), Type::Param { name: "Self" }) {
                    push_diagnostic_at(ctx,
                        "Trait "
                            + info.name
                            + "::"
                            + method.name
                            + " is not dyn-safe: receiver must be Self",
                        Option::None,
                    )
                } else {
                    ()
                };
                let invalid_parameter = Ref::new(false);
                for index in range(1, method.params.len()) {
                    if type_contains_parameter(method.params.get(index), "Self") {
                        invalid_parameter.set(true)
                    } else {
                        ()
                    }
                };
                if invalid_parameter.get() {
                    push_diagnostic_at(ctx,
                        "Trait "
                            + info.name
                            + "::"
                            + method.name
                            + " is not dyn-safe: Self is not allowed in non-receiver parameters",
                        Option::None,
                    )
                } else {
                    ()
                }
            };
            if type_contains_parameter(method.ret_ty, "Self") {
                push_diagnostic_at(ctx,
                    "Trait "
                        + info.name
                        + "::"
                        + method.name
                        + " is not dyn-safe: Self is not allowed in return type",
                    Option::None,
                )
            } else {
                ()
            }
        }
    }
}

fn validate_signature_type(ctx: Checker, value: Type) -> unit {
    match prune(value) {
        Type::Con { name } => validate_nominal_application(ctx, name, Vec::new()),
        Type::App { ty: base, args } => match prune(base) {
            Type::Con { name } => validate_nominal_application(ctx, name, args),
            _ => {
                push_diagnostic(
                    ctx,
                    "Expected a type constructor, got " + type_text(base),
                );
                validate_signature_type(ctx, base);
                for arg in args {
                    validate_signature_type(ctx, arg)
                }
            },
        },
        Type::Dyn { trait_name: name } => match find_trait(ctx, name) {
            Option::Some(info) => if info.generics.len() > 0 {
                push_diagnostic(ctx, "generic trait cannot be used as dyn " + name)
            } else {
                validate_dyn_trait(ctx, info)
            },
            Option::None => push_diagnostic(ctx, "Unknown trait " + name),
        },
        Type::Projection { for_ty: base, name: _, trait_ref: qualifier } => {
            validate_signature_type(ctx, base);
            match qualifier {
                Option::Some(reference) => validate_trait_reference(ctx, reference),
                Option::None => (),
            }
        },
        Type::Tuple { items: values } => for value in values {
            validate_signature_type(ctx, value)
        },
        Type::Array { len: _, elem: element }
        | Type::Slice { elem: element }
        | Type::VecType { elem: element }
        | Type::RefType { elem: element }
        | Type::Channel { elem: element } => validate_signature_type(ctx, element),
        Type::HashMap { key, value } => {
            validate_signature_type(ctx, key);
            validate_signature_type(ctx, value)
        },
        Type::Func { params, ret_ty } => {
            for param in params {
                validate_signature_type(ctx, param)
            };
            validate_signature_type(ctx, ret_ty)
        },
        _ => (),
    }
}

fn resolve_signature_type(
    ctx: Checker,
    value: Type,
    predicates: Vec[TypePredicate],
    report: bool,
) -> Type {
    if report {
        validate_signature_type(ctx, value)
    } else {
        ()
    };
    resolve_projection_type(
        ctx,
        value,
        projection_candidates_from_predicates(ctx, predicates),
        report,
    )
}

fn resolve_trait_reference_method(
    ctx: Checker,
    reference: TraitRef,
    name: string,
    self_ty: Option[Type],
) -> Option[ResolvedCallable] {
    match find_trait(ctx, reference.name) {
        Option::Some(info) => if info.generics.len() == reference.args.len() {
            match find_trait_method(info, name) {
                Option::Some(method) => {
                    let resolved_self_ty = match self_ty {
                        Option::Some(ty) => Option::Some(ty),
                        Option::None => if method.params.len() == 0 {
                            Option::Some(Type::Unit)
                        } else {
                            Option::None
                        },
                    };
                    let substitutions = trait_substitutions(
                        ctx,
                        info,
                        reference,
                        resolved_self_ty,
                    );
                    let params: Vec[Type] = Vec::new();
                    for param in method.params {
                        params.push(substitute_type(param, substitutions))
                    };
                    Option::Some(trait_callable(
                        reference.name,
                        reference.args,
                        name,
                        params,
                        substitute_type(method.ret_ty, substitutions),
                    ))
                },
                Option::None => Option::None,
            }
        } else {
            Option::None
        },
        Option::None => Option::None,
    }
}

fn expand_implied_predicates(
    ctx: Checker,
    predicates: Vec[TypePredicate],
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::new();
    for predicate in predicates {
        push_predicate(result, predicate)
    };
    let index = Ref::new(0);
    while index.get() < result.len() {
        let predicate = result.get(index.get());
        index.set(index.get() + 1);
        match predicate {
            TypePredicate::Trait(for_ty, reference) => {
                for application in trait_ref_closure(ctx, reference) {
                    push_predicate(result, TypePredicate::Trait(for_ty, application));
                    match find_trait(ctx, application.name) {
                        Option::Some(info) => if info.generics.len() == application.args.len() {
                            let substitutions = trait_substitutions(
                                ctx,
                                info,
                                application,
                                Option::Some(for_ty),
                            );
                            for declared in info.predicates {
                                push_predicate(
                                    result,
                                    substitute_predicate(declared, substitutions),
                                )
                            };
                            for associated in info.associated_types {
                                let projection = Type::Projection {
                                    for_ty,
                                    name: associated.name,
                                    trait_ref: Option::Some(application),
                                };
                                for bound in associated.bounds {
                                    push_predicate(
                                        result,
                                        TypePredicate::Trait(
                                            projection,
                                            substitute_trait_ref(bound, substitutions),
                                        ),
                                    )
                                }
                            }
                        } else {
                            ()
                        },
                        Option::None => (),
                    }
                }
            },
            TypePredicate::Equality(_, _) => (),
        }
    };
    result
}

fn resolve_predicate_method(
    ctx: Checker,
    receiver: Type,
    name: string,
) -> Option[ResolvedCallable] {
    let result = Ref::new(Option::None);
    let matches = Ref::new(0);
    let candidates = Ref::new("");
    for predicate in ctx.predicates {
        match predicate {
            TypePredicate::Trait(bound_ty, reference) => {
                if types_equal(normalize_type(ctx, bound_ty), receiver) {
                    match resolve_trait_reference_method(
                        ctx,
                        reference,
                        name,
                        Option::Some(receiver),
                    ) {
                        Option::Some(value) => {
                            if candidates.get().byte_len() > 0 {
                                candidates.set(candidates.get() + ", ")
                            } else {
                                ()
                            };
                            candidates.set(
                                candidates.get() + short_name(reference.name),
                            );
                            matches.set(matches.get() + 1);
                            result.set(Option::Some(value))
                        },
                        Option::None => (),
                    }
                } else {
                    ()
                }
            },
            TypePredicate::Equality(_, _) => (),
        }
    };
    if matches.get() == 1 {
        result.get()
    } else {
        if matches.get() > 1 {
            push_diagnostic(
                ctx,
                "Ambiguous method "
                    + name
                    + " for type "
                    + type_text(receiver)
                    + " (candidates: "
                    + candidates.get()
                    + "). Use UFCS like Trait::"
                    + name
                    + "(...) to disambiguate",
            )
        } else {
            ()
        };
        if matches.get() > 1 {
            Option::Some(ResolvedCallable {
                callable: Callable::Function("<error>"),
                ty: Type::Error,
            })
        } else {
            Option::None
        }
    }
}

fn resolve_trait_static(
    ctx: Checker,
    owner: string,
    name: string,
    explicit: Vec[Type],
) -> Option[ResolvedCallable] {
    if owner == "ToString" && name == "to_string" {
        let receiver = fresh_type(ctx.counter, VarKind::Any);
        Option::Some(trait_callable(
            owner,
            explicit,
            name,
            one_type(receiver),
            Type::String,
        ))
    } else if owner == "Eq" && name == "eq" {
        let receiver = fresh_type(ctx.counter, VarKind::Any);
        Option::Some(trait_callable(
            owner,
            explicit,
            name,
            two_types(receiver, receiver),
            Type::Bool,
        ))
    } else if owner == "Hash" && name == "hash" {
        let receiver = fresh_type(ctx.counter, VarKind::Any);
        Option::Some(trait_callable(
            owner,
            explicit,
            name,
            one_type(receiver),
            Type::Uint64,
        ))
    } else {
        match find_trait(ctx, owner) {
            Option::Some(info) => {
                let substitutions = instantiate_substitutions(
                    ctx.counter,
                    info.generics,
                    explicit,
                );
                let args: Vec[Type] = Vec::new();
                for generic in info.generics {
                    match find_substitution(substitutions, generic) {
                        Option::Some(ty) => args.push(ty),
                        Option::None => (),
                    }
                };
                let reference = TraitRef {
                    name: info.name,
                    args,
                };
                match resolve_trait_reference_method(
                    ctx,
                    reference,
                    name,
                    Option::None,
                ) {
                    Option::Some(value) => Option::Some(value),
                    Option::None => {
                        let result = Ref::new(Option::None);
                        let matches = Ref::new(0);
                        for candidate in trait_ref_closure(ctx, reference) {
                            if trait_ref_equal(candidate, reference) {
                                ()
                            } else {
                                match resolve_trait_reference_method(
                                    ctx,
                                    candidate,
                                    name,
                                    Option::None,
                                ) {
                                    Option::Some(value) => {
                                        matches.set(matches.get() + 1);
                                        result.set(Option::Some(value))
                                    },
                                    Option::None => (),
                                }
                            }
                        };
                        if matches.get() == 1 {
                            result.get()
                        } else {
                            if matches.get() > 1 {
                                push_diagnostic(ctx, "ambiguous method: " + name)
                            } else {
                                ()
                            };
                            Option::None
                        }
                    },
                }
            },
            Option::None => Option::None,
        }
    }
}

fn explicit_types(ctx: Checker, values: Vec[hir::TypeExpr]) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    for value in values {
        result.push(type_from_hir(value, ctx.type_params, ctx.self_ty))
    };
    result
}

fn resolve_static_member(
    ctx: Checker,
    owner: string,
    member: string,
    type_args: Vec[hir::TypeExpr],
) -> Option[ResolvedCallable] {
    let explicit = explicit_types(ctx, type_args);
    let bare_owner = explicit.len() == 0;
    match explicit_function_scheme(ctx, owner, member) {
        Option::Some(scheme) => {
            let value = instantiate_scheme_candidate(ctx, scheme, explicit);
            Option::Some(ResolvedCallable {
                callable: value.callable,
                ty: value.ty,
            })
        },
        Option::None => match resolve_trait_static(ctx, owner, member, explicit) {
            Option::Some(value) => Option::Some(value),
            Option::None => {
                let owner_ty = nominal_type(owner, explicit);
                match resolve_user_method(ctx, owner_ty, member, Option::None, true) {
                    Option::Some(value) => if bare_owner && nominal_type_is_defined(ctx, owner) {
                        Option::Some(ResolvedCallable {
                            callable: match value.callable {
                                Callable::InherentMethod { receiver_ty: _, method_name: name } => {
                                    Callable::InherentMethod {
                                        receiver_ty: owner_ty,
                                        method_name: name,
                                    }
                                },
                                other => other,
                            },
                            ty: value.ty,
                        })
                    } else {
                        Option::Some(value)
                    },
                    Option::None => resolve_builtin_static(ctx, owner_ty, member),
                }
            },
        },
    }
}

fn resolve_builtin_static(
    ctx: Checker,
    owner: Type,
    name: string,
) -> Option[ResolvedCallable] {
    let owner = match prune(owner) {
        Type::Con { name: owner_name } => if owner_name == "Vec" {
            Type::VecType { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "Ref" {
            Type::RefType { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "Slice" {
            Type::Slice { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "HashMap" {
            Type::HashMap {
                key: fresh_type(ctx.counter, VarKind::Any),
                value: fresh_type(ctx.counter, VarKind::Any),
            }
        } else if owner_name == "Channel" {
            Type::Channel { elem: fresh_type(ctx.counter, VarKind::Any) }
        } else if owner_name == "FnIterator" {
            nominal_type(
                owner_name,
                one_type(fresh_type(ctx.counter, VarKind::Any)),
            )
        } else {
            Type::Con { name: owner_name }
        },
        other => other,
    };
    match owner {
        Type::VecType { elem } => if name == "new" {
            Option::Some(inherent_callable(owner, name, Vec::new(), owner))
        } else if name == "with_capacity" {
            Option::Some(inherent_callable(owner, name, one_type(Type::Int), owner))
        } else {
            Option::None
        },
        Type::RefType { elem } => if name == "new" {
            Option::Some(inherent_callable(owner, name, one_type(elem), owner))
        } else {
            Option::None
        },
        Type::Channel { elem: _ } => if name == "new" {
            Option::Some(inherent_callable(
                owner,
                name,
                one_type(Type::Int),
                owner,
            ))
        } else {
            Option::None
        },
        Type::HashMap { key: _, value: _ } => if name == "new" {
            Option::Some(inherent_callable(owner, name, Vec::new(), owner))
        } else {
            Option::None
        },
        Type::App { ty: base, args } => match type_constructor_name(base) {
            Option::Some(owner_name) => if owner_name == "FnIterator"
                && args.len() == 1
                && name == "from_fn" {
                let item = args.get(0);
                Option::Some(ResolvedCallable {
                    callable: Callable::InherentMethod {
                        receiver_ty: Type::Con { name: owner_name },
                        method_name: name,
                    },
                    ty: callable_type(
                        one_type(Type::Func {
                            params: Vec::new(),
                            ret_ty: nominal_type("Option", one_type(item)),
                        }),
                        owner,
                    ),
                })
            } else {
                Option::None
            },
            Option::None => Option::None,
        },
        _ => Option::None,
    }
}
