package tast;

use gomlang::parser::ast;
use gomlang::parser::hir;

pub struct EnumVariantInfo {
    name: string,
    fields: Vec[Type],
}

pub struct EnumInfo {
    def_id: hir::DefId,
    name: string,
    generics: Vec[string],
    variants: Vec[EnumVariantInfo],
}

pub struct StructInfo {
    def_id: hir::DefId,
    name: string,
    generics: Vec[string],
    fields: Vec[(string, Type)],
}

pub struct TraitMethodInfo {
    name: string,
    params: Vec[Type],
    ret_ty: Type,
}

pub struct AssociatedTypeInfo {
    name: string,
    bounds: Vec[TraitRef],
}

pub struct TraitInfo {
    name: string,
    generics: Vec[string],
    predicates: Vec[TypePredicate],
    supertraits: Vec[TraitRef],
    associated_types: Vec[AssociatedTypeInfo],
    methods: Vec[TraitMethodInfo],
}

pub enum TypePredicate {
    Trait(Type, TraitRef),
    Equality(Type, Type),
}

pub struct FunctionScheme {
    def_id: Option[hir::DefId],
    name: string,
    generics: Vec[string],
    predicates: Vec[TypePredicate],
    params: Vec[Type],
    ret_ty: Type,
    callable: Callable,
}

struct RejectedExtern {
    def_id: hir::DefId,
    name: string,
    arity: int32,
    source_path: string,
    local: bool,
}

struct InstantiatedFunction {
    callable: Callable,
    ty: Type,
    predicates: Vec[TypePredicate],
}

pub struct MethodInfo {
    generics: Vec[string],
    trait_ref: Option[TraitRef],
    for_type: Type,
    function: FunctionScheme,
}

pub struct ImplInfo {
    generics: Vec[string],
    predicates: Vec[TypePredicate],
    trait_ref: TraitRef,
    for_type: Type,
    associated_types: Vec[(string, Type)],
}

struct FieldConstraint {
    receiver: Type,
    name: string,
    field_ty: Type,
    span: Option[ast::Span],
}

struct PredicateRequirement {
    predicate: TypePredicate,
    message: string,
    span: Option[ast::Span],
}

struct CoercionConstraint {
    actual: Type,
    expected: Type,
    span: Option[ast::Span],
}

struct Checker {
    counter: Ref[int32],
    diagnostics: Vec[Diagnostic],
    source_path: string,
    current_span: Ref[Option[ast::Span]],
    coercion_constraints: Vec[CoercionConstraint],
    defer_coercion_depth: Ref[int32],
    package_aliases: Vec[hir::ImportAlias],
    in_scope_traits: Vec[string],
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    traits: Vec[TraitInfo],
    functions: Vec[FunctionScheme],
    rejected_externs: Vec[RejectedExtern],
    methods: Vec[MethodInfo],
    impls: Vec[ImplInfo],
    invalid_impl_arity_owners: Vec[string],
    predicates: Vec[TypePredicate],
    param_aliases: Vec[TypeSubst],
    projection_aliases: Vec[ProjectionAlias],
    field_constraints: Vec[FieldConstraint],
    silent_field_receivers: Vec[Type],
    required_predicates: Vec[PredicateRequirement],
    locals: Vec[(hir::LocalId, Type)],
    unresolved_locals: Vec[hir::LocalId],
    mutable_locals: Vec[hir::LocalId],
    return_ty: Type,
    self_ty: Option[Type],
    type_params: Vec[string],
    loop_depth: Ref[int32],
    condition_depth: Ref[int32],
    condition_loop_depth: Ref[int32],
}

fn new_diagnostic(
    stage: string,
    message: string,
    source_path: string,
    span: Option[ast::Span],
) -> Diagnostic {
    Diagnostic {
        severity: DiagnosticSeverity::Error,
        stage,
        message,
        source_path,
        span,
        primary_label: Option::None,
        secondary_labels: Vec::new(),
    }
}

fn push_warning_at(
    ctx: Checker,
    message: string,
    span: Option[ast::Span],
) -> unit {
    ctx.diagnostics.push(Diagnostic {
        severity: DiagnosticSeverity::Warning,
        stage: "typer",
        message,
        source_path: ctx.source_path,
        span,
        primary_label: Option::None,
        secondary_labels: Vec::new(),
    })
}

fn push_diagnostic(ctx: Checker, message: string) -> unit {
    push_diagnostic_at(ctx, message, ctx.current_span.get())
}

fn push_diagnostic_at(
    ctx: Checker,
    message: string,
    span: Option[ast::Span],
) -> unit {
    let diagnostics = ctx.diagnostics;
    diagnostics.push(new_diagnostic(
        "typer",
        message,
        ctx.source_path,
        span,
    ))
}

fn push_stage_diagnostic(ctx: Checker, stage: string, message: string) -> unit {
    let diagnostics = ctx.diagnostics;
    diagnostics.push(new_diagnostic(
        stage,
        message,
        ctx.source_path,
        ctx.current_span.get(),
    ))
}

fn push_global_diagnostic(ctx: Checker, message: string) -> unit {
    let diagnostics = ctx.diagnostics;
    diagnostics.push(new_diagnostic(
        "typer",
        message,
        "",
        Option::None,
    ))
}

fn diagnostics_from_messages(values: Vec[string], source_path: string) -> Vec[Diagnostic] {
    let diagnostics: Vec[Diagnostic] = Vec::new();
    for value in values {
        diagnostics.push(new_diagnostic("typer", value, source_path, Option::None))
    };
    diagnostics
}

pub struct PackageSignatures {
    traits: Vec[TraitInfo],
    functions: Vec[FunctionScheme],
}

pub struct DependencyEnvironment {
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    traits: Vec[TraitInfo],
    functions: Vec[FunctionScheme],
    methods: Vec[MethodInfo],
    impls: Vec[ImplInfo],
}

pub fn dependency_environment(
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    traits: Vec[TraitInfo],
    functions: Vec[FunctionScheme],
    methods: Vec[MethodInfo],
    impls: Vec[ImplInfo],
) -> DependencyEnvironment {
    DependencyEnvironment {
        enums,
        structs,
        traits,
        functions,
        methods,
        impls,
    }
}

fn contains_name(values: Vec[string], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn append_names(left: Vec[string], right: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in left {
        result.push(value)
    };
    for value in right {
        result.push(value)
    };
    result
}

fn append_predicates(
    left: Vec[TypePredicate],
    right: Vec[TypePredicate],
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::new();
    for value in left {
        result.push(value)
    };
    for value in right {
        result.push(value)
    };
    result
}

fn type_from_hir(value: hir::TypeExpr, params: Vec[string], self_ty: Option[Type]) -> Type {
    match value {
        hir::TypeExpr::Unit => Type::Unit,
        hir::TypeExpr::Bool => Type::Bool,
        hir::TypeExpr::Int8 => Type::Int8,
        hir::TypeExpr::Int16 => Type::Int16,
        hir::TypeExpr::Int32 => Type::Int32,
        hir::TypeExpr::Int64 => Type::Int64,
        hir::TypeExpr::Uint8 => Type::Uint8,
        hir::TypeExpr::Uint16 => Type::Uint16,
        hir::TypeExpr::Uint32 => Type::Uint32,
        hir::TypeExpr::Uint64 => Type::Uint64,
        hir::TypeExpr::Float32 => Type::Float32,
        hir::TypeExpr::Float64 => Type::Float64,
        hir::TypeExpr::String => Type::String,
        hir::TypeExpr::Char => Type::Char,
        hir::TypeExpr::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(type_from_hir(item, params, self_ty))
            };
            Type::Tuple(result)
        },
        hir::TypeExpr::Con(name) => if name == "Self" {
            match self_ty {
                Option::Some(ty) => ty,
                Option::None => Type::Param(name),
            }
        } else if contains_name(params, name) {
            Type::Param(name)
        } else {
            Type::Con(name)
        },
        hir::TypeExpr::Projection(base, name) => {
            Type::Projection(type_from_hir(base, params, self_ty), name, Option::None)
        },
        hir::TypeExpr::Dyn(name) => Type::Dyn(name),
        hir::TypeExpr::App(base, args) => {
            let base = type_from_hir(base, params, self_ty);
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(type_from_hir(arg, params, self_ty))
            };
            match prune(base) {
                Type::Con(name) => nominal_type(name, result),
                _ => Type::App(base, result),
            }
        },
        hir::TypeExpr::Array(length, elem) => Type::Array(
            parse_array_length(length),
            type_from_hir(elem, params, self_ty),
        ),
        hir::TypeExpr::Func(values, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for param in values {
                result.push(type_from_hir(param, params, self_ty))
            };
            Type::Func(result, type_from_hir(ret_ty, params, self_ty))
        },
    }
}

fn trait_ref_from_hir(
    value: hir::TraitRef,
    params: Vec[string],
    self_ty: Option[Type],
) -> TraitRef {
    let args: Vec[Type] = Vec::new();
    for arg in value.args {
        args.push(type_from_hir(arg, params, self_ty))
    };
    TraitRef {
        name: value.name,
        args,
    }
}

fn predicate_from_hir(
    value: hir::Predicate,
    params: Vec[string],
    self_ty: Option[Type],
) -> TypePredicate {
    match value {
        hir::Predicate::Trait(ty, reference) => TypePredicate::Trait(
            type_from_hir(ty, params, self_ty),
            trait_ref_from_hir(reference, params, self_ty),
        ),
        hir::Predicate::Equality(left, right) => TypePredicate::Equality(
            type_from_hir(left, params, self_ty),
            type_from_hir(right, params, self_ty),
        ),
    }
}

fn predicates_from_hir(
    generic_bounds: Vec[(string, Vec[hir::TraitRef])],
    predicates: Vec[hir::Predicate],
    params: Vec[string],
    self_ty: Option[Type],
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::new();
    for generic_bound in generic_bounds {
        for bound in generic_bound.1 {
            result.push(TypePredicate::Trait(
                type_from_hir(hir::TypeExpr::Con(generic_bound.0), params, self_ty),
                trait_ref_from_hir(bound, params, self_ty),
            ))
        }
    };
    for predicate in predicates {
        result.push(predicate_from_hir(predicate, params, self_ty))
    };
    result
}

fn function_scheme(
    value: hir::Function,
    inherited_generics: Vec[string],
    inherited_predicates: Vec[TypePredicate],
    self_ty: Option[Type],
    callable: Callable,
) -> FunctionScheme {
    let generics = append_names(inherited_generics, value.generics);
    let params: Vec[Type] = Vec::new();
    for param in value.params {
        params.push(type_from_hir(param.1, generics, self_ty))
    };
    FunctionScheme {
        def_id: Option::Some(value.def_id),
        name: value.name,
        generics,
        predicates: append_predicates(
            inherited_predicates,
            predicates_from_hir(
                value.generic_bounds,
                value.predicates,
                generics,
                self_ty,
            ),
        ),
        params,
        ret_ty: match value.ret_ty {
            Option::Some(ty) => type_from_hir(ty, generics, self_ty),
            Option::None => Type::Unit,
        },
        callable,
    }
}

fn extern_scheme(value: hir::ExternFunction) -> FunctionScheme {
    let params: Vec[Type] = Vec::new();
    for param in value.params {
        params.push(type_from_hir(param.1, value.generics, Option::None))
    };
    FunctionScheme {
        def_id: Option::Some(value.def_id),
        name: value.name,
        generics: value.generics,
        predicates: predicates_from_hir(
            value.generic_bounds,
            value.predicates,
            value.generics,
            Option::None,
        ),
        params,
        ret_ty: match value.ret_ty {
            Option::Some(ty) => type_from_hir(ty, value.generics, Option::None),
            Option::None => Type::Unit,
        },
        callable: extern_callable(value),
    }
}

fn extern_attribute_payload(value: ast::Attribute, name: string) -> Option[string] {
    let text = value.text;
    let name_end = Ref::new(Option::None);
    let index = Ref::new(0);
    while index.get() + name.byte_len() <= text.byte_len() {
        if text.byte_slice(index.get(), index.get() + name.byte_len()) == name {
            name_end.set(Option::Some(index.get() + name.byte_len()));
            index.set(text.byte_len())
        } else {
            index.set(index.get() + 1)
        }
    };
    match name_end.get() {
        Option::Some(after_name) => {
            let quote_start = Ref::new(Option::None);
            let quote_end = Ref::new(Option::None);
            let scan = Ref::new(after_name);
            while scan.get() < text.byte_len() {
                if text.byte_get(scan.get()) == 34u8 {
                    match quote_start.get() {
                        Option::Some(_) => {
                            quote_end.set(Option::Some(scan.get()));
                            scan.set(text.byte_len())
                        },
                        Option::None => quote_start.set(Option::Some(scan.get() + 1)),
                    }
                } else {
                    ()
                };
                scan.set(scan.get() + 1)
            };
            match (quote_start.get(), quote_end.get()) {
                (Option::Some(start), Option::Some(end)) => {
                    Option::Some(text.byte_slice(start, end))
                },
                _ => Option::None,
            }
        },
        Option::None => Option::None,
    }
}

fn extern_callable(value: hir::ExternFunction) -> Callable {
    let result = Ref::new(Callable::Function(value.name));
    let found = Ref::new(false);
    for attribute in value.attrs {
        if found.get() == false {
            match extern_attribute_payload(attribute, "runtime") {
                Option::Some(name) => {
                    result.set(Callable::Runtime(name));
                    found.set(true)
                },
                Option::None => match extern_attribute_payload(attribute, "intrinsic") {
                    Option::Some(name) => {
                        result.set(Callable::Intrinsic(name));
                        found.set(true)
                    },
                    Option::None => (),
                },
            }
        } else {
            ()
        }
    };
    result.get()
}

fn collect_enum(value: hir::EnumDef) -> EnumInfo {
    let variants: Vec[EnumVariantInfo] = Vec::new();
    for variant in value.variants {
        let fields: Vec[Type] = Vec::new();
        for field in variant.1 {
            fields.push(type_from_hir(field, value.generics, Option::None))
        };
        variants.push(EnumVariantInfo {
            name: variant.0,
            fields,
        })
    };
    EnumInfo {
        def_id: value.def_id,
        name: value.name,
        generics: value.generics,
        variants,
    }
}

fn collect_struct(value: hir::StructDef) -> StructInfo {
    let fields: Vec[(string, Type)] = Vec::new();
    for field in value.fields {
        fields.push((
            field.0,
            type_from_hir(field.1, value.generics, Option::None),
        ))
    };
    StructInfo {
        def_id: value.def_id,
        name: value.name,
        generics: value.generics,
        fields,
    }
}

fn qualify_trait_projection(
    value: Type,
    reference: TraitRef,
    associated_names: Vec[string],
) -> Type {
    match value {
        Type::Tuple(values) => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(qualify_trait_projection(item, reference, associated_names))
            };
            Type::Tuple(result)
        },
        Type::Projection(base, name, qualifier) => {
            let base = qualify_trait_projection(base, reference, associated_names);
            let qualifier = match qualifier {
                Option::Some(value) => Option::Some(value),
                Option::None => match base {
                    Type::Param(owner) => if owner == "Self" && contains_name(associated_names, name) {
                        Option::Some(reference)
                    } else {
                        Option::None
                    },
                    _ => Option::None,
                },
            };
            Type::Projection(base, name, qualifier)
        },
        Type::App(base, args) => {
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(qualify_trait_projection(arg, reference, associated_names))
            };
            Type::App(qualify_trait_projection(base, reference, associated_names), result)
        },
        Type::Array(length, elem) => Type::Array(
            length,
            qualify_trait_projection(elem, reference, associated_names),
        ),
        Type::Slice(elem) => {
            Type::Slice(qualify_trait_projection(elem, reference, associated_names))
        },
        Type::VecType(elem) => {
            Type::VecType(qualify_trait_projection(elem, reference, associated_names))
        },
        Type::RefType(elem) => {
            Type::RefType(qualify_trait_projection(elem, reference, associated_names))
        },
        Type::HashMap(key, item) => Type::HashMap(
            qualify_trait_projection(key, reference, associated_names),
            qualify_trait_projection(item, reference, associated_names),
        ),
        Type::Func(params, ret_ty) => {
            let result: Vec[Type] = Vec::new();
            for param in params {
                result.push(qualify_trait_projection(param, reference, associated_names))
            };
            Type::Func(
                result,
                qualify_trait_projection(ret_ty, reference, associated_names),
            )
        },
        other => other,
    }
}

fn qualify_trait_ref_projection(
    value: TraitRef,
    reference: TraitRef,
    associated_names: Vec[string],
) -> TraitRef {
    let args: Vec[Type] = Vec::new();
    for arg in value.args {
        args.push(qualify_trait_projection(arg, reference, associated_names))
    };
    TraitRef {
        name: value.name,
        args,
    }
}

fn qualify_trait_predicate(
    value: TypePredicate,
    reference: TraitRef,
    associated_names: Vec[string],
) -> TypePredicate {
    match value {
        TypePredicate::Trait(for_ty, trait_ref) => TypePredicate::Trait(
            qualify_trait_projection(for_ty, reference, associated_names),
            qualify_trait_ref_projection(trait_ref, reference, associated_names),
        ),
        TypePredicate::Equality(left, right) => TypePredicate::Equality(
            qualify_trait_projection(left, reference, associated_names),
            qualify_trait_projection(right, reference, associated_names),
        ),
    }
}

fn collect_trait(value: hir::TraitDef) -> TraitInfo {
    let params = append_names(value.generics, Vec::new().pushed("Self"));
    let raw_predicates = predicates_from_hir(
        value.generic_bounds,
        value.predicates,
        params,
        Option::None,
    );
    let supertraits: Vec[TraitRef] = Vec::new();
    for supertrait in value.supertraits {
        supertraits.push(trait_ref_from_hir(supertrait, params, Option::None))
    };
    let trait_args: Vec[Type] = Vec::new();
    for generic in value.generics {
        trait_args.push(Type::Param(generic))
    };
    let reference = TraitRef {
        name: value.name,
        args: trait_args,
    };
    let associated_types: Vec[AssociatedTypeInfo] = Vec::new();
    let associated_names: Vec[string] = Vec::new();
    for associated in value.associated_types {
        let bounds: Vec[TraitRef] = Vec::new();
        for bound in associated.bounds {
            bounds.push(trait_ref_from_hir(bound, params, Option::None))
        };
        associated_types.push(AssociatedTypeInfo {
            name: associated.name,
            bounds,
        });
        associated_names.push(associated.name)
    };
    let predicates: Vec[TypePredicate] = Vec::new();
    for predicate in raw_predicates {
        predicates.push(qualify_trait_predicate(
            predicate,
            reference,
            associated_names,
        ))
    };
    let methods: Vec[TraitMethodInfo] = Vec::new();
    for method in value.method_sigs {
        let method_params: Vec[Type] = Vec::new();
        for param in method.params {
            method_params.push(qualify_trait_projection(
                type_from_hir(param, params, Option::None),
                reference,
                associated_names,
            ))
        };
        methods.push(TraitMethodInfo {
            name: method.name,
            params: method_params,
            ret_ty: qualify_trait_projection(
                type_from_hir(method.ret_ty, params, Option::None),
                reference,
                associated_names,
            ),
        })
    };
    TraitInfo {
        name: value.name,
        generics: value.generics,
        predicates,
        supertraits,
        associated_types,
        methods,
    }
}

fn collected_nominal_arity(
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    name: string,
) -> Option[int32] {
    let result = Ref::new(builtin_nominal_arity(short_name(name)));
    for value in enums {
        if names_match(value.name, name) {
            result.set(Option::Some(value.generics.len()))
        } else {
            ()
        }
    };
    for value in structs {
        if names_match(value.name, name) {
            result.set(Option::Some(value.generics.len()))
        } else {
            ()
        }
    };
    result.get()
}

fn collected_type_error_kind(
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    value: Type,
) -> int32 {
    match prune(value) {
        Type::Con(name) => match collected_nominal_arity(enums, structs, name) {
            Option::Some(expected) => if expected == 0 { 0 } else { 1 },
            Option::None => if name == short_name(name) { 2 } else { 0 },
        },
        Type::Tuple(values) => {
            let result = Ref::new(0);
            for value in values {
                let kind = collected_type_error_kind(enums, structs, value);
                if result.get() == 0 && kind != 0 {
                    result.set(kind)
                } else {
                    ()
                }
            };
            result.get()
        },
        Type::Projection(base, _, _) => collected_type_error_kind(enums, structs, base),
        Type::App(base, args) => {
            let result = match prune(base) {
                Type::Con(name) => match collected_nominal_arity(enums, structs, name) {
                    Option::Some(expected) => if expected == args.len() { 0 } else { 1 },
                    Option::None => if name == short_name(name) { 2 } else { 0 },
                },
                _ => collected_type_error_kind(enums, structs, base),
            };
            let result = Ref::new(result);
            for value in args {
                let kind = collected_type_error_kind(enums, structs, value);
                if result.get() == 0 && kind != 0 {
                    result.set(kind)
                } else {
                    ()
                }
            };
            result.get()
        },
        Type::Array(_, elem)
        | Type::Slice(elem)
        | Type::VecType(elem)
        | Type::RefType(elem) => collected_type_error_kind(enums, structs, elem),
        Type::HashMap(key, value) => {
            let key_kind = collected_type_error_kind(enums, structs, key);
            if key_kind != 0 {
                key_kind
            } else {
                collected_type_error_kind(enums, structs, value)
            }
        },
        Type::Func(params, ret_ty) => {
            let result = Ref::new(collected_type_error_kind(enums, structs, ret_ty));
            for value in params {
                let kind = collected_type_error_kind(enums, structs, value);
                if result.get() == 0 && kind != 0 {
                    result.set(kind)
                } else {
                    ()
                }
            };
            result.get()
        },
        _ => 0,
    }
}

fn collect_environment(file: hir::File, allow_externs: bool) -> Checker {
    let enums: Vec[EnumInfo] = Vec::new();
    let structs: Vec[StructInfo] = Vec::new();
    let traits: Vec[TraitInfo] = Vec::new();
    for item in file.items {
        match item {
            hir::Item::EnumDef(value) => enums.push(collect_enum(value)),
            hir::Item::StructDef(value) => structs.push(collect_struct(value)),
            hir::Item::TraitDef(value) => traits.push(collect_trait(value)),
            _ => (),
        }
    };
    let functions: Vec[FunctionScheme] = Vec::new();
    let rejected_externs: Vec[RejectedExtern] = Vec::new();
    let methods: Vec[MethodInfo] = Vec::new();
    let impls: Vec[ImplInfo] = Vec::new();
    let invalid_impl_arity_owners: Vec[string] = Vec::new();
    for item in file.items {
        match item {
            hir::Item::Function(value) => functions.push(function_scheme(
                value,
                Vec::new(),
                Vec::new(),
                Option::None,
                Callable::Function(value.name),
            )),
            hir::Item::ExternFunction(value) => if allow_externs {
                functions.push(extern_scheme(value))
            } else {
                rejected_externs.push(RejectedExtern {
                    def_id: value.def_id,
                    name: value.name,
                    arity: value.params.len(),
                    source_path: file.source_path,
                    local: true,
                })
            },
            hir::Item::ImplBlock(value) => {
                let for_type = type_from_hir(
                    value.for_type,
                    value.generics,
                    Option::None,
                );
                let trait_ref = match value.trait_ref {
                    Option::Some(reference) => Option::Some(trait_ref_from_hir(
                        reference,
                        value.generics,
                        Option::Some(for_type),
                    )),
                    Option::None => Option::None,
                };
                let predicates = predicates_from_hir(
                    value.generic_bounds,
                    value.predicates,
                    value.generics,
                    Option::Some(for_type),
                );
                let target_error = collected_type_error_kind(enums, structs, for_type);
                if target_error == 0 {
                    match trait_ref {
                        Option::Some(reference) => {
                            let associated_types: Vec[(string, Type)] = Vec::new();
                            for associated in value.associated_types {
                                associated_types.push((
                                    associated.0,
                                    type_from_hir(
                                        associated.1,
                                        value.generics,
                                        Option::Some(for_type),
                                    ),
                                ))
                            };
                            impls.push(ImplInfo {
                                generics: value.generics,
                                predicates,
                                trait_ref: reference,
                                for_type,
                                associated_types,
                            })
                        },
                        Option::None => (),
                    };
                    for method in value.methods {
                        let callable = match trait_ref {
                            Option::Some(reference) => {
                                Callable::TraitMethod(reference, method.name)
                            },
                            Option::None => Callable::InherentMethod(for_type, method.name),
                        };
                        methods.push(MethodInfo {
                            generics: value.generics,
                            trait_ref,
                            for_type,
                            function: function_scheme(
                                method,
                                value.generics,
                                predicates,
                                Option::Some(for_type),
                                callable,
                            ),
                        })
                    }
                } else if target_error == 1 {
                    match type_constructor_name(for_type) {
                        Option::Some(owner) => if !contains_name(
                            invalid_impl_arity_owners,
                            owner,
                        ) {
                            invalid_impl_arity_owners.push(owner)
                        } else {
                            ()
                        },
                        Option::None => (),
                    }
                } else {
                    ()
                }
            },
            _ => (),
        }
    };
    let in_scope_traits = file.use_traits;
    let builtin_traits = Vec::new();
    builtin_traits.push("ToString");
    builtin_traits.push("Eq");
    builtin_traits.push("Hash");
    builtin_traits.push("Iterator");
    builtin_traits.push("IntoIterator");
    for name in builtin_traits {
        if !contains_name(in_scope_traits, name) {
            in_scope_traits.push(name)
        } else {
            ()
        }
    };
    for value in traits {
        if !contains_name(in_scope_traits, value.name) {
            in_scope_traits.push(value.name)
        } else {
            ()
        }
    };
    let environment = Checker {
        counter: Ref::new(0),
        diagnostics: Vec::new(),
        source_path: file.source_path,
        current_span: Ref::new(Option::None),
        coercion_constraints: Vec::new(),
        defer_coercion_depth: Ref::new(0),
        package_aliases: file.import_aliases,
        in_scope_traits,
        enums,
        structs,
        traits,
        functions,
        rejected_externs,
        methods,
        impls,
        invalid_impl_arity_owners,
        predicates: Vec::new(),
        param_aliases: Vec::new(),
        projection_aliases: Vec::new(),
        field_constraints: Vec::new(),
        silent_field_receivers: Vec::new(),
        required_predicates: Vec::new(),
        locals: Vec::new(),
        unresolved_locals: Vec::new(),
        mutable_locals: Vec::new(),
        return_ty: Type::Unit,
        self_ty: Option::None,
        type_params: Vec::new(),
        loop_depth: Ref::new(0),
        condition_depth: Ref::new(0),
        condition_loop_depth: Ref::new(0),
    };
    for index in range(0, environment.functions.len()) {
        let function = environment.functions.get(index);
        let predicates = resolve_signature_predicates(
            environment,
            function.predicates,
            false,
        );
        let params = Vec::new();
        for param in function.params {
            params.push(resolve_signature_type(
                environment,
                param,
                predicates,
                false,
            ))
        };
        environment.functions.set(index, FunctionScheme {
            def_id: function.def_id,
            name: function.name,
            generics: function.generics,
            predicates,
            params,
            ret_ty: resolve_signature_type(
                environment,
                function.ret_ty,
                predicates,
                false,
            ),
            callable: function.callable,
        })
    };
    environment
}

pub fn package_signatures(file: hir::File) -> PackageSignatures {
    let environment = collect_environment(file, true);
    PackageSignatures {
        traits: environment.traits,
        functions: environment.functions,
    }
}

fn canonical_supertrait_scope_name(
    ctx: Checker,
    owner: string,
    name: string,
) -> string {
    let result = Ref::new(name);
    if short_name(name) == name {
        let owner_short = short_name(owner);
        let prefix = owner.byte_slice(0, owner.byte_len() - owner_short.byte_len());
        let candidate = prefix + name;
        for info in ctx.traits {
            if info.name == candidate {
                result.set(candidate)
            } else {
                ()
            }
        }
    } else {
        ()
    };
    result.get()
}

fn expand_in_scope_supertraits(ctx: Checker) -> unit {
    let index = Ref::new(0);
    while index.get() < ctx.in_scope_traits.len() {
        let name = ctx.in_scope_traits.get(index.get());
        index.set(index.get() + 1);
        for info in ctx.traits {
            if info.name == name {
                for supertrait in info.supertraits {
                    let supertrait_name = canonical_supertrait_scope_name(
                        ctx,
                        info.name,
                        supertrait.name,
                    );
                    if contains_name(ctx.in_scope_traits, supertrait_name) {
                        ()
                    } else {
                        ctx.in_scope_traits.push(supertrait_name)
                    }
                }
            } else {
                ()
            }
        }
    }
}

fn external_function_scheme(value: FunctionScheme) -> FunctionScheme {
    FunctionScheme {
        def_id: Option::None,
        name: value.name,
        generics: value.generics,
        predicates: value.predicates,
        params: value.params,
        ret_ty: value.ret_ty,
        callable: value.callable,
    }
}

fn append_package_environment(ctx: Checker, file: hir::File, allow_externs: bool) -> unit {
    let package_env = collect_environment(file, allow_externs);
    for value in package_env.enums {
        ctx.enums.push(value)
    };
    for value in package_env.structs {
        ctx.structs.push(value)
    };
    for value in package_env.traits {
        if contains_name(ctx.in_scope_traits, value.name) {
            ()
        } else {
            ctx.in_scope_traits.push(value.name)
        };
        ctx.traits.push(value)
    };
    for value in package_env.functions {
        ctx.functions.push(value)
    };
    for value in package_env.rejected_externs {
        ctx.rejected_externs.push(RejectedExtern {
            def_id: value.def_id,
            name: value.name,
            arity: value.arity,
            source_path: value.source_path,
            local: false,
        })
    };
    for value in package_env.methods {
        ctx.methods.push(value)
    };
    for value in package_env.impls {
        ctx.impls.push(value)
    }
}

fn dependency_environment_from_hir(file: hir::File) -> DependencyEnvironment {
    let dependency = collect_environment(file, true);
    let enums = Vec::new();
    for value in dependency.enums {
        enums.push(EnumInfo {
            def_id: hir::DefId { pkg: -1, index: -1 },
            name: value.name,
            generics: value.generics,
            variants: value.variants,
        })
    };
    let structs = Vec::new();
    for value in dependency.structs {
        structs.push(StructInfo {
            def_id: hir::DefId { pkg: -1, index: -1 },
            name: value.name,
            generics: value.generics,
            fields: value.fields,
        })
    };
    let functions = Vec::new();
    for value in dependency.functions {
        functions.push(external_function_scheme(value))
    };
    let methods = Vec::new();
    for value in dependency.methods {
        methods.push(MethodInfo {
            generics: value.generics,
            trait_ref: value.trait_ref,
            for_type: value.for_type,
            function: external_function_scheme(value.function),
        })
    };
    DependencyEnvironment {
        enums,
        structs,
        traits: dependency.traits,
        functions,
        methods,
        impls: dependency.impls,
    }
}

pub fn dependency_environments(
    values: Vec[hir::File],
) -> Vec[DependencyEnvironment] {
    let result = Vec::new();
    for value in values {
        result.push(dependency_environment_from_hir(value))
    };
    result
}

fn append_dependency_environment(
    ctx: Checker,
    dependency: DependencyEnvironment,
) -> unit {
    for value in dependency.enums {
        ctx.enums.push(value)
    };
    for value in dependency.structs {
        ctx.structs.push(value)
    };
    for value in dependency.traits {
        ctx.traits.push(value)
    };
    for value in dependency.functions {
        ctx.functions.push(value)
    };
    for value in dependency.methods {
        ctx.methods.push(value)
    };
    for value in dependency.impls {
        ctx.impls.push(value)
    }
}

fn package_function_scheme(
    ctx: Checker,
    owner: string,
    member: string,
) -> Option[FunctionScheme] {
    find_function_by_name(ctx, canonical_imported_name(ctx, owner + "::" + member))
}

fn canonical_imported_name(ctx: Checker, name: string) -> string {
    let result = Ref::new(name);
    let resolved = Ref::new(false);
    for alias in ctx.package_aliases {
        let prefix = alias.alias + "::";
        if resolved.get() == false
            && name.byte_len() > prefix.byte_len()
            && name.byte_slice(0, prefix.byte_len()) == prefix
        {
            result.set(
                alias.package_name
                    + name.byte_slice(alias.alias.byte_len(), name.byte_len()),
            );
            resolved.set(true)
        } else {
            ()
        }
    };
    result.get()
}

fn same_def(left: hir::DefId, right: hir::DefId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

fn same_local(left: hir::LocalId, right: hir::LocalId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

fn contains_local(values: Vec[hir::LocalId], expected: hir::LocalId) -> bool {
    let found = Ref::new(false);
    for value in values {
        if same_local(value, expected) {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn local_name(value: hir::LocalId) -> string {
    value.hint + "/" + value.index.to_string()
}

fn find_local(ctx: Checker, id: hir::LocalId) -> Option[Type] {
    let result = Ref::new(Option::None);
    for value in ctx.locals {
        if same_local(value.0, id) {
            result.set(Option::Some(value.1))
        } else {
            ()
        }
    };
    result.get()
}

fn insert_local(ctx: Checker, id: hir::LocalId, ty: Type) -> unit {
    ctx.locals.push((id, ty))
}

fn mark_mutable_local(ctx: Checker, id: hir::LocalId) -> unit {
    ctx.mutable_locals.push(id)
}

fn local_is_mutable(ctx: Checker, id: hir::LocalId) -> bool {
    let found = Ref::new(false);
    for candidate in ctx.mutable_locals {
        if same_local(candidate, id) {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn find_function_by_def(ctx: Checker, id: hir::DefId) -> Option[FunctionScheme] {
    let result = Ref::new(Option::None);
    for value in ctx.functions {
        match value.def_id {
            Option::Some(candidate) => if same_def(candidate, id) {
                result.set(Option::Some(value))
            } else {
                ()
            },
            Option::None => (),
        }
    };
    result.get()
}

fn find_rejected_extern(ctx: Checker, id: hir::DefId) -> Option[RejectedExtern] {
    let result = Ref::new(Option::None);
    for value in ctx.rejected_externs {
        if same_def(value.def_id, id) {
            result.set(Option::Some(value))
        } else {
            ()
        }
    };
    result.get()
}

fn find_function_by_name(ctx: Checker, name: string) -> Option[FunctionScheme] {
    let result = Ref::new(Option::None);
    for value in ctx.functions {
        if value.name == name {
            result.set(Option::Some(value))
        } else {
            ()
        }
    };
    result.get()
}

fn instantiate_scheme_candidate(
    ctx: Checker,
    value: FunctionScheme,
    explicit: Vec[Type],
) -> InstantiatedFunction {
    let substitutions = instantiate_substitutions(
        ctx.counter,
        value.generics,
        explicit,
    );
    let params: Vec[Type] = Vec::new();
    for param in value.params {
        params.push(substitute_type(param, substitutions))
    };
    let predicates = expand_implied_predicates(
        ctx,
        substitute_predicates(value.predicates, substitutions),
    );
    apply_predicate_equalities(predicates);
    InstantiatedFunction {
        callable: substitute_callable(value.callable, substitutions),
        ty: Type::Func(params, substitute_type(value.ret_ty, substitutions)),
        predicates,
    }
}

fn instantiate_scheme(
    ctx: Checker,
    value: FunctionScheme,
    explicit: Vec[Type],
) -> (Callable, Type) {
    let candidate = instantiate_scheme_candidate(ctx, value, explicit);
    (candidate.callable, candidate.ty)
}

fn substitute_trait_ref(value: TraitRef, substitutions: Vec[TypeSubst]) -> TraitRef {
    let args: Vec[Type] = Vec::new();
    for arg in value.args {
        args.push(substitute_type(arg, substitutions))
    };
    TraitRef {
        name: value.name,
        args,
    }
}

fn substitute_predicate(
    value: TypePredicate,
    substitutions: Vec[TypeSubst],
) -> TypePredicate {
    match value {
        TypePredicate::Trait(ty, reference) => TypePredicate::Trait(
            substitute_type(ty, substitutions),
            substitute_trait_ref(reference, substitutions),
        ),
        TypePredicate::Equality(left, right) => TypePredicate::Equality(
            substitute_type(left, substitutions),
            substitute_type(right, substitutions),
        ),
    }
}

fn substitute_predicates(
    values: Vec[TypePredicate],
    substitutions: Vec[TypeSubst],
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::new();
    for value in values {
        result.push(substitute_predicate(value, substitutions))
    };
    result
}

fn apply_predicate_equalities(values: Vec[TypePredicate]) -> unit {
    for value in values {
        match value {
            TypePredicate::Equality(left, right) => {
                match (prune(left), prune(right)) {
                    (Type::Projection(_, _, _), Type::Projection(_, _, _)) => (),
                    (left, right) => {
                        let _ = unify(left, right);
                    },
                }
            },
            TypePredicate::Trait(_, _) => (),
        }
    }
}

fn substitute_callable(value: Callable, substitutions: Vec[TypeSubst]) -> Callable {
    match value {
        Callable::Function(name) => Callable::Function(name),
        Callable::Runtime(name) => Callable::Runtime(name),
        Callable::Intrinsic(name) => Callable::Intrinsic(name),
        Callable::TraitMethod(reference, name) => {
            Callable::TraitMethod(substitute_trait_ref(reference, substitutions), name)
        },
        Callable::DynTraitMethod(owner, name) => Callable::DynTraitMethod(owner, name),
        Callable::InherentMethod(owner, name) => {
            Callable::InherentMethod(substitute_type(owner, substitutions), name)
        },
    }
}

fn expect_type(ctx: Checker, actual: Type, expected: Type) -> unit {
    expect_type_at(ctx, actual, expected, ctx.current_span.get())
}

fn expect_type_at(
    ctx: Checker,
    actual: Type,
    expected: Type,
    span: Option[ast::Span],
) -> unit {
    let actual = normalize_type(ctx, actual);
    let expected = normalize_type(ctx, expected);
    let message = first_unification_error(actual, expected);
    if !unify(actual, expected) {
        push_diagnostic_at(ctx, match message {
            Option::Some(message) => message,
            Option::None => type_mismatch_text(actual, expected),
        }, span)
    } else {
        ()
    }
}

fn one_type(value: Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    result.push(value);
    result
}

fn two_types(first: Type, second: Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    result.push(first);
    result.push(second);
    result
}

fn three_types(first: Type, second: Type, third: Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    result.push(first);
    result.push(second);
    result.push(third);
    result
}

fn generic_names(first: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    result.push(first);
    result
}

fn generic_names2(first: string, second: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    result.push(first);
    result.push(second);
    result
}

fn generic_names3(first: string, second: string, third: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    result.push(first);
    result.push(second);
    result.push(third);
    result
}

fn iterator_predicates(iterator: Type, item: Option[Type]) -> Vec[TypePredicate] {
    let reference = TraitRef {
        name: "Iterator",
        args: Vec::new(),
    };
    let result: Vec[TypePredicate] = Vec::new();
    result.push(TypePredicate::Trait(iterator, reference));
    match item {
        Option::Some(ty) => result.push(TypePredicate::Equality(
            Type::Projection(iterator, "Item", Option::Some(reference)),
            ty,
        )),
        Option::None => (),
    };
    result
}

fn builtin_callable(name: string) -> Callable {
    let key = if name == "array_get" {
        Option::Some("array.get")
    } else if name == "array_set" {
        Option::Some("array.set")
    } else if name == "ref" {
        Option::Some("ref.new")
    } else if name == "ref_get" {
        Option::Some("ref.get")
    } else if name == "ref_set" {
        Option::Some("ref.set")
    } else if name == "ptr_eq" {
        Option::Some("ref.ptr_eq")
    } else if name == "ptr_hash" {
        Option::Some("ref.ptr_hash")
    } else if name == "vec_new" {
        Option::Some("vec.new")
    } else if name == "vec_with_capacity" {
        Option::Some("vec.with_capacity")
    } else if name == "vec_push" {
        Option::Some("vec.push")
    } else if name == "vec_get" {
        Option::Some("vec.get")
    } else if name == "vec_set" {
        Option::Some("vec.set")
    } else if name == "vec_len" {
        Option::Some("vec.len")
    } else if name == "vec_capacity" {
        Option::Some("vec.capacity")
    } else if name == "vec_reserve" {
        Option::Some("vec.reserve")
    } else if name == "vec_truncate" {
        Option::Some("vec.truncate")
    } else if name == "slice" {
        Option::Some("slice.new")
    } else if name == "slice_get" {
        Option::Some("slice.get")
    } else if name == "slice_len" {
        Option::Some("slice.len")
    } else if name == "slice_sub" {
        Option::Some("slice.sub")
    } else if name == "hashmap_new" {
        Option::Some("hashmap.new")
    } else if name == "hashmap_get" {
        Option::Some("hashmap.get")
    } else if name == "hashmap_set" {
        Option::Some("hashmap.set")
    } else if name == "hashmap_remove" {
        Option::Some("hashmap.remove")
    } else if name == "hashmap_len" {
        Option::Some("hashmap.len")
    } else if name == "hashmap_contains" {
        Option::Some("hashmap.contains")
    } else if name == "hashmap_entries" {
        Option::Some("hashmap.entries")
    } else if name == "missing" {
        Option::Some("compiler.missing")
    } else {
        Option::None
    };
    match key {
        Option::Some(value) => Callable::Intrinsic(value),
        Option::None => if name == "string_len"
            || name == "string_get"
            || name == "string_byte_get"
            || name == "string_byte_slice"
            || name == "string_is_char_boundary"
            || name == "string_decode_utf8_at"
            || name == "string_to_bytes"
            || name == "string_from_utf8"
            || name == "string_concat"
            || name == "string_print"
            || name == "string_println"
            || name == "string_parse_float32"
            || name == "string_parse_float64"
            || name == "string_hash"
            || name == "char_hash"
            || name == "char_from_uint32_raw"
            || name == "int8_hash"
            || name == "int16_hash"
            || name == "int32_hash"
            || name == "int64_hash"
            || name == "uint8_hash"
            || name == "uint16_hash"
            || name == "uint32_hash"
            || name == "float32_hash"
            || name == "float64_hash"
            || name == "unit_to_string"
            || name == "bool_to_string"
            || name == "int8_to_string"
            || name == "int16_to_string"
            || name == "int32_to_string"
            || name == "int64_to_string"
            || name == "uint8_to_string"
            || name == "uint16_to_string"
            || name == "uint32_to_string"
            || name == "uint64_to_string"
            || name == "float32_to_string"
            || name == "float64_to_string"
            || name == "char_to_string" {
            Callable::Runtime(if name == "char_from_uint32_raw" {
                "core.char_from_uint32"
            } else {
                "core." + name
            })
        } else {
            Callable::Function(name)
        },
    }
}

fn apply_builtin_callable(value: Option[FunctionScheme], name: string) -> Option[FunctionScheme] {
    match value {
        Option::Some(scheme) => Option::Some(FunctionScheme {
            def_id: scheme.def_id,
            name: scheme.name,
            generics: scheme.generics,
            predicates: scheme.predicates,
            params: scheme.params,
            ret_ty: scheme.ret_ty,
            callable: builtin_callable(name),
        }),
        Option::None => Option::None,
    }
}

fn builtin_function_scheme(name: string) -> Option[FunctionScheme] {
    let t = Type::Param("T");
    let no_generics: Vec[string] = Vec::new();
    let scheme = if name == "print" || name == "println" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new().pushed(TypePredicate::Trait(
                t,
                TraitRef {
                    name: "ToString",
                    args: Vec::new(),
                },
            )),
            params: one_type(t),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "char_from_uint32" {
        Option::Some(FunctionScheme {
