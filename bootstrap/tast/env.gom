            callable: Callable::Function(name),
        })
    } else if name == "string_byte_slice" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: three_types(Type::String, Type::Int32, Type::Int32),
            ret_ty: Type::String,
            callable: Callable::Function(name),
        })
    } else if name == "string_is_char_boundary" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: two_types(Type::String, Type::Int32),
            ret_ty: Type::Bool,
            callable: Callable::Function(name),
        })
    } else if name == "string_decode_utf8_at" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: two_types(Type::String, Type::Int32),
            ret_ty: Type::Tuple(three_types(Type::Bool, Type::Char, Type::Int32)),
            callable: Callable::Function(name),
        })
    } else if name == "string_to_bytes" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
