            ret_ty: Type::VecType(Type::Uint8),
            callable: Callable::Function(name),
        })
    } else if name == "string_from_utf8" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: one_type(Type::VecType(Type::Uint8)),
            ret_ty: Type::Tuple(two_types(Type::Bool, Type::String)),
            callable: Callable::Function(name),
        })
    } else if name == "string_concat" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: one_type(Type::VecType(Type::String)),
            ret_ty: Type::String,
            callable: Callable::Function(name),
        })
    } else if name == "string_parse_float32" || name == "string_parse_float64" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: one_type(Type::String),
            ret_ty: Type::Tuple(two_types(Type::Bool, Type::Float64)),
            callable: Callable::Function(name),
        })
    } else if name == "string_hash" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: one_type(Type::String),
            ret_ty: Type::Uint64,
            callable: Callable::Function(name),
        })
    } else {
        builtin_collection_function_scheme(name)
    };
    apply_builtin_callable(scheme, name)
}

fn builtin_collection_function_scheme(name: string) -> Option[FunctionScheme] {
    let t = Type::Param("T");
    let empty: Vec[Type] = Vec::new();
    if name == "vec_new" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: empty,
            ret_ty: Type::VecType(t),
            callable: Callable::Function(name),
        })
    } else if name == "vec_with_capacity" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::Int32),
            ret_ty: Type::VecType(t),
            callable: Callable::Function(name),
        })
    } else if name == "vec_push" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::VecType(t), t),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "vec_get" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::VecType(t), Type::Int32),
            ret_ty: t,
            callable: Callable::Function(name),
        })
    } else if name == "vec_set" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: three_types(Type::VecType(t), Type::Int32, t),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "vec_len" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::VecType(t)),
            ret_ty: Type::Int32,
            callable: Callable::Function(name),
        })
    } else if name == "vec_capacity" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::VecType(t)),
            ret_ty: Type::Int32,
            callable: Callable::Function(name),
        })
    } else if name == "vec_reserve" || name == "vec_truncate" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::VecType(t), Type::Int32),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "array_get" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::Array(-1, t), Type::Int32),
            ret_ty: t,
            callable: Callable::Function(name),
        })
    } else if name == "array_set" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: three_types(Type::Array(-1, t), Type::Int32, t),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "ref" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(t),
            ret_ty: Type::RefType(t),
            callable: Callable::Function(name),
        })
    } else if name == "ref_get" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::RefType(t)),
            ret_ty: t,
            callable: Callable::Function(name),
        })
    } else if name == "ref_set" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::RefType(t), t),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "ptr_eq" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::RefType(t), Type::RefType(t)),
            ret_ty: Type::Bool,
            callable: Callable::Function(name),
        })
    } else if name == "ptr_hash" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::RefType(t)),
            ret_ty: Type::Uint64,
            callable: Callable::Function(name),
        })
    } else {
        builtin_hash_slice_function_scheme(name)
    }
}

fn builtin_hash_slice_function_scheme(name: string) -> Option[FunctionScheme] {
    let t = Type::Param("T");
    let a = Type::Param("A");
    let b = Type::Param("B");
    let i = Type::Param("I");
    let k = Type::Param("K");
    let v = Type::Param("V");
    let empty: Vec[Type] = Vec::new();
    let no_generics: Vec[string] = Vec::new();
    let hashmap_predicates = Vec::new()
        .pushed(TypePredicate::Trait(
            k,
            TraitRef {
                name: "Eq",
                args: Vec::new(),
            },
        ))
        .pushed(TypePredicate::Trait(
            k,
            TraitRef {
                name: "Hash",
                args: Vec::new(),
            },
        ));
    if name == "hashmap_new" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: empty,
            ret_ty: Type::HashMap(k, v),
            callable: Callable::Function(name),
        })
    } else if name == "hashmap_get" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: two_types(Type::HashMap(k, v), k),
            ret_ty: nominal_type("Option", one_type(v)),
            callable: Callable::Function(name),
        })
    } else if name == "hashmap_set" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: three_types(Type::HashMap(k, v), k, v),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "hashmap_remove" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: two_types(Type::HashMap(k, v), k),
            ret_ty: Type::Unit,
            callable: Callable::Function(name),
        })
    } else if name == "hashmap_len" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: one_type(Type::HashMap(k, v)),
            ret_ty: Type::Int32,
            callable: Callable::Function(name),
        })
    } else if name == "hashmap_contains" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: two_types(Type::HashMap(k, v), k),
            ret_ty: Type::Bool,
            callable: Callable::Function(name),
        })
    } else if name == "hashmap_entries" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("K", "V"),
            predicates: hashmap_predicates,
            params: one_type(Type::HashMap(k, v)),
            ret_ty: Type::VecType(Type::Tuple(two_types(k, v))),
            callable: Callable::Function(name),
        })
    } else if name == "slice" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: three_types(Type::VecType(t), Type::Int32, Type::Int32),
            ret_ty: Type::Slice(t),
            callable: Callable::Function(name),
        })
    } else if name == "slice_get" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: two_types(Type::Slice(t), Type::Int32),
            ret_ty: t,
            callable: Callable::Function(name),
        })
    } else if name == "slice_len" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::Slice(t)),
            ret_ty: Type::Int32,
            callable: Callable::Function(name),
        })
    } else if name == "slice_sub" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: three_types(Type::Slice(t), Type::Int32, Type::Int32),
            ret_ty: Type::Slice(t),
            callable: Callable::Function(name),
        })
    } else if name == "iterator_map" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names3("A", "B", "I"),
            predicates: iterator_predicates(i, Option::Some(a)),
            params: two_types(i, Type::Func(one_type(a), b)),
            ret_ty: nominal_type("MapIterator", three_types(a, b, i)),
            callable: Callable::Function(name),
        })
    } else if name == "iterator_filter" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("T", "I"),
            predicates: iterator_predicates(i, Option::Some(t)),
            params: two_types(i, Type::Func(one_type(t), Type::Bool)),
            ret_ty: nominal_type("FilterIterator", two_types(t, i)),
            callable: Callable::Function(name),
        })
    } else if name == "iterator_take" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("I"),
            predicates: iterator_predicates(i, Option::None),
            params: two_types(i, Type::Int32),
            ret_ty: nominal_type("TakeIterator", one_type(i)),
            callable: Callable::Function(name),
        })
    } else if name == "iterator_fold" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names3("T", "A", "I"),
            predicates: iterator_predicates(i, Option::Some(t)),
            params: three_types(i, a, Type::Func(two_types(a, t), a)),
            ret_ty: a,
            callable: Callable::Function(name),
        })
    } else if name == "iterator_collect" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names2("T", "I"),
            predicates: iterator_predicates(i, Option::Some(t)),
            params: one_type(i),
            ret_ty: Type::VecType(t),
            callable: Callable::Function(name),
        })
    } else if name == "range" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: two_types(Type::Int32, Type::Int32),
            ret_ty: nominal_type("FnIterator", one_type(Type::Int32)),
            callable: Callable::Function(name),
        })
    } else if name == "missing" {
        Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: generic_names("T"),
            predicates: Vec::new(),
            params: one_type(Type::String),
            ret_ty: t,
            callable: Callable::Function(name),
        })
    } else {
        match builtin_conversion_scheme(name) {
            Option::Some(value) => Option::Some(value),
            Option::None => builtin_runtime_scheme(name),
        }
    }
}

fn builtin_conversion_scheme(name: string) -> Option[FunctionScheme] {
    let no_generics: Vec[string] = Vec::new();
    let pair = if name == "unit_to_string" {
        Option::Some((Type::Unit, Type::String))
    } else if name == "bool_to_string" {
        Option::Some((Type::Bool, Type::String))
    } else if name == "int8_to_string" {
        Option::Some((Type::Int8, Type::String))
    } else if name == "int16_to_string" {
        Option::Some((Type::Int16, Type::String))
    } else if name == "int32_to_string" {
        Option::Some((Type::Int32, Type::String))
    } else if name == "int64_to_string" {
        Option::Some((Type::Int64, Type::String))
    } else if name == "uint8_to_string" {
        Option::Some((Type::Uint8, Type::String))
    } else if name == "uint16_to_string" {
        Option::Some((Type::Uint16, Type::String))
    } else if name == "uint32_to_string" {
        Option::Some((Type::Uint32, Type::String))
    } else if name == "uint64_to_string" {
        Option::Some((Type::Uint64, Type::String))
    } else if name == "float32_to_string" {
        Option::Some((Type::Float32, Type::String))
    } else if name == "float64_to_string" {
        Option::Some((Type::Float64, Type::String))
    } else if name == "char_to_string" {
        Option::Some((Type::Char, Type::String))
    } else {
        Option::None
    };
    match pair {
        Option::Some(types) => Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: no_generics,
            predicates: Vec::new(),
            params: one_type(types.0),
            ret_ty: types.1,
            callable: builtin_callable(name),
        }),
        Option::None => Option::None,
    }
}

fn builtin_runtime_scheme(name: string) -> Option[FunctionScheme] {
    let pair = if name == "char_from_uint32_raw" {
        Option::Some((Type::Uint32, Type::Tuple(two_types(Type::Bool, Type::Char))))
    } else if name == "int8_hash" {
        Option::Some((Type::Int8, Type::Uint64))
    } else if name == "int16_hash" {
        Option::Some((Type::Int16, Type::Uint64))
    } else if name == "int32_hash" {
        Option::Some((Type::Int32, Type::Uint64))
    } else if name == "int64_hash" {
        Option::Some((Type::Int64, Type::Uint64))
    } else if name == "uint8_hash" {
        Option::Some((Type::Uint8, Type::Uint64))
    } else if name == "uint16_hash" {
        Option::Some((Type::Uint16, Type::Uint64))
    } else if name == "uint32_hash" {
        Option::Some((Type::Uint32, Type::Uint64))
    } else if name == "float32_hash" {
        Option::Some((Type::Float32, Type::Uint64))
    } else if name == "float64_hash" {
        Option::Some((Type::Float64, Type::Uint64))
    } else if name == "string_hash" {
        Option::Some((Type::String, Type::Uint64))
    } else if name == "char_hash" {
        Option::Some((Type::Char, Type::Uint64))
    } else {
        Option::None
    };
    match pair {
        Option::Some(types) => Option::Some(FunctionScheme {
            def_id: Option::None,
            name,
            generics: Vec::new(),
            predicates: Vec::new(),
            params: one_type(types.0),
            ret_ty: types.1,
            callable: builtin_callable(name),
        }),
        Option::None => Option::None,
    }
}
