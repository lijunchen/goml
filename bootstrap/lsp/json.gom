package lsp;

use std::text;

pub enum JsonValue {
    Object(Vec[(string, JsonValue)]),
    Array(Vec[JsonValue]),
    String(string),
    Number(string),
    Bool(bool),
    Null,
}

struct JsonParser {
    input: string,
    index: Ref[int],
}

fn json_parser(input: string) -> JsonParser {
    JsonParser {
        input,
        index: Ref::new(0),
    }
}

fn json_error(value: JsonParser, message: string) -> string {
    message + " at byte " + value.index.get().to_string()
}

fn json_whitespace(value: uint8) -> bool {
    value == 9 || value == 10 || value == 13 || value == 32
}

fn skip_json_whitespace(value: JsonParser) -> unit {
    while value.index.get() < value.input.byte_len()
        && json_whitespace(value.input.byte_get(value.index.get()))
    {
        value.index.set(value.index.get() + 1)
    }
}

fn hex_digit(value: uint8) -> Option[uint32] {
    if value >= 48 && value <= 57 {
        Option::Some((value - 48) as uint32)
    } else if value >= 65 && value <= 70 {
        Option::Some((value - 55) as uint32)
    } else if value >= 97 && value <= 102 {
        Option::Some((value - 87) as uint32)
    } else {
        Option::None
    }
}

fn parse_hex_quad(value: JsonParser) -> Result[uint32, string] {
    if value.index.get() + 4 > value.input.byte_len() {
        Result::Err(json_error(value, "incomplete unicode escape"))
    } else {
        let result = Ref::new(0 as uint32);
        for offset in range(0, 4) {
            match hex_digit(value.input.byte_get(value.index.get() + offset)) {
                Option::Some(digit) => {
                    result.set(result.get() * 16 + digit)
                },
                Option::None => {
                    return Result::Err(json_error(
                        value,
                        "invalid unicode escape",
                    ))
                },
            }
        };
        value.index.set(value.index.get() + 4);
        Result::Ok(result.get())
    }
}

fn write_codepoint(
    value: JsonParser,
    builder: text::StringBuilder,
    codepoint: uint32,
) -> Result[unit, string] {
    match char_from_uint32(codepoint) {
        Option::Some(character) => {
            builder.write_char(character);
            Result::Ok(())
        },
        Option::None => Result::Err(json_error(
            value,
            "invalid unicode codepoint",
        )),
    }
}

fn parse_unicode_escape(
    value: JsonParser,
    builder: text::StringBuilder,
) -> Result[unit, string] {
    let first = match parse_hex_quad(value) {
        Result::Ok(codepoint) => codepoint,
        Result::Err(error) => return Result::Err(error),
    };
    if first >= 55296 && first <= 56319 {
        if value.index.get() + 2 > value.input.byte_len()
            || value.input.byte_get(value.index.get()) != 92
            || value.input.byte_get(value.index.get() + 1) != 117
        {
            Result::Err(json_error(value, "missing low surrogate"))
        } else {
            value.index.set(value.index.get() + 2);
            let second = match parse_hex_quad(value) {
                Result::Ok(codepoint) => codepoint,
                Result::Err(error) => return Result::Err(error),
            };
            if second < 56320 || second > 57343 {
                Result::Err(json_error(value, "invalid low surrogate"))
            } else {
                write_codepoint(
                    value,
                    builder,
                    65536 + (first - 55296) * 1024 + second - 56320,
                )
            }
        }
    } else if first >= 56320 && first <= 57343 {
        Result::Err(json_error(value, "unexpected low surrogate"))
    } else {
        write_codepoint(value, builder, first)
    }
}

fn parse_json_string(value: JsonParser) -> Result[string, string] {
    if value.index.get() >= value.input.byte_len()
        || value.input.byte_get(value.index.get()) != 34
    {
        return Result::Err(json_error(value, "expected string"))
    } else {
        value.index.set(value.index.get() + 1)
    };
    let builder = text::StringBuilder::new();
    let segment = Ref::new(value.index.get());
    while value.index.get() < value.input.byte_len() {
        let byte = value.input.byte_get(value.index.get());
        if byte == 34 {
            if segment.get() < value.index.get() {
                builder.write_string(value.input.byte_slice(
                    segment.get(),
                    value.index.get(),
                ))
            } else {
                ()
            };
            value.index.set(value.index.get() + 1);
            return Result::Ok(builder.finish())
        } else if byte == 92 {
            if segment.get() < value.index.get() {
                builder.write_string(value.input.byte_slice(
                    segment.get(),
                    value.index.get(),
                ))
            } else {
                ()
            };
            value.index.set(value.index.get() + 1);
            if value.index.get() >= value.input.byte_len() {
                return Result::Err(json_error(value, "incomplete escape"))
            } else {
                ()
            };
            let escape = value.input.byte_get(value.index.get());
            value.index.set(value.index.get() + 1);
            if escape == 34 {
                builder.write_char('"')
            } else if escape == 92 {
                builder.write_char('\\')
            } else if escape == 47 {
                builder.write_char('/')
            } else if escape == 98 {
                match char_from_uint32(8) {
                    Option::Some(character) => builder.write_char(character),
                    Option::None => (),
                }
            } else if escape == 102 {
                match char_from_uint32(12) {
                    Option::Some(character) => builder.write_char(character),
                    Option::None => (),
                }
            } else if escape == 110 {
                builder.write_char('\n')
            } else if escape == 114 {
                builder.write_char('\r')
            } else if escape == 116 {
                builder.write_char('\t')
            } else if escape == 117 {
                match parse_unicode_escape(value, builder) {
                    Result::Ok(()) => (),
                    Result::Err(error) => return Result::Err(error),
                }
            } else {
                return Result::Err(json_error(value, "invalid escape"))
            };
            segment.set(value.index.get())
        } else if byte < 32 {
            return Result::Err(json_error(
                value,
                "unescaped control character",
            ))
        } else {
            value.index.set(value.index.get() + 1)
        }
    };
    Result::Err(json_error(value, "unterminated string"))
}

fn json_digit(value: uint8) -> bool {
    value >= 48 && value <= 57
}

fn parse_digits(value: JsonParser) -> bool {
    let start = value.index.get();
    while value.index.get() < value.input.byte_len()
        && json_digit(value.input.byte_get(value.index.get()))
    {
        value.index.set(value.index.get() + 1)
    };
    value.index.get() > start
}

fn parse_json_number(value: JsonParser) -> Result[JsonValue, string] {
    let start = value.index.get();
    if value.input.byte_get(value.index.get()) == 45 {
        value.index.set(value.index.get() + 1)
    } else {
        ()
    };
    if value.index.get() >= value.input.byte_len() {
        return Result::Err(json_error(value, "incomplete number"))
    } else if value.input.byte_get(value.index.get()) == 48 {
        value.index.set(value.index.get() + 1);
        if value.index.get() < value.input.byte_len()
            && json_digit(value.input.byte_get(value.index.get()))
        {
            return Result::Err(json_error(value, "invalid leading zero"))
        } else {
            ()
        }
    } else if !parse_digits(value) {
        return Result::Err(json_error(value, "expected number"))
    } else {
        ()
    };
    if value.index.get() < value.input.byte_len()
        && value.input.byte_get(value.index.get()) == 46
    {
        value.index.set(value.index.get() + 1);
        if !parse_digits(value) {
            return Result::Err(json_error(
                value,
                "missing fraction digits",
            ))
        } else {
            ()
        }
    } else {
        ()
    };
    if value.index.get() < value.input.byte_len()
        && (value.input.byte_get(value.index.get()) == 101
            || value.input.byte_get(value.index.get()) == 69)
    {
        value.index.set(value.index.get() + 1);
        if value.index.get() < value.input.byte_len()
            && (value.input.byte_get(value.index.get()) == 43
                || value.input.byte_get(value.index.get()) == 45)
        {
            value.index.set(value.index.get() + 1)
        } else {
            ()
        };
        if !parse_digits(value) {
            return Result::Err(json_error(
                value,
                "missing exponent digits",
            ))
        } else {
            ()
        }
    } else {
        ()
    };
    Result::Ok(JsonValue::Number(value.input.byte_slice(
        start,
        value.index.get(),
    )))
}

fn parse_json_literal(
    value: JsonParser,
    expected: string,
    result: JsonValue,
) -> Result[JsonValue, string] {
    if value.index.get() + expected.byte_len() <= value.input.byte_len()
        && value.input.byte_slice(
            value.index.get(),
            value.index.get() + expected.byte_len(),
        ) == expected
    {
        value.index.set(value.index.get() + expected.byte_len());
        Result::Ok(result)
    } else {
        Result::Err(json_error(value, "invalid literal"))
    }
}

fn parse_json_array(value: JsonParser) -> Result[JsonValue, string] {
    value.index.set(value.index.get() + 1);
    skip_json_whitespace(value);
    let result = Vec::new();
    if value.index.get() < value.input.byte_len()
        && value.input.byte_get(value.index.get()) == 93
    {
        value.index.set(value.index.get() + 1);
        return Result::Ok(JsonValue::Array(result))
    } else {
        ()
    };
    while value.index.get() < value.input.byte_len() {
        match parse_json_value(value) {
            Result::Ok(item) => result.push(item),
            Result::Err(error) => return Result::Err(error),
        };
        skip_json_whitespace(value);
        if value.index.get() >= value.input.byte_len() {
            return Result::Err(json_error(value, "unterminated array"))
        } else if value.input.byte_get(value.index.get()) == 93 {
            value.index.set(value.index.get() + 1);
            return Result::Ok(JsonValue::Array(result))
        } else if value.input.byte_get(value.index.get()) == 44 {
            value.index.set(value.index.get() + 1);
            skip_json_whitespace(value)
        } else {
            return Result::Err(json_error(
                value,
                "expected array separator",
            ))
        }
    };
    Result::Err(json_error(value, "unterminated array"))
}

fn parse_json_object(value: JsonParser) -> Result[JsonValue, string] {
    value.index.set(value.index.get() + 1);
    skip_json_whitespace(value);
    let result = Vec::new();
    if value.index.get() < value.input.byte_len()
        && value.input.byte_get(value.index.get()) == 125
    {
        value.index.set(value.index.get() + 1);
        return Result::Ok(JsonValue::Object(result))
    } else {
        ()
    };
    while value.index.get() < value.input.byte_len() {
        let name = match parse_json_string(value) {
            Result::Ok(name) => name,
            Result::Err(error) => return Result::Err(error),
        };
        skip_json_whitespace(value);
        if value.index.get() >= value.input.byte_len()
            || value.input.byte_get(value.index.get()) != 58
        {
            return Result::Err(json_error(value, "expected object colon"))
        } else {
            value.index.set(value.index.get() + 1)
        };
        skip_json_whitespace(value);
        match parse_json_value(value) {
            Result::Ok(item) => result.push((name, item)),
            Result::Err(error) => return Result::Err(error),
        };
        skip_json_whitespace(value);
        if value.index.get() >= value.input.byte_len() {
            return Result::Err(json_error(value, "unterminated object"))
        } else if value.input.byte_get(value.index.get()) == 125 {
            value.index.set(value.index.get() + 1);
            return Result::Ok(JsonValue::Object(result))
        } else if value.input.byte_get(value.index.get()) == 44 {
            value.index.set(value.index.get() + 1);
            skip_json_whitespace(value)
        } else {
            return Result::Err(json_error(
                value,
                "expected object separator",
            ))
        }
    };
    Result::Err(json_error(value, "unterminated object"))
}

fn parse_json_value(value: JsonParser) -> Result[JsonValue, string] {
    skip_json_whitespace(value);
    if value.index.get() >= value.input.byte_len() {
        Result::Err(json_error(value, "expected JSON value"))
    } else {
        match value.input.byte_get(value.index.get()) {
            123 => parse_json_object(value),
            91 => parse_json_array(value),
            34 => match parse_json_string(value) {
                Result::Ok(text) => Result::Ok(JsonValue::String(text)),
                Result::Err(error) => Result::Err(error),
            },
            116 => parse_json_literal(value, "true", JsonValue::Bool(true)),
            102 => parse_json_literal(value, "false", JsonValue::Bool(false)),
            110 => parse_json_literal(value, "null", JsonValue::Null),
            byte => if byte == 45 || json_digit(byte) {
                parse_json_number(value)
            } else {
                Result::Err(json_error(value, "unexpected JSON token"))
            },
        }
    }
}

pub fn parse_json(input: string) -> Result[JsonValue, string] {
    let parser = json_parser(input);
    let result = match parse_json_value(parser) {
        Result::Ok(value) => value,
        Result::Err(error) => return Result::Err(error),
    };
    skip_json_whitespace(parser);
    if parser.index.get() == input.byte_len() {
        Result::Ok(result)
    } else {
        Result::Err(json_error(parser, "trailing JSON data"))
    }
}

fn json_hex_digit(value: uint8) -> char {
    "0123456789abcdef".get(value as int)
}

fn write_json_string(builder: text::StringBuilder, value: string) -> unit {
    builder.write_char('"');
    let start = Ref::new(0);
    for index in range(0, value.byte_len()) {
        let byte = value.byte_get(index);
        if byte == 34
            || byte == 92
            || byte == 8
            || byte == 9
            || byte == 10
            || byte == 12
            || byte == 13
            || byte < 32
        {
            if start.get() < index {
                builder.write_string(value.byte_slice(start.get(), index))
            } else {
                ()
            };
            if byte == 34 {
                builder.write_string("\\\"")
            } else if byte == 92 {
                builder.write_string("\\\\")
            } else if byte == 8 {
                builder.write_string("\\b")
            } else if byte == 9 {
                builder.write_string("\\t")
            } else if byte == 10 {
                builder.write_string("\\n")
            } else if byte == 12 {
                builder.write_string("\\f")
            } else if byte == 13 {
                builder.write_string("\\r")
            } else {
                builder.write_string("\\u00");
                builder.write_char(json_hex_digit(byte / 16));
                builder.write_char(json_hex_digit(byte % 16))
            };
            start.set(index + 1)
        } else {
            ()
        }
    };
    if start.get() < value.byte_len() {
        builder.write_string(value.byte_slice(
            start.get(),
            value.byte_len(),
        ))
    } else {
        ()
    };
    builder.write_char('"')
}

fn write_json_value(builder: text::StringBuilder, value: JsonValue) -> unit {
    match value {
        JsonValue::Object(fields) => {
            builder.write_char('{');
            let index = Ref::new(0);
            for field in fields {
                if index.get() > 0 {
                    builder.write_char(',')
                } else {
                    ()
                };
                write_json_string(builder, field.0);
                builder.write_char(':');
                write_json_value(builder, field.1);
                index.set(index.get() + 1)
            };
            builder.write_char('}')
        },
        JsonValue::Array(items) => {
            builder.write_char('[');
            let index = Ref::new(0);
            for item in items {
                if index.get() > 0 {
                    builder.write_char(',')
                } else {
                    ()
                };
                write_json_value(builder, item);
                index.set(index.get() + 1)
            };
            builder.write_char(']')
        },
        JsonValue::String(text) => write_json_string(builder, text),
        JsonValue::Number(number) => builder.write_string(number),
        JsonValue::Bool(value) => builder.write_string(if value {
            "true"
        } else {
            "false"
        }),
        JsonValue::Null => builder.write_string("null"),
    }
}

pub fn encode_json(value: JsonValue) -> string {
    let builder = text::StringBuilder::new();
    write_json_value(builder, value);
    builder.finish()
}

pub fn json_field(value: JsonValue, name: string) -> Option[JsonValue] {
    match value {
        JsonValue::Object(fields) => {
            let result = Ref::new(Option::None);
            for field in fields {
                if field.0 == name {
                    result.set(Option::Some(field.1))
                } else {
                    ()
                }
            };
            result.get()
        },
        _ => Option::None,
    }
}

pub fn json_string(value: JsonValue) -> Option[string] {
    match value {
        JsonValue::String(text) => Option::Some(text),
        _ => Option::None,
    }
}

fn parse_json_int_text(value: string) -> Option[int] {
    if value.byte_len() == 0 {
        Option::None
    } else {
        let negative = value.byte_get(0) == 45;
        let index = Ref::new(if negative { 1 } else { 0 });
        let result = Ref::new(0);
        if index.get() == value.byte_len() {
            return Option::None
        } else {
            ()
        };
        while index.get() < value.byte_len() {
            let byte = value.byte_get(index.get());
            if byte < 48 || byte > 57 {
                return Option::None
            } else {
                result.set(result.get() * 10 + (byte - 48) as int)
            };
            index.set(index.get() + 1)
        };
        Option::Some(if negative { 0 - result.get() } else { result.get() })
    }
}

pub fn json_int(value: JsonValue) -> Option[int] {
    match value {
        JsonValue::Number(number) => parse_json_int_text(number),
        _ => Option::None,
    }
}

pub fn json_bool(value: JsonValue) -> Option[bool] {
    match value {
        JsonValue::Bool(result) => Option::Some(result),
        _ => Option::None,
    }
}

pub fn json_array(value: JsonValue) -> Option[Vec[JsonValue]] {
    match value {
        JsonValue::Array(items) => Option::Some(items),
        _ => Option::None,
    }
}

pub fn json_object(fields: Vec[(string, JsonValue)]) -> JsonValue {
    JsonValue::Object(fields)
}
