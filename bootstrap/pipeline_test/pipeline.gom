package pipeline;

use gomlc::anf;
use gomlc::ast;
use gomlc::cmd::gomlc as compiler_driver;
use gomlc::core;
use gomlc::cst;
use gomlc::go_backend;
use gomlc::hir;
use gomlc::lift;
use gomlc::mono;
use gomlc::parser;
use gomlc::tast;
use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;

pub fn repo_root() -> string {
    match env::var("GOML_REPO") {
        Option::Some(value) => value,
        Option::None => "..",
    }
}

pub fn fixture_dir(name: string) -> string {
    path::join(
        path::join(repo_root(), "crates/compiler/src/tests/pipeline"),
        name,
    )
}

pub fn read_snapshot(base: string, extension: string) -> string {
    let file = path::join(base, "main.gom." + extension);
    match fs::read_file(file) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail("failed to read " + file + ": " + message);
            ""
        },
    }
}

fn go_available() -> bool {
    match process::Command::new("go").arg("version").output() {
        Result::Ok(output) => process::ExitStatus::success(process::Output::status(output)),
        Result::Err(_) => false,
    }
}

fn has_out_snapshot(base: string) -> bool {
    fs::is_file(path::join(base, "main.gom.out"))
}

fn tmp_dir() -> string {
    match env::var("TMPDIR") {
        Option::Some(value) => if value == "" { "/tmp" } else { value },
        Option::None => "/tmp",
    }
}

fn execute_go_and_read_stdout(go_source: string) -> string {
    let work_dir = path::join(tmp_dir(), "gomlc-pipeline-test");
    match fs::create_dir_all(work_dir) {
        Result::Ok(()) => (),
        Result::Err(message) => {
            testing::fail("failed to create Go work dir: " + message);
            return ""
        },
    };
    let main_file = path::join(work_dir, "main.go");
    match fs::write_file(main_file, go_source) {
        Result::Ok(()) => (),
        Result::Err(message) => {
            testing::fail("failed to write Go source: " + message);
            return ""
        },
    };
    match process::Command::new("go")
        .arg("run")
        .arg("main.go")
        .current_dir(work_dir)
        .env("GOWORK", "off")
        .env("GO111MODULE", "off")
        .output()
    {
        Result::Ok(output) => {
            if process::ExitStatus::success(process::Output::status(output)) {
                match process::Output::stdout(output).to_string() {
                    Result::Ok(value) => value,
                    Result::Err(message) => {
                        testing::fail("failed to decode Go stdout: " + message);
                        ""
                    },
                }
            } else {
                match process::Output::stderr(output).to_string() {
                    Result::Ok(value) => {
                        testing::fail("go run failed: " + value);
                        ""
                    },
                    Result::Err(_) => {
                        testing::fail("go run failed (non-UTF-8 stderr)");
                        ""
                    },
                }
            }
        },
        Result::Err(message) => {
            testing::fail("failed to execute go run: " + message);
            ""
        },
    }
}

pub fn all_pipeline_cases() -> Vec[string] {
    let result = Vec::new();
    let root = path::join(
        repo_root(),
        "crates/compiler/src/tests/pipeline",
    );
    match fs::read_dir(root) {
        Result::Ok(names) => for name in names {
            let directory = path::join(root, name);
            if fs::is_dir(directory)
                && fs::is_file(path::join(directory, "main.gom"))
            {
                result.push(name)
            } else {
                ()
            }
        },
        Result::Err(message) => {
            testing::fail("failed to read pipeline fixtures: " + message)
        },
    };
    result
}

pub fn test_one_case(name: string) -> unit {
    let base = fixture_dir(name);
    let source_path = path::join(base, "main.gom");
    let source = match fs::read_file(source_path) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail("failed to read " + source_path + ": " + message);
            ""
        },
    };

    let parsed = parser::parse(source);
    testing::assert_eq(cst::debug_tree(parsed), read_snapshot(base, "cst"));

    let compilation = compiler_driver::compile_source(source_path, source);

    testing::assert_eq(ast::pretty(compilation.ast_value), read_snapshot(base, "ast"));
    testing::assert_eq(hir::encode(compilation.hir_value), read_snapshot(base, "hir"));
    testing::assert_eq(tast::encode(compilation.tast_value), read_snapshot(base, "tast"));
    testing::assert_eq(core::encode(compilation.core_value), read_snapshot(base, "core"));
    testing::assert_eq(mono::encode(compilation.mono_value), read_snapshot(base, "mono"));
    testing::assert_eq(lift::encode(compilation.lift_value), read_snapshot(base, "lift"));
    testing::assert_eq(anf::encode(compilation.anf_value), read_snapshot(base, "anf"));
    testing::assert_eq(go_backend::encode(compilation.go_value), read_snapshot(base, "go"));

    if has_out_snapshot(base) {
        if go_available() {
            let go_source = go_backend::encode(compilation.go_value);
            testing::assert_eq(execute_go_and_read_stdout(go_source), read_snapshot(base, "out"))
        } else {
            ()
        }
    } else {
        ()
    }
}
