package ast;

use gomlc::cst;

pub struct Span {
    pub start: int32,
    pub end: int32,
}

pub struct PathSegment {
    pub ident: string,
    pub span: Span,
}

pub struct Path {
    pub segments: Vec[PathSegment],
}

pub enum TypeExpr {
    Unit,
    Bool,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Tuple(Vec[TypeExpr]),
    Con(Path),
    Dyn(Path),
    App(TypeExpr, Vec[TypeExpr]),
    Array(string, TypeExpr),
    Func(Vec[TypeExpr], TypeExpr),
}

pub struct ClosureParam {
    pub name: string,
    pub ty: Option[TypeExpr],
    pub span: Span,
}

pub struct Attribute {
    pub span: Span,
    pub text: string,
}

pub struct File {
    pub package_name: string,
    pub package_explicit: bool,
    pub uses: Vec[UseDecl],
    pub items: Vec[Item],
    pub invalid_self_type_spans: Vec[Span],
}

pub struct UseDecl {
    pub path: Path,
    pub alias: Option[string],
}

pub enum Visibility {
    Private,
    Public,
}

pub enum Item {
    EnumDef(EnumDef),
    StructDef(StructDef),
    TraitDef(TraitDef),
    ImplBlock(ImplBlock),
    Function(Function),
    ExternFunction(ExternFunction),
}

pub struct Function {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub param_type_spans: Vec[Span],
    pub ret_ty: Option[TypeExpr],
    pub ret_ty_span: Option[Span],
    pub body: Block,
}

pub struct ExternFunction {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub ret_ty: Option[TypeExpr],
}

pub struct EnumDef {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariant],
}

pub struct EnumVariant {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[TypeExpr]),
    Struct(Vec[(string, TypeExpr)]),
}

pub struct StructDef {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub fields: Vec[(string, TypeExpr)],
    pub public_fields: Vec[string],
}

pub struct TraitDef {
    pub attrs: Vec[Attribute],
    pub visibility: Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub supertraits: Vec[TraitRef],
    pub associated_types: Vec[AssociatedType],
    pub method_sigs: Vec[TraitMethodSignature],
}

pub struct AssociatedType {
    pub name: string,
    pub bounds: Vec[TraitRef],
}

pub struct TraitRef {
    pub path: Path,
    pub args: Vec[TypeExpr],
}

pub enum Predicate {
    Trait(TypeExpr, TraitRef),
    Equality(TypeExpr, TypeExpr),
}

pub struct TraitMethodSignature {
    pub name: string,
    pub params: Vec[(string, TypeExpr)],
    pub ret_ty: TypeExpr,
}

pub struct ImplBlock {
    pub attrs: Vec[Attribute],
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub associated_types: Vec[(string, TypeExpr)],
    pub trait_ref: Option[TraitRef],
    pub for_type: TypeExpr,
    pub for_type_span: Span,
    pub methods: Vec[Function],
}

pub struct Block {
    pub stmts: Vec[Stmt],
    pub tail: Option[Expr],
    pub span: Span,
}

pub enum Stmt {
    Let(bool, Pat, Option[TypeExpr], Expr, Span),
    Assign(Expr, Expr, Span),
    Expr(Expr, Span),
}

pub enum UnaryOp {
    Neg,
    Not,
    BitNot,
}

pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    And,
    Or,
    Less,
    Greater,
    LessEq,
    GreaterEq,
    Eq,
    NotEq,
}

pub enum Expr {
    Path(Path, Vec[TypeExpr], Span),
    Unit(Span),
    Bool(bool, Span),
    Int(string, Span),
    Int8(string, Span),
    Int16(string, Span),
    Int32(string, Span),
    Int64(string, Span),
    UInt8(string, Span),
    UInt16(string, Span),
    UInt32(string, Span),
    UInt64(string, Span),
    Float(float64, Span),
    Float32(string, Span),
    Float64(string, Span),
    String(string, Span),
    Char(string, Span),
    Constr(Path, Vec[Expr], Span),
    StructLiteral(Path, Vec[(string, Expr)], Span),
    Tuple(Vec[Expr], Span),
    Array(Vec[Expr], Span),
    Closure(Vec[ClosureParam], Expr, Span),
    Match(Expr, Vec[Arm], Span),
    If(Expr, Expr, Expr, Span),
    While(Expr, Expr, Span),
    For(Pat, Expr, Expr, Span),
    Break(Span),
    Continue(Span),
    Return(Option[Expr], Span),
    Go(Expr, Span),
    Call(Expr, Vec[Expr], Span),
    Unary(UnaryOp, Expr, Span),
    Cast(Expr, TypeExpr, Span),
    Try(Expr, Span),
    Binary(BinaryOp, Expr, Expr, Span),
    Proj(Expr, int32, Span),
    Field(Expr, string, Span),
    Index(Expr, Expr, Span),
    Block(Block, Span),
}

pub struct Arm {
    pub pat: Pat,
    pub guard: Option[Expr],
    pub body: Expr,
}

pub struct ArrayPatRest {
    pub binding: Option[string],
    pub span: Span,
}

pub enum Pat {
    Var(string, Span),
    Unit(Span),
    Bool(bool, Span),
    Int(string, Span),
    Int8(string, Span),
    Int16(string, Span),
    Int32(string, Span),
    Int64(string, Span),
    UInt8(string, Span),
    UInt16(string, Span),
    UInt32(string, Span),
    UInt64(string, Span),
    Float(string, Span),
    Float32(string, Span),
    Float64(string, Span),
    String(string, Span),
    Char(string, Span),
    Constr(Path, Vec[Pat], Span),
    Struct(Path, Vec[(string, Pat)], bool, Span),
    Tuple(Vec[Pat], Span),
    Array(Vec[Pat], Option[ArrayPatRest], Vec[Pat], Span),
    Alias(string, Pat, Span),
    Or(Vec[Pat], Span),
    Range(Pat, Pat, bool, Span),
    Wild(Span),
}

pub struct LowerResult {
    pub ast: Option[File],
    pub diagnostics: Vec[cst::Diagnostic],
}

pub fn span(start: int32, end: int32) -> Span {
    Span { start, end }
}

pub fn expr_span(value: Expr) -> Span {
    match value {
        Expr::Unit(span) | Expr::Break(span) | Expr::Continue(span) => span,
        Expr::Bool(_, span)
        | Expr::Int(_, span)
        | Expr::Int8(_, span)
        | Expr::Int16(_, span)
        | Expr::Int32(_, span)
        | Expr::Int64(_, span)
        | Expr::UInt8(_, span)
        | Expr::UInt16(_, span)
        | Expr::UInt32(_, span)
        | Expr::UInt64(_, span)
        | Expr::Float(_, span)
        | Expr::Float32(_, span)
        | Expr::Float64(_, span)
        | Expr::String(_, span)
        | Expr::Char(_, span)
        | Expr::Tuple(_, span)
        | Expr::Array(_, span)
        | Expr::Return(_, span)
        | Expr::Go(_, span)
        | Expr::Try(_, span)
        | Expr::Block(_, span) => span,
        Expr::Path(_, _, span)
        | Expr::Constr(_, _, span)
        | Expr::StructLiteral(_, _, span)
        | Expr::Closure(_, _, span)
        | Expr::Match(_, _, span)
        | Expr::While(_, _, span)
        | Expr::Call(_, _, span)
        | Expr::Unary(_, _, span)
        | Expr::Cast(_, _, span)
        | Expr::Proj(_, _, span)
        | Expr::Field(_, _, span)
        | Expr::Index(_, _, span) => span,
        Expr::If(_, _, _, span)
        | Expr::For(_, _, _, span)
        | Expr::Binary(_, _, _, span) => span,
    }
}

pub fn pat_span(value: Pat) -> Span {
    match value {
        Pat::Unit(span) | Pat::Wild(span) => span,
        Pat::Var(_, span)
        | Pat::Bool(_, span)
        | Pat::Int(_, span)
        | Pat::Int8(_, span)
        | Pat::Int16(_, span)
        | Pat::Int32(_, span)
        | Pat::Int64(_, span)
        | Pat::UInt8(_, span)
        | Pat::UInt16(_, span)
        | Pat::UInt32(_, span)
        | Pat::UInt64(_, span)
        | Pat::Float(_, span)
        | Pat::Float32(_, span)
        | Pat::Float64(_, span)
        | Pat::String(_, span)
        | Pat::Char(_, span)
        | Pat::Tuple(_, span)
        | Pat::Alias(_, _, span)
        | Pat::Or(_, span) => span,
        Pat::Constr(_, _, span)
        | Pat::Struct(_, _, _, span)
        | Pat::Array(_, _, _, span)
        | Pat::Range(_, _, _, span) => span,
    }
}
