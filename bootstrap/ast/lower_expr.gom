package ast;

use gomlc::cst;
use gomlc::lexer;
use std::text;

fn lower_block(ctx: LowerCtx, node: LocatedNode) -> Option[Block] {
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in stmt_children(node) {
        match lower_stmt(ctx, stmt) {
            Option::Some(value) => stmts.push(value),
            Option::None => (),
        }
    };
    let tails = expr_children(node);
    let tail = if tails.len() > 0 {
        lower_expr(ctx, tails.get(0))
    } else {
        Option::None
    };
    Option::Some(Block {
        stmts,
        tail,
        span: node_span(node),
    })
}

fn lower_stmt(ctx: LowerCtx, node: LocatedNode) -> Option[Stmt] {
    match node_kind(node) {
        cst::NodeKind::STMT_LET => {
            let patterns = pattern_children(node);
            let values = expr_children(node);
            if patterns.len() == 0 {
                push_error(ctx, node_span(node), "Let statement missing pattern");
                Option::None
            } else if values.len() == 0 {
                push_error(ctx, node_span(node), "Let statement missing value");
                Option::None
            } else {
                match lower_pat(ctx, patterns.get(0)) {
                    Option::Some(pat) => match lower_expr(ctx, values.get(0)) {
                        Option::Some(value) => {
                            let types = type_children(node);
                            let annotation = if types.len() > 0 {
                                lower_ty(ctx, types.get(0))
                            } else {
                                Option::None
                            };
                            Option::Some(Stmt::Let(
                                has_token(node, lexer::TokenKind::MutKeyword),
                                pat,
                                annotation,
                                value,
                                node_span(node),
                            ))
                        },
                        Option::None => Option::None,
                    },
                    Option::None => Option::None,
                }
            }
        },
        cst::NodeKind::STMT_ASSIGN => {
            let values = expr_children(node);
            if values.len() < 1 {
                push_error(ctx, node_span(node), "Assignment statement missing target");
                Option::None
            } else if values.len() < 2 {
                push_error(ctx, node_span(node), "Assignment statement missing value");
                Option::None
            } else {
                match lower_expr(ctx, values.get(0)) {
                    Option::Some(target) => match lower_expr(ctx, values.get(1)) {
                        Option::Some(value) => Option::Some(Stmt::Assign(target, value, node_span(node))),
                        Option::None => Option::None,
                    },
                    Option::None => Option::None,
                }
            }
        },
        cst::NodeKind::STMT_EXPR => {
            let values = expr_children(node);
            if values.len() == 0 {
                push_error(ctx, node_span(node), "Expression statement missing expression");
                Option::None
            } else {
                match lower_expr(ctx, values.get(0)) {
                    Option::Some(value) => Option::Some(Stmt::Expr(value, node_span(node))),
                    Option::None => Option::None,
                }
            }
        },
        _ => Option::None,
    }
}

fn hex_value(value: uint8) -> Option[uint32] {
    if value >= 48u8 && value <= 57u8 {
        Option::Some(decimal_hex_value(value))
    } else {
        match value {
            65u8 | 97u8 => Option::Some(10u32),
            66u8 | 98u8 => Option::Some(11u32),
            67u8 | 99u8 => Option::Some(12u32),
            68u8 | 100u8 => Option::Some(13u32),
            69u8 | 101u8 => Option::Some(14u32),
            70u8 | 102u8 => Option::Some(15u32),
            _ => Option::None,
        }
    }
}

fn decimal_hex_value(value: uint8) -> uint32 {
    match value {
        48u8 => 0u32,
        49u8 => 1u32,
        50u8 => 2u32,
        51u8 => 3u32,
        52u8 => 4u32,
        53u8 => 5u32,
        54u8 => 6u32,
        55u8 => 7u32,
        56u8 => 8u32,
        _ => 9u32,
    }
}

fn unescape_string(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    let index = Ref::new(0);
    while index.get() < value.byte_len() {
        let byte = value.byte_get(index.get());
        if byte != 92u8 {
            let width = if byte < 128u8 {
                1
            } else if byte < 224u8 {
                2
            } else if byte < 240u8 {
                3
            } else {
                4
            };
            builder.write_string(value.byte_slice(index.get(), index.get() + width));
            index.set(index.get() + width)
        } else if index.get() + 1 >= value.byte_len() {
            builder.write_string("\\");
            index.set(index.get() + 1)
        } else {
            let escaped = value.byte_get(index.get() + 1);
            match escaped {
                34u8 => builder.write_string("\""),
                92u8 => builder.write_string("\\"),
                110u8 => builder.write_string("\n"),
                114u8 => builder.write_string("\r"),
                116u8 => builder.write_string("\t"),
                98u8 => builder.write_string("\b"),
                102u8 => builder.write_string("\f"),
                47u8 => builder.write_string("/"),
                117u8 => {
                    let code = Ref::new(0u32);
                    let cursor = Ref::new(index.get() + 2);
                    let valid = Ref::new(true);
                    while cursor.get() < index.get() + 6 && cursor.get() < value.byte_len() {
                        let digit_byte = value.byte_get(cursor.get());
                        let digit = if digit_byte >= 48u8 && digit_byte <= 57u8 {
                            Option::Some(decimal_hex_value(digit_byte))
                        } else {
                            hex_value(digit_byte)
                        };
                        match digit {
                            Option::Some(part) => code.set(code.get() * 16u32 + part),
                            Option::None => valid.set(false),
                        };
                        cursor.set(cursor.get() + 1)
                    };
                    if valid.get() && cursor.get() == index.get() + 6 {
                        match char_from_uint32(code.get()) {
                            Option::Some(character) => builder.write_string(character.to_string()),
                            Option::None => (),
                        }
                    } else {
                        ()
                    };
                    index.set(index.get() + 4)
                },
                _ => {
                    builder.write_string("\\");
                    builder.write_string(value.byte_slice(index.get() + 1, index.get() + 2))
                },
            };
            index.set(index.get() + 2)
        }
    };
    builder.finish()
}

fn lower_multiline_string(ctx: LowerCtx, node: LocatedNode) -> Option[string] {
    match first_token(node, lexer::TokenKind::MultilineStr) {
        Option::Some(token) => {
            let value = token.token.text;
            let builder = text::StringBuilder::with_capacity(value.byte_len());
            let line_start = Ref::new(0);
            let first = Ref::new(true);
            let valid = Ref::new(true);
            while line_start.get() <= value.byte_len() && valid.get() {
                let line_end = Ref::new(line_start.get());
                while line_end.get() < value.byte_len() && value.byte_get(line_end.get()) != 10u8 {
                    line_end.set(line_end.get() + 1)
                };
                let marker = Ref::new(line_start.get());
                while marker.get() < line_end.get()
                    && (value.byte_get(marker.get()) == 32u8 || value.byte_get(marker.get()) == 9u8)
                {
                    marker.set(marker.get() + 1)
                };
                if marker.get() + 2 > line_end.get()
                    || value.byte_slice(marker.get(), marker.get() + 2) != "\\\\"
                {
                    valid.set(false)
                } else {
                    if first.get() {
                        first.set(false)
                    } else {
                        builder.write_string("\n")
                    };
                    builder.write_string(value.byte_slice(marker.get() + 2, line_end.get()));
                    if line_end.get() >= value.byte_len() {
                        line_start.set(value.byte_len() + 1)
                    } else {
                        line_start.set(line_end.get() + 1)
                    }
                }
            };
            if valid.get() {
                Option::Some(builder.finish())
            } else {
                push_error(ctx, token_span(token), "Invalid multiline string content");
                Option::None
            }
        },
        Option::None => {
            push_error(ctx, node_span(node), "MultilineStrExpr has no value");
            Option::None
        },
    }
}

fn reject_trailing(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr], message: string) -> bool {
    if trailing_args.len() == 0 {
        false
    } else {
        push_error(ctx, node_span(node), message);
        true
    }
}

fn lower_ident_parts(ctx: LowerCtx, node: LocatedNode) -> Option[(Path, Vec[TypeExpr])] {
    match first_child(node, cst::NodeKind::TYPE_TAPP) {
        Option::Some(owner_node) => match first_child(owner_node, cst::NodeKind::PATH) {
            Option::Some(owner_path_node) => match lower_path(ctx, owner_path_node) {
                Option::Some(owner_path) => {
                    let paths = children_of_kind(node, cst::NodeKind::PATH);
                    if paths.len() > 0 {
                        match lower_path(ctx, paths.get(0)) {
                            Option::Some(member_path) => {
                                let segments = owner_path.segments;
                                for segment in member_path.segments {
                                    segments.push(segment)
                                };
                                let args = match first_child(owner_node, cst::NodeKind::TYPE_PARAM_LIST) {
                                    Option::Some(list) => lower_type_list(ctx, list),
                                    Option::None => Vec::new(),
                                };
                                Option::Some((Path { segments }, args))
                            },
                            Option::None => Option::None,
                        }
                    } else {
                        let args = match first_child(owner_node, cst::NodeKind::TYPE_PARAM_LIST) {
                            Option::Some(list) => lower_type_list(ctx, list),
                            Option::None => Vec::new(),
                        };
                        Option::Some((owner_path, args))
                    }
                },
                Option::None => Option::None,
            },
            Option::None => Option::None,
        },
        Option::None => match first_child(node, cst::NodeKind::PATH) {
            Option::Some(path_node) => match lower_path(ctx, path_node) {
                Option::Some(path) => Option::Some((path, Vec::new())),
                Option::None => Option::None,
            },
            Option::None => {
                push_error(ctx, node_span(node), "Missing identifier in expression");
                Option::None
            },
        },
    }
}

fn lower_closure_param(ctx: LowerCtx, node: LocatedNode) -> Option[ClosureParam] {
    let ident = match first_token(node, lexer::TokenKind::Ident) {
        Option::Some(value) => Option::Some(value),
        Option::None => first_token(node, lexer::TokenKind::WildcardKeyword),
    };
    match ident {
        Option::Some(name_token) => {
            let types = type_children(node);
            let ty = if types.len() > 0 {
                lower_ty(ctx, types.get(0))
            } else {
                Option::None
            };
            Option::Some(ClosureParam {
                name: name_token.token.text,
                ty,
                span: node_span(node),
            })
        },
        Option::None => {
            push_error(ctx, node_span(node), "Closure parameter missing name");
            Option::None
        },
    }
}

fn lower_closure(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to closure expression") {
        Option::None
    } else {
        let params: Vec[ClosureParam] = Vec::new();
        match first_child(node, cst::NodeKind::CLOSURE_PARAM_LIST) {
            Option::Some(list) => for param in children_of_kind(list, cst::NodeKind::CLOSURE_PARAM) {
                match lower_closure_param(ctx, param) {
                    Option::Some(value) => params.push(value),
                    Option::None => (),
                }
            },
            Option::None => push_error(ctx, node_span(node), "Closure missing parameter list"),
        };
        match first_child(node, cst::NodeKind::EXPR_CLOSURE_BODY) {
            Option::Some(body_node) => match first_child(body_node, cst::NodeKind::BLOCK) {
                Option::Some(block_node) => match lower_block(ctx, block_node) {
                    Option::Some(block) => Option::Some(Expr::Closure(
                        params,
                        Expr::Block(block, node_span(block_node)),
                        node_span(node),
                    )),
                    Option::None => Option::None,
                },
                Option::None => {
                    let values = expr_children(body_node);
                    if values.len() > 0 {
                        match lower_expr(ctx, values.get(0)) {
                            Option::Some(body) => Option::Some(Expr::Closure(params, body, node_span(node))),
                            Option::None => Option::None,
                        }
                    } else {
                        push_error(ctx, node_span(body_node), "Closure body missing expr");
                        Option::None
                    }
                },
            },
            Option::None => {
                push_error(ctx, node_span(node), "Closure missing body");
                Option::None
            },
        }
    }
}

fn lower_struct_literal(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to struct literal") {
        Option::None
    } else {
        match first_child(node, cst::NodeKind::PATH) {
            Option::Some(path_node) => match lower_path(ctx, path_node) {
                Option::Some(path) => {
                    let fields: Vec[(string, Expr)] = Vec::new();
                    match first_child(node, cst::NodeKind::STRUCT_LITERAL_FIELD_LIST) {
                        Option::Some(list) => for field in children_of_kind(list, cst::NodeKind::STRUCT_LITERAL_FIELD) {
                            match first_token(field, lexer::TokenKind::Ident) {
                                Option::Some(name_token) => {
                                    let values = expr_children(field);
                                    if values.len() > 0 {
                                        match lower_expr(ctx, values.get(0)) {
                                            Option::Some(value) => fields.push((name_token.token.text, value)),
                                            Option::None => (),
                                        }
                                    } else {
                                        fields.push((
                                            name_token.token.text,
                                            Expr::Path(
                                                path_from_single_ident(name_token.token.text),
                                                Vec::new(),
                                                node_span(field),
                                            ),
                                        ))
                                    }
                                },
                                Option::None => (),
                            }
                        },
                        Option::None => (),
                    };
                    Option::Some(Expr::StructLiteral(path, fields, node_span(node)))
                },
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }
}

fn lower_expr(ctx: LowerCtx, node: LocatedNode) -> Option[Expr] {
    lower_expr_with_args(ctx, node, Vec::new())
}

fn lower_expr_with_args(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if ctx.expr_depth.get() >= 256 {
        push_error(ctx, node_span(node), "expression is too deeply nested");
        Option::None
    } else {
        ctx.expr_depth.set(ctx.expr_depth.get() + 1);
        let value_span = node_span(node);
        let result = match node_kind(node) {
            cst::NodeKind::EXPR_UNIT => if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to unit expression") {
                Option::None
            } else {
                Option::Some(Expr::Unit(value_span))
            },
            cst::NodeKind::EXPR_BOOL => if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to bool literal") {
                Option::None
            } else if has_token(node, lexer::TokenKind::TrueKeyword) {
                Option::Some(Expr::Bool(true, value_span))
            } else if has_token(node, lexer::TokenKind::FalseKeyword) {
                Option::Some(Expr::Bool(false, value_span))
            } else {
                push_error(ctx, value_span, "BoolExpr has no value");
                Option::None
            },
            cst::NodeKind::EXPR_INT => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Int, "", 0),
            cst::NodeKind::EXPR_INT8 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Int8Lit, "i8", 1),
            cst::NodeKind::EXPR_INT16 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Int16Lit, "i16", 2),
            cst::NodeKind::EXPR_INT32 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Int32Lit, "i32", 3),
            cst::NodeKind::EXPR_INT64 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Int64Lit, "i64", 4),
            cst::NodeKind::EXPR_UINT8 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::UInt8Lit, "u8", 5),
            cst::NodeKind::EXPR_UINT16 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::UInt16Lit, "u16", 6),
            cst::NodeKind::EXPR_UINT32 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::UInt32Lit, "u32", 7),
            cst::NodeKind::EXPR_UINT64 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::UInt64Lit, "u64", 8),
            cst::NodeKind::EXPR_FLOAT => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Float, "", 9),
            cst::NodeKind::EXPR_FLOAT32 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Float32Lit, "f32", 10),
            cst::NodeKind::EXPR_FLOAT64 => lower_number_expr(ctx, node, trailing_args, lexer::TokenKind::Float64Lit, "f64", 11),
            cst::NodeKind::EXPR_CHAR => lower_char_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_STR => lower_string_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_MULTILINE_STR => if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to string literal") {
                Option::None
            } else {
                match lower_multiline_string(ctx, node) {
                    Option::Some(value) => Option::Some(Expr::String(value, value_span)),
                    Option::None => Option::None,
                }
            },
            cst::NodeKind::EXPR_IDENT => lower_ident_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_STRUCT_LITERAL => lower_struct_literal(ctx, node, trailing_args),
            cst::NodeKind::EXPR_ARRAY_LITERAL => lower_expr_sequence(ctx, node, trailing_args, false),
            cst::NodeKind::EXPR_TUPLE => lower_expr_sequence(ctx, node, trailing_args, true),
            cst::NodeKind::EXPR_PAREN => {
                let values = expr_children(node);
                if values.len() > 0 {
                    lower_expr_with_args(ctx, values.get(0), trailing_args)
                } else {
                    Option::None
                }
            },
            cst::NodeKind::EXPR_CALL => lower_call_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_BINARY => lower_binary_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_PREFIX => lower_prefix_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_CAST => lower_cast_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_INDEX => lower_index_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_TRY => lower_try_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_RANGE => lower_range_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_CLOSURE => lower_closure(ctx, node, trailing_args),
            cst::NodeKind::EXPR_MATCH => lower_match_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_IF => lower_if_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_WHILE => lower_while_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_FOR => lower_for_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_BREAK => if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to break expression") {
                Option::None
            } else {
                Option::Some(Expr::Break(value_span))
            },
            cst::NodeKind::EXPR_CONTINUE => if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to continue expression") {
                Option::None
            } else {
                Option::Some(Expr::Continue(value_span))
            },
            cst::NodeKind::EXPR_RETURN => lower_return_expr(ctx, node, trailing_args),
            cst::NodeKind::EXPR_GO => lower_go_expr(ctx, node, trailing_args),
            _ => Option::None,
        };
        ctx.expr_depth.set(ctx.expr_depth.get() - 1);
        result
    }
}

fn lower_number_expr(
    ctx: LowerCtx,
    node: LocatedNode,
    trailing_args: Vec[Expr],
    token_kind: lexer::TokenKind,
    suffix: string,
    variant: int32,
) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to numeric literal") {
        Option::None
    } else {
        match first_token(node, token_kind) {
            Option::Some(token) => {
                let value = strip_suffix(token.token.text, suffix);
                let value_span = node_span(node);
                match variant {
                    0 => Option::Some(Expr::Int(value, value_span)),
                    1 => Option::Some(Expr::Int8(value, value_span)),
                    2 => Option::Some(Expr::Int16(value, value_span)),
                    3 => Option::Some(Expr::Int32(value, value_span)),
                    4 => Option::Some(Expr::Int64(value, value_span)),
                    5 => Option::Some(Expr::UInt8(value, value_span)),
                    6 => Option::Some(Expr::UInt16(value, value_span)),
                    7 => Option::Some(Expr::UInt32(value, value_span)),
                    8 => Option::Some(Expr::UInt64(value, value_span)),
                    9 => {
                        let (_, parsed) = string_parse_float64(value);
                        Option::Some(Expr::Float(parsed, value_span))
                    },
                    10 => Option::Some(Expr::Float32(value, value_span)),
                    _ => Option::Some(Expr::Float64(value, value_span)),
                }
            },
            Option::None => Option::None,
        }
    }
}

fn lower_char_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to char literal") {
        Option::None
    } else {
        match first_token(node, lexer::TokenKind::CharLit) {
            Option::Some(token) => match strip_delimiters(token.token.text) {
                Option::Some(value) => Option::Some(Expr::Char(value, node_span(node))),
                Option::None => {
                    push_error(ctx, token_span(token), "CharExpr has no value");
                    Option::None
                },
            },
            Option::None => {
                push_error(ctx, node_span(node), "CharExpr has no value");
                Option::None
            },
        }
    }
}

fn lower_string_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    if reject_trailing(ctx, node, trailing_args, "Cannot apply arguments to string literal") {
        Option::None
    } else {
        match first_token(node, lexer::TokenKind::Str) {
            Option::Some(token) => match strip_delimiters(token.token.text) {
                Option::Some(value) => Option::Some(Expr::String(unescape_string(value), node_span(node))),
                Option::None => {
                    push_error(ctx, token_span(token), "StrExpr has no value");
                    Option::None
                },
            },
            Option::None => {
                push_error(ctx, node_span(node), "StrExpr has no value");
                Option::None
            },
        }
    }
}

fn lower_ident_expr(ctx: LowerCtx, node: LocatedNode, trailing_args: Vec[Expr]) -> Option[Expr] {
    match lower_ident_parts(ctx, node) {
        Option::Some((path, type_args)) => match path_last(path) {
            Option::Some(last) => {
                let base = if type_args.len() == 0 && ident_starts_upper(last) {
                    Expr::Constr(path, Vec::new(), node_span(node))
                } else {
                    Expr::Path(path, type_args, node_span(node))
                };
                apply_trailing_args(ctx, base, trailing_args, node_span(node))
            },
            Option::None => {
                push_error(ctx, node_span(node), "Path expression is missing a name");
                Option::None
            },
        },
        Option::None => Option::None,
    }
}

fn lower_expr_sequence(
    ctx: LowerCtx,
    node: LocatedNode,
    trailing_args: Vec[Expr],
    tuple: bool,
) -> Option[Expr] {
    if reject_trailing(
        ctx,
        node,
        trailing_args,
        if tuple { "Cannot apply arguments to tuple literal" } else { "Cannot apply arguments to array literal" },
    ) {
        Option::None
    } else {
        let items: Vec[Expr] = Vec::new();
        for child in expr_children(node) {
            match lower_expr(ctx, child) {
                Option::Some(value) => items.push(value),
                Option::None => (),
            }
        };
        if tuple {
            Option::Some(Expr::Tuple(items, node_span(node)))
        } else {
            Option::Some(Expr::Array(items, node_span(node)))
        }
    }
}
