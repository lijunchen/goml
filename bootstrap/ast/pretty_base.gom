package ast;

use std::text;

fn pretty_write_spaces(builder: text::StringBuilder, count: int32) -> unit {
    for _ in range(0, count) {
        builder.write_char(' ')
    }
}

fn pretty_newline(builder: text::StringBuilder, indent: int32) -> unit {
    builder.write_char('\n');
    pretty_write_spaces(builder, indent)
}

fn pretty_write_path(builder: text::StringBuilder, value: Path) -> unit {
    let index = Ref::new(0);
    for segment in value.segments {
        if index.get() > 0 {
            builder.write_string("::")
        } else {
            ()
        };
        builder.write_string(segment.ident);
        index.set(index.get() + 1)
    }
}

fn pretty_write_strings(
    builder: text::StringBuilder,
    values: Vec[string],
    separator: string,
) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        builder.write_string(value);
        index.set(index.get() + 1)
    }
}

fn pretty_write_types(
    builder: text::StringBuilder,
    values: Vec[TypeExpr],
    separator: string,
) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        pretty_write_type(builder, value);
        index.set(index.get() + 1)
    }
}

fn pretty_write_type(builder: text::StringBuilder, value: TypeExpr) -> unit {
    match value {
        TypeExpr::Unit => builder.write_string("unit"),
        TypeExpr::Bool => builder.write_string("bool"),
        TypeExpr::Int8 => builder.write_string("int8"),
        TypeExpr::Int16 => builder.write_string("int16"),
        TypeExpr::Int32 => builder.write_string("int32"),
        TypeExpr::Int64 => builder.write_string("int64"),
        TypeExpr::Uint8 => builder.write_string("uint8"),
        TypeExpr::Uint16 => builder.write_string("uint16"),
        TypeExpr::Uint32 => builder.write_string("uint32"),
        TypeExpr::Uint64 => builder.write_string("uint64"),
        TypeExpr::Float32 => builder.write_string("float32"),
        TypeExpr::Float64 => builder.write_string("float64"),
        TypeExpr::String => builder.write_string("string"),
        TypeExpr::Char => builder.write_string("char"),
        TypeExpr::Tuple(values) => {
            builder.write_char('(');
            pretty_write_types(builder, values, ", ");
            builder.write_char(')')
        },
        TypeExpr::Con(path) => pretty_write_path(builder, path),
        TypeExpr::Dyn(path) => {
            builder.write_string("dyn ");
            pretty_write_path(builder, path)
        },
        TypeExpr::App(base, args) => {
            pretty_write_type(builder, base);
            if args.len() > 0 {
                builder.write_char('[');
                pretty_write_types(builder, args, ", ");
                builder.write_char(']')
            } else {
                ()
            }
        },
        TypeExpr::Array(length, element) => {
            builder.write_char('[');
            pretty_write_type(builder, element);
            builder.write_string("; ");
            builder.write_string(length);
            builder.write_char(']')
        },
        TypeExpr::Func(params, ret_ty) => {
            builder.write_char('(');
            pretty_write_types(builder, params, ", ");
            builder.write_string(") -> ");
            pretty_write_type(builder, ret_ty)
        },
    }
}

fn pretty_write_trait_ref(builder: text::StringBuilder, value: TraitRef) -> unit {
    pretty_write_path(builder, value.path);
    if value.args.len() > 0 {
        builder.write_char('[');
        pretty_write_types(builder, value.args, ", ");
        builder.write_char(']')
    } else {
        ()
    }
}

fn pretty_write_trait_refs(
    builder: text::StringBuilder,
    values: Vec[TraitRef],
    separator: string,
) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_string(separator)
        } else {
            ()
        };
        pretty_write_trait_ref(builder, value);
        index.set(index.get() + 1)
    }
}

fn pretty_find_bounds(
    values: Vec[(string, Vec[TraitRef])],
    name: string,
) -> Option[Vec[TraitRef]] {
    let result = Ref::new(Option::None);
    for value in values {
        if value.0 == name {
            result.set(Option::Some(value.1))
        } else {
            ()
        }
    };
    result.get()
}

fn pretty_write_generics(builder: text::StringBuilder, values: Vec[string]) -> unit {
    if values.len() > 0 {
        builder.write_char('[');
        pretty_write_strings(builder, values, ", ");
        builder.write_char(']')
    } else {
        ()
    }
}

fn pretty_write_bounded_generics(
    builder: text::StringBuilder,
    generics: Vec[string],
    bounds: Vec[(string, Vec[TraitRef])],
) -> unit {
    if generics.len() > 0 {
        builder.write_char('[');
        let index = Ref::new(0);
        for generic in generics {
            if index.get() > 0 {
                builder.write_string(", ")
            } else {
                ()
            };
            builder.write_string(generic);
            match pretty_find_bounds(bounds, generic) {
                Option::Some(values) => if values.len() > 0 {
                    builder.write_string(": ");
                    pretty_write_trait_refs(builder, values, " + ")
                } else {
                    ()
                },
                Option::None => (),
            };
            index.set(index.get() + 1)
        };
        builder.write_char(']')
    } else {
        ()
    }
}

fn pretty_write_attributes(builder: text::StringBuilder, values: Vec[Attribute]) -> unit {
    let index = Ref::new(0);
    for value in values {
        if index.get() > 0 {
            builder.write_char('\n')
        } else {
            ()
        };
        builder.write_string(value.text);
        index.set(index.get() + 1)
    }
}

fn pretty_write_visibility(builder: text::StringBuilder, value: Visibility) -> unit {
    match value {
        Visibility::Private => (),
        Visibility::Public => builder.write_string("pub "),
    }
}

fn pretty_utf8_width(value: uint8) -> int32 {
    if value < 128u8 {
        1
    } else if value < 224u8 {
        2
    } else if value < 240u8 {
        3
    } else {
        4
    }
}

fn pretty_hex_digit(value: uint8) -> char {
    match value {
        0u8 => '0',
        1u8 => '1',
        2u8 => '2',
        3u8 => '3',
        4u8 => '4',
        5u8 => '5',
        6u8 => '6',
        7u8 => '7',
        8u8 => '8',
        9u8 => '9',
        10u8 => 'a',
        11u8 => 'b',
        12u8 => 'c',
        13u8 => 'd',
        14u8 => 'e',
        _ => 'f',
    }
}

fn pretty_write_control_escape(builder: text::StringBuilder, value: uint8) -> unit {
    builder.write_string("\\u{");
    if value >= 16u8 {
        builder.write_char(pretty_hex_digit(value / 16u8))
    } else {
        ()
    };
    builder.write_char(pretty_hex_digit(value % 16u8));
    builder.write_char('}')
}

fn pretty_write_quoted_string(builder: text::StringBuilder, value: string) -> unit {
    builder.write_char('"');
    let index = Ref::new(0);
    while index.get() < value.byte_len() {
        let byte = value.byte_get(index.get());
        if byte == 34u8 {
            builder.write_string("\\\"")
        } else if byte == 92u8 {
            builder.write_string("\\\\")
        } else if byte == 10u8 {
            builder.write_string("\\n")
        } else if byte == 13u8 {
            builder.write_string("\\r")
        } else if byte == 9u8 {
            builder.write_string("\\t")
        } else if byte == 0u8 {
            builder.write_string("\\0")
        } else if byte < 32u8 || byte == 127u8 {
            pretty_write_control_escape(builder, byte)
        } else {
            let width = pretty_utf8_width(byte);
            builder.write_string(value.byte_slice(index.get(), index.get() + width))
        };
        index.set(index.get() + pretty_utf8_width(byte))
    };
    builder.write_char('"')
}

fn pretty_unary_symbol(value: UnaryOp) -> string {
    match value {
        UnaryOp::Neg => "-",
        UnaryOp::Not => "!",
        UnaryOp::BitNot => "~",
    }
}

fn pretty_binary_symbol(value: BinaryOp) -> string {
    match value {
        BinaryOp::Add => "+",
        BinaryOp::Sub => "-",
        BinaryOp::Mul => "*",
        BinaryOp::Div => "/",
        BinaryOp::Rem => "%",
        BinaryOp::BitAnd => "&",
        BinaryOp::BitOr => "|",
        BinaryOp::BitXor => "^",
        BinaryOp::Shl => "<<",
        BinaryOp::Shr => ">>",
        BinaryOp::And => "&&",
        BinaryOp::Or => "||",
        BinaryOp::Less => "<",
        BinaryOp::Greater => ">",
        BinaryOp::LessEq => "<=",
        BinaryOp::GreaterEq => ">=",
        BinaryOp::Eq => "==",
        BinaryOp::NotEq => "!=",
    }
}

fn pretty_write_enum(builder: text::StringBuilder, value: EnumDef, indent: int32) -> unit {
    pretty_write_attributes(builder, value.attrs);
    pretty_write_visibility(builder, value.visibility);
    builder.write_string("enum ");
    builder.write_string(value.name);
    pretty_write_generics(builder, value.generics);
    builder.write_string(" {");
    let index = Ref::new(0);
    for variant in value.variants {
        if index.get() > 0 {
            builder.write_char(',')
        } else {
            ()
        };
        pretty_newline(builder, indent + 4);
        builder.write_string(variant.name);
        match variant.fields {
            EnumVariantFields::Unit => (),
            EnumVariantFields::Tuple(types) => {
                builder.write_char('(');
                pretty_write_types(builder, types, ", ");
                builder.write_char(')')
            },
            EnumVariantFields::Struct(fields) => {
                builder.write_string(" { ");
                let field_index = Ref::new(0);
                for field in fields {
                    if field_index.get() > 0 {
                        builder.write_string(", ")
                    } else {
                        ()
                    };
                    builder.write_string(field.0);
                    builder.write_string(": ");
                    pretty_write_type(builder, field.1);
                    field_index.set(field_index.get() + 1)
                };
                builder.write_string(" }")
            },
        };
        index.set(index.get() + 1)
    };
    pretty_newline(builder, indent);
    builder.write_char('}')
}

fn pretty_write_struct(builder: text::StringBuilder, value: StructDef, indent: int32) -> unit {
    pretty_write_attributes(builder, value.attrs);
    pretty_write_visibility(builder, value.visibility);
    builder.write_string("struct ");
    builder.write_string(value.name);
    pretty_write_generics(builder, value.generics);
    builder.write_string(" {");
    for field in value.fields {
        pretty_newline(builder, indent + 4);
        builder.write_string(field.0);
        builder.write_string(": ");
        pretty_write_type(builder, field.1);
        builder.write_char(',')
    };
    pretty_newline(builder, indent);
    builder.write_char('}')
}

fn pretty_write_trait_method(
    builder: text::StringBuilder,
    value: TraitMethodSignature,
) -> unit {
    builder.write_string("fn ");
    builder.write_string(value.name);
    builder.write_char('(');
    for index in range(0, value.params.len()) {
        if index > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        let param = value.params.get(index);
        builder.write_string(param.0);
        builder.write_string(": ");
        pretty_write_type(builder, param.1)
    };
    builder.write_string(") -> ");
    pretty_write_type(builder, value.ret_ty);
    builder.write_char(';')
}

fn pretty_write_trait(builder: text::StringBuilder, value: TraitDef, indent: int32) -> unit {
    pretty_write_attributes(builder, value.attrs);
    pretty_write_visibility(builder, value.visibility);
    builder.write_string("trait ");
    builder.write_string(value.name);
    pretty_write_bounded_generics(builder, value.generics, value.generic_bounds);
    if value.supertraits.len() > 0 {
        builder.write_string(": ");
        pretty_write_trait_refs(builder, value.supertraits, " + ")
    } else {
        ()
    };
    builder.write_string(" {");
    if value.associated_types.len() == 0 && value.method_sigs.len() == 0 {
        builder.write_string("\n\n");
        pretty_write_spaces(builder, indent)
    } else {
        for associated in value.associated_types {
            pretty_newline(builder, indent + 2);
            builder.write_string("type ");
            builder.write_string(associated.name);
            if associated.bounds.len() > 0 {
                builder.write_string(": ");
                pretty_write_trait_refs(builder, associated.bounds, " + ")
            } else {
                ()
            };
            builder.write_char(';')
        };
        for method in value.method_sigs {
            pretty_newline(builder, indent + 2);
            pretty_write_trait_method(builder, method)
        };
        pretty_newline(builder, indent)
    };
    builder.write_char('}')
}

fn pretty_write_function(builder: text::StringBuilder, value: Function, indent: int32) -> unit {
    pretty_write_attributes(builder, value.attrs);
    pretty_write_visibility(builder, value.visibility);
    builder.write_string("fn ");
    builder.write_string(value.name);
    builder.write_char('(');
    let index = Ref::new(0);
    for param in value.params {
        if index.get() > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        builder.write_string(param.0);
        builder.write_string(": ");
        pretty_write_type(builder, param.1);
        index.set(index.get() + 1)
    };
    builder.write_char(')');
    match value.ret_ty {
        Option::Some(ty) => {
            builder.write_string(" -> ");
            pretty_write_type(builder, ty)
        },
        Option::None => (),
    };
    builder.write_char(' ');
    pretty_write_block(builder, value.body, indent)
}

fn pretty_write_extern(builder: text::StringBuilder, value: ExternFunction) -> unit {
    pretty_write_attributes(builder, value.attrs);
    pretty_write_visibility(builder, value.visibility);
    builder.write_string("extern fn ");
    builder.write_string(value.name);
    builder.write_char('(');
    let index = Ref::new(0);
    for param in value.params {
        if index.get() > 0 {
            builder.write_string(", ")
        } else {
            ()
        };
        builder.write_string(param.0);
        builder.write_string(": ");
        pretty_write_type(builder, param.1);
        index.set(index.get() + 1)
    };
    builder.write_char(')');
    match value.ret_ty {
        Option::Some(ty) => {
            builder.write_string(" -> ");
            pretty_write_type(builder, ty)
        },
        Option::None => (),
    }
}

fn pretty_write_impl(builder: text::StringBuilder, value: ImplBlock, indent: int32) -> unit {
    pretty_write_attributes(builder, value.attrs);
    builder.write_string("impl");
    pretty_write_bounded_generics(builder, value.generics, value.generic_bounds);
    builder.write_char(' ');
    match value.trait_ref {
        Option::Some(trait_ref) => {
            pretty_write_trait_ref(builder, trait_ref);
            builder.write_string(" for ")
        },
        Option::None => (),
    };
    pretty_write_type(builder, value.for_type);
    builder.write_string(" {");
    if value.associated_types.len() == 0 && value.methods.len() == 0 {
        builder.write_string("\n\n");
        pretty_write_spaces(builder, indent)
    } else {
        for associated in value.associated_types {
            pretty_newline(builder, indent + 2);
            builder.write_string("type ");
            builder.write_string(associated.0);
            builder.write_string(" = ");
            pretty_write_type(builder, associated.1);
            builder.write_char(';')
        };
        for method in value.methods {
            pretty_newline(builder, indent + 2);
            pretty_write_function(builder, method, indent + 2)
        };
        pretty_newline(builder, indent)
    };
    builder.write_char('}')
}

fn pretty_write_item(builder: text::StringBuilder, value: Item, indent: int32) -> unit {
    match value {
        Item::EnumDef(value) => pretty_write_enum(builder, value, indent),
        Item::StructDef(value) => pretty_write_struct(builder, value, indent),
        Item::TraitDef(value) => pretty_write_trait(builder, value, indent),
        Item::ImplBlock(value) => pretty_write_impl(builder, value, indent),
        Item::Function(value) => pretty_write_function(builder, value, indent),
        Item::ExternFunction(value) => pretty_write_extern(builder, value),
    }
}

fn pretty_file(value: File) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string("package ");
    builder.write_string(value.package_name);
    builder.write_char(';');
    pretty_newline(builder, 0);
    if value.uses.len() > 0 {
        for use_decl in value.uses {
            builder.write_string("use ");
            pretty_write_path(builder, use_decl.path);
            match use_decl.alias {
                Option::Some(alias) => {
                    builder.write_string(" as ");
                    builder.write_string(alias)
                },
                Option::None => (),
            };
            builder.write_char(';');
            pretty_newline(builder, 0)
        };
        pretty_newline(builder, 0)
    } else {
        ()
    };
    for item in value.items {
        pretty_write_item(builder, item, 0);
        pretty_newline(builder, 0);
        pretty_newline(builder, 0)
    };
    builder.finish()
}

pub fn pretty(value: LowerResult) -> string {
    match value.ast {
        Option::Some(file) => pretty_file(file),
        Option::None => {
            let builder = text::StringBuilder::new();
            for diagnostic in value.diagnostics {
                builder.write_string(diagnostic.message);
                builder.write_char('\n')
            };
            builder.finish()
        },
    }
}
