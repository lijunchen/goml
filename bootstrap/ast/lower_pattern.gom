package ast;

use gomlc::cst;
use gomlc::lexer;
use std::text;

fn literal_value(node: LocatedNode, kind: lexer::TokenKind) -> Option[string] {
    match first_token(node, kind) {
        Option::Some(token) => Option::Some(token.token.text),
        Option::None => Option::None,
    }
}

fn strip_suffix(value: string, suffix: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for index in range(0, value.byte_len()) {
        if value.byte_get(index) != 95 {
            builder.write_string(value.byte_slice(index, index + 1))
        } else {
            ()
        }
    };
    let normalized = builder.finish();
    if normalized.byte_len() >= suffix.byte_len()
        && normalized.byte_slice(
            normalized.byte_len() - suffix.byte_len(),
            normalized.byte_len(),
        ) == suffix
    {
        normalized.byte_slice(0, normalized.byte_len() - suffix.byte_len())
    } else {
        normalized
    }
}

fn strip_delimiters(value: string) -> Option[string] {
    if value.byte_len() >= 2 {
        Option::Some(value.byte_slice(1, value.byte_len() - 1))
    } else {
        Option::None
    }
}

fn path_from_single_ident(value: string) -> Path {
    let segments: Vec[PathSegment] = Vec::new();
    segments.push(PathSegment {
        ident: value,
        span: span(0, 0),
    });
    Path { segments }
}

fn signed_pattern_value(node: LocatedNode, kind: lexer::TokenKind, suffix: string) -> Option[string] {
    match literal_value(node, kind) {
        Option::Some(value) => {
            let base = strip_suffix(value, suffix);
            if has_token(node, lexer::TokenKind::Minus) {
                Option::Some("-" + base)
            } else {
                Option::Some(base)
            }
        },
        Option::None => Option::None,
    }
}

fn lower_pat_inner(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    if ctx.pattern_depth.get() >= 128 {
        push_error(ctx, node_span(node), "pattern is too deeply nested");
        Option::None
    } else {
        ctx.pattern_depth.set(ctx.pattern_depth.get() + 1);
        let value_span = node_span(node);
        let result = match node_kind(node) {
            cst::NodeKind::PATTERN_VARIABLE => match first_token(node, lexer::TokenKind::Ident) {
                Option::Some(token) => Option::Some(Pat::Var(token.token.text, value_span)),
                Option::None => {
                    push_error(ctx, value_span, "Variable pattern is missing a name");
                    Option::None
                },
            },
            cst::NodeKind::PATTERN_UNIT => Option::Some(Pat::Unit(value_span)),
            cst::NodeKind::PATTERN_BOOL => match first_token(node, lexer::TokenKind::TrueKeyword) {
                Option::Some(_) => Option::Some(Pat::Bool(true, value_span)),
                Option::None => match first_token(node, lexer::TokenKind::FalseKeyword) {
                    Option::Some(_) => Option::Some(Pat::Bool(false, value_span)),
                    Option::None => {
                        push_error(ctx, value_span, "Invalid boolean pattern");
                        Option::None
                    },
                },
            },
            cst::NodeKind::PATTERN_INT => match signed_pattern_value(node, lexer::TokenKind::IntLit, "") {
                Option::Some(value) => Option::Some(Pat::Int(value, value_span)),
                Option::None => Option::None,
            },
            cst::NodeKind::PATTERN_FLOAT => match signed_pattern_value(node, lexer::TokenKind::Float, "") {
                Option::Some(value) => Option::Some(Pat::Float(value, value_span)),
                Option::None => Option::None,
            },
            cst::NodeKind::PATTERN_STRING => match literal_value(node, lexer::TokenKind::Str) {
                Option::Some(raw) => match strip_delimiters(raw) {
                    Option::Some(value) => Option::Some(Pat::String(value, value_span)),
                    Option::None => Option::None,
                },
                Option::None => {
                    push_error(ctx, value_span, "StringPat has no value");
                    Option::None
                },
            },
            cst::NodeKind::PATTERN_CHAR => match literal_value(node, lexer::TokenKind::CharLit) {
                Option::Some(raw) => match strip_delimiters(raw) {
                    Option::Some(value) => Option::Some(Pat::Char(value, value_span)),
                    Option::None => Option::None,
                },
                Option::None => {
                    push_error(ctx, value_span, "CharPat has no value");
                    Option::None
                },
            },
            cst::NodeKind::PATTERN_CONSTR => lower_constr_pat(ctx, node),
            cst::NodeKind::PATTERN_TUPLE => {
                let pats: Vec[Pat] = Vec::new();
                for child in pattern_children(node) {
                    match lower_pat_inner(ctx, child) {
                        Option::Some(value) => pats.push(value),
                        Option::None => (),
                    }
                };
                if has_token(node, lexer::TokenKind::Comma) == false && pats.len() == 1 {
                    Option::Some(pats.get(0))
                } else {
                    Option::Some(Pat::Tuple(pats, value_span))
                }
            },
            cst::NodeKind::PATTERN_ARRAY => lower_array_pat(ctx, node),
            cst::NodeKind::PATTERN_ALIAS => {
                let names = tokens_of_kind(node, lexer::TokenKind::Ident);
                let pats = pattern_children(node);
                if names.len() > 0 && pats.len() > 0 {
                    match lower_pat_inner(ctx, pats.get(0)) {
                        Option::Some(pat) => Option::Some(Pat::Alias(names.get(0).token.text, pat, value_span)),
                        Option::None => Option::None,
                    }
                } else {
                    Option::None
                }
            },
            cst::NodeKind::PATTERN_OR => {
                let pats: Vec[Pat] = Vec::new();
                let valid = Ref::new(true);
                for child in pattern_children(node) {
                    match lower_pat_inner(ctx, child) {
                        Option::Some(value) => pats.push(value),
                        Option::None => valid.set(false),
                    }
                };
                if valid.get() {
                    Option::Some(Pat::Or(pats, value_span))
                } else {
                    Option::None
                }
            },
            cst::NodeKind::PATTERN_RANGE => {
                let children = pattern_children(node);
                if children.len() >= 2 {
                    match lower_pat_inner(ctx, children.get(0)) {
                        Option::Some(start) => match lower_pat_inner(ctx, children.get(1)) {
                            Option::Some(end) => Option::Some(Pat::Range(
                                start,
                                end,
                                has_token(node, lexer::TokenKind::DotDotEq),
                                value_span,
                            )),
                            Option::None => Option::None,
                        },
                        Option::None => Option::None,
                    }
                } else {
                    Option::None
                }
            },
            cst::NodeKind::PATTERN_REST => {
                push_error(ctx, value_span, "`..` is only allowed inside an array pattern");
                Option::None
            },
            cst::NodeKind::PATTERN_WILDCARD => Option::Some(Pat::Wild(value_span)),
            _ => Option::None,
        };
        ctx.pattern_depth.set(ctx.pattern_depth.get() - 1);
        result
    }
}

fn lower_constr_pat(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    match first_child(node, cst::NodeKind::PATH) {
        Option::Some(path_node) => match lower_path(ctx, path_node) {
            Option::Some(path) => match first_child(node, cst::NodeKind::STRUCT_PATTERN_FIELD_LIST) {
                Option::Some(list) => {
                    let fields: Vec[(string, Pat)] = Vec::new();
                    let valid = Ref::new(true);
                    for field in children_of_kind(list, cst::NodeKind::STRUCT_PATTERN_FIELD) {
                        match first_token(field, lexer::TokenKind::Ident) {
                            Option::Some(name_token) => {
                                let patterns = pattern_children(field);
                                if patterns.len() > 0 {
                                    match lower_pat_inner(ctx, patterns.get(0)) {
                                        Option::Some(pat) => fields.push((name_token.token.text, pat)),
                                        Option::None => valid.set(false),
                                    }
                                } else if has_token(field, lexer::TokenKind::Colon) {
                                    push_error(ctx, node_span(field), "Struct pattern field missing pattern");
                                    valid.set(false)
                                } else {
                                    fields.push((
                                        name_token.token.text,
                                        Pat::Var(name_token.token.text, node_span(field)),
                                    ))
                                }
                            },
                            Option::None => {
                                push_error(ctx, node_span(field), "Struct pattern field missing name");
                                valid.set(false)
                            },
                        }
                    };
                    if valid.get() {
                        Option::Some(Pat::Struct(
                            path,
                            fields,
                            match first_child(list, cst::NodeKind::PATTERN_REST) {
                                Option::Some(_) => true,
                                Option::None => false,
                            },
                            node_span(node),
                        ))
                    } else {
                        Option::None
                    }
                },
                Option::None => {
                    let pats: Vec[Pat] = Vec::new();
                    for child in pattern_children(node) {
                        match lower_pat_inner(ctx, child) {
                            Option::Some(value) => pats.push(value),
                            Option::None => (),
                        }
                    };
                    Option::Some(Pat::Constr(path, pats, node_span(node)))
                },
            },
            Option::None => Option::None,
        },
        Option::None => {
            push_error(ctx, node_span(node), "Missing constructor name in pattern");
            Option::None
        },
    }
}

fn lower_array_pat(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    let prefix: Vec[Pat] = Vec::new();
    let suffix: Vec[Pat] = Vec::new();
    let rest = Ref::new(Option::None);
    let valid = Ref::new(true);
    for child in pattern_children(node) {
        if cst::node_kind_equal(node_kind(child), cst::NodeKind::PATTERN_REST) {
            let binding = match first_token(child, lexer::TokenKind::Ident) {
                Option::Some(token) => Option::Some(token.token.text),
                Option::None => Option::None,
            };
            rest.set(Option::Some(ArrayPatRest {
                binding,
                span: node_span(child),
            }))
        } else {
            match lower_pat_inner(ctx, child) {
                Option::Some(value) => match rest.get() {
                    Option::Some(_) => suffix.push(value),
                    Option::None => prefix.push(value),
                },
                Option::None => valid.set(false),
            }
        }
    };
    if valid.get() {
        Option::Some(Pat::Array(prefix, rest.get(), suffix, node_span(node)))
    } else {
        Option::None
    }
}

fn lower_pat(ctx: LowerCtx, node: LocatedNode) -> Option[Pat] {
    lower_pat_inner(ctx, node)
}
