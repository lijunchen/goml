    PATTERN_BOOL,
    PATTERN_STRING,
    PATTERN_INT,
    PATTERN_INT8,
    PATTERN_INT16,
    PATTERN_INT32,
    PATTERN_INT64,
    PATTERN_UINT8,
    PATTERN_UINT16,
    PATTERN_UINT32,
    PATTERN_UINT64,
    PATTERN_FLOAT,
    PATTERN_FLOAT32,
    PATTERN_FLOAT64,
    PATTERN_CHAR,
    PATTERN_TUPLE,
    PATTERN_ARRAY,
    PATTERN_CONSTR,
    PATTERN_VARIABLE,
    PATTERN_WILDCARD,
    PATTERN_ALIAS,
    PATTERN_OR,
    PATTERN_RANGE,
    PATTERN_REST,
    MATCH_ARM_LIST,
    MATCH_ARM,
    MATCH_ARM_GUARD,
    PARAM,
