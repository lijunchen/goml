    WHERE_CLAUSE,
    WHERE_PREDICATE,
    TYPE_PARAM_LIST,
    BLOCK,
    FILE,
    ATTRIBUTE_LIST,
    ATTRIBUTE,
}

pub struct CstNode {
    kind: NodeKind,
    children: Vec[CstElement],
    byte_len: int32,
}

pub enum CstElement {
    Node(CstNode),
    Token(lexer::Token),
}

pub struct Diagnostic {
    message: string,
    start: int32,
    end: int32,
}

pub struct ParseResult {
    root: CstNode,
    diagnostics: Vec[Diagnostic],
}

pub fn node(kind: NodeKind, children: Vec[CstElement], byte_len: int32) -> CstNode {
    CstNode { kind, children, byte_len }
}

pub fn diagnostic(message: string, start: int32, end: int32) -> Diagnostic {
    Diagnostic { message, start, end }
}

pub fn parse_result(root: CstNode, diagnostics: Vec[Diagnostic]) -> ParseResult {
    ParseResult { root, diagnostics }
}

pub fn node_kind(value: CstNode) -> NodeKind {
    value.kind
}

pub fn node_children(value: CstNode) -> Vec[CstElement] {
    value.children
}

pub fn node_byte_len(value: CstNode) -> int32 {
    value.byte_len
}

pub fn element_byte_len(value: CstElement) -> int32 {
    match value {
        CstElement::Node(node_value) => node_value.byte_len,
        CstElement::Token(token) => token.text.byte_len(),
    }
}

pub fn node_kind_name(kind: NodeKind) -> string {
    let rendered = kind.to_string();
    rendered.byte_slice(10, rendered.byte_len())
}

pub fn node_kind_equal(left: NodeKind, right: NodeKind) -> bool {
    Eq::eq(left, right)
}

fn encode_node(value: CstNode, start: int32, builder: text::StringBuilder) -> int32 {
    let end = start + value.byte_len;
    builder.write_string("N\t");
    builder.write_string(node_kind_name(value.kind));
    builder.write_string("\t");
    builder.write_string(start.to_string());
    builder.write_string("\t");
    builder.write_string(end.to_string());
    builder.write_string("\n");
    let cursor = Ref::new(start);
    for child in value.children {
        match child {
            CstElement::Node(child_node) => cursor.set(encode_node(child_node, cursor.get(), builder)),
            CstElement::Token(token) => {
                builder.write_string("T\t");
                builder.write_string(lexer::token_kind_name(token.kind));
                builder.write_string("\t");
                builder.write_string(cursor.get().to_string());
                builder.write_string("\t");
                builder.write_string((cursor.get() + token.text.byte_len()).to_string());
                builder.write_string("\t");
                builder.write_string(lexer::encode_text_hex(token.text));
                builder.write_string("\n");
                cursor.set(cursor.get() + token.text.byte_len())
            },
        }
    };
    builder.write_string("E\n");
    end
}

pub fn encode(result: ParseResult) -> string {
    let builder = text::StringBuilder::new();
    let _ = encode_node(result.root, 0, builder);
    for item in result.diagnostics {
        builder.write_string("D\t");
        builder.write_string(item.start.to_string());
        builder.write_string("\t");
        builder.write_string(item.end.to_string());
        builder.write_string("\t");
        builder.write_string(lexer::encode_text_hex(item.message));
        builder.write_string("\n")
    };
    builder.finish()
}
