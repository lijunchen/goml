fn apply_twice(f: (int32) -> int32, x: int32) -> int32 {
    f(f(x))
}

fn main() {
    let f = |n: int32| {
        if n > 3 {
            return n
        } else {
            ()
        };
        n + 10
    };

    println(f(2).to_string());
    println(f(5).to_string());
    println(apply_twice(f, 2).to_string());
}
