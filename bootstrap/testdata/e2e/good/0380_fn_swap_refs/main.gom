fn swap_refs(a: Ref[int32], b: Ref[int32]) {
    let tmp = a.get();
    a.set(b.get());
    b.set(tmp);
}

fn main() {
    let x: Ref[int32] = Ref::new(10);
    let y: Ref[int32] = Ref::new(20);
    println(x.get().to_string() + " " + y.get().to_string());
    swap_refs(x, y);
    println(x.get().to_string() + " " + y.get().to_string());
}
