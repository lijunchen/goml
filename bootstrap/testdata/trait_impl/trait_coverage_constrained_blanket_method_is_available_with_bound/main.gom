trait Mark {
    fn mark(self: Self) -> unit;
}

trait Extra {
    fn extra(self: Self) -> int32;
}

impl Mark for int32 {
    fn mark(self: int32) -> unit { () }
}

impl[T: Mark] Extra for T {
    fn extra(self: T) -> int32 { 1 }
}

fn main() -> unit {
    let source: int32 = 1;
    let value: int32 = source.extra();
    let _ = value;
}
