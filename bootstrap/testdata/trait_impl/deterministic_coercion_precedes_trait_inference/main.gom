trait Mark {
    fn mark(self: Self) -> unit;
}

impl Mark for int32 {
    fn mark(self: int32) -> unit { () }
}

fn identity[T](value: T) -> T {
    value
}

fn require_mark[T: Mark](value: T) -> unit {
    ()
}

fn preserve[T: Mark](value: T) -> unit {
    let copied = identity(value);
    require_mark(copied)
}

fn main() -> unit { () }
