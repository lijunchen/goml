enum Event {
    Move {
        x: int32,
        y: int32,
    },
    Tuple(int32),
    Unit,
}

fn inspect(value: Event) -> int32 {
    let _ = Event::Move {
        x: 1,
        x: 2,
        extra: 3,
    };
    let _ = Event::Tuple { value: 1 };
    let _ = Event::Move(1, 2);
    match value {
        Event::Move { x } => x,
        Event::Tuple(value) => value,
        Event::Unit => 0,
    }
}
