fn main() -> unit {
    let t/0: T = T::B(true, ());
    match (t/0 : T) {
        T::A => (println : (string) -> unit)((int::to_string : (int) -> string)(1)),
        T::B(true, ()) => (println : (string) -> unit)((int::to_string : (int) -> string)(2)),
        T::B(false, ()) => (println : (string) -> unit)((int::to_string : (int) -> string)(3)),
    }
}