fn main() -> unit {
    let p/0: Pair[uint8, float32] = Pair { first: 10, second: 3.14 };
    (println : (string) -> unit)((ToString::to_string : (uint8) -> string)((p/0 : Pair[uint8, float32]).first));
    (println : (string) -> unit)((ToString::to_string : (float32) -> string)((p/0 : Pair[uint8, float32]).second));
}