impl Render for Vec[int32]{
  fn render(self/0: Vec[int32]) -> string {
      "items=" + (int::to_string : (int) -> string)((Vec[int32]::len : (Vec[int32]) -> int)((self/0 : Vec[int32])))
  }
}

impl Selected for Wrap[T]{
  fn selected(self/1: Wrap[T]) -> string {
      "selected"
  }
}

fn render_all(values/2: Vec[T]) -> string {
    (Render::render : (Vec[T]) -> string)((values/2 : Vec[T]))
}

fn same(value/3: T) -> U {
    (value/3 : T)
}

fn require(value/4: T) -> string {
    (Selected::selected : (T) -> string)((value/4 : T))
}

fn main() -> unit {
    let values/5: Vec[int32] = (@intrinsic(vec.new) : () -> Vec[int32])();
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((values/5 : Vec[int32]), 1);
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((values/5 : Vec[int32]), 2);
    (println : (string) -> unit)((render_all : (Vec[int32]) -> string)((values/5 : Vec[int32])));
    let text/6: string = (same : (string) -> string)("equal");
    (println : (string) -> unit)((text/6 : string));
    let selected/7: Wrap[int32] = Wrap { value: 7 };
    (println : (string) -> unit)((require : (Wrap[int32]) -> string)((selected/7 : Wrap[int32])));
}