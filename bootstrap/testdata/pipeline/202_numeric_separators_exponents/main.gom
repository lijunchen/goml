fn accepts_array_length(value: [int32; 1_0]) -> unit {
    let _ = value;
}

fn main() -> unit {
    let integer: int32 = 1_000;
    let unsigned: uint64 = 4_294_967_296;
    let float: float64 = 1.25e2;
    let small: float32 = 2_5.0_0e-1;
    println(integer);
    println(unsigned);
    println(float);
    println(small);
    match integer {
        1_000 => println("matched"),
        _ => println("missed"),
    }
}
