impl Mark for int32{
  fn marked(self/0: int32) -> string {
      "m" + (int32::to_string : (int32) -> string)((self/0 : int32))
  }
}

impl Source for LeftSource{
  fn get(self/1: LeftSource) -> int32 {
      (self/1 : LeftSource).value
  }
}

impl Source for RightSource{
  fn get(self/2: RightSource) -> int32 {
      (self/2 : RightSource).value
  }
}

fn combine(left/3: A, right/4: B) -> string {
    (Mark::marked : (B::Item) -> string)((Source::get : (A) -> B::Item)((left/3 : A))) + ":" + (Mark::marked : (B::Item) -> string)((Source::get : (B) -> B::Item)((right/4 : B)))
}

fn main() -> unit {
    (println : (string) -> unit)((combine : (LeftSource, RightSource) -> string)(LeftSource { value: 3 }, RightSource { value: 4 }));
}