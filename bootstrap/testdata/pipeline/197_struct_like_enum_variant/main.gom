enum Message[T] {
    Quit,
    Write(T),
    Move {
        x: int32,
        y: int32,
        label: T,
    },
}

#[derive(ToString, Hash, Eq)]
enum Key {
    Empty,
    Point {
        x: int32,
        y: int32,
    },
}

fn score(value: Message[string]) -> int32 {
    match value {
        Message::Quit => 0,
        Message::Write(_) => 1,
        Message::Move { x, y: vertical, .. } => x + vertical,
    }
}

fn label(value: Message[string]) -> string {
    match value {
        Message::Move {
            label,
            x: _,
            y: _,
        } => label,
        Message::Write(text) => text,
        Message::Quit => "quit",
    }
}

fn main() -> unit {
    let x = 3;
    let direction = "north";
    let first = Message::Move {
        label: direction,
        y: 4,
        x,
    };
    let second = Message::Move {
        x: 3,
        y: 4,
        label: "north",
    };
    println(score(first));
    println(label(second));
    println(Key::Point {
        x: 1,
        y: 2,
    }.to_string());
    println(Eq::eq(
        Key::Point {
            x: 1,
            y: 2,
        },
        Key::Point {
            y: 2,
            x: 1,
        },
    ));
}
