package main;
trait Named {
  fn name(self: Self) -> string;
}

trait Display: Named {
  fn show(self: Self, prefix: string) -> string;
}

struct Point {
    value: int32,
}

impl Named for Point {
  fn name(self: Point) -> string {
      "point"
  }
}

impl Display for Point {
  fn show(self: Point, prefix: string) -> string {
      prefix + self.value.to_string()
  }
}

fn render(value: dyn Display) -> unit {
    println(value.show("value="));
    println(value.name());
    println(Display::show(value, "again="));
}

fn main() -> unit {
    let value: dyn Display = Point {
        value: 7
    };
    render(value);
}

