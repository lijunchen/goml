package main;
fn loop_return_unit(flag: bool) -> unit {
    while if flag {
        {
            return
        }
    } else {
        {
            return
        }
    } {
        {
            println("unreachable");
        }
    };
}

fn loop_return() -> int32 {
    while match 0 {
        _ => return 5,
    } {
        {
            println("unreachable");
        }
    };
    0
}

fn main() -> unit {
    loop_return_unit(true);
    println(loop_return());
}

