fn show_unit(result/0: Result[unit, string]) -> string {
    match (result/0 : Result[unit, string]) {
        Result::Ok(_ : unit) => "ok",
        Result::Err(err/1: string) => "err " + (err/1 : string),
    }
}

fn show_string(result/2: Result[string, string]) -> string {
    match (result/2 : Result[string, string]) {
        Result::Ok(value/3: string) => (value/3 : string),
        Result::Err(err/4: string) => "err " + (err/4 : string),
    }
}

fn main() -> unit {
    (std::io::println : (string) -> unit)((@runtime(core.string_byte_slice) : (string, int, int) -> string)("a你好z", 1, 7));
    (std::io::eprint : (string) -> unit)("");
    (std::io::eprintln : (string) -> unit)("");
    (std::io::println : (string) -> unit)((show_unit : (Result[unit, string]) -> string)((std::fs::create_dir_all : (string) -> Result[unit, string])("goml-self-host/nested")));
    (std::io::println : (string) -> unit)((show_unit : (Result[unit, string]) -> string)((std::fs::write_file : (string, string) -> Result[unit, string])("goml-self-host/nested/output.txt", "boot")));
    (std::io::println : (string) -> unit)((show_string : (Result[string, string]) -> string)((std::fs::read_file : (string) -> Result[string, string])("goml-self-host/nested/output.txt")))
}