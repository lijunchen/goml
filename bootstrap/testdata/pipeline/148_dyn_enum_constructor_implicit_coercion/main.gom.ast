package main;
trait Display {
  fn show(self: Self) -> string;
}

impl Display for int32 {
  fn show(self: int32) -> string {
      self.to_string()
  }
}

enum Boxed {
    One(dyn Display),
    Pair(dyn Display, dyn Display)
}

fn render(value: Boxed) -> string {
    match value {
        Boxed::One(inner) => Display::show(inner),
        Boxed::Pair(left, right) => Display::show(left) + "-" + Display::show(right),
    }
}

fn main() -> unit {
    let one: int32 = 42;
    let left: int32 = 7;
    let right: int32 = 9;
    println(render(Boxed::One(one)));
    println(render(Boxed::Pair(left, right)));
}

