  let t124 = ("3.14 >= 3.14: " + t123) in
  let mtmp79 = println__T_string(t124) in
  let eq1/22 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let t125 = trait_impl#ToString#bool#to_string(eq1/22) in
  let t126 = ("3.14 == 3.14: " + t125) in
  let mtmp80 = println__T_string(t126) in
  let eq2/23 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let t127 = trait_impl#ToString#bool#to_string(eq2/23) in
  let t128 = ("3.14 == 2.71: " + t127) in
  let mtmp81 = println__T_string(t128) in
  let t129 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let neq1/24 = (!t129) in
