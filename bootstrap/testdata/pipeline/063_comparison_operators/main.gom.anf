  let t120 = ("3.14 <= 3.14: " + t119) in
  let mtmp77 = println__T_string(t120) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let t121 = trait_impl#ToString#bool#to_string(greater_eq1/20) in
  let t122 = ("3.14 >= 2.71: " + t121) in
