impl Mark for int32{
  fn mark(self/0: int32) -> string {
      "marked:" + (int32::to_string : (int32) -> string)((self/0 : int32))
  }
}

impl Container[int32] for NumberBox{
  fn value(self/1: NumberBox) -> int32 {
      (self/1 : NumberBox).value
  }
}

fn describe(container/2: C) -> string {
    (Mark::mark : (T) -> string)((Container[T]::value : (C) -> T)((container/2 : C)))
}

fn main() -> unit {
    (println : (string) -> unit)((describe : (NumberBox) -> string)(NumberBox { value: 7 }));
}