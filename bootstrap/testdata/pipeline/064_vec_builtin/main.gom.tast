fn main() -> unit {
    let v/0: Vec[int32] = (Vec[int32]::new : () -> Vec[int32])();
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((v/0 : Vec[int32]), 10);
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((v/0 : Vec[int32]), 20);
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((v/0 : Vec[int32]), 30);
    let first/1: int32 = (v/0 : Vec[int32])[0];
    let second/2: int32 = (v/0 : Vec[int32])[1];
    let third/3: int32 = (v/0 : Vec[int32])[2];
    let len/4: int = (Vec[int32]::len : (Vec[int32]) -> int)((v/0 : Vec[int32]));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((first/1 : int32)));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((second/2 : int32)));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((third/3 : int32)));
    let _ : unit = (println : (string) -> unit)((int::to_string : (int) -> string)((len/4 : int)));
    ()
}