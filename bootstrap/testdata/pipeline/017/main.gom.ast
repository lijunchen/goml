package main;
impl ToString for (int, int) {
  fn to_string(self: (int, int)) -> string {
      "(?, ?)"
  }
}

fn main() {
    let x = 123;
    let _ = println(ToString::to_string(x));
    let x = true;
    let _ = println(ToString::to_string(x));
    let x = (3, 4);
    let _ = println(ToString::to_string(x));
    ()
}

