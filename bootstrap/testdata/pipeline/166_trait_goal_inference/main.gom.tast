impl Measure for Vec[int32]{
  fn measure(self/0: Vec[int32]) -> int {
      (Vec[int32]::len : (Vec[int32]) -> int)((self/0 : Vec[int32]))
  }
}

fn read_measure(value/1: T) -> int {
    (Measure::measure : (T) -> int)((value/1 : T))
}

fn main() -> unit {
    let values/2: Vec[int32] = (@intrinsic(vec.new) : () -> Vec[int32])();
    (println : (string) -> unit)((int::to_string : (int) -> string)((read_measure : (Vec[int32]) -> int)((values/2 : Vec[int32]))))
}