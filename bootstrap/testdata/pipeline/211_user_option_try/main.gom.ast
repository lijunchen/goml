package main;
enum Option[T] {
    Some(T),
    None
}

fn maybe_value(flag: bool) -> Option[int32] {
    if flag {
        {
            Option::Some(41)
        }
    } else {
        {
            Option::None
        }
    }
}

fn compute(flag: bool) -> Option[int32] {
    let value = maybe_value(flag)?;
    Option::Some(value + 1)
}

fn show(value: Option[int32]) -> string {
    match value {
        Option::Some(value) => value.to_string(),
        Option::None => "none",
    }
}

fn main() -> unit {
    println(show(compute(true)));
    println(show(compute(false)))
}

