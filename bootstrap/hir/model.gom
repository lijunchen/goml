package hir;

use gomlc::ast;

pub struct LocalId {
    pub pkg: int,
    pub index: int,
    pub hint: string,
}

pub struct DefId {
    pub pkg: int,
    pub index: int,
}

pub struct ImportAlias {
    pub alias: string,
    pub package_name: string,
}

pub enum NameRef {
    Local(LocalId),
    Def(DefId),
    Other(string),
}

pub enum ConstructorRef {
    Resolved(DefId, int),
    Unresolved(string),
}

pub enum TypeExpr {
    Unit,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Tuple(Vec[TypeExpr]),
    Con(string),
    Projection(TypeExpr, string),
    Dyn(string),
    App(TypeExpr, Vec[TypeExpr]),
    Array(string, TypeExpr),
    Func(Vec[TypeExpr], TypeExpr),
}

pub struct TraitRef {
    pub name: string,
    pub args: Vec[TypeExpr],
}

pub enum Predicate {
    Trait(TypeExpr, TraitRef),
    Equality(TypeExpr, TypeExpr),
}

pub struct AssociatedType {
    pub name: string,
    pub bounds: Vec[TraitRef],
}

pub struct TraitMethodSignature {
    pub name: string,
    pub params: Vec[TypeExpr],
    pub ret_ty: TypeExpr,
}

pub struct ClosureParam {
    pub name: LocalId,
    pub ty: Option[TypeExpr],
}

pub struct Function {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub visibility: ast::Visibility,
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(LocalId, TypeExpr)],
    pub param_type_spans: Vec[ast::Span],
    pub ret_ty: Option[TypeExpr],
    pub ret_ty_span: Option[ast::Span],
    pub body: Block,
}

pub struct ExternFunction {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub ret_ty: Option[TypeExpr],
}

pub struct EnumDef {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariant],
}

pub struct EnumVariant {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[TypeExpr]),
    Struct(Vec[(string, TypeExpr)]),
}

pub struct StructDef {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub fields: Vec[(string, TypeExpr)],
    pub public_fields: Vec[string],
}

pub struct TraitDef {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub supertraits: Vec[TraitRef],
    pub associated_types: Vec[AssociatedType],
    pub method_sigs: Vec[TraitMethodSignature],
}

pub struct ImplBlock {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub associated_types: Vec[(string, TypeExpr)],
    pub trait_ref: Option[TraitRef],
    pub for_type: TypeExpr,
    pub for_type_span: ast::Span,
    pub methods: Vec[Function],
}

pub enum Item {
    EnumDef(EnumDef),
    StructDef(StructDef),
    TraitDef(TraitDef),
    ImplBlock(ImplBlock),
    Function(Function),
    ExternFunction(ExternFunction),
}

pub struct File {
    pub package_name: string,
    pub path: string,
    pub source_path: string,
    pub imports: Vec[string],
    pub import_aliases: Vec[ImportAlias],
    pub use_traits: Vec[string],
    pub items: Vec[Item],
    pub invalid_self_type_spans: Vec[ast::Span],
}

pub struct Block {
    pub stmts: Vec[Stmt],
    pub tail: Option[Expr],
}

pub enum Stmt {
    Let(bool, Pat, Option[TypeExpr], Expr),
    Assign(Expr, Expr),
    Expr(Expr),
}

pub struct Expr {
    pub kind: ExprKind,
    pub span: ast::Span,
}

pub enum ExprKind {
    NameRef(NameRef),
    StaticMember(string, string, Vec[TypeExpr]),
    Unit,
    Bool(bool),
    Int(string),
    Float(float64),
    String(string),
    Char(string),
    Constr(ConstructorRef, Vec[Expr]),
    StructLiteral(string, Vec[(string, Expr)]),
    Tuple(Vec[Expr]),
    Array(Vec[Expr]),
    Closure(Vec[ClosureParam], Expr),
    Match(Expr, Vec[Arm]),
    If(Expr, Expr, Expr),
    While(Expr, Expr),
    For(Pat, Expr, Expr),
    Break,
    Continue,
    Return(Option[Expr]),
    Go(Expr),
    Call(Expr, Vec[Expr]),
    Unary(ast::UnaryOp, Expr),
    Cast(Expr, TypeExpr),
    Try(int, Expr),
    Range(Expr, Expr),
    Binary(ast::BinaryOp, Expr, Expr),
    Proj(Expr, int),
    Field(Expr, string),
    Index(Expr, Expr),
    Block(Block),
}

pub struct Arm {
    pub pat: Pat,
    pub guard: Option[Expr],
    pub body: Expr,
}

pub struct ArrayPatRest {
    pub binding: Option[LocalId],
}

pub struct Pat {
    pub kind: PatKind,
    pub span: ast::Span,
}

pub enum PatKind {
    Var(LocalId),
    Unit,
    Bool(bool),
    Int(string),
    Float(string),
    String(string),
    Char(string),
    Constr(ConstructorRef, Vec[Pat]),
    Struct(string, Vec[(string, Pat)], bool),
    Tuple(Vec[Pat]),
    Array(Vec[Pat], Option[ArrayPatRest], Vec[Pat]),
    Alias(LocalId, Pat),
    Or(Vec[Pat]),
    Range(Pat, Pat, bool),
    Wild,
}

pub struct Diagnostic {
    pub message: string,
    pub span: Option[ast::Span],
}

pub struct LowerResult {
    pub hir: Option[File],
    pub source_path: string,
    pub diagnostics: Vec[Diagnostic],
}
