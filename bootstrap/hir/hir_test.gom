package hir;

use gomlang::parser::ast;
use gomlang::parser::parser;
use std::testing;

fn lowered_file(source: string) -> File {
    let result = lower(ast::lower(parser::parse(source)), "main.gom");
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Option::Some(file) => file,
        Option::None => {
            testing::fail("expected HIR");
            File {
                package_name: "",
                path: "",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                items: Vec::new(),
            }
        },
    }
}

fn lowered_package_file(source: string, package_name: string) -> File {
    let result = lower_package(
        ast::lower(parser::parse(source)),
        "package.gom",
        package_name,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Option::Some(file) => file,
        Option::None => {
            testing::fail("expected package HIR");
            File {
                package_name: "",
                path: "",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                items: Vec::new(),
            }
        },
    }
}

#[test]
fn qualifies_package_items_types_and_import_aliases() -> unit {
    let source = "package sample; use std::io as output; struct Value { field: int32 } fn emit(value: Value) -> Value { output::println(\"ok\"); Value { field: value.field } }";
    let file = lowered_package_file(source, "std::sample");
    testing::assert_eq(file.package_name, "std::sample");
    testing::assert_eq(file.import_aliases.len(), 1);
    testing::assert_eq(file.import_aliases.get(0).alias, "output");
    testing::assert_eq(file.import_aliases.get(0).package_name, "std::io");
    match file.items.get(1) {
        Item::Function(value) => {
            testing::assert_eq(value.name, "std::sample::emit");
            match value.params.get(0).1 {
                TypeExpr::Con(name) => testing::assert_eq(name, "std::sample::Value"),
                _ => testing::fail("expected qualified parameter type"),
            };
            match value.body.stmts.get(0) {
                Stmt::Expr(Expr::Call(Expr::StaticMember(owner, member, _), _)) => {
                    testing::assert_eq(owner, "std::io");
                    testing::assert_eq(member, "println")
                },
                _ => testing::fail("expected qualified package call"),
            };
            match value.body.tail {
                Option::Some(Expr::StructLiteral(name, _)) => {
                    testing::assert_eq(name, "std::sample::Value")
                },
                _ => testing::fail("expected qualified struct literal"),
            }
        },
        _ => testing::fail("expected package function"),
    }
}

#[test]
fn resolves_traits_imported_through_package_aliases() -> unit {
    let file = lowered_package_file(
        "package usepkg; use vendor::traits as traitpkg; use traitpkg::Render; fn render() -> unit {}",
        "vendor::usepkg",
    );
    testing::assert_eq(file.import_aliases.len(), 1);
    testing::assert_eq(file.import_aliases.get(0).alias, "traitpkg");
    testing::assert_eq(file.import_aliases.get(0).package_name, "vendor::traits");
    testing::assert_eq(file.use_traits.len(), 1);
    testing::assert_eq(file.use_traits.get(0), "vendor::traits::Render")
}

#[test]
fn exposes_derived_impls_without_lowering_them_twice() -> unit {
    let expanded = expand_derives(ast::lower(parser::parse(
        "#[derive(Eq, Hash)] struct Key { value: int32 }",
    )));
    match expanded.ast {
        Option::Some(file) => {
            testing::assert_eq(file.items.len(), 3);
            match file.items.get(1) {
                ast::Item::ImplBlock(_) => (),
                _ => testing::fail("expected derived Eq impl"),
            };
            match file.items.get(2) {
                ast::Item::ImplBlock(_) => (),
                _ => testing::fail("expected derived Hash impl"),
            }
        },
        Option::None => testing::fail("expected expanded AST"),
    };
    let result = lower_expanded(expanded, "main.gom");
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Option::Some(file) => testing::assert_eq(file.items.len(), 3),
        Option::None => testing::fail("expected HIR"),
    }
}

#[test]
fn resolves_definitions_and_shadowed_locals() -> unit {
    let source = "fn id(value: int32) -> int32 { value } fn main() -> int32 { let value = 1; id(value) }";
    let file = lowered_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Item::Function(value) => {
            match value.body.stmts.get(0) {
                Stmt::Let(_, Pat::Var(local), _, Expr::Int(number)) => {
                    testing::assert_eq(local.pkg, 1);
                    testing::assert_eq(local.index, 1);
                    testing::assert_eq(number, "1")
                },
                _ => testing::fail("expected local binding"),
            };
            match value.body.tail {
                Option::Some(Expr::Call(function, args)) => {
                    match function {
                        Expr::NameRef(NameRef::Def(definition)) => {
                            testing::assert_eq(definition.pkg, 1);
                            testing::assert_eq(definition.index, 0)
                        },
                        _ => testing::fail("expected definition reference"),
                    };
                    testing::assert_eq(args.len(), 1);
                    match args.get(0) {
                        Expr::NameRef(NameRef::Local(local)) => {
                            testing::assert_eq(local.pkg, 1);
                            testing::assert_eq(local.index, 1)
                        },
                        _ => testing::fail("expected local reference"),
                    }
                },
                _ => testing::fail("expected function call"),
            }
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_enum_constructors_and_pattern_bindings() -> unit {
    let source = "enum Choice { None, Some(int32) } fn unwrap(value: Choice) -> int32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = lowered_file(source);
    match file.items.get(1) {
        Item::Function(value) => match value.body.tail {
            Option::Some(Expr::Match(_, arms)) => {
                testing::assert_eq(arms.len(), 2);
                match arms.get(0).pat {
                    Pat::Constr(ConstructorRef::Resolved(definition, variant), args) => {
                        testing::assert_eq(definition.pkg, 1);
                        testing::assert_eq(definition.index, 0);
                        testing::assert_eq(variant, 1);
                        testing::assert_eq(args.len(), 1)
                    },
                    _ => testing::fail("expected resolved constructor pattern"),
                };
                match arms.get(0).body {
                    Expr::NameRef(NameRef::Local(local)) => {
                        testing::assert_eq(local.pkg, 1);
                        testing::assert_eq(local.index, 1)
                    },
                    _ => testing::fail("expected pattern local reference"),
                }
            },
            _ => testing::fail("expected match expression"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_cross_file_constructor_patterns() -> unit {
    let parsed = Vec::new();
    parsed.push(parser::parse("package main; enum Status { Idle, Busy(int32) }"));
    parsed.push(parser::parse(
        "package main; fn label(status: Status) -> string { match status { Idle => \"idle\", Busy(value) => value.to_string() } }",
    ));
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "types.gom"));
    inputs.push((ast_files.get(1), "main.gom"));
    let lowered = lower_package_files(inputs, "main");
    testing::assert_eq(lowered.len(), 2);
    match lowered.get(1).hir {
        Option::Some(file) => match file.items.get(0) {
            Item::Function(function) => match function.body.tail {
                Option::Some(Expr::Match(_, arms)) => {
                    match arms.get(0).pat {
                        Pat::Constr(ConstructorRef::Resolved(definition, variant), args) => {
                            testing::assert_eq(definition.index, 0);
                            testing::assert_eq(variant, 0);
                            testing::assert_eq(args.len(), 0)
                        },
                        _ => testing::fail("expected resolved Idle pattern"),
                    };
                    match arms.get(1).pat {
                        Pat::Constr(ConstructorRef::Resolved(definition, variant), args) => {
                            testing::assert_eq(definition.index, 0);
                            testing::assert_eq(variant, 1);
                            testing::assert_eq(args.len(), 1)
                        },
                        _ => testing::fail("expected resolved Busy pattern"),
                    }
                },
                _ => testing::fail("expected cross-file match"),
            },
            _ => testing::fail("expected label function"),
        },
        Option::None => testing::fail("expected cross-file HIR"),
    }
}
