pub fn text_source() -> string {
    let source = \\package text;
        \\
        \\use std::bytes;
        \\
        \\pub struct StringBuilder {
        \\    pub parts: Vec[string],
        \\    pub byte_len: Ref[int32],
        \\}
        \\
        \\impl StringBuilder {
        \\    pub fn new() -> StringBuilder {
        \\        StringBuilder {
        \\            parts: Vec::new(),
        \\            byte_len: Ref::new(0),
        \\        }
        \\    }
        \\
        \\    pub fn with_capacity(part_capacity: int32) -> StringBuilder {
        \\        StringBuilder {
        \\            parts: Vec::with_capacity(part_capacity),
        \\            byte_len: Ref::new(0),
        \\        }
        \\    }
        \\
        \\    pub fn len(self: StringBuilder) -> int32 {
        \\        self.byte_len.get()
        \\    }
        \\
        \\    pub fn is_empty(self: StringBuilder) -> bool {
        \\        self.byte_len.get() == 0
        \\    }
        \\
        \\    pub fn write_string(self: StringBuilder, value: string) -> unit {
        \\        self.parts.push(value);
        \\        self.byte_len.set(self.byte_len.get() + value.byte_len())
        \\    }
        \\
        \\    pub fn write_char(self: StringBuilder, value: char) -> unit {
        \\        self.write_string(value.to_string())
        \\    }
        \\
        \\    pub fn write_bytes(self: StringBuilder, value: bytes::Bytes) -> Result[unit, string] {
        \\        match value.to_string() {
        \\            Result::Ok(text) => {
        \\                self.write_string(text);
        \\                Result::Ok(())
        \\            },
        \\            Result::Err(error) => Result::Err(error),
        \\        }
        \\    }
        \\
        \\    pub fn write_line(self: StringBuilder, value: string) -> unit {
        \\        self.write_string(value);
        \\        self.write_string("\n")
        \\    }
        \\
        \\    pub fn clear(self: StringBuilder) -> unit {
        \\        self.parts.clear();
        \\        self.byte_len.set(0)
        \\    }
        \\
        \\    pub fn finish(self: StringBuilder) -> string {
        \\        string_concat(self.parts)
        \\    }
        \\}
        \\
        \\impl ToString for StringBuilder {
        \\    fn to_string(self: StringBuilder) -> string {
        \\        self.finish()
        \\    }
        \\}
    ;
    source
}
