}

pub fn bytes_source() -> string {
    let source = \\package bytes;
        \\
        \\pub struct Bytes {
        \\    pub values: Vec[uint8],
        \\}
        \\
        \\impl Bytes {
        \\    pub fn new() -> Bytes {
        \\        Bytes { values: Vec::new() }
        \\    }
        \\
        \\    pub fn with_capacity(capacity: int32) -> Bytes {
        \\        Bytes {
        \\            values: Vec::with_capacity(capacity),
        \\        }
        \\    }
        \\
        \\    pub fn from_vec(values: Vec[uint8]) -> Bytes {
        \\        Bytes { values }
        \\    }
        \\
        \\    pub fn from_string(value: string) -> Bytes {
        \\        Bytes {
        \\            values: value.to_bytes(),
        \\        }
        \\    }
        \\
        \\    pub fn len(self: Bytes) -> int32 {
        \\        self.values.len()
        \\    }
        \\
        \\    pub fn capacity(self: Bytes) -> int32 {
        \\        self.values.capacity()
        \\    }
        \\
        \\    pub fn is_empty(self: Bytes) -> bool {
        \\        self.values.is_empty()
        \\    }
        \\
        \\    pub fn get(self: Bytes, index: int32) -> uint8 {
        \\        self.values.get(index)
        \\    }
        \\
        \\    pub fn set(self: Bytes, index: int32, value: uint8) -> unit {
        \\        self.values.set(index, value)
        \\    }
        \\
        \\    pub fn push(self: Bytes, value: uint8) -> unit {
        \\        self.values.push(value)
        \\    }
        \\
        \\    pub fn pop(self: Bytes) -> Option[uint8] {
        \\        self.values.pop()
        \\    }
        \\
        \\    pub fn reserve(self: Bytes, additional: int32) -> unit {
        \\        self.values.reserve(additional)
        \\    }
        \\
        \\    pub fn truncate(self: Bytes, len: int32) -> unit {
        \\        self.values.truncate(len)
        \\    }
        \\
        \\    pub fn clear(self: Bytes) -> unit {
        \\        self.values.clear()
        \\    }
        \\
        \\    pub fn slice(self: Bytes, start: int32, end: int32) -> Slice[uint8] {
        \\        self.values.slice(start, end)
        \\    }
        \\
        \\    pub fn to_vec(self: Bytes) -> Vec[uint8] {
        \\        self.values
        \\    }
        \\
        \\    pub fn to_string(self: Bytes) -> Result[string, string] {
        \\        let (valid, value) = string_from_utf8(self.values);
        \\        if valid {
        \\            Result::Ok(value)
        \\        } else {
        \\            Result::Err("invalid UTF-8")
        \\        }
        \\    }
        \\}
    ;
    source
}

pub fn fs_source() -> string {
    let source = \\package fs;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub fn read_file(path: string) -> Result[string, string] {
        \\    match read_bytes(path) {
        \\        Result::Ok(data) => data.to_string(),
        \\        Result::Err(error) => Result::Err(error),
        \\    }
        \\}
        \\
        \\pub fn write_file(path: string, content: string) -> Result[unit, string] {
        \\    write_bytes(path, bytes::Bytes::from_string(content))
        \\}
        \\
        \\pub fn read_bytes(path: string) -> Result[bytes::Bytes, string] {
        \\    let (ok, data, err) = host::read_bytes(path);
        \\    if ok {
        \\        Result::Ok(bytes::Bytes::from_vec(data))
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_bytes(path: string, data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_bytes(path, data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn create_dir_all(path: string) -> Result[unit, string] {
        \\    let (ok, err) = host::create_dir_all(path);
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn exists(path: string) -> bool {
        \\    host::file_exists(path)
        \\}
        \\
        \\pub fn is_file(path: string) -> bool {
        \\    host::is_file(path)
        \\}
        \\
        \\pub fn is_dir(path: string) -> bool {
        \\    host::is_dir(path)
        \\}
        \\
        \\pub fn canonicalize(path: string) -> Result[string, string] {
        \\    let (ok, result, err) = host::canonicalize(path);
        \\    if ok {
        \\        Result::Ok(result)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn read_dir(path: string) -> Result[Vec[string], string] {
        \\    let (ok, names, err) = host::read_dir(path);
        \\    if ok {
        \\        Result::Ok(names)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
    ;
    source
}

pub fn io_source() -> string {
