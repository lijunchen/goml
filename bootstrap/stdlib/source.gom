package stdlib;

pub fn host_source() -> string {
    let source = \\package host;
        \\
        \\#[runtime("std.env.args")]
        \\pub extern fn args() -> Vec[string]
        \\
        \\#[runtime("std.env.current_dir")]
        \\pub extern fn current_dir() -> (bool, string, string)
        \\
        \\#[runtime("std.env.current_exe")]
        \\pub extern fn current_exe() -> (bool, string, string)
        \\
        \\#[runtime("std.env.var")]
        \\pub extern fn env_var(name: string) -> (bool, string)
        \\
        \\#[runtime("std.fs.read_file")]
        \\pub extern fn read_file(path: string) -> (bool, string, string)
        \\
        \\#[runtime("std.fs.write_file")]
        \\pub extern fn write_file(path: string, content: string) -> (bool, string)
        \\
        \\#[runtime("std.fs.read_bytes")]
        \\pub extern fn read_bytes(path: string) -> (bool, Vec[uint8], string)
        \\
        \\#[runtime("std.fs.write_bytes")]
        \\pub extern fn write_bytes(path: string, data: Vec[uint8]) -> (bool, string)
        \\
        \\#[runtime("std.fs.create_dir_all")]
        \\pub extern fn create_dir_all(path: string) -> (bool, string)
        \\
        \\#[runtime("std.fs.file_exists")]
        \\pub extern fn file_exists(path: string) -> bool
        \\
        \\#[runtime("std.fs.is_file")]
        \\pub extern fn is_file(path: string) -> bool
        \\
        \\#[runtime("std.fs.is_dir")]
        \\pub extern fn is_dir(path: string) -> bool
        \\
        \\#[runtime("std.fs.canonicalize")]
        \\pub extern fn canonicalize(path: string) -> (bool, string, string)
        \\
        \\#[runtime("std.fs.read_dir")]
        \\pub extern fn read_dir(path: string) -> (bool, Vec[string], string)
        \\
        \\#[runtime("std.io.print")]
        \\pub extern fn print(value: string) -> unit
        \\
        \\#[runtime("std.io.println")]
        \\pub extern fn println(value: string) -> unit
        \\
        \\#[runtime("std.io.eprint")]
        \\pub extern fn eprint(value: string) -> unit
        \\
        \\#[runtime("std.io.read_stdin")]
        \\pub extern fn read_stdin() -> (bool, Vec[uint8], string)
        \\
        \\#[runtime("std.io.write_stdout")]
        \\pub extern fn write_stdout(data: Vec[uint8]) -> (bool, string)
        \\
        \\#[runtime("std.io.write_stderr")]
        \\pub extern fn write_stderr(data: Vec[uint8]) -> (bool, string)
    ;
    source
}

pub fn bytes_source() -> string {
    let source = \\package bytes;
        \\
        \\pub struct Bytes {
        \\    values: Vec[uint8],
        \\}
        \\
        \\impl Bytes {
        \\    fn new() -> Bytes {
        \\        Bytes { values: Vec::new() }
        \\    }
        \\
        \\    fn with_capacity(capacity: int32) -> Bytes {
        \\        Bytes {
        \\            values: Vec::with_capacity(capacity),
        \\        }
        \\    }
        \\
        \\    fn from_vec(values: Vec[uint8]) -> Bytes {
        \\        Bytes { values }
        \\    }
        \\
        \\    fn from_string(value: string) -> Bytes {
        \\        Bytes {
        \\            values: value.to_bytes(),
        \\        }
        \\    }
        \\
        \\    fn len(self: Bytes) -> int32 {
        \\        self.values.len()
        \\    }
        \\
        \\    fn capacity(self: Bytes) -> int32 {
        \\        self.values.capacity()
        \\    }
        \\
        \\    fn is_empty(self: Bytes) -> bool {
        \\        self.values.is_empty()
        \\    }
        \\
        \\    fn get(self: Bytes, index: int32) -> uint8 {
        \\        self.values.get(index)
        \\    }
        \\
        \\    fn set(self: Bytes, index: int32, value: uint8) -> unit {
        \\        self.values.set(index, value)
        \\    }
        \\
        \\    fn push(self: Bytes, value: uint8) -> unit {
        \\        self.values.push(value)
        \\    }
        \\
        \\    fn pop(self: Bytes) -> Option[uint8] {
        \\        self.values.pop()
        \\    }
        \\
        \\    fn reserve(self: Bytes, additional: int32) -> unit {
        \\        self.values.reserve(additional)
        \\    }
        \\
        \\    fn truncate(self: Bytes, len: int32) -> unit {
        \\        self.values.truncate(len)
        \\    }
        \\
        \\    fn clear(self: Bytes) -> unit {
        \\        self.values.clear()
        \\    }
        \\
        \\    fn slice(self: Bytes, start: int32, end: int32) -> Slice[uint8] {
        \\        self.values.slice(start, end)
        \\    }
        \\
        \\    fn to_vec(self: Bytes) -> Vec[uint8] {
        \\        self.values
        \\    }
        \\
        \\    fn to_string(self: Bytes) -> Result[string, string] {
        \\        let (valid, value) = string_from_utf8(self.values);
        \\        if valid {
        \\            Result::Ok(value)
        \\        } else {
        \\            Result::Err("invalid UTF-8")
        \\        }
        \\    }
        \\}
    ;
    source
}

pub fn fs_source() -> string {
    let source = \\package fs;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub fn read_file(path: string) -> Result[string, string] {
        \\    match read_bytes(path) {
        \\        Result::Ok(data) => data.to_string(),
        \\        Result::Err(error) => Result::Err(error),
        \\    }
        \\}
        \\
        \\pub fn write_file(path: string, content: string) -> Result[unit, string] {
        \\    write_bytes(path, bytes::Bytes::from_string(content))
        \\}
        \\
        \\pub fn read_bytes(path: string) -> Result[bytes::Bytes, string] {
        \\    let (ok, data, err) = host::read_bytes(path);
        \\    if ok {
        \\        Result::Ok(bytes::Bytes::from_vec(data))
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_bytes(path: string, data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_bytes(path, data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn create_dir_all(path: string) -> Result[unit, string] {
        \\    let (ok, err) = host::create_dir_all(path);
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn exists(path: string) -> bool {
        \\    host::file_exists(path)
        \\}
        \\
        \\pub fn is_file(path: string) -> bool {
        \\    host::is_file(path)
        \\}
        \\
        \\pub fn is_dir(path: string) -> bool {
        \\    host::is_dir(path)
        \\}
        \\
        \\pub fn canonicalize(path: string) -> Result[string, string] {
        \\    let (ok, result, err) = host::canonicalize(path);
        \\    if ok {
        \\        Result::Ok(result)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn read_dir(path: string) -> Result[Vec[string], string] {
        \\    let (ok, names, err) = host::read_dir(path);
        \\    if ok {
        \\        Result::Ok(names)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
    ;
    source
}

pub fn io_source() -> string {
    let source = \\package io;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub fn print[T: ToString](value: T) -> unit {
        \\    host::print(ToString::to_string(value))
        \\}
        \\
        \\pub fn println[T: ToString](value: T) -> unit {
        \\    host::println(ToString::to_string(value))
        \\}
        \\
        \\pub fn eprint[T: ToString](value: T) -> unit {
        \\    host::eprint(ToString::to_string(value))
        \\}
        \\
        \\pub fn eprintln[T: ToString](value: T) -> unit {
        \\    host::eprint(ToString::to_string(value) + "\n")
        \\}
        \\
        \\pub fn read_stdin() -> Result[bytes::Bytes, string] {
        \\    let (ok, data, err) = host::read_stdin();
        \\    if ok {
        \\        Result::Ok(bytes::Bytes::from_vec(data))
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_stdout(data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_stdout(data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn write_stderr(data: bytes::Bytes) -> Result[unit, string] {
        \\    let (ok, err) = host::write_stderr(data.to_vec());
        \\    if ok {
        \\        Result::Ok(())
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
    ;
    source
}

pub fn env_source() -> string {
    let source = \\package env;
        \\
        \\use std::internal::host;
        \\
        \\pub fn args() -> Vec[string] {
        \\    host::args()
        \\}
        \\
        \\pub fn current_dir() -> Result[string, string] {
        \\    let (ok, value, err) = host::current_dir();
        \\    if ok {
        \\        Result::Ok(value)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn current_exe() -> Result[string, string] {
        \\    let (ok, value, err) = host::current_exe();
        \\    if ok {
        \\        Result::Ok(value)
        \\    } else {
        \\        Result::Err(err)
        \\    }
        \\}
        \\
        \\pub fn var(name: string) -> Option[string] {
        \\    let (found, value) = host::env_var(name);
        \\    if found {
        \\        Option::Some(value)
        \\    } else {
        \\        Option::None
        \\    }
        \\}
    ;
    source
}
