pub fn process_source() -> string {
    let source = \\package process;
        \\
        \\use std::bytes;
        \\use std::internal::host;
        \\
        \\pub struct ExitStatus {
        \\    pub code_value: int32,
        \\}
        \\
        \\impl ExitStatus {
        \\    pub fn success(self: ExitStatus) -> bool {
        \\        self.code_value == 0
        \\    }
        \\
        \\    pub fn code(self: ExitStatus) -> Option[int32] {
        \\        if self.code_value < 0 {
        \\            Option::None
        \\        } else {
        \\            Option::Some(self.code_value)
        \\        }
        \\    }
        \\}
        \\
        \\pub struct Output {
        \\    pub status_value: ExitStatus,
        \\    pub stdout_value: bytes::Bytes,
        \\    pub stderr_value: bytes::Bytes,
        \\}
        \\
        \\impl Output {
        \\    pub fn status(self: Output) -> ExitStatus {
        \\        self.status_value
        \\    }
        \\
        \\    pub fn stdout(self: Output) -> bytes::Bytes {
        \\        self.stdout_value
        \\    }
        \\
        \\    pub fn stderr(self: Output) -> bytes::Bytes {
        \\        self.stderr_value
        \\    }
        \\}
        \\
        \\pub struct Command {
        \\    pub program: string,
        \\    pub arguments: Vec[string],
        \\    pub has_directory: bool,
        \\    pub directory: string,
        \\    pub environment: Vec[(string, string)],
        \\}
        \\
        \\impl Command {
        \\    pub fn new(program: string) -> Command {
        \\        Command {
        \\            program,
        \\            arguments: Vec::new(),
        \\            has_directory: false,
        \\            directory: "",
        \\            environment: Vec::new(),
        \\        }
        \\    }
        \\
        \\    pub fn arg(self: Command, argument: string) -> Command {
        \\        self.arguments.push(argument);
        \\        self
        \\    }
        \\
        \\    pub fn args(self: Command, arguments: Vec[string]) -> Command {
        \\        for argument in arguments {
        \\            self.arguments.push(argument)
        \\        };
        \\        self
        \\    }
        \\
        \\    pub fn current_dir(self: Command, directory: string) -> Command {
        \\        Command {
        \\            program: self.program,
        \\            arguments: self.arguments,
        \\            has_directory: true,
        \\            directory,
        \\            environment: self.environment,
        \\        }
        \\    }
        \\
        \\    pub fn env(self: Command, key: string, value: string) -> Command {
        \\        self.environment.push((key, value));
        \\        self
        \\    }
        \\
        \\    pub fn output(self: Command) -> Result[Output, string] {
        \\        let (ok, code, stdout, stderr, err) = host::process_output(
        \\            self.program,
        \\            self.arguments,
        \\            self.has_directory,
        \\            self.directory,
        \\            self.environment,
        \\        );
        \\        if ok {
        \\            Result::Ok(Output {
        \\                status_value: ExitStatus { code_value: code },
        \\                stdout_value: bytes::Bytes::from_vec(stdout),
        \\                stderr_value: bytes::Bytes::from_vec(stderr),
        \\            })
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\
        \\    pub fn status(self: Command) -> Result[ExitStatus, string] {
        \\        let (ok, code, err) = host::process_status(
        \\            self.program,
        \\            self.arguments,
        \\            self.has_directory,
        \\            self.directory,
        \\            self.environment,
        \\        );
        \\        if ok {
        \\            Result::Ok(ExitStatus { code_value: code })
        \\        } else {
        \\            Result::Err(err)
        \\        }
        \\    }
        \\}
        \\
        \\pub fn exit(code: int32) -> unit {
        \\    host::exit(code)
        \\}
    ;
    source
}

pub fn testing_source() -> string {
    let source = \\package testing;
        \\
        \\use std::internal::host;
        \\
        \\pub fn fail(message: string) -> unit {
        \\    host::test_fail(message)
        \\}
        \\
        \\pub fn assert(condition: bool) -> unit {
        \\    if condition {
        \\        ()
        \\    } else {
        \\        fail("assertion failed")
        \\    }
        \\}
        \\
        \\pub fn assert_eq[T: Eq + ToString](actual: T, expected: T) -> unit {
        \\    if Eq::eq(actual, expected) {
        \\        ()
        \\    } else {
        \\        fail(
        \\            "assertion failed: values are not equal\n  actual: "
        \\                + ToString::to_string(actual)
        \\                + "\nexpected: "
        \\                + ToString::to_string(expected),
        \\        )
        \\    }
        \\}
        \\
        \\pub fn assert_ne[T: Eq + ToString](actual: T, expected: T) -> unit {
        \\    if Eq::eq(actual, expected) {
        \\        fail(
        \\            "assertion failed: values are equal\nvalue: "
        \\                + ToString::to_string(actual),
        \\        )
        \\    } else {
        \\        ()
        \\    }
        \\}
    ;
    source
}

pub fn collections_source() -> string {
    let source = \\package collections;
        \\
        \\pub struct ArenaId[T] {
        \\    pub index: int32,
        \\}
        \\
        \\impl[T] ArenaId[T] {
        \\    pub fn index(self: ArenaId[T]) -> int32 {
        \\        self.index
        \\    }
        \\}
        \\
        \\impl[T] Eq for ArenaId[T] {
        \\    fn eq(self: ArenaId[T], other: ArenaId[T]) -> bool {
        \\        self.index == other.index
        \\    }
        \\}
        \\
        \\impl[T] Hash for ArenaId[T] {
        \\    fn hash(self: ArenaId[T]) -> uint64 {
        \\        Hash::hash(self.index)
        \\    }
        \\}
        \\
        \\pub struct Arena[T] {
        \\    pub values: Vec[T],
        \\}
        \\
        \\impl[T] Arena[T] {
        \\    pub fn new() -> Arena[T] {
        \\        Arena { values: Vec::new() }
        \\    }
        \\
        \\    pub fn len(self: Arena[T]) -> int32 {
        \\        self.values.len()
        \\    }
        \\
        \\    pub fn is_empty(self: Arena[T]) -> bool {
        \\        self.values.len() == 0
        \\    }
        \\
        \\    pub fn alloc(self: Arena[T], value: T) -> ArenaId[T] {
        \\        let index = self.values.len();
        \\        self.values.push(value);
        \\        ArenaId { index }
        \\    }
        \\
        \\    pub fn contains_id(self: Arena[T], id: ArenaId[T]) -> bool {
        \\        id.index >= 0 && id.index < self.values.len()
        \\    }
        \\
        \\    pub fn get(self: Arena[T], id: ArenaId[T]) -> T {
        \\        self.values.get(id.index)
        \\    }
        \\
        \\    pub fn try_get(self: Arena[T], id: ArenaId[T]) -> Option[T] {
        \\        if self.contains_id(id) {
        \\            Option::Some(self.values.get(id.index))
        \\        } else {
        \\            Option::None
        \\        }
        \\    }
        \\
        \\    pub fn set(self: Arena[T], id: ArenaId[T], value: T) -> unit {
        \\        self.values.set(id.index, value)
        \\    }
        \\}
        \\
        \\pub struct BitSet {
        \\    pub words: Vec[uint64],
        \\    pub len: Ref[int32],
        \\}
        \\
        \\impl BitSet {
        \\    pub fn new() -> BitSet {
        \\        BitSet {
        \\            words: Vec::new(),
        \\            len: Ref::new(0),
        \\        }
        \\    }
        \\
        \\    pub fn len(self: BitSet) -> int32 {
        \\        self.len.get()
        \\    }
        \\
        \\    pub fn is_empty(self: BitSet) -> bool {
        \\        self.len.get() == 0
        \\    }
        \\
        \\    pub fn contains(self: BitSet, index: int32) -> bool {
        \\        if index < 0 {
        \\            false
        \\        } else {
        \\            let word_index = index / 64;
        \\            if word_index >= self.words.len() {
        \\                false
        \\            } else {
        \\                let mask = 1u64 << (index % 64);
        \\                self.words.get(word_index) & mask != 0u64
        \\            }
        \\        }
        \\    }
        \\
        \\    pub fn insert(self: BitSet, index: int32) -> bool {
        \\        if index < 0 {
        \\            false
        \\        } else {
        \\            let word_index = index / 64;
        \\            while self.words.len() <= word_index {
        \\                self.words.push(0u64);
        \\            };
        \\            let mask = 1u64 << (index % 64);
        \\            let old = self.words.get(word_index);
        \\            if old & mask != 0u64 {
        \\                false
        \\            } else {
        \\                self.words.set(word_index, old | mask);
        \\                self.len.set(self.len.get() + 1);
        \\                true
        \\            }
        \\        }
        \\    }
        \\
        \\    pub fn remove(self: BitSet, index: int32) -> bool {
        \\        if !self.contains(index) {
        \\            false
        \\        } else {
        \\            let word_index = index / 64;
        \\            let mask = 1u64 << (index % 64);
        \\            self.words.set(word_index, self.words.get(word_index) & ~mask);
        \\            self.len.set(self.len.get() - 1);
        \\            true
        \\        }
        \\    }
        \\
        \\    pub fn clear(self: BitSet) -> unit {
        \\        self.words.clear();
        \\        self.len.set(0)
        \\    }
        \\}
        \\
        \\pub struct Deque[T] {
        \\    pub slots: Ref[Vec[Option[T]]],
        \\    pub head: Ref[int32],
        \\    pub len: Ref[int32],
        \\}
        \\
        \\impl[T] Deque[T] {
        \\    pub fn new() -> Deque[T] {
