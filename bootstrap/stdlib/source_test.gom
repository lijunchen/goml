package stdlib;

use gomlang::parser::ast;
use gomlang::parser::hir;
use gomlang::parser::parser;
use gomlang::parser::tast;
use std::testing;

fn lowered_standard_hir(source: string, path: string, package_name: string) -> hir::File {
    let result = hir::lower_package(
        ast::lower(parser::parse(source)),
        path,
        package_name,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Option::Some(file) => file,
        Option::None => {
            testing::fail("expected standard package HIR");
            hir::File {
                package_name,
                path,
                source_path: path,
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                items: Vec::new(),
            }
        },
    }
}

fn assert_standard_typechecks(
    source: string,
    path: string,
    package_name: string,
    dependencies: Vec[hir::File],
) -> unit {
    let result = tast::check_for_link_with_dependencies(
        hir::lower_package(
            ast::lower(parser::parse(source)),
            path,
            package_name,
        ),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 0)
}

#[test]
fn typechecks_collections_source() -> unit {
    assert_standard_typechecks(
        collections_source(),
        "collections.gom",
        "std::collections",
        Vec::new(),
    )
}

#[test]
fn typechecks_text_source_with_bytes() -> unit {
    let dependencies = Vec::new();
    dependencies.push(lowered_standard_hir(
        bytes_source(),
        "bytes.gom",
        "std::bytes",
    ));
    assert_standard_typechecks(
        text_source(),
        "string_builder.gom",
        "std::text",
        dependencies,
    )
}

#[test]
fn typechecks_path_process_and_testing_sources() -> unit {
    let host = lowered_standard_hir(
        host_source(),
        "host.gom",
        "std::internal::host",
    );
    let bytes = lowered_standard_hir(
        bytes_source(),
        "bytes.gom",
        "std::bytes",
    );
    assert_standard_typechecks(
        path_source(),
        "path.gom",
        "std::path",
        Vec::new().pushed(host),
    );
    assert_standard_typechecks(
        process_source(),
        "process.gom",
        "std::process",
        Vec::new().pushed(host).pushed(bytes),
    );
    assert_standard_typechecks(
        testing_source(),
        "testing.gom",
        "std::testing",
        Vec::new().pushed(host),
    )
}
