package mono;

use gomlc::core;
use gomlc::tast;

struct TypeBinding {
    name: string,
    ty: tast::Type,
}

struct Instance {
    original_name: string,
    name: string,
    bindings: Vec[TypeBinding],
    parent: Option[string],
}

struct TraitSelection {
    reference: tast::TraitRef,
    associated_types: Vec[(string, tast::Type)],
}

struct SpecializeCtx {
    functions: Vec[core::Function],
    function_index: HashMap[string, core::Function],
    generic_inherent_index: HashMap[string, core::Function],
    trait_function_index: HashMap[string, Vec[core::Function]],
    trait_method_index: HashMap[string, Vec[core::Function]],
    trait_method_names: HashMap[string, string],
    instances: Vec[Instance],
    instance_index: HashMap[string, Instance],
    work: Vec[Instance],
    used_names: HashMap[string, unit],
    active: Ref[Option[Instance]],
    error: Ref[Option[string]],
}

fn find_binding(values: Vec[TypeBinding], name: string) -> Option[tast::Type] {
    let result: Ref[Option[tast::Type]] = Ref::new(Option::None);
    for value in values {
        if value.name == name {
            result.set(Option::Some(value.ty))
        } else {
            ()
        }
    };
    result.get()
}

fn bind_type(values: Vec[TypeBinding], name: string, ty: tast::Type) -> bool {
    match find_binding(values, name) {
        Option::Some(previous) => compact_type(previous) == compact_type(ty),
        Option::None => {
            values.push(TypeBinding { name, ty });
            true
        },
    }
}

fn unify_types(
    templates: Vec[tast::Type],
    actuals: Vec[tast::Type],
    bindings: Vec[TypeBinding],
) -> bool {
    if templates.len() != actuals.len() {
        false
    } else {
        let valid = Ref::new(true);
        for index in range(0, templates.len()) {
            if unify_type(templates.get(index), actuals.get(index), bindings) {
                ()
            } else {
                valid.set(false)
            }
        };
        valid.get()
    }
}

fn unify_optional_trait_refs(
    templates: Option[tast::TraitRef],
    actuals: Option[tast::TraitRef],
    bindings: Vec[TypeBinding],
) -> bool {
    match (templates, actuals) {
        (Option::Some(template), Option::Some(actual)) => {
            template.name == actual.name && unify_types(template.args, actual.args, bindings)
        },
        (Option::None, Option::None) => true,
        _ => false,
    }
}

fn projection_binding_name(
    base: tast::Type,
    name: string,
    reference: Option[tast::TraitRef],
) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string("projection#");
    builder.write_string(compact_type(base));
    builder.write_char('#');
    match reference {
        Option::Some(reference) => {
            builder.write_string(reference.name);
            for arg in reference.args {
                builder.write_char('#');
                builder.write_string(compact_type(arg))
            }
        },
        Option::None => (),
    };
    builder.write_char('#');
    builder.write_string(name);
    builder.finish()
}

fn has_projection_binding(values: Vec[TypeBinding]) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.name.byte_len() >= 11
            && value.name.byte_slice(0, 11) == "projection#"
        {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn unify_type(
    template: tast::Type,
    actual: tast::Type,
    bindings: Vec[TypeBinding],
) -> bool {
    match (tast::resolve_type(template), tast::resolve_type(actual)) {
        (tast::Type::Param { name }, value) => bind_type(bindings, name, value),
        (tast::Type::Unit, tast::Type::Unit)
        | (tast::Type::Never, tast::Type::Never)
        | (tast::Type::Bool, tast::Type::Bool)
        | (tast::Type::Int, tast::Type::Int)
        | (tast::Type::Int8, tast::Type::Int8)
        | (tast::Type::Int16, tast::Type::Int16)
        | (tast::Type::Int32, tast::Type::Int32)
        | (tast::Type::Int64, tast::Type::Int64)
        | (tast::Type::Uint8, tast::Type::Uint8)
        | (tast::Type::Uint16, tast::Type::Uint16)
        | (tast::Type::Uint32, tast::Type::Uint32)
        | (tast::Type::Uint64, tast::Type::Uint64)
        | (tast::Type::Float32, tast::Type::Float32)
        | (tast::Type::Float64, tast::Type::Float64)
        | (tast::Type::String, tast::Type::String)
        | (tast::Type::Char, tast::Type::Char)
        | (tast::Type::Error, tast::Type::Error) => true,
        (tast::Type::Tuple { items: templates }, tast::Type::Tuple { items: actuals }) => {
            unify_types(templates, actuals, bindings)
        },
        (tast::Type::Con { name: template }, tast::Type::Con { name: actual }) => template == actual,
        (tast::Type::Dyn { trait_name: template }, tast::Type::Dyn { trait_name: actual }) => template == actual,
        (
            tast::Type::Projection {
                for_ty: template_base,
                name: template_name,
                trait_ref: template_ref,
            },
            tast::Type::Projection { for_ty: actual_base, name: actual_name, trait_ref: actual_ref },
        ) => {
            template_name == actual_name
                && unify_type(template_base, actual_base, bindings)
                && unify_optional_trait_refs(template_ref, actual_ref, bindings)
        },
        (tast::Type::Projection { for_ty: base, name, trait_ref: reference }, actual) => {
            let base = substitute_type(base, bindings);
            let reference = substitute_optional_trait_ref(reference, bindings);
            if type_is_concrete(base) && type_is_concrete(actual) {
                bind_type(
                    bindings,
                    projection_binding_name(base, name, reference),
                    actual,
                )
            } else {
                false
            }
        },
        (
            tast::Type::App { ty: template_base, args: template_args },
            tast::Type::App { ty: actual_base, args: actual_args },
        ) => {
            unify_type(template_base, actual_base, bindings)
                && unify_types(template_args, actual_args, bindings)
        },
        (
            tast::Type::Array { len: template_length, elem: template_elem },
            tast::Type::Array { len: actual_length, elem: actual_elem },
        ) => {
            template_length == actual_length
                && unify_type(template_elem, actual_elem, bindings)
        },
        (tast::Type::Slice { elem: template }, tast::Type::Slice { elem: actual })
        | (tast::Type::VecType { elem: template }, tast::Type::VecType { elem: actual })
        | (tast::Type::RefType { elem: template }, tast::Type::RefType { elem: actual })
        | (tast::Type::Channel { elem: template }, tast::Type::Channel { elem: actual }) => {
            unify_type(template, actual, bindings)
        },
        (
            tast::Type::HashMap { key: template_key, value: template_value },
            tast::Type::HashMap { key: actual_key, value: actual_value },
        ) => {
            unify_type(template_key, actual_key, bindings)
                && unify_type(template_value, actual_value, bindings)
        },
        (
            tast::Type::Func { params: template_params, ret_ty: template_ret },
            tast::Type::Func { params: actual_params, ret_ty: actual_ret },
        ) => {
            unify_types(template_params, actual_params, bindings)
                && unify_type(template_ret, actual_ret, bindings)
        },
        _ => false,
    }
}

fn substitute_types(
    values: Vec[tast::Type],
    bindings: Vec[TypeBinding],
) -> Vec[tast::Type] {
    let result = Vec::new();
    for value in values {
        result.push(substitute_type(value, bindings))
    };
    result
}

fn substitute_named_types(
    values: Vec[(string, tast::Type)],
    bindings: Vec[TypeBinding],
) -> Vec[(string, tast::Type)] {
    let result = Vec::new();
    for value in values {
        result.push((value.0, substitute_type(value.1, bindings)))
    };
    result
}

fn substitute_optional_trait_ref(
    value: Option[tast::TraitRef],
    bindings: Vec[TypeBinding],
) -> Option[tast::TraitRef] {
    match value {
        Option::Some(reference) => Option::Some(substitute_trait_ref(reference, bindings)),
        Option::None => Option::None,
    }
}

fn substitute_trait_ref(
    value: tast::TraitRef,
    bindings: Vec[TypeBinding],
) -> tast::TraitRef {
    tast::TraitRef {
        name: value.name,
        args: substitute_types(value.args, bindings),
    }
}

fn substitute_type(value: tast::Type, bindings: Vec[TypeBinding]) -> tast::Type {
    match tast::resolve_type(value) {
        tast::Type::Var(variable) => tast::Type::Var(variable),
        tast::Type::Unit => tast::Type::Unit,
        tast::Type::Never => tast::Type::Never,
        tast::Type::Bool => tast::Type::Bool,
        tast::Type::Int => tast::Type::Int,
        tast::Type::Int8 => tast::Type::Int8,
        tast::Type::Int16 => tast::Type::Int16,
        tast::Type::Int32 => tast::Type::Int32,
        tast::Type::Int64 => tast::Type::Int64,
        tast::Type::Uint8 => tast::Type::Uint8,
        tast::Type::Uint16 => tast::Type::Uint16,
        tast::Type::Uint32 => tast::Type::Uint32,
        tast::Type::Uint64 => tast::Type::Uint64,
        tast::Type::Float32 => tast::Type::Float32,
        tast::Type::Float64 => tast::Type::Float64,
        tast::Type::String => tast::Type::String,
        tast::Type::Char => tast::Type::Char,
        tast::Type::Tuple { items } => {
            tast::Type::Tuple { items: substitute_types(items, bindings) }
        },
        tast::Type::Con { name } => tast::Type::Con { name },
        tast::Type::Dyn { trait_name: name } => tast::Type::Dyn { trait_name: name },
        tast::Type::Projection { for_ty: base, name, trait_ref: reference } => {
            let base = substitute_type(base, bindings);
            let reference = substitute_optional_trait_ref(reference, bindings);
            match find_binding(
                bindings,
                projection_binding_name(base, name, reference),
            ) {
                Option::Some(ty) => ty,
                Option::None => match tast::builtin_projection(base, name, reference) {
                    Option::Some(ty) => substitute_type(ty, bindings),
                    Option::None => tast::Type::Projection {
                        for_ty: base,
                        name,
                        trait_ref: reference,
                    },
                },
            }
        },
        tast::Type::App { ty: base, args } => tast::Type::App {
            ty: substitute_type(base, bindings),
            args: substitute_types(args, bindings),
        },
        tast::Type::Array { len: length, elem } => {
            tast::Type::Array { len: length, elem: substitute_type(elem, bindings) }
        },
        tast::Type::Slice { elem } => {
            tast::Type::Slice { elem: substitute_type(elem, bindings) }
        },
        tast::Type::VecType { elem } => {
            tast::Type::VecType { elem: substitute_type(elem, bindings) }
        },
        tast::Type::RefType { elem } => {
            tast::Type::RefType { elem: substitute_type(elem, bindings) }
        },
        tast::Type::Channel { elem } => {
            tast::Type::Channel { elem: substitute_type(elem, bindings) }
        },
        tast::Type::HashMap { key, value } => tast::Type::HashMap {
            key: substitute_type(key, bindings),
            value: substitute_type(value, bindings),
        },
        tast::Type::Param { name } => match find_binding(bindings, name) {
            Option::Some(ty) => ty,
            Option::None => tast::Type::Param { name },
        },
        tast::Type::Func { params, ret_ty } => tast::Type::Func {
            params: substitute_types(params, bindings),
            ret_ty: substitute_type(ret_ty, bindings),
        },
        tast::Type::Error => tast::Type::Error,
    }
}

fn function_type(value: core::Function) -> tast::Type {
    let params = Vec::new();
    for param in value.params {
        params.push(param.1)
    };
    tast::Type::Func { params, ret_ty: value.ret_ty }
}

fn function_is_generic(value: core::Function) -> bool {
    if value.generics.len() > 0 {
        true
    } else {
        let generic = Ref::new(!type_is_concrete(value.ret_ty));
        for param in value.params {
            if type_is_concrete(param.1) {
                ()
            } else {
                generic.set(true)
            }
        };
        generic.get()
    }
}

fn find_function(ctx: SpecializeCtx, name: string) -> Option[core::Function] {
    ctx.function_index.get(name)
}

fn hash_segments(value: string) -> Vec[string] {
    let result = Vec::new();
    let start = Ref::new(0);
    for index in range(0, value.byte_len()) {
        if value.byte_slice(index, index + 1) == "#" {
            result.push(value.byte_slice(start.get(), index));
            start.set(index + 1)
        } else {
            ()
        }
    };
    result.push(value.byte_slice(start.get(), value.byte_len()));
    result
}

fn inherent_method_key(name: string) -> Option[(string, string)] {
    let segments = hash_segments(name);
    if segments.len() == 4 && segments.get(0) == "inherent" {
        Option::Some((segments.get(1), segments.get(3)))
    } else {
        Option::None
    }
}

fn lookup_pair_key(left: string, right: string) -> string {
    left.byte_len().to_string() + ":" + left + right
}

fn add_indexed_function(
    index: HashMap[string, Vec[core::Function]],
    key: string,
    function: core::Function,
) -> unit {
    match index.get(key) {
        Option::Some(functions) => functions.push(function),
        Option::None => {
            let functions = Vec::new();
            functions.push(function);
            index.set(key, functions)
        },
    }
}

fn indexed_functions(
    index: HashMap[string, Vec[core::Function]],
    key: string,
) -> Vec[core::Function] {
    match index.get(key) {
        Option::Some(functions) => functions,
        Option::None => Vec::new(),
    }
}

fn find_generic_inherent_function(
    ctx: SpecializeCtx,
    name: string,
) -> Option[core::Function] {
    match inherent_method_key(name) {
        Option::Some(key) => ctx.generic_inherent_index.get(
            lookup_pair_key(key.0, key.1),
        ),
        Option::None => Option::None,
    }
}

fn find_callee_function(ctx: SpecializeCtx, name: string) -> Option[core::Function] {
    match find_function(ctx, name) {
        Option::Some(function) => Option::Some(function),
        Option::None => find_generic_inherent_function(ctx, name),
    }
}

fn trait_impl_method_name(name: string) -> Option[string] {
    let segments = hash_segments(name);
    if segments.len() == 4 && segments.get(0) == "trait_impl" {
        Option::Some(segments.get(3))
    } else {
        Option::None
    }
}

fn trait_instance_name(
    ctx: SpecializeCtx,
    function: core::Function,
    bindings: Vec[TypeBinding],
) -> Option[string] {
    match (function.trait_impl, ctx.trait_method_names.get(function.name)) {
        (Option::Some(metadata), Option::Some(method_name)) => Option::Some(
            trait_impl_name(
                substitute_trait_ref(metadata.trait_ref, bindings),
                substitute_type(metadata.for_ty, bindings),
                method_name,
            ),
        ),
        _ => Option::None,
    }
}

fn same_bindings(left: Vec[TypeBinding], right: Vec[TypeBinding]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        let equal = Ref::new(true);
        for value in left {
            match find_binding(right, value.name) {
                Option::Some(ty) => if compact_type(value.ty) == compact_type(ty) {
                    ()
                } else {
                    equal.set(false)
                },
                Option::None => equal.set(false),
            }
        };
        equal.get()
    }
}

fn find_instance(
    ctx: SpecializeCtx,
    original_name: string,
    bindings: Vec[TypeBinding],
) -> Option[Instance] {
    ctx.instance_index.get(instance_lookup_key(original_name, bindings))
}

fn name_is_used(ctx: SpecializeCtx, name: string) -> bool {
    ctx.used_names.contains(name)
}

fn string_precedes(left: string, right: string) -> bool {
    let length = if left.byte_len() < right.byte_len() {
        left.byte_len()
    } else {
        right.byte_len()
    };
    let index = Ref::new(0);
    while index.get() < length
        && left.byte_get(index.get()) == right.byte_get(index.get())
    {
        index.set(index.get() + 1)
    };
    if index.get() == length {
        left.byte_len() < right.byte_len()
    } else {
        left.byte_get(index.get()) < right.byte_get(index.get())
    }
}

fn sorted_bindings(values: Vec[TypeBinding]) -> Vec[TypeBinding] {
    let result = Vec::new();
    for value in values {
        let index = Ref::new(0);
        while index.get() < result.len()
            && !string_precedes(value.name, result.get(index.get()).name)
        {
            index.set(index.get() + 1)
        };
        result.insert(index.get(), value)
    };
    result
}

fn instance_lookup_key(
    original_name: string,
    bindings: Vec[TypeBinding],
) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string(original_name.byte_len().to_string());
    builder.write_char(':');
    builder.write_string(original_name);
    for binding in sorted_bindings(bindings) {
        let ty = compact_type(binding.ty);
        builder.write_string(binding.name.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(binding.name);
        builder.write_string(ty.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(ty)
    };
    builder.finish()
}

fn instance_base_name(
    ctx: SpecializeCtx,
    original_name: string,
    bindings: Vec[TypeBinding],
) -> string {
    if bindings.len() == 0 {
        original_name
    } else {
        match find_function(ctx, original_name) {
            Option::Some(function) => match trait_instance_name(ctx, function, bindings) {
                Option::Some(name) => name,
                Option::None => {
                    let builder = std::text::StringBuilder::new();
                    builder.write_string(original_name);
                    for binding in sorted_bindings(bindings) {
                        if binding.name.byte_len() >= 11
                            && binding.name.byte_slice(0, 11) == "projection#"
                        {
                            ()
                        } else {
                            builder.write_string("__");
                            builder.write_string(binding.name);
                            builder.write_char('_');
                            builder.write_string(compact_type(binding.ty))
                        }
                    };
                    builder.finish()
                },
            },
            Option::None => original_name,
        }
    }
}

fn unique_instance_name(ctx: SpecializeCtx, base: string) -> string {
    if !name_is_used(ctx, base) {
        ctx.used_names.set(base, ());
        base
    } else {
        let index = Ref::new(1);
        let candidate = Ref::new(base + "__mono1");
        while name_is_used(ctx, candidate.get()) {
            index.set(index.get() + 1);
            candidate.set(base + "__mono" + index.get().to_string())
        };
        ctx.used_names.set(candidate.get(), ());
        candidate.get()
    }
}

fn ensure_instance(
    ctx: SpecializeCtx,
    original_name: string,
    bindings: Vec[TypeBinding],
) -> string {
    match find_instance(ctx, original_name, bindings) {
        Option::Some(instance) => instance.name,
        Option::None => {
            match recursive_specialization_message(ctx, original_name, bindings) {
                Option::Some(message) => {
                    ctx.error.set(Option::Some(message));
                    return original_name
                },
                Option::None => (),
            };
            let base = instance_base_name(ctx, original_name, bindings);
            let name = if bindings.len() == 0 {
                base
            } else {
                unique_instance_name(ctx, base)
            };
            let instance = Instance {
                original_name,
                name,
                bindings,
                parent: match ctx.active.get() {
                    Option::Some(active) => Option::Some(instance_lookup_key(
                        active.original_name,
                        active.bindings,
                    )),
                    Option::None => Option::None,
                },
            };
            ctx.instances.push(instance);
            ctx.instance_index.set(
                instance_lookup_key(instance.original_name, instance.bindings),
                instance,
            );
            ctx.work.push(instance);
            instance.name
        },
    }
}

fn mono_type_text(value: tast::Type) -> string {
    let builder = std::text::StringBuilder::new();
    tast::write_type(builder, value);
    builder.finish()
}

fn mono_types_equal(left: tast::Type, right: tast::Type) -> bool {
    compact_type(left) == compact_type(right)
}

fn mono_type_contains_proper_subterm(
    value: tast::Type,
    expected: tast::Type,
) -> bool {
    match tast::resolve_type(value) {
        tast::Type::Tuple { items: values } => {
            let found = Ref::new(false);
            for value in values {
                if mono_types_equal(value, expected)
                    || mono_type_contains_proper_subterm(value, expected)
                {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        tast::Type::App { ty: base, args } => {
            let found = Ref::new(
                mono_types_equal(base, expected)
                    || mono_type_contains_proper_subterm(base, expected),
            );
            for arg in args {
                if mono_types_equal(arg, expected)
                    || mono_type_contains_proper_subterm(arg, expected)
                {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        tast::Type::Array { len: _, elem }
        | tast::Type::Slice { elem }
        | tast::Type::VecType { elem }
        | tast::Type::RefType { elem }
        | tast::Type::Channel { elem } => {
            mono_types_equal(elem, expected)
                || mono_type_contains_proper_subterm(elem, expected)
        },
        tast::Type::HashMap { key, value } => {
            mono_types_equal(key, expected)
                || mono_type_contains_proper_subterm(key, expected)
                || mono_types_equal(value, expected)
                || mono_type_contains_proper_subterm(value, expected)
        },
        tast::Type::Func { params, ret_ty } => {
            let found = Ref::new(
                mono_types_equal(ret_ty, expected)
                    || mono_type_contains_proper_subterm(ret_ty, expected),
            );
            for param in params {
                if mono_types_equal(param, expected)
                    || mono_type_contains_proper_subterm(param, expected)
                {
                    found.set(true)
                } else {
                    ()
                }
            };
            found.get()
        },
        _ => false,
    }
}

fn mono_type_outer_constructor_matches(
    left: tast::Type,
    right: tast::Type,
) -> bool {
    match (tast::resolve_type(left), tast::resolve_type(right)) {
        (tast::Type::Tuple { items: _ }, tast::Type::Tuple { items: _ })
        | (tast::Type::Array { len: _, elem: _ }, tast::Type::Array { len: _, elem: _ })
        | (tast::Type::Slice { elem: _ }, tast::Type::Slice { elem: _ })
        | (tast::Type::VecType { elem: _ }, tast::Type::VecType { elem: _ })
        | (tast::Type::RefType { elem: _ }, tast::Type::RefType { elem: _ })
        | (tast::Type::Channel { elem: _ }, tast::Type::Channel { elem: _ })
        | (tast::Type::HashMap { key: _, value: _ }, tast::Type::HashMap { key: _, value: _ })
        | (tast::Type::Func { params: _, ret_ty: _ }, tast::Type::Func { params: _, ret_ty: _ }) => true,
        (tast::Type::App { ty: left, args: _ }, tast::Type::App { ty: right, args: _ }) => {
            mono_types_equal(left, right)
        },
        _ => false,
    }
}

fn mono_type_contains_recursive_growth(
    value: tast::Type,
    previous: tast::Type,
) -> bool {
    mono_type_outer_constructor_matches(value, previous)
        && mono_type_contains_proper_subterm(value, previous)
}

fn projection_binding(value: TypeBinding) -> bool {
    value.name.byte_len() >= 11
        && value.name.byte_slice(0, 11) == "projection#"
}

fn specialization_growth_message(
    ctx: SpecializeCtx,
    name: string,
    previous: Vec[TypeBinding],
    next: Vec[TypeBinding],
) -> Option[string] {
    match find_function(ctx, name) {
        Option::Some(function) => {
            for generic in function.generics {
                match (find_binding(previous, generic), find_binding(next, generic)) {
                    (Option::Some(old_ty), Option::Some(new_ty)) => {
                        if mono_type_contains_recursive_growth(new_ty, old_ty) {
                            return Option::Some(
                                "Infinite monomorphization detected for generic function "
                                    + name
                                    + ": recursive specialization grows type parameter "
                                    + generic
                                    + " from "
                                    + mono_type_text(old_ty)
                                    + " to "
                                    + mono_type_text(new_ty),
                            )
                        } else {
                            ()
                        }
                    },
                    _ => (),
                }
            };
            for new_binding in next {
                if projection_binding(new_binding) {
                    ()
                } else {
                    for old_binding in previous {
                        if !projection_binding(old_binding)
                            && mono_type_contains_recursive_growth(
                                new_binding.ty,
                                old_binding.ty,
                            )
                        {
                            return Option::Some(
                                "Infinite monomorphization detected for generic function "
                                    + name
                                    + ": recursive specialization grows type parameter "
                                    + new_binding.name
                                    + " from "
                                    + mono_type_text(old_binding.ty)
                                    + " to "
                                    + mono_type_text(new_binding.ty),
                            )
                        } else {
                            ()
                        }
                    }
                }
            };
            Option::None
        },
        Option::None => Option::None,
    }
}

fn recursive_specialization_message(
    ctx: SpecializeCtx,
    name: string,
    bindings: Vec[TypeBinding],
) -> Option[string] {
    recursive_specialization_from(
        ctx,
        name,
        bindings,
        ctx.active.get(),
    )
}

fn recursive_specialization_from(
    ctx: SpecializeCtx,
    name: string,
    bindings: Vec[TypeBinding],
    cursor: Option[Instance],
) -> Option[string] {
    match cursor {
        Option::Some(instance) => {
            let current = if instance.original_name == name {
                specialization_growth_message(
                    ctx,
                    name,
                    instance.bindings,
                    bindings,
                )
            } else {
                Option::None
            };
            match current {
                Option::Some(message) => Option::Some(message),
                Option::None => match instance.parent {
                    Option::Some(parent) => recursive_specialization_from(
                        ctx,
                        name,
                        bindings,
                        ctx.instance_index.get(parent),
                    ),
                    Option::None => Option::None,
                },
            }
        },
        Option::None => Option::None,
    }
}

fn copy_bindings(values: Vec[TypeBinding]) -> Vec[TypeBinding] {
    let result = Vec::new();
    for value in values {
        result.push(value)
    };
    result
}

fn trait_ref_key(value: tast::TraitRef) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string(value.name);
    for arg in value.args {
        builder.write_char('#');
        builder.write_string(compact_type(arg))
    };
    builder.finish()
}

fn trait_selection_key(value: TraitSelection) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string(trait_ref_key(value.reference));
    for associated in value.associated_types {
        builder.write_char('#');
        builder.write_string(associated.0);
        builder.write_char('=');
        builder.write_string(compact_type(associated.1))
    };
    builder.finish()
}

fn contains_string(values: Vec[string], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn matching_trait_selections(
    ctx: SpecializeCtx,
    for_ty: tast::Type,
    reference: tast::TraitRef,
    bindings: Vec[TypeBinding],
) -> Vec[TraitSelection] {
    let selections = Vec::new();
    let keys = Vec::new();
    for function in indexed_functions(ctx.trait_function_index, reference.name) {
        match function.trait_impl {
            Option::Some(metadata) => if metadata.trait_ref.name == reference.name
                && metadata.trait_ref.args.len() == reference.args.len()
            {
                let impl_bindings = Vec::new();
                if unify_type(metadata.for_ty, for_ty, impl_bindings) {
                    let candidate = substitute_trait_ref(
                        metadata.trait_ref,
                        impl_bindings,
                    );
                    let candidate_matches = if types_are_concrete(reference.args) {
                        unify_types(candidate.args, reference.args, impl_bindings)
                    } else {
                        true
                    };
                    if candidate_matches
                        && complete_bindings(ctx, function, impl_bindings)
                    {
                        let application = substitute_trait_ref(
                            metadata.trait_ref,
                            impl_bindings,
                        );
                        let trial = copy_bindings(bindings);
                        if unify_types(reference.args, application.args, trial) {
                            let selection = TraitSelection {
                                reference: application,
                                associated_types: substitute_named_types(
                                    metadata.associated_types,
                                    impl_bindings,
                                ),
                            };
                            let key = trait_selection_key(selection);
                            if contains_string(keys, key) {
                                ()
                            } else {
                                keys.push(key);
                                selections.push(selection)
                            }
                        } else {
                            ()
                        }
                    } else {
                        ()
                    }
                } else {
                    ()
                }
            } else {
                ()
            },
            Option::None => (),
        }
    };
    selections
}

fn active_types_with(values: Vec[string], value: string) -> Vec[string] {
    let result = Vec::new();
    for item in values {
        result.push(item)
    };
    result.push(value);
    result
}

fn normalize_types(
    ctx: SpecializeCtx,
    values: Vec[tast::Type],
    active: Vec[string],
) -> Vec[tast::Type] {
    let result = Vec::new();
    for value in values {
        result.push(normalize_type(ctx, value, active))
    };
    result
}

fn normalize_trait_ref(
    ctx: SpecializeCtx,
    value: tast::TraitRef,
    active: Vec[string],
) -> tast::TraitRef {
    tast::TraitRef {
        name: value.name,
        args: normalize_types(ctx, value.args, active),
    }
}

fn normalize_optional_trait_ref(
    ctx: SpecializeCtx,
    value: Option[tast::TraitRef],
    active: Vec[string],
) -> Option[tast::TraitRef] {
    match value {
        Option::Some(reference) => {
            Option::Some(normalize_trait_ref(ctx, reference, active))
        },
        Option::None => Option::None,
    }
}

fn matching_projection_types(
    ctx: SpecializeCtx,
    base: tast::Type,
    name: string,
    reference: tast::TraitRef,
) -> Vec[tast::Type] {
    let result = Vec::new();
    let keys = Vec::new();
    for function in indexed_functions(ctx.trait_function_index, reference.name) {
        match function.trait_impl {
            Option::Some(metadata) => {
                if metadata.trait_ref.name == reference.name
                    && metadata.trait_ref.args.len() == reference.args.len()
                {
                    let bindings = Vec::new();
                    if unify_type(metadata.for_ty, base, bindings)
                        && unify_types(
                            metadata.trait_ref.args,
                            reference.args,
                            bindings,
                        )
                        && complete_bindings(ctx, function, bindings)
                    {
                        for associated in metadata.associated_types {
                            if associated.0 == name {
                                let value = substitute_type(associated.1, bindings);
                                let key = compact_type(value);
                                if contains_string(keys, key) {
                                    ()
                                } else {
                                    keys.push(key);
                                    result.push(value)
                                }
                            } else {
                                ()
                            }
                        }
                    } else {
                        ()
                    }
                } else {
                    ()
                }
            },
            Option::None => (),
        }
    };
    result
}

fn normalize_projection(
    ctx: SpecializeCtx,
    base: tast::Type,
    name: string,
    reference: Option[tast::TraitRef],
    active: Vec[string],
) -> tast::Type {
    let projection = tast::Type::Projection { for_ty: base, name, trait_ref: reference };
    let key = projection_binding_name(base, name, reference);
    if contains_string(active, key) {
        projection
    } else {
        let normalized = match tast::builtin_projection(base, name, reference) {
            Option::Some(value) => Option::Some(value),
            Option::None => match reference {
                Option::Some(reference) => {
                    if type_is_concrete(base) && types_are_concrete(reference.args) {
                        let values = matching_projection_types(
                            ctx,
                            base,
                            name,
                            reference,
                        );
                        if values.len() == 1 {
                            Option::Some(values.get(0))
                        } else {
                            Option::None
                        }
                    } else {
                        Option::None
                    }
                },
                Option::None => Option::None,
            },
        };
        match normalized {
            Option::Some(value) => {
                normalize_type(ctx, value, active_types_with(active, key))
            },
            Option::None => projection,
        }
    }
}

fn normalize_type(
    ctx: SpecializeCtx,
    value: tast::Type,
    active: Vec[string],
) -> tast::Type {
    match tast::resolve_type(value) {
        tast::Type::Var(variable) => tast::Type::Var(variable),
        tast::Type::Unit => tast::Type::Unit,
        tast::Type::Never => tast::Type::Never,
        tast::Type::Bool => tast::Type::Bool,
        tast::Type::Int => tast::Type::Int,
        tast::Type::Int8 => tast::Type::Int8,
        tast::Type::Int16 => tast::Type::Int16,
        tast::Type::Int32 => tast::Type::Int32,
        tast::Type::Int64 => tast::Type::Int64,
        tast::Type::Uint8 => tast::Type::Uint8,
        tast::Type::Uint16 => tast::Type::Uint16,
        tast::Type::Uint32 => tast::Type::Uint32,
        tast::Type::Uint64 => tast::Type::Uint64,
        tast::Type::Float32 => tast::Type::Float32,
        tast::Type::Float64 => tast::Type::Float64,
        tast::Type::String => tast::Type::String,
        tast::Type::Char => tast::Type::Char,
        tast::Type::Tuple { items } => {
            tast::Type::Tuple { items: normalize_types(ctx, items, active) }
        },
        tast::Type::Con { name } => tast::Type::Con { name },
        tast::Type::Dyn { trait_name: name } => tast::Type::Dyn { trait_name: name },
        tast::Type::Projection { for_ty: base, name, trait_ref: reference } => {
            let base = normalize_type(ctx, base, active);
            let reference = normalize_optional_trait_ref(ctx, reference, active);
            normalize_projection(ctx, base, name, reference, active)
        },
        tast::Type::App { ty: base, args } => tast::Type::App {
            ty: normalize_type(ctx, base, active),
            args: normalize_types(ctx, args, active),
        },
        tast::Type::Array { len: length, elem } => {
            tast::Type::Array { len: length, elem: normalize_type(ctx, elem, active) }
        },
        tast::Type::Slice { elem } => {
            tast::Type::Slice { elem: normalize_type(ctx, elem, active) }
        },
        tast::Type::VecType { elem } => {
            tast::Type::VecType { elem: normalize_type(ctx, elem, active) }
        },
        tast::Type::RefType { elem } => {
            tast::Type::RefType { elem: normalize_type(ctx, elem, active) }
        },
        tast::Type::Channel { elem } => {
            tast::Type::Channel { elem: normalize_type(ctx, elem, active) }
        },
        tast::Type::HashMap { key, value } => tast::Type::HashMap {
            key: normalize_type(ctx, key, active),
            value: normalize_type(ctx, value, active),
        },
        tast::Type::Param { name } => tast::Type::Param { name },
        tast::Type::Func { params, ret_ty } => tast::Type::Func {
            params: normalize_types(ctx, params, active),
            ret_ty: normalize_type(ctx, ret_ty, active),
        },
        tast::Type::Error => tast::Type::Error,
    }
}

fn types_contain_associated_projection(values: Vec[tast::Type]) -> bool {
    let found = Ref::new(false);
    for value in values {
        if type_contains_associated_projection(value) {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn type_contains_associated_projection(value: tast::Type) -> bool {
    match value {
        tast::Type::Projection { for_ty: _, name: _, trait_ref: _ } => true,
        tast::Type::Tuple { items } => types_contain_associated_projection(items),
        tast::Type::App { ty: base, args } => {
            type_contains_associated_projection(base)
                || types_contain_associated_projection(args)
        },
        tast::Type::Array { len: _, elem }
        | tast::Type::Slice { elem }
        | tast::Type::VecType { elem }
        | tast::Type::RefType { elem }
        | tast::Type::Channel { elem } => type_contains_associated_projection(elem),
        tast::Type::HashMap { key, value } => {
            type_contains_associated_projection(key)
                || type_contains_associated_projection(value)
        },
        tast::Type::Func { params, ret_ty } => {
            types_contain_associated_projection(params)
                || type_contains_associated_projection(ret_ty)
        },
        tast::Type::Var(_)
        | tast::Type::Unit
        | tast::Type::Never
        | tast::Type::Bool
        | tast::Type::Int
        | tast::Type::Int8
        | tast::Type::Int16
        | tast::Type::Int32
        | tast::Type::Int64
        | tast::Type::Uint8
        | tast::Type::Uint16
        | tast::Type::Uint32
        | tast::Type::Uint64
        | tast::Type::Float32
        | tast::Type::Float64
        | tast::Type::String
        | tast::Type::Char
        | tast::Type::Con { name: _ }
        | tast::Type::Dyn { trait_name: _ }
        | tast::Type::Param { name: _ }
        | tast::Type::Error => false,
    }
}

fn specialize_type(
    ctx: SpecializeCtx,
    value: tast::Type,
    bindings: Vec[TypeBinding],
) -> tast::Type {
    let specialized = substitute_type(value, bindings);
    if type_contains_associated_projection(specialized) {
        normalize_type(ctx, specialized, Vec::new())
    } else {
        specialized
    }
}

fn specialize_trait_ref(
    ctx: SpecializeCtx,
    value: tast::TraitRef,
    bindings: Vec[TypeBinding],
) -> tast::TraitRef {
    normalize_trait_ref(
        ctx,
        substitute_trait_ref(value, bindings),
        Vec::new(),
    )
}

fn specialize_named_types(
    ctx: SpecializeCtx,
    values: Vec[(string, tast::Type)],
    bindings: Vec[TypeBinding],
) -> Vec[(string, tast::Type)] {
    let result = Vec::new();
    for value in values {
        result.push((value.0, specialize_type(ctx, value.1, bindings)))
    };
    result
}

fn complete_function_bindings(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
) -> unit {
    for _ in range(0, value.generics.len() + 1) {
        let previous_len = bindings.len();
        for predicate in value.predicates {
            match predicate {
                tast::TypePredicate::Trait { for_ty, trait_ref: reference } => {
                    let for_ty = substitute_type(for_ty, bindings);
                    if type_is_concrete(for_ty) {
                        let reference = substitute_trait_ref(reference, bindings);
                        let selections = matching_trait_selections(
                            ctx,
                            for_ty,
                            reference,
                            bindings,
                        );
                        if selections.len() == 1 {
                            let selection = selections.get(0);
                            unify_types(
                                reference.args,
                                selection.reference.args,
                                bindings,
                            );
                            for associated in selection.associated_types {
                                bind_type(
                                    bindings,
                                    projection_binding_name(
                                        for_ty,
                                        associated.0,
                                        Option::Some(selection.reference),
                                    ),
                                    associated.1,
                                );
                                bind_type(
                                    bindings,
                                    projection_binding_name(
                                        for_ty,
                                        associated.0,
                                        Option::None,
                                    ),
                                    associated.1,
                                );
                                ()
                            };
                            ()
                        } else {
                            ()
                        }
                    } else {
                        ()
                    }
                },
                tast::TypePredicate::Equality { lhs, rhs } => {
                    let lhs = substitute_type(lhs, bindings);
                    let rhs = substitute_type(rhs, bindings);
                    if unify_type(lhs, rhs, bindings) {
                        ()
                    } else {
                        unify_type(rhs, lhs, bindings);
                        ()
                    }
                },
            }
        };
        if bindings.len() == previous_len {
            break
        } else {
            ()
        }
    }
}

fn predicates_are_satisfied(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
) -> bool {
    let satisfied = Ref::new(true);
    for predicate in value.predicates {
        match predicate {
            tast::TypePredicate::Trait { for_ty, trait_ref: reference } => {
                let for_ty = substitute_type(for_ty, bindings);
                let reference = substitute_trait_ref(reference, bindings);
                if type_is_concrete(for_ty)
                    && (builtin_trait_satisfied(for_ty, reference)
                        || matching_trait_selections(
                            ctx,
                            for_ty,
                            reference,
                            bindings,
                        ).len() == 1)
                {
                    ()
                } else {
                    satisfied.set(false)
                }
            },
            tast::TypePredicate::Equality { lhs, rhs } => {
                let lhs = substitute_type(lhs, bindings);
                let rhs = substitute_type(rhs, bindings);
                if compact_type(lhs) == compact_type(rhs) {
                    ()
                } else {
                    satisfied.set(false)
                }
            },
        }
    };
    satisfied.get()
}

fn builtin_scalar_type(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        tast::Type::Unit
        | tast::Type::Bool
        | tast::Type::Int
        | tast::Type::Int8
        | tast::Type::Int16
        | tast::Type::Int32
        | tast::Type::Int64
        | tast::Type::Uint8
        | tast::Type::Uint16
        | tast::Type::Uint32
        | tast::Type::Uint64
        | tast::Type::Float32
        | tast::Type::Float64
        | tast::Type::String
        | tast::Type::Char => true,
        _ => false,
    }
}

fn builtin_iterator_type(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        tast::Type::App { ty: tast::Type::Con { name }, args } => {
            (name == "FnIterator" && args.len() == 1)
                || (name == "MapIterator" && args.len() == 3)
                || (name == "FilterIterator" && args.len() == 2)
                || (name == "TakeIterator" && args.len() == 1)
        },
        _ => false,
    }
}

fn builtin_trait_satisfied(
    for_ty: tast::Type,
    reference: tast::TraitRef,
) -> bool {
    reference.args.len() == 0 && match tast::resolve_type(for_ty) {
        tast::Type::Dyn { trait_name: name } => reference.name == name,
        other => if reference.name == "ToString"
            || reference.name == "Eq"
            || reference.name == "Hash"
        {
            builtin_scalar_type(other)
        } else if reference.name == "Iterator" {
            builtin_iterator_type(other)
        } else if reference.name == "IntoIterator" {
            match other {
                tast::Type::VecType { elem: _ } | tast::Type::Slice { elem: _ } => true,
                value => builtin_iterator_type(value),
            }
        } else {
            false
        },
    }
}

fn complete_bindings(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
) -> bool {
    complete_function_bindings(ctx, value, bindings);
    let complete = Ref::new(true);
    for generic in value.generics {
        match find_binding(bindings, generic) {
            Option::Some(ty) => if type_is_concrete(ty) {
                ()
            } else {
                complete.set(false)
            },
            Option::None => complete.set(false),
        }
    };
    complete.get() && predicates_are_satisfied(ctx, value, bindings)
}

fn specialize_callable(
    ctx: SpecializeCtx,
    value: tast::Callable,
    bindings: Vec[TypeBinding],
) -> tast::Callable {
    match value {
        tast::Callable::Function(name) => tast::Callable::Function(name),
        tast::Callable::Runtime(name) => tast::Callable::Runtime(name),
        tast::Callable::Intrinsic(name) => tast::Callable::Intrinsic(name),
        tast::Callable::TraitMethod { trait_ref: reference, method_name: name } => {
            tast::Callable::TraitMethod {
                trait_ref: specialize_trait_ref(ctx, reference, bindings),
                method_name: name,
            }
        },
        tast::Callable::DynTraitMethod {
            trait_name: owner,
            dispatch_name: dispatch,
            method_name: name,
        } => {
            tast::Callable::DynTraitMethod {
                trait_name: owner,
                dispatch_name: dispatch,
                method_name: name,
            }
        },
        tast::Callable::InherentMethod { receiver_ty: owner, method_name: name } => {
            tast::Callable::InherentMethod {
                receiver_ty: specialize_type(ctx, owner, bindings),
                method_name: name,
            }
        },
    }
}

fn specialize_closure_params(
    ctx: SpecializeCtx,
    values: Vec[tast::ClosureParam],
    bindings: Vec[TypeBinding],
) -> Vec[tast::ClosureParam] {
    let result = Vec::new();
    for value in values {
        result.push(tast::ClosureParam {
            name: value.name,
            ty: specialize_type(ctx, value.ty, bindings),
        })
    };
    result
}

fn specialize_exprs(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    values: Vec[core::Expr],
) -> Vec[core::Expr] {
    let result = Vec::new();
    for value in values {
        result.push(specialize_expr(ctx, bindings, value))
    };
    result
}

fn specialize_optional_expr(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    value: Option[core::Expr],
) -> Option[core::Expr] {
    match value {
        Option::Some(expr) => Option::Some(specialize_expr(ctx, bindings, expr)),
        Option::None => Option::None,
    }
}

fn specialize_arms(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    values: Vec[core::Arm],
) -> Vec[core::Arm] {
    let result = Vec::new();
    for value in values {
        result.push(core::Arm {
            lhs: specialize_expr(ctx, bindings, value.lhs),
            body: specialize_expr(ctx, bindings, value.body),
        })
    };
    result
}

fn specialize_block(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    value: core::Block,
) -> core::Block {
    let stmts = Vec::new();
    for stmt in value.stmts {
        stmts.push(core::LetStmt {
            name: stmt.name,
            value: specialize_expr(ctx, bindings, stmt.value),
            ty: specialize_type(ctx, stmt.ty, bindings),
        })
    };
    core::Block {
        stmts,
        tail: specialize_optional_expr(ctx, bindings, value.tail),
    }
}

fn trait_call_types(receiver: core::Expr, args: Vec[core::Expr]) -> Vec[tast::Type] {
    let result = Vec::new();
    result.push(core::expr_type(receiver));
    for arg in args {
        result.push(core::expr_type(arg))
    };
    result
}

fn ensure_trait_method_instance(
    ctx: SpecializeCtx,
    reference: tast::TraitRef,
    method_name: string,
    actual_types: Vec[tast::Type],
    ret_ty: tast::Type,
) -> tast::TraitRef {
    let resolved: Ref[Option[tast::TraitRef]] = Ref::new(Option::None);
    for function in indexed_functions(
        ctx.trait_method_index,
        lookup_pair_key(reference.name, method_name),
    ) {
        let bindings = Vec::new();
        let valid = Ref::new(true);
        match function.trait_impl {
            Option::Some(metadata) => {
                if metadata.trait_ref.args.len() == reference.args.len() {
                    if unify_type(
                        metadata.for_ty,
                        actual_types.get(0),
                        bindings,
                    ) && unify_types(
                        metadata.trait_ref.args,
                        reference.args,
                        bindings,
                    ) {
                        ()
                    } else {
                        valid.set(false)
                    }
                } else {
                    valid.set(false)
                };
            },
            Option::None => valid.set(false),
        };
        if valid.get() {
            let param_types = Vec::new();
            for param in function.params {
                param_types.push(param.1)
            };
            if unify_types(param_types, actual_types, bindings)
                && unify_type(function.ret_ty, ret_ty, bindings)
            {
                ()
            } else {
                valid.set(false)
            }
        } else {
            ()
        };
        if valid.get()
            && complete_bindings(ctx, function, bindings)
        {
            ensure_instance(ctx, function.name, bindings);
            resolved.set(Option::Some(specialize_trait_ref(
                ctx,
                reference,
                bindings,
            )))
        } else {
            ()
        }
    };
    match resolved.get() {
        Option::Some(reference) => reference,
        Option::None => reference,
    }
}

fn ensure_trait_call_instance(
    ctx: SpecializeCtx,
    reference: tast::TraitRef,
    method_name: string,
    receiver: core::Expr,
    args: Vec[core::Expr],
    ret_ty: tast::Type,
) -> tast::TraitRef {
    ensure_trait_method_instance(
        ctx,
        reference,
        method_name,
        trait_call_types(receiver, args),
        ret_ty,
    )
}

fn ensure_dyn_trait_impls(
    ctx: SpecializeCtx,
    trait_name: string,
    for_ty: tast::Type,
) -> unit {
    for function in indexed_functions(ctx.trait_function_index, trait_name) {
        match function.trait_impl {
            Option::Some(metadata) => {
                let bindings = Vec::new();
                if unify_type(metadata.for_ty, for_ty, bindings)
                    && complete_bindings(ctx, function, bindings)
                {
                    ensure_instance(ctx, function.name, bindings);
                    ()
                } else {
                    ()
                }
            },
            Option::None => (),
        }
    }
}

fn specialize_found_var_with_projection_bindings(
    ctx: SpecializeCtx,
    function: core::Function,
    name: string,
    ty: tast::Type,
    allow_projection_bindings: bool,
) -> core::Expr {
    if function_is_generic(function) {
        if type_is_concrete(ty) {
            let call_bindings = Vec::new();
            if unify_type(function_type(function), ty, call_bindings)
                && (allow_projection_bindings
                    || !has_projection_binding(call_bindings))
                && complete_bindings(ctx, function, call_bindings)
            {
                core::Expr::Var {
                    name: ensure_instance(ctx, function.name, call_bindings),
                    ty,
                }
            } else {
                core::Expr::Var { name, ty }
            }
        } else {
            core::Expr::Var { name, ty }
        }
    } else {
        core::Expr::Var { name, ty }
    }
}

fn specialize_found_var(
    ctx: SpecializeCtx,
    function: core::Function,
    name: string,
    ty: tast::Type,
) -> core::Expr {
    specialize_found_var_with_projection_bindings(
        ctx,
        function,
        name,
        ty,
        false,
    )
}

fn specialize_call_var(
    ctx: SpecializeCtx,
    function: core::Function,
    name: string,
    ty: tast::Type,
) -> core::Expr {
    specialize_found_var_with_projection_bindings(
        ctx,
        function,
        name,
        ty,
        true,
    )
}

fn specialize_var(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    name: string,
    ty: tast::Type,
) -> core::Expr {
    let ty = specialize_type(ctx, ty, bindings);
    match find_function(ctx, name) {
        Option::Some(function) => specialize_found_var(ctx, function, name, ty),
        Option::None => core::Expr::Var { name, ty },
    }
}

fn specialize_call(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    func: core::Expr,
    args: Vec[core::Expr],
    ty: tast::Type,
) -> core::Expr {
    let func = specialize_expr(ctx, bindings, func);
    let args = specialize_exprs(ctx, bindings, args);
    let ty = specialize_type(ctx, ty, bindings);
    let func = match func {
        core::Expr::Var { name, ty: func_ty } => match find_callee_function(ctx, name) {
            Option::Some(function) => if function_is_generic(function) {
                specialize_call_var(ctx, function, name, func_ty)
            } else {
                core::Expr::Var {
                    name: ensure_instance(ctx, function.name, Vec::new()),
                    ty: func_ty,
                }
            },
            Option::None => core::Expr::Var { name, ty: func_ty },
        },
        other => other,
    };
    core::Expr::Call { func, args, ty }
}

fn specialize_expr(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    value: core::Expr,
) -> core::Expr {
    match value {
        core::Expr::Var { name, ty } => specialize_var(ctx, bindings, name, ty),
        core::Expr::Callable { callable, ty } => core::Expr::Callable {
            callable: specialize_callable(ctx, callable, bindings),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Prim { value, ty } => {
            core::Expr::Prim { value, ty: specialize_type(ctx, ty, bindings) }
        },
        core::Expr::Constr { constructor, args, ty } => core::Expr::Constr {
            constructor,
            args: specialize_exprs(ctx, bindings, args),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Tuple { items, ty } => core::Expr::Tuple {
            items: specialize_exprs(ctx, bindings, items),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Array { items, ty } => core::Expr::Array {
            items: specialize_exprs(ctx, bindings, items),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Closure { params, body, ty } => core::Expr::Closure {
            params: specialize_closure_params(ctx, params, bindings),
            body: specialize_expr(ctx, bindings, body),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Block { block, ty } => core::Expr::Block {
            block: specialize_block(ctx, bindings, block),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Match { expr, arms, default, ty } => core::Expr::Match {
            expr: specialize_expr(ctx, bindings, expr),
            arms: specialize_arms(ctx, bindings, arms),
            default: specialize_optional_expr(ctx, bindings, default),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::If { cond, then_branch, else_branch, ty } => core::Expr::If {
            cond: specialize_expr(ctx, bindings, cond),
            then_branch: specialize_expr(ctx, bindings, then_branch),
            else_branch: specialize_expr(ctx, bindings, else_branch),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::While { cond, body, ty } => core::Expr::While {
            cond: specialize_expr(ctx, bindings, cond),
            body: specialize_expr(ctx, bindings, body),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Break { ty } => core::Expr::Break { ty: specialize_type(ctx, ty, bindings) },
        core::Expr::Continue { ty } => {
            core::Expr::Continue { ty: specialize_type(ctx, ty, bindings) }
        },
        core::Expr::Return { expr, ty } => core::Expr::Return {
            expr: specialize_optional_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Go { expr, ty } => core::Expr::Go {
            expr: specialize_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::ConstrGet { expr, constructor, field_index, ty } => {
            core::Expr::ConstrGet {
                expr: specialize_expr(ctx, bindings, expr),
                constructor,
                field_index,
                ty: specialize_type(ctx, ty, bindings),
            }
        },
        core::Expr::Unary { op, expr, ty } => core::Expr::Unary {
            op,
            expr: specialize_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Cast { expr, ty } => core::Expr::Cast {
            expr: specialize_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Binary { op, lhs, rhs, ty } => core::Expr::Binary {
            op,
            lhs: specialize_expr(ctx, bindings, lhs),
            rhs: specialize_expr(ctx, bindings, rhs),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Assign { name, value, target_ty, ty } => core::Expr::Assign {
            name,
            value: specialize_expr(ctx, bindings, value),
            target_ty: specialize_type(ctx, target_ty, bindings),
            ty: specialize_type(ctx, ty, bindings),
        },
        core::Expr::Call { func, args, ty } => {
            specialize_call(ctx, bindings, func, args, ty)
        },
        core::Expr::ToDyn { trait_name, for_ty, expr, ty } => {
            let for_ty = specialize_type(ctx, for_ty, bindings);
            ensure_dyn_trait_impls(ctx, trait_name, for_ty);
            core::Expr::ToDyn {
                trait_name,
                for_ty,
                expr: specialize_expr(ctx, bindings, expr),
                ty: specialize_type(ctx, ty, bindings),
            }
        },
        core::Expr::DynCall { trait_name, method_name, receiver, args, ty } => {
            core::Expr::DynCall {
                trait_name,
                method_name,
                receiver: specialize_expr(ctx, bindings, receiver),
                args: specialize_exprs(ctx, bindings, args),
                ty: specialize_type(ctx, ty, bindings),
            }
        },
        core::Expr::TraitCall { trait_ref: reference, method_name, receiver, args, ty } => {
            let reference = specialize_trait_ref(ctx, reference, bindings);
            let receiver = specialize_expr(ctx, bindings, receiver);
            let args = specialize_exprs(ctx, bindings, args);
            let ty = specialize_type(ctx, ty, bindings);
            let reference = ensure_trait_call_instance(
                ctx,
                reference,
                method_name,
                receiver,
                args,
                ty,
            );
            core::Expr::TraitCall { trait_ref: reference, method_name, receiver, args, ty }
        },
        core::Expr::Proj { tuple, index, ty } => core::Expr::Proj {
            tuple: specialize_expr(ctx, bindings, tuple),
            index,
            ty: specialize_type(ctx, ty, bindings),
        },
    }
}

fn ensure_runtime_trait_impl(
    ctx: SpecializeCtx,
    trait_name: string,
    method_name: string,
    params: Vec[tast::Type],
    ret_ty: tast::Type,
) -> unit {
    let _ = ensure_trait_method_instance(
        ctx,
        tast::TraitRef {
            name: trait_name,
            args: Vec::new(),
        },
        method_name,
        params,
        ret_ty,
    );
}

fn ensure_eq_hash_impls(ctx: SpecializeCtx, ty: tast::Type) -> unit {
    ensure_runtime_trait_impl(
        ctx,
        "Eq",
        "eq",
        Vec::new().pushed(ty).pushed(ty),
        tast::Type::Bool,
    );
    ensure_runtime_trait_impl(
        ctx,
        "Hash",
        "hash",
        Vec::new().pushed(ty),
        tast::Type::Uint64,
    )
}

fn ensure_runtime_trait_impls_for_types(
    ctx: SpecializeCtx,
    values: Vec[tast::Type],
) -> unit {
    for value in values {
        ensure_runtime_trait_impls_for_type(ctx, value)
    }
}

fn ensure_runtime_trait_impls_for_type(
    ctx: SpecializeCtx,
    value: tast::Type,
) -> unit {
    match tast::resolve_type(value) {
        tast::Type::Tuple { items } => ensure_runtime_trait_impls_for_types(ctx, items),
        tast::Type::Projection { for_ty: base, name: _, trait_ref: reference } => {
            ensure_runtime_trait_impls_for_type(ctx, base);
            match reference {
                Option::Some(reference) => {
                    ensure_runtime_trait_impls_for_types(ctx, reference.args)
                },
                Option::None => (),
            }
        },
        tast::Type::App { ty: base, args } => {
            ensure_runtime_trait_impls_for_type(ctx, base);
            ensure_runtime_trait_impls_for_types(ctx, args)
        },
        tast::Type::Array { len: _, elem }
        | tast::Type::Slice { elem }
        | tast::Type::VecType { elem }
        | tast::Type::Channel { elem } => ensure_runtime_trait_impls_for_type(ctx, elem),
        tast::Type::RefType { elem } => {
            ensure_eq_hash_impls(ctx, elem);
            ensure_runtime_trait_impls_for_type(ctx, elem)
        },
        tast::Type::HashMap { key, value } => {
            ensure_eq_hash_impls(ctx, key);
            ensure_runtime_trait_impls_for_type(ctx, key);
            ensure_runtime_trait_impls_for_type(ctx, value)
        },
        tast::Type::Func { params, ret_ty } => {
            ensure_runtime_trait_impls_for_types(ctx, params);
            ensure_runtime_trait_impls_for_type(ctx, ret_ty)
        },
        _ => (),
    }
}

fn ensure_runtime_trait_impls_for_optional_expr(
    ctx: SpecializeCtx,
    value: Option[core::Expr],
) -> unit {
    match value {
        Option::Some(value) => ensure_runtime_trait_impls_for_expr(ctx, value),
        Option::None => (),
    }
}

fn ensure_runtime_trait_impls_for_exprs(
    ctx: SpecializeCtx,
    values: Vec[core::Expr],
) -> unit {
    for value in values {
        ensure_runtime_trait_impls_for_expr(ctx, value)
    }
}

fn ensure_runtime_trait_impls_for_block(
    ctx: SpecializeCtx,
    value: core::Block,
) -> unit {
    for stmt in value.stmts {
        ensure_runtime_trait_impls_for_type(ctx, stmt.ty);
        ensure_runtime_trait_impls_for_expr(ctx, stmt.value)
    };
    ensure_runtime_trait_impls_for_optional_expr(ctx, value.tail)
}

fn ensure_runtime_trait_impls_for_expr(
    ctx: SpecializeCtx,
    value: core::Expr,
) -> unit {
    ensure_runtime_trait_impls_for_type(ctx, core::expr_type(value));
    match value {
        core::Expr::Constr { constructor: _, args, ty: _ } => ensure_runtime_trait_impls_for_exprs(ctx, args),
        core::Expr::Tuple { items, ty: _ } | core::Expr::Array { items, ty: _ } => {
            ensure_runtime_trait_impls_for_exprs(ctx, items)
        },
        core::Expr::Closure { params, body, ty: _ } => {
            for param in params {
                ensure_runtime_trait_impls_for_type(ctx, param.ty)
            };
            ensure_runtime_trait_impls_for_expr(ctx, body)
        },
        core::Expr::Block { block, ty: _ } => ensure_runtime_trait_impls_for_block(ctx, block),
        core::Expr::Match { expr, arms, default, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, expr);
            for arm in arms {
                ensure_runtime_trait_impls_for_expr(ctx, arm.lhs);
                ensure_runtime_trait_impls_for_expr(ctx, arm.body)
            };
            ensure_runtime_trait_impls_for_optional_expr(ctx, default)
        },
        core::Expr::If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, cond);
            ensure_runtime_trait_impls_for_expr(ctx, then_);
            ensure_runtime_trait_impls_for_expr(ctx, else_)
        },
        core::Expr::While { cond, body, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, cond);
            ensure_runtime_trait_impls_for_expr(ctx, body)
        },
        core::Expr::Return { expr, ty: _ } => ensure_runtime_trait_impls_for_optional_expr(ctx, expr),
        core::Expr::Go { expr, ty: _ }
        | core::Expr::ConstrGet { expr, constructor: _, field_index: _, ty: _ }
        | core::Expr::Unary { op: _, expr, ty: _ }
        | core::Expr::Cast { expr, ty: _ }
        | core::Expr::Proj { tuple: expr, index: _, ty: _ } => ensure_runtime_trait_impls_for_expr(ctx, expr),
        core::Expr::Binary { op: _, lhs, rhs, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, lhs);
            ensure_runtime_trait_impls_for_expr(ctx, rhs)
        },
        core::Expr::Assign { name: _, value: expr, target_ty, ty: _ } => {
            ensure_runtime_trait_impls_for_type(ctx, target_ty);
            ensure_runtime_trait_impls_for_expr(ctx, expr)
        },
        core::Expr::Call { func, args, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, func);
            ensure_runtime_trait_impls_for_exprs(ctx, args)
        },
        core::Expr::ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            ensure_runtime_trait_impls_for_type(ctx, for_ty);
            ensure_runtime_trait_impls_for_expr(ctx, expr)
        },
        core::Expr::DynCall { trait_name: _, method_name: _, receiver, args, ty: _ }
        | core::Expr::TraitCall { trait_ref: _, method_name: _, receiver, args, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, receiver);
            ensure_runtime_trait_impls_for_exprs(ctx, args)
        },
        core::Expr::Var { name: _, ty: _ }
        | core::Expr::Callable { callable: _, ty: _ }
        | core::Expr::Prim { value: _, ty: _ }
        | core::Expr::Break { ty: _ }
        | core::Expr::Continue { ty: _ } => (),
    }
}

fn ensure_runtime_trait_impls(
    ctx: SpecializeCtx,
    functions: Vec[core::Function],
) -> unit {
    for function in functions {
        for param in function.params {
            ensure_runtime_trait_impls_for_type(ctx, param.1)
        };
        ensure_runtime_trait_impls_for_type(ctx, function.ret_ty);
        ensure_runtime_trait_impls_for_block(ctx, function.body)
    }
}

fn specialize_function(
    ctx: SpecializeCtx,
    instance: Instance,
    value: core::Function,
) -> core::Function {
    let params = Vec::new();
    for param in value.params {
        params.push((
            param.0,
            specialize_type(ctx, param.1, instance.bindings),
        ))
    };
    core::Function {
        name: instance.name,
        root: true,
        generics: Vec::new(),
        predicates: Vec::new(),
        trait_impl: match value.trait_impl {
            Option::Some(metadata) => Option::Some(core::TraitImpl {
                trait_ref: specialize_trait_ref(
                    ctx,
                    metadata.trait_ref,
                    instance.bindings,
                ),
                for_ty: specialize_type(ctx, metadata.for_ty, instance.bindings),
                associated_types: specialize_named_types(
                    ctx,
                    metadata.associated_types,
                    instance.bindings,
                ),
            }),
            Option::None => Option::None,
        },
        params,
        ret_ty: specialize_type(ctx, value.ret_ty, instance.bindings),
        body: specialize_block(ctx, instance.bindings, value.body),
    }
}

fn specialize(
    value: core::File,
    error: Ref[Option[string]],
) -> core::File {
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let function_index: HashMap[string, core::Function] = HashMap::new();
    let generic_inherent_index: HashMap[string, core::Function] = HashMap::new();
    let trait_function_index: HashMap[string, Vec[core::Function]] = HashMap::new();
    let trait_method_index: HashMap[string, Vec[core::Function]] = HashMap::new();
    let trait_method_names: HashMap[string, string] = HashMap::new();
    let used_names: HashMap[string, unit] = HashMap::new();
    for function in value.functions {
        function_index.set(function.name, function);
        used_names.set(function.name, ());
        if function_is_generic(function) {
            match inherent_method_key(function.name) {
                Option::Some(key) => generic_inherent_index.set(
                    lookup_pair_key(key.0, key.1),
                    function,
                ),
                Option::None => (),
            }
        } else {
            ()
        };
        match function.trait_impl {
            Option::Some(metadata) => {
                add_indexed_function(
                    trait_function_index,
                    metadata.trait_ref.name,
                    function,
                );
                match trait_impl_method_name(function.name) {
                    Option::Some(method_name) => {
                        trait_method_names.set(function.name, method_name);
                        add_indexed_function(
                            trait_method_index,
                            lookup_pair_key(metadata.trait_ref.name, method_name),
                            function,
                        )
                    },
                    Option::None => (),
                }
            },
            Option::None => (),
        }
    };
    let ctx = SpecializeCtx {
        functions: value.functions,
        function_index,
        generic_inherent_index,
        trait_function_index,
        trait_method_index,
        trait_method_names,
        instances: Vec::new(),
        instance_index: HashMap::new(),
        work: Vec::new(),
        used_names,
        active: Ref::new(Option::None),
        error,
    };
    for function in ctx.functions {
        if function.root && !function_is_generic(function) {
            ensure_instance(ctx, function.name, Vec::new());
            ()
        } else {
            ()
        }
    };
    let output = Vec::new();
    let index = Ref::new(0);
    let complete = Ref::new(false);
    while complete.get() == false {
        while index.get() < ctx.work.len() {
            let instance = ctx.work.get(index.get());
            index.set(index.get() + 1);
            match find_function(ctx, instance.original_name) {
                Option::Some(function) => {
                    ctx.active.set(Option::Some(instance));
                    output.push(specialize_function(ctx, instance, function));
                    ctx.active.set(Option::None)
                },
                Option::None => (),
            }
        };
        let previous_len = ctx.work.len();
        ensure_runtime_trait_impls(ctx, output);
        complete.set(ctx.work.len() == previous_len)
    };
    core::File { functions: output, enums, structs, type_instances }
}
