package anf;

use gomlang::parser::ast;
use gomlang::parser::core;
use gomlang::parser::hir;
use gomlang::parser::lift;
use gomlang::parser::mono;
use gomlang::parser::parser;
use gomlang::parser::tast;
use std::testing;

fn lower_source(source: string) -> File {
    lower(lift::lower(mono::lower(core::lower(tast::check(hir::lower(
        ast::lower(parser::parse(source)),
        "main.gom",
    ))))))
}

#[test]
fn lowers_linear_values_and_return_join() -> unit {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  join ret7() -> unit {\n    ()\n  } in\n  let mtmp0 = () in\n  let t8 = (true, false) in\n  let a/0 = (true, false, t8) in\n  let x1 = a/0.0 in\n  let x2 = a/0.1 in\n  let x3 = a/0.2 in\n  let x4 = x3.0 in\n  let x5 = x3.1 in\n  let w/4 = x5 in\n  let z/3 = x4 in\n  let y/2 = x2 in\n  let x/1 = x1 in\n  let b/5 = w/4 in\n  let mtmp6 = print(b/5) in\n  jump ret7()\n}",
    )
}

#[test]
fn lowers_if_expressions_through_join_points() -> unit {
    let source = "fn choose(flag: bool, x: int32, y: int32) -> int32 { if flag { x } else { y } } fn main() { let yes = choose(true, 10, 99); let no = choose(false, 10, 99); let _ = println(\"yes=\" + yes.to_string()); let _ = println(\"no=\" + no.to_string()); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn choose(flag/0: bool, x/1: int32, y/2: int32) -> int32 {\n  join ret2(retv3: int32) -> int32 {\n    retv3\n  } in\n  join k4(jp5: int32) -> int32 {\n    jump ret2(jp5)\n  } in\n  if flag/0 {\n    jump k4(x/1)\n  } else {\n    jump k4(y/2)\n  }\n}\n\nfn main() -> unit {\n  join ret6() -> unit {\n    ()\n  } in\n  let yes/3 = choose(true, 10, 99) in\n  let no/4 = choose(false, 10, 99) in\n  let t7 = inherent#int32#int32#to_string(yes/3) in\n  let t8 = (\"yes=\" + t7) in\n  let mtmp0 = println(t8) in\n  let t9 = inherent#int32#int32#to_string(no/4) in\n  let t10 = (\"no=\" + t9) in\n  let mtmp1 = println(t10) in\n  jump ret6()\n}",
    )
}

#[test]
fn lowers_enum_matches_with_tags() -> unit {
    let source = "enum T { A, B(bool, unit) } fn main() { let t = B(true, ()); match t { A => println((1).to_string()), B(true, ()) => println((2).to_string()), B(false, ()) => println((3).to_string()), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  join ret2() -> unit {\n    ()\n  } in\n  let t/0 = T::B(true, ()) in\n  join k3() -> unit {\n    jump ret2()\n  } in\n  match t/0 {\n    Tag_0 => {\n      let t4 = inherent#int32#int32#to_string(1) in\n      let t5 = println(t4) in\n      jump k3()\n    },\n    Tag_1 => {\n      let x0 = T::B._0(t/0) in\n      let x1 = T::B._1(t/0) in\n      join k6() -> unit {\n        jump k3()\n      } in\n      match x1 {\n        () => {\n          join k7() -> unit {\n            jump k6()\n          } in\n          match x0 {\n            true => {\n              let t8 = inherent#int32#int32#to_string(2) in\n              let t9 = println(t8) in\n              jump k7()\n            },\n            false => {\n              let t10 = inherent#int32#int32#to_string(3) in\n              let t11 = println(t10) in\n              jump k7()\n            },\n          }\n        },\n      }\n    },\n  }\n}",
    )
}

#[test]
fn lowers_while_loops_through_recursive_joins() -> unit {
    let source = "fn main() { let i = Ref::new(0i32); while i.get() < 10i32 { if i.get() == 5i32 { break } else { () }; let _ = println(i.get()); i.set(i.get() + 1i32); }; let _ = println(\"done\"); }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  join ret5() -> unit {\n    ()\n  } in\n  let i/0 = inherent#Ref#Ref[int32]#new(0) in\n  join exit6() -> unit {\n    let _wild3 = () in\n    let mtmp4 = println(\"done\") in\n    jump ret5()\n  } in\n  joinrec {\n    join loop7() -> unit {\n      let t8 = inherent#Ref#Ref[int32]#get(i/0) in\n      let t9 = (t8 < 10) in\n      if t9 {\n        let t14 = inherent#Ref#Ref[int32]#get(i/0) in\n        let t15 = (t14 == 5) in\n        join k10() -> unit {\n          let _wild0 = () in\n          let t11 = inherent#Ref#Ref[int32]#get(i/0) in\n          let mtmp1 = println(t11) in\n          let t12 = inherent#Ref#Ref[int32]#get(i/0) in\n          let t13 = (t12 + 1) in\n          let _wild2 = inherent#Ref#Ref[int32]#set(i/0, t13) in\n          jump loop7()\n        } in\n        if t15 {\n          jump exit6()\n        } else {\n          jump k10()\n        }\n      } else {\n        jump exit6()\n      }\n    } in\n  } in\n  jump loop7()\n}",
    )
}
