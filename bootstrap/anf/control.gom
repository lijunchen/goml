package anf;

use gomlang::parser::core;
use gomlang::parser::tast;

fn reify_k(
    state: State,
    value_ty: tast::Type,
    k: (Imm) -> Block,
) -> (JoinBind, tast::Type) {
    let name = fresh(state, "k");
    if type_is_unit(value_ty) {
        let body = k(unit_imm());
        let ret_ty = block_type(body);
        (JoinBind {
            name,
            params: Vec::new(),
            ret_ty,
            body,
        }, ret_ty)
    } else {
        let param = fresh(state, "jp");
        let body = k(Imm::Var(param, value_ty));
        let ret_ty = block_type(body);
        let params = Vec::new();
        params.push((param, value_ty));
        (JoinBind {
            name,
            params,
            ret_ty,
            body,
        }, ret_ty)
    }
}

fn reify_k_for_expr(
    state: State,
    value: core::Expr,
    k: (Imm) -> Block,
) -> (JoinBind, tast::Type) {
    let value_ty = if type_is_error(core::expr_type(value))
        && expr_always_exits(value) {
        tast::Type::Unit
    } else {
        core::expr_type(value)
    };
    if type_is_unit(value_ty) && expr_always_exits(value) {
        let name = fresh(state, "k");
        let ret_ty = block_type(k(unit_imm()));
        (JoinBind {
            name,
            params: Vec::new(),
            ret_ty,
            body: Block {
                binds: no_binds(),
                term: Term::Unreachable(ret_ty),
            },
        }, ret_ty)
    } else {
        reify_k(state, value_ty, k)
    }
}

fn lower_core_stmts(
    state: State,
    stmts: Vec[core::LetStmt],
    index: int32,
    tail: Option[core::Expr],
    k: (Imm) -> Block,
) -> Block {
    if index >= stmts.len() {
        match tail {
            Option::Some(value) => lower_expr(state, value, k),
            Option::None => k(unit_imm()),
        }
    } else {
        let stmt = stmts.get(index);
        let value_ty = core::expr_type(stmt.value);
        if expr_is_control(stmt.value) {
            lower_expr(state, stmt.value, |value| {
                let block = lower_core_stmts(
                    state,
                    stmts,
                    index + 1,
                    tail,
                    k,
                );
                prepend_bind(Bind::Let(LetBind {
                    name: stmt.name,
                    value: Value::Imm(value),
                    ty: value_ty,
                }), block)
            })
        } else {
            lower_value(state, stmt.value, |value| {
                let ty = value_type(value);
                let block = lower_core_stmts(
                    state,
                    stmts,
                    index + 1,
                    tail,
                    k,
                );
                prepend_bind(Bind::Let(LetBind {
                    name: stmt.name,
                    value,
                    ty,
                }), block)
            })
        }
    }
}

fn lower_core_block(
    state: State,
    value: core::Block,
    k: (Imm) -> Block,
) -> Block {
    lower_core_stmts(state, value.stmts, 0, value.tail, k)
}

fn lower_branch(
    state: State,
    value: core::Expr,
    join_id: string,
    join_ret_ty: tast::Type,
    join_takes_arg: bool,
) -> Block {
    lower_expr(state, value, |value| {
        jump_block(join_id, value, join_takes_arg, join_ret_ty)
    })
}

fn lower_if(
    state: State,
    cond: core::Expr,
    then_: core::Expr,
    else_: core::Expr,
    ty: tast::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = core::Expr::If(cond, then_, else_, ty);
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_id = join.name;
    let takes_arg = join.params.len() > 0;
    lower_expr(state, cond, |cond| {
        let then_block = lower_branch(
            state,
            then_,
            join_id,
            ret_ty,
            takes_arg,
        );
        let else_block = lower_branch(
            state,
            else_,
            join_id,
            ret_ty,
            takes_arg,
        );
        Block {
            binds: one_bind(Bind::Join(join)),
            term: Term::If(cond, then_block, else_block, ret_ty),
        }
    })
}

fn lower_arms(
    state: State,
    values: Vec[core::Arm],
    join_id: string,
    join_ret_ty: tast::Type,
    join_takes_arg: bool,
) -> Vec[Arm] {
    let result = Vec::new();
    for value in values {
        result.push(Arm {
            lhs: match_imm(value.lhs),
            body: lower_branch(
                state,
                value.body,
                join_id,
                join_ret_ty,
                join_takes_arg,
            ),
        })
    };
    result
}

fn lower_match(
    state: State,
    scrutinee: core::Expr,
    arms: Vec[core::Arm],
    default: Option[core::Expr],
    ty: tast::Type,
    k: (Imm) -> Block,
) -> Block {
    let expr = core::Expr::Match(scrutinee, arms, default, ty);
    let reified = reify_k_for_expr(state, expr, k);
    let join = reified.0;
    let ret_ty = reified.1;
    let join_id = join.name;
    let takes_arg = join.params.len() > 0;
    lower_expr(state, scrutinee, |scrutinee| {
        let lowered_arms = lower_arms(
            state,
            arms,
            join_id,
            ret_ty,
            takes_arg,
        );
        let lowered_default = match default {
            Option::Some(value) => Option::Some(lower_branch(
                state,
                value,
                join_id,
                ret_ty,
                takes_arg,
            )),
            Option::None => Option::None,
        };
        Block {
            binds: one_bind(Bind::Join(join)),
            term: Term::Match(scrutinee, lowered_arms, lowered_default, ret_ty),
        }
    })
}

fn lower_while(
    state: State,
    cond: core::Expr,
    body: core::Expr,
    k: (Imm) -> Block,
) -> Block {
    let exit_id = fresh(state, "exit");
    let exit_body = k(unit_imm());
    let exit_ret_ty = block_type(exit_body);
    let exit = JoinBind {
        name: exit_id,
        params: Vec::new(),
        ret_ty: exit_ret_ty,
        body: exit_body,
    };
    let loop_id = fresh(state, "loop");
    let previous = state.loop_ctx.get();
    state.loop_ctx.set(Option::Some(LoopCtx {
        loop_id,
        exit_id,
        exit_ret_ty,
    }));
    let loop_body = lower_expr(state, cond, |cond| {
        let then_block = lower_expr(state, body, |_| {
            Block {
                binds: no_binds(),
                term: Term::Jump(loop_id, no_imms(), exit_ret_ty),
            }
        });
        let else_block = Block {
            binds: no_binds(),
            term: Term::Jump(exit_id, no_imms(), exit_ret_ty),
        };
        Block {
            binds: no_binds(),
            term: Term::If(cond, then_block, else_block, exit_ret_ty),
        }
    });
    state.loop_ctx.set(previous);
    let recursive = Vec::new();
    recursive.push(JoinBind {
        name: loop_id,
        params: Vec::new(),
        ret_ty: exit_ret_ty,
        body: loop_body,
    });
    let binds = Vec::new();
    binds.push(Bind::Join(exit));
    binds.push(Bind::JoinRec(recursive));
    Block {
        binds,
        term: Term::Jump(loop_id, no_imms(), exit_ret_ty),
    }
}

fn lower_return(
    state: State,
    value: Option[core::Expr],
) -> Block {
    match state.return_ctx.get() {
        Option::Some(ctx) => match value {
            Option::Some(value) => lower_expr(state, value, |value| {
                jump_block(ctx.join_id, value, ctx.takes_arg, ctx.ret_ty)
            }),
            Option::None => Block {
                binds: no_binds(),
                term: Term::Jump(ctx.join_id, no_imms(), ctx.ret_ty),
            },
        },
        Option::None => Block {
            binds: no_binds(),
            term: Term::Unreachable(tast::Type::Error),
        },
    }
}

fn lower_expr(
    state: State,
    value: core::Expr,
    k: (Imm) -> Block,
) -> Block {
    match try_imm(value) {
        Option::Some(value) => k(value),
        Option::None => match value {
            core::Expr::Block(block, _) => lower_core_block(state, block, k),
            core::Expr::If(cond, then_, else_, ty) => {
                lower_if(state, cond, then_, else_, ty, k)
            },
            core::Expr::Match(scrutinee, arms, default, ty) => {
                lower_match(state, scrutinee, arms, default, ty, k)
            },
            core::Expr::While(cond, body, _) => lower_while(state, cond, body, k),
            core::Expr::Break(_) => match state.loop_ctx.get() {
                Option::Some(ctx) => Block {
                    binds: no_binds(),
                    term: Term::Jump(ctx.exit_id, no_imms(), ctx.exit_ret_ty),
                },
                Option::None => Block {
                    binds: no_binds(),
                    term: Term::Unreachable(tast::Type::Error),
                },
            },
            core::Expr::Continue(_) => match state.loop_ctx.get() {
                Option::Some(ctx) => Block {
                    binds: no_binds(),
                    term: Term::Jump(ctx.loop_id, no_imms(), ctx.exit_ret_ty),
                },
                Option::None => Block {
                    binds: no_binds(),
                    term: Term::Unreachable(tast::Type::Error),
                },
            },
            core::Expr::Return(value, _) => lower_return(state, value),
            core::Expr::Closure(_, _, _) | core::Expr::TraitCall(_, _, _, _, _) => {
                k(unit_imm())
            },
            other => lower_imm(state, other, k),
        },
    }
}
