package anf;

use gomlc::ast;
use gomlc::core;

fn all_immediate(values: Vec[core::Expr]) -> bool {
    let result = Ref::new(true);
    for value in values {
        match try_imm(value) {
            Option::Some(_) => (),
            Option::None => result.set(false),
        }
    };
    result.get()
}

fn probe_linear_list(state: State, values: Vec[core::Expr]) -> bool {
    let result = Ref::new(true);
    let active = Ref::new(true);
    for value in values {
        if active.get() {
            if probe_linear_expr(state, value) {
                ()
            } else {
                result.set(false);
                active.set(false)
            }
        } else {
            ()
        }
    };
    result.get()
}

fn probe_bound_value(state: State) -> bool {
    let _ = fresh(state, "t");
    true
}

fn probe_linear_expr(state: State, value: core::Expr) -> bool {
    match try_imm(value) {
        Option::Some(_) => true,
        Option::None => match value {
            core::Expr::ConstrGet(expr, _, _, _)
            | core::Expr::Unary(_, expr, _)
            | core::Expr::Cast(expr, _)
            | core::Expr::ToDyn(_, _, expr, _)
            | core::Expr::Go(expr, _)
            | core::Expr::Proj(expr, _, _) => {
                probe_linear_expr(state, expr) && probe_bound_value(state)
            },
            core::Expr::Binary(op, lhs, rhs, _) => match op {
                ast::BinaryOp::And | ast::BinaryOp::Or => false,
                _ => probe_linear_expr(state, lhs)
                    && probe_linear_expr(state, rhs)
                    && probe_bound_value(state),
            },
            core::Expr::Assign(_, expr, _, _) => {
                probe_linear_expr(state, expr) && probe_bound_value(state)
            },
            core::Expr::Constr(_, args, _)
            | core::Expr::Tuple(args, _)
            | core::Expr::Array(args, _) => {
                probe_linear_list(state, args) && probe_bound_value(state)
            },
            core::Expr::Call(func, args, _) => probe_linear_expr(state, func)
                && probe_linear_list(state, args)
                && probe_bound_value(state),
            core::Expr::DynCall(_, _, receiver, args, _)
            | core::Expr::TraitCall(_, _, receiver, args, _) => {
                probe_linear_expr(state, receiver)
                    && probe_linear_list(state, args)
                    && probe_bound_value(state)
            },
            _ => false,
        },
    }
}
