package anf;

use gomlc::core;

fn try_imm(value: core::Expr) -> Option[Imm] {
    match value {
        core::Expr::Var(name, ty) => Option::Some(Imm::Var { name, ty }),
        core::Expr::Callable(callable, ty) => {
            Option::Some(Imm::Callable { callable, ty })
        },
        core::Expr::Prim(value, ty) => Option::Some(Imm::Prim { value, ty }),
        core::Expr::Constr(constructor, args, ty) => if args.len() == 0 {
            match constructor.tag {
                Option::Some(tag) => Option::Some(Imm::Tag { index: tag, ty }),
                Option::None => Option::None,
            }
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn match_imm(value: core::Expr) -> Imm {
    match value {
        core::Expr::Constr(constructor, _, ty) => match constructor.tag {
            Option::Some(tag) => Imm::Tag { index: tag, ty },
            Option::None => unit_imm(),
        },
        other => match try_imm(other) {
            Option::Some(value) => value,
            Option::None => unit_imm(),
        },
    }
}

fn bind_value(
    state: State,
    value: Value,
    k: (Imm) -> Block,
) -> Block {
    let ty = value_type(value);
    let name = fresh(state, "t");
    let block = k(Imm::Var { name, ty });
    prepend_bind(Bind::Let(LetBind {
        name,
        value,
        ty,
    }), block)
}

fn lower_imm(
    state: State,
    value: core::Expr,
    k: (Imm) -> Block,
) -> Block {
    match try_imm(value) {
        Option::Some(value) => k(value),
        Option::None => lower_value(state, value, |value| {
            bind_value(state, value, k)
        }),
    }
}

fn lower_list_from(
    state: State,
    values: Vec[core::Expr],
    index: int,
    result: Vec[Imm],
    k: (Vec[Imm]) -> Block,
) -> Block {
    if index >= values.len() {
        k(result)
    } else {
        lower_expr(state, values.get(index), |value| {
            result.push(value);
            lower_list_from(state, values, index + 1, result, k)
        })
    }
}

fn lower_list(
    state: State,
    values: Vec[core::Expr],
    k: (Vec[Imm]) -> Block,
) -> Block {
    if all_immediate(values) {
        ()
    } else {
        let start = state.counter.get();
        if probe_linear_list(state, values) {
            state.counter.set(start)
        } else {
            ()
        }
    };
    lower_list_from(state, values, 0, Vec::new(), k)
}

fn lower_value(
    state: State,
    value: core::Expr,
    k: (Value) -> Block,
) -> Block {
    let ty = core::expr_type(value);
    match try_imm(value) {
        Option::Some(value) => k(Value::Imm(value)),
        Option::None => match value {
            core::Expr::Constr(constructor, args, _) => {
                lower_list(state, args, |args| {
                    k(Value::Constr { constructor, args, ty })
                })
            },
            core::Expr::Tuple(items, _) => lower_list(state, items, |items| {
                k(Value::Tuple { items, ty })
            }),
            core::Expr::Array(items, _) => lower_list(state, items, |items| {
                k(Value::Array { items, ty })
            }),
            core::Expr::ConstrGet(expr, constructor, index, _) => {
                lower_expr(state, expr, |expr| {
                    k(Value::ConstrGet { expr, constructor, field_index: index, ty })
                })
            },
            core::Expr::Unary(op, expr, _) => lower_expr(state, expr, |expr| {
                k(Value::Unary { op, expr, ty })
            }),
            core::Expr::Cast(expr, _) => lower_expr(state, expr, |expr| {
                k(Value::Cast { expr, ty })
            }),
            core::Expr::Binary(op, lhs, rhs, _) => lower_expr(state, lhs, |lhs| {
                lower_expr(state, rhs, |rhs| {
                    k(Value::Binary { op, lhs, rhs, ty })
                })
            }),
            core::Expr::Assign(name, expr, target_ty, _) => {
                lower_expr(state, expr, |expr| {
                    k(Value::Assign { name, value: expr, target_ty, ty })
                })
            },
            core::Expr::Call(func, args, _) => lower_expr(state, func, |func| {
                lower_list(state, args, |args| {
                    k(Value::Call { func, args, ty })
                })
            }),
            core::Expr::ToDyn(trait_name, for_ty, expr, _) => {
                lower_expr(state, expr, |expr| {
                    k(Value::ToDyn { trait_name, for_ty, expr, ty })
                })
            },
            core::Expr::DynCall(trait_name, method_name, receiver, args, _) => {
                lower_expr(state, receiver, |receiver| {
                    lower_list(state, args, |args| {
                        k(Value::DynCall {
                            trait_name,
                            method_name,
                            receiver,
                            args,
                            ty,
                        })
                    })
                })
            },
            core::Expr::Go(expr, _) => lower_expr(state, expr, |expr| {
                k(Value::Go { closure: expr, ty })
            }),
            core::Expr::Proj(expr, index, _) => lower_expr(state, expr, |expr| {
                k(Value::Proj { tuple: expr, index, ty })
            }),
            other => lower_expr(state, other, |value| k(Value::Imm(value))),
        },
    }
}
