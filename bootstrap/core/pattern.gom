package core;

use gomlang::parser::tast;
use std::text;

struct PatternBinding {
    name: string,
    source: string,
    ty: tast::Type,
}

struct PatternPlan {
    projections: Vec[LetStmt],
    bindings: Vec[PatternBinding],
}

struct PatternColumn {
    source: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
}

struct PatternRow {
    columns: Vec[PatternColumn],
    bindings: Vec[PatternBinding],
    body: tast::Expr,
}

struct PatternEnumCase {
    constructor: tast::Constructor,
    variables: Vec[(string, tast::Type)],
    rows: Vec[PatternRow],
}

struct PrimitivePatternCase {
    key: string,
    value: tast::Primitive,
    ty: tast::Type,
}

fn flat_pattern_items(items: Vec[tast::Pat]) -> bool {
    let valid = Ref::new(true);
    for item in items {
        match item {
            tast::Pat::Var(_, _) | tast::Pat::Wild(_) => (),
            _ => valid.set(false),
        }
    };
    valid.get()
}

fn plan_flat_pattern(
    ctx: Lowerer,
    source: string,
    pattern: tast::Pat,
) -> Option[PatternPlan] {
    match pattern {
        tast::Pat::Tuple(items, tuple_ty) => match tast::resolve_type(tuple_ty) {
            tast::Type::Tuple(types) => if items.len() == types.len() && flat_pattern_items(items) {
                let names: Vec[string] = Vec::new();
                for _ in types {
                    names.push(gensym(ctx, "x"))
                };
                let projections: Vec[LetStmt] = Vec::new();
                let bindings: Vec[PatternBinding] = Vec::new();
                for index in range(0, items.len()) {
                    let item_ty = types.get(index);
                    let projection_name = names.get(index);
                    projections.push(LetStmt {
                        name: projection_name,
                        value: Expr::Proj(
                            Expr::Var(source, tuple_ty),
                            index,
                            item_ty,
                        ),
                        ty: item_ty,
                    });
                    match items.get(index) {
                        tast::Pat::Var(name, ty) => bindings.push(PatternBinding {
                            name,
                            source: projection_name,
                            ty,
                        }),
                        tast::Pat::Wild(_) => (),
                        _ => (),
                    }
                };
                Option::Some(PatternPlan {
                    projections,
                    bindings,
                })
            } else {
                Option::None
            },
            _ => Option::None,
        },
        tast::Pat::Constr(constructor, items, struct_ty) => if constructor.is_struct && flat_pattern_items(items) {
            let names: Vec[string] = Vec::new();
            for _ in items {
                names.push(gensym(ctx, "x"))
            };
            let projections: Vec[LetStmt] = Vec::new();
            let bindings: Vec[PatternBinding] = Vec::new();
            for index in range(0, items.len()) {
                let item = items.get(index);
                let item_ty = tast::pat_type(item);
                let projection_name = names.get(index);
                projections.push(LetStmt {
                    name: projection_name,
                    value: Expr::ConstrGet(
                        Expr::Var(source, struct_ty),
                        constructor,
                        index,
                        item_ty,
                    ),
                    ty: item_ty,
                });
                match item {
                    tast::Pat::Var(name, ty) => bindings.push(PatternBinding {
                        name,
                        source: projection_name,
                        ty,
                    }),
                    tast::Pat::Wild(_) => (),
                    _ => (),
                }
            };
            Option::Some(PatternPlan {
                projections,
                bindings,
            })
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn apply_pattern_plan(
    plan: PatternPlan,
    body: Expr,
    body_ty: tast::Type,
) -> Expr {
    let result = Ref::new(body);
    for binding in plan.bindings {
        let stmts: Vec[LetStmt] = Vec::new();
        stmts.push(LetStmt {
            name: binding.name,
            value: Expr::Var(binding.source, binding.ty),
            ty: binding.ty,
        });
        result.set(Expr::Block(
            Block {
                stmts,
                tail: Option::Some(result.get()),
            },
            body_ty,
        ))
    };
    Expr::Block(
        Block {
            stmts: plan.projections,
            tail: Option::Some(result.get()),
        },
        body_ty,
    )
}

fn normalize_pattern_rows(rows: Vec[PatternRow]) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        let columns: Vec[PatternColumn] = Vec::new();
        let bindings: Vec[PatternBinding] = Vec::new();
        for binding in row.bindings {
            bindings.push(binding)
        };
        for column in row.columns {
            match column.pattern {
                tast::Pat::Var(name, ty) => bindings.push(PatternBinding {
                    name,
                    source: column.source,
                    ty,
                }),
                tast::Pat::Wild(_) => (),
                _ => columns.push(column),
            }
        };
        result.push(PatternRow {
            columns,
            bindings,
            body: row.body,
        })
    };
    result
}

fn expand_or_pattern_rows(rows: Vec[PatternRow], source: string) -> Option[Vec[PatternRow]] {
    let result: Vec[PatternRow] = Vec::new();
    let changed = Ref::new(false);
    for row in rows {
        let expanded = Ref::new(false);
        for index in range(0, row.columns.len()) {
            let column = row.columns.get(index);
            if !(expanded.get()) && column.source == source {
                match column.pattern {
                    tast::Pat::Or(patterns, _) => {
                        changed.set(true);
                        expanded.set(true);
                        for pattern in patterns {
                            let columns: Vec[PatternColumn] = Vec::new();
                            for column_index in range(0, row.columns.len()) {
                                let value = row.columns.get(column_index);
                                if column_index == index {
                                    columns.push(PatternColumn {
                                        source: value.source,
                                        source_ty: value.source_ty,
                                        pattern,
                                    })
                                } else {
                                    columns.push(value)
                                }
                            };
                            result.push(PatternRow {
                                columns,
                                bindings: row.bindings,
                                body: row.body,
                            })
                        }
                    },
                    _ => (),
                }
            } else {
                ()
            }
        };
        if !(expanded.get()) {
            result.push(row)
        } else {
            ()
        }
    };
    if changed.get() {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn pattern_source_count(rows: Vec[PatternRow], source: string) -> int32 {
    let count = Ref::new(0);
    for row in rows {
        for column in row.columns {
            if column.source == source {
                count.set(count.get() + 1)
            } else {
                ()
            }
        }
    };
    count.get()
}

fn branch_pattern_column(rows: Vec[PatternRow]) -> Option[PatternColumn] {
    if rows.len() == 0 || rows.get(0).columns.len() == 0 {
        Option::None
    } else {
        let selected: Ref[Option[PatternColumn]] = Ref::new(Option::None);
        let best = Ref::new(-1);
        for column in rows.get(0).columns {
            let count = pattern_source_count(rows, column.source);
            if count >= best.get() {
                best.set(count);
                selected.set(Option::Some(column))
            } else {
                ()
            }
        };
        selected.get()
    }
}

fn lower_pattern_row_body(ctx: Lowerer, row: PatternRow, ty: tast::Type) -> Expr {
    let result = Ref::new(lower_expr(ctx, row.body));
    for binding in row.bindings {
        let stmts: Vec[LetStmt] = Vec::new();
        stmts.push(LetStmt {
            name: binding.name,
            value: Expr::Var(binding.source, binding.ty),
            ty: binding.ty,
        });
        result.set(Expr::Block(
            Block {
                stmts,
                tail: Option::Some(result.get()),
            },
            ty,
        ))
    };
    result.get()
}

fn bool_pattern_row(
    row: PatternRow,
    source: string,
    expected: bool,
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    let matches = Ref::new(true);
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                tast::Pat::Prim(tast::Primitive::Bool(value), _) => if value == expected {
                    ()
                } else {
                    matches.set(false)
                },
                _ => matches.set(false),
            }
        } else {
            columns.push(column)
        }
    };
    if matches.get() {
        Option::Some(PatternRow {
            columns,
            bindings: row.bindings,
            body: row.body,
        })
    } else {
        Option::None
    }
}

fn bool_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    expected: bool,
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match bool_pattern_row(row, source, expected) {
            Option::Some(value) => result.push(value),
            Option::None => (),
        }
    };
    result
}

fn tuple_pattern_row(
    row: PatternRow,
    source: string,
    names: Vec[string],
    types: Vec[tast::Type],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    let valid = Ref::new(true);
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                tast::Pat::Tuple(items, _) => if items.len() == names.len() {
                    for index in range(0, items.len()) {
                        columns.push(PatternColumn {
                            source: names.get(index),
                            source_ty: types.get(index),
                            pattern: items.get(index),
                        })
                    }
                } else {
                    valid.set(false)
                },
                _ => valid.set(false),
            }
        } else {
            columns.push(column)
        }
    };
    if valid.get() {
        Option::Some(PatternRow {
            columns,
            bindings: row.bindings,
            body: row.body,
        })
    } else {
        Option::None
    }
}

fn tuple_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    names: Vec[string],
    types: Vec[tast::Type],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match tuple_pattern_row(row, source, names, types) {
            Option::Some(value) => result.push(value),
            Option::None => (),
        }
    };
    result
}

fn lower_tuple_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    types: Vec[tast::Type],
    ty: tast::Type,
) -> Expr {
    let names: Vec[string] = Vec::new();
    for _ in types {
        names.push(gensym(ctx, "x"))
    };
    let inner = lower_pattern_rows(
        ctx,
        tuple_pattern_rows(rows, column.source, names, types),
        ty,
    );
    let stmts: Vec[LetStmt] = Vec::new();
    for index in range(0, types.len()) {
        stmts.push(LetStmt {
            name: names.get(index),
            value: Expr::Proj(
                Expr::Var(column.source, column.source_ty),
                index,
                types.get(index),
            ),
            ty: types.get(index),
        })
    };
    Expr::Block(
        Block {
            stmts,
            tail: Option::Some(inner),
        },
        ty,
    )
}

fn struct_pattern_row(
    row: PatternRow,
    source: string,
    names: Vec[string],
    fields: Vec[(string, tast::Type)],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    let valid = Ref::new(true);
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                tast::Pat::Constr(constructor, patterns, _) => {
                    if constructor.is_struct && patterns.len() == names.len() {
                        for index in range(0, patterns.len()) {
                            columns.push(PatternColumn {
                                source: names.get(index),
                                source_ty: fields.get(index).1,
                                pattern: patterns.get(index),
                            })
                        }
                    } else {
                        valid.set(false)
                    }
                },
                _ => valid.set(false),
            }
        } else {
            columns.push(column)
        }
    };
    if valid.get() {
        Option::Some(PatternRow {
            columns,
            bindings: row.bindings,
            body: row.body,
        })
    } else {
        Option::None
    }
}

fn struct_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    names: Vec[string],
    fields: Vec[(string, tast::Type)],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match struct_pattern_row(row, source, names, fields) {
            Option::Some(value) => result.push(value),
            Option::None => (),
        }
    };
    result
}

fn lower_struct_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    constructor: tast::Constructor,
    fields: Vec[(string, tast::Type)],
    ty: tast::Type,
) -> Expr {
    let names: Vec[string] = Vec::new();
    for _ in fields {
        names.push(gensym(ctx, "x"))
    };
    let inner = lower_pattern_rows(
        ctx,
        struct_pattern_rows(rows, column.source, names, fields),
        ty,
    );
    let stmts: Vec[LetStmt] = Vec::new();
    for index in range(0, fields.len()) {
        stmts.push(LetStmt {
            name: names.get(index),
            value: Expr::ConstrGet(
                Expr::Var(column.source, column.source_ty),
                constructor,
                index,
                fields.get(index).1,
            ),
            ty: fields.get(index).1,
        })
    };
    Expr::Block(
        Block {
            stmts,
            tail: Option::Some(inner),
        },
        ty,
    )
}

fn enum_pattern_row(
    row: PatternRow,
    source: string,
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    let valid = Ref::new(true);
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                tast::Pat::Constr(constructor, patterns, _) => {
                    if constructor.name == constructor_name && patterns.len() == variables.len() {
                        for index in range(0, patterns.len()) {
                            let variable = variables.get(index);
                            columns.push(PatternColumn {
                                source: variable.0,
                                source_ty: variable.1,
                                pattern: patterns.get(index),
                            })
                        }
                    } else {
                        valid.set(false)
                    }
                },
                _ => valid.set(false),
            }
        } else {
            columns.push(column)
        }
    };
    if valid.get() {
        Option::Some(PatternRow {
            columns,
            bindings: row.bindings,
            body: row.body,
        })
    } else {
        Option::None
    }
}

fn enum_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match enum_pattern_row(row, source, constructor_name, variables) {
            Option::Some(value) => result.push(value),
            Option::None => (),
        }
    };
    result
}

fn lower_enum_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    definition: tast::EnumDef,
    type_args: Vec[tast::Type],
    ty: tast::Type,
) -> Expr {
    let cases: Vec[PatternEnumCase] = Vec::new();
    for variant_index in range(0, definition.variants.len()) {
        let variant = definition.variants.get(variant_index);
        let constructor_name = definition.name + "::" + variant.name;
        let variables: Vec[(string, tast::Type)] = Vec::new();
        for field in variant.fields {
            variables.push((
                gensym(ctx, "x"),
                tast::substitute_params(field, definition.generics, type_args),
            ))
        };
        cases.push(PatternEnumCase {
            constructor: tast::Constructor {
                name: constructor_name,
                fields: Vec::new(),
                is_struct: false,
                tag: Option::Some(variant_index),
            },
            variables,
            rows: enum_pattern_rows(
                rows,
                column.source,
                constructor_name,
                variables,
            ),
        })
    };
    let arms: Vec[Arm] = Vec::new();
    for case in cases {
        let args: Vec[Expr] = Vec::new();
        let stmts: Vec[LetStmt] = Vec::new();
        for index in range(0, case.variables.len()) {
            let variable = case.variables.get(index);
            args.push(Expr::Var(variable.0, variable.1));
            stmts.push(LetStmt {
                name: variable.0,
                value: Expr::ConstrGet(
                    Expr::Var(column.source, column.source_ty),
                    case.constructor,
                    index,
                    variable.1,
                ),
                ty: variable.1,
            })
        };
        let inner = lower_pattern_rows(ctx, case.rows, ty);
        let body = if stmts.len() == 0 {
            inner
        } else {
            Expr::Block(
                Block {
                    stmts,
                    tail: Option::Some(inner),
                },
                ty,
            )
        };
        arms.push(Arm {
            lhs: Expr::Constr(case.constructor, args, column.source_ty),
            body,
        })
    };
    Expr::Match(
        Expr::Var(column.source, column.source_ty),
        arms,
        Option::None,
        ty,
    )
}

fn lower_bool_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> Expr {
    let arms: Vec[Arm] = Vec::new();
    for expected in Vec::new().pushed(true).pushed(false) {
        arms.push(Arm {
            lhs: bool_expr(expected),
            body: lower_pattern_rows(
                ctx,
                bool_pattern_rows(rows, column.source, expected),
                ty,
            ),
        })
    };
    Expr::Match(
        Expr::Var(column.source, column.source_ty),
        arms,
        Option::None,
        ty,
    )
}

fn unit_pattern_rows(rows: Vec[PatternRow], source: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        let columns: Vec[PatternColumn] = Vec::new();
        let valid = Ref::new(true);
        for column in row.columns {
            if column.source == source {
                match column.pattern {
                    tast::Pat::Prim(tast::Primitive::Unit, _) => (),
                    _ => valid.set(false),
                }
            } else {
                columns.push(column)
            }
        };
        if valid.get() {
            result.push(PatternRow {
                columns,
                bindings: row.bindings,
                body: row.body,
            })
        } else {
            ()
        }
    };
    result
}

fn lower_unit_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> Expr {
    let arms: Vec[Arm] = Vec::new();
    arms.push(Arm {
        lhs: Expr::Prim(tast::Primitive::Unit, tast::Type::Unit),
        body: lower_pattern_rows(ctx, unit_pattern_rows(rows, column.source), ty),
    });
    Expr::Match(
        Expr::Var(column.source, column.source_ty),
        arms,
        Option::None,
        ty,
    )
}

fn primitive_pattern_key(value: tast::Primitive, ty: tast::Type) -> string {
    let builder = text::StringBuilder::new();
    tast::write_type(builder, ty);
    builder.write_char(':');
    tast::write_primitive(builder, value);
    builder.finish()
}

fn primitive_pattern_cases(rows: Vec[PatternRow], source: string) -> Vec[PrimitivePatternCase] {
    let result: Vec[PrimitivePatternCase] = Vec::new();
    for row in rows {
        for column in row.columns {
            if column.source == source {
                match column.pattern {
                    tast::Pat::Prim(value, ty) => {
                        let key = primitive_pattern_key(value, ty);
                        let found = Ref::new(false);
                        for existing in result {
                            if existing.key == key {
                                found.set(true)
                            } else {
                                ()
                            }
                        };
                        if found.get() {
                            ()
                        } else {
                            result.push(PrimitivePatternCase {
                                key,
                                value,
                                ty,
                            })
                        }
                    },
                    _ => (),
                }
            } else {
                ()
            }
        }
    };
    result
}

fn primitive_pattern_row(
    row: PatternRow,
    source: string,
    key: string,
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    let valid = Ref::new(true);
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                tast::Pat::Prim(value, ty) => {
                    if primitive_pattern_key(value, ty) == key {
                        ()
                    } else {
                        valid.set(false)
                    }
                },
                _ => valid.set(false),
            }
        } else {
            columns.push(column)
        }
    };
    if valid.get() {
        Option::Some(PatternRow {
            columns,
            bindings: row.bindings,
            body: row.body,
        })
    } else {
        Option::None
    }
}

fn primitive_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    key: string,
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        match primitive_pattern_row(row, source, key) {
            Option::Some(value) => result.push(value),
            Option::None => (),
        }
    };
    result
}

fn primitive_default_rows(rows: Vec[PatternRow], source: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        let contains = Ref::new(false);
        for column in row.columns {
            if column.source == source {
                contains.set(true)
            } else {
                ()
            }
        };
        if contains.get() {
            ()
        } else {
            result.push(row)
        }
    };
    result
}

fn lower_primitive_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> Expr {
    let arms: Vec[Arm] = Vec::new();
    for case in primitive_pattern_cases(rows, column.source) {
        arms.push(Arm {
            lhs: Expr::Prim(case.value, case.ty),
            body: lower_pattern_rows(
                ctx,
                primitive_pattern_rows(rows, column.source, case.key),
                ty,
            ),
        })
    };
    let defaults = primitive_default_rows(rows, column.source);
    let default = if defaults.len() == 0 {
        Option::None
    } else {
        Option::Some(lower_pattern_rows(ctx, defaults, ty))
    };
    Expr::Match(
        Expr::Var(column.source, column.source_ty),
        arms,
        default,
        ty,
    )
}

fn primitive_pattern_type(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        tast::Type::Int8
        | tast::Type::Int16
        | tast::Type::Int32
        | tast::Type::Int64
        | tast::Type::Uint8
        | tast::Type::Uint16
        | tast::Type::Uint32
        | tast::Type::Uint64
        | tast::Type::Float32
        | tast::Type::Float64
        | tast::Type::String
        | tast::Type::Char => true,
        _ => false,
    }
}

fn lower_pattern_rows(ctx: Lowerer, values: Vec[PatternRow], ty: tast::Type) -> Expr {
    let rows = normalize_pattern_rows(values);
    if rows.len() == 0 {
        missing_expr(ty)
    } else if rows.get(0).columns.len() == 0 {
        lower_pattern_row_body(ctx, rows.get(0), ty)
    } else {
        match branch_pattern_column(rows) {
            Option::Some(column) => match expand_or_pattern_rows(rows, column.source) {
                Option::Some(expanded) => lower_pattern_rows(ctx, expanded, ty),
                Option::None => match nominal_parts(column.source_ty) {
                    Option::Some((name, type_args)) => match find_enum(ctx, name) {
                        Option::Some(definition) => lower_enum_pattern_rows(
                            ctx,
                            rows,
                            column,
                            definition,
                            type_args,
                            ty,
                        ),
                        Option::None => match struct_place_details(ctx, column.source_ty) {
                            Option::Some((constructor, fields)) => lower_struct_pattern_rows(
                                ctx,
                                rows,
                                column,
                                constructor,
                                fields,
                                ty,
                            ),
                            Option::None => lower_pattern_row_body(ctx, rows.get(0), ty),
                        },
                    },
                    Option::None => match tast::resolve_type(column.source_ty) {
                        tast::Type::Unit => lower_unit_pattern_rows(ctx, rows, column, ty),
                        tast::Type::Bool => lower_bool_pattern_rows(ctx, rows, column, ty),
                        tast::Type::Tuple(types) => {
                            lower_tuple_pattern_rows(ctx, rows, column, types, ty)
                        },
                        _ => if primitive_pattern_type(column.source_ty) {
                            lower_primitive_pattern_rows(ctx, rows, column, ty)
                        } else {
                            lower_pattern_row_body(ctx, rows.get(0), ty)
                        },
                    },
                },
            },
            Option::None => missing_expr(ty),
        }
    }
}

fn pattern_rows_from_arms(
    source: string,
    source_ty: tast::Type,
    arms: Vec[tast::Arm],
) -> Option[Vec[PatternRow]] {
    let rows: Vec[PatternRow] = Vec::new();
    let valid = Ref::new(true);
    for arm in arms {
        match arm.guard {
            Option::Some(_) => valid.set(false),
            Option::None => {
                let columns: Vec[PatternColumn] = Vec::new();
                columns.push(PatternColumn {
                    source,
                    source_ty,
                    pattern: arm.pat,
                });
                rows.push(PatternRow {
                    columns,
                    bindings: Vec::new(),
                    body: arm.body,
                })
            },
        }
    };
    if valid.get() {
        Option::Some(rows)
    } else {
        Option::None
    }
}
