package core;

use gomlang::parser::tast;

fn contains_name(values: Vec[string], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value == expected {
            found.set(true)
        } else {
            ()
        }
    };
    found.get()
}

fn push_name(values: Vec[string], value: string) -> unit {
    if contains_name(values, value) {
        ()
    } else {
        values.push(value)
    }
}

fn push_mutable(values: Vec[(string, tast::Type)], name: string, ty: tast::Type) -> unit {
    let found = Ref::new(false);
    for value in values {
        if value.0 == name {
            found.set(true)
        } else {
            ()
        }
    };
    if found.get() {
        ()
    } else {
        values.push((name, ty))
    }
}

fn collect_mutable_exprs(values: Vec[tast::Expr], result: Vec[(string, tast::Type)]) -> unit {
    for value in values {
        collect_mutable_expr(value, result)
    }
}

fn collect_mutable_block(value: tast::Block, result: Vec[(string, tast::Type)]) -> unit {
    for stmt in value.stmts {
        match stmt {
            tast::Stmt::Let(is_mut, pattern, expr) => {
                if is_mut {
                    match pattern {
                        tast::Pat::Var(name, ty) => push_mutable(result, name, ty),
                        _ => (),
                    }
                } else {
                    ()
                };
                collect_mutable_expr(expr, result)
            },
            tast::Stmt::Assign(target, expr) => {
                collect_mutable_expr(target, result);
                collect_mutable_expr(expr, result)
            },
            tast::Stmt::Expr(expr) => collect_mutable_expr(expr, result),
        }
    };
    match value.tail {
        Option::Some(expr) => collect_mutable_expr(expr, result),
        Option::None => (),
    }
}

fn collect_mutable_expr(value: tast::Expr, result: Vec[(string, tast::Type)]) -> unit {
    match value {
        tast::Expr::Var(_, _)
        | tast::Expr::Callable(_, _)
        | tast::Expr::Prim(_, _)
        | tast::Expr::Break(_)
        | tast::Expr::Continue(_) => (),
        tast::Expr::Constr(_, args, _)
        | tast::Expr::Tuple(args, _)
        | tast::Expr::Array(args, _) => collect_mutable_exprs(args, result),
        tast::Expr::Closure(_, body, _) => collect_mutable_expr(body, result),
        tast::Expr::Block(block, _) => collect_mutable_block(block, result),
        tast::Expr::Match(source, arms, _) => {
            collect_mutable_expr(source, result);
            for arm in arms {
                match arm.guard {
                    Option::Some(guard) => collect_mutable_expr(guard, result),
                    Option::None => (),
                };
                collect_mutable_expr(arm.body, result)
            }
        },
        tast::Expr::If(cond, then_branch, else_branch, _) => {
            collect_mutable_expr(cond, result);
            collect_mutable_expr(then_branch, result);
            collect_mutable_expr(else_branch, result)
        },
        tast::Expr::While(cond, body, _) => {
            collect_mutable_expr(cond, result);
            collect_mutable_expr(body, result)
        },
        tast::Expr::For(_, iterator, _, _, _, body, _) => {
            collect_mutable_expr(iterator, result);
            collect_mutable_expr(body, result)
        },
        tast::Expr::Return(expr, _) => match expr {
            Option::Some(value) => collect_mutable_expr(value, result),
            Option::None => (),
        },
        tast::Expr::Go(expr, _)
        | tast::Expr::Unary(_, expr, _)
        | tast::Expr::Cast(expr, _)
        | tast::Expr::Proj(expr, _, _)
        | tast::Expr::Field(expr, _, _)
        | tast::Expr::ToDyn(_, _, expr, _) => collect_mutable_expr(expr, result),
        tast::Expr::Call(function, args, _) => {
            collect_mutable_expr(function, result);
            collect_mutable_exprs(args, result)
        },
        tast::Expr::Index(base, index, _) | tast::Expr::Binary(_, base, index, _) => {
            collect_mutable_expr(base, result);
            collect_mutable_expr(index, result)
        },
    }
}

fn collect_pattern_names(value: tast::Pat, result: Vec[string]) -> unit {
    match value {
        tast::Pat::Var(name, _) => push_name(result, name),
        tast::Pat::Constr(_, args, _) | tast::Pat::Tuple(args, _) | tast::Pat::Or(args, _) => {
            for arg in args {
                collect_pattern_names(arg, result)
            }
        },
        tast::Pat::Array(prefix, rest, suffix, _) => {
            for item in prefix {
                collect_pattern_names(item, result)
            };
            match rest {
                Option::Some(value) => match value.binding {
                    Option::Some(name) => push_name(result, name),
                    Option::None => (),
                },
                Option::None => (),
            };
            for item in suffix {
                collect_pattern_names(item, result)
            }
        },
        tast::Pat::Alias(name, pattern, _) => {
            push_name(result, name);
            collect_pattern_names(pattern, result)
        },
        tast::Pat::Prim(_, _) | tast::Pat::Range(_, _, _, _) | tast::Pat::Wild(_) => (),
    }
}

fn collect_bound_exprs(values: Vec[tast::Expr], result: Vec[string]) -> unit {
    for value in values {
        collect_bound_expr(value, result)
    }
}

fn collect_bound_block(value: tast::Block, result: Vec[string]) -> unit {
    for stmt in value.stmts {
        match stmt {
            tast::Stmt::Let(_, pattern, expr) => {
                collect_pattern_names(pattern, result);
                collect_bound_expr(expr, result)
            },
            tast::Stmt::Assign(target, expr) => {
                collect_bound_expr(target, result);
                collect_bound_expr(expr, result)
            },
            tast::Stmt::Expr(expr) => collect_bound_expr(expr, result),
        }
    };
    match value.tail {
        Option::Some(expr) => collect_bound_expr(expr, result),
        Option::None => (),
    }
}

fn collect_bound_expr(value: tast::Expr, result: Vec[string]) -> unit {
    match value {
        tast::Expr::Var(_, _)
        | tast::Expr::Callable(_, _)
        | tast::Expr::Prim(_, _)
        | tast::Expr::Closure(_, _, _)
        | tast::Expr::Break(_)
        | tast::Expr::Continue(_) => (),
        tast::Expr::Constr(_, args, _)
        | tast::Expr::Tuple(args, _)
        | tast::Expr::Array(args, _) => collect_bound_exprs(args, result),
        tast::Expr::Block(block, _) => collect_bound_block(block, result),
        tast::Expr::Match(source, arms, _) => {
            collect_bound_expr(source, result);
            for arm in arms {
                collect_pattern_names(arm.pat, result);
                match arm.guard {
                    Option::Some(guard) => collect_bound_expr(guard, result),
                    Option::None => (),
                };
                collect_bound_expr(arm.body, result)
            }
        },
        tast::Expr::If(cond, then_branch, else_branch, _) => {
            collect_bound_expr(cond, result);
            collect_bound_expr(then_branch, result);
            collect_bound_expr(else_branch, result)
        },
        tast::Expr::While(cond, body, _) => {
            collect_bound_expr(cond, result);
            collect_bound_expr(body, result)
        },
        tast::Expr::For(pattern, iterator, _, _, _, body, _) => {
            collect_pattern_names(pattern, result);
            collect_bound_expr(iterator, result);
            collect_bound_expr(body, result)
        },
        tast::Expr::Return(expr, _) => match expr {
            Option::Some(value) => collect_bound_expr(value, result),
            Option::None => (),
        },
        tast::Expr::Go(expr, _)
        | tast::Expr::Unary(_, expr, _)
        | tast::Expr::Cast(expr, _)
        | tast::Expr::Proj(expr, _, _)
        | tast::Expr::Field(expr, _, _)
        | tast::Expr::ToDyn(_, _, expr, _) => collect_bound_expr(expr, result),
        tast::Expr::Call(function, args, _) => {
            collect_bound_expr(function, result);
            collect_bound_exprs(args, result)
        },
        tast::Expr::Index(base, index, _) | tast::Expr::Binary(_, base, index, _) => {
            collect_bound_expr(base, result);
            collect_bound_expr(index, result)
        },
    }
}

fn collect_reference_exprs(values: Vec[tast::Expr], result: Vec[string]) -> unit {
    for value in values {
        collect_reference_expr(value, result)
    }
}

fn collect_reference_block(value: tast::Block, result: Vec[string]) -> unit {
    for stmt in value.stmts {
        match stmt {
            tast::Stmt::Let(_, _, expr) => collect_reference_expr(expr, result),
            tast::Stmt::Assign(target, expr) => {
                collect_reference_expr(target, result);
                collect_reference_expr(expr, result)
            },
            tast::Stmt::Expr(expr) => collect_reference_expr(expr, result),
        }
    };
    match value.tail {
        Option::Some(expr) => collect_reference_expr(expr, result),
        Option::None => (),
    }
}

fn collect_reference_expr(value: tast::Expr, result: Vec[string]) -> unit {
    match value {
        tast::Expr::Var(name, _) => push_name(result, name),
        tast::Expr::Callable(_, _)
        | tast::Expr::Prim(_, _)
        | tast::Expr::Closure(_, _, _)
        | tast::Expr::Break(_)
        | tast::Expr::Continue(_) => (),
        tast::Expr::Constr(_, args, _)
        | tast::Expr::Tuple(args, _)
        | tast::Expr::Array(args, _) => collect_reference_exprs(args, result),
        tast::Expr::Block(block, _) => collect_reference_block(block, result),
        tast::Expr::Match(source, arms, _) => {
            collect_reference_expr(source, result);
            for arm in arms {
                match arm.guard {
                    Option::Some(guard) => collect_reference_expr(guard, result),
                    Option::None => (),
                };
                collect_reference_expr(arm.body, result)
            }
        },
        tast::Expr::If(cond, then_branch, else_branch, _) => {
            collect_reference_expr(cond, result);
            collect_reference_expr(then_branch, result);
            collect_reference_expr(else_branch, result)
        },
        tast::Expr::While(cond, body, _) => {
            collect_reference_expr(cond, result);
            collect_reference_expr(body, result)
        },
        tast::Expr::For(_, iterator, _, _, _, body, _) => {
            collect_reference_expr(iterator, result);
            collect_reference_expr(body, result)
        },
        tast::Expr::Return(expr, _) => match expr {
            Option::Some(value) => collect_reference_expr(value, result),
            Option::None => (),
        },
        tast::Expr::Go(expr, _)
        | tast::Expr::Unary(_, expr, _)
        | tast::Expr::Cast(expr, _)
        | tast::Expr::Proj(expr, _, _)
        | tast::Expr::Field(expr, _, _)
        | tast::Expr::ToDyn(_, _, expr, _) => collect_reference_expr(expr, result),
        tast::Expr::Call(function, args, _) => {
            collect_reference_expr(function, result);
            collect_reference_exprs(args, result)
        },
        tast::Expr::Index(base, index, _) | tast::Expr::Binary(_, base, index, _) => {
            collect_reference_expr(base, result);
            collect_reference_expr(index, result)
        },
    }
}

fn collect_capture_exprs(values: Vec[tast::Expr], result: Vec[string]) -> unit {
    for value in values {
        collect_capture_expr(value, result)
    }
}

fn collect_capture_block(value: tast::Block, result: Vec[string]) -> unit {
    for stmt in value.stmts {
        match stmt {
            tast::Stmt::Let(_, _, expr) => collect_capture_expr(expr, result),
            tast::Stmt::Assign(target, expr) => {
                collect_capture_expr(target, result);
                collect_capture_expr(expr, result)
            },
            tast::Stmt::Expr(expr) => collect_capture_expr(expr, result),
        }
    };
    match value.tail {
        Option::Some(expr) => collect_capture_expr(expr, result),
        Option::None => (),
    }
}

fn collect_closure_captures(
    params: Vec[tast::ClosureParam],
    body: tast::Expr,
    result: Vec[string],
) -> unit {
    let bound: Vec[string] = Vec::new();
    for param in params {
        push_name(bound, param.name)
    };
    collect_bound_expr(body, bound);
    let references: Vec[string] = Vec::new();
    collect_reference_expr(body, references);
    for name in references {
        if contains_name(bound, name) {
            ()
        } else {
            push_name(result, name)
        }
    };
    collect_capture_expr(body, result)
}

fn collect_capture_expr(value: tast::Expr, result: Vec[string]) -> unit {
    match value {
        tast::Expr::Var(_, _)
        | tast::Expr::Callable(_, _)
        | tast::Expr::Prim(_, _)
        | tast::Expr::Break(_)
        | tast::Expr::Continue(_) => (),
        tast::Expr::Constr(_, args, _)
        | tast::Expr::Tuple(args, _)
        | tast::Expr::Array(args, _) => collect_capture_exprs(args, result),
        tast::Expr::Closure(params, body, _) => collect_closure_captures(params, body, result),
        tast::Expr::Block(block, _) => collect_capture_block(block, result),
        tast::Expr::Match(source, arms, _) => {
            collect_capture_expr(source, result);
            for arm in arms {
                match arm.guard {
                    Option::Some(guard) => collect_capture_expr(guard, result),
                    Option::None => (),
                };
                collect_capture_expr(arm.body, result)
            }
        },
        tast::Expr::If(cond, then_branch, else_branch, _) => {
            collect_capture_expr(cond, result);
            collect_capture_expr(then_branch, result);
            collect_capture_expr(else_branch, result)
        },
        tast::Expr::While(cond, body, _) => {
            collect_capture_expr(cond, result);
            collect_capture_expr(body, result)
        },
        tast::Expr::For(_, iterator, _, _, _, body, _) => {
            collect_capture_expr(iterator, result);
            collect_capture_expr(body, result)
        },
        tast::Expr::Return(expr, _) => match expr {
            Option::Some(value) => collect_capture_expr(value, result),
            Option::None => (),
        },
        tast::Expr::Go(expr, _)
        | tast::Expr::Unary(_, expr, _)
        | tast::Expr::Cast(expr, _)
        | tast::Expr::Proj(expr, _, _)
        | tast::Expr::Field(expr, _, _)
        | tast::Expr::ToDyn(_, _, expr, _) => collect_capture_expr(expr, result),
        tast::Expr::Call(function, args, _) => {
            collect_capture_expr(function, result);
            collect_capture_exprs(args, result)
        },
        tast::Expr::Index(base, index, _) | tast::Expr::Binary(_, base, index, _) => {
            collect_capture_expr(base, result);
            collect_capture_expr(index, result)
        },
    }
}

fn hidden_mutable_cells(value: tast::Block) -> Vec[(string, tast::Type)] {
    let mutables: Vec[(string, tast::Type)] = Vec::new();
    collect_mutable_block(value, mutables);
    let captures: Vec[string] = Vec::new();
    collect_capture_block(value, captures);
    let result: Vec[(string, tast::Type)] = Vec::new();
    for value in mutables {
        if contains_name(captures, value.0) {
            result.push(value)
        } else {
            ()
        }
    };
    result
}

fn hidden_cell_type(value: tast::Type) -> tast::Type {
    tast::Type::RefType(value)
}

fn hidden_cell_inner(cells: Vec[(string, tast::Type)], name: string) -> Option[tast::Type] {
    let result: Ref[Option[tast::Type]] = Ref::new(Option::None);
    for value in cells {
        if value.0 == name {
            result.set(Option::Some(value.1))
        } else {
            ()
        }
    };
    result.get()
}

fn intrinsic_expr(name: string, params: Vec[tast::Type], ret_ty: tast::Type) -> Expr {
    Expr::Callable(
        tast::Callable::Intrinsic(name),
        tast::Type::Func(params, ret_ty),
    )
}

fn hidden_cell_var(name: string, inner_ty: tast::Type) -> Expr {
    Expr::Var(name, hidden_cell_type(inner_ty))
}

fn hidden_ref_alloc(value: Expr, inner_ty: tast::Type) -> Expr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::new();
    params.push(inner_ty);
    let args: Vec[Expr] = Vec::new();
    args.push(value);
    Expr::Call(intrinsic_expr("ref.new", params, ref_ty), args, ref_ty)
}

fn hidden_ref_get(name: string, inner_ty: tast::Type) -> Expr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::new();
    params.push(ref_ty);
    let args: Vec[Expr] = Vec::new();
    args.push(hidden_cell_var(name, inner_ty));
    Expr::Call(intrinsic_expr("ref.get", params, inner_ty), args, inner_ty)
}

fn hidden_ref_set(name: string, inner_ty: tast::Type, value: Expr) -> Expr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::new();
    params.push(ref_ty);
    params.push(inner_ty);
    let args: Vec[Expr] = Vec::new();
    args.push(hidden_cell_var(name, inner_ty));
    args.push(value);
    Expr::Call(
        intrinsic_expr("ref.set", params, tast::Type::Unit),
        args,
        tast::Type::Unit,
    )
}

fn lower_hidden_exprs(values: Vec[Expr], cells: Vec[(string, tast::Type)]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::new();
    for value in values {
        result.push(lower_hidden_expr(value, cells))
    };
    result
}

fn lower_hidden_block(value: Block, cells: Vec[(string, tast::Type)]) -> Block {
    let stmts: Vec[LetStmt] = Vec::new();
    for stmt in value.stmts {
        let lowered = lower_hidden_expr(stmt.value, cells);
        match hidden_cell_inner(cells, stmt.name) {
            Option::Some(inner_ty) => stmts.push(LetStmt {
                name: stmt.name,
                value: hidden_ref_alloc(lowered, inner_ty),
                ty: hidden_cell_type(inner_ty),
            }),
            Option::None => stmts.push(LetStmt {
                name: stmt.name,
                value: lowered,
                ty: stmt.ty,
            }),
        }
    };
    Block {
        stmts,
        tail: match value.tail {
            Option::Some(expr) => Option::Some(lower_hidden_expr(expr, cells)),
            Option::None => Option::None,
        },
    }
}

fn lower_hidden_arms(values: Vec[Arm], cells: Vec[(string, tast::Type)]) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::new();
    for value in values {
        result.push(Arm {
            lhs: lower_hidden_expr(value.lhs, cells),
            body: lower_hidden_expr(value.body, cells),
        })
    };
    result
}

fn lower_hidden_expr(value: Expr, cells: Vec[(string, tast::Type)]) -> Expr {
    match value {
        Expr::Var(name, ty) => match hidden_cell_inner(cells, name) {
            Option::Some(inner_ty) => hidden_ref_get(name, inner_ty),
            Option::None => Expr::Var(name, ty),
        },
        Expr::Callable(callable, ty) => Expr::Callable(callable, ty),
        Expr::Prim(value, ty) => Expr::Prim(value, ty),
        Expr::Constr(constructor, args, ty) => {
            Expr::Constr(constructor, lower_hidden_exprs(args, cells), ty)
        },
        Expr::Tuple(items, ty) => Expr::Tuple(lower_hidden_exprs(items, cells), ty),
        Expr::Array(items, ty) => Expr::Array(lower_hidden_exprs(items, cells), ty),
        Expr::Closure(params, body, ty) => {
            Expr::Closure(params, lower_hidden_expr(body, cells), ty)
        },
        Expr::Block(block, ty) => Expr::Block(lower_hidden_block(block, cells), ty),
        Expr::Match(source, arms, default, ty) => Expr::Match(
            lower_hidden_expr(source, cells),
            lower_hidden_arms(arms, cells),
            match default {
                Option::Some(expr) => Option::Some(lower_hidden_expr(expr, cells)),
                Option::None => Option::None,
            },
            ty,
        ),
        Expr::If(cond, then_branch, else_branch, ty) => Expr::If(
            lower_hidden_expr(cond, cells),
            lower_hidden_expr(then_branch, cells),
            lower_hidden_expr(else_branch, cells),
            ty,
        ),
        Expr::While(cond, body, ty) => {
            Expr::While(lower_hidden_expr(cond, cells), lower_hidden_expr(body, cells), ty)
        },
        Expr::Break(ty) => Expr::Break(ty),
        Expr::Continue(ty) => Expr::Continue(ty),
        Expr::Return(expr, ty) => Expr::Return(match expr {
            Option::Some(value) => Option::Some(lower_hidden_expr(value, cells)),
            Option::None => Option::None,
        }, ty),
        Expr::Go(expr, ty) => Expr::Go(lower_hidden_expr(expr, cells), ty),
        Expr::ConstrGet(expr, constructor, field_index, ty) => Expr::ConstrGet(
            lower_hidden_expr(expr, cells),
            constructor,
            field_index,
            ty,
        ),
        Expr::Unary(op, expr, ty) => Expr::Unary(op, lower_hidden_expr(expr, cells), ty),
        Expr::Cast(expr, ty) => Expr::Cast(lower_hidden_expr(expr, cells), ty),
        Expr::Binary(op, left, right, ty) => Expr::Binary(
            op,
            lower_hidden_expr(left, cells),
            lower_hidden_expr(right, cells),
            ty,
        ),
        Expr::Assign(name, expr, target_ty, ty) => {
            let expr = lower_hidden_expr(expr, cells);
            match hidden_cell_inner(cells, name) {
                Option::Some(inner_ty) => hidden_ref_set(name, inner_ty, expr),
                Option::None => Expr::Assign(name, expr, target_ty, ty),
            }
        },
        Expr::Call(function, args, ty) => Expr::Call(
            lower_hidden_expr(function, cells),
            lower_hidden_exprs(args, cells),
            ty,
        ),
        Expr::ToDyn(name, for_ty, expr, ty) => {
            Expr::ToDyn(name, for_ty, lower_hidden_expr(expr, cells), ty)
        },
        Expr::DynCall(owner, name, receiver, args, ty) => Expr::DynCall(
            owner,
            name,
            lower_hidden_expr(receiver, cells),
            lower_hidden_exprs(args, cells),
            ty,
        ),
        Expr::TraitCall(reference, name, receiver, args, ty) => Expr::TraitCall(
            reference,
            name,
            lower_hidden_expr(receiver, cells),
            lower_hidden_exprs(args, cells),
            ty,
        ),
        Expr::Proj(expr, index, ty) => {
            Expr::Proj(lower_hidden_expr(expr, cells), index, ty)
        },
    }
}
