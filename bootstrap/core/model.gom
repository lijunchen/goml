package core;

use gomlc::ast;
use gomlc::tast;

pub struct File {
    pub functions: Vec[Function],
    pub enums: Vec[tast::EnumDef],
    pub structs: Vec[tast::StructDef],
    pub type_instances: Vec[TypeInstance],
}

pub struct TypeInstance {
    pub base_name: string,
    pub args: Vec[tast::Type],
    pub name: string,
}

pub struct Function {
    pub name: string,
    pub root: bool,
    pub generics: Vec[string],
    pub predicates: Vec[tast::TypePredicate],
    pub trait_impl: Option[TraitImpl],
    pub params: Vec[(string, tast::Type)],
    pub ret_ty: tast::Type,
    pub body: Block,
}

pub struct TraitImpl {
    pub trait_ref: tast::TraitRef,
    pub for_ty: tast::Type,
    pub associated_types: Vec[(string, tast::Type)],
}

pub struct LetStmt {
    pub name: string,
    pub value: Expr,
    pub ty: tast::Type,
}

pub struct Block {
    pub stmts: Vec[LetStmt],
    pub tail: Option[Expr],
}

pub enum Expr {
    Var(string, tast::Type),
    Callable(tast::Callable, tast::Type),
    Prim(tast::Primitive, tast::Type),
    Constr(tast::Constructor, Vec[Expr], tast::Type),
    Tuple(Vec[Expr], tast::Type),
    Array(Vec[Expr], tast::Type),
    Closure(Vec[tast::ClosureParam], Expr, tast::Type),
    Block(Block, tast::Type),
    Match(Expr, Vec[Arm], Option[Expr], tast::Type),
    If(Expr, Expr, Expr, tast::Type),
    While(Expr, Expr, tast::Type),
    Break(tast::Type),
    Continue(tast::Type),
    Return(Option[Expr], tast::Type),
    Go(Expr, tast::Type),
    ConstrGet(Expr, tast::Constructor, int, tast::Type),
    Unary(ast::UnaryOp, Expr, tast::Type),
    Cast(Expr, tast::Type),
    Binary(ast::BinaryOp, Expr, Expr, tast::Type),
    Assign(string, Expr, tast::Type, tast::Type),
    Call(Expr, Vec[Expr], tast::Type),
    ToDyn(string, tast::Type, Expr, tast::Type),
    DynCall(string, string, Expr, Vec[Expr], tast::Type),
    TraitCall(tast::TraitRef, string, Expr, Vec[Expr], tast::Type),
    Proj(Expr, int, tast::Type),
}

pub struct Arm {
    pub lhs: Expr,
    pub body: Expr,
}

pub fn expr_type(value: Expr) -> tast::Type {
    match value {
        Expr::Var(_, ty) => ty,
        Expr::Callable(_, ty) => ty,
        Expr::Prim(_, ty) => ty,
        Expr::Constr(_, _, ty) => ty,
        Expr::Tuple(_, ty) => ty,
        Expr::Array(_, ty) => ty,
        Expr::Closure(_, _, ty) => ty,
        Expr::Block(_, ty) => ty,
        Expr::Match(_, _, _, ty) => ty,
        Expr::If(_, _, _, ty) => ty,
        Expr::While(_, _, ty) => ty,
        Expr::Break(ty) => ty,
        Expr::Continue(ty) => ty,
        Expr::Return(_, ty) => ty,
        Expr::Go(_, ty) => ty,
        Expr::ConstrGet(_, _, _, ty) => ty,
        Expr::Unary(_, _, ty) => ty,
        Expr::Cast(_, ty) => ty,
        Expr::Binary(_, _, _, ty) => ty,
        Expr::Assign(_, _, _, ty) => ty,
        Expr::Call(_, _, ty) => ty,
        Expr::ToDyn(_, _, _, ty) => ty,
        Expr::DynCall(_, _, _, _, ty) => ty,
        Expr::TraitCall(_, _, _, _, ty) => ty,
        Expr::Proj(_, _, ty) => ty,
    }
}
