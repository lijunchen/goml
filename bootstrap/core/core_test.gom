package core;

use gomlang::parser::ast;
use gomlang::parser::hir;
use gomlang::parser::parser;
use gomlang::parser::tast;
use std::testing;

fn lower_source(source: string) -> File {
    lower(tast::check(hir::lower(
        ast::lower(parser::parse(source)),
        "main.gom",
    )))
}

#[test]
fn lowers_basic_functions_and_let_chains() -> unit {
    let source = "fn take(value: uint16) -> uint16 { value } fn main() -> uint16 { let value = take(1000); value }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn take(value/0: uint16) -> uint16 {\n  value/0\n}\n\nfn main() -> uint16 {\n  let value/1 = take(1000) in\n  value/1\n}",
    )
}

#[test]
fn folds_negative_integer_primitives() -> unit {
    testing::assert_eq(
        encode(lower_source("fn main() -> int32 { -1 }")),
        "fn main() -> int32 {\n  -1\n}",
    )
}

#[test]
fn nests_discard_patterns_around_the_continuation() -> unit {
    testing::assert_eq(
        encode(lower_source("fn main() -> unit { let _ = (); () }")),
        "fn main() -> unit {\n  let mtmp0 = () in\n  {\n    ()\n  }\n}",
    )
}

#[test]
fn lowers_enum_payload_patterns_in_definition_order() -> unit {
    let source = "enum Weird[T] { Next(Ref[Weird[(int32) -> int32]]), Done(T) } fn main() -> unit { let x: Weird[int32] = Weird::Done(1i32); match x { Weird::Done(v) => println(v.to_string()), Weird::Next(_) => println(\"next\"), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> unit {\n  let x/0 = Weird::Done(1) in\n  match x/0 {\n    Weird::Next(x0) => {\n      {\n        let x0 = Weird::Next._0(x/0) in\n        println(\"next\")\n      }\n    },\n    Weird::Done(x1) => {\n      {\n        let x1 = Weird::Done._0(x/0) in\n        {\n          let v/1 = x1 in\n          println(inherent#int32#int32#to_string(v/1))\n        }\n      }\n    },\n  }\n}",
    )
}

#[test]
fn allocates_statement_names_after_lowering_the_value() -> unit {
    let file = lower_source("fn f(flag: bool) -> int32 { while true { if flag { return 1 } else { break }; }; 2 }");
    match file.functions.get(0).body.stmts.get(0) {
        LetStmt { name, value: Expr::While(_, Expr::Block(body, _), _), ty: _ } => {
            testing::assert_eq(name, "_wild1");
            testing::assert_eq(body.stmts.get(0).name, "_wild0")
        },
        _ => testing::fail("expected nested while statement bindings"),
    }
}

#[test]
fn lowers_builtin_option_matches_with_nonvariable_sources() -> unit {
    let source = "fn build() -> Option[() -> int32] { Option::Some(|| 1i32) } fn main() -> unit { match build() { Option::Some(f) => println(f()), Option::None => println(0i32), } }";
    let file = lower_source(source);
    match file.functions.get(1).body.tail {
        Option::Some(Expr::Block(block, _)) => {
            testing::assert_eq(block.stmts.get(0).name, "mtmp0");
            match block.tail {
                Option::Some(Expr::Match(_, arms, Option::None, _)) => {
                    match arms.get(0).lhs {
                        Expr::Constr(constructor, _, _) => {
                            testing::assert_eq(constructor.name, "Option::None")
                        },
                        _ => testing::fail("expected None arm"),
                    };
                    match arms.get(1).lhs {
                        Expr::Constr(constructor, _, _) => {
                            testing::assert_eq(constructor.name, "Option::Some")
                        },
                        _ => testing::fail("expected Some arm"),
                    }
                },
                _ => testing::fail("expected Option match"),
            }
        },
        _ => testing::fail("expected scrutinee binding block"),
    }
}

#[test]
fn boxes_mutable_locals_captured_by_closures() -> unit {
    let source = "fn main() -> int32 { let mut x = 0; let inc = || { x = x + 1; x }; inc() }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn main() -> int32 {\n  let x/0 = @intrinsic(ref.new)(0) in\n  let inc/1 = || => {\n    let _wild0 = @intrinsic(ref.set)(x/0, (@intrinsic(ref.get)(x/0) + 1)) in\n    @intrinsic(ref.get)(x/0)\n  } in\n  inc/1()\n}",
    )
}

#[test]
fn binds_nested_match_sources_before_lowering_them() -> unit {
    let source = "fn main() -> bool { match match Option::Some(true) { Option::Some(value) => value, Option::None => false, } { false => false, true => true, } }";
    let file = lower_source(source);
    match file.functions.get(0).body.tail {
        Option::Some(Expr::Block(outer, _)) => {
            testing::assert_eq(outer.stmts.get(0).name, "mtmp0");
            match outer.stmts.get(0).value {
                Expr::Block(inner, _) => testing::assert_eq(inner.stmts.get(0).name, "mtmp1"),
                _ => testing::fail("expected inner match binding"),
            };
            match outer.tail {
                Option::Some(Expr::Match(_, arms, Option::None, _)) => {
                    match arms.get(0).lhs {
                        Expr::Prim(tast::Primitive::Bool(value), _) => {
                            testing::assert_eq(value, true)
                        },
                        _ => testing::fail("expected true arm"),
                    };
                    match arms.get(1).lhs {
                        Expr::Prim(tast::Primitive::Bool(value), _) => {
                            testing::assert_eq(value, false)
                        },
                        _ => testing::fail("expected false arm"),
                    }
                },
                _ => testing::fail("expected outer bool match"),
            }
        },
        _ => testing::fail("expected outer match binding"),
    }
}

#[test]
fn evaluates_index_assignment_places_once() -> unit {
    let file = lower_source("fn main() -> unit { let mut values = [1, 2]; values[0] = 3; }");
    let body = file.functions.get(0).body;
    testing::assert_eq(body.stmts.get(1).name, "_wild4");
    match body.stmts.get(1).value {
        Expr::Block(place, _) => {
            testing::assert_eq(place.stmts.get(0).name, "place_root0");
            testing::assert_eq(place.stmts.get(1).name, "index1");
            testing::assert_eq(place.stmts.get(2).name, "place2");
            testing::assert_eq(place.stmts.get(3).name, "value3");
            match place.tail {
                Option::Some(Expr::Assign(name, Expr::Call(
                    Expr::Callable(tast::Callable::Intrinsic(intrinsic), _),
                    _,
                    _,
                ), _, _)) => {
                    testing::assert_eq(name, "values/0");
                    testing::assert_eq(intrinsic, "array.set")
                },
                _ => testing::fail("expected array writeback"),
            }
        },
        _ => testing::fail("expected indexed place block"),
    }
}

#[test]
fn lowers_flat_tuple_bindings_in_matrix_order() -> unit {
    let source = "fn split(pair: (int32, string)) -> string { let (left, right) = pair; right }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn split(pair/0: (int32, string)) -> string {\n  let mtmp0 = pair/0 in\n  {\n    let x1 = mtmp0.0 in\n    let x2 = mtmp0.1 in\n    {\n      let right/2 = x2 in\n      {\n        let left/1 = x1 in\n        {\n          right/2\n        }\n      }\n    }\n  }\n}",
    )
}

#[test]
fn lowers_nested_boolean_enum_payload_patterns() -> unit {
    let source = "enum Pair { Values(bool, bool) } fn choose(value: Pair) -> int32 { match value { Pair::Values(false, false) => 2, Pair::Values(false, true) => 3, _ => 4, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn choose(value/0: Pair) -> int32 {\n  match value/0 {\n    Pair::Values(x0, x1) => {\n      {\n        let x0 = Pair::Values._0(value/0) in\n        let x1 = Pair::Values._1(value/0) in\n        match x1 {\n          true => {\n            match x0 {\n              true => {\n                4\n              },\n              false => {\n                3\n              },\n            }\n          },\n          false => {\n            match x0 {\n              true => {\n                4\n              },\n              false => {\n                2\n              },\n            }\n          },\n        }\n      }\n    },\n  }\n}",
    )
}

#[test]
fn lowers_for_loops_through_iterator_protocols() -> unit {
    let source = "fn each(values: Vec[int32]) -> unit { for value in values { println(value) } }";
    testing::assert_eq(
        encode(lower_source(source)),
        "fn each(values/0: Vec[int32]) -> unit {\n  {\n    let for_iter0 = trait_call[IntoIterator::into_iter](values/0) in\n    while true {\n        {\n          let for_next1 = trait_call[Iterator::next](for_iter0) in\n          match for_next1 {\n            Option::None => {\n              break\n            },\n            Option::Some(x2) => {\n              {\n                let x2 = Option::Some._0(for_next1) in\n                {\n                  let value/1 = x2 in\n                  {\n                    println(value/1)\n                  }\n                }\n              }\n            },\n          }\n        }\n    }\n  }\n}",
    )
}
