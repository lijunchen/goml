package core;

use gomlc::ast;
use gomlc::tast;

fn tast_exprs_exit(values: Vec[tast::Expr]) -> bool {
    let result = Ref::new(false);
    for value in values {
        if tast_expr_exits(value) {
            result.set(true)
        } else {
            ()
        }
    };
    result.get()
}

fn tast_stmt_exits(value: tast::Stmt) -> bool {
    match value {
        tast::Stmt::Expr { expr } => tast_expr_exits(expr),
        tast::Stmt::Let { is_mut: _, pat: _, value: _ } | tast::Stmt::Assign { target: _, value: _ } => false,
    }
}

fn tast_block_exits(value: tast::Block) -> bool {
    let result = Ref::new(false);
    for stmt in value.stmts {
        if tast_stmt_exits(stmt) {
            result.set(true)
        } else {
            ()
        }
    };
    match value.tail {
        Option::Some(tail) => if tast_expr_exits(tail) {
            result.set(true)
        } else {
            ()
        },
        Option::None => (),
    };
    result.get()
}

fn tast_match_arms_exit(arms: Vec[tast::Arm]) -> bool {
    let result = Ref::new(true);
    for arm in arms {
        if tast_expr_exits(arm.body) {
            ()
        } else {
            result.set(false)
        }
    };
    result.get()
}

fn tast_expr_exits(value: tast::Expr) -> bool {
    match value {
        tast::Expr::Break { ty: _ } | tast::Expr::Continue { ty: _ } | tast::Expr::Return { expr: _, ty: _ } => true,
        tast::Expr::Constr { constructor: _, args, ty: _ }
        | tast::Expr::Tuple { items: args, ty: _ }
        | tast::Expr::Array { items: args, ty: _ } => tast_exprs_exit(args),
        tast::Expr::Unary { op: _, expr, ty: _ }
        | tast::Expr::Cast { expr, ty: _ }
        | tast::Expr::Go { expr, ty: _ }
        | tast::Expr::Field { expr, field_name: _, ty: _ } => tast_expr_exits(expr),
        tast::Expr::Call { func: function, args, ty: _ } => {
            tast_expr_exits(function) || tast_exprs_exit(args)
        },
        tast::Expr::Proj { tuple, index: _, ty: _ } => tast_expr_exits(tuple),
        tast::Expr::Index { base, index, ty: _ } => {
            tast_expr_exits(base) || tast_expr_exits(index)
        },
        tast::Expr::Binary { op, lhs: left, rhs: right, ty: _, resolution: _ } => {
            tast_expr_exits(left) || match op {
                ast::BinaryOp::And | ast::BinaryOp::Or => false,
                _ => tast_expr_exits(right),
            }
        },
        tast::Expr::Block { block, ty: _ } => tast_block_exits(block),
        tast::Expr::If { cond: _, then_branch, else_branch, ty: _ } => {
            tast_expr_exits(then_branch) && tast_expr_exits(else_branch)
        },
        tast::Expr::While { cond, body: _, ty: _ } => tast_expr_exits(cond),
        tast::Expr::For {
            pat: _,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body: _,
            ty: _,
        } => tast_expr_exits(iterator),
        tast::Expr::Match { expr: _, arms, ty: _ } => tast_match_arms_exit(arms),
        _ => false,
    }
}

fn exit_expr_as(ctx: Lowerer, value: Expr, ty: tast::Type) -> Expr {
    let stmts: Vec[LetStmt] = Vec::new();
    stmts.push(LetStmt {
        name: gensym(ctx, "_wild"),
        ty: expr_type(value),
        value,
    });
    Expr::Block {
        block: Block {
                    stmts,
                    tail: Option::Some(missing_expr(ty)),
                },
        ty,
    }
}
