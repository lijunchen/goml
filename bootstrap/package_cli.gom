        } else if argument == "--input" {
            index.set(index.get() + 1);
            let previous_len = inputs.len();
            while index.get() < args.len() && !cli_option(args.get(index.get())) {
                inputs.push(args.get(index.get()));
                index.set(index.get() + 1)
            };
            if inputs.len() == previous_len {
                return Result::Err(value_required_error(
                    "--input <INPUT>...",
                    Option::None,
                ))
            } else {
                ()
            }
        } else if option_string_present(inline_cli_value(argument, "--input")) {
            let value = match inline_cli_value(argument, "--input") {
                Option::Some(value) => value,
                Option::None => "",
            };
            if value == "" {
                return Result::Err(value_required_error(
                    "--input <INPUT>...",
                    Option::None,
                ))
            } else {
                inputs.push(value);
                index.set(index.get() + 1);
                while index.get() < args.len() && !cli_option(args.get(index.get())) {
                    inputs.push(args.get(index.get()));
                    index.set(index.get() + 1)
                }
            }
        } else if argument == "--package" {
            if index.get() + 1 >= args.len()
                || cli_option(args.get(index.get() + 1))
            {
                return Result::Err(value_required_error(
                    "--package <PACKAGE>",
                    Option::None,
                ))
            } else {
                packages.push(args.get(index.get() + 1));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--package")) {
            match inline_cli_value(argument, "--package") {
                Option::Some(value) => packages.push(value),
                Option::None => (),
            };
            index.set(index.get() + 1)
        } else if argument == "--output" {
            if index.get() + 1 >= args.len()
                || cli_option(args.get(index.get() + 1))
            {
                return Result::Err(value_required_error(
                    "--output <OUTPUT>",
                    Option::None,
                ))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(Option::Some(args.get(index.get() + 1)));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--output")) {
            if option_string_empty(inline_cli_value(argument, "--output")) {
                return Result::Err(value_required_error(
                    "--output <OUTPUT>",
                    Option::None,
                ))
            } else if option_string_present(output.get()) {
                return Result::Err(repeated_argument_error(command, "--output <OUTPUT>"))
            } else {
                output.set(inline_cli_value(argument, "--output"));
                index.set(index.get() + 1)
            }
        } else if argument == "--manifest" {
            if index.get() + 1 >= args.len()
                || cli_option(args.get(index.get() + 1))
            {
                return Result::Err(value_required_error(
                    "--manifest <MANIFEST>",
                    Option::None,
                ))
            } else if option_string_present(manifest.get()) {
                return Result::Err(repeated_argument_error(
                    command,
                    "--manifest <MANIFEST>",
                ))
            } else {
                manifest.set(Option::Some(args.get(index.get() + 1)));
                index.set(index.get() + 2)
            }
        } else if option_string_present(inline_cli_value(argument, "--manifest")) {
            if option_string_empty(inline_cli_value(argument, "--manifest")) {
                return Result::Err(value_required_error(
                    "--manifest <MANIFEST>",
                    Option::None,
                ))
            } else if option_string_present(manifest.get()) {
                return Result::Err(repeated_argument_error(
                    command,
                    "--manifest <MANIFEST>",
                ))
            } else {
                manifest.set(inline_cli_value(argument, "--manifest"));
                index.set(index.get() + 1)
            }
        } else {
            match similar_cli_argument(command, argument) {
                Option::Some(similar) => return Result::Err(
                    unexpected_similar_argument_error(
                        argument,
                        similar,
                        command_usage(command),
                    ),
                ),
                Option::None => return Result::Err(unexpected_argument_error(
                    command,
                    argument,
                    false,
                )),
            }
        }
    };
    let missing = Vec::new();
    if inputs.len() == 0 {
        missing.push("--input <INPUT>...")
    } else {
        ()
    };
    if packages.len() == 0 {
        missing.push("--package <PACKAGE>")
    } else {
        ()
    };
    if !option_string_present(output.get()) {
        missing.push("--output <OUTPUT>")
    } else {
        ()
    };
    if !option_string_present(manifest.get()) {
        missing.push("--manifest <MANIFEST>")
    } else {
        ()
    };
    if missing.len() > 0 {
        Result::Err(missing_required_arguments_error(command, missing))
    } else {
        Result::Ok(TestLinkCommandArgs {
            inputs,
            packages,
            output: match output.get() {
                Option::Some(value) => value,
                Option::None => "",
            },
            manifest: match manifest.get() {
                Option::Some(value) => value,
                Option::None => "",
            },
        })
    }
}

fn absolute_path(value: string) -> Result[string, string] {
    path::absolute(value)
}

fn absolute_paths(values: Vec[string]) -> Result[Vec[string], string] {
    let result = Vec::new();
    for value in values {
        match absolute_path(value) {
            Result::Ok(value) => result.push(value),
            Result::Err(error) => return Result::Err(error),
        }
    };
    Result::Ok(result)
}

fn source_artifact(args: PackageCommandArgs) -> Result[SourceArtifact, string] {
    match absolute_paths(args.inputs) {
        Result::Ok(sources) => match absolute_paths(args.interface_paths) {
            Result::Ok(dependencies) => Result::Ok(SourceArtifact {
                package_name: args.package_name,
                sources,
                source_paths: args.inputs,
                dependencies,
            }),
            Result::Err(error) => Result::Err(error),
        },
        Result::Err(error) => Result::Err(error),
    }
}

fn encode_source_artifact(value: SourceArtifact) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string("gomlc-selfhost-source-v1\n");
    builder.write_string("package\t");
    builder.write_string(value.package_name);
    builder.write_char('\n');
    for source in value.sources {
        builder.write_string("source\t");
        builder.write_string(source);
        builder.write_char('\n')
    };
    for source_path in value.source_paths {
        builder.write_string("source-path\t");
        builder.write_string(source_path);
        builder.write_char('\n')
    };
    for dependency in value.dependencies {
        builder.write_string("dependency\t");
        builder.write_string(dependency);
        builder.write_char('\n')
    };
    builder.finish()
}

fn artifact_lines(value: string) -> Vec[string] {
    let result = Vec::new();
    let start = Ref::new(0);
    for index in range(0, value.byte_len()) {
        if value.byte_slice(index, index + 1) == "\n" {
            result.push(value.byte_slice(start.get(), index));
            start.set(index + 1)
        } else {
            ()
        }
    };
    if start.get() < value.byte_len() {
        result.push(value.byte_slice(start.get(), value.byte_len()))
    } else {
        ()
    };
    result
}

fn artifact_field(line: string, name: string) -> Option[string] {
    let prefix = name + "\t";
    if line.byte_len() >= prefix.byte_len()
        && line.byte_slice(0, prefix.byte_len()) == prefix
    {
        Option::Some(line.byte_slice(prefix.byte_len(), line.byte_len()))
    } else {
        Option::None
    }
}

fn decode_source_artifact(value: string) -> Result[SourceArtifact, string] {
    let lines = artifact_lines(value);
    if lines.len() == 0 || lines.get(0) != "gomlc-selfhost-source-v1" {
        return Result::Err("unsupported compiler artifact")
    } else {
        ()
    };
    let package_name: Ref[Option[string]] = Ref::new(Option::None);
    let sources = Vec::new();
    let source_paths = Vec::new();
    let dependencies = Vec::new();
    for index in range(1, lines.len()) {
        let line = lines.get(index);
        match artifact_field(line, "package") {
            Option::Some(value) => package_name.set(Option::Some(value)),
            Option::None => match artifact_field(line, "source") {
                Option::Some(value) => sources.push(value),
                Option::None => match artifact_field(line, "source-path") {
                    Option::Some(value) => source_paths.push(value),
                    Option::None => match artifact_field(line, "dependency") {
                        Option::Some(value) => dependencies.push(value),
                        Option::None => if line == "" {
                            ()
                        } else {
                            return Result::Err("invalid compiler artifact field")
                        },
                    },
                },
            },
        }
    };
    match package_name.get() {
        Option::Some(package_name) => if sources.len() > 0 {
            let normalized_paths = if source_paths.len() == sources.len() {
                source_paths
            } else {
                sources
            };
            Result::Ok(SourceArtifact {
                package_name,
                sources,
                source_paths: normalized_paths,
                dependencies,
            })
        } else {
            Result::Err("compiler artifact has no sources")
        },
        Option::None => Result::Err("compiler artifact has no package"),
    }
}

fn read_source_artifact(path: string) -> Result[SourceArtifact, string] {
    match fs::read_file(path) {
        Result::Ok(value) => decode_source_artifact(value),
        Result::Err(error) => Result::Err(error),
    }
}

fn ensure_parent(path_value: string) -> Result[unit, string] {
    match path::parent(path_value) {
        Option::Some(parent) => fs::create_dir_all(parent),
        Option::None => Result::Ok(()),
    }
}

fn write_artifact(path_value: string, value: SourceArtifact) -> Result[unit, string] {
    match ensure_parent(path_value) {
        Result::Ok(()) => fs::write_file(path_value, encode_source_artifact(value)),
        Result::Err(error) => Result::Err(error),
    }
}

fn interface_output_path(output: string) -> string {
    path::with_extension(output, "interface")
}

fn core_output_path(output: string) -> string {
    path::with_extension(output, "core")
}
