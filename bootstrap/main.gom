package main;

use gomlang::parser::ast;
use gomlang::parser::anf;
use gomlang::parser::cst;
use gomlang::parser::core;
use gomlang::parser::go_backend;
use gomlang::parser::hir;
use gomlang::parser::lexer;
use gomlang::parser::lift;
use gomlang::parser::mono;
use gomlang::parser::parser;
use gomlang::parser::tast;
use std::env;
use std::fs;
use std::io;
use std::process;

struct RunArgs {
    file: string,
    dump_ast: bool,
    dump_hir: bool,
    dump_tast: bool,
    dump_core: bool,
    dump_mono: bool,
    dump_lift: bool,
    dump_anf: bool,
    dump_go: bool,
}

fn fail(message: string) -> unit {
    io::eprintln(message);
    process::exit(1)
}

fn read_source(path: string) -> string {
    match fs::read_file(path) {
        Result::Ok(source) => source,
        Result::Err(error) => {
            fail("failed to read " + path + ": " + error);
            ""
        },
    }
}

fn parse_run_args(args: Vec[string]) -> Result[RunArgs, string] {
    let file: Ref[Option[string]] = Ref::new(Option::None);
    let dump_ast = Ref::new(false);
    let dump_hir = Ref::new(false);
    let dump_tast = Ref::new(false);
    let dump_core = Ref::new(false);
    let dump_mono = Ref::new(false);
    let dump_lift = Ref::new(false);
    let dump_anf = Ref::new(false);
    let dump_go = Ref::new(false);
    for index in range(2, args.len()) {
        let argument = args.get(index);
        if argument == "--dump-ast" {
            dump_ast.set(true)
        } else if argument == "--dump-hir" {
            dump_hir.set(true)
        } else if argument == "--dump-tast" {
            dump_tast.set(true)
        } else if argument == "--dump-core" {
            dump_core.set(true)
        } else if argument == "--dump-mono" {
            dump_mono.set(true)
        } else if argument == "--dump-lift" {
            dump_lift.set(true)
        } else if argument == "--dump-anf" {
            dump_anf.set(true)
        } else if argument == "--dump-go" {
            dump_go.set(true)
        } else if argument.byte_len() > 0 && argument.byte_slice(0, 1) == "-" {
            return Result::Err("unknown argument: " + argument)
        } else {
            match file.get() {
                Option::Some(_) => return Result::Err("multiple input files"),
                Option::None => file.set(Option::Some(argument)),
            }
        }
    };
    match file.get() {
        Option::Some(value) => Result::Ok(RunArgs {
            file: value,
            dump_ast: dump_ast.get(),
            dump_hir: dump_hir.get(),
            dump_tast: dump_tast.get(),
            dump_core: dump_core.get(),
            dump_mono: dump_mono.get(),
            dump_lift: dump_lift.get(),
            dump_anf: dump_anf.get(),
            dump_go: dump_go.get(),
        }),
        Option::None => Result::Err("missing input file"),
    }
}

fn run_stage(args: Vec[string]) -> unit {
    if args.len() != 3 {
        fail("usage: gomlang-parser <lex|cst|ast|hir|tast|core|mono|lift|anf|go> <file>")
    } else if args.get(1) == "lex" {
        io::print(lexer::encode_tokens(lexer::lex(read_source(args.get(2)))))
    } else if args.get(1) == "cst" {
        io::print(cst::encode(parser::parse(read_source(args.get(2)))))
    } else if args.get(1) == "ast" {
        io::print(ast::encode(ast::lower(parser::parse(read_source(args.get(2))))))
    } else if args.get(1) == "hir" {
        let source = read_source(args.get(2));
        io::print(hir::encode(hir::lower(
            ast::lower(parser::parse(source)),
            args.get(2),
        )))
    } else if args.get(1) == "tast" {
        let source = read_source(args.get(2));
        io::print(tast::encode(tast::check(hir::lower(
            ast::lower(parser::parse(source)),
            args.get(2),
        ))))
    } else if args.get(1) == "core" {
        let source = read_source(args.get(2));
        io::print(core::encode(core::lower(tast::check(hir::lower(
            ast::lower(parser::parse(source)),
            args.get(2),
        )))))
    } else if args.get(1) == "mono" {
        let source = read_source(args.get(2));
        io::print(mono::encode(mono::lower(core::lower(tast::check(hir::lower(
            ast::lower(parser::parse(source)),
            args.get(2),
        ))))))
    } else if args.get(1) == "lift" {
        let source = read_source(args.get(2));
        io::print(lift::encode(lift::lower(mono::lower(core::lower(tast::check(
            hir::lower(
                ast::lower(parser::parse(source)),
                args.get(2),
            ),
        ))))))
    } else if args.get(1) == "anf" {
        let source = read_source(args.get(2));
        io::print(anf::encode(anf::lower(lift::lower(mono::lower(core::lower(
            tast::check(hir::lower(
                ast::lower(parser::parse(source)),
                args.get(2),
            )),
        ))))))
    } else if args.get(1) == "go" {
        let source = read_source(args.get(2));
        io::print(go_backend::encode(go_backend::lower(anf::lower(lift::lower(
            mono::lower(core::lower(tast::check(hir::lower(
                ast::lower(parser::parse(source)),
                args.get(2),
            )))),
        )))))
    } else {
        fail("unknown mode: " + args.get(1))
    }
}

fn main() -> unit {
    let args = env::args();
    if args.len() > 1 && args.get(1) == "version" {
        run_version(args)
    } else if args.len() > 1 && args.get(1) == "check" {
        run_package_command(args, false)
    } else if args.len() > 1 && args.get(1) == "test-check" {
        run_package_command(args, false)
    } else if args.len() > 1 && args.get(1) == "build" {
        run_package_command(args, true)
    } else if args.len() > 1 && args.get(1) == "test-build" {
        run_package_command(args, true)
    } else if args.len() > 1 && args.get(1) == "link" {
        run_link_command(args)
    } else if args.len() > 1 && args.get(1) == "test-link" {
        run_test_link_command(args)
    } else if args.len() > 1 && args.get(1) == "run-single" {
        match parse_run_args(args) {
            Result::Ok(run_args) => run_single(run_args),
            Result::Err(error) => fail(error),
        }
    } else {
        run_stage(args)
    }
}
