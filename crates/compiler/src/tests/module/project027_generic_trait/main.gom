package main;

use generic_iter::convert;
use convert::Convert;

fn scoped_convert[T, V: convert::Convert[T]](value: V) -> T {
    value.convert()
}

fn main() -> unit {
    println(convert::Convert[int32]::convert(convert::token()));
    println(convert::Convert[string]::convert(convert::token()));
    let number: int32 = convert::convert_to(convert::token());
    let text: string = convert::convert_to(convert::token());
    let scoped: int32 = scoped_convert(convert::token());
    println(number);
    println(text);
    println(scoped);
}
