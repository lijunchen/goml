  let vlen/49 = inherent#Vec#Vec[dynDisplay]#len(v/48) in
  let delta/50 = match vlen/49 {
    2 => {
      3
    },
    _ => 5,
  } in
  let mtmp28 = println(s0/45) in
  {
    let mtmp29 = println(s1/46) in
    {
      let mtmp30 = println(s2/47) in
      {
        let i/51 = inherent#Ref#Ref[int32]#new(0) in
        let mtmp33 = while (inherent#Ref#Ref[int32]#get(i/51) < 3) {
            {
              let line/52 = bump_and_show(dc/42, delta/50) in
              let _wild31 = println(line/52) in
              let mtmp32 = inherent#Ref#Ref[int32]#set(i/51, (inherent#Ref#Ref[int32]#get(i/51) + 1)) in
              {
                ()
              }
            }
        } in
