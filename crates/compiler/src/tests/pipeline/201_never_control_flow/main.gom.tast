fn choose(flag/0: bool) -> int32 {
    let value/1: int32 = if (flag/0 : bool) {
        {
            return 10
        }
    } else {
        {
            20
        }
    };
    (value/1 : int32) + 1
}

fn continue_branch() -> unit {
    let count/2: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while (Ref[int]::get : (Ref[int]) -> int)((count/2 : Ref[int])) < 2 {
        {
            (Ref[int]::set : (Ref[int], int) -> unit)((count/2 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((count/2 : Ref[int])) + 1);
            let value/3: int = if (Ref[int]::get : (Ref[int]) -> int)((count/2 : Ref[int])) == 1 {
                {
                    continue
                }
            } else {
                {
                    7
                }
            };
            (println : (int) -> unit)((value/3 : int))
        }
    }
}

fn break_branch(stop/4: bool) -> unit {
    while true {
        {
            let value/5: int = if (stop/4 : bool) {
                {
                    break
                }
            } else {
                {
                    9
                }
            };
            (println : (int) -> unit)((value/5 : int));
            break
        }
    }
}

fn main() -> unit {
    (println : (int32) -> unit)((choose : (bool) -> int32)(false));
    (println : (int32) -> unit)((choose : (bool) -> int32)(true));
    (continue_branch : () -> unit)();
    (break_branch : (bool) -> unit)(false);
    (break_branch : (bool) -> unit)(true)
}