package main
file main.gom
  trait Mark {
      fn mark(Self) -> string;
    }
    
    trait Label {
      fn label(Self) -> string;
    }
    
    struct Box[T] {
        value: T,
    }
    
    impl Mark for int32 {
      fn mark(local/1/0: int32) -> string {
          self/0.to_string()
      }
    }
    
    impl[T: Mark] Label for Box[T] {
      fn label(local/1/1: Box[T]) -> string {
          "blanket:" + self/1.value.mark()
      }
    }
    
    impl Label for Box[string] {
      fn label(local/1/2: Box[string]) -> string {
          "string:" + self/2.value
      }
    }
    
    fn main() -> unit {
        println(Box {
              value: "text"
          }.label());
        println(Box {
              value: 7
          }.label());
    }