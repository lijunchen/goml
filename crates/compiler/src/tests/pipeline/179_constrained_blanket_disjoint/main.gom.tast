impl Mark for int32{
  fn mark(self/0: int32) -> string {
      (int32::to_string : (int32) -> string)((self/0 : int32))
  }
}

impl Label for Box[T]{
  fn label(self/1: Box[T]) -> string {
      "blanket:" + (Mark::mark : (T) -> string)((self/1 : Box[T]).value)
  }
}

impl Label for Box[string]{
  fn label(self/2: Box[string]) -> string {
      "string:" + (self/2 : Box[string]).value
  }
}

fn main() -> unit {
    (println : (string) -> unit)((Label::label : (Box[string]) -> string)(Box { value: "text" }));
    (println : (string) -> unit)((Label::label : (Box[int32]) -> string)(Box { value: 7 }));
}