fn make_point(base/0: int32) -> Point {
  join ret61(retv62: Point) -> Point {
    retv62
  } in
  let t63 = (base/0 + 1) in
  let t64 = Point { x: base/0, y: t63 } in
  jump ret61(t64)
}

fn sum_point(p/1: Point) -> int32 {
  join ret65(retv66: int32) -> int32 {
    retv66
  } in
  let t67 = Point.x(p/1) in
  let t68 = Point.y(p/1) in
  let t69 = (t67 + t68) in
  jump ret65(t69)
}

fn main() -> int32 {
  join ret70(retv71: int32) -> int32 {
    retv71
  } in
  let p/2 = make_point(5) in
  let t72 = Point.x(p/2) in
  let t73 = (t72 + 1) in
  let t74 = Point.y(p/2) in
  let t75 = (t74 - 2) in
  let shifted/3 = Point { x: t73, y: t75 } in
  let t76 = Point.x(shifted/3) in
  let t77 = sum_point(shifted/3) in
  let t78 = (t76 + t77) in
  jump ret70(t78)
}