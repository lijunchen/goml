fn make_point(base/0: int32) -> Point {
  join ret7(retv8: Point) -> Point {
    retv8
  } in
  let t9 = (base/0 + 1) in
  let t10 = Point { x: base/0, y: t9 } in
  jump ret7(t10)
}

fn sum_point(p/1: Point) -> int32 {
  join ret11(retv12: int32) -> int32 {
    retv12
  } in
  let t13 = Point.x(p/1) in
  let t14 = Point.y(p/1) in
  let t15 = (t13 + t14) in
  jump ret11(t15)
}

fn main() -> int32 {
  join ret16(retv17: int32) -> int32 {
    retv17
  } in
  let p/2 = make_point(5) in
  let t18 = Point.x(p/2) in
  let t19 = (t18 + 1) in
  let t20 = Point.y(p/2) in
  let t21 = (t20 - 2) in
  let shifted/3 = Point { x: t19, y: t21 } in
  let t22 = Point.x(shifted/3) in
  let t23 = sum_point(shifted/3) in
  let t24 = (t22 + t23) in
  jump ret16(t24)
}