fn make_point(base/0: int32) -> Point {
  join ret58(retv59: Point) -> Point {
    retv59
  } in
  let t60 = (base/0 + 1) in
  let t61 = Point { x: base/0, y: t60 } in
  jump ret58(t61)
}

fn sum_point(p/1: Point) -> int32 {
  join ret62(retv63: int32) -> int32 {
    retv63
  } in
  let t64 = Point.x(p/1) in
  let t65 = Point.y(p/1) in
  let t66 = (t64 + t65) in
  jump ret62(t66)
}

fn main() -> int32 {
  join ret67(retv68: int32) -> int32 {
    retv68
  } in
  let p/2 = make_point(5) in
  let t69 = Point.x(p/2) in
  let t70 = (t69 + 1) in
  let t71 = Point.y(p/2) in
  let t72 = (t71 - 2) in
  let shifted/3 = Point { x: t70, y: t72 } in
  let t73 = Point.x(shifted/3) in
  let t74 = sum_point(shifted/3) in
  let t75 = (t73 + t74) in
  jump ret67(t75)
}