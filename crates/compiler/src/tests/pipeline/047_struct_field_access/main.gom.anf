fn make_point(base/0: int32) -> Point {
  join ret4(retv5: Point) -> Point {
    retv5
  } in
  let t6 = (base/0 + 1) in
  let t7 = Point { x: base/0, y: t6 } in
  jump ret4(t7)
}

fn sum_point(p/1: Point) -> int32 {
  join ret8(retv9: int32) -> int32 {
    retv9
  } in
  let t10 = Point.x(p/1) in
  let t11 = Point.y(p/1) in
  let t12 = (t10 + t11) in
  jump ret8(t12)
}

fn main() -> int32 {
  join ret13(retv14: int32) -> int32 {
    retv14
  } in
  let p/2 = make_point(5) in
  let t15 = Point.x(p/2) in
  let t16 = (t15 + 1) in
  let t17 = Point.y(p/2) in
  let t18 = (t17 - 2) in
  let shifted/3 = Point { x: t16, y: t18 } in
  let t19 = Point.x(shifted/3) in
  let t20 = sum_point(shifted/3) in
  let t21 = (t19 + t20) in
  jump ret13(t21)
}