fn make_point(base/0: int32) -> Point {
  join ret22(retv23: Point) -> Point {
    retv23
  } in
  let t24 = (base/0 + 1) in
  let t25 = Point { x: base/0, y: t24 } in
  jump ret22(t25)
}

fn sum_point(p/1: Point) -> int32 {
  join ret26(retv27: int32) -> int32 {
    retv27
  } in
  let t28 = Point.x(p/1) in
  let t29 = Point.y(p/1) in
  let t30 = (t28 + t29) in
  jump ret26(t30)
}

fn main() -> int32 {
  join ret31(retv32: int32) -> int32 {
    retv32
  } in
  let p/2 = make_point(5) in
  let t33 = Point.x(p/2) in
  let t34 = (t33 + 1) in
  let t35 = Point.y(p/2) in
  let t36 = (t35 - 2) in
  let shifted/3 = Point { x: t34, y: t36 } in
  let t37 = Point.x(shifted/3) in
  let t38 = sum_point(shifted/3) in
  let t39 = (t37 + t38) in
  jump ret31(t39)
}