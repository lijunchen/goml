package main;
trait Convert[T] {
  fn convert(Self) -> T;
}

struct Token {
}

impl Convert[int32] for Token {
  fn convert(self: Token) -> int32 {
      7
  }
}

impl Convert[string] for Token {
  fn convert(self: Token) -> string {
      "seven"
  }
}

fn convert_to(value: V) -> T {
    value.convert()
}

trait Marker[T] {
  fn marker(Self) -> string;
}

struct Any {
}

impl[T] Marker[T] for Any {
  fn marker(self: Any) -> string {
      "marked"
  }
}

struct Counter {
    current: Ref[int32],
    end: int32,
}

impl Counter {
  fn new(start: int32, end: int32) -> Self {
      Counter {
          current: Ref::new(start),
          end: end
      }
  }
}

impl Iterator for Counter {
  type Item = int32;
  fn next(self: Self) -> Option[int32] {
      let current = self.current.get();
      if current < self.end {
          {
              self.current.set(current + 1);
              Option::Some(current)
          }
      } else {
          {
              Option::None
          }
      }
  }
}

fn main() -> unit {
    println(Convert::[int32]::convert(Token {}));
    println(Convert::[string]::convert(Token {}));
    let converted: int32 = convert_to(Token {});
    println(converted);
    println(Marker::[int32]::marker(Any {}));
    println(Marker::[string]::marker(Any {}));
    println(Marker::[Vec[int32]]::marker(Any {}));
    let mapped = iterator_map(Counter::new(0, 8), |value: int32| value * 2);
    let filtered = iterator_filter(mapped, |value: int32| value > 4);
    let limited = iterator_take(filtered, 3);
    for value in limited {
        println(value);
    };
    let sum = iterator_fold(range(1, 5), 0, |total: int32, value: int32| {
          total + value
      });
    println(sum);
    let texts: Vec[string] = iterator_collect(iterator_map(range(1, 4), |value: int32| "v" + value.to_string()));
    for text in texts {
        println(text);
    };
}

