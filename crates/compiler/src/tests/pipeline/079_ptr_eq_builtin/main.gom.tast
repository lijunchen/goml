fn main() -> unit {
    let a/0: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])(1);
    let b/1: Ref[int32] = (a/0 : Ref[int32]);
    let c/2: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])(1);
    (println : (bool) -> unit)((@intrinsic(ref.ptr_eq) : (Ref[int32], Ref[int32]) -> bool)((a/0 : Ref[int32]), (b/1 : Ref[int32])));
    (println : (bool) -> unit)((@intrinsic(ref.ptr_eq) : (Ref[int32], Ref[int32]) -> bool)((a/0 : Ref[int32]), (c/2 : Ref[int32])));
}