fn inherent#Vec#Vec[T]#pushed(self/73: Vec[T], elem/74: T) -> Vec[T] {
  let result/75 = inherent#Vec#Vec[T]#new() in
  let index/76 = inherent#Ref#Ref[int32]#new(0) in
  let _wild2 = while (inherent#Ref#Ref[int32]#get(index/76) < inherent#Vec#Vec[T]#len(self/73)) {
      {
        let _wild0 = inherent#Vec#Vec[T]#push(result/75, inherent#Vec#Vec[T]#get(self/73, inherent#Ref#Ref[int32]#get(index/76))) in
        let _wild1 = inherent#Ref#Ref[int32]#set(index/76, (inherent#Ref#Ref[int32]#get(index/76) + 1)) in
      }
  } in
  let _wild3 = inherent#Vec#Vec[T]#push(result/75, elem/74) in
  result/75
}

