fn test_int_comparisons() -> unit {
  let a/0 = 10 in
  let b/1 = 20 in
  let c/2 = 10 in
  let less/3 = (a/0 < b/1) in
  let mtmp4 = println(("10 < 20: " + trait_impl#ToString#bool#to_string(less/3))) in
  {
    let greater/4 = (b/1 > a/0) in
    let mtmp5 = println(("20 > 10: " + trait_impl#ToString#bool#to_string(greater/4))) in
    {
      let less_eq1/5 = (a/0 <= b/1) in
      let mtmp6 = println(("10 <= 20: " + trait_impl#ToString#bool#to_string(less_eq1/5))) in
      {
        let less_eq2/6 = (a/0 <= c/2) in
        let mtmp7 = println(("10 <= 10: " + trait_impl#ToString#bool#to_string(less_eq2/6))) in
        {
          let greater_eq1/7 = (b/1 >= a/0) in
          let mtmp8 = println(("20 >= 10: " + trait_impl#ToString#bool#to_string(greater_eq1/7))) in
          {
            let greater_eq2/8 = (c/2 >= a/0) in
            let mtmp9 = println(("10 >= 10: " + trait_impl#ToString#bool#to_string(greater_eq2/8))) in
            {
              let eq1/9 = (a/0 == c/2) in
              let mtmp10 = println(("10 == 10: " + trait_impl#ToString#bool#to_string(eq1/9))) in
              {
                let eq2/10 = (a/0 == b/1) in
                let mtmp11 = println(("10 == 20: " + trait_impl#ToString#bool#to_string(eq2/10))) in
                {
                  let neq1/11 = (a/0 != b/1) in
                  let mtmp12 = println(("10 != 20: " + trait_impl#ToString#bool#to_string(neq1/11))) in
                  {
                    let neq2/12 = (a/0 != c/2) in
                    let mtmp13 = println(("10 != 10: " + trait_impl#ToString#bool#to_string(neq2/12))) in
                    {
                      ()
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn test_float_comparisons() -> unit {
  let x/13 = 3.14 in
  let y/14 = 2.71 in
  let z/15 = 3.14 in
  let less/16 = (y/14 < x/13) in
  let mtmp14 = println(("2.71 < 3.14: " + trait_impl#ToString#bool#to_string(less/16))) in
  {
    let greater/17 = (x/13 > y/14) in
    let mtmp15 = println(("3.14 > 2.71: " + trait_impl#ToString#bool#to_string(greater/17))) in
    {
      let less_eq1/18 = (y/14 <= x/13) in
      let mtmp16 = println(("2.71 <= 3.14: " + trait_impl#ToString#bool#to_string(less_eq1/18))) in
      {
        let less_eq2/19 = (x/13 <= z/15) in
        let mtmp17 = println(("3.14 <= 3.14: " + trait_impl#ToString#bool#to_string(less_eq2/19))) in
        {
          let greater_eq1/20 = (x/13 >= y/14) in
          let mtmp18 = println(("3.14 >= 2.71: " + trait_impl#ToString#bool#to_string(greater_eq1/20))) in
          {
            let greater_eq2/21 = (z/15 >= x/13) in
            let mtmp19 = println(("3.14 >= 3.14: " + trait_impl#ToString#bool#to_string(greater_eq2/21))) in
            {
              let eq1/22 = (x/13 == z/15) in
              let mtmp20 = println(("3.14 == 3.14: " + trait_impl#ToString#bool#to_string(eq1/22))) in
              {
                let eq2/23 = (x/13 == y/14) in
                let mtmp21 = println(("3.14 == 2.71: " + trait_impl#ToString#bool#to_string(eq2/23))) in
                {
                  let neq1/24 = (x/13 != y/14) in
                  let mtmp22 = println(("3.14 != 2.71: " + trait_impl#ToString#bool#to_string(neq1/24))) in
                  {
                    let neq2/25 = (x/13 != z/15) in
                    let mtmp23 = println(("3.14 != 3.14: " + trait_impl#ToString#bool#to_string(neq2/25))) in
                    {
                      ()
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn main() -> unit {
  let mtmp24 = println("=== Integer Comparisons ===") in
  {
    let mtmp25 = test_int_comparisons() in
    {
      let mtmp26 = println("") in
      {
        let mtmp27 = println("=== Float Comparisons ===") in
        {
          let mtmp28 = test_float_comparisons() in
          {
            ()
          }
        }
      }
    }
  }
}