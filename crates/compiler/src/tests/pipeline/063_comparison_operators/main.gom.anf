fn test_float_comparisons() -> unit {
  join ret53() -> unit {
    ()
  } in
  let x/13 = 3.14 in
  let y/14 = 2.71 in
  let z/15 = 3.14 in
  let less/16 = (y/14 < x/13) in
  let t54 = trait_impl#ToString#bool#to_string(less/16) in
  let t55 = ("2.71 < 3.14: " + t54) in
  let mtmp17 = println__T_string(t55) in
