  let less_eq2/19 = (x/13 <= z/15) in
  let t114 = trait_impl#ToString#bool#to_string(less_eq2/19) in
  let t115 = ("3.14 <= 3.14: " + t114) in
  let mtmp74 = println__T_string(t115) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let t116 = trait_impl#ToString#bool#to_string(greater_eq1/20) in
  let t117 = ("3.14 >= 2.71: " + t116) in
  let mtmp75 = println__T_string(t117) in
  let greater_eq2/21 = (z/15 >= x/13) in
