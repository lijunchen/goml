  let less_eq1/18 = (y/14 <= x/13) in
  let t114 = trait_impl#ToString#bool#to_string(less_eq1/18) in
  let t115 = ("2.71 <= 3.14: " + t114) in
  let mtmp73 = println__T_string(t115) in
  let less_eq2/19 = (x/13 <= z/15) in
  let t116 = trait_impl#ToString#bool#to_string(less_eq2/19) in
  let t117 = ("3.14 <= 3.14: " + t116) in
  let mtmp74 = println__T_string(t117) in
  let greater_eq1/20 = (x/13 >= y/14) in
  let t118 = trait_impl#ToString#bool#to_string(greater_eq1/20) in
  let t119 = ("3.14 >= 2.71: " + t118) in
  let mtmp75 = println__T_string(t119) in
  let greater_eq2/21 = (z/15 >= x/13) in
  let t120 = trait_impl#ToString#bool#to_string(greater_eq2/21) in
  let t121 = ("3.14 >= 3.14: " + t120) in
  let mtmp76 = println__T_string(t121) in
  let eq1/22 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let t122 = trait_impl#ToString#bool#to_string(eq1/22) in
  let t123 = ("3.14 == 3.14: " + t122) in
  let mtmp77 = println__T_string(t123) in
  let eq2/23 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let t124 = trait_impl#ToString#bool#to_string(eq2/23) in
  let t125 = ("3.14 == 2.71: " + t124) in
  let mtmp78 = println__T_string(t125) in
  let t126 = trait_impl#Eq#float64#eq(x/13, y/14) in
  let neq1/24 = (!t126) in
  let t127 = trait_impl#ToString#bool#to_string(neq1/24) in
  let t128 = ("3.14 != 2.71: " + t127) in
  let mtmp79 = println__T_string(t128) in
  let t129 = trait_impl#Eq#float64#eq(x/13, z/15) in
  let neq2/25 = (!t129) in
  let t130 = trait_impl#ToString#bool#to_string(neq2/25) in
  let t131 = ("3.14 != 3.14: " + t130) in
  let mtmp80 = println__T_string(t131) in
  jump ret109()
}

