impl Display for int32{
  fn show(self/0: int32) -> string {
      (int32::to_string : (int32) -> string)((self/0 : int32))
  }
}

fn render(value/1: Boxed) -> string {
    match (value/1 : Boxed) {
        Boxed::One(inner/2: dyn Display) => (dyn Display::show : (dyn Display) -> string)((inner/2 : dyn Display)),
        Boxed::Pair(left/3: dyn Display, right/4: dyn Display) => (dyn Display::show : (dyn Display) -> string)((left/3 : dyn Display)) + "-" + (dyn Display::show : (dyn Display) -> string)((right/4 : dyn Display)),
    }
}

fn main() -> unit {
    let one/5: int32 = 42;
    let left/6: int32 = 7;
    let right/7: int32 = 9;
    (println : (string) -> unit)((render : (Boxed) -> string)(Boxed::One(to_dyn[Display]{int32}((one/5 : int32)))));
    (println : (string) -> unit)((render : (Boxed) -> string)(Boxed::Pair(to_dyn[Display]{int32}((left/6 : int32)), to_dyn[Display]{int32}((right/7 : int32)))));
}