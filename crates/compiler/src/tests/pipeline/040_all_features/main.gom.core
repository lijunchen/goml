fn build_counter(label/42: string, start/43: int32) -> (Tracker, () -> Record[int32], (int32) -> Record[int32], () -> Record[string]) {
  let count/44 = inherent#Ref#Ref[int32]#new(start/43) in
  let toggled/45 = inherent#Ref#Ref[bool]#new(false) in
  let tracker/46 = Tracker { label: label/42, count: count/44, toggled: toggled/45 } in
  let snapshot/47 = || => {
    Record::Value(inherent#Ref#Ref[int32]#get(count/44))
  } in
  let bump/50 = |delta/48: int32| => {
    let before/49 = inherent#Ref#Ref[int32]#get(count/44) in
    let mtmp26 = inherent#Ref#Ref[int32]#set(count/44, (before/49 + delta/48)) in
    {
      Record::Pair(before/49, inherent#Ref#Ref[int32]#get(count/44))
