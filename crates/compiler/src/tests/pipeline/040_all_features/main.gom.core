  let flip/53 = || => {
    let before/51 = inherent#Ref#Ref[bool]#get(toggled/45) in
    let mtmp27 = inherent#Ref#Ref[bool]#set(toggled/45, (!before/51)) in
    {
      let after/52 = inherent#Ref#Ref[bool]#get(toggled/45) in
      Record::Pair(trait_impl#ToString#bool#to_string(before/51), trait_impl#ToString#bool#to_string(after/52))
    }
  } in
  (tracker/46, snapshot/47, bump/50, flip/53)
}

fn main() -> unit {
  let mtmp28 = build_counter("goml", 2) in
  {
    let x29 = mtmp28.0 in
    let x30 = mtmp28.1 in
    let x31 = mtmp28.2 in
    let x32 = mtmp28.3 in
    {
      let flip/57 = x32 in
      {
        let bump/56 = x31 in
        {
          let snapshot/55 = x30 in
          {
            let tracker/54 = x29 in
            {
              let tracker_info/58 = trait_impl#Describe#Tracker#describe(tracker/54) in
              let first_record/59 = snapshot/55() in
              let bumped_record/60 = bump/56(5) in
              let flipped_record/61 = flip/57() in
              let maybe_first/62 = gather(first_record/59) in
              let maybe_second/63 = gather(bumped_record/60) in
              let chosen/64 = choose(true, maybe_second/63, maybe_first/62) in
              let stringified/65 = map_maybe(chosen/64, format_total) in
              let transforms/66 = [increment, triple] in
              let results/67 = run_transforms(4, transforms/66) in
              let first_result/68 = @intrinsic(array.get)(results/67, 0) in
              let second_result/69 = @intrinsic(array.get)(results/67, 1) in
              let order_check/70 = if (first_result/68 < second_result/69) {
                  true
              } else {
                  false
              } in
              let first_text/71 = trait_impl#Describe#Record[int32]#describe(first_record/59) in
              let bumped_text/72 = trait_impl#Describe#Record[int32]#describe(bumped_record/60) in
              let flipped_text/73 = trait_impl#Describe#Record[string]#describe(flipped_record/61) in
              let summary/75 = match stringified/65 {
                Maybe::Some(x33) => {
                  {
                    let x33 = Maybe::Some._0(stringified/65) in
                    {
                      let text/74 = x33 in
                      ("Snapshot: " + text/74)
                    }
                  }
                },
                Maybe::None => {
                  "Snapshot: none"
                },
              } in
              let pair_text/76 = pair_join((inherent#int32#int32#to_string(first_result/68), inherent#int32#int32#to_string(second_result/69))) in
              let bool_text/77 = trait_impl#ToString#bool#to_string(order_check/70) in
              let mtmp34 = println(tracker_info/58) in
              {
                let mtmp35 = println(first_text/71) in
                {
                  let mtmp36 = println(bumped_text/72) in
                  {
                    let mtmp37 = println(flipped_text/73) in
                    {
                      let mtmp38 = println(summary/75) in
                      {
                        let mtmp39 = println(pair_text/76) in
                        {
                          let mtmp40 = println(bool_text/77) in
                          {
                            ()
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}