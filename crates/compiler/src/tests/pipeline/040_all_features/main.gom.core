      let after/52 = inherent#Ref#Ref[bool]#get(toggled/45) in
      Record::Pair(trait_call[ToString::to_string](before/51), trait_call[ToString::to_string](after/52))
    }
  } in
  (tracker/46, snapshot/47, bump/50, flip/53)
}

fn main() -> unit {
  let mtmp46 = build_counter("goml", 2) in
  {
    let x47 = mtmp46.0 in
    let x48 = mtmp46.1 in
    let x49 = mtmp46.2 in
    let x50 = mtmp46.3 in
    {
      let flip/57 = x50 in
      {
        let bump/56 = x49 in
        {
          let snapshot/55 = x48 in
          {
            let tracker/54 = x47 in
            {
              let tracker_info/58 = trait_call[Describe::describe](tracker/54) in
              let first_record/59 = snapshot/55() in
              let bumped_record/60 = bump/56(5) in
              let flipped_record/61 = flip/57() in
              let maybe_first/62 = gather(first_record/59) in
              let maybe_second/63 = gather(bumped_record/60) in
              let chosen/64 = choose(true, maybe_second/63, maybe_first/62) in
              let stringified/65 = map_maybe(chosen/64, format_total) in
              let transforms/66 = [increment, triple] in
              let results/67 = run_transforms(4, transforms/66) in
              let first_result/68 = @intrinsic(array.get)(results/67, 0) in
              let second_result/69 = @intrinsic(array.get)(results/67, 1) in
              let order_check/70 = if (first_result/68 < second_result/69) {
                  true
              } else {
                  false
              } in
              let first_text/71 = trait_call[Describe::describe](first_record/59) in
              let bumped_text/72 = trait_call[Describe::describe](bumped_record/60) in
              let flipped_text/73 = trait_call[Describe::describe](flipped_record/61) in
              let summary/75 = match stringified/65 {
                Maybe::Some(x51) => {
                  {
                    let x51 = Maybe::Some._0(stringified/65) in
                    {
                      let text/74 = x51 in
                      ("Snapshot: " + text/74)
                    }
                  }
                },
                Maybe::None => {
                  "Snapshot: none"
                },
              } in
              let pair_text/76 = pair_join((inherent#int32#int32#to_string(first_result/68), inherent#int32#int32#to_string(second_result/69))) in
              let bool_text/77 = trait_call[ToString::to_string](order_check/70) in
              let mtmp52 = println(tracker_info/58) in
              {
                let mtmp53 = println(first_text/71) in
                {
                  let mtmp54 = println(bumped_text/72) in
                  {
                    let mtmp55 = println(flipped_text/73) in
                    {
                      let mtmp56 = println(summary/75) in
                      {
                        let mtmp57 = println(pair_text/76) in
                        {
                          let mtmp58 = println(bool_text/77) in
                          {
                            ()
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}