package main;
#[derive(Hash, Eq)]
struct FloatKey {
    value: float64,
}

impl Eq for FloatKey {
  fn eq(self: FloatKey, other: FloatKey) -> bool {
      true && Eq::eq(self.value, other.value)
  }
}

impl Hash for FloatKey {
  fn hash(self: FloatKey) -> uint64 {
      let h: uint64 = 14695981039346656037;
      let h = h * 1099511628211 + Hash::hash(self.value);
      h
  }
}

struct CollisionKey {
    value: int32,
}

impl Eq for CollisionKey {
  fn eq(self: CollisionKey, other: CollisionKey) -> bool {
      self.value == other.value
  }
}

impl Hash for CollisionKey {
  fn hash(self: CollisionKey) -> uint64 {
      1
  }
}

fn print_opt_string(value: Option[string]) -> unit {
    match value {
        Option::Some(text) => println(text),
        Option::None => println("none"),
    }
}

fn print_opt_int(value: Option[int32]) -> unit {
    match value {
        Option::Some(number) => println(number),
        Option::None => println("none"),
    }
}

fn float_zero_contracts() -> unit {
    let zero32: float32 = 0;
    let negative_zero32 = -zero32;
    println(Hash::hash(zero32) == Hash::hash(negative_zero32).to_string());
    let values32: HashMap[float32, string] = HashMap::new();
    values32.set(zero32, "f32");
    print_opt_string(values32.get(negative_zero32));
    values32.set(negative_zero32, "f32-updated");
    println(values32.len());
    print_opt_string(values32.get(zero32));
    values32.remove(negative_zero32);
    println(values32.len());
    let zero64: float64 = 0;
    let negative_zero64 = -zero64;
    println(Hash::hash(zero64) == Hash::hash(negative_zero64).to_string());
    let values64: HashMap[float64, string] = HashMap::new();
    values64.set(zero64, "f64");
    print_opt_string(values64.get(negative_zero64));
    let derived: HashMap[FloatKey, string] = HashMap::new();
    derived.set(FloatKey {
          value: zero64
      }, "derived");
    print_opt_string(derived.get(FloatKey {
            value: negative_zero64
        }));
}

fn collision_contracts() -> unit {
    let values: HashMap[CollisionKey, int32] = HashMap::new();
    values.set(CollisionKey {
          value: 1
      }, 10);
    values.set(CollisionKey {
          value: 2
      }, 20);
    values.set(CollisionKey {
          value: 3
      }, 30);
    values.remove(CollisionKey {
          value: 2
      });
    print_opt_int(values.get(CollisionKey {
            value: 1
        }));
    print_opt_int(values.get(CollisionKey {
            value: 2
        }));
    print_opt_int(values.get(CollisionKey {
            value: 3
        }));
    values.set(CollisionKey {
          value: 4
      }, 40);
    println(values.len());
    print_opt_int(values.get(CollisionKey {
            value: 4
        }));
    values.set(CollisionKey {
          value: 4
      }, 41);
    println(values.len());
    print_opt_int(values.get(CollisionKey {
            value: 4
        }));
    values.remove(CollisionKey {
          value: 99
      });
    values.remove(CollisionKey {
          value: 99
      });
    println(values.len());
    let index = Ref::new(0);
    while index.get() < 2000 {
        {
            let key = CollisionKey {
                value: 1000 + index.get()
            };
            values.set(key, index.get());
            values.remove(key);
            index.set(index.get() + 1);
        }
    };
    println(values.len());
}

fn reference_contracts() -> unit {
    let values: HashMap[Ref[CollisionKey], string] = HashMap::new();
    let key = Ref::new(CollisionKey {
          value: 1
      });
    let alias = key;
    let equal_value = Ref::new(CollisionKey {
          value: 1
      });
    values.set(key, "identity");
    println(Eq::eq(key, alias));
    println(Eq::eq(key, equal_value));
    println(Hash::hash(key) == Hash::hash(alias));
    print_opt_string(values.get(alias));
    print_opt_string(values.get(equal_value));
    key.set(CollisionKey {
          value: 99
      });
    print_opt_string(values.get(key));
}

fn main() -> unit {
    float_zero_contracts();
    collision_contracts();
    reference_contracts();
}

