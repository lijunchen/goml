package main;
fn main() -> unit {
    string_println(18318654708.7.to_string());
    string_println(0.0000001.to_string());
    let zero = 0;
    let negative_one = -1;
    string_println(negative_one * zero.to_string());
    string_println(1 / zero.to_string());
    string_println(-1 / zero.to_string());
    string_println(zero / zero.to_string());
    let wide = 12345678;
    string_println(wide.to_string())
}

