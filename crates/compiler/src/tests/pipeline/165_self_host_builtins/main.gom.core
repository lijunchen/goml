fn show_unit(result/0: Result[unit, string]) -> string {
  match result/0 {
    Result::Ok(x0) => {
      {
        let x0 = Result::Ok._0(result/0) in
        "ok"
      }
    },
    Result::Err(x1) => {
      {
        let x1 = Result::Err._0(result/0) in
        {
          let err/1 = x1 in
          ("err " + err/1)
        }
      }
    },
  }
}

fn show_string(result/2: Result[string, string]) -> string {
  match result/2 {
    Result::Ok(x2) => {
      {
        let x2 = Result::Ok._0(result/2) in
        {
          let value/3 = x2 in
          value/3
        }
      }
    },
    Result::Err(x3) => {
      {
        let x3 = Result::Err._0(result/2) in
        {
          let err/4 = x3 in
          ("err " + err/4)
        }
      }
    },
  }
}

fn main() -> unit {
  let _wild4 = std::io::println(string_byte_slice("a你好z", 1, 7)) in
  let _wild5 = std::io::eprint("") in
  let _wild6 = std::io::eprintln("") in
  let _wild7 = std::io::println(show_unit(std::fs::create_dir_all("goml-self-host/nested"))) in
