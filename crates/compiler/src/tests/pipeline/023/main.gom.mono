fn match_mixed_pair(pair/0: (int32, string)) -> int32 {
  {
    let x58 = pair/0.0 in
    let x59 = pair/0.1 in
    match x59 {
      "zero" => {
        match x58 {
          0 => {
            1
          },
          _ => 4,
        }
      },
      "one" => {
        match x58 {
          0 => {
            2
          },
          1 => {
            3
          },
          _ => 5,
        }
      },
      _ => match x58 {
        0 => {
          2
        },
        _ => 5,
      },
    }
  }
}

fn match_mixed_enum(value/1: Mixed) -> int32 {
  match value/1 {
    Mixed::OnlyInt(x60) => {
      {
        let x60 = Mixed::OnlyInt._0(value/1) in
        match x60 {
          0 => {
            6
          },
          _ => 7,
        }
      }
    },
    Mixed::OnlyStr(x61) => {
      {
        let x61 = Mixed::OnlyStr._0(value/1) in
        match x61 {
          "zero" => {
            8
          },
          _ => 9,
        }
      }
    },
    Mixed::Both(x62, x63) => {
      {
        let x62 = Mixed::Both._0(value/1) in
        let x63 = Mixed::Both._1(value/1) in
        match x63 {
          "zero" => {
            match x62 {
              0 => {
                10
              },
              _ => 12,
            }
          },
          _ => match x62 {
            0 => {
              11
            },
            _ => 13,
          },
        }
      }
    },
  }
}

