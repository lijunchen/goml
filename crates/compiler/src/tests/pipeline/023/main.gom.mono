fn match_mixed_pair(pair/0: (int32, string)) -> int32 {
  {
    let x22 = pair/0.0 in
    let x23 = pair/0.1 in
    match x23 {
      "zero" => {
        match x22 {
          0 => {
            1
          },
          _ => 4,
        }
      },
      "one" => {
        match x22 {
          0 => {
            2
          },
          1 => {
            3
          },
          _ => 5,
        }
      },
      _ => match x22 {
        0 => {
          2
        },
        _ => 5,
      },
    }
  }
}

fn match_mixed_enum(value/1: Mixed) -> int32 {
  match value/1 {
    Mixed::OnlyInt(x24) => {
      {
        let x24 = Mixed::OnlyInt._0(value/1) in
        match x24 {
          0 => {
            6
          },
          _ => 7,
        }
      }
    },
    Mixed::OnlyStr(x25) => {
      {
        let x25 = Mixed::OnlyStr._0(value/1) in
        match x25 {
          "zero" => {
            8
          },
          _ => 9,
        }
      }
    },
    Mixed::Both(x26, x27) => {
      {
        let x26 = Mixed::Both._0(value/1) in
        let x27 = Mixed::Both._1(value/1) in
        match x27 {
          "zero" => {
            match x26 {
              0 => {
                10
              },
              _ => 12,
            }
          },
          _ => match x26 {
            0 => {
              11
            },
            _ => 13,
          },
        }
      }
    },
  }
}

