fn match_mixed_pair(pair/0: (int32, string)) -> int32 {
  {
    let x4 = pair/0.0 in
    let x5 = pair/0.1 in
    match x5 {
      "zero" => {
        match x4 {
          0 => {
            1
          },
          _ => 4,
        }
      },
      "one" => {
        match x4 {
          0 => {
            2
          },
          1 => {
            3
          },
          _ => 5,
        }
      },
      _ => match x4 {
        0 => {
          2
        },
        _ => 5,
      },
    }
  }
}

fn match_mixed_enum(value/1: Mixed) -> int32 {
  match value/1 {
    Mixed::OnlyInt(x6) => {
      {
        let x6 = Mixed::OnlyInt._0(value/1) in
        match x6 {
          0 => {
            6
          },
          _ => 7,
        }
      }
    },
    Mixed::OnlyStr(x7) => {
      {
        let x7 = Mixed::OnlyStr._0(value/1) in
        match x7 {
          "zero" => {
            8
          },
          _ => 9,
        }
      }
    },
    Mixed::Both(x8, x9) => {
      {
        let x8 = Mixed::Both._0(value/1) in
        let x9 = Mixed::Both._1(value/1) in
        match x9 {
          "zero" => {
            match x8 {
              0 => {
                10
              },
              _ => 12,
            }
          },
          _ => match x8 {
            0 => {
              11
            },
            _ => 13,
          },
        }
      }
    },
  }
}

fn main() -> unit {
  let mtmp10 = println__T_string(inherent#int32#int32#to_string(match_mixed_pair((0, "zero")))) in
  {
    let mtmp11 = println__T_string(inherent#int32#int32#to_string(match_mixed_pair((0, "other")))) in
    {
      let mtmp12 = println__T_string(inherent#int32#int32#to_string(match_mixed_pair((1, "one")))) in
      {
        let mtmp13 = println__T_string(inherent#int32#int32#to_string(match_mixed_pair((2, "zero")))) in
        {
          let mtmp14 = println__T_string(inherent#int32#int32#to_string(match_mixed_pair((2, "two")))) in
          {
            let mtmp15 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::OnlyInt(0)))) in
            {
              let mtmp16 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::OnlyInt(5)))) in
              {
                let mtmp17 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::OnlyStr("zero")))) in
                {
                  let mtmp18 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::OnlyStr("hello")))) in
                  {
                    let mtmp19 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::Both(0, "zero")))) in
                    {
                      let mtmp20 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::Both(0, "hello")))) in
                      {
                        let mtmp21 = println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::Both(2, "zero")))) in
                        {
                          println__T_string(inherent#int32#int32#to_string(match_mixed_enum(Mixed::Both(3, "three"))))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn inherent#int32#int32#to_string(self/2: int32) -> string {
  @runtime(core.int32_to_string)(self/2)
}

fn trait_impl#ToString#string#to_string(self/9: string) -> string {
  self/9
}