    },
    Shape::Wrapped(x23) => {
      {
        let x23 = Shape::Wrapped._0(shape/0) in
        {
          let inner/2 = x23 in
          Shape::Wrapped(inner/2)
        }
      }
    },
    Shape::Origin => {
      Shape::Origin
    },
  }
}

