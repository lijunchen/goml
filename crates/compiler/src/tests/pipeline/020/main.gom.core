fn bounce_int(shape/0: Shape[int32]) -> Shape[int32] {
  match shape/0 {
    Shape::Dot(x22) => {
      {
        let x22 = Shape::Dot._0(shape/0) in
        {
          let point/1 = x22 in
          Shape::Dot(point/1)
