fn main() -> unit {
  let mtmp37 = println(point32_to_string(Point { x: 3, y: 4 })) in
  {
    let mtmp38 = println(wrapper_int32_to_string(Wrapper { value: 7 })) in
    {
      let mtmp39 = println(wrapper_unit_to_string(Wrapper { value: () })) in
      {
        let bounced_origin/30 = bounce_int(Shape::Origin) in
        let mtmp40 = println(shape_int32_to_string(Shape::Dot(Point { x: 3, y: 4 }))) in
        {
          let mtmp41 = println(shape_int32_to_string(Shape::Wrapped(Wrapper { value: 7 }))) in
          {
            let mtmp42 = println(shape_int32_to_string(bounced_origin/30)) in
            {
              let mtmp43 = println(shape_unit_to_string(Shape::Dot(Point { x: 3, y: 4 }))) in
              {
                let mtmp44 = println(shape_unit_to_string(Shape::Wrapped(Wrapper { value: () }))) in
                {
                  let mtmp45 = println(shape_unit_to_string(Shape::Origin)) in
                  {
                    let mtmp46 = describe(bounce_int(Shape::Origin)) in
                    {
                      println("struct enums!")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}