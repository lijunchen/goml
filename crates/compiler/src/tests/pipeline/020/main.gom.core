fn bounce_int(shape/0: Shape[int32]) -> Shape[int32] {
  match shape/0 {
    Shape::Dot(x4) => {
      {
        let x4 = Shape::Dot._0(shape/0) in
        {
          let point/1 = x4 in
          Shape::Dot(point/1)
        }
      }
    },
    Shape::Wrapped(x5) => {
      {
        let x5 = Shape::Wrapped._0(shape/0) in
        {
          let inner/2 = x5 in
          Shape::Wrapped(inner/2)
        }
      }
    },
    Shape::Origin => {
      Shape::Origin
    },
  }
}

fn wrap_unit(value/3: Wrapper[unit]) -> Shape[unit] {
  Shape::Wrapped(value/3)
}

fn pick(flag/4: bool, point/5: Point, wrapper/6: Wrapper[int32]) -> Shape[int32] {
  match flag/4 {
    true => {
      Shape::Dot(point/5)
    },
    false => {
      Shape::Wrapped(wrapper/6)
    },
  }
}

fn describe(shape/7: Shape[T]) -> int32 {
  match shape/7 {
    Shape::Dot(x6) => {
      {
        let x6 = Shape::Dot._0(shape/7) in
        1
      }
    },
    Shape::Wrapped(x7) => {
      {
        let x7 = Shape::Wrapped._0(shape/7) in
        2
      }
    },
    Shape::Origin => {
      0
    },
  }
}

fn point32_to_string(point/8: Point) -> string {
  let mtmp8 = point/8 in
  {
    let x9 = Point.x(mtmp8) in
    let x10 = Point.y(mtmp8) in
    {
      let y/10 = x10 in
      {
        let x/9 = x9 in
        {
          let with_x/11 = ("Point { x: " + inherent#int32#int32#to_string(x/9)) in
          let with_y_label/12 = (with_x/11 + ", y: ") in
          let with_y/13 = (with_y_label/12 + inherent#int32#int32#to_string(y/10)) in
          (with_y/13 + " }")
        }
      }
    }
  }
}

fn wrapper_int32_to_string(wrapper/14: Wrapper[int32]) -> string {
  let mtmp11 = wrapper/14 in
  {
    let x12 = Wrapper.value(mtmp11) in
    {
      let value/15 = x12 in
      {
        let prefix/16 = ("Wrapper[int32] { value: " + inherent#int32#int32#to_string(value/15)) in
        (prefix/16 + " }")
      }
    }
  }
}

fn wrapper_unit_to_string(wrapper/17: Wrapper[unit]) -> string {
  let mtmp13 = wrapper/17 in
  {
    let x14 = Wrapper.value(mtmp13) in
    {
      let value/18 = x14 in
      {
        let prefix/19 = ("Wrapper[unit] { value: " + trait_impl#ToString#unit#to_string(value/18)) in
        (prefix/19 + " }")
      }
    }
  }
}

fn shape_int32_to_string(shape/20: Shape[int32]) -> string {
  match shape/20 {
    Shape::Dot(x15) => {
      {
        let x15 = Shape::Dot._0(shape/20) in
        {
          let point/21 = x15 in
          {
            let prefix/22 = ("Shape::Dot(" + point32_to_string(point/21)) in
            (prefix/22 + ")")
          }
        }
      }
    },
    Shape::Wrapped(x16) => {
      {
        let x16 = Shape::Wrapped._0(shape/20) in
        {
          let wrapper/23 = x16 in
          {
            let prefix/24 = ("Shape::Wrapped(" + wrapper_int32_to_string(wrapper/23)) in
            (prefix/24 + ")")
          }
        }
      }
    },
    Shape::Origin => {
      "Shape::Origin"
    },
  }
}

fn shape_unit_to_string(shape/25: Shape[unit]) -> string {
  match shape/25 {
    Shape::Dot(x17) => {
      {
        let x17 = Shape::Dot._0(shape/25) in
        {
          let point/26 = x17 in
          {
            let prefix/27 = ("Shape::Dot(" + point32_to_string(point/26)) in
            (prefix/27 + ")")
          }
        }
      }
    },
    Shape::Wrapped(x18) => {
      {
        let x18 = Shape::Wrapped._0(shape/25) in
        {
          let wrapper/28 = x18 in
          {
            let prefix/29 = ("Shape::Wrapped(" + wrapper_unit_to_string(wrapper/28)) in
            (prefix/29 + ")")
          }
        }
      }
    },
    Shape::Origin => {
      "Shape::Origin"
    },
  }
}

fn main() -> unit {
  let mtmp19 = println(point32_to_string(Point { x: 3, y: 4 })) in
  {
    let mtmp20 = println(wrapper_int32_to_string(Wrapper { value: 7 })) in
    {
      let mtmp21 = println(wrapper_unit_to_string(Wrapper { value: () })) in
      {
        let bounced_origin/30 = bounce_int(Shape::Origin) in
        let mtmp22 = println(shape_int32_to_string(Shape::Dot(Point { x: 3, y: 4 }))) in
        {
          let mtmp23 = println(shape_int32_to_string(Shape::Wrapped(Wrapper { value: 7 }))) in
          {
            let mtmp24 = println(shape_int32_to_string(bounced_origin/30)) in
            {
              let mtmp25 = println(shape_unit_to_string(Shape::Dot(Point { x: 3, y: 4 }))) in
              {
                let mtmp26 = println(shape_unit_to_string(Shape::Wrapped(Wrapper { value: () }))) in
                {
                  let mtmp27 = println(shape_unit_to_string(Shape::Origin)) in
                  {
                    let mtmp28 = describe(bounce_int(Shape::Origin)) in
                    {
                      println("struct enums!")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}