fn print(value/0: T) -> unit {
  string_print(trait_call[ToString::to_string](value/0))
}

fn println(value/1: T) -> unit {
  string_println(trait_call[ToString::to_string](value/1))
}

fn sum_to(limit/0: int32) -> int32 {
  let acc/1 = inherent#Ref#Ref[int32]#new(0) in
  let i/2 = inherent#Ref#Ref[int32]#new(0) in
  let mtmp2 = while (inherent#Ref#Ref[int32]#get(i/2) < limit/0) {
      {
        let current/3 = inherent#Ref#Ref[int32]#get(i/2) in
        let mtmp0 = inherent#Ref#Ref[int32]#set(acc/1, (inherent#Ref#Ref[int32]#get(acc/1) + current/3)) in
        {
          let mtmp1 = inherent#Ref#Ref[int32]#set(i/2, (current/3 + 1)) in
          {
            ()
          }
        }
      }
  } in
  {
    inherent#Ref#Ref[int32]#get(acc/1)
  }
}

fn sum_even(limit/4: int32) -> int32 {
  let acc/5 = inherent#Ref#Ref[int32]#new(0) in
  let i/6 = inherent#Ref#Ref[int32]#new(0) in
  let is_even/7 = inherent#Ref#Ref[bool]#new(true) in
  let mtmp5 = while (inherent#Ref#Ref[int32]#get(i/6) < limit/4) {
      {
        let current/8 = inherent#Ref#Ref[int32]#get(i/6) in
        let mtmp3 = inherent#Ref#Ref[int32]#set(i/6, (current/8 + 1)) in
        {
          let add_now/9 = inherent#Ref#Ref[bool]#get(is_even/7) in
          let mtmp4 = inherent#Ref#Ref[bool]#set(is_even/7, (!add_now/9)) in
          {
            if add_now/9 {
                {
                  inherent#Ref#Ref[int32]#set(acc/5, (inherent#Ref#Ref[int32]#get(acc/5) + current/8))
                }
            } else {
                {
                  ()
                }
            }
          }
        }
      }
  } in
  {
    inherent#Ref#Ref[int32]#get(acc/5)
  }
}

fn main() -> unit {
  let first/10 = sum_to(5) in
  let evens/11 = sum_even(6) in
  let mtmp6 = print("sum_to(5)=") in
  {
    let mtmp7 = println(first/10) in
    {
      let mtmp8 = print("sum_even(6)=") in
      {
        let mtmp9 = println(evens/11) in
        {
          ()
        }
      }
    }
  }
}

fn inherent#Ref#Ref[T]#new(value/93: T) -> Ref[T] {
  ref(value/93)
}

fn inherent#Ref#Ref[T]#get(self/94: Ref[T]) -> T {
  ref_get(self/94)
}

fn inherent#Ref#Ref[T]#set(self/95: Ref[T], value/96: T) -> unit {
  ref_set(self/95, value/96)
}