fn sum_to(limit/0: int32) -> int32 {
  let acc/1 = inherent#Ref#Ref[T]#new__T_int32(0) in
  let i/2 = inherent#Ref#Ref[T]#new__T_int32(0) in
  let mtmp2 = while (inherent#Ref#Ref[T]#get__T_int32(i/2) < limit/0) {
      {
        let current/3 = inherent#Ref#Ref[T]#get__T_int32(i/2) in
        let mtmp0 = inherent#Ref#Ref[T]#set__T_int32(acc/1, (inherent#Ref#Ref[T]#get__T_int32(acc/1) + current/3)) in
        {
          let mtmp1 = inherent#Ref#Ref[T]#set__T_int32(i/2, (current/3 + 1)) in
          {
            ()
          }
        }
      }
  } in
  {
    inherent#Ref#Ref[T]#get__T_int32(acc/1)
  }
}

fn sum_even(limit/4: int32) -> int32 {
  let acc/5 = inherent#Ref#Ref[T]#new__T_int32(0) in
  let i/6 = inherent#Ref#Ref[T]#new__T_int32(0) in
  let is_even/7 = inherent#Ref#Ref[T]#new__T_bool(true) in
  let mtmp5 = while (inherent#Ref#Ref[T]#get__T_int32(i/6) < limit/4) {
      {
        let current/8 = inherent#Ref#Ref[T]#get__T_int32(i/6) in
        let mtmp3 = inherent#Ref#Ref[T]#set__T_int32(i/6, (current/8 + 1)) in
        {
          let add_now/9 = inherent#Ref#Ref[T]#get__T_bool(is_even/7) in
          let mtmp4 = inherent#Ref#Ref[T]#set__T_bool(is_even/7, (!add_now/9)) in
          {
            if add_now/9 {
                {
                  inherent#Ref#Ref[T]#set__T_int32(acc/5, (inherent#Ref#Ref[T]#get__T_int32(acc/5) + current/8))
                }
            } else {
                {
                  ()
                }
            }
          }
        }
      }
  } in
  {
    inherent#Ref#Ref[T]#get__T_int32(acc/5)
  }
}

fn main() -> unit {
  let first/10 = sum_to(5) in
  let evens/11 = sum_even(6) in
  let mtmp6 = print__T_string("sum_to(5)=") in
  {
    let mtmp7 = println__T_int32(first/10) in
    {
      let mtmp8 = print__T_string("sum_even(6)=") in
      {
        let mtmp9 = println__T_int32(evens/11) in
        {
          ()
        }
      }
    }
  }
}

