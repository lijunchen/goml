fn bump(cell/0: Ref[int32]) -> int32 {
  let mtmp0 = inherent#Ref#Ref[int32]#set(cell/0, (inherent#Ref#Ref[int32]#get(cell/0) + 1)) in
  {
    inherent#Ref#Ref[int32]#get(cell/0)
  }
}

fn flip(flag/1: Ref[bool]) -> bool {
  let current/2 = inherent#Ref#Ref[bool]#get(flag/1) in
  let mtmp1 = inherent#Ref#Ref[bool]#set(flag/1, (!current/2)) in
  {
    inherent#Ref#Ref[bool]#get(flag/1)
  }
}

fn nested_total(cell/3: Ref[Ref[int32]]) -> int32 {
  let inner/4 = inherent#Ref#Ref[Ref[int32]]#get(cell/3) in
  let before/5 = inherent#Ref#Ref[int32]#get(inner/4) in
  let mtmp2 = inherent#Ref#Ref[int32]#set(inner/4, (before/5 + 2)) in
  {
    (before/5 + inherent#Ref#Ref[int32]#get(inner/4))
  }
}

fn alias_bump(cell/6: Ref[int32]) -> int32 {
  let alias/7 = cell/6 in
  let mtmp3 = inherent#Ref#Ref[int32]#set(alias/7, (inherent#Ref#Ref[int32]#get(alias/7) + 5)) in
  {
    inherent#Ref#Ref[int32]#get(alias/7)
  }
}

fn pair_sum() -> int32 {
  let first/8 = inherent#Ref#Ref[int32]#new(4) in
  let second/9 = inherent#Ref#Ref[int32]#new(6) in
  let mtmp4 = inherent#Ref#Ref[int32]#set(first/8, (inherent#Ref#Ref[int32]#get(first/8) + inherent#Ref#Ref[int32]#get(second/9))) in
  {
    (inherent#Ref#Ref[int32]#get(first/8) + inherent#Ref#Ref[int32]#get(second/9))
  }
}

fn reassign_nested(nested/10: Ref[Ref[int32]]) -> int32 {
  let inner/11 = inherent#Ref#Ref[Ref[int32]]#get(nested/10) in
  let mtmp5 = inherent#Ref#Ref[int32]#set(inner/11, (inherent#Ref#Ref[int32]#get(inner/11) + 7)) in
  {
    inherent#Ref#Ref[int32]#get(inner/11)
  }
}

fn main() -> unit {
  let counter/12 = inherent#Ref#Ref[int32]#new(39) in
  let toggler/13 = inherent#Ref#Ref[bool]#new(false) in
  let nested/14 = inherent#Ref#Ref[Ref[int32]]#new(inherent#Ref#Ref[int32]#new(3)) in
  let bumped/15 = bump(counter/12) in
  let flipped/16 = flip(toggler/13) in
  let flipped_again/17 = flip(toggler/13) in
  let inner/18 = inherent#Ref#Ref[Ref[int32]]#get(nested/14) in
  let mtmp6 = inherent#Ref#Ref[int32]#set(inner/18, (inherent#Ref#Ref[int32]#get(inner/18) + bumped/15)) in
  {
    let nested_total_val/19 = nested_total(nested/14) in
    let alias_total/20 = alias_bump(counter/12) in
    let pair_total/21 = pair_sum() in
    let reassigned/22 = reassign_nested(nested/14) in
    let bool_check/23 = (!false) in
    let mtmp7 = println($goml_builtin_runtime$int32_to_string((bumped/15 + inherent#Ref#Ref[int32]#get(counter/12)))) in
    {
      let mtmp8 = println($goml_builtin_runtime$int32_to_string(((nested_total_val/19 + alias_total/20) + reassigned/22))) in
      {
        let mtmp9 = println($goml_builtin_runtime$int32_to_string(pair_total/21)) in
        {
          let mtmp10 = println(trait_call[ToString::to_string](if if flipped/16 {
              flipped_again/17
          } else {
              false
          } {
              bool_check/23
          } else {
              false
          })) in
          {
            ()
          }
        }
      }
    }
  }
}

