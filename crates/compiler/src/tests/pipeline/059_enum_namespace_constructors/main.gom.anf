fn color_is_red(color/0: Color) -> bool {
  join ret5(retv6: bool) -> bool {
    retv6
  } in
  join k7(jp8: bool) -> bool {
    jump ret5(jp8)
  } in
  match color/0 {
    Tag_0 => {
      jump k7(true)
    },
    Tag_1 => {
      jump k7(false)
    },
  }
}

fn toggle_signal(signal/1: Signal) -> Signal {
  join ret9(retv10: Signal) -> Signal {
    retv10
  } in
  join k11(jp12: Signal) -> Signal {
    jump ret9(jp12)
  } in
  match signal/1 {
    Tag_0 => {
      jump k11(Tag_1)
    },
    Tag_1 => {
      jump k11(Tag_0)
    },
  }
}

fn main() -> Signal {
  join ret13(retv14: Signal) -> Signal {
    retv14
  } in
  let current/2 = Tag_0 in
  let mtmp4 = color_is_red(current/2) in
  let t15 = toggle_signal(Tag_0) in
