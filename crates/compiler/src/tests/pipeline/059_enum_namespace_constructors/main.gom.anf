fn color_is_red(color/0: Color) -> bool {
  join ret23(retv24: bool) -> bool {
    retv24
  } in
  join k25(jp26: bool) -> bool {
    jump ret23(jp26)
  } in
  match color/0 {
    Tag_0 => {
      jump k25(true)
    },
    Tag_1 => {
      jump k25(false)
    },
  }
}

fn toggle_signal(signal/1: Signal) -> Signal {
  join ret27(retv28: Signal) -> Signal {
    retv28
  } in
  join k29(jp30: Signal) -> Signal {
    jump ret27(jp30)
  } in
  match signal/1 {
    Tag_0 => {
      jump k29(Tag_1)
    },
    Tag_1 => {
      jump k29(Tag_0)
    },
  }
}

fn main() -> Signal {
  join ret31(retv32: Signal) -> Signal {
    retv32
  } in
  let current/2 = Tag_0 in
  let mtmp22 = color_is_red(current/2) in
  let t33 = toggle_signal(Tag_0) in
