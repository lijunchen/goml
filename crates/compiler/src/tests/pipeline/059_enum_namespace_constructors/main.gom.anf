fn color_is_red(color/0: Color) -> bool {
  join ret8(retv9: bool) -> bool {
    retv9
  } in
  join k10(jp11: bool) -> bool {
    jump ret8(jp11)
  } in
  match color/0 {
    Tag_0 => {
      jump k10(true)
    },
    Tag_1 => {
      jump k10(false)
    },
  }
}

fn toggle_signal(signal/1: Signal) -> Signal {
  join ret12(retv13: Signal) -> Signal {
    retv13
  } in
  join k14(jp15: Signal) -> Signal {
    jump ret12(jp15)
  } in
  match signal/1 {
    Tag_0 => {
      jump k14(Tag_1)
    },
    Tag_1 => {
      jump k14(Tag_0)
    },
  }
}

fn main() -> Signal {
  join ret16(retv17: Signal) -> Signal {
    retv17
  } in
  let current/2 = Tag_0 in
  let mtmp7 = color_is_red(current/2) in
  let t18 = toggle_signal(Tag_0) in
  jump ret16(t18)
}