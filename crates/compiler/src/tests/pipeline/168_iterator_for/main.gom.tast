fn countdown(start/0: int32) -> FnIterator[int32] {
    let current/1: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])((start/0 : int32));
    (FnIterator::from_fn : (() -> Option[int32]) -> FnIterator[int32])(|| => {
        let value/2: int32 = (Ref[int32]::get : (Ref[int32]) -> int32)((current/1 : Ref[int32]));
        if (value/2 : int32) > 0 {
            {
                (Ref[int32]::set : (Ref[int32], int32) -> unit)((current/1 : Ref[int32]), (value/2 : int32) - 1);
                Option::Some((value/2 : int32))
            }
        } else {
            {
                Option::None
            }
        }
    })
}

fn counted_range(calls/3: Ref[int32]) -> FnIterator[int] {
    (Ref[int32]::set : (Ref[int32], int32) -> unit)((calls/3 : Ref[int32]), (Ref[int32]::get : (Ref[int32]) -> int32)((calls/3 : Ref[int32])) + 1);
    (range : (int, int) -> FnIterator[int])(1, 5)
}

fn first_even(values/4: FnIterator[int]) -> int {
    for value/5: int in (values/4 : FnIterator[int]) {
        if (value/5 : int) / 2 * 2 == (value/5 : int) {
            {
                return (value/5 : int)
            }
        } else {
            {
                ()
            }
        };
    };
    -1
}

fn main() -> unit {
    let values/6: Vec[int32] = (Vec[int32]::new : () -> Vec[int32])();
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((values/6 : Vec[int32]), 10);
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((values/6 : Vec[int32]), 20);
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((values/6 : Vec[int32]), 30);
    let sum/7: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])(0);
    for value/8: int32 in (values/6 : Vec[int32]) {
        if (value/8 : int32) == 20 {
            {
                continue
            }
        } else {
            {
                ()
            }
        };
        (Ref[int32]::set : (Ref[int32], int32) -> unit)((sum/7 : Ref[int32]), (Ref[int32]::get : (Ref[int32]) -> int32)((sum/7 : Ref[int32])) + (value/8 : int32));
    };
    (println : (int32) -> unit)((Ref[int32]::get : (Ref[int32]) -> int32)((sum/7 : Ref[int32])));
    let pairs/9: Vec[(int32, string)] = (Vec[(int32, string)]::new : () -> Vec[(int32, string)])();
    (Vec[(int32, string)]::push : (Vec[(int32, string)], (int32, string)) -> unit)((pairs/9 : Vec[(int32, string)]), (1, "a"));
    (Vec[(int32, string)]::push : (Vec[(int32, string)], (int32, string)) -> unit)((pairs/9 : Vec[(int32, string)]), (2, "b"));
    for (number/10: int32, text/11: string) in (pairs/9 : Vec[(int32, string)]) {
        (println : (string) -> unit)((int32::to_string : (int32) -> string)((number/10 : int32)) + (text/11 : string));
    };
    let calls/12: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])(0);
    let range_sum/13: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    for value/14: int in (counted_range : (Ref[int32]) -> FnIterator[int])((calls/12 : Ref[int32])) {
        (Ref[int]::set : (Ref[int], int) -> unit)((range_sum/13 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((range_sum/13 : Ref[int])) + (value/14 : int));
    };
    (println : (int32) -> unit)((Ref[int32]::get : (Ref[int32]) -> int32)((calls/12 : Ref[int32])));
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((range_sum/13 : Ref[int])));
    let slice_sum/15: Ref[int32] = (Ref[int32]::new : (int32) -> Ref[int32])(0);
    for value/16: int32 in (Vec[int32]::slice : (Vec[int32], int, int) -> Slice[int32])((values/6 : Vec[int32]), 1, 3) {
        (Ref[int32]::set : (Ref[int32], int32) -> unit)((slice_sum/15 : Ref[int32]), (Ref[int32]::get : (Ref[int32]) -> int32)((slice_sum/15 : Ref[int32])) + (value/16 : int32));
    };
    (println : (int32) -> unit)((Ref[int32]::get : (Ref[int32]) -> int32)((slice_sum/15 : Ref[int32])));
    for value/17: int32 in (countdown : (int32) -> FnIterator[int32])(4) {
        if (value/17 : int32) == 2 {
            {
                break
            }
        } else {
            {
                (println : (int32) -> unit)((value/17 : int32));
            }
        };
    };
    let empty/18: FnIterator[int] = (range : (int, int) -> FnIterator[int])(0, 0);
    for _ : int in (empty/18 : FnIterator[int]) {};
    (println : (int) -> unit)((first_even : (FnIterator[int]) -> int)((range : (int, int) -> FnIterator[int])(3, 8)));
    (println : (string) -> unit)("done");
}