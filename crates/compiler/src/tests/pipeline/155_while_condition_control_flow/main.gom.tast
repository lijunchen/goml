fn main() -> unit {
    let i/0: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while if (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) < 3 {
        {
            true
        }
    } else {
        {
            false
        }
    } {
        {
            (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])));
            (Ref[int]::set : (Ref[int], int) -> unit)((i/0 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((i/0 : Ref[int])) + 1);
        }
    };
    let j/1: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let total/2: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while if (Ref[int]::get : (Ref[int]) -> int)((j/1 : Ref[int])) < 4 {
        {
            if (Ref[int]::get : (Ref[int]) -> int)((j/1 : Ref[int])) == 1 {
                {
                    true
                }
            } else {
                {
                    (Ref[int]::get : (Ref[int]) -> int)((j/1 : Ref[int])) != 3
                }
            }
        }
    } else {
        {
            false
        }
    } {
        {
            (Ref[int]::set : (Ref[int], int) -> unit)((total/2 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((total/2 : Ref[int])) + (Ref[int]::get : (Ref[int]) -> int)((j/1 : Ref[int])));
            (Ref[int]::set : (Ref[int], int) -> unit)((j/1 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((j/1 : Ref[int])) + 1);
        }
    };
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((total/2 : Ref[int])));
    let k/3: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    let sum/4: Ref[int] = (Ref[int]::new : (int) -> Ref[int])(0);
    while match (Ref[int]::get : (Ref[int]) -> int)((k/3 : Ref[int])) {
        0 => true,
        1 => if (Ref[int]::get : (Ref[int]) -> int)((sum/4 : Ref[int])) == 0 {
              {
                  true
              }
          } else {
              {
                  false
              }
          },
        2 => true,
        _ : int => false,
    } {
        {
            (Ref[int]::set : (Ref[int], int) -> unit)((sum/4 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((sum/4 : Ref[int])) + (Ref[int]::get : (Ref[int]) -> int)((k/3 : Ref[int])));
            (Ref[int]::set : (Ref[int], int) -> unit)((k/3 : Ref[int]), (Ref[int]::get : (Ref[int]) -> int)((k/3 : Ref[int])) + 1);
        }
    };
    (println : (int) -> unit)((Ref[int]::get : (Ref[int]) -> int)((sum/4 : Ref[int])));
}