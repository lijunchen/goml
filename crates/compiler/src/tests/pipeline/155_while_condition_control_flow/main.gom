fn main() -> unit {
    let i = Ref::new(0i32);
    while if i.get() < 3i32 { true } else { false } {
        println(i.get());
        i.set(i.get() + 1i32);
    };

    let j = Ref::new(0i32);
    let total = Ref::new(0i32);
    while if j.get() < 4i32 {
        if j.get() == 1i32 {
            true
        } else {
            j.get() != 3i32
        }
    } else {
        false
    } {
        total.set(total.get() + j.get());
        j.set(j.get() + 1i32);
    };
    println(total.get());

    let k = Ref::new(0i32);
    let sum = Ref::new(0i32);
    while match k.get() {
        0i32 => true,
        1i32 => if sum.get() == 0i32 { true } else { false },
        2i32 => true,
        _ => false,
    } {
        sum.set(sum.get() + k.get());
        k.set(k.get() + 1i32);
    };
    println(sum.get());
}
