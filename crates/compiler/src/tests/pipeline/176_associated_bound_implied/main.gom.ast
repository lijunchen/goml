package main;
trait Label {
  fn label(Self) -> string;
}

trait Source {
  type Item: Label;
  fn get(Self) -> Self::Item;
}

struct TextSource {
    value: string,
}

impl Label for string {
  fn label(self: string) -> string {
      "label:" + self
  }
}

impl Source for TextSource {
  type Item = string;
  fn get(self: TextSource) -> string {
      self.value
  }
}

fn render(source: S) -> string {
    Source::get(source).label()
}

fn main() -> unit {
    println(render(TextSource {
            value: "goml"
        }));
}

