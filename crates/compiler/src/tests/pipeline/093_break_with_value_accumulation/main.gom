fn main() {
    let sum = Ref::new(0i32);
    let i = Ref::new(0i32);
    while i.get() < 20i32 {
        i.set(i.get() + 1i32);
        if i.get() > 5i32 {
            break
        } else {
            ()
        };
        sum.set(sum.get() + i.get());
    };
    let _ = print("sum: ");
    let _ = println(sum.get());
    let _ = print("i at break: ");
    let _ = println(i.get());
}
