fn show_scalar(value: uint32) -> unit {
    match char_from_uint32(value) {
        Option::Some(result) => println(result as uint32),
        Option::None => println("none"),
    }
}

fn main() -> unit {
    show_scalar(0u32);
    show_scalar(65u32);
    show_scalar(55295u32);
    show_scalar(55296u32);
    show_scalar(57343u32);
    show_scalar(57344u32);
    show_scalar(1114111u32);
    show_scalar(1114112u32);
    match char_from_uint32(128512u32) {
        Option::Some(result) => println(result.to_string()),
        Option::None => println("none"),
    }
}
