impl Eq for AlwaysDifferent{
  fn eq(self/0: AlwaysDifferent, other/1: AlwaysDifferent) -> bool {
      false
  }
}

fn main() -> unit {
    let first/2: AlwaysDifferent = AlwaysDifferent { value: 7 };
    let second/3: AlwaysDifferent = AlwaysDifferent { value: 7 };
    (println : (bool) -> unit)((first/2 : AlwaysDifferent) == (second/3 : AlwaysDifferent));
    (println : (bool) -> unit)((first/2 : AlwaysDifferent) != (second/3 : AlwaysDifferent));
    let left_tuple/4: (AlwaysDifferent, int32) = (AlwaysDifferent { value: 1 }, 2);
    let right_tuple/5: (AlwaysDifferent, int32) = (AlwaysDifferent { value: 1 }, 2);
    (println : (bool) -> unit)((left_tuple/4 : (AlwaysDifferent, int32)) == (right_tuple/5 : (AlwaysDifferent, int32)));
    let left_array/6: [AlwaysDifferent; 2] = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
    let right_array/7: [AlwaysDifferent; 2] = [AlwaysDifferent { value: 1 }, AlwaysDifferent { value: 2 }];
    (println : (bool) -> unit)((left_array/6 : [AlwaysDifferent; 2]) == (right_array/7 : [AlwaysDifferent; 2]));
}