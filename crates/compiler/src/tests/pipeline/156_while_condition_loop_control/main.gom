fn main() -> unit {
    let i = Ref::new(0i32);
    let total = Ref::new(0i32);

    while if i.get() == 0i32 {
        i.set(1i32);
        true
    } else if i.get() < 4i32 {
        true
    } else {
        false
    } {
        total.set(total.get() + i.get());
        if i.get() == 1i32 {
            i.set(2i32);
            continue
        } else {
            ()
        };
        i.set(i.get() + 1i32);
    };
    println(total.get());

    let j = Ref::new(0i32);
    let total2 = Ref::new(0i32);
    while match j.get() {
        0i32 => {
            j.set(1i32);
            true
        },
        1i32 => {
            j.set(2i32);
            true
        },
        2i32 => true,
        _ => false,
    } {
        total2.set(total2.get() + j.get());
        if j.get() == 2i32 {
            break;
        } else {
            ()
        };
    };
    println(total2.get());
}
