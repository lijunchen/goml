package main;
enum option[T] {
    Some(T),
    None
}

struct point {
    x: int32,
    y: int32,
}

fn make_some(value: int32) -> option[int32] {
    Some(value)
}

fn build_point(x: int32, y: int32) -> point {
    point {
        x: x,
        y: y
    }
}

fn magnitude(p: point) -> int32 {
    let point { x: x, y: y } = p;
    x + y
}

fn main() -> int32 {
    match make_some(5) {
        Some(result) => {
              let pt = build_point(result, 7);
              match Some(pt.x) {
                  Some(value) => value + magnitude(pt),
                  None => 0,
              }
          },
        None => 0,
    }
}

