fn make_some(value/0: int32) -> option__int32 {
  option__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> point {
  point { x: x/1, y: y/2 }
}

fn magnitude(p/3: point) -> int32 {
  let mtmp61 = p/3 in
  let x62 = point.x(mtmp61) in
  let x63 = point.y(mtmp61) in
  let y/5 = x63 in
  let x/4 = x62 in
  (x/4 + y/5)
}

fn main() -> int32 {
  let mtmp64 = make_some(5) in
  match mtmp64 {
    option__int32::Some(x65) => {
      let x65 = option__int32::Some._0(mtmp64) in
      let result/6 = x65 in
      let pt/7 = build_point(result/6, 7) in
      let mtmp66 = option__int32::Some(point.x(pt/7)) in
      match mtmp66 {
        option__int32::Some(x67) => {
          let x67 = option__int32::Some._0(mtmp66) in
          let value/8 = x67 in
          (value/8 + magnitude(pt/7))
        },
        option__int32::None => {
          0
        },
      }
    },
    option__int32::None => {
      0
    },
  }
}