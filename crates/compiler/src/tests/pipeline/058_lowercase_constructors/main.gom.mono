fn make_some(value/0: int32) -> option__int32 {
  option__int32::some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> point {
  point { x: x/1, y: y/2 }
}

fn magnitude(p/3: point) -> int32 {
  let mtmp7 = p/3 in
  {
    let x8 = point.x(mtmp7) in
    let x9 = point.y(mtmp7) in
    {
      let y/5 = x9 in
      {
        let x/4 = x8 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp10 = make_some(5) in
    match mtmp10 {
      option__int32::some(x11) => {
        {
          let x11 = option__int32::some._0(mtmp10) in
          {
            let result/6 = x11 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp12 = option__int32::some(point.x(pt/7)) in
                match mtmp12 {
                  option__int32::some(x13) => {
                    {
                      let x13 = option__int32::some._0(mtmp12) in
                      {
                        let value/8 = x13 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  option__int32::none => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      option__int32::none => {
        0
      },
    }
  }
}