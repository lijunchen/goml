fn make_some(value/0: int32) -> option__int32 {
  option__int32::some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> point {
  point { x: x/1, y: y/2 }
}

fn magnitude(p/3: point) -> int32 {
  let mtmp22 = p/3 in
  {
    let x23 = point.x(mtmp22) in
    let x24 = point.y(mtmp22) in
    {
      let y/5 = x24 in
      {
        let x/4 = x23 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp25 = make_some(5) in
    match mtmp25 {
      option__int32::some(x26) => {
        {
          let x26 = option__int32::some._0(mtmp25) in
          {
            let result/6 = x26 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp27 = option__int32::some(point.x(pt/7)) in
                match mtmp27 {
                  option__int32::some(x28) => {
                    {
                      let x28 = option__int32::some._0(mtmp27) in
                      {
                        let value/8 = x28 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  option__int32::none => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      option__int32::none => {
        0
      },
    }
  }
}