fn make_some(value/0: int32) -> Maybe__int32 {
  Maybe__int32::Some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> Point {
  Point { x: x/1, y: y/2 }
}

fn magnitude(p/3: Point) -> int32 {
  let mtmp61 = p/3 in
  {
    let x62 = Point.x(mtmp61) in
    let x63 = Point.y(mtmp61) in
    {
      let y/5 = x63 in
      {
        let x/4 = x62 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp64 = make_some(5) in
    match mtmp64 {
      Maybe__int32::Some(x65) => {
        {
          let x65 = Maybe__int32::Some._0(mtmp64) in
          {
            let result/6 = x65 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp66 = Maybe__int32::Some(Point.x(pt/7)) in
                match mtmp66 {
                  Maybe__int32::Some(x67) => {
                    {
                      let x67 = Maybe__int32::Some._0(mtmp66) in
                      {
                        let value/8 = x67 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  Maybe__int32::None => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      Maybe__int32::None => {
        0
      },
    }
  }
}