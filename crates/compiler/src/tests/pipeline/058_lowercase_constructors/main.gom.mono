fn make_some(value/0: int32) -> option__int32 {
  option__int32::some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> point {
  point { x: x/1, y: y/2 }
}

fn magnitude(p/3: point) -> int32 {
  let mtmp4 = p/3 in
  {
    let x5 = point.x(mtmp4) in
    let x6 = point.y(mtmp4) in
    {
      let y/5 = x6 in
      {
        let x/4 = x5 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp7 = make_some(5) in
    match mtmp7 {
      option__int32::some(x8) => {
        {
          let x8 = option__int32::some._0(mtmp7) in
          {
            let result/6 = x8 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp9 = option__int32::some(point.x(pt/7)) in
                match mtmp9 {
                  option__int32::some(x10) => {
                    {
                      let x10 = option__int32::some._0(mtmp9) in
                      {
                        let value/8 = x10 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  option__int32::none => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      option__int32::none => {
        0
      },
    }
  }
}