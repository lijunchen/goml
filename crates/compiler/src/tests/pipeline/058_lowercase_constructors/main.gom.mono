fn make_some(value/0: int32) -> option__int32 {
  option__int32::some(value/0)
}

fn build_point(x/1: int32, y/2: int32) -> point {
  point { x: x/1, y: y/2 }
}

fn magnitude(p/3: point) -> int32 {
  let mtmp58 = p/3 in
  {
    let x59 = point.x(mtmp58) in
    let x60 = point.y(mtmp58) in
    {
      let y/5 = x60 in
      {
        let x/4 = x59 in
        {
          (x/4 + y/5)
        }
      }
    }
  }
}

fn main() -> int32 {
  {
    let mtmp61 = make_some(5) in
    match mtmp61 {
      option__int32::some(x62) => {
        {
          let x62 = option__int32::some._0(mtmp61) in
          {
            let result/6 = x62 in
            {
              let pt/7 = build_point(result/6, 7) in
              {
                let mtmp63 = option__int32::some(point.x(pt/7)) in
                match mtmp63 {
                  option__int32::some(x64) => {
                    {
                      let x64 = option__int32::some._0(mtmp63) in
                      {
                        let value/8 = x64 in
                        (value/8 + magnitude(pt/7))
                      }
                    }
                  },
                  option__int32::none => {
                    0
                  },
                }
              }
            }
          }
        }
      },
      option__int32::none => {
        0
      },
    }
  }
}