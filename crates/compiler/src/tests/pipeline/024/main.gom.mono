fn point_type(p/8: Point) -> string {
  {
    let x14 = Point.x(p/8) in
    let x15 = Point.y(p/8) in
    match x14 {
      0 => {
        match x15 {
          0 => {
            {
              "origin"
            }
          },
          1 => {
            {
              "up"
            }
          },
          _ => {
            let y/9 = x15 in
            {
              {
                let mtmp16 = (0 < y/9) in
                match mtmp16 {
                  true => {
                    "above"
                  },
                  false => {
                    "below"
                  },
                }
              }
            }
          },
        }
      },
      1 => {
        match x15 {
          0 => {
            {
              "right"
            }
          },
          _ => "unknown",
        }
      },
      _ => "unknown",
    }
  }
}

fn main() -> unit {
