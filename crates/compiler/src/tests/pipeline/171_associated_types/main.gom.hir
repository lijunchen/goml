package main
file main.gom
  trait Provider {
      fn get(Self) -> Self::Item;
    }
    
    struct Number {
        value: int32,
    }
    
    struct Box[T] {
        value: T,
    }
    
    impl Provider for Number {
      fn get(local/1/0: Number) -> int32 {
          self/0.value
      }
    }
    
    impl[T: ToString] Provider for Box[T] {
      fn get(local/1/1: Box[T]) -> T {
          self/1.value
      }
    }
    
    fn read(local/1/2: P) -> P::Item {
        provider/2.get()
    }
    
    fn read_as(local/1/3: P) -> T {
        provider/3.get()
    }
    
    fn main() -> unit {
        string_println(def/1/5(Number {
                value: 42
            }).to_string());
        let local/1/4: int32 = def/1/6(Number {
              value: 7
          });
        string_println(value/4.to_string());
        string_println(def/1/5(Box {
                value: "generic"
            }));
        string_println(Provider::get(Number {
                value: 11
            }).to_string())
    }