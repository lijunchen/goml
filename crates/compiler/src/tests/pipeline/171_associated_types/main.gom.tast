impl Provider for Number{
  fn get(self/0: Number) -> int32 {
      (self/0 : Number).value
  }
}

impl Provider for Box[T]{
  fn get(self/1: Box[T]) -> T {
      (self/1 : Box[T]).value
  }
}

fn read(provider/2: P) -> P::Item {
    (Provider::get : (P) -> P::Item)((provider/2 : P))
}

fn read_as(provider/3: P) -> T {
    (Provider::get : (P) -> T)((provider/3 : P))
}

fn main() -> unit {
    (@runtime(core.string_println) : (string) -> unit)((int32::to_string : (int32) -> string)((read : (Number) -> int32)(Number { value: 42 })));
    let value/4: int32 = (read_as : (Number) -> int32)(Number { value: 7 });
    (@runtime(core.string_println) : (string) -> unit)((int32::to_string : (int32) -> string)((value/4 : int32)));
    (@runtime(core.string_println) : (string) -> unit)((read : (Box[string]) -> string)(Box { value: "generic" }));
    (@runtime(core.string_println) : (string) -> unit)((int32::to_string : (int32) -> string)((Provider::get : (Number) -> int32)(Number { value: 11 })))
}