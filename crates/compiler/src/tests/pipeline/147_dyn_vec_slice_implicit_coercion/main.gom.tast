impl Display for int32{
  fn show(self/0: int32) -> string {
      (int32::to_string : (int32) -> string)((self/0 : int32))
  }
}

fn render(x/1: dyn Display) -> string {
    (dyn Display::show : (dyn Display) -> string)((x/1 : dyn Display))
}

fn main() -> unit {
    let v/2: Vec[dyn Display] = (Vec[dyn Display]::new : () -> Vec[dyn Display])();
    let first/3: int32 = 10;
    let second/4: int32 = 20;
    (Vec[dyn Display]::push : (Vec[dyn Display], dyn Display) -> unit)((v/2 : Vec[dyn Display]), to_dyn[Display]{int32}((first/3 : int32)));
    (Vec[dyn Display]::push : (Vec[dyn Display], dyn Display) -> unit)((v/2 : Vec[dyn Display]), to_dyn[Display]{int32}((second/4 : int32)));
    let s/5: Slice[dyn Display] = (Vec[dyn Display]::slice : (Vec[dyn Display], int, int) -> Slice[dyn Display])((v/2 : Vec[dyn Display]), 0, 2);
    (println : (string) -> unit)((render : (dyn Display) -> string)((s/5 : Slice[dyn Display])[0]));
    let t/6: Slice[dyn Display] = (Slice[dyn Display]::sub : (Slice[dyn Display], int, int) -> Slice[dyn Display])((s/5 : Slice[dyn Display]), 1, 2);
    (println : (string) -> unit)((render : (dyn Display) -> string)((t/6 : Slice[dyn Display])[0]));
}