package main
file main.gom
  fn main() -> unit {
        let (local/1/0, local/1/1) = string_parse_float64("3.125");
        string_println(valid/0.to_string());
        string_println(value/1.to_string());
        let (local/1/2, local/1/3) = string_parse_float64("not-a-number");
        string_println(invalid/2.to_string());
        string_println(fallback/3.to_string())
    }