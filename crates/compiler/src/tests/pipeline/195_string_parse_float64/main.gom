fn main() -> unit {
    let (valid, value) = string_parse_float64("3.125");
    string_println(valid.to_string());
    string_println(value.to_string());
    let (invalid, fallback) = string_parse_float64("not-a-number");
    string_println(invalid.to_string());
    string_println(fallback.to_string())
}
