package main;
fn main() -> unit {
    let i = Ref::new(0i32);
    let sum = Ref::new(0i32);
    while i.get() < 5i32 {
        {
            i.set(i.get() + 1i32);
            let cur = if i.get() == 3i32 {
                {
                    continue
                }
            } else {
                {
                    i.get()
                }
            };
            sum.set(sum.get() + cur);
        }
    };
    println(sum.get());
    let j = Ref::new(0i32);
    let total = Ref::new(0i32);
    while true {
        {
            j.set(j.get() + 1i32);
            let cur = match j.get() {
                5i32 => break,
                _ => j.get(),
            };
            total.set(total.get() + cur);
        }
    };
    println(total.get());
}

