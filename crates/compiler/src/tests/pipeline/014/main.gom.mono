fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  {
    let x58 = x/0.0 in
    let x59 = x/0.1 in
    match x59 {
      true => {
        {
          let x60 = y/1.0 in
          let x61 = y/1.1 in
          match x61 {
            true => {
              match x60 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        }
      },
      false => {
        match x58 {
          true => {
            {
              let x62 = y/1.0 in
              let x63 = y/1.1 in
              match x63 {
                true => {
                  match x62 {
                    true => {
                      println__T_string("case2")
                    },
                    false => {
                      println__T_string("case1")
                    },
                  }
                },
                false => {
                  println__T_string("case2")
                },
              }
            }
          },
          false => {
            {
              let x64 = y/1.0 in
              let x65 = y/1.1 in
              match x65 {
                true => {
                  match x64 {
                    true => {
                      println__T_string("case4")
                    },
                    false => {
                      println__T_string("case3")
                    },
                  }
                },
                false => {
                  println__T_string("case4")
                },
              }
            }
          },
        }
      },
    }
  }
}

fn main() -> unit {
  let mtmp66 = test_nested_match((true, false), (false, true)) in
  {
    let mtmp67 = test_nested_match((true, false), (true, false)) in
    {
      let mtmp68 = test_nested_match((false, true), (false, true)) in
      {
        let mtmp69 = test_nested_match((false, true), (true, false)) in
        {
          ()
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/34: string) -> string {
  self/34
}