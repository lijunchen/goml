fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  {
    let x7 = x/0.0 in
    let x8 = x/0.1 in
    match x8 {
      true => {
        {
          let x9 = y/1.0 in
          let x10 = y/1.1 in
          match x10 {
            true => {
              match x9 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        }
      },
      false => {
        match x7 {
          true => {
            {
              let x11 = y/1.0 in
              let x12 = y/1.1 in
              match x12 {
                true => {
                  match x11 {
                    true => {
                      println__T_string("case2")
                    },
                    false => {
                      println__T_string("case1")
                    },
                  }
                },
                false => {
                  println__T_string("case2")
                },
              }
            }
          },
          false => {
            {
              let x13 = y/1.0 in
              let x14 = y/1.1 in
              match x14 {
                true => {
                  match x13 {
                    true => {
                      println__T_string("case4")
                    },
                    false => {
                      println__T_string("case3")
                    },
                  }
                },
                false => {
                  println__T_string("case4")
                },
              }
            }
          },
        }
      },
    }
  }
}

fn main() -> unit {
  let mtmp15 = test_nested_match((true, false), (false, true)) in
  {
    let mtmp16 = test_nested_match((true, false), (true, false)) in
    {
      let mtmp17 = test_nested_match((false, true), (false, true)) in
      {
        let mtmp18 = test_nested_match((false, true), (true, false)) in
        {
          ()
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/9: string) -> string {
  self/9
}