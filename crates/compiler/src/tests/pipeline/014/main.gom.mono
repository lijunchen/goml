fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  {
    let x22 = x/0.0 in
    let x23 = x/0.1 in
    match x23 {
      true => {
        {
          let x24 = y/1.0 in
          let x25 = y/1.1 in
          match x25 {
            true => {
              match x24 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        }
      },
      false => {
        match x22 {
          true => {
            {
              let x26 = y/1.0 in
              let x27 = y/1.1 in
              match x27 {
                true => {
                  match x26 {
                    true => {
                      println__T_string("case2")
                    },
                    false => {
                      println__T_string("case1")
                    },
                  }
                },
                false => {
                  println__T_string("case2")
                },
              }
            }
          },
          false => {
            {
              let x28 = y/1.0 in
              let x29 = y/1.1 in
              match x29 {
                true => {
                  match x28 {
                    true => {
                      println__T_string("case4")
                    },
                    false => {
                      println__T_string("case3")
                    },
                  }
                },
                false => {
                  println__T_string("case4")
                },
              }
            }
          },
        }
      },
    }
  }
}

fn main() -> unit {
  let mtmp30 = test_nested_match((true, false), (false, true)) in
  {
    let mtmp31 = test_nested_match((true, false), (true, false)) in
    {
      let mtmp32 = test_nested_match((false, true), (false, true)) in
      {
        let mtmp33 = test_nested_match((false, true), (true, false)) in
        {
          ()
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/9: string) -> string {
  self/9
}