fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  {
    let x4 = x/0.0 in
    let x5 = x/0.1 in
    match x5 {
      true => {
        {
          let x6 = y/1.0 in
          let x7 = y/1.1 in
          match x7 {
            true => {
              match x6 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        }
      },
      false => {
        match x4 {
          true => {
            {
              let x8 = y/1.0 in
              let x9 = y/1.1 in
              match x9 {
                true => {
                  match x8 {
                    true => {
                      println__T_string("case2")
                    },
                    false => {
                      println__T_string("case1")
                    },
                  }
                },
                false => {
                  println__T_string("case2")
                },
              }
            }
          },
          false => {
            {
              let x10 = y/1.0 in
              let x11 = y/1.1 in
              match x11 {
                true => {
                  match x10 {
                    true => {
                      println__T_string("case4")
                    },
                    false => {
                      println__T_string("case3")
                    },
                  }
                },
                false => {
                  println__T_string("case4")
                },
              }
            }
          },
        }
      },
    }
  }
}

fn main() -> unit {
  let mtmp12 = test_nested_match((true, false), (false, true)) in
  {
    let mtmp13 = test_nested_match((true, false), (true, false)) in
    {
      let mtmp14 = test_nested_match((false, true), (false, true)) in
      {
        let mtmp15 = test_nested_match((false, true), (true, false)) in
        {
          ()
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/9: string) -> string {
  self/9
}