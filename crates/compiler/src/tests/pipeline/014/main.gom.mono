fn test_nested_match(x/0: (bool, bool), y/1: (bool, bool)) -> unit {
  {
    let x61 = x/0.0 in
    let x62 = x/0.1 in
    match x62 {
      true => {
        {
          let x63 = y/1.0 in
          let x64 = y/1.1 in
          match x64 {
            true => {
              match x63 {
                true => {
                  println__T_string("case4")
                },
                false => {
                  println__T_string("case3")
                },
              }
            },
            false => {
              println__T_string("case4")
            },
          }
        }
      },
      false => {
        match x61 {
          true => {
            {
              let x65 = y/1.0 in
              let x66 = y/1.1 in
              match x66 {
                true => {
                  match x65 {
                    true => {
                      println__T_string("case2")
                    },
                    false => {
                      println__T_string("case1")
                    },
                  }
                },
                false => {
                  println__T_string("case2")
                },
              }
            }
          },
          false => {
            {
              let x67 = y/1.0 in
              let x68 = y/1.1 in
              match x68 {
                true => {
                  match x67 {
                    true => {
                      println__T_string("case4")
                    },
                    false => {
                      println__T_string("case3")
                    },
                  }
                },
                false => {
                  println__T_string("case4")
                },
              }
            }
          },
        }
      },
    }
  }
}

fn main() -> unit {
  let mtmp69 = test_nested_match((true, false), (false, true)) in
  {
    let mtmp70 = test_nested_match((true, false), (true, false)) in
    {
      let mtmp71 = test_nested_match((false, true), (false, true)) in
      {
        let mtmp72 = test_nested_match((false, true), (true, false)) in
        {
          ()
        }
      }
    }
  }
}

fn println__T_string(value/1: string) -> unit {
  @runtime(core.string_println)(trait_impl#ToString#string#to_string(value/1))
}

fn trait_impl#ToString#string#to_string(self/37: string) -> string {
  self/37
}