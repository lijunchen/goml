fn main() -> unit {
    let vi/0: Vec[int32] = (Vec[int32]::new : () -> Vec[int32])();
    (Vec[int32]::push : (Vec[int32], int32) -> unit)((vi/0 : Vec[int32]), 42);
    let val_i/1: int32 = (vi/0 : Vec[int32])[0];
    let len_i/2: int32 = (Vec[int32]::len : (Vec[int32]) -> int32)((vi/0 : Vec[int32]));
    let vs/3: Vec[string] = (Vec[string]::new : () -> Vec[string])();
    (Vec[string]::push : (Vec[string], string) -> unit)((vs/3 : Vec[string]), "hello");
    (Vec[string]::push : (Vec[string], string) -> unit)((vs/3 : Vec[string]), "world");
    let val_s/4: string = (vs/3 : Vec[string])[1];
    let len_s/5: int32 = (Vec[string]::len : (Vec[string]) -> int32)((vs/3 : Vec[string]));
    let vb/6: Vec[bool] = (Vec[bool]::new : () -> Vec[bool])();
    (Vec[bool]::push : (Vec[bool], bool) -> unit)((vb/6 : Vec[bool]), true);
    (Vec[bool]::push : (Vec[bool], bool) -> unit)((vb/6 : Vec[bool]), false);
    let val_b/7: bool = (vb/6 : Vec[bool])[0];
    let len_b/8: int32 = (Vec[bool]::len : (Vec[bool]) -> int32)((vb/6 : Vec[bool]));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((val_i/1 : int32)));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((len_i/2 : int32)));
    let _ : unit = (println : (string) -> unit)((val_s/4 : string));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((len_s/5 : int32)));
    let _ : unit = (println : (string) -> unit)((ToString::to_string : (bool) -> string)((val_b/7 : bool)));
    let _ : unit = (println : (string) -> unit)((int32::to_string : (int32) -> string)((len_b/8 : int32)));
    ()
}