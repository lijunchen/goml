fn main() -> unit {
    let i = Ref::new(0i32);
    let sum = Ref::new(0i32);
    while i.get() < 7i32 {
        let cur = i.get();
        i.set(cur + 1i32);
        let _ = if cur < 5i32 {
            match cur {
                1 => continue,
                3 => continue,
                _ => (),
            }
        } else {
            match cur {
                5 => break,
                _ => (),
            }
        };
        sum.set(sum.get() + cur);
    };
    println(sum.get());
}
