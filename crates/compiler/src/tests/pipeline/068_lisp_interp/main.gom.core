fn apply(func/137: Value, args/138: Vec[Value], global/139: Ref[Vec[Binding]]) -> Value {
  match func/137 {
    Value::Int(x145) => {
      {
        let x145 = Value::Int._0(func/137) in
        Value::Nil
      }
    },
    Value::Bool(x146) => {
