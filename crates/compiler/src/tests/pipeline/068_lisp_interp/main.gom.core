            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "if" => {
      {
        if trait_impl#Eq#int#eq(inherent#Vec#Vec[SExpr]#len(items/87), 4) {
            {
              let cond/94 = eval(@intrinsic(vec.get)(items/87, 1), local/88, global/89) in
              if truthy(cond/94) {
                  {
                    eval(@intrinsic(vec.get)(items/87, 2), local/88, global/89)
                  }
              } else {
                  {
                    eval(@intrinsic(vec.get)(items/87, 3), local/88, global/89)
                  }
              }
            }
        } else {
            {
              Value::Nil
            }
        }
      }
    },
    "lambda" => {
      {
        if trait_impl#Eq#int#eq(inherent#Vec#Vec[SExpr]#len(items/87), 3) {
            {
              {
                let mtmp130 = @intrinsic(vec.get)(items/87, 1) in
                match mtmp130 {
                  SExpr::List(x134) => {
                    {
                      let x134 = SExpr::List._0(mtmp130) in
                      {
                        let params_exprs/95 = x134 in
