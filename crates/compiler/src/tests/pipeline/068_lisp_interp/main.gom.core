        let x146 = Value::Bool._0(func/137) in
        Value::Nil
      }
    },
    Value::Func(x147) => {
      {
        let x147 = Value::Func._0(func/137) in
        {
          let fun/140 = x147 in
          apply_lambda(fun/140, args/138)
        }
      }
    },
    Value::Nil => {
      Value::Nil
    },
  }
}

fn apply_lambda(lambda/141: Lambda, args/142: Vec[Value]) -> Value {
  let env/143 = inherent#Ref#Ref[Vec[Binding]]#new(Lambda.env(lambda/141)) in
  let i/144 = inherent#Ref#Ref[int32]#new(0) in
  let mtmp149 = while if (inherent#Ref#Ref[int32]#get(i/144) < inherent#Vec#Vec[string]#len(Lambda.params(lambda/141))) {
      (inherent#Ref#Ref[int32]#get(i/144) < inherent#Vec#Vec[Value]#len(args/142))
  } else {
      false
  } {
      {
        let name/145 = @intrinsic(vec.get)(Lambda.params(lambda/141), inherent#Ref#Ref[int32]#get(i/144)) in
        let value/146 = @intrinsic(vec.get)(args/142, inherent#Ref#Ref[int32]#get(i/144)) in
        let updated/147 = inherent#Vec#Vec[Binding]#pushed(inherent#Ref#Ref[Vec[Binding]]#get(env/143), Binding { name: name/145, value: value/146 }) in
        let mtmp148 = inherent#Ref#Ref[Vec[Binding]]#set(env/143, updated/147) in
        {
          inherent#Ref#Ref[int32]#set(i/144, (inherent#Ref#Ref[int32]#get(i/144) + 1))
        }
      }
  } in
  {
    eval(Lambda.body(lambda/141), inherent#Ref#Ref[Vec[Binding]]#get(env/143), Lambda.global(lambda/141))
  }
}

