fn print(value/0: T) -> unit {
  string_print(trait_call[ToString::to_string](value/0))
}

fn println(value/1: T) -> unit {
  string_println(trait_call[ToString::to_string](value/1))
}

fn main() -> unit {
  let arr/0 = [10, 20, 30] in
  let i/1 = inherent#Ref#Ref[int32]#new(0) in
  let _wild2 = while (inherent#Ref#Ref[int32]#get(i/1) < 3) {
      {
        let _wild0 = println(trait_call[ToString::to_string](array_get(arr/0, inherent#Ref#Ref[int32]#get(i/1)))) in
        let _wild1 = inherent#Ref#Ref[int32]#set(i/1, (inherent#Ref#Ref[int32]#get(i/1) + 1)) in
      }
  } in
  let floats/2 = [1.5, 2.5] in
  let _wild3 = println(trait_call[ToString::to_string](array_get(floats/2, 0))) in
  let _wild4 = println(trait_call[ToString::to_string](array_get(floats/2, 1))) in
  let longs/3 = [100, 200] in
  let _wild5 = println(trait_call[ToString::to_string](array_get(longs/3, 0))) in
  let _wild6 = println(trait_call[ToString::to_string](array_get(longs/3, 1))) in
}

fn inherent#Ref#Ref[T]#new(value/93: T) -> Ref[T] {
  ref(value/93)
}

fn inherent#Ref#Ref[T]#get(self/94: Ref[T]) -> T {
  ref_get(self/94)
}

fn inherent#Ref#Ref[T]#set(self/95: Ref[T], value/96: T) -> unit {
  ref_set(self/95, value/96)
}