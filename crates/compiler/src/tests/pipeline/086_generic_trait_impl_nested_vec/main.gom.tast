impl Size for Wrap[T]{
  fn size(self/0: Wrap[T]) -> int32 {
      1
  }
}

fn main() -> unit {
    let a/1: Wrap[int32] = Wrap { value: 1 };
    let b/2: Wrap[string] = Wrap { value: "x" };
    (println : (string) -> unit)((int32::to_string : (int32) -> string)((Size::size : (Wrap[int32]) -> int32)((a/1 : Wrap[int32]))));
    (println : (string) -> unit)((int32::to_string : (int32) -> string)((Size::size : (Wrap[string]) -> int32)((b/2 : Wrap[string]))));
}