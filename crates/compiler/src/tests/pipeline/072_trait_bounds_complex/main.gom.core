      {
        "true"
      }
  } else {
      {
        "false"
      }
  }
}

fn show_both(x/21: T) -> string {
  ((trait_call[Debug::show](x/21) + " / ") + trait_call[Display::show](x/21))
}

fn tag_text(tag/22: Q) -> string {
  ((trait_call[Debug::show](tag/22) + "#") + inherent#int32#int32#to_string(trait_call[MyHash::hash](tag/22)))
}

fn combine_scaled(a/23: T, b/24: T, factor/25: int32) -> T {
  trait_call[Scale::scale](trait_call[Add::add](a/23, b/24), factor/25)
}

fn report_pair(tag/26: Q, a/27: T, b/28: T, combined/29: T) -> string {
  let same/30 = trait_call[MyEq::eq](a/27, b/28) in
  let header/31 = tag_text(tag/26) in
  let repr/32 = show_both(combined/29) in
  let h/33 = trait_call[MyHash::hash](combined/29) in
  (((header/31 + " ") + repr/32) + ((" | eq=" + bool_text(same/30)) + (" | hash=" + inherent#int32#int32#to_string(h/33))))
}

fn full_report(tag/34: Q, a/35: T, b/36: T) -> string {
  let combined/37 = combine_scaled(a/35, b/36, 2) in
  report_pair(tag/34, a/35, b/36, combined/37)
}

fn sum_and_tag(tag/38: Q, x/39: T, y/40: T, z/41: T) -> string {
  let total/42 = trait_call[Add::add](trait_call[Add::add](x/39, y/40), z/41) in
  let header/43 = tag_text(tag/38) in
  let h/44 = trait_call[MyHash::hash](total/42) in
  (((header/43 + " ") + trait_call[Inspect::inspect](total/42)) + (" @" + inherent#int32#int32#to_string(h/44)))
}

fn main() -> unit {
  let mtmp4 = println(full_report(7, 10, 32)) in
  {
    let mtmp5 = println(full_report(Boxed { value: 99 }, Boxed { value: 3 }, Boxed { value: 4 })) in
    {
      let mtmp6 = println(sum_and_tag(0, 1, 2, 3)) in
      {
        let mtmp7 = println(sum_and_tag(Boxed { value: 1 }, Boxed { value: 5 }, Boxed { value: 6 }, Boxed { value: 7 })) in
        {
          ()
        }
      }
    }
  }
}