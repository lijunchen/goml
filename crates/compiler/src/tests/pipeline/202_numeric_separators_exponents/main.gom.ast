package main;
fn accepts_array_length(value: [int32; 10]) -> unit {
    let _ = value;
}

fn main() -> unit {
    let integer: int32 = 1000;
    let unsigned: uint64 = 4294967296;
    let float: float64 = 125;
    let small: float32 = 2.5;
    println(integer);
    println(unsigned);
    println(float);
    println(small);
    match integer {
        1000 => println("matched"),
        _ => println("missed"),
    }
}

