package main;
trait Mark {
  fn mark(self: Self) -> unit;
}

trait Extra {
  fn extra(self: Self) -> int32;
}

impl Mark for int32 {
  fn mark(self: int32) -> unit {
      ()
  }
}

impl[T: Mark] Extra for T {
  fn extra(self: T) -> int32 {
      42
  }
}

fn apply(value: T) -> int32 {
    value.extra()
}

fn main() -> unit {
    println(apply(1));
    println(2.extra());
}

