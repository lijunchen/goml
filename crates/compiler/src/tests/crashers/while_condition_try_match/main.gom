fn step(i: int32) -> Option[bool] {
    match i {
        0i32 => Option::Some(true),
        1i32 => Option::Some(true),
        2i32 => Option::Some(false),
        _ => Option::None,
    }
}

fn main() -> Option[unit] {
    let i = Ref::new(0i32);
    while match step(i.get())? {
        true => {
            i.set(i.get() + 1i32);
            true
        },
        false => false,
    } {
        ()
    };
    Option::Some(())
}
