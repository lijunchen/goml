trait Show {
    fn show(Self) -> string;
}

impl Show for int32 {
    fn show(self: int32) -> string {
        self.to_string()
    }
}

impl Eq for Ref[dyn Show] {
    fn eq(self: Ref[dyn Show], other: Ref[dyn Show]) -> bool {
        Show::show(self.get()) == Show::show(other.get())
    }
}

impl Hash for Ref[dyn Show] {
    fn hash(self: Ref[dyn Show]) -> uint64 {
        string_hash(Show::show(self.get()))
    }
}

fn main() {
    let h: HashMap[Ref[dyn Show], string] = HashMap::new();
    let inner: dyn Show = 1;
    let r = Ref::new(inner);
    h.set(r, "one");
    println(h.contains(r).to_string());
}
