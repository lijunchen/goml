trait Display {
    fn show(self: Self) -> string;
}

impl Display for int32 {
    fn show(self: int32) -> string {
        self.to_string()
    }
}

enum Boxed[T] {
    One((T, int32)),
}

fn build() -> int32 {
    let _: Boxed[dyn Display] = Boxed::One((return 7, 0));
    0
}

fn main() -> unit {
    println(build().to_string())
}
