trait Display {
    fn show(self: Self) -> string;
}

impl Display for int32 {
    fn show(self: int32) -> string {
        self.to_string()
    }
}

impl Hash for dyn Display {
    fn hash(self: dyn Display) -> uint64 {
        string_hash(Display::show(self))
    }
}

fn main() -> unit {
    let first: int32 = 1;
    let inner: dyn Display = first;
    let r = Ref::new(inner);
    let alias = r;
    let before = Hash::hash(r);
    let second: int32 = 2;
    let replacement: dyn Display = second;
    r.set(replacement);
    println((before == Hash::hash(alias)).to_string());
}
