enum E {
    A,
    B,
}

fn f(e: E, b: bool) -> int32 {
    match e {
        E::A => if b { () } else { () },
        E::B => (),
    };
    let i = Ref::new(0i32);
    while i.get() < 2i32 {
        i.set(i.get() + 1i32);
    };
    1i32
}

fn main() -> unit {
    println(f(E::A, true));
    println(f(E::B, false));
}
