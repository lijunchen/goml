trait Transform {
    fn apply(self: Self, arg1: int32) -> int32;
}

struct Adder { amount: int32 }
struct Multiplier { factor: int32 }

impl Transform for Adder {
    fn apply(self: Adder, x: int32) -> int32 { x + self.amount }
}

impl Transform for Multiplier {
    fn apply(self: Multiplier, x: int32) -> int32 { x * self.factor }
}

fn apply_all(transforms: Vec[dyn Transform], x: int32) -> int32 {
    let result = Ref::new(x);
    let i = Ref::new(0);
    while i.get() < transforms.len() {
        let t = transforms[i.get()];
        result.set(Transform::apply(t, result.get()));
        i.set(i.get() + 1);
    };
    result.get()
}

fn main() {
    let transforms: Vec[dyn Transform] = Vec::new();
    transforms.push(Adder { amount: 5 });
    transforms.push(Multiplier { factor: 3 });
    transforms.push(Adder { amount: -2 });
    let result = apply_all(transforms, 10);
    println(result.to_string());
}
