struct Foo {
    value: int32,
}

struct FooLower {
    value: int32,
}

fn get_upper(r: Ref[Foo]) -> int32 {
    r.get().value
}

fn get_lower(r: Ref[FooLower]) -> int32 {
    r.get().value
}

fn main() -> unit {
    let upper = Ref::new(Foo { value: 1 });
    let lower = Ref::new(FooLower { value: 2 });
    println(get_upper(upper));
    println(get_lower(lower));
}
