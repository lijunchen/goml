fn main() {
    let a: int8 = 42;
    let b: int16 = 1000;
    let c: int32 = 100000;
    let d: int64 = 10000000;
    let e: uint8 = 200;
    let f: uint16 = 50000;
    let g: uint32 = 3000000;
    let h: uint64 = 9000000000;
    println(a.to_string());
    println(b.to_string());
    println(c.to_string());
    println(d.to_string());
    println(e.to_string());
    println(f.to_string());
    println(g.to_string());
    println(h.to_string());
}
