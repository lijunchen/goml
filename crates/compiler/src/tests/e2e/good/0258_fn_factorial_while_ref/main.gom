fn factorial(n: int64) -> int64 {
    let result = Ref::new(1i64);
    let i = Ref::new(1i64);
    while i.get() <= n {
        result.set(result.get() * i.get());
        i.set(i.get() + 1i64);
    };
    result.get()
}

fn main() {
    println(factorial(10i64).to_string());
    println(factorial(20i64).to_string());
}
