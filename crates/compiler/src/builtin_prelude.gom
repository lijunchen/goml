impl [T: Eq] Eq for Ref[T] {
    fn eq(self: Ref[T], other: Ref[T]) -> bool {
        ptr_eq(self, other)
    }
}

impl [T: Hash] Hash for Ref[T] {
    fn hash(self: Ref[T]) -> uint64 {
        ptr_hash(self)
    }
}

impl [T: ToString] ToString for Ref[T] {
    fn to_string(self: Ref[T]) -> string {
        let v: T = self.get();
        "ref(" + ToString::to_string(v) + ")"
    }
}

impl [T] FnIterator[T] {
    fn from_fn(next_fn: () -> Option[T]) -> Self {
        FnIterator { next_fn }
    }
}

impl [T] Iterator for FnIterator[T] {
    type Item = T;

    fn next(self: Self) -> Option[T] {
        self.next_fn()
    }
}

impl [A, B, I: Iterator] Iterator for MapIterator[A, B, I]
where
    I::Item == A,
{
    type Item = B;

    fn next(self: Self) -> Option[B] {
        match Iterator::next(self.iterator) {
            Option::Some(value) => Option::Some(self.map_fn(value)),
            Option::None => Option::None,
        }
    }
}

impl [T, I: Iterator] Iterator for FilterIterator[T, I]
where
    I::Item == T,
{
    type Item = T;

    fn next(self: Self) -> Option[T] {
        while true {
            match Iterator::next(self.iterator) {
                Option::Some(value) => if self.predicate(value) {
                    return Option::Some(value)
                } else {
                    ()
                },
                Option::None => return Option::None,
            };
        };
        Option::None
    }
}

impl [I: Iterator] Iterator for TakeIterator[I] {
    type Item = I::Item;

    fn next(self: Self) -> Option[I::Item] {
        let remaining = self.remaining.get();
        if remaining > 0 {
            self.remaining.set(remaining - 1);
            Iterator::next(self.iterator)
        } else {
            Option::None
        }
    }
}

impl [I: Iterator] IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;

    fn into_iter(self: I) -> I {
        self
    }
}

fn iterator_map[A, B, I: Iterator](
    iterator: I,
    map_fn: (A) -> B,
) -> MapIterator[A, B, I]
where
    I::Item == A,
{
    MapIterator { iterator, map_fn }
}

fn iterator_filter[T, I: Iterator](
    iterator: I,
    predicate: (T) -> bool,
) -> FilterIterator[T, I]
where
    I::Item == T,
{
    FilterIterator { iterator, predicate }
}

fn iterator_take[I: Iterator](iterator: I, count: int32) -> TakeIterator[I] {
    let remaining = if count > 0 { count } else { 0 };
    TakeIterator {
        iterator,
        remaining: Ref::new(remaining),
    }
}

fn iterator_fold[T, A, I: Iterator](
    iterator: I,
    initial: A,
    combine: (A, T) -> A,
) -> A
where
    I::Item == T,
{
    let accumulator = Ref::new(initial);
    let running = Ref::new(true);
    while running.get() {
        match Iterator::next(iterator) {
            Option::Some(value) => accumulator.set(combine(accumulator.get(), value)),
            Option::None => running.set(false),
        };
    };
    accumulator.get()
}

fn iterator_collect[T, I: Iterator](iterator: I) -> Vec[T]
where
    I::Item == T,
{
    let values: Vec[T] = Vec::new();
    let running = Ref::new(true);
    while running.get() {
        match Iterator::next(iterator) {
            Option::Some(value) => values.push(value),
            Option::None => running.set(false),
        };
    };
    values
}

impl [T] Vec[T] {
    fn new() -> Self {
        vec_new()
    }

    fn push(self: Self, elem: T) -> unit {
        vec_push(self, elem)
    }

    fn pushed(self: Self, elem: T) -> Self {
        let result: Vec[T] = Vec::new();
        let index = Ref::new(0);
        while index.get() < self.len() {
            result.push(self.get(index.get()));
            index.set(index.get() + 1);
        };
        result.push(elem);
        result
    }

    fn get(self: Self, index: int32) -> T {
        vec_get(self, index)
    }

    fn set(self: Self, index: int32, elem: T) -> unit {
        vec_set(self, index, elem)
    }

    fn len(self: Self) -> int32 {
        vec_len(self)
    }

    fn slice(self: Self, start: int32, end: int32) -> Slice[T] {
        slice(self, start, end)
    }

    fn iter(self: Self) -> FnIterator[T] {
        let index = Ref::new(0);
        let len = self.len();
        FnIterator::from_fn(|| {
            let current = index.get();
            if current < len {
                let value = self.get(current);
                index.set(current + 1);
                Option::Some(value)
            } else {
                Option::None
            }
        })
    }
}

impl [T] IntoIterator for Vec[T] {
    type Item = T;
    type IntoIter = FnIterator[T];

    fn into_iter(self: Vec[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl [T] Slice[T] {
    fn get(self: Self, index: int32) -> T {
        slice_get(self, index)
    }

    fn len(self: Self) -> int32 {
        slice_len(self)
    }

    fn sub(self: Self, start: int32, end: int32) -> Self {
        slice_sub(self, start, end)
    }

    fn iter(self: Self) -> FnIterator[T] {
        let index = Ref::new(0);
        let len = self.len();
        FnIterator::from_fn(|| {
            let current = index.get();
            if current < len {
                let value = self.get(current);
                index.set(current + 1);
                Option::Some(value)
            } else {
                Option::None
            }
        })
    }
}

impl [T] IntoIterator for Slice[T] {
    type Item = T;
    type IntoIter = FnIterator[T];

    fn into_iter(self: Slice[T]) -> FnIterator[T] {
        self.iter()
    }
}

impl [K: Hash + Eq, V] HashMap[K, V] {
    fn new() -> Self {
        hashmap_new()
    }

    fn get(self: Self, key: K) -> Option[V] {
        hashmap_get(self, key)
    }

    fn set(self: Self, key: K, value: V) -> unit {
        hashmap_set(self, key, value)
    }

    fn remove(self: Self, key: K) -> unit {
        hashmap_remove(self, key)
    }

    fn len(self: Self) -> int32 {
        hashmap_len(self)
    }

    fn contains(self: Self, key: K) -> bool {
        hashmap_contains(self, key)
    }
}

impl [T] Ref[T] {
    fn new(value: T) -> Self {
        ref(value)
    }

    fn get(self: Self) -> T {
        ref_get(self)
    }

    fn set(self: Self, value: T) -> unit {
        ref_set(self, value)
    }
}

fn range(start: int32, end: int32) -> FnIterator[int32] {
    let current = Ref::new(start);
    FnIterator::from_fn(|| {
        let value = current.get();
        if value < end {
            current.set(value + 1);
            Option::Some(value)
        } else {
            Option::None
        }
    })
}
