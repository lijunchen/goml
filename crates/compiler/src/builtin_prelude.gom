fn print[T: ToString](value: T) -> unit {
    string_print(ToString::to_string(value))
}

fn println[T: ToString](value: T) -> unit {
    string_println(ToString::to_string(value))
}

fn char_from_uint32(value: uint32) -> Option[char] {
    let (valid, value) = char_from_uint32_raw(value);
    if valid {
        Option::Some(value)
    } else {
        Option::None
    }
}

impl int32 {
    fn to_string(self: int32) -> string {
        int32_to_string(self)
    }
}

impl char {
    fn to_string(self: char) -> string {
        char_to_string(self)
    }
}

impl string {
    fn len(self: string) -> int32 {
        string_len(self)
    }

    fn byte_len(self: string) -> int32 {
        string_len(self)
    }

    fn get(self: string, index: int32) -> char {
        string_get(self, index)
    }

    fn byte_get(self: string, index: int32) -> uint8 {
        string_byte_get(self, index)
    }

    fn byte_slice(self: string, start: int32, end: int32) -> string {
        string_byte_slice(self, start, end)
    }

    fn is_char_boundary(self: string, index: int32) -> bool {
        string_is_char_boundary(self, index)
    }

    fn decode_at(self: string, index: int32) -> Option[(char, int32)] {
        let (valid, value, width) = string_decode_utf8_at(self, index);
        if valid {
            Option::Some((value, width))
        } else {
            Option::None
        }
    }

    fn to_bytes(self: string) -> Vec[uint8] {
        string_to_bytes(self)
    }

    fn chars(self: string) -> FnIterator[char] {
        let index = Ref::new(0);
        FnIterator::from_fn(|| {
            match self.decode_at(index.get()) {
                Option::Some(decoded) => {
                    let (value, width) = decoded;
                    index.set(index.get() + width);
                    Option::Some(value)
                },
                Option::None => Option::None,
            }
        })
    }

    fn char_indices(self: string) -> FnIterator[(int32, char)] {
        let index = Ref::new(0);
        FnIterator::from_fn(|| {
            let current = index.get();
            match self.decode_at(current) {
                Option::Some(decoded) => {
                    let (value, width) = decoded;
                    index.set(current + width);
                    Option::Some((current, value))
                },
                Option::None => Option::None,
            }
        })
    }
}

