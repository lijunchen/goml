#[lang("option")]
enum Option[T] {
    None,
    Some(T),
}

#[lang("result")]
enum Result[T, E] {
    Ok(T),
    Err(E),
}

#[lang("iterator")]
trait Iterator {
    type Item;

    fn next(Self) -> Option[Self::Item];
}

#[lang("into_iterator")]
trait IntoIterator {
    type Item;
    type IntoIter: Iterator;

    fn into_iter(Self) -> Self::IntoIter;
}

struct FnIterator[T] {
    next_fn: () -> Option[T],
}

struct MapIterator[A, B, I] {
    iterator: I,
    map_fn: (A) -> B,
}

struct FilterIterator[T, I] {
    iterator: I,
    predicate: (T) -> bool,
}

struct TakeIterator[I] {
    iterator: I,
    remaining: Ref[int32],
}

#[intrinsic("vec.new")]
extern fn vec_new[T]() -> Vec[T]
#[intrinsic("vec.with_capacity")]
extern fn vec_with_capacity[T](capacity: int32) -> Vec[T]
#[intrinsic("vec.push")]
extern fn vec_push[T](vec: Vec[T], elem: T) -> unit
#[intrinsic("vec.get")]
extern fn vec_get[T](vec: Vec[T], index: int32) -> T
#[intrinsic("vec.set")]
extern fn vec_set[T](vec: Vec[T], index: int32, elem: T) -> unit
#[intrinsic("vec.len")]
extern fn vec_len[T](vec: Vec[T]) -> int32
#[intrinsic("vec.capacity")]
extern fn vec_capacity[T](vec: Vec[T]) -> int32
#[intrinsic("vec.reserve")]
extern fn vec_reserve[T](vec: Vec[T], additional: int32) -> unit
#[intrinsic("vec.truncate")]
extern fn vec_truncate[T](vec: Vec[T], len: int32) -> unit
#[intrinsic("slice.new")]
extern fn slice[T](vec: Vec[T], start: int32, end: int32) -> Slice[T]
#[intrinsic("slice.get")]
extern fn slice_get[T](s: Slice[T], index: int32) -> T
#[intrinsic("slice.len")]
extern fn slice_len[T](s: Slice[T]) -> int32
#[intrinsic("slice.sub")]
extern fn slice_sub[T](s: Slice[T], start: int32, end: int32) -> Slice[T]

#[lang("eq")]
trait Eq {
    fn eq(Self, Self) -> bool;
}

#[lang("hash")]
trait Hash {
    fn hash(Self) -> uint64;
}

#[intrinsic("hashmap.new")]
extern fn hashmap_new[K: Hash + Eq, V]() -> HashMap[K, V]
#[intrinsic("hashmap.get")]
extern fn hashmap_get[K: Hash + Eq, V](m: HashMap[K, V], key: K) -> Option[V]
#[intrinsic("hashmap.set")]
extern fn hashmap_set[K: Hash + Eq, V](m: HashMap[K, V], key: K, value: V) -> unit
#[intrinsic("hashmap.remove")]
extern fn hashmap_remove[K: Hash + Eq, V](m: HashMap[K, V], key: K) -> unit
#[intrinsic("hashmap.len")]
extern fn hashmap_len[K: Hash + Eq, V](m: HashMap[K, V]) -> int32
#[intrinsic("hashmap.contains")]
extern fn hashmap_contains[K: Hash + Eq, V](m: HashMap[K, V], key: K) -> bool
#[intrinsic("hashmap.entries")]
extern fn hashmap_entries[K: Hash + Eq, V](m: HashMap[K, V]) -> Vec[(K, V)]

#[intrinsic("compiler.missing")]
extern fn missing[T](message: string) -> T

#[lang("to_string")]
trait ToString {
    fn to_string(Self) -> string;
}
#[intrinsic("ref.new")]
extern fn ref[T](value: T) -> Ref[T]
#[intrinsic("ref.get")]
extern fn ref_get[T](reference: Ref[T]) -> T
#[intrinsic("ref.set")]
extern fn ref_set[T](reference: Ref[T], value: T) -> unit
#[intrinsic("ref.ptr_eq")]
extern fn ptr_eq[T](a: Ref[T], b: Ref[T]) -> bool
#[intrinsic("ref.ptr_hash")]
extern fn ptr_hash[T](reference: Ref[T]) -> uint64
