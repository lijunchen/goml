#[lang("option")]
enum Option[T] {
    None,
    Some(T),
}

#[lang("result")]
enum Result[T, E] {
    Ok(T),
    Err(E),
}

#[lang("iterator")]
trait Iterator {
    type Item;

    fn next(self: Self) -> Option[Self::Item];
}

#[lang("into_iterator")]
trait IntoIterator {
    type Item;
    type IntoIter: Iterator;

    fn into_iter(self: Self) -> Self::IntoIter;
}

struct FnIterator[T] {
    next_fn: () -> Option[T],
}

struct MapIterator[A, B, I] {
    iterator: I,
    map_fn: (A) -> B,
}

struct FilterIterator[T, I] {
    iterator: I,
    predicate: (T) -> bool,
}

struct TakeIterator[I] {
    iterator: I,
    remaining: Ref[int],
}

#[intrinsic("vec.new")]
extern fn vec_new[T]() -> Vec[T];
#[intrinsic("vec.with_capacity")]
extern fn vec_with_capacity[T](capacity: int) -> Vec[T];
#[intrinsic("vec.push")]
extern fn vec_push[T](vec: Vec[T], elem: T) -> unit;
#[intrinsic("vec.get")]
extern fn vec_get[T](vec: Vec[T], index: int) -> T;
#[intrinsic("vec.set")]
extern fn vec_set[T](vec: Vec[T], index: int, elem: T) -> unit;
#[intrinsic("vec.len")]
extern fn vec_len[T](vec: Vec[T]) -> int;
#[intrinsic("vec.capacity")]
extern fn vec_capacity[T](vec: Vec[T]) -> int;
#[intrinsic("vec.reserve")]
extern fn vec_reserve[T](vec: Vec[T], additional: int) -> unit;
#[intrinsic("vec.truncate")]
extern fn vec_truncate[T](vec: Vec[T], len: int) -> unit;
#[intrinsic("slice.new")]
extern fn slice[T](vec: Vec[T], start: int, end: int) -> Slice[T];
#[intrinsic("slice.get")]
extern fn slice_get[T](s: Slice[T], index: int) -> T;
#[intrinsic("slice.len")]
extern fn slice_len[T](s: Slice[T]) -> int;
#[intrinsic("slice.sub")]
extern fn slice_sub[T](s: Slice[T], start: int, end: int) -> Slice[T];

#[lang("eq")]
trait Eq {
    fn eq(self: Self, arg1: Self) -> bool;
}

#[intrinsic("eq.primitive")]
extern fn __goml_primitive_eq[T](first: T, second: T) -> bool;

#[lang("hash")]
trait Hash {
    fn hash(self: Self) -> uint64;
}

#[intrinsic("hashmap.new")]
extern fn hashmap_new[K: Hash + Eq, V]() -> HashMap[K, V];
#[intrinsic("hashmap.get")]
extern fn hashmap_get[K: Hash + Eq, V](m: HashMap[K, V], key: K) -> Option[V];
#[intrinsic("hashmap.set")]
extern fn hashmap_set[K: Hash + Eq, V](m: HashMap[K, V], key: K, value: V) -> unit;
#[intrinsic("hashmap.remove")]
extern fn hashmap_remove[K: Hash + Eq, V](m: HashMap[K, V], key: K) -> unit;
#[intrinsic("hashmap.len")]
extern fn hashmap_len[K: Hash + Eq, V](m: HashMap[K, V]) -> int;
#[intrinsic("hashmap.contains")]
extern fn hashmap_contains[K: Hash + Eq, V](m: HashMap[K, V], key: K) -> bool;
#[intrinsic("hashmap.entries")]
extern fn hashmap_entries[K: Hash + Eq, V](m: HashMap[K, V]) -> Vec[(K, V)];

#[intrinsic("channel.new")]
extern fn channel_new[T](capacity: int) -> Channel[T];
#[intrinsic("channel.send")]
extern fn channel_send[T](channel: Channel[T], value: T) -> unit;
#[intrinsic("channel.recv")]
extern fn channel_recv[T](channel: Channel[T]) -> (T, bool);
#[intrinsic("channel.close")]
extern fn channel_close[T](channel: Channel[T]) -> unit;

#[lang("to_string")]
trait ToString {
    fn to_string(self: Self) -> string;
}
#[intrinsic("ref.new")]
extern fn ref[T](value: T) -> Ref[T];
#[intrinsic("ref.get")]
extern fn ref_get[T](reference: Ref[T]) -> T;
#[intrinsic("ref.set")]
extern fn ref_set[T](reference: Ref[T], value: T) -> unit;
#[intrinsic("ref.ptr_eq")]
extern fn ptr_eq[T](a: Ref[T], b: Ref[T]) -> bool;
#[intrinsic("ref.ptr_hash")]
extern fn ptr_hash[T](reference: Ref[T]) -> uint64;
