#[test]
fn project_check_dry_run_prints_compiler_check_commands() -> unit {
    let root = test_support::workspace("check_dry_run");
    test_support::write_basic_project(root, "demo");
    let output = test_support::project_command(
        "check",
        "",
        Vec::new().pushed("--dry-run"),
        root,
    );
    test_support::assert_success(output);
    let stdout = test_support::stdout(output);
    test_support::assert_contains(
        stdout,
        "gomlc check --package demo --input main.gom --output _artifact/check/pkg/demo/package",
    );
    testing::assert(!fs::exists(path::join(root, "_artifact/check/pkg/demo/package.interface")))
}

#[test]
fn project_build_dry_run_prints_compiler_build_and_link_commands() -> unit {
    let root = test_support::workspace("build_dry_run");
    test_support::write_basic_project(root, "demo");
    let output = test_support::project_command(
        "build",
        "",
        Vec::new().pushed("--dry-run"),
        root,
    );
    test_support::assert_success(output);
    let stdout = test_support::stdout(output);
    test_support::assert_contains(
        stdout,
        "gomlc build --package demo --input main.gom --output _artifact/build/pkg/demo/package",
    );
    test_support::assert_contains(
        stdout,
        "gomlc link --input _artifact/build/pkg/demo/package.core --output _artifact/main.go --entry demo",
    );
    test_support::assert_contains(
        stdout,
        "go build -o _artifact/bin/demo _artifact/main.go",
    )
}

#[test]
fn project_run_dry_run_prints_the_complete_plan_without_tools() -> unit {
    let root = test_support::workspace("run_dry_run");
    test_support::write_basic_project(root, "demo");
    let output = test_support::project_command(
        "run",
        "",
        Vec::new()
            .pushed("--dry-run")
            .pushed("--")
            .pushed("alpha")
            .pushed("two words"),
        root,
    );
    test_support::assert_success(output);
    let stdout = test_support::stdout(output);
    test_support::assert_contains(
        stdout,
        "go build -o _artifact/bin/demo _artifact/main.go",
    );
    test_support::assert_contains(
        stdout,
        "_artifact/bin/demo alpha 'two words'",
    )
}

#[test]
fn project_build_creates_and_runs_the_native_binary() -> unit {
    let root = test_support::workspace("native_binary");
    test_support::write_basic_project(root, "demo");
    test_support::assert_success(migration_build(root));
    let output = match process::Command::new(
        path::join(root, "_artifact/bin/demo"),
    ).output() {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail(message);
            test_support::run(Vec::new().pushed("version"), root)
        },
    };
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "hello\n")
}

#[test]
fn project_check_and_build_work_for_complex_dependency_fixtures() -> unit {
    let projects = Vec::new()
        .pushed("project001")
        .pushed("project002")
        .pushed("project003")
        .pushed("project004")
        .pushed("project005")
        .pushed("project006")
        .pushed("project007_trait_impl_orphan_ok")
        .pushed("project008_trait_bounds_across_packages")
        .pushed("project009_builtin_option_result");
    for project_name in projects {
        let root = path::join(
            path::join(
                test_support::repository_root(),
                "crates/compiler/src/tests/module",
            ),
            project_name,
        );
        let target = path::join(
            path::join(
                test_support::module_root(),
                "_artifact/complex-fixtures",
            ),
            project_name,
        );
        let extra = Vec::new()
            .pushed("--target-dir")
            .pushed(target);
        test_support::assert_success(test_support::project_command(
            "check",
            root,
            extra,
            test_support::module_root(),
        ));
        test_support::assert_success(test_support::project_command(
            "build",
            root,
            extra,
            test_support::module_root(),
        ))
    }
}

#[test]
fn project_build_stops_when_compiler_subcommand_fails() -> unit {
    let root = test_support::workspace("compiler_failure");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nuse demo::A;\n\nfn main() -> unit { println(A::msg()) }\n",
    );
    test_support::write_file(
        path::join(root, "A/A.gom"),
        "package A;\n\npub fn msg() -> string { \"bad\" }\n",
    );
    let output = migration_build(root);
    test_support::assert_failure(output);
    test_support::assert_contains(
        test_support::stderr(output),
        "package name must start with a lowercase letter or `_`",
    )
}

#[test]
fn project_build_preserves_entry_directory_structure() -> unit {
    let root = test_support::workspace("entry_directory");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n",
    );
    test_support::write_file(
        path::join(root, "src/main.gom"),
        "package main;\n\nuse demo::src::Lib;\n\nfn main() -> unit { println(lib::msg()) }\n",
    );
    test_support::write_file(
        path::join(root, "src/Lib/Lib.gom"),
        "package lib;\n\npub fn msg() -> string { \"ok\" }\n",
    );
    let output = test_support::project_command(
        "build",
        "src",
        Vec::new(),
        root,
    );
    test_support::assert_success(output);
    testing::assert(fs::is_file(path::join(
        root,
        "_artifact/bin/src/src",
    )))
}

#[test]
fn project_test_runs_private_tests_and_ignores_test_sources_in_check() -> unit {
    let root = test_support::workspace("internal_tests");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n",
    );
    test_support::write_file(
        path::join(root, "math/math.gom"),
        "package math;\n\nfn double(value: int32) -> int32 { value * 2 }\n\npub fn add(left: int32, right: int32) -> int32 { left + right }\n",
    );
    test_support::write_file(
        path::join(root, "math/math_test.gom"),
        "package math;\n\nuse std::testing;\n\n#[test]\nfn add_works() -> unit { testing::assert_eq(add(2, 3), 5) }\n\n#[test]\nfn private_helper_works() -> unit { testing::assert_eq(double(4), 8) }\n\n#[test]\n#[ignore(\"later\")]\nfn ignored_case() -> unit { testing::assert(true) }\n",
    );
    let check = test_support::project_command(
        "check",
        "math",
        Vec::new().pushed("--dry-run"),
        root,
    );
    test_support::assert_success(check);
    test_support::assert_not_contains(
        test_support::stdout(check),
        "math_test.gom",
    );
    let tested = test_support::project_command(
        "test",
        "math",
        Vec::new().pushed("--jobs").pushed("2"),
        root,
    );
    test_support::assert_success(tested);
    let stdout = test_support::stdout(tested);
    test_support::assert_contains(stdout, "demo::math::add_works ... ok");
    test_support::assert_contains(
        stdout,
        "demo::math::private_helper_works ... ok",
    );
    test_support::assert_contains(stdout, "2 passed; 0 failed; 1 ignored");
    let listed = test_support::project_command(
        "test",
        "math",
        Vec::new().pushed("--list"),
        root,
    );
    test_support::assert_success(listed);
    test_support::assert_contains(
        test_support::stdout(listed),
        "demo::math::ignored_case: ignored",
    );
    let included = test_support::project_command(
        "test",
        "math",
        Vec::new().pushed("--include-ignored"),
        root,
    );
    test_support::assert_success(included);
    test_support::assert_contains(
        test_support::stdout(included),
        "3 passed; 0 failed; 0 ignored",
    );
    let json = test_support::project_command(
        "test",
        "math",
        Vec::new()
            .pushed("add_works")
            .pushed("--format")
            .pushed("json"),
        root,
    );
    test_support::assert_success(json);
    test_support::assert_contains(
        test_support::stdout(json),
        "{\"event\":\"ok\",\"name\":\"demo::math::add_works\"}",
    )
}

#[test]
fn project_test_dry_run_and_invalid_signature_diagnostics() -> unit {
    let root = test_support::workspace("invalid_test_signature");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n",
    );
    test_support::write_file(
        path::join(root, "value/value.gom"),
        "package value;\npub fn value() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "value/value_test.gom"),
        "package value;\n\n#[test]\nfn invalid[T](value: T) -> bool { true }\n",
    );
    let dry_run = test_support::project_command(
        "test",
        "value",
        Vec::new().pushed("--dry-run"),
        root,
    );
    test_support::assert_success(dry_run);
    test_support::assert_contains(
        test_support::stdout(dry_run),
        "gomlc test-build --package demo::value --input value/value.gom --input value/value_test.gom",
    );
    let output = test_support::project_command(
        "test",
        "value",
        Vec::new(),
        root,
    );
    test_support::assert_failure(output);
    let stderr = test_support::stderr(output);
    test_support::assert_contains(stderr, "must not have type parameters");
    test_support::assert_contains(stderr, "must not have parameters");
    test_support::assert_contains(stderr, "must return unit")
}

fn migration_wide_fields(count: int) -> string {
    let parts = Vec::new();
    for idx in range(0, count) {
        parts.push("f" + idx.to_string() + ": int32")
    };
    util::join(parts, ", ")
}

fn migration_wide_values(count: int) -> string {
    let parts = Vec::new();
    for idx in range(0, count) {
        parts.push("f" + idx.to_string() + ": " + idx.to_string())
    };
    util::join(parts, ", ")
}

fn migration_wide_pattern(count: int) -> string {
    let parts = Vec::new();
    for idx in range(0, count) {
        parts.push("f" + idx.to_string() + ": x" + idx.to_string())
    };
    util::join(parts, ", ")
}

fn migration_wide_sum(count: int) -> string {
    let parts = Vec::new();
    for idx in range(0, count) {
        parts.push("x" + idx.to_string())
    };
    util::join(parts, " + ")
}

fn migration_wide_struct_program(field_count: int, sum_count: int) -> string {
    "package main;\n\nstruct S { "
        + migration_wide_fields(field_count)
        + " }\nfn main() -> unit { let s = S { "
        + migration_wide_values(field_count)
        + " }; let total = match s { S { "
        + migration_wide_pattern(field_count)
        + " } => "
        + migration_wide_sum(sum_count)
        + " }; println(total.to_string()) }\n"
}

#[test]
fn project_build_handles_very_wide_struct_pattern() -> unit {
    let root = test_support::workspace("wide_struct_pattern");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"wideproj\"\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        migration_wide_struct_program(128, 128),
    );
    let output = migration_build(root);
    test_support::assert_success(output);
    testing::assert(fs::is_file(path::join(root, "_artifact/main.go")))
}

#[test]
fn test_sources_cannot_repair_a_broken_normal_package() -> unit {
    let root = test_support::workspace("broken_normal_package");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n",
    );
    test_support::write_file(
        path::join(root, "value/value.gom"),
        "package value;\npub fn value() -> int32 { test_only_value() }\n",
    );
    test_support::write_file(
        path::join(root, "value/value_test.gom"),
        "package value;\n\nfn test_only_value() -> int32 { 1 }\n\n#[test]\nfn value_works() -> unit { let _ = value(); () }\n",
    );
    // Normal check (without --tests) must fail: test-only items are not
    // visible to the normal package, so test sources cannot repair it.
    let checked = test_support::project_command(
        "check",
        "value",
        Vec::new(),
        root,
    );
    test_support::assert_failure(checked);
    test_support::assert_contains(
        test_support::stderr(checked),
        "test_only_value",
    )
}
