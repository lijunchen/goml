package main;

use gomlang::bootstrap_goml::test_support;
use gomlang::bootstrap_goml::util;
use std::fs;
use std::path;
use std::process;
use std::testing;

fn migration_deep_ref_type(depth: int) -> string {
    let result = Ref::new("int32");
    for _ in range(0, depth) {
        result.set("Ref[" + result.get() + "]")
    };
    result.get()
}

fn migration_build(root: string) -> process::Output {
    test_support::project_command(
        "build",
        "",
        Vec::new(),
        root,
    )
}

fn migration_check(root: string) -> process::Output {
    test_support::project_command(
        "check",
        "",
        Vec::new(),
        root,
    )
}

#[test]
fn project_build_handles_deep_public_interface_type() -> unit {
    let root = test_support::workspace("deep_public_interface");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"iface_deep\"\n",
    );
    test_support::write_file(
        path::join(root, "Lib/Lib.gom"),
        "package lib;\n\npub struct Wrap { value: "
            + migration_deep_ref_type(200)
            + " }\n\npub fn ping() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nuse iface_deep::Lib;\n\nfn main() -> unit { println(lib::ping().to_string()) }\n",
    );
    let output = migration_build(root);
    test_support::assert_success(output);
    testing::assert(fs::is_file(path::join(root, "_artifact/main.go")))
}

#[test]
fn project_build_loads_transitive_public_type_interfaces() -> unit {
    let root = test_support::workspace("transitive_public_types");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"transitive_types\"\n",
    );
    test_support::write_file(
        path::join(root, "model/model.gom"),
        "package model;\n\npub struct Box { pub value: int32 }\n\npub fn make() -> Box { Box { value: 42 } }\n",
    );
    test_support::write_file(
        path::join(root, "facade/facade.gom"),
        "package facade;\n\nuse transitive_types::model;\n\npub fn make() -> model::Box { model::make() }\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nuse transitive_types::facade;\n\nfn main() -> unit { println(facade::make().value.to_string()) }\n",
    );
    let output = migration_build(root);
    test_support::assert_success(output);
    let execution = match process::Command::new(
        path::join(root, "_artifact/bin/transitive_types"),
    ).output() {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail(message);
            output
        },
    };
    test_support::assert_success(execution);
    testing::assert_eq(test_support::stdout(execution), "42\n")
}

#[test]
fn version_prints_crate_version() -> unit {
    let output = test_support::run(
        Vec::new().pushed("version"),
        test_support::module_root(),
    );
    test_support::assert_success(output);
    testing::assert_eq(test_support::stdout(output), "goml 0.1.0\n")
}

#[test]
fn project_check_checks_module_from_cwd() -> unit {
    let root = test_support::workspace("check_from_cwd");
    test_support::write_basic_project(root, "demo");
    test_support::assert_success(migration_check(root));
    testing::assert(fs::is_file(path::join(
        root,
        "_artifact/check/pkg/demo/package.interface",
    )))
}

#[test]
fn project_build_writes_default_artifact_layout() -> unit {
    let root = test_support::workspace("default_artifact_layout");
    test_support::write_basic_project(root, "demo");
    test_support::assert_success(migration_build(root));
    testing::assert(fs::is_file(path::join(root, "_artifact/main.go")));
    testing::assert(fs::is_file(path::join(root, "_artifact/bin/demo")))
}

#[test]
fn project_uses_manifest_and_cli_target_directories() -> unit {
    let root = test_support::workspace("target_directories");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n\n[build]\ntarget-dir = \"out/generated\"\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nfn main() -> unit { println(\"hello\") }\n",
    );
    test_support::assert_success(migration_build(root));
    testing::assert(fs::is_file(path::join(root, "out/generated/main.go")));
    testing::assert(fs::is_file(path::join(root, "out/generated/bin/demo")));
    let override_output = test_support::project_command(
        "check",
        "",
        Vec::new().pushed("--target-dir").pushed("cli output"),
        root,
    );
    test_support::assert_success(override_output);
    testing::assert(fs::is_file(path::join(
        root,
        "cli output/check/pkg/demo/package.interface",
    )))
}

