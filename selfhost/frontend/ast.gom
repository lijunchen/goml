#[derive(Eq, Hash)]
pub enum NodeKind {
    File,
    Error,
    Attribute,
    Use,
    Mod,
    ExternFn,
    FnDef,
    GenericList,
    ParamList,
    Param,
    TypeMissing,
    TypeName,
    TypeUnit,
    TypeTuple,
    TypeFn,
    TypeArray,
    TypeDyn,
    Block,
    StmtLet,
    StmtExpr,
    StmtTail,
    PatternMissing,
    PatternWildcard,
    PatternVar,
    PatternTuple,
    PatternConstr,
    PatternLit,
    ExprMissing,
    ExprLit,
    ExprPath,
    ExprCall,
    ExprMethodCall,
    ExprField,
    ExprIndex,
    ExprUnary,
    ExprBinary,
    ExprTuple,
    ExprArray,
    ExprStructLit,
    Field,
    ExprBlock,
    ExprIf,
    ExprMatch,
    MatchArm,
    ExprWhile,
    ExprClosure,
    ExprReturn,
    ExprBreak,
    ExprContinue,
    ExprGo,
    StructDef,
    StructField,
    EnumDef,
    EnumVariant,
    TraitDef,
    ImplDef,
}

pub struct Node {
    kind: NodeKind,
    text: string,
    children: Vec[Node],
    start: int32,
    end: int32,
}

pub struct Diagnostic {
    start: int32,
    end: int32,
    message: string,
}

pub struct ParseResult {
    root: Node,
    diagnostics: Vec[Diagnostic],
}

pub struct CheckResult {
    diagnostics: Vec[Diagnostic],
}

pub fn empty_nodes() -> Vec[Node] {
    let nodes: Vec[Node] = Vec::new();
    nodes
}

pub fn empty_diagnostics() -> Vec[Diagnostic] {
    let diagnostics: Vec[Diagnostic] = Vec::new();
    diagnostics
}

pub fn node(kind: NodeKind, text: string, children: Vec[Node], start: int32, end: int32) -> Node {
    Node {
        kind: kind,
        text: text,
        children: children,
        start: start,
        end: end,
    }
}

pub fn leaf(kind: NodeKind, text: string, start: int32, end: int32) -> Node {
    node(kind, text, empty_nodes(), start, end)
}

pub fn diagnostic(start: int32, end: int32, message: string) -> Diagnostic {
    Diagnostic {
        start: start,
        end: end,
        message: message,
    }
}

pub fn parse_result(root: Node, diagnostics: Vec[Diagnostic]) -> ParseResult {
    ParseResult {
        root: root,
        diagnostics: diagnostics,
    }
}

pub fn check_result(diagnostics: Vec[Diagnostic]) -> CheckResult {
    CheckResult {
        diagnostics: diagnostics,
    }
}

pub fn node_kind_name(kind: NodeKind) -> string {
    match kind {
        NodeKind::File => "File",
        NodeKind::Error => "Error",
        NodeKind::Attribute => "Attribute",
        NodeKind::Use => "Use",
        NodeKind::Mod => "Mod",
        NodeKind::ExternFn => "ExternFn",
        NodeKind::FnDef => "FnDef",
        NodeKind::GenericList => "GenericList",
        NodeKind::ParamList => "ParamList",
        NodeKind::Param => "Param",
        NodeKind::TypeMissing => "TypeMissing",
        NodeKind::TypeName => "TypeName",
        NodeKind::TypeUnit => "TypeUnit",
        NodeKind::TypeTuple => "TypeTuple",
        NodeKind::TypeFn => "TypeFn",
        NodeKind::TypeArray => "TypeArray",
        NodeKind::TypeDyn => "TypeDyn",
        NodeKind::Block => "Block",
        NodeKind::StmtLet => "StmtLet",
        NodeKind::StmtExpr => "StmtExpr",
        NodeKind::StmtTail => "StmtTail",
        NodeKind::PatternMissing => "PatternMissing",
        NodeKind::PatternWildcard => "PatternWildcard",
        NodeKind::PatternVar => "PatternVar",
        NodeKind::PatternTuple => "PatternTuple",
        NodeKind::PatternConstr => "PatternConstr",
        NodeKind::PatternLit => "PatternLit",
        NodeKind::ExprMissing => "ExprMissing",
        NodeKind::ExprLit => "ExprLit",
        NodeKind::ExprPath => "ExprPath",
        NodeKind::ExprCall => "ExprCall",
        NodeKind::ExprMethodCall => "ExprMethodCall",
        NodeKind::ExprField => "ExprField",
        NodeKind::ExprIndex => "ExprIndex",
        NodeKind::ExprUnary => "ExprUnary",
        NodeKind::ExprBinary => "ExprBinary",
        NodeKind::ExprTuple => "ExprTuple",
        NodeKind::ExprArray => "ExprArray",
        NodeKind::ExprStructLit => "ExprStructLit",
        NodeKind::Field => "Field",
        NodeKind::ExprBlock => "ExprBlock",
        NodeKind::ExprIf => "ExprIf",
        NodeKind::ExprMatch => "ExprMatch",
        NodeKind::MatchArm => "MatchArm",
        NodeKind::ExprWhile => "ExprWhile",
        NodeKind::ExprClosure => "ExprClosure",
        NodeKind::ExprReturn => "ExprReturn",
        NodeKind::ExprBreak => "ExprBreak",
        NodeKind::ExprContinue => "ExprContinue",
        NodeKind::ExprGo => "ExprGo",
        NodeKind::StructDef => "StructDef",
        NodeKind::StructField => "StructField",
        NodeKind::EnumDef => "EnumDef",
        NodeKind::EnumVariant => "EnumVariant",
        NodeKind::TraitDef => "TraitDef",
        NodeKind::ImplDef => "ImplDef",
    }
}

fn indent(width: int32) -> string {
    let result = ref("");
    let i = ref(0);
    while ref_get(i) < width {
        ref_set(result, ref_get(result) + "  ");
        ref_set(i, ref_get(i) + 1);
    };
    ref_get(result)
}

fn format_node_at(value: Node, depth: int32) -> string {
    let line = if value.text == "" {
        indent(depth) + node_kind_name(value.kind) + " @" + value.start.to_string() + ".." + value.end.to_string()
    } else {
        indent(depth) + node_kind_name(value.kind) + "(" + value.text + ") @" + value.start.to_string() + ".." + value.end.to_string()
    };
    let result = ref(line + "\n");
    let i = ref(0);
    while ref_get(i) < value.children.len() {
        ref_set(result, ref_get(result) + format_node_at(value.children.get(ref_get(i)), depth + 1));
        ref_set(i, ref_get(i) + 1);
    };
    ref_get(result)
}

pub fn format_tree(value: Node) -> string {
    format_node_at(value, 0)
}

pub fn format_diagnostic(diagnostic: Diagnostic) -> string {
    diagnostic.start.to_string() + ".." + diagnostic.end.to_string() + " error: " + diagnostic.message
}

pub fn has_diagnostics(diagnostics: Vec[Diagnostic]) -> bool {
    diagnostics.len() > 0
}
