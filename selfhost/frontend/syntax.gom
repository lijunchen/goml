#[derive(Eq, Hash)]
pub enum TokenKind {
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Eq,
    Semi,
    Comma,
    ColonColon,
    Colon,
    Arrow,
    FatArrow,
    Plus,
    Minus,
    Star,
    Slash,
    Dot,
    AndAnd,
    OrOr,
    Pipe,
    Bang,
    Less,
    Greater,
    GreaterEq,
    LessEq,
    EqEq,
    NotEq,
    Question,
    Pound,
    ExternKeyword,
    PackageKeyword,
    UseKeyword,
    ImportKeyword,
    PubKeyword,
    ModKeyword,
    CrateKeyword,
    SuperKeyword,
    FnKeyword,
    TraitKeyword,
    ImplKeyword,
    ForKeyword,
    EnumKeyword,
    StructKeyword,
    TypeKeyword,
    MatchKeyword,
    IfKeyword,
    ElseKeyword,
    LetKeyword,
    MutKeyword,
    InKeyword,
    ReturnKeyword,
    GoKeyword,
    WhileKeyword,
    BreakKeyword,
    ContinueKeyword,
    DynKeyword,
    TrueKeyword,
    FalseKeyword,
    WildcardKeyword,
    UnitKeyword,
    BoolKeyword,
    Int8Keyword,
    Int16Keyword,
    Int32Keyword,
    Int64Keyword,
    Uint8Keyword,
    Uint16Keyword,
    Uint32Keyword,
    Uint64Keyword,
    Float32Keyword,
    Float64Keyword,
    StringKeyword,
    CharKeyword,
    ArrayKeyword,
    Ident,
    Float32Lit,
    Float64Lit,
    Float,
    Int8Lit,
    Int16Lit,
    Int32Lit,
    Int64Lit,
    UInt8Lit,
    UInt16Lit,
    UInt32Lit,
    UInt64Lit,
    Int,
    Str,
    MultilineStr,
    CharLit,
    Whitespace,
    Comment,
    Error,
    Eof,
}

pub struct Token {
    kind: TokenKind,
    text: string,
    start: int32,
    end: int32,
}

pub fn token(kind: TokenKind, text: string, start: int32, end: int32) -> Token {
    Token {
        kind: kind,
        text: text,
        start: start,
        end: end,
    }
}

pub fn is_trivia(kind: TokenKind) -> bool {
    match kind {
        TokenKind::Whitespace => true,
        TokenKind::Comment => true,
        _ => false,
    }
}

pub fn token_kind_name(kind: TokenKind) -> string {
    match kind {
        TokenKind::LParen => "LParen",
        TokenKind::RParen => "RParen",
        TokenKind::LBrace => "LBrace",
        TokenKind::RBrace => "RBrace",
        TokenKind::LBracket => "LBracket",
        TokenKind::RBracket => "RBracket",
        TokenKind::Eq => "Eq",
        TokenKind::Semi => "Semi",
        TokenKind::Comma => "Comma",
        TokenKind::ColonColon => "ColonColon",
        TokenKind::Colon => "Colon",
        TokenKind::Arrow => "Arrow",
        TokenKind::FatArrow => "FatArrow",
        TokenKind::Plus => "Plus",
        TokenKind::Minus => "Minus",
        TokenKind::Star => "Star",
        TokenKind::Slash => "Slash",
        TokenKind::Dot => "Dot",
        TokenKind::AndAnd => "AndAnd",
        TokenKind::OrOr => "OrOr",
        TokenKind::Pipe => "Pipe",
        TokenKind::Bang => "Bang",
        TokenKind::Less => "Less",
        TokenKind::Greater => "Greater",
        TokenKind::GreaterEq => "GreaterEq",
        TokenKind::LessEq => "LessEq",
        TokenKind::EqEq => "EqEq",
        TokenKind::NotEq => "NotEq",
        TokenKind::Question => "Question",
        TokenKind::Pound => "Pound",
        TokenKind::ExternKeyword => "ExternKeyword",
        TokenKind::PackageKeyword => "PackageKeyword",
        TokenKind::UseKeyword => "UseKeyword",
        TokenKind::ImportKeyword => "ImportKeyword",
        TokenKind::PubKeyword => "PubKeyword",
        TokenKind::ModKeyword => "ModKeyword",
        TokenKind::CrateKeyword => "CrateKeyword",
        TokenKind::SuperKeyword => "SuperKeyword",
        TokenKind::FnKeyword => "FnKeyword",
        TokenKind::TraitKeyword => "TraitKeyword",
        TokenKind::ImplKeyword => "ImplKeyword",
        TokenKind::ForKeyword => "ForKeyword",
        TokenKind::EnumKeyword => "EnumKeyword",
        TokenKind::StructKeyword => "StructKeyword",
        TokenKind::TypeKeyword => "TypeKeyword",
        TokenKind::MatchKeyword => "MatchKeyword",
        TokenKind::IfKeyword => "IfKeyword",
        TokenKind::ElseKeyword => "ElseKeyword",
        TokenKind::LetKeyword => "LetKeyword",
        TokenKind::MutKeyword => "MutKeyword",
        TokenKind::InKeyword => "InKeyword",
        TokenKind::ReturnKeyword => "ReturnKeyword",
        TokenKind::GoKeyword => "GoKeyword",
        TokenKind::WhileKeyword => "WhileKeyword",
        TokenKind::BreakKeyword => "BreakKeyword",
        TokenKind::ContinueKeyword => "ContinueKeyword",
        TokenKind::DynKeyword => "DynKeyword",
        TokenKind::TrueKeyword => "TrueKeyword",
        TokenKind::FalseKeyword => "FalseKeyword",
        TokenKind::WildcardKeyword => "WildcardKeyword",
        TokenKind::UnitKeyword => "UnitKeyword",
        TokenKind::BoolKeyword => "BoolKeyword",
        TokenKind::Int8Keyword => "Int8Keyword",
        TokenKind::Int16Keyword => "Int16Keyword",
        TokenKind::Int32Keyword => "Int32Keyword",
        TokenKind::Int64Keyword => "Int64Keyword",
        TokenKind::Uint8Keyword => "Uint8Keyword",
        TokenKind::Uint16Keyword => "Uint16Keyword",
        TokenKind::Uint32Keyword => "Uint32Keyword",
        TokenKind::Uint64Keyword => "Uint64Keyword",
        TokenKind::Float32Keyword => "Float32Keyword",
        TokenKind::Float64Keyword => "Float64Keyword",
        TokenKind::StringKeyword => "StringKeyword",
        TokenKind::CharKeyword => "CharKeyword",
        TokenKind::ArrayKeyword => "ArrayKeyword",
        TokenKind::Ident => "Ident",
        TokenKind::Float32Lit => "Float32Lit",
        TokenKind::Float64Lit => "Float64Lit",
        TokenKind::Float => "Float",
        TokenKind::Int8Lit => "Int8Lit",
        TokenKind::Int16Lit => "Int16Lit",
        TokenKind::Int32Lit => "Int32Lit",
        TokenKind::Int64Lit => "Int64Lit",
        TokenKind::UInt8Lit => "UInt8Lit",
        TokenKind::UInt16Lit => "UInt16Lit",
        TokenKind::UInt32Lit => "UInt32Lit",
        TokenKind::UInt64Lit => "UInt64Lit",
        TokenKind::Int => "Int",
        TokenKind::Str => "Str",
        TokenKind::MultilineStr => "MultilineStr",
        TokenKind::CharLit => "CharLit",
