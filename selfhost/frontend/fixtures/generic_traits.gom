package fixtures;

trait Convert[T] where T: Show {
    type Output: Show;

    fn convert(Self) -> T;
}

struct Box[T] {
    value: T,
}

impl[T: Show] Convert[T] for Box[T] where Vec[T]: Show {
    type Output = T;

    fn convert(self: Box[T]) -> T {
        self.value
    }
}

fn same[T, U](value: T) -> U where T == U {
    value
}

fn explicit(value: Box[int32]) -> int32 {
    Convert[int32]::convert(value)
}
