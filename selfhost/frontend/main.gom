mod lexer;
mod ast;
mod parser;
mod syntax;
mod typecheck;

use std::env;
use std::fs;
use std::io;
use std::process;

fn usage() -> string {
    "usage: frontend tokens|parse <file.gom>\n       frontend check <file.gom> [more.gom ...]"
}

fn print_token(token: crate::syntax::Token) -> unit {
    std::io::println(token.start.to_string() + ".." + token.end.to_string() + " " + crate::syntax::token_kind_name(token.kind) + " " + token.text)
}

fn print_tokens(tokens: Vec[crate::syntax::Token]) -> unit {
    let i = ref(0);
    while ref_get(i) < tokens.len() {
        print_token(tokens.get(ref_get(i)));
        ref_set(i, ref_get(i) + 1);
    }
}

fn run_tokens(path: string) -> int32 {
    match std::fs::read_file(path) {
        Result::Ok(source) => {
            print_tokens(crate::lexer::lex(source));
            0
        },
        Result::Err(err) => {
            std::io::println("error: " + err);
            1
        },
    }
}

fn print_diagnostics(diagnostics: Vec[crate::ast::Diagnostic]) -> unit {
    let i = ref(0);
    while ref_get(i) < diagnostics.len() {
        std::io::println(crate::ast::format_diagnostic(diagnostics.get(ref_get(i))));
        ref_set(i, ref_get(i) + 1);
    }
}

fn run_parse(path: string) -> int32 {
    match std::fs::read_file(path) {
        Result::Ok(source) => {
            let result = crate::parser::parse_source(source);
            std::io::println(crate::ast::format_tree(result.root));
            print_diagnostics(result.diagnostics);
            if crate::ast::has_diagnostics(result.diagnostics) {
                1
            } else {
                0
            }
        },
        Result::Err(err) => {
            std::io::println("error: " + err);
            1
        },
    }
}

fn basename(path: string) -> string {
    let start = ref(0);
    let i = ref(0);
    while ref_get(i) < path.len() {
        if path.get(ref_get(i)) == '/' {
            ref_set(start, ref_get(i) + 1);
        } else {
            ()
        };
        ref_set(i, ref_get(i) + 1);
    };
    let result = ref("");
    let j = ref(ref_get(start));
    while ref_get(j) < path.len() {
        ref_set(result, ref_get(result) + path.get(ref_get(j)).to_string());
        ref_set(j, ref_get(j) + 1);
    };
    ref_get(result)
}

fn strip_gom_suffix(name: string) -> string {
    if name.len() >= 4 && name.get(name.len() - 4) == '.' && name.get(name.len() - 3) == 'g' && name.get(name.len() - 2) == 'o' && name.get(name.len() - 1) == 'm' {
        let result = ref("");
        let i = ref(0);
        while ref_get(i) + 4 < name.len() {
            ref_set(result, ref_get(result) + name.get(ref_get(i)).to_string());
            ref_set(i, ref_get(i) + 1);
        };
        ref_get(result)
    } else {
        name
    }
}

fn module_name(path: string) -> string {
    strip_gom_suffix(basename(path))
}

fn run_check(args: Vec[string]) -> int32 {
    let files0: Vec[crate::typecheck::SourceFile] = Vec::new();
    let files = ref(files0);
    let failed = ref(false);
    let i = ref(2);
    while ref_get(i) < args.len() {
        let path = args.get(ref_get(i));
        match std::fs::read_file(path) {
            Result::Ok(source) => {
                let parsed = crate::parser::parse_source(source);
                if crate::ast::has_diagnostics(parsed.diagnostics) {
                    print_diagnostics(parsed.diagnostics);
                    ref_set(failed, true);
                } else {
                    ref_set(files, ref_get(files).push(crate::typecheck::source_file(module_name(path), parsed.root)));
                };
            },
            Result::Err(err) => {
                std::io::println("error: " + err);
                ref_set(failed, true);
            },
        };
        ref_set(i, ref_get(i) + 1);
    };
    if ref_get(failed) {
        1
    } else {
        let result = crate::typecheck::check(ref_get(files));
        print_diagnostics(result.diagnostics);
        if crate::ast::has_diagnostics(result.diagnostics) {
            1
        } else {
            std::io::println("check ok");
            0
        }
    }
}

fn main() -> unit {
    let args = std::env::args();
    if args.len() == 3 && args.get(1) == "tokens" {
        std::process::exit(run_tokens(args.get(2)))
    } else if args.len() == 3 && args.get(1) == "parse" {
        std::process::exit(run_parse(args.get(2)))
    } else if args.len() >= 3 && args.get(1) == "check" {
        std::process::exit(run_check(args))
    } else {
        std::io::println(usage());
        std::process::exit(1)
    }
}
