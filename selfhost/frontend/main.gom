package main;

use frontend::ast;
use frontend::lexer;
use frontend::parser;
use frontend::syntax;
use frontend::typecheck;
use std::env;
use std::fs;
use std::io;
use std::process;

fn usage() -> string {
    "usage: frontend tokens|parse <file.gom>\n       frontend check <file.gom> [more.gom ...]"
}

fn print_token(token: syntax::Token) -> unit {
    io::println(token.start.to_string() + ".." + token.end.to_string() + " " + syntax::token_kind_name(token.kind) + " " + token.text)
}

fn print_tokens(tokens: Vec[syntax::Token]) -> unit {
    let i = Ref::new(0);
    while i.get() < tokens.len() {
        print_token(tokens.get(i.get()));
        i.set(i.get() + 1);
    }
}

fn run_tokens(path: string) -> int32 {
    match fs::read_file(path) {
        Result::Ok(source) => {
            print_tokens(lexer::lex(source));
            0
        },
        Result::Err(err) => {
            io::println("error: " + err);
            1
        },
    }
}

fn print_diagnostics(diagnostics: Vec[ast::Diagnostic]) -> unit {
    let i = Ref::new(0);
    while i.get() < diagnostics.len() {
        io::println(ast::format_diagnostic(diagnostics.get(i.get())));
        i.set(i.get() + 1);
    }
}

fn run_parse(path: string) -> int32 {
    match fs::read_file(path) {
        Result::Ok(source) => {
            let result = parser::parse_source(source);
            io::println(ast::format_tree(result.root));
            print_diagnostics(result.diagnostics);
            if ast::has_diagnostics(result.diagnostics) {
                1
            } else {
                0
            }
        },
        Result::Err(err) => {
            io::println("error: " + err);
            1
        },
    }
}

fn basename(path: string) -> string {
    let start = Ref::new(0);
    let i = Ref::new(0);
    while i.get() < path.len() {
        if path.get(i.get()) == '/' {
            start.set(i.get() + 1);
        } else {
            ()
        };
        i.set(i.get() + 1);
    };
    let result = Ref::new("");
    let j = Ref::new(start.get());
    while j.get() < path.len() {
        result.set(result.get() + path.get(j.get()).to_string());
        j.set(j.get() + 1);
    };
    result.get()
}

fn strip_gom_suffix(name: string) -> string {
    if name.len() >= 4 && name.get(name.len() - 4) == '.' && name.get(name.len() - 3) == 'g' && name.get(name.len() - 2) == 'o' && name.get(name.len() - 1) == 'm' {
        let result = Ref::new("");
        let i = Ref::new(0);
        while i.get() + 4 < name.len() {
            result.set(result.get() + name.get(i.get()).to_string());
            i.set(i.get() + 1);
        };
        result.get()
    } else {
        name
    }
}

fn source_package(path: string, root: ast::Node) -> string {
    let i = Ref::new(0);
    let result = Ref::new("");
    while result.get() == "" && i.get() < root.children.len() {
        let item = root.children.get(i.get());
        if ast::node_kind_name(item.kind) == ast::node_kind_name(ast::NodeKind::Package) {
            result.set(item.text);
        } else {
            ()
        };
        i.set(i.get() + 1);
    };
    if result.get() == "" {
        strip_gom_suffix(basename(path))
    } else {
        result.get()
    }
}

fn run_check(args: Vec[string]) -> int32 {
    let files0: Vec[typecheck::SourceFile] = Vec::new();
    let files = Ref::new(files0);
    let failed = Ref::new(false);
    let i = Ref::new(2);
    while i.get() < args.len() {
        let path = args.get(i.get());
        match fs::read_file(path) {
            Result::Ok(source) => {
                let parsed = parser::parse_source(source);
                if ast::has_diagnostics(parsed.diagnostics) {
                    print_diagnostics(parsed.diagnostics);
                    failed.set(true);
                } else {
                    files.set(files.get().pushed(typecheck::source_file(source_package(path, parsed.root), parsed.root)));
                };
            },
            Result::Err(err) => {
                io::println("error: " + err);
                failed.set(true);
            },
        };
        i.set(i.get() + 1);
    };
    if failed.get() {
        1
    } else {
        let result = typecheck::check(files.get());
        print_diagnostics(result.diagnostics);
        if ast::has_diagnostics(result.diagnostics) {
            1
        } else {
            io::println("check ok");
            0
        }
    }
}

fn main() -> unit {
    let args = env::args();
    if args.len() == 3 && args.get(1) == "tokens" {
        process::exit(run_tokens(args.get(2)))
    } else if args.len() == 3 && args.get(1) == "parse" {
        process::exit(run_parse(args.get(2)))
    } else if args.len() >= 3 && args.get(1) == "check" {
        process::exit(run_check(args))
    } else {
        io::println(usage());
        process::exit(1)
    }
}
