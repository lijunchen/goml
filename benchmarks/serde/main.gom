package main;

use std::bincode;
use std::json;
use std::serde;
use std::toml;
use serde::{Deserialize, Serialize};

#[derive(Serialize, Deserialize)]
struct Details {
    label: string,
    pair: (int16, bool),
    short_values: Vec[int8],
}

#[derive(Serialize, Deserialize)]
enum Mode {
    Idle,
    Batch(Vec[int32]),
    Named {
        code: uint32,
        label: string,
    },
}

#[derive(Serialize, Deserialize)]
struct Record {
    id: uint64,
    active: bool,
    name: string,
    details: Details,
    mode: Mode,
    values: Vec[int32],
    note: Option[string],
    large: string,
}

#[derive(Serialize, Deserialize)]
struct TomlDetails {
    owner: string,
    retries: int64,
}

#[derive(Serialize, Deserialize)]
struct TomlRecord {
    title: string,
    enabled: bool,
    tags: Vec[string],
    details: TomlDetails,
}

fn long_values() -> Vec[int32] {
    let values: Vec[int32] = Vec::with_capacity(256);
    let mut index = 0;
    while index < 256 {
        values.push(index as int32);
        index = index + 1;
    }
    values
}

fn record() -> Record {
    Record {
        id: 4294967296,
        active: true,
        name: "streaming-serde",
        details: Details { label: "nested", pair: (-12, true), short_values: Vec::[1, -2, 3, -4] },
        mode: Mode::Named { code: 77, label: "selected" },
        values: long_values(),
        note: Option::Some("benchmark"),
        large: "",
    }
}

fn toml_record() -> TomlRecord {
    TomlRecord {
        title: "streaming-serde",
        enabled: true,
        tags: Vec::["flat", "nested", "typed"],
        details: TomlDetails { owner: "goml", retries: 4 },
    }
}

fn record_score(value: Record) -> int {
    let mode = match value.mode {
        Mode::Idle => 0,
        Mode::Batch(values) => values.len(),
        Mode::Named { code, label } => code as int + label.byte_len(),
    };
    value.name.byte_len() + value.details.label.byte_len() + value.details.short_values.len()
        + value.values.len()
        + value.large.byte_len()
        + mode
}

fn toml_score(value: TomlRecord) -> int {
    value.title.byte_len() + value.tags.len() + value.details.owner.byte_len()
        + value.details.retries as int
}

pub fn serde_benchmark_json_input() -> string {
    json::to_string(record())
}

pub fn serde_benchmark_bincode_standard_input() -> Vec[byte] {
    match bincode::encode_to_vec(record(), bincode::standard()) {
        Ok(value) => value,
        Err(_) => Vec::[],
    }
}

pub fn serde_benchmark_bincode_legacy_input() -> Vec[byte] {
    match bincode::encode_to_vec(record(), bincode::legacy()) {
        Ok(value) => value,
        Err(_) => Vec::[],
    }
}

pub fn serde_benchmark_toml_input() -> string {
    match toml::to_string(toml_record()) {
        Ok(value) => {
            if value.byte_len() < 0 {
                let _ = toml_decode(value);
            } else {};
            value
        },
        Err(_) => "",
    }
}

pub fn serde_benchmark_json_direct_encode() -> int {
    json::to_string(record()).byte_len()
}

pub fn serde_benchmark_json_value_encode() -> int {
    json::encode(json::to_value(record())).byte_len()
}

pub fn serde_benchmark_json_direct_decode(input: string) -> int {
    let decoded: Result[Record, string] = json::from_string(input);
    match decoded {
        Ok(value) => record_score(value),
        Err(_) => 0,
    }
}

pub fn serde_benchmark_json_value_decode(input: string) -> int {
    let parsed = match json::parse(input) {
        Ok(value) => value,
        Err(_) => return 0,
    };
    let decoded: Result[Record, string] = json::from_value(parsed);
    match decoded {
        Ok(value) => record_score(value),
        Err(_) => 0,
    }
}

fn bincode_direct_encode(config: bincode::Config) -> int {
    match bincode::encode_to_vec(record(), config) {
        Ok(value) => value.len(),
        Err(_) => 0,
    }
}

fn bincode_value_encode(config: bincode::Config) -> int {
    match bincode::encode_value(serde::to_value(record()), config) {
        Ok(value) => value.len(),
        Err(_) => 0,
    }
}

pub fn serde_benchmark_bincode_standard_direct_encode() -> int {
    bincode_direct_encode(bincode::standard())
}

pub fn serde_benchmark_bincode_standard_value_encode() -> int {
    bincode_value_encode(bincode::standard())
}

pub fn serde_benchmark_bincode_legacy_direct_encode() -> int {
    bincode_direct_encode(bincode::legacy())
}

pub fn serde_benchmark_bincode_legacy_value_encode() -> int {
    bincode_value_encode(bincode::legacy())
}

fn bincode_direct_decode(input: Vec[byte], config: bincode::Config) -> int {
    let decoded: Result[(Record, int), string] = bincode::decode_from_slice(
        input.slice(0, input.len()),
        config,
    );
    match decoded {
        Ok((value, consumed)) => record_score(value) + consumed,
        Err(_) => 0,
    }
}

fn bincode_value_decode(input: Vec[byte], config: bincode::Config) -> int {
    let schema: serde::TypedSchema[Record] = Deserialize::schema();
    let decoded = bincode::decode_value(input.slice(0, input.len()), schema.value, config);
    match decoded {
        Ok((value, consumed)) => {
            let record: Result[Record, string] = Deserialize::deserialize(value);
            match record {
                Ok(value) => record_score(value) + consumed,
                Err(_) => 0,
            }
        },
        Err(_) => 0,
    }
}

pub fn serde_benchmark_bincode_standard_direct_decode(input: Vec[byte]) -> int {
    bincode_direct_decode(input, bincode::standard())
}

pub fn serde_benchmark_bincode_standard_value_decode(input: Vec[byte]) -> int {
    bincode_value_decode(input, bincode::standard())
}

pub fn serde_benchmark_bincode_legacy_direct_decode(input: Vec[byte]) -> int {
    bincode_direct_decode(input, bincode::legacy())
}

pub fn serde_benchmark_bincode_legacy_value_decode(input: Vec[byte]) -> int {
    bincode_value_decode(input, bincode::legacy())
}

pub fn serde_benchmark_toml_encode() -> int {
    match toml::to_string(toml_record()) {
        Ok(value) => {
            if value.byte_len() < 0 {
                let _ = toml_decode(value);
            } else {};
            value.byte_len()
        },
        Err(_) => 0,
    }
}

fn toml_decode(input: string) -> int {
    let decoded: Result[TomlRecord, string] = toml::from_string(input);
    match decoded {
        Ok(value) => toml_score(value),
        Err(_) => 0,
    }
}

pub fn serde_benchmark_toml_decode(input: string) -> int {
    toml_decode(input)
}

fn main() -> unit {
    let json_input = serde_benchmark_json_input();
    let bincode_standard_input = serde_benchmark_bincode_standard_input();
    let bincode_legacy_input = serde_benchmark_bincode_legacy_input();
    let toml_input = serde_benchmark_toml_input();
    println(serde_benchmark_json_direct_encode());
    println(serde_benchmark_bincode_standard_direct_encode());
    println(serde_benchmark_bincode_legacy_direct_encode());
    println(serde_benchmark_toml_encode());
    let _ = serde_benchmark_json_value_encode();
    let _ = serde_benchmark_json_value_encode();
    let _ = serde_benchmark_json_direct_decode(json_input);
    let _ = serde_benchmark_json_direct_decode(json_input);
    let _ = serde_benchmark_json_value_decode(json_input);
    let _ = serde_benchmark_json_value_decode(json_input);
    let _ = serde_benchmark_bincode_standard_value_encode();
    let _ = serde_benchmark_bincode_standard_direct_decode(bincode_standard_input);
    let _ = serde_benchmark_bincode_standard_direct_decode(bincode_standard_input);
    let _ = serde_benchmark_bincode_standard_value_decode(bincode_standard_input);
    let _ = serde_benchmark_bincode_standard_value_decode(bincode_standard_input);
    let _ = serde_benchmark_bincode_legacy_value_encode();
    let _ = serde_benchmark_bincode_legacy_direct_decode(bincode_legacy_input);
    let _ = serde_benchmark_bincode_legacy_direct_decode(bincode_legacy_input);
    let _ = serde_benchmark_bincode_legacy_value_decode(bincode_legacy_input);
    let _ = serde_benchmark_bincode_legacy_value_decode(bincode_legacy_input);
    let _ = serde_benchmark_toml_decode(toml_input);
    let _ = serde_benchmark_toml_decode(toml_input);
}
