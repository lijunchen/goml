package commands;

use gomlang::bootstrap_goml::util;
use std::env;
use std::fs;
use std::io;
use std::path;

fn create_directory(value: string) -> Result[unit, string] {
    match fs::create_dir_all(value) {
        Result::Ok(()) => Result::Ok(()),
        Result::Err(message) => Result::Err(message),
    }
}

fn write_file(value: string, content: string) -> Result[unit, string] {
    match fs::write_file(value, content) {
        Result::Ok(()) => Result::Ok(()),
        Result::Err(message) => Result::Err(message),
    }
}

pub fn home_directory() -> Result[string, string] {
    match env::var("GOML_HOME") {
        Option::Some(value) => if value != "" {
            return Result::Ok(value)
        } else {
            ()
        },
        Option::None => (),
    };
    match env::var("HOME") {
        Option::Some(value) => if value != "" {
            return Result::Ok(path::join(value, ".goml"))
        } else {
            ()
        },
        Option::None => (),
    };
    match env::var("USERPROFILE") {
        Option::Some(value) => if value != "" {
            return Result::Ok(path::join(value, ".goml"))
        } else {
            ()
        },
        Option::None => (),
    };
    Result::Err("failed to determine home directory")
}

pub fn print_home() -> Result[unit, string] {
    let home = match home_directory() {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    match ensure_home_layout() {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    let bin = path::join(home, "bin");
    let lib = path::join(home, "lib");
    let std = path::join(lib, "std");
    let cache = path::join(home, "cache");
    io::println("GOML_HOME=" + home);
    io::println("bin=" + bin);
    io::println("lib=" + lib);
    io::println("std=" + std);
    io::println("cache=" + cache);
    Result::Ok(())
}

pub fn ensure_home_layout() -> Result[unit, string] {
    let home = match home_directory() {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    for directory in Vec::new()
        .pushed(home)
        .pushed(path::join(home, "bin"))
        .pushed(path::join(home, "lib"))
        .pushed(path::join(home, "cache"))
    {
        match create_directory(directory) {
            Result::Ok(()) => (),
            Result::Err(message) => return Result::Err(message),
        }
    };
    Result::Ok(())
}

fn valid_identifier(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    } else {
        ()
    };
    let first = value.byte_get(0);
    if !((first >= 65 && first <= 90)
        || (first >= 97 && first <= 122)
        || first == 95)
    {
        return false
    } else {
        ()
    };
    for index in range(1, value.byte_len()) {
        let byte = value.byte_get(index);
        if (byte >= 48 && byte <= 57)
            || (byte >= 65 && byte <= 90)
            || (byte >= 97 && byte <= 122)
            || byte == 95
        {
            ()
        } else {
            return false
        }
    };
    true
}

fn validate_project_name(value: string) -> Result[unit, string] {
    if !valid_identifier(value) {
        Result::Err(
            "invalid project name `"
                + value
                + "`: expected identifier [A-Za-z_][A-Za-z0-9_]*",
        )
    } else if value == "main" || value == "builtin" || value == "std" {
        Result::Err("module path `" + value + "` is reserved")
    } else {
        Result::Ok(())
    }
}

fn ensure_project_directory(value: string) -> Result[unit, string] {
    if fs::is_file(value) {
        return Result::Err(
            "target directory " + value + " already exists and is not empty",
        )
    } else if fs::is_dir(value) {
        let entries = match fs::read_dir(value) {
            Result::Ok(entries) => entries,
            Result::Err(message) => return Result::Err(message),
        };
        if entries.len() > 0 {
            return Result::Err(
                "target directory " + value + " already exists and is not empty",
            )
        } else {
            Result::Ok(())
        }
    } else {
        create_directory(value)
    }
}

pub fn new_project(name: string, base: string) -> Result[unit, string] {
    match validate_project_name(name) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    let project = path::join(base, name);
    match ensure_project_directory(project) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    let lib = path::join(project, "lib");
    match create_directory(lib) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    match write_file(
        path::join(project, "goml.toml"),
        "[module]\npath = \"" + name + "\"\n",
    ) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    match write_file(path::join(project, ".gitignore"), "/_artifact/\n") {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    match write_file(
        path::join(project, "main.gom"),
        "package main;\n\nuse "
            + name
            + "::lib;\n\nfn main() -> unit {\n    println(lib::message())\n}\n",
    ) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    match write_file(
        path::join(lib, "lib.gom"),
        "package lib;\n\npub fn message() -> string {\n    \"hello from lib\"\n}\n",
    ) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    io::println("Created project at " + project);
    io::println("Next steps:");
    io::println("  cd " + project);
    io::println("  goml check");
    io::println("  goml build");
    Result::Ok(())
}

pub fn parse_new(args: Vec[string]) -> Result[unit, string] {
    let name: Ref[Option[string]] = Ref::new(Option::None);
    let base = Ref::new(".");
    let index = Ref::new(2);
    while index.get() < args.len() {
        let argument = args.get(index.get());
        if argument == "--path" {
            if index.get() + 1 >= args.len() {
                return Result::Err("--path requires a value")
            } else {
                base.set(args.get(index.get() + 1));
                index.set(index.get() + 2)
            }
        } else if util::starts_with(argument, "--path=") {
            let value = argument.byte_slice(7, argument.byte_len());
            if value == "" {
                return Result::Err("--path requires a value")
            } else {
                base.set(value);
                index.set(index.get() + 1)
            }
        } else if util::starts_with(argument, "-") {
            return Result::Err("unknown option " + argument)
        } else {
            match name.get() {
                Option::Some(_) => return Result::Err(
                    "unexpected argument " + argument,
                ),
                Option::None => {
                    name.set(Option::Some(argument));
                    index.set(index.get() + 1)
                },
            }
        }
    };
    match name.get() {
        Option::Some(value) => new_project(value, base.get()),
        Option::None => Result::Err("project name is required"),
    }
}
