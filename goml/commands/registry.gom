package commands;

use gomlang::bootstrap_goml::manifest;
use gomlang::bootstrap_goml::registry;
use gomlang::bootstrap_goml::util;
use std::bytes;
use std::env;
use std::fs;
use std::io;
use std::path;
use std::process;

fn command_output(value: bytes::Bytes) -> string {
    match value.to_string() {
        Ok(value) => value,
        Err(_) => "<non-UTF-8 output>",
    }
}

fn run_git(arguments: Vec[string]) -> Result[unit, string] {
    let command = process::Command::new("git");
    for argument in arguments {
        let _ = command.arg(argument);
        ()
    };
    let output = match command.output() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    if process::ExitStatus::success(process::Output::status(output)) {
        Result::Ok(())
    } else {
        let message = util::trim(command_output(
            process::Output::stderr(output),
        ));
        if message == "" {
            Result::Err("git command failed")
        } else {
            Result::Err("git command failed: " + message)
        }
    }
}

fn config_path() -> Result[string, string] {
    match home_directory() {
        Ok(home) => Result::Ok(path::join(home, "config.toml")),
        Err(message) => Result::Err(message),
    }
}

fn config_registry_source() -> Result[string, string] {
    let config = match config_path() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    if !fs::is_file(config) {
        match ensure_home_layout() {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        };
        match fs::write_file(config, "[registry]\ndefault = \"\"\n") {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        }
    } else {
        ()
    };
    let source = match fs::read_file(config) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let section = Ref::new("");
    for original in util::split_lines(source) {
        let line = util::trim(original);
        if util::starts_with(line, "[")
            && util::ends_with(line, "]")
        {
            section.set(line.byte_slice(1, line.byte_len() - 1))
        } else if section.get() == "registry"
            && util::starts_with(line, "default")
        {
            let equals = Ref::new(-1);
            for index in range(0, line.byte_len()) {
                if equals.get() < 0 && line.byte_get(index) == 61 {
                    equals.set(index)
                } else {
                    ()
                }
            };
            if equals.get() >= 0 {
                let value = util::trim(line.byte_slice(
                    equals.get() + 1,
                    line.byte_len(),
                ));
                if value.byte_len() >= 2
                    && value.byte_get(0) == 34
                    && value.byte_get(value.byte_len() - 1) == 34
                {
                    let value = value.byte_slice(1, value.byte_len() - 1);
                    if value != "" {
                        return Result::Ok(value)
                    } else {
                        ()
                    }
                } else {
                    ()
                }
            } else {
                ()
            }
        } else {
            ()
        }
    };
    Result::Err(
        "registry.default is not configured in "
            + config
            + "; set it or use --local-registry",
    )
}

fn option_local_registry(
    args: Vec[string],
    index: Ref[int],
) -> Result[Option[string], string] {
    let argument = args[index.get()];
    if argument == "--local-registry" {
        if index.get() + 1 >= args.len() {
            Result::Err("--local-registry requires a value")
        } else {
            let value = args[index.get() + 1];
            index.set(index.get() + 2);
            Result::Ok(Option::Some(value))
        }
    } else if util::starts_with(argument, "--local-registry=") {
        let value = argument.byte_slice(17, argument.byte_len());
        if value == "" {
            Result::Err("--local-registry requires a value")
        } else {
            index.set(index.get() + 1);
            Result::Ok(Option::Some(value))
        }
    } else {
        Result::Ok(Option::None)
    }
}

fn registry_argument(args: Vec[string]) -> Result[Option[string], string] {
    let value: Ref[Option[string]] = Ref::new(Option::None);
    let index = Ref::new(2);
    while index.get() < args.len() {
        let parsed = match option_local_registry(args, index) {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        match parsed {
            Some(registry) => match value.get() {
                Some(_) => return Result::Err(
                    "--local-registry cannot be repeated",
                ),
                None => value.set(Option::Some(registry)),
            },
            None => return Result::Err(
                "unexpected argument " + args[index.get()],
            ),
        }
    };
    Result::Ok(value.get())
}

pub fn update_registry(args: Vec[string]) -> Result[unit, string] {
    let local = match registry_argument(args) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let source = match local {
        Some(value) => value,
        None => match config_registry_source() {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        },
    };
    match ensure_home_layout() {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    let cache = match registry::cached_root() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    if fs::exists(cache) {
        if !fs::is_dir(path::join(cache, ".git")) {
            return Result::Err(
                "cached registry path "
                    + cache
                    + " exists but is not a git repository",
            )
        } else {
            ()
        };
        match run_git(Vec::[
            "-C",
            cache,
            "remote",
            "set-url",
            "origin",
            source,
        ]) {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        };
        match run_git(Vec::["-C", cache, "pull", "--ff-only"]) {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        }
    } else {
        match run_git(Vec::["clone", source, cache]) {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        }
    };
    match registry::validate(cache) {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    io::println("updated registry cache at " + cache);
    Result::Ok(())
}

fn module_root() -> Result[string, string] {
    let current = match env::current_dir() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let directory = Ref::new(current);
    while true {
        let manifest_path = path::join(directory.get(), "goml.toml");
        if fs::is_file(manifest_path) {
            match manifest::load(manifest_path) {
                Ok(_) => return Result::Ok(directory.get()),
                Err(_) => (),
            }
        } else {
            ()
        };
        match path::parent(directory.get()) {
            Some(parent) => if parent == directory.get() {
                return Result::Err(
                    "no goml.toml with [module] section found in ancestors of "
                        + current,
                )
            } else {
                directory.set(parent)
            },
            None => return Result::Err(
                "no goml.toml with [module] section found in ancestors of "
                    + current,
            ),
        }
    };
    Result::Err("could not find module root")
}

fn dependency_line_name(line: string) -> Option[string] {
    let line = util::trim(line);
    if line.byte_len() < 3 || line.byte_get(0) != 34 {
        return Option::None
    } else {
        ()
    };
    for index in range(1, line.byte_len()) {
        if line.byte_get(index) == 34 {
            let rest = util::trim(line.byte_slice(
                index + 1,
                line.byte_len(),
            ));
            if util::starts_with(rest, "=") {
                return Option::Some(line.byte_slice(1, index))
            } else {
                return Option::None
            }
        } else {
            ()
        }
    };
    Option::None
}

fn section_name(line: string) -> Option[string] {
    let line = util::trim(line);
    if line.byte_len() >= 2
        && line.byte_get(0) == 91
        && line.byte_get(line.byte_len() - 1) == 93
    {
        Option::Some(util::trim(
            line.byte_slice(1, line.byte_len() - 1),
        ))
    } else {
        Option::None
    }
}

fn has_section(lines: Vec[string], expected: string) -> bool {
    for line in lines {
        match section_name(line) {
            Some(section) => if section == expected {
                return true
            } else {
                ()
            },
            None => (),
        }
    };
    false
}

fn upsert_dependency(
    manifest_path: string,
    name: string,
    version: string,
) -> Result[unit, string] {
    let source = match fs::read_file(manifest_path) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let result = Vec::new();
    let in_dependencies = Ref::new(false);
    let inserted = Ref::new(false);
    let entry = "\"" + name + "\" = \"" + version + "\"";
    let lines = util::split_lines(source);
    let dependency_section_exists = has_section(lines, "dependencies");
    for line in lines {
        match section_name(line) {
            Some(section) => {
                if in_dependencies.get() && !(inserted.get()) {
                    result.push(entry);
                    inserted.set(true)
                } else {
                    ()
                };
                in_dependencies.set(section == "dependencies");
                result.push(line)
            },
            None => {
                if in_dependencies.get()
                    && match dependency_line_name(line) {
                        Some(value) => value == name,
                        None => false,
                    }
                {
                    result.push(entry);
                    inserted.set(true)
                } else {
                    result.push(line)
                }
            },
        }
    };
    if !dependency_section_exists {
        if result.len() > 0 && result[result.len() - 1] != "" {
            result.push("")
        } else {
            ()
        };
        result.push("[dependencies]");
        result.push(entry)
    } else if !(inserted.get()) {
        result.push(entry)
    } else {
        ()
    };
    fs::write_file(manifest_path, util::join(result, "\n") + "\n")
}

fn remove_dependency_line(
    manifest_path: string,
    name: string,
) -> Result[unit, string] {
    let source = match fs::read_file(manifest_path) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let result = Vec::new();
    let buffer = Vec::new();
    let in_dependencies = Ref::new(false);
    let kept = Ref::new(0);
    let flush = |result: Vec[string],
                 buffer: Vec[string],
                 kept: Ref[int]| {
        if kept.get() > 0 {
            result.push("[dependencies]");
            for value in buffer {
                result.push(value)
            }
        } else {
            ()
        };
        while buffer.len() > 0 {
            let _ = buffer.remove(0);
            ()
        };
        kept.set(0)
    };
    for line in util::split_lines(source) {
        match section_name(line) {
            Some(section) => {
                if in_dependencies.get() {
                    flush(result, buffer, kept)
                } else {
                    ()
                };
                if section == "dependencies" {
                    in_dependencies.set(true)
                } else {
                    in_dependencies.set(false);
                    result.push(line)
                }
            },
            None => if in_dependencies.get() {
                match dependency_line_name(line) {
                    Some(value) => if value == name {
                        ()
                    } else {
                        kept.set(kept.get() + 1);
                        buffer.push(line)
                    },
                    None => buffer.push(line),
                }
            } else {
                result.push(line)
            },
        }
    };
    if in_dependencies.get() {
        flush(result, buffer, kept)
    } else {
        ()
    };
    while result.len() > 1
        && result[result.len() - 1] == ""
        && result[result.len() - 2] == ""
    {
        let _ = result.remove(result.len() - 1);
        ()
    };
    fs::write_file(manifest_path, util::join(result, "\n") + "\n")
}

fn command_registry_root(local: Option[string]) -> Result[string, string] {
    let root = match local {
        Some(value) => value,
        None => match registry::cached_root() {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        },
    };
    if !fs::is_dir(root) {
        return Result::Err(
            "registry cache not found at "
                + root
                + "; run `goml update` or use --local-registry",
        )
    } else {
        ()
    };
    match registry::validate(root) {
        Ok(()) => Result::Ok(root),
        Err(message) => Result::Err(message),
    }
}

fn dependency_command_args(
    args: Vec[string],
) -> Result[(string, Option[string]), string] {
    let dependency: Ref[Option[string]] = Ref::new(Option::None);
    let local: Ref[Option[string]] = Ref::new(Option::None);
    let index = Ref::new(2);
    while index.get() < args.len() {
        let parsed = match option_local_registry(args, index) {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        match parsed {
            Some(value) => match local.get() {
                Some(_) => return Result::Err(
                    "--local-registry cannot be repeated",
                ),
                None => local.set(Option::Some(value)),
            },
            None => {
                let argument = args[index.get()];
                if util::starts_with(argument, "-") {
                    return Result::Err("unknown option " + argument)
                } else {
                    match dependency.get() {
                        Some(_) => return Result::Err(
                            "unexpected argument " + argument,
                        ),
                        None => {
                            dependency.set(Option::Some(argument));
                            index.set(index.get() + 1)
                        },
                    }
                }
            },
        }
    };
    match dependency.get() {
        Some(value) => Result::Ok((value, local.get())),
        None => Result::Err("dependency is required"),
    }
}

pub fn add_dependency(args: Vec[string]) -> Result[unit, string] {
    let parsed = match dependency_command_args(args) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let spec = parsed.0;
    let local = parsed.1;
    let parts = util::split(spec, "@");
    if parts.len() > 2 {
        return Result::Err("invalid dependency " + spec)
    } else {
        ()
    };
    let name = parts[0];
    match registry::validate_coordinate(name) {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    let root = match command_registry_root(local) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let version = if parts.len() == 2 {
        match registry::select_version(root, name, parts[1]) {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        }
    } else {
        match registry::latest_version(root, name) {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        }
    };
    let module = match module_root() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    match upsert_dependency(
        path::join(module, "goml.toml"),
        name,
        version,
    ) {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    io::println("added " + name + " = " + version);
    Result::Ok(())
}

pub fn remove_dependency(args: Vec[string]) -> Result[unit, string] {
    let parsed = match dependency_command_args(args) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let name = util::trim(parsed.0);
    match registry::validate_coordinate(name) {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    let module = match module_root() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    match remove_dependency_line(
        path::join(module, "goml.toml"),
        name,
    ) {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    io::println("removed " + name);
    Result::Ok(())
}
