package commands;

use gomlang::bootstrap_goml::manifest;
use gomlang::bootstrap_goml::project;
use gomlang::bootstrap_goml::util;
use std::env;
use std::fs;
use std::path;
use std::process;

fn canonical(value: string) -> Result[string, string] {
    match fs::canonicalize(value) {
        Ok(value) => Result::Ok(value),
        Err(message) => Result::Err("failed to resolve " + value + ": " + message),
    }
}

fn resolve_program(value: string) -> Result[string, string] {
    if fs::is_file(value) {
        canonical(value)
    } else {
        match process::look_path(value) {
            Ok(value) => canonical(value),
            Err(message) => Result::Err("failed to find gomlfmt: " + message),
        }
    }
}

fn default_formatter_candidate() -> string {
    match env::current_exe() {
        Ok(value) => match path::parent(value) {
            Some(parent) => {
                let sibling = path::join(parent, "gomlfmt");
                if fs::is_file(sibling) {
                    return sibling
                } else {
                    ()
                }
            },
            None => (),
        },
        Err(_) => (),
    };
    match home_directory() {
        Ok(home) => {
            let installed = path::join(path::join(home, "bin"), "gomlfmt");
            if fs::is_file(installed) {
                installed
            } else {
                "gomlfmt"
            }
        },
        Err(_) => "gomlfmt",
    }
}

fn formatter_candidate(explicit: Option[string]) -> string {
    match explicit {
        Some(value) => value,
        None => match env::var("GOMLFMT") {
            Some(value) => if value != "" {
                value
            } else {
                default_formatter_candidate()
            },
            None => default_formatter_candidate(),
        },
    }
}

fn directory_ignored(name: string, value: string, artifact_root: string) -> bool {
    value == artifact_root || name == "_artifact" || name == "_bootstrap"
        || util::starts_with(name, ".")
}

fn collect_format_files(
    module_root: string,
    directory: string,
    artifact_root: string,
    result: Vec[string],
) -> Result[unit, string] {
    if directory != module_root && fs::is_file(path::join(directory, "goml.toml")) {
        return Result::Ok(())
    } else {
        ()
    };
    let names = match fs::read_dir(directory) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    for name in names {
        let value = path::join(directory, name);
        if fs::is_file(value)
            && match path::extension(value) {
                Some(extension) => extension == "gom",
                None => false,
            } {
            result.push(value)
        } else if fs::is_dir(value) && !directory_ignored(name, value, artifact_root) {
            match collect_format_files(module_root, value, artifact_root, result) {
                Ok(()) => (),
                Err(message) => return Result::Err(message),
            }
        } else {
            ()
        }
    };
    Result::Ok(())
}

fn module_format_files(module_root: string) -> Result[Vec[string], string] {
    let module_manifest = match manifest::load(path::join(module_root, "goml.toml")) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let artifact_root = path::clean(path::join(module_root, module_manifest.target_dir));
    let files = Vec::new();
    match collect_format_files(module_root, module_root, artifact_root, files) {
        Ok(()) => Result::Ok(util::sorted_unique(files)),
        Err(message) => Result::Err(message),
    }
}

fn relative_path(root: string, value: string) -> string {
    if value == root {
        "."
    } else {
        value.byte_slice(root.byte_len() + 1, value.byte_len())
    }
}

pub fn format_module(check: bool, formatter_override: Option[string]) -> Result[int, string] {
    let current = match env::current_dir() {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let module_root = match project::find_module_root(current) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let files = match module_format_files(module_root) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    if files.len() == 0 {
        return Result::Ok(0)
    } else {
        ()
    };
    let formatter = match resolve_program(formatter_candidate(formatter_override)) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let command = process::Command::new(formatter).arg(
        if check {
            "--check"
        } else {
            "-w"
        },
    ).current_dir(module_root);
    for file in files {
        let _ = command.arg(relative_path(module_root, file));
    };
    match command.status() {
        Ok(status) => match process::ExitStatus::code(status) {
            Some(code) => Result::Ok(code),
            None => Result::Err("gomlfmt terminated by signal"),
        },
        Err(message) => Result::Err(message),
    }
}
