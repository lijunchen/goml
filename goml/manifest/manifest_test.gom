package manifest;

use module::test_support;
use std::testing;

fn manifest_error(source: string) -> string {
    let root = test_support::workspace("manifest_reserved_toolchain_path");
    let path = root + "/goml.toml";
    test_support::write_file(path, source);
    match load(path) {
        Ok(_) => {
            testing::fail("expected manifest error");
            ""
        },
        Err(error) => error,
    }
}

#[test]
fn rejects_toolchain_module_paths_and_dependencies() -> () {
    testing::assert_eq(
        manifest_error("[module]\npath = \"builtin::fake\"\n"),
        "module path builtin::fake is reserved for the toolchain",
    );
    testing::assert_eq(
        manifest_error("[module]\npath = \"demo\"\n\n[dependencies]\n\"prelude\" = \"0.1.0\"\n"),
        "module path prelude is reserved for the toolchain",
    )
}

#[test]
fn internal_loader_accepts_toolchain_module_paths() -> () {
    let root = test_support::workspace("manifest_toolchain_path");
    let path = root + "/goml.toml";
    test_support::write_file(path, "[module]\npath = \"builtin\"\n");
    match load_toolchain(path) {
        Ok(value) => testing::assert_eq(value.module_path, "builtin"),
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn parses_escaped_unicode_manifest_strings() -> () {
    match parse_string("\"工具\\\\\\\"路径\"") {
        Ok(value) => testing::assert_eq(value, "工具\\\"路径"),
        Err(error) => testing::fail(error.to_string()),
    }
}
