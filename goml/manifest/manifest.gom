package manifest;

use gomlang::bootstrap_goml::util;
use std::fs;
use std::path;
use std::text;

pub struct Dependency {
    pub name: string,
    pub version: string,
}

pub struct Manifest {
    pub module_path: string,
    pub target_dir: string,
    pub dependencies: Vec[Dependency],
}

fn strip_comment(value: string) -> string {
    let quoted = Ref::new(false);
    let escaped = Ref::new(false);
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if escaped.get() {
            escaped.set(false)
        } else if quoted.get() && byte == b'\\' {
            escaped.set(true)
        } else if byte == b'"' {
            quoted.set(!(quoted.get()))
        } else if !(quoted.get()) && byte == b'#' {
            return value.byte_slice(0, index)
        } else {
            ()
        }
    };
    value
}

fn parse_string(value: string) -> Result[string, string] {
    let value = util::trim(value);
    if value.byte_len() < 2 || value.byte_get(0) != b'"'
        || value.byte_get(value.byte_len() - 1) != b'"' {
        return Result::Err("manifest values must be quoted strings")
    } else {
        ()
    };
    let content = value.byte_slice(1, value.byte_len() - 1);
    let builder = text::StringBuilder::with_capacity(content.byte_len());
    let escaped = Ref::new(false);
    for character in content.chars() {
        if escaped.get() {
            if character == '"' || character == '\\' {
                builder.write_char(character);
                escaped.set(false)
            } else {
                return Result::Err("unsupported manifest string escape")
            }
        } else if character == '\\' {
            escaped.set(true)
        } else {
            builder.write_char(character)
        }
    };
    if escaped.get() {
        Result::Err("invalid manifest string escape")
    } else {
        Result::Ok(builder.finish())
    }
}

fn valid_segment(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    } else {
        ()
    };
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'a' && byte <= b'z')
            || byte == b'_'
            || byte == b'-' {
            ()
        } else {
            return false
        }
    };
    true
}

fn validate_module_path(value: string) -> Result[unit, string] {
    let segments = util::split(value, "::");
    if segments.len() == 0 {
        return Result::Err("module.path is empty")
    } else {
        ()
    };
    for segment in segments {
        if !valid_segment(segment) {
            return Result::Err("invalid module.path " + value)
        } else {
            ()
        }
    };
    Result::Ok(())
}

fn validate_target_dir(value: string) -> Result[unit, string] {
    if value == "" || path::is_absolute(value) {
        Result::Err("build.target-dir must be a non-empty relative path")
    } else {
        for segment in util::split(value, "/") {
            if segment == ".." {
                return Result::Err("build.target-dir must stay inside the module")
            } else {
                ()
            }
        };
        for segment in util::split(value, "\\") {
            if segment == ".." {
                return Result::Err("build.target-dir must stay inside the module")
            } else {
                ()
            }
        };
        Result::Ok(())
    }
}

pub fn load(path: string) -> Result[Manifest, string] {
    let source = fs::read_file(path)?;
    let section = Ref::new("");
    let module_path: Ref[Option[string]] = Ref::new(Option::None);
    let target_dir = Ref::new("_artifact");
    let dependencies = Vec::new();
    for original in util::split_lines(source) {
        let line = util::trim(strip_comment(original));
        if line == "" {
            ()
        } else if line.byte_len() >= 2 && line.byte_get(0) == b'['
            && line.byte_get(line.byte_len() - 1) == b']' {
            section.set(util::trim(line.byte_slice(1, line.byte_len() - 1)))
        } else {
            let equals = Ref::new(-1);
            for index in 0..line.byte_len() {
                if equals.get() < 0 && line.byte_get(index) == b'=' {
                    equals.set(index)
                } else {
                    ()
                }
            };
            if equals.get() < 0 {
                return Result::Err("invalid manifest line: " + original)
            } else {
                ()
            };
            let key = util::trim(line.byte_slice(0, equals.get()));
            let value = parse_string(line.byte_slice(equals.get() + 1, line.byte_len()))?;
            if section.get() == "module" && key == "path" {
                module_path.set(Option::Some(value))
            } else if section.get() == "build" && key == "target-dir" {
                target_dir.set(value)
            } else if section.get() == "dependencies" {
                let name = parse_string(key)?;
                dependencies.push(Dependency { name, version: value })
            } else {
                ()
            }
        }
    };
    let Some(module_path) = module_path.get() else {
        return Result::Err("goml.toml is missing [module].path")
    };
    validate_module_path(module_path)?;
    match validate_target_dir(target_dir.get()) {
        Ok(()) => Result::Ok(Manifest { module_path, target_dir: target_dir.get(), dependencies }),
        Err(message) => Result::Err(message),
    }
}
