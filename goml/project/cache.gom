package project;

use std::fs;
use std::path;
use std::text;

struct CacheSpec {
    kind: string,
    args: Vec[string],
    inputs: Vec[string],
    outputs: Vec[string],
    anchor: string,
}

struct DigestCache {
    values: HashMap[string, string],
}

fn digest_cache() -> DigestCache {
    DigestCache { values: HashMap::from_array([]) }
}

fn sha256_constants() -> Vec[u32] {
    Vec::from_array(
        [
            1116352408,
            1899447441,
            3049323471,
            3921009573,
            961987163,
            1508970993,
            2453635748,
            2870763221,
