fn sha256_rotate_right(value: uint32, count: uint32) -> uint32 {
    (value >> count) | (value << (32 - count))
}

fn sha256_padded_byte(value: Vec[byte], index: int, padded_len: int, bit_len: uint64) -> byte {
    if index < value.len() {
        value[index]
    } else if index == value.len() {
        128
    } else if index >= padded_len - 8 {
        let shift = ((padded_len - 1 - index) * 8) as uint64;
        ((bit_len >> shift) & 255) as byte
    } else {
        0
    }
}

fn sha256_message_word(value: Vec[byte], offset: int, padded_len: int, bit_len: uint64) -> uint32 {
    ((sha256_padded_byte(value, offset, padded_len, bit_len) as uint32) << 24)
        | ((sha256_padded_byte(value, offset + 1, padded_len, bit_len) as uint32) << 16)
        | ((sha256_padded_byte(value, offset + 2, padded_len, bit_len) as uint32) << 8)
        | (sha256_padded_byte(value, offset + 3, padded_len, bit_len) as uint32)
}

fn sha256_write_hex(builder: text::StringBuilder, value: uint32) -> unit {
    let digits = "0123456789abcdef";
    for index in range(0, 8) {
        let shift = ((7 - index) * 4) as uint32;
        builder.write_char(digits.get(((value >> shift) & 15) as int))
    }
}

fn sha256_bytes(value: Vec[byte]) -> string {
    let constants = sha256_constants();
    let mut padded_len = value.len() + 9;
    while padded_len % 64 != 0 {
        padded_len += 1;
    };
    let bit_len = (value.len() as uint64) * 8;
    let mut h0 = 1779033703;
    let mut h1 = 3144134277;
    let mut h2 = 1013904242;
    let mut h3 = 2773480762;
    let mut h4 = 1359893119;
    let mut h5 = 2600822924;
    let mut h6 = 528734635;
    let mut h7 = 1541459225;
    let words: Vec[uint32] = Vec::with_capacity(64);
    for _ in range(0, 64) {
        words.push(0)
    };
    for chunk in range(0, padded_len / 64) {
        for index in range(0, 16) {
            words[index] = sha256_message_word(value, chunk * 64 + index * 4, padded_len, bit_len);
        };
        for index in range(16, 64) {
            let first = words[index - 15];
            let second = words[index - 2];
            let sigma0 = sha256_rotate_right(first, 7) ^ sha256_rotate_right(first, 18)
                ^ (first >> 3);
            let sigma1 = sha256_rotate_right(second, 17) ^ sha256_rotate_right(second, 19)
                ^ (second >> 10);
            words[index] = words[index - 16] + sigma0 + words[index - 7] + sigma1;
        };
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        let mut f = h5;
        let mut g = h6;
        let mut h = h7;
        for index in range(0, 64) {
            let sigma1 = sha256_rotate_right(e, 6) ^ sha256_rotate_right(e, 11)
                ^ sha256_rotate_right(e, 25);
            let choice = (e & f) ^ (~e & g);
            let temp1 = h + sigma1 + choice + constants[index] + words[index];
            let sigma0 = sha256_rotate_right(a, 2) ^ sha256_rotate_right(a, 13)
                ^ sha256_rotate_right(a, 22);
            let majority = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = sigma0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 + temp2;
        };
        h0 += a;
        h1 += b;
        h2 += c;
        h3 += d;
        h4 += e;
        h5 += f;
        h6 += g;
        h7 += h;
    };
    let builder = text::StringBuilder::new();
    sha256_write_hex(builder, h0);
    sha256_write_hex(builder, h1);
    sha256_write_hex(builder, h2);
    sha256_write_hex(builder, h3);
    sha256_write_hex(builder, h4);
    sha256_write_hex(builder, h5);
    sha256_write_hex(builder, h6);
    sha256_write_hex(builder, h7);
    builder.finish()
}

fn sha256_text(value: string) -> string {
    sha256_bytes(value.to_bytes())
}

fn absolute_from_module(module_dir: string, value: string) -> string {
    if path::is_absolute(value) {
        value
    } else {
        path::join(module_dir, value)
    }
}

fn file_digest(module_dir: string, value: string) -> Result[string, string] {
    match fs::sha256_file(absolute_from_module(module_dir, value)) {
        Ok(value) => Result::Ok(value),
        Err(message) => Result::Err("failed to read cache input " + value + ": " + message),
    }
}

fn compiler_digest(context: Context) -> Result[string, string] {
    if fs::is_file(context.compiler) {
        file_digest(context.graph.module_dir, context.compiler)
    } else {
        Result::Ok(sha256_text(context.compiler))
    }
}

fn cache_spec(value: Command) -> Option[CacheSpec] {
    match value {
        PrepareWorld { output } => Option::Some(
            CacheSpec {
                kind: "prepare-world",
                args: command_args(value).1,
                inputs: Vec::new(),
                outputs: Vec::new().pushed(output),
                anchor: output,
            },
        ),
        Compile { subcommand, input_files, interface_files, output, world, .. } => {
            let inputs = Vec::new();
            for input in input_files {
                inputs.push(input)
            };
            for input in interface_files {
                inputs.push(input)
            };
            match world {
                Some(value) => inputs.push(value),
                None => (),
            };
            let outputs = Vec::new().pushed(path::with_extension(output, "interface"));
            if subcommand == "build" || subcommand == "test-build" {
                outputs.push(path::with_extension(output, "core"))
            } else {
                ()
            };
            Option::Some(
                CacheSpec {
                    kind: subcommand,
                    args: command_args(value).1,
                    inputs,
                    outputs,
                    anchor: output,
                },
            )
        },
        Link { input_cores, output, world, .. } => {
            let inputs = Vec::new();
            for input in input_cores {
                inputs.push(input)
            };
            match world {
                Some(value) => inputs.push(value),
                None => (),
            };
            Option::Some(
                CacheSpec {
                    kind: "link",
                    args: command_args(value).1,
                    inputs,
                    outputs: Vec::new().pushed(output),
                    anchor: output,
                },
            )
        },
        TestLink { input_cores, output, manifest, world, .. } => {
            let inputs = Vec::new();
            for input in input_cores {
                inputs.push(input)
            };
            match world {
                Some(value) => inputs.push(value),
                None => (),
            };
            Option::Some(
                CacheSpec {
                    kind: "test-link",
                    args: command_args(value).1,
                    inputs,
                    outputs: Vec::new().pushed(output).pushed(manifest),
                    anchor: output,
                },
            )
        },
        GoBuild { input, output } => Option::Some(
            CacheSpec {
                kind: "go-build",
                args: command_args(value).1,
                inputs: Vec::new().pushed(input),
                outputs: Vec::new().pushed(output),
                anchor: output,
            },
        ),
    }
}

fn cache_path(module_dir: string, spec: CacheSpec) -> string {
    absolute_from_module(module_dir, spec.anchor) + ".goml-" + spec.kind + "-fingerprint"
}

fn command_fingerprint(context: Context, compiler: string, spec: CacheSpec) -> Result[
    string,
    string,
] {
    let builder = text::StringBuilder::new();
    builder.write_string("goml-build-cache-v1\n");
    builder.write_string(compiler);
    builder.write_char('\n');
    builder.write_string(context.graph.module_dir);
    builder.write_char('\n');
    builder.write_string(spec.kind);
    builder.write_char('\n');
    for argument in spec.args {
        builder.write_string(argument.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(argument)
    };
    builder.write_char('\n');
    for input in spec.inputs {
        let digest = match file_digest(context.graph.module_dir, input) {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        builder.write_string(input.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(input);
        builder.write_string(digest)
    };
    Result::Ok(sha256_text(builder.finish()))
}

fn output_digests(module_dir: string, outputs: Vec[string]) -> Result[Option[Vec[string]], string] {
    let result = Vec::new();
    for output in outputs {
        if fs::is_file(absolute_from_module(module_dir, output)) {
            match file_digest(module_dir, output) {
                Ok(value) => result.push(value),
                Err(message) => return Result::Err(message),
            }
        } else {
            return Result::Ok(Option::None)
        }
    };
    Result::Ok(Option::Some(result))
}

fn cache_is_fresh(context: Context, spec: CacheSpec, fingerprint: string) -> Result[bool, string] {
    let record_path = cache_path(context.graph.module_dir, spec);
    if !fs::is_file(record_path) {
        return Result::Ok(false)
    } else {
        ()
    };
    let source = match fs::read_file(record_path) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let lines = util::split(source, "\n");
    if lines.len() != spec.outputs.len() + 1 || lines[0] != fingerprint {
        return Result::Ok(false)
    } else {
        ()
    };
    let actual = match output_digests(context.graph.module_dir, spec.outputs) {
        Ok(Some(value)) => value,
        Ok(None) => return Result::Ok(false),
        Err(message) => return Result::Err(message),
    };
    for index in range(0, actual.len()) {
        if lines[index + 1] != actual[index] {
            return Result::Ok(false)
        } else {
            ()
        }
    };
    Result::Ok(true)
}

fn remove_cache_file(value: string) -> Result[unit, string] {
    if fs::exists(value) {
        fs::remove_file(value)
    } else {
        Result::Ok(())
    }
}

fn prepare_cache_execution(context: Context, spec: CacheSpec) -> Result[unit, string] {
    match remove_cache_file(cache_path(context.graph.module_dir, spec)) {
        Ok(()) => (),
        Err(message) => return Result::Err(message),
    };
    for output in spec.outputs {
        match remove_cache_file(absolute_from_module(context.graph.module_dir, output)) {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        }
    };
    Result::Ok(())
}

fn store_cache(context: Context, spec: CacheSpec, compiler: string, before: string) -> Result[
    unit,
    string,
] {
    let after = match command_fingerprint(context, compiler, spec) {
        Ok(value) => value,
        Err(message) => {
            let _ = prepare_cache_execution(context, spec);
            return Result::Err(message)
        },
    };
    if after != before {
        let _ = prepare_cache_execution(context, spec);
        return Result::Err("cache input changed while executing subcommand")
    } else {
        ()
    };
    let digests = match output_digests(context.graph.module_dir, spec.outputs) {
        Ok(Some(value)) => value,
        Ok(None) => {
            let _ = prepare_cache_execution(context, spec);
            return Result::Err("subcommand succeeded without all expected outputs")
        },
        Err(message) => {
            let _ = prepare_cache_execution(context, spec);
            return Result::Err(message)
        },
    };
    let builder = text::StringBuilder::new();
    builder.write_string(after);
    for digest in digests {
        builder.write_char('\n');
        builder.write_string(digest)
    };
    let record_path = cache_path(context.graph.module_dir, spec);
    match path::parent(record_path) {
        Some(parent) => match fs::create_dir_all(parent) {
            Ok(()) => (),
            Err(message) => return Result::Err(message),
        },
        None => return Result::Err("fingerprint path has no parent directory"),
    };
    fs::write_file(record_path, builder.finish())
}
