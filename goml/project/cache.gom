package project;

use std::bytes;
use std::crypto::hash;
use std::fs;
use std::path;
use std::text;

struct CacheSpec {
    kind: string,
    args: Vec[string],
    inputs: Vec[string],
    outputs: Vec[string],
    anchor: string,
}

struct DigestCache {
    values: HashMap[string, string],
}

fn digest_cache() -> DigestCache {
    DigestCache { values: HashMap::from_array([]) }
}

fn sha256_text(value: string) -> string {
    hash::sha256(bytes::Bytes::from_string(value))
}

fn absolute_from_module(module_dir: string, value: string) -> string {
    if path::is_absolute(value) {
        value
    } else {
        path::join(module_dir, value)
    }
}

fn file_digest(module_dir: string, value: string) -> Result[string, string] {
    match fs::sha256_file(absolute_from_module(module_dir, value)) {
        Ok(value) => Result::Ok(value),
        Err(message) => Result::Err("failed to read cache input " + value + ": " + message),
    }
}

fn cached_file_digest(cache: DigestCache, module_dir: string, value: string) -> Result[
    string,
    string,
] {
    let absolute = absolute_from_module(module_dir, value);
    match cache.values[absolute] {
        Some(digest) => Result::Ok(digest),
        None => {
            let digest = file_digest(module_dir, value)?;
            cache.values[absolute] = digest;
            Result::Ok(digest)
        },
    }
}

fn invalidate_output_digests(cache: DigestCache, module_dir: string, outputs: Vec[string]) -> unit {
    for output in outputs {
        let _ = cache.values.remove(absolute_from_module(module_dir, output));
    }
}

fn compiler_digest(context: Context) -> Result[string, string] {
    if fs::is_file(context.compiler) {
        file_digest(context.graph.module_dir, context.compiler)
    } else {
        Result::Ok(sha256_text(context.compiler))
    }
}

fn cache_spec(value: Command) -> Option[CacheSpec] {
    match value {
        PrepareWorld { output } => Option::Some(
            CacheSpec {
                kind: "prepare-world",
                args: command_args(value).1,
                inputs: Vec::from_array([]),
                outputs: Vec::from_array([output]),
                anchor: output,
            },
        ),
        Compile { subcommand, input_files, interface_files, output, world, .. } => {
            let inputs: Vec[string] = Vec::from_array([]);
            for input in input_files {
                inputs.push(input)
            }
            for input in interface_files {
                inputs.push(input)
            }
            match world {
                Some(value) => inputs.push(value),
                None => (),
            };
            let outputs = Vec::from_array([path::with_extension(output, "interface")]);
            match subcommand {
                BUILD_SUBCOMMAND | TEST_BUILD_SUBCOMMAND => {
                    outputs.push(path::with_extension(output, "core"))
                },
                _ => (),
            };
            Option::Some(
                CacheSpec {
                    kind: subcommand,
                    args: command_args(value).1,
                    inputs,
                    outputs,
                    anchor: output,
                },
            )
        },
        ToolchainCompile { input_files, interface_files, output, counter_output, .. } => {
            let inputs: Vec[string] = Vec::from_array([]);
            for value in input_files {
                inputs.push(value)
            }
            for value in interface_files {
                inputs.push(value)
            }
            let outputs = Vec::from_array(
                [path::with_extension(output, "interface"), path::with_extension(output, "core")],
            );
            match counter_output {
                Some(value) => outputs.push(value),
                None => (),
            };
            Option::Some(
                CacheSpec {
                    kind: "toolchain-build",
                    args: command_args(value).1,
                    inputs,
                    outputs,
                    anchor: output,
                },
            )
        },
        PackToolchainWorld { input_packages, source_files, counter_file, output } => {
            let inputs = Vec::from_array([counter_file]);
            for value in input_packages {
                inputs.push(path::with_extension(value, "interface"));
                inputs.push(path::with_extension(value, "core"))
            }
            for value in source_files {
                inputs.push(value)
            }
            Option::Some(
                CacheSpec {
                    kind: "toolchain-pack",
                    args: command_args(value).1,
                    inputs,
                    outputs: Vec::from_array([output]),
                    anchor: output,
                },
            )
        },
        Link { input_cores, output, world, .. } => {
            let inputs: Vec[string] = Vec::from_array([]);
            for input in input_cores {
                inputs.push(input)
            }
            match world {
                Some(value) => inputs.push(value),
                None => (),
            };
            Option::Some(
                CacheSpec {
                    kind: "link",
                    args: command_args(value).1,
                    inputs,
                    outputs: Vec::from_array([output]),
                    anchor: output,
                },
            )
        },
        TestLink { input_cores, output, manifest, world, .. } => {
            let inputs: Vec[string] = Vec::from_array([]);
            for input in input_cores {
                inputs.push(input)
            }
            match world {
                Some(value) => inputs.push(value),
                None => (),
            };
            Option::Some(
                CacheSpec {
                    kind: "test-link",
                    args: command_args(value).1,
                    inputs,
                    outputs: Vec::from_array([output, manifest]),
                    anchor: output,
                },
            )
        },
        GoBuild { input, output } => Option::Some(
            CacheSpec {
                kind: "go-build",
                args: command_args(value).1,
                inputs: Vec::from_array([input]),
                outputs: Vec::from_array([output]),
                anchor: output,
            },
        ),
    }
}

fn cache_path(module_dir: string, spec: CacheSpec) -> string {
    absolute_from_module(module_dir, spec.anchor) + ".goml-" + spec.kind + "-fingerprint"
}

fn command_fingerprint(cache: DigestCache, context: Context, compiler: string, spec: CacheSpec) -> Result[
    string,
    string,
] {
    let builder = text::StringBuilder::new();
    builder.write_string("goml-build-cache-v1\n");
    builder.write_string(compiler);
    builder.write_char('\n');
    builder.write_string(context.graph.module_dir);
    builder.write_char('\n');
    builder.write_string(spec.kind);
    builder.write_char('\n');
    for argument in spec.args {
        builder.write_string(argument.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(argument)
    }
    builder.write_char('\n');
    for input in spec.inputs {
        let digest = cached_file_digest(cache, context.graph.module_dir, input)?;
        builder.write_string(input.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(input);
        builder.write_string(digest)
    }
    Result::Ok(sha256_text(builder.finish()))
}

fn output_digests(cache: DigestCache, module_dir: string, outputs: Vec[string]) -> Result[
    Option[Vec[string]],
    string,
] {
    let result: Vec[string] = Vec::from_array([]);
    for output in outputs {
        if fs::is_file(absolute_from_module(module_dir, output)) {
            match cached_file_digest(cache, module_dir, output) {
                Ok(value) => result.push(value),
                Err(message) => return Result::Err(message),
            }
        } else {
            return Result::Ok(Option::None)
        }
    }
    Result::Ok(Option::Some(result))
}

fn cache_is_fresh(cache: DigestCache, context: Context, spec: CacheSpec, fingerprint: string) -> Result[
    bool,
    string,
] {
    let record_path = cache_path(context.graph.module_dir, spec);
    if !fs::is_file(record_path) {
        return Result::Ok(false)
    } else {};
    let source = fs::read_file(record_path)?;
    let lines = text::split(source, "\n");
    if lines.len() != spec.outputs.len() + 1 || lines[0] != fingerprint {
        return Result::Ok(false)
    } else {};
    let actual = match output_digests(cache, context.graph.module_dir, spec.outputs) {
        Ok(Some(value)) => value,
        Ok(None) => return Result::Ok(false),
        Err(message) => return Result::Err(message),
    };
    for index in 0..actual.len() {
        if lines[index + 1] != actual[index] {
            return Result::Ok(false)
        } else {}
    }
    Result::Ok(true)
}

fn remove_cache_file(value: string) -> Result[unit, string] {
    if fs::exists(value) {
        fs::remove_file(value)
    } else {
        Result::Ok(())
    }
}

fn prepare_cache_execution(context: Context, spec: CacheSpec) -> Result[unit, string] {
    remove_cache_file(cache_path(context.graph.module_dir, spec))?;
    for output in spec.outputs {
        remove_cache_file(absolute_from_module(context.graph.module_dir, output))?
    }
    Result::Ok(())
}

fn store_cache(
    cache: DigestCache,
    context: Context,
    spec: CacheSpec,
    compiler: string,
    before: string,
) -> Result[unit, string] {
    let after = match command_fingerprint(digest_cache(), context, compiler, spec) {
        Ok(value) => value,
        Err(message) => {
            let _ = prepare_cache_execution(context, spec);
            return Result::Err(message)
        },
    };
    if after != before {
        let _ = prepare_cache_execution(context, spec);
        return Result::Err("cache input changed while executing subcommand")
    } else {};
    let digests = match output_digests(cache, context.graph.module_dir, spec.outputs) {
        Ok(Some(value)) => value,
        Ok(None) => {
            let _ = prepare_cache_execution(context, spec);
            return Result::Err("subcommand succeeded without all expected outputs")
        },
        Err(message) => {
            let _ = prepare_cache_execution(context, spec);
            return Result::Err(message)
        },
    };
    let builder = text::StringBuilder::new();
    builder.write_string(after);
    for digest in digests {
        builder.write_char('\n');
        builder.write_string(digest)
    }
    let record_path = cache_path(context.graph.module_dir, spec);
    match path::parent(record_path) {
        Some(parent) => fs::create_dir_all(parent)?,
        None => return Result::Err("fingerprint path has no parent directory"),
    };
    fs::write_file(record_path, builder.finish())
}
