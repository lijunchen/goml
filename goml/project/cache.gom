package project;

use gomlang::bootstrap_goml::util;
use std::fs;
use std::path;
use std::text;

struct CacheSpec {
    kind: string,
    args: Vec[string],
    inputs: Vec[string],
    outputs: Vec[string],
    anchor: string,
}

