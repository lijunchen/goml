package project;

use gomlang::bootstrap_goml::manifest;
use gomlang::bootstrap_goml::registry;
use gomlang::bootstrap_goml::util;
use std::bytes;
use std::env;
use std::fs;
use std::json;
use std::path;
use std::process;

fn result_string(value: Result[string, string], context: string) -> Result[string, string] {
    match value {
        Result::Ok(value) => Result::Ok(value),
        Result::Err(message) => Result::Err(context + ": " + message),
    }
}

fn canonical(value: string) -> Result[string, string] {
    result_string(fs::canonicalize(value), "failed to resolve " + value)
}

fn manifest_root(start: string) -> Result[string, string] {
    let current = Ref::new(start);
    while true {
        if fs::is_file(path::join(current.get(), "goml.toml")) {
            return Result::Ok(current.get())
        } else {
            match path::parent(current.get()) {
                Option::Some(parent) => if parent == current.get() {
                    return Result::Err("could not find goml.toml")
                } else {
                    current.set(parent)
                },
                Option::None => return Result::Err("could not find goml.toml"),
            }
        }
    };
    Result::Err("could not find goml.toml")
}

pub fn clean(target_dir_override: Option[string]) -> Result[unit, string] {
    let current = match env::current_dir() {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let module_dir = match manifest_root(current) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let module_manifest = match manifest::load(path::join(module_dir, "goml.toml")) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let artifact_root = match target_dir_override {
        Option::Some(value) => if path::is_absolute(value) {
            path::clean(value)
        } else {
            path::join(module_dir, value)
        },
        Option::None => path::join(module_dir, module_manifest.target_dir),
    };
    if artifact_root == module_dir || !path_inside(module_dir, artifact_root) {
        return Result::Err("clean target must stay inside the module")
    } else if fs::is_file(artifact_root) {
        return Result::Err("clean target is not a directory")
    } else if !fs::exists(artifact_root) {
        return Result::Ok(())
    } else {
        fs::remove_dir_all(artifact_root)
    }
}

fn target_directory(target: string) -> Result[string, string] {
    let resolved = match path::absolute(target) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let resolved = match canonical(resolved) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    if fs::is_file(resolved) {
        match path::parent(resolved) {
            Option::Some(value) => Result::Ok(value),
            Option::None => Result::Err("target file has no parent directory"),
        }
    } else if fs::is_dir(resolved) {
        Result::Ok(resolved)
    } else {
        Result::Err("target is not a file or directory")
    }
}

fn path_inside(root: string, value: string) -> bool {
    value == root
        || (util::starts_with(value, root)
            && value.byte_len() > root.byte_len()
            && (value.byte_get(root.byte_len()) == 47
                || value.byte_get(root.byte_len()) == 92))
}

fn relative_path(root: string, value: string) -> string {
    if value == root {
        "."
    } else if path_inside(root, value) {
        value.byte_slice(root.byte_len() + 1, value.byte_len())
    } else {
        value
    }
}

fn package_name_for_directory(
    module_dir: string,
    module_path: string,
    directory: string,
) -> Result[string, string] {
    if !path_inside(module_dir, directory) {
        return Result::Err("target is outside the module")
    } else if directory == module_dir {
        return Result::Ok(module_path)
    } else {
        ()
    };
    let relative = relative_path(module_dir, directory);
    let segments = Vec::new();
    let current = Ref::new("");
    for index in range(0, relative.byte_len()) {
        let byte = relative.byte_get(index);
        if byte == 47 || byte == 92 {
            if current.get() != "" {
                segments.push(current.get());
                current.set("")
            } else {
                ()
            }
        } else {
            current.set(current.get() + relative.byte_slice(index, index + 1))
        }
    };
    if current.get() != "" {
        segments.push(current.get())
    } else {
        ()
    };
    if segments.len() == 0 {
        Result::Ok(module_path)
    } else {
        Result::Ok(module_path + "::" + util::join(segments, "::"))
    }
}

fn directory_for_package(
    module_dir: string,
    module_path: string,
    package_name: string,
) -> Option[string] {
    if package_name == module_path {
        Option::Some(module_dir)
    } else {
        let prefix = module_path + "::";
        if !util::starts_with(package_name, prefix) {
            Option::None
        } else {
            let result = Ref::new(module_dir);
            let suffix = package_name.byte_slice(
                prefix.byte_len(),
                package_name.byte_len(),
            );
            for segment in util::split(suffix, "::") {
                result.set(path::join(result.get(), segment));
                if fs::is_file(path::join(result.get(), "goml.toml")) {
                    return Option::None
                } else {
                    ()
                }
            };
            Option::Some(result.get())
        }
    }
}

fn source_files(directory: string, include_tests: bool) -> Result[Vec[string], string] {
    let names = match fs::read_dir(directory) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let result = Vec::new();
    for name in names {
        let source_path = path::join(directory, name);
        if fs::is_file(source_path)
            && match path::extension(source_path) {
                Option::Some(value) => value == "gom",
                Option::None => false,
            }
            && (include_tests
                || match path::file_name(source_path) {
                    Option::Some(value) => !util::ends_with(value, "_test.gom"),
                    Option::None => false,
                })
        {
            result.push(source_path)
        } else {
            ()
        }
    };
    Result::Ok(util::sorted_unique(result))
}

fn directory_contains_gom(directory: string) -> Result[bool, string] {
    let names = match fs::read_dir(directory) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    for name in names {
        let value = path::join(directory, name);
        if fs::is_file(value)
            && match path::extension(value) {
                Option::Some(extension) => extension == "gom",
                Option::None => false,
            }
        {
            return Result::Ok(true)
        } else if fs::is_dir(value) {
            match directory_contains_gom(value) {
                Result::Ok(true) => return Result::Ok(true),
                Result::Ok(false) => (),
                Result::Err(message) => return Result::Err(message),
            }
        } else {
            ()
        }
    };
    Result::Ok(false)
}

fn black_box_test_files(tests_dir: string) -> Result[Vec[string], string] {
    let files = match source_files(tests_dir, true) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let names = match fs::read_dir(tests_dir) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    for name in names {
        let child = path::join(tests_dir, name);
        if fs::is_dir(child) {
            match directory_contains_gom(child) {
                Result::Ok(true) => return Result::Err(
                    "black-box test sources must be placed directly in "
                        + tests_dir,
                ),
                Result::Ok(false) => (),
                Result::Err(message) => return Result::Err(message),
            }
        } else {
            ()
        }
    };
    Result::Ok(files)
}

fn output_text(value: bytes::Bytes) -> string {
    match value.to_string() {
        Result::Ok(value) => value,
        Result::Err(_) => "<non-UTF-8 output>",
    }
}

fn compiler_package_info(
    compiler: string,
    module_dir: string,
    files: Vec[string],
) -> Result[Vec[PackageInfoFile], string] {
    let command = process::Command::new(compiler)
        .arg("package-info")
        .arg("--format")
        .arg("json")
        .arg("--input");
    for file in files {
        let _ = command.arg(relative_path(module_dir, file));
    };
    let output = match command.current_dir(module_dir).output() {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    if !(process::ExitStatus::success(process::Output::status(output))) {
        return Result::Err(output_text(process::Output::stderr(output)))
    } else {
        ()
    };
    let root = match json::parse(output_text(process::Output::stdout(output))) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    match json::field(root, "protocol_version") {
        Option::Some(json::Value::Number(value)) => if value != "1" {
            return Result::Err("unsupported package-info protocol " + value)
        } else {
            ()
        },
        _ => return Result::Err("package-info omitted protocol_version"),
    };
    let values = match json::field(root, "files") {
        Option::Some(value) => match json::as_array(value) {
            Option::Some(values) => values,
            Option::None => return Result::Err("package-info files must be an array"),
        },
        Option::None => return Result::Err("package-info omitted files"),
    };
    let result = Vec::new();
    for value in values {
        let source_path = match json::field(value, "path") {
            Option::Some(value) => match json::as_string(value) {
                Option::Some(value) => value,
                Option::None => return Result::Err("package-info path must be a string"),
            },
            Option::None => return Result::Err("package-info file omitted path"),
        };
        let package_name = match json::field(value, "package") {
            Option::Some(value) => match json::as_string(value) {
                Option::Some(value) => value,
                Option::None => return Result::Err("package-info package must be a string"),
            },
            Option::None => return Result::Err("package-info file omitted package"),
        };
        let package_explicit = match json::field(value, "package_explicit") {
            Option::Some(value) => match json::as_bool(value) {
                Option::Some(value) => value,
                Option::None => return Result::Err("package_explicit must be boolean"),
            },
            Option::None => return Result::Err("package-info omitted package_explicit"),
        };
        let uses = match json::field(value, "uses") {
            Option::Some(value) => match json::as_array(value) {
                Option::Some(value) => value,
                Option::None => return Result::Err("package-info uses must be an array"),
            },
            Option::None => return Result::Err("package-info omitted uses"),
        };
        let parsed_uses = Vec::new();
        for use_value in uses {
            let use_path = match json::field(use_value, "path") {
                Option::Some(value) => match json::as_string(value) {
                    Option::Some(value) => value,
                    Option::None => return Result::Err("use path must be a string"),
                },
                Option::None => return Result::Err("use omitted path"),
            };
            let alias = match json::field(use_value, "alias") {
                Option::Some(value) => json::as_string(value),
                Option::None => Option::None,
            };
            parsed_uses.push(PackageInfoUse {
                path: use_path,
                alias,
            })
        };
        result.push(PackageInfoFile {
            path: source_path,
            package_name,
            package_explicit,
            uses: parsed_uses,
        })
    };
    Result::Ok(result)
}

fn select_package_info(
    module_dir: string,
    all_info: Vec[PackageInfoFile],
    files: Vec[string],
) -> Result[Vec[PackageInfoFile], string] {
    let result = Vec::new();
    for file in files {
        let relative = relative_path(module_dir, file);
        let before = result.len();
        for value in all_info {
            if value.path == relative {
                result.push(value)
            } else {
                ()
            }
        };
        if result.len() == before {
            return Result::Err("package-info omitted " + relative)
        } else {
            ()
        }
    };
    Result::Ok(result)
}

fn source_by_name(
    sources: Vec[ModuleSource],
    name: string,
) -> Option[ModuleSource] {
    for source in sources {
        if source.name == name {
            return Option::Some(source)
        } else {
            ()
        }
    };
    Option::None
}

fn source_for_package(
    sources: Vec[ModuleSource],
    package_name: string,
) -> Option[ModuleSource] {
    let selected: Ref[Option[ModuleSource]] = Ref::new(Option::None);
    for source in sources {
        if package_name == source.name
            || util::starts_with(package_name, source.name + "::")
        {
            match selected.get() {
                Option::Some(current) => if source.name.byte_len()
                    > current.name.byte_len()
                {
                    selected.set(Option::Some(source))
                } else {
                    ()
                },
                Option::None => selected.set(Option::Some(source)),
            }
        } else {
            ()
        }
    };
    selected.get()
}

fn source_for_package_directory(
    sources: Vec[ModuleSource],
    directory: string,
) -> Option[ModuleSource] {
    let selected: Ref[Option[ModuleSource]] = Ref::new(Option::None);
    for source in sources {
        if path_inside(source.directory, directory) {
            match selected.get() {
                Option::Some(current) => if source.directory.byte_len()
                    > current.directory.byte_len()
                {
                    selected.set(Option::Some(source))
                } else {
                    ()
                },
                Option::None => selected.set(Option::Some(source)),
            }
        } else {
            ()
        }
    };
    selected.get()
}

fn dependency_names(
    dependencies: Vec[manifest::Dependency],
) -> Vec[string] {
    let result = Vec::new();
    for dependency in dependencies {
        result.push(dependency.name)
    };
    util::sorted_unique(result)
}

fn module_sources(
    module_dir: string,
    module_manifest: manifest::Manifest,
) -> Result[Vec[ModuleSource], string] {
    let result = Vec::new();
    result.push(ModuleSource {
        name: module_manifest.module_path,
        directory: module_dir,
        artifact_prefix: "pkg",
        dependencies: dependency_names(module_manifest.dependencies),
    });
    if module_manifest.dependencies.len() == 0 {
        return Result::Ok(result)
    } else {
        ()
    };
    let resolved = match registry::resolve(module_dir) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    for module in resolved {
        match source_by_name(result, module.name) {
            Option::Some(_) => return Result::Err(
                "external module conflicts with module " + module.name,
            ),
            Option::None => result.push(ModuleSource {
                name: module.name,
                directory: module.root,
                artifact_prefix: registry::artifact_prefix(module),
                dependencies: dependency_names(module.dependencies),
            }),
        }
    };
    Result::Ok(result)
}

fn package_directory_in_source(
    source: ModuleSource,
    package_name: string,
) -> Option[string] {
    directory_for_package(
        source.directory,
        source.name,
        package_name,
    )
}

fn local_import(
    sources: Vec[ModuleSource],
    current_module: string,
    import_path: string,
) -> Result[Option[string], string] {
    if import_path == "std" || util::starts_with(import_path, "std::") {
        Result::Ok(Option::None)
    } else {
        let current = match source_by_name(sources, current_module) {
            Option::Some(value) => value,
            Option::None => return Result::Err(
                "missing module source " + current_module,
            ),
        };
        let prefix = current_module + "::";
        if util::starts_with(import_path, prefix) {
            let suffix = import_path.byte_slice(
                prefix.byte_len(),
                import_path.byte_len(),
            );
            for segment in util::split(suffix, "::") {
                if segment == "tests" {
                    return Result::Err(
                        "test-only package "
                            + import_path
                            + " cannot be imported",
                    )
                } else {
                    ()
                }
            }
        } else {
            ()
        };
        match package_directory_in_source(current, import_path) {
            Option::Some(directory) => if fs::is_dir(directory) {
                return Result::Ok(Option::Some(import_path))
            } else {
                return Result::Err(
                    "local package does not exist: " + import_path,
                )
            },
            Option::None => (),
        };
        for source in sources {
            if source.name == current_module {
                ()
            } else {
                match package_directory_in_source(source, import_path) {
                    Option::Some(directory) => if fs::is_dir(directory) {
                        return Result::Ok(Option::Some(import_path))
                    } else {
                        return Result::Err(
                            "external package does not exist: " + import_path,
                        )
                    },
                    Option::None => (),
                }
            }
        }
        Result::Ok(Option::None)
    }
}

fn package_from_info(
    sources: Vec[ModuleSource],
    source: ModuleSource,
    package_name: string,
    directory: string,
    files: Vec[string],
    info: Vec[PackageInfoFile],
) -> Result[Package, string] {
    let declared_name = Ref::new("");
    let imports = Vec::new();
    for file in info {
        if !file.package_explicit {
            return Result::Err(file.path + " must declare package <name>;")
        } else if declared_name.get() == "" {
            declared_name.set(file.package_name)
        } else if declared_name.get() != file.package_name {
            return Result::Err(
                "package declaration mismatch in " + file.path,
            )
        } else {
            ()
        };
        for use_decl in file.uses {
            match local_import(sources, source.name, use_decl.path) {
                Result::Ok(Option::Some(value)) => imports.push(value),
                Result::Ok(Option::None) => (),
                Result::Err(message) => return Result::Err(message),
            }
        }
    };
    Result::Ok(Package {
        name: package_name,
        declared_name: declared_name.get(),
        module_name: source.name,
        directory,
        artifact_prefix: source.artifact_prefix,
        files,
        imports: util::sorted_unique(imports),
    })
}

fn contains_file(files: Vec[string], target: string) -> bool {
    for file in files {
        if file == target {
            return true
        } else {
            ()
        }
    };
    false
}

fn extend_package_with_info(
    sources: Vec[ModuleSource],
    package_value: Package,
    files: Vec[string],
    test_files: Vec[string],
    info: Vec[PackageInfoFile],
) -> Result[Package, string] {
    let source = match source_for_package(sources, package_value.name) {
        Option::Some(value) => value,
        Option::None => return Result::Err(
            "invalid package " + package_value.name,
        ),
    };
    let test_package = match package_from_info(
        sources,
        source,
        package_value.name,
        package_value.directory,
        test_files,
        info,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    if test_package.declared_name != package_value.declared_name {
        return Result::Err(
            "package declaration mismatch in " + package_value.directory,
        )
    } else {
        ()
    };
    let imports = Vec::new();
    for value in package_value.imports {
        imports.push(value)
    };
    for value in test_package.imports {
        imports.push(value)
    };
    Result::Ok(Package {
        name: package_value.name,
        declared_name: package_value.declared_name,
        module_name: package_value.module_name,
        directory: package_value.directory,
        artifact_prefix: package_value.artifact_prefix,
        files,
        imports: util::sorted_unique(imports),
    })
}

fn load_package(
    compiler: string,
    module_dir: string,
    sources: Vec[ModuleSource],
    package_name: string,
    include_entry_tests: bool,
    entry_package: string,
) -> Result[Package, string] {
    let source = match source_for_package(sources, package_name) {
        Option::Some(value) => value,
        Option::None => return Result::Err("invalid package " + package_name),
    };
    let directory = match package_directory_in_source(source, package_name) {
        Option::Some(value) => value,
        Option::None => return Result::Err("invalid package " + package_name),
    };
    let files = match source_files(
        directory,
        include_entry_tests && package_name == entry_package,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    if files.len() == 0 {
        return Result::Err("package has no .gom files: " + package_name)
    } else {
        ()
    };
    let info = match compiler_package_info(compiler, module_dir, files) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    package_from_info(
        sources,
        source,
        package_name,
        directory,
        files,
        info,
    )
}

fn find_package(packages: Vec[Package], name: string) -> Option[Package] {
    for package_value in packages {
        if package_value.name == name {
            return Option::Some(package_value)
        } else {
            ()
        }
    };
    Option::None
}

fn visit_package(
    packages: Vec[Package],
    states: HashMap[string, int],
    output: Vec[string],
    name: string,
) -> Result[unit, string] {
    match states.get(name) {
        Option::Some(1) => return Result::Err("package dependency cycle at " + name),
        Option::Some(2) => return Result::Ok(()),
        _ => (),
    };
    states.set(name, 1);
    let package_value = match find_package(packages, name) {
        Option::Some(value) => value,
        Option::None => return Result::Err("missing package " + name),
    };
    for dependency in package_value.imports {
        match visit_package(packages, states, output, dependency) {
            Result::Ok(()) => (),
            Result::Err(message) => return Result::Err(message),
        }
    };
    states.set(name, 2);
    output.push(name);
    Result::Ok(())
}

fn topological_order(packages: Vec[Package], entry: string) -> Result[Vec[string], string] {
    let output = Vec::new();
    match visit_package(packages, HashMap::new(), output, entry) {
        Result::Ok(()) => Result::Ok(output),
        Result::Err(message) => Result::Err(message),
    }
}

fn topological_order_all(packages: Vec[Package]) -> Result[Vec[string], string] {
    let output = Vec::new();
    let states: HashMap[string, int] = HashMap::new();
    let names = Vec::new();
    for package_value in packages {
        names.push(package_value.name)
    };
    for name in util::sorted_unique(names) {
        match visit_package(packages, states, output, name) {
            Result::Ok(()) => (),
            Result::Err(message) => return Result::Err(message),
        }
    };
    Result::Ok(output)
}

fn collect_package_directories(
    module_dir: string,
    directory: string,
    artifact_root: string,
    result: Vec[string],
) -> Result[unit, string] {
    if directory != module_dir
        && fs::is_file(path::join(directory, "goml.toml"))
    {
        return Result::Ok(())
    } else {
        ()
    };
    let names = match fs::read_dir(directory) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let has_source = Ref::new(false);
    let tests_dir: Ref[Option[string]] = Ref::new(Option::None);
    let children = Vec::new();
    for name in names {
        let value = path::join(directory, name);
        if fs::is_file(value)
            && match path::extension(value) {
                Option::Some(extension) => extension == "gom",
                Option::None => false,
            }
            && match path::file_name(value) {
                Option::Some(file_name) => !util::ends_with(
                    file_name,
                    "_test.gom",
                ),
                Option::None => false,
            }
        {
            has_source.set(true)
        } else if fs::is_dir(value) && value != artifact_root {
            if name == "tests" {
                tests_dir.set(Option::Some(value))
            } else if name != "testdata" && !util::starts_with(name, ".") {
                children.push(value)
            } else {
                ()
            }
        } else {
            ()
        }
    };
    match tests_dir.get() {
        Option::Some(value) => {
            let files = match black_box_test_files(value) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            if files.len() > 0 && !(has_source.get()) {
                return Result::Err(
                    "black-box test package "
                        + value
                        + " has no parent production package",
                )
            } else {
                ()
            }
        },
        Option::None => (),
    };
    if has_source.get() {
        result.push(directory)
    } else {
        ()
    };
    for child in util::sorted(children) {
        match collect_package_directories(
            module_dir,
            child,
            artifact_root,
            result,
        ) {
            Result::Ok(()) => (),
            Result::Err(message) => return Result::Err(message),
        }
    };
    Result::Ok(())
}

fn discover_module_graph(
    compiler: string,
    module_dir: string,
    module_path: string,
    artifact_root: string,
    sources: Vec[ModuleSource],
) -> Result[Graph, string] {
    let directories = Vec::new();
    for source in sources {
        match collect_package_directories(
            source.directory,
            source.directory,
            artifact_root,
            directories,
        ) {
            Result::Ok(()) => (),
            Result::Err(message) => return Result::Err(message),
        }
    };
    if directories.len() == 0 {
        return Result::Err("module has no package directories")
    } else {
        ()
    };
    let package_files = Vec::new();
    let all_files = Vec::new();
    for directory in directories {
        let files = match source_files(directory, false) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        if files.len() == 0 {
            return Result::Err("package has no .gom files: " + directory)
        } else {
            ()
        };
        for file in files {
            all_files.push(file)
        };
        package_files.push((directory, files))
    };
    let all_info = match compiler_package_info(
        compiler,
        module_dir,
        all_files,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let packages = Vec::new();
    for item in package_files {
        let directory = item.0;
        let files = item.1;
        let source = match source_for_package_directory(sources, directory) {
            Option::Some(value) => value,
            Option::None => return Result::Err(
                "package directory has no module source " + directory,
            ),
        };
        let package_name = match package_name_for_directory(
            source.directory,
            source.name,
            directory,
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        let info = match select_package_info(
            module_dir,
            all_info,
            files,
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        let package_value = match package_from_info(
            sources,
            source,
            package_name,
            directory,
            files,
            info,
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        match find_package(packages, package_value.name) {
            Option::Some(_) => return Result::Err(
                "package "
                    + package_value.name
                    + " is provided by more than one module",
            ),
            Option::None => packages.push(package_value),
        }
    };
    let order = match topological_order_all(packages) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let entry_package = match find_package(packages, module_path) {
        Option::Some(_) => module_path,
        Option::None => order.get(0),
    };
    Result::Ok(Graph {
        module_dir,
        module_path,
        entry_package,
        packages,
        sources,
        order,
    })
}

fn discover_graph(
    compiler: string,
    module_dir: string,
    module_path: string,
    entry_dir: string,
    include_tests: bool,
    sources: Vec[ModuleSource],
) -> Result[Graph, string] {
    let entry_package = match package_name_for_directory(
        module_dir,
        module_path,
        entry_dir,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let packages = Vec::new();
    let pending = Vec::new();
    let seen: HashMap[string, bool] = HashMap::new();
    pending.push(entry_package);
    while pending.len() > 0 {
        let package_name = pending.remove(0);
        if seen.contains(package_name) {
            ()
        } else {
            let package_value = match load_package(
                compiler,
                module_dir,
                sources,
                package_name,
                include_tests,
                entry_package,
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            seen.set(package_name, true);
            for dependency in package_value.imports {
                if !seen.contains(dependency) {
                    pending.push(dependency)
                } else {
                    ()
                }
            };
            packages.push(package_value)
        }
    };
    let order = match topological_order(packages, entry_package) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    Result::Ok(Graph {
        module_dir,
        module_path,
        entry_package,
        packages,
        sources,
        order,
    })
}

fn resolve_compiler(explicit: Option[string]) -> Result[string, string] {
    let candidate = match explicit {
        Option::Some(value) => Option::Some(value),
        Option::None => match env::var("GOMLC") {
            Option::Some(value) => if value == "" {
                Option::None
            } else {
                Option::Some(value)
            },
            Option::None => Option::None,
        },
    };
    let compiler = match candidate {
        Option::Some(value) => value,
        Option::None => match env::current_exe() {
            Result::Ok(value) => match path::parent(value) {
                Option::Some(parent) => {
                    let sibling = path::join(parent, "gomlc");
                    if fs::is_file(sibling) {
                        sibling
                    } else {
                        match env::var("GOML_HOME") {
                            Option::Some(home) => {
                                let installed = path::join(
                                    path::join(home, "bin"),
                                    "gomlc",
                                );
                                if fs::is_file(installed) {
                                    installed
                                } else {
                                    "gomlc"
                                }
                            },
                            Option::None => "gomlc",
                        }
                    }
                },
                Option::None => match env::var("GOML_HOME") {
                    Option::Some(home) => {
                        let installed = path::join(
                            path::join(home, "bin"),
                            "gomlc",
                        );
                        if fs::is_file(installed) {
                            installed
                        } else {
                            "gomlc"
                        }
                    },
                    Option::None => "gomlc",
                },
            },
            Result::Err(_) => "gomlc",
        },
    };
    let compiler = if fs::is_file(compiler) {
        match canonical(compiler) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        }
    } else {
        match process::look_path(compiler) {
            Result::Ok(value) => match canonical(value) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            },
            Result::Err(message) => return Result::Err(message),
        }
    };
    let output = match process::Command::new(compiler)
        .arg("version")
        .arg("--format")
        .arg("json")
        .output()
    {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    if !(process::ExitStatus::success(process::Output::status(output))) {
        return Result::Err("gomlc does not support the driver protocol")
    } else {
        ()
    };
    let version = match json::parse(output_text(process::Output::stdout(output))) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    match json::field(version, "driver_protocol") {
        Option::Some(json::Value::Number(value)) => if value == "1" {
            Result::Ok(compiler)
        } else {
            Result::Err("incompatible gomlc driver protocol " + value)
        },
        _ => Result::Err("gomlc omitted driver_protocol"),
    }
}

pub fn load_context(
    target_dir_override: Option[string],
    compiler_override: Option[string],
) -> Result[Context, string] {
    let current = match env::current_dir() {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let module_dir = match manifest_root(current) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let module_manifest = match manifest::load(path::join(module_dir, "goml.toml")) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let compiler = match resolve_compiler(compiler_override) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let sources = match module_sources(module_dir, module_manifest) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let artifact_root = match target_dir_override {
        Option::Some(value) => if path::is_absolute(value) {
            path::clean(value)
        } else {
            path::join(module_dir, value)
        },
        Option::None => path::join(module_dir, module_manifest.target_dir),
    };
    let graph = match discover_module_graph(
        compiler,
        module_dir,
        module_manifest.module_path,
        artifact_root,
        sources,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    Result::Ok(Context {
        graph,
        compiler,
        artifact_root,
    })
}

pub fn load_target_context(
    target: string,
    target_dir_override: Option[string],
    compiler_override: Option[string],
) -> Result[Context, string] {
    let entry_dir = match target_directory(target) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let module_dir = match manifest_root(entry_dir) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let module_manifest = match manifest::load(path::join(module_dir, "goml.toml")) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let compiler = match resolve_compiler(compiler_override) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let sources = match module_sources(module_dir, module_manifest) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let artifact_root = match target_dir_override {
        Option::Some(value) => if path::is_absolute(value) {
            path::clean(value)
        } else {
            path::join(module_dir, value)
        },
        Option::None => path::join(module_dir, module_manifest.target_dir),
    };
    let graph = match discover_graph(
        compiler,
        module_dir,
        module_manifest.module_path,
        entry_dir,
        false,
        sources,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    Result::Ok(Context {
        graph,
        compiler,
        artifact_root,
    })
}

fn graph_with_entry(base: Graph, extra: Graph, entry: string) -> Result[Graph, string] {
    let packages = Vec::new();
    for package_value in base.packages {
        packages.push(package_value)
    };
    for package_value in extra.packages {
        match find_package(packages, package_value.name) {
            Option::Some(existing) => if existing.declared_name
                != package_value.declared_name
            {
                return Result::Err(
                    "conflicting package inputs for " + package_value.name,
                )
            } else {
                ()
            },
            Option::None => packages.push(package_value),
        }
    };
    let order = match topological_order_all(packages) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    Result::Ok(Graph {
        module_dir: base.module_dir,
        module_path: base.module_path,
        entry_package: entry,
        packages,
        sources: base.sources,
        order,
    })
}

fn internal_test_graph(
    context: Context,
    package_value: Package,
    test_package: Package,
) -> Result[Graph, string] {
    let packages = Vec::new();
    let seen: HashMap[string, bool] = HashMap::new();
    for current in context.graph.packages {
        if current.name == package_value.name {
            packages.push(test_package)
        } else {
            packages.push(current)
        };
        seen.set(current.name, true)
    };
    let pending = Vec::new();
    for dependency in test_package.imports {
        if !seen.contains(dependency) {
            pending.push(dependency)
        } else {
            ()
        }
    };
    while pending.len() > 0 {
        let package_name = pending.remove(0);
        if seen.contains(package_name) {
            ()
        } else {
            let current = match load_package(
                context.compiler,
                context.graph.module_dir,
                context.graph.sources,
                package_name,
                false,
                package_value.name,
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            seen.set(package_name, true);
            for dependency in current.imports {
                if !seen.contains(dependency) {
                    pending.push(dependency)
                } else {
                    ()
                }
            };
            packages.push(current)
        }
    };
    let order = match topological_order(packages, package_value.name) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    Result::Ok(Graph {
        module_dir: context.graph.module_dir,
        module_path: context.graph.module_path,
        entry_package: package_value.name,
        packages,
        sources: context.graph.sources,
        order,
    })
}

pub fn internal_test_graphs(context: Context) -> Result[Vec[Graph], string] {
    let result = Vec::new();
    let names = Vec::new();
    for package_value in context.graph.packages {
        if package_value.module_name == context.graph.module_path {
            let files = match source_files(package_value.directory, true) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            if files.len() > package_value.files.len() {
                names.push(package_value.name)
            } else {
                ()
            }
        } else {
            ()
        }
    };
    let package_files = Vec::new();
    let all_files = Vec::new();
    for package_name in util::sorted(names) {
        let package_value = match find_package(
            context.graph.packages,
            package_name,
        ) {
            Option::Some(value) => value,
            Option::None => return Result::Err("missing package " + package_name),
        };
        let files = match source_files(package_value.directory, true) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        let test_files = Vec::new();
        for file in files {
            if !contains_file(package_value.files, file) {
                test_files.push(file);
                all_files.push(file)
            } else {
                ()
            }
        };
        package_files.push((package_value, files, test_files))
    };
    if package_files.len() == 0 {
        return Result::Ok(result)
    } else {
        ()
    };
    let all_info = match compiler_package_info(
        context.compiler,
        context.graph.module_dir,
        all_files,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    for item in package_files {
        let package_value = item.0;
        let files = item.1;
        let test_files = item.2;
        let info = match select_package_info(
            context.graph.module_dir,
            all_info,
            test_files,
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        let test_package = match extend_package_with_info(
            context.graph.sources,
            package_value,
            files,
            test_files,
            info,
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        let graph = match internal_test_graph(
            context,
            package_value,
            test_package,
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        result.push(graph)
    };
    Result::Ok(result)
}

pub fn external_test_graphs(context: Context) -> Result[Vec[ExternalTest], string] {
    let result = Vec::new();
    let names = Vec::new();
    for package_value in context.graph.packages {
        if package_value.module_name == context.graph.module_path {
            names.push(package_value.name)
        } else {
            ()
        }
    };
    for target_package in util::sorted(names) {
        let package_value = match find_package(
            context.graph.packages,
            target_package,
        ) {
            Option::Some(value) => value,
            Option::None => return Result::Err(
                "missing package " + target_package,
            ),
        };
        let tests_dir = path::join(package_value.directory, "tests");
        if !fs::exists(tests_dir) {
            ()
        } else if !fs::is_dir(tests_dir) {
            return Result::Err(tests_dir + " must be a directory")
        } else {
            let files = match black_box_test_files(tests_dir) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            if files.len() == 0 {
                ()
            } else {
                let graph = match discover_graph(
                    context.compiler,
                    context.graph.module_dir,
                    context.graph.module_path,
                    tests_dir,
                    true,
                    context.graph.sources,
                ) {
                    Result::Ok(value) => value,
                    Result::Err(message) => return Result::Err(message),
                };
                let test_package = match find_package(
                    graph.packages,
                    graph.entry_package,
                ) {
                    Option::Some(value) => value,
                    Option::None => return Result::Err(
                        "missing black-box test package",
                    ),
                };
                if test_package.declared_name != "tests" {
                    return Result::Err(
                        tests_dir + " must declare package tests;",
                    )
                } else {
                    ()
                };
                let combined = match graph_with_entry(
                    context.graph,
                    graph,
                    test_package.name,
                ) {
                    Result::Ok(value) => value,
                    Result::Err(message) => return Result::Err(message),
                };
                result.push(ExternalTest {
                    graph: combined,
                    target_package,
                })
            }
        }
    };
    Result::Ok(result)
}

pub fn package_by_name(graph: Graph, name: string) -> Option[Package] {
    find_package(graph.packages, name)
}

pub fn module_relative(module_dir: string, value: string) -> string {
    relative_path(module_dir, value)
}
