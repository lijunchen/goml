package project;

use gomlang::bootstrap_goml::util;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::text;

struct BuildNode {
    index: int,
    command: Command,
    dependencies: Vec[int],
}

struct BuildGraph {
    nodes: Vec[BuildNode],
}

fn package_artifact_base(
    root: string,
    graph: Graph,
    package_name: string,
) -> string {
    let package_value = match package_by_name(graph, package_name) {
        Option::Some(value) => value,
        Option::None => return path::join(root, package_name),
    };
    let result = Ref::new(path::join(root, package_value.artifact_prefix));
    for segment in util::split(package_name, "::") {
        result.set(path::join(result.get(), segment))
    };
    path::join(result.get(), last_segment(package_name))
}

fn linked_go_output(root: string, graph: Graph, package_name: string) -> string {
    match path::parent(package_artifact_base(root, graph, package_name)) {
        Option::Some(value) => path::join(value, "goml_generated.go"),
        Option::None => path::join(root, "goml_generated.go"),
    }
}

fn extension(value: string, suffix: string) -> string {
    path::with_extension(value, suffix)
}

fn last_segment(value: string) -> string {
    let segments = util::split(value, "::");
    if segments.len() == 0 {
        value
    } else {
        segments.get(segments.len() - 1)
    }
}

fn executable_path_for(context: Context, entry_package: string) -> string {
    let result = Ref::new(path::join(context.artifact_root, "bin"));
    let module_segments = util::split(context.graph.module_path, "::");
    let entry_segments = util::split(entry_package, "::");
    for index in range(module_segments.len(), entry_segments.len()) {
        result.set(path::join(result.get(), entry_segments.get(index)))
    };
    path::join(result.get(), last_segment(entry_package))
}

fn collect_dependencies(
    graph: Graph,
    package_name: string,
    seen: HashMap[string, bool],
    result: Vec[string],
) -> Result[unit, string] {
    let package_value = match package_by_name(graph, package_name) {
        Option::Some(value) => value,
        Option::None => return Result::Err("missing package " + package_name),
    };
    for dependency in package_value.imports {
        if seen.contains(dependency) {
            ()
        } else {
            seen.set(dependency, true);
            result.push(dependency);
            match collect_dependencies(graph, dependency, seen, result) {
                Result::Ok(()) => (),
                Result::Err(message) => return Result::Err(message),
            }
        }
    };
    Result::Ok(())
}

fn dependency_interfaces(
    graph: Graph,
    package_name: string,
    output_root: string,
) -> Result[Vec[string], string] {
    let names = Vec::new();
    match collect_dependencies(
        graph,
        package_name,
        HashMap::new(),
        names,
    ) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    let result = Vec::new();
    for name in util::sorted_unique(names) {
        result.push(extension(
            package_artifact_base(output_root, graph, name),
            "interface",
        ))
    };
    Result::Ok(result)
}

fn compile_commands(
    context: Context,
    output_root: string,
    entry_command: string,
    dependency_command: string,
) -> Result[Vec[Command], string] {
    let result = Vec::new();
    for package_name in context.graph.order {
        let command = if package_name == context.graph.entry_package {
            entry_command
        } else {
            dependency_command
        };
        let compiled = match compile_package_command(
            context.graph,
            context.graph.module_dir,
            package_name,
            output_root,
            output_root,
            command,
            compiler_world_path(context),
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        result.push(compiled)
    };
    Result::Ok(result)
}

fn compiler_world_path(context: Context) -> Option[string] {
    if context.compiler_world_artifact {
        Option::Some(module_relative(
            context.graph.module_dir,
            path::join(
                path::join(context.artifact_root, "compiler"),
                "world-v1.gaf",
            ),
        ))
    } else {
        Option::None
    }
}

fn commands_with_world(
    context: Context,
    commands: Vec[Command],
) -> Vec[Command] {
    match compiler_world_path(context) {
        Option::Some(output) => {
            let result = Vec::new().pushed(Command::PrepareWorld { output });
            for command in commands {
                result.push(command)
            };
            result
        },
        Option::None => commands,
    }
}

fn compile_package_command(
    graph: Graph,
    module_dir: string,
    package_name: string,
    interface_root: string,
    output_root: string,
    command: string,
    world: Option[string],
) -> Result[Command, string] {
    let package_value = match package_by_name(graph, package_name) {
        Option::Some(value) => value,
        Option::None => return Result::Err("missing package " + package_name),
    };
    let inputs = Vec::new();
    for file in package_value.files {
        inputs.push(module_relative(module_dir, file))
    };
    let interfaces = match dependency_interfaces(
        graph,
        package_name,
        interface_root,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let relative_interfaces = Vec::new();
    for value in interfaces {
        relative_interfaces.push(module_relative(module_dir, value))
    };
    Result::Ok(Command::Compile {
        subcommand: command,
        package_name,
        input_files: util::sorted(inputs),
        interface_files: relative_interfaces,
        output: module_relative(
            module_dir,
            package_artifact_base(output_root, graph, package_name),
        ),
        world,
    })
}

fn compile_test_package_command(
    graph: Graph,
    module_dir: string,
    package_name: string,
    dependency_root: string,
    output_root: string,
    production_interface: bool,
    world: Option[string],
) -> Result[Command, string] {
    let compiled = match compile_package_command(
        graph,
        module_dir,
        package_name,
        dependency_root,
        output_root,
        "test-build",
        world,
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    match compiled {
        Command::Compile {
            subcommand,
            package_name,
            input_files,
            interface_files,
            output,
            world,
        } => {
            if production_interface {
                interface_files.push(module_relative(
                    module_dir,
                    extension(
                        package_artifact_base(
                            dependency_root,
                            graph,
                            package_name,
                        ),
                        "interface",
                    ),
                ))
            } else {
                ()
            };
            Result::Ok(Command::Compile {
                subcommand,
                package_name,
                input_files,
                interface_files,
                output,
                world,
            })
        },
        _ => Result::Err("test package did not produce a compile command"),
    }
}

fn core_outputs(context: Context, output_root: string) -> Vec[string] {
    let result = Vec::new();
    for package_name in context.graph.order {
        result.push(module_relative(
            context.graph.module_dir,
            extension(
                package_artifact_base(
                    output_root,
                    context.graph,
                    package_name,
                ),
                "core",
            ),
        ))
    };
    result
}

pub fn check_plan(context: Context, include_tests: bool) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, "check");
    let commands = match compile_commands(
        context,
        output_root,
        "check",
        "check",
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    if include_tests {
        let internal = match internal_test_graphs(context) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        for graph in internal {
            let target = Context {
                graph,
                compiler: context.compiler,
                compiler_world_artifact: context.compiler_world_artifact,
                artifact_root: context.artifact_root,
            };
            let values = match compile_commands(
                target,
                output_root,
                "test-check",
                "check",
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            for value in values {
                commands.push(value)
            }
        };
        let external = match external_test_graphs(context) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        for test in external {
            let target = Context {
                graph: test.graph,
                compiler: context.compiler,
                compiler_world_artifact: context.compiler_world_artifact,
                artifact_root: context.artifact_root,
            };
            let values = match compile_commands(
                target,
                output_root,
                "test-check",
                "check",
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            for value in values {
                commands.push(value)
            }
        }
    } else {
        ()
    };
    Result::Ok(Plan {
        commands: commands_with_world(context, commands),
        executable: Option::None,
        test_groups: Vec::new(),
    })
}

pub fn build_plan(context: Context) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, "build");
    let commands = match compile_commands(
        context,
        output_root,
        "build",
        "build",
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let entries = Vec::new();
    for package_name in context.graph.order {
        let package_value = match package_by_name(context.graph, package_name) {
            Option::Some(value) => value,
            Option::None => return Result::Err("missing package " + package_name),
        };
        if package_value.declared_name == "main" {
            entries.push(package_name)
        } else {
            ()
        }
    };
    for entry_package in util::sorted(entries) {
        let main_go = linked_go_output(
            output_root,
            context.graph,
            entry_package,
        );
        commands.push(Command::Link {
            input_cores: core_outputs(context, output_root),
            entry_package,
            output: module_relative(context.graph.module_dir, main_go),
            world: compiler_world_path(context),
        });
        let executable = executable_path_for(context, entry_package);
        commands.push(Command::GoBuild {
            input: module_relative(context.graph.module_dir, main_go),
            output: module_relative(context.graph.module_dir, executable),
        })
    };
    Result::Ok(Plan {
        commands: commands_with_world(context, commands),
        executable: Option::None,
        test_groups: Vec::new(),
    })
}

pub fn run_plan(context: Context) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, "build");
    let commands = match compile_commands(
        context,
        output_root,
        "build",
        "build",
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let main_go = linked_go_output(
        output_root,
        context.graph,
        context.graph.entry_package,
    );
    commands.push(Command::Link {
        input_cores: core_outputs(context, output_root),
        entry_package: context.graph.entry_package,
        output: module_relative(context.graph.module_dir, main_go),
        world: compiler_world_path(context),
    });
    let executable = executable_path_for(
        context,
        context.graph.entry_package,
    );
    commands.push(Command::GoBuild {
        input: module_relative(context.graph.module_dir, main_go),
        output: module_relative(context.graph.module_dir, executable),
    });
    Result::Ok(Plan {
        commands: commands_with_world(context, commands),
        executable: Option::Some(executable),
        test_groups: Vec::new(),
    })
}

fn append_test_package(
    context: Context,
    graph: Graph,
    dependency_root: string,
    output_root: string,
    compiled_dependencies: HashMap[string, bool],
    commands: Vec[Command],
) -> Result[unit, string] {
    for package_name in graph.order {
        if package_name == graph.entry_package
            || compiled_dependencies.contains(package_name)
        {
            ()
        } else {
            let compiled = match compile_package_command(
                graph,
                context.graph.module_dir,
                package_name,
                dependency_root,
                dependency_root,
                "build",
                compiler_world_path(context),
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            commands.push(compiled);
            compiled_dependencies.set(package_name, true)
        }
    };
    let compiled = match compile_test_package_command(
        graph,
        context.graph.module_dir,
        graph.entry_package,
        dependency_root,
        output_root,
        compiled_dependencies.contains(graph.entry_package),
        compiler_world_path(context),
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    commands.push(compiled);
    Result::Ok(())
}

fn append_test_group(
    context: Context,
    graphs: Vec[Graph],
    dependency_root: string,
    output_root: string,
    kind: string,
    packages: Vec[string],
    commands: Vec[Command],
    groups: Vec[TestGroup],
) -> unit {
    let test_packages = HashMap::new();
    for graph in graphs {
        test_packages.set(graph.entry_package, true)
    };
    let input_cores = Vec::new();
    let added = HashMap::new();
    for package_name in context.graph.order {
        let root = if test_packages.contains(package_name) {
            output_root
        } else {
            dependency_root
        };
        input_cores.push(module_relative(
            context.graph.module_dir,
            extension(
                package_artifact_base(
                    root,
                    context.graph,
                    package_name,
                ),
                "core",
            ),
        ));
        added.set(package_name, true)
    };
    for graph in graphs {
        for package_name in graph.order {
            if added.contains(package_name) {
                ()
            } else {
                let root = if test_packages.contains(package_name) {
                    output_root
                } else {
                    dependency_root
                };
                input_cores.push(module_relative(
                    context.graph.module_dir,
                    extension(
                        package_artifact_base(root, graph, package_name),
                        "core",
                    ),
                ));
                added.set(package_name, true)
            }
        }
    };
    let main_go = path::join(output_root, "goml_generated.go");
    let manifest = path::join(output_root, "tests.json");
    commands.push(Command::TestLink {
        input_cores,
        packages,
        output: module_relative(context.graph.module_dir, main_go),
        manifest: module_relative(context.graph.module_dir, manifest),
        world: compiler_world_path(context),
    });
    let runner = path::join(output_root, "runner");
    commands.push(Command::GoBuild {
        input: module_relative(context.graph.module_dir, main_go),
        output: module_relative(context.graph.module_dir, runner),
    });
    groups.push(TestGroup {
        kind,
        manifest,
        runner,
    });
}

pub fn test_plan(context: Context, kind: string) -> Result[Plan, string] {
    let dependency_root = path::join(
        path::join(context.artifact_root, "test"),
        "base",
    );
    let commands = match compile_commands(
        context,
        dependency_root,
        "build",
        "build",
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let compiled_dependencies = HashMap::new();
    for package_name in context.graph.order {
        compiled_dependencies.set(package_name, true)
    };
    let groups = Vec::new();
    let internal = if kind == "internal" || kind == "all" {
        match internal_test_graphs(context) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        }
    } else {
        Vec::new()
    };
    let internal_root = path::join(
        path::join(context.artifact_root, "test"),
        "internal",
    );
    let internal_graphs = Vec::new();
    let internal_packages = Vec::new();
    for graph in internal {
        let package_name = graph.entry_package;
        match append_test_package(
            context,
            graph,
            dependency_root,
            internal_root,
            compiled_dependencies,
            commands,
        ) {
            Result::Ok(()) => {
                internal_graphs.push(graph);
                internal_packages.push(package_name)
            },
            Result::Err(message) => return Result::Err(message),
        }
    };
    if internal_graphs.len() > 0 {
        append_test_group(
            context,
            internal_graphs,
            dependency_root,
            internal_root,
            "internal",
            internal_packages,
            commands,
            groups,
        )
    } else {
        ()
    };
    let external = if kind == "external" || kind == "all" {
        match external_test_graphs(context) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        }
    } else {
        Vec::new()
    };
    let external_root = path::join(
        path::join(context.artifact_root, "test"),
        "external",
    );
    let external_graphs = Vec::new();
    let external_packages = Vec::new();
    for test in external {
        let package_name = test.graph.entry_package;
        match append_test_package(
            context,
            test.graph,
            dependency_root,
            external_root,
            compiled_dependencies,
            commands,
        ) {
            Result::Ok(()) => {
                external_graphs.push(test.graph);
                external_packages.push(package_name);
                external_packages.push(test.target_package)
            },
            Result::Err(message) => return Result::Err(message),
        }
    };
    if external_graphs.len() > 0 {
        append_test_group(
            context,
            external_graphs,
            dependency_root,
            external_root,
            "external",
            external_packages,
            commands,
            groups,
        )
    } else {
        ()
    };
    Result::Ok(Plan {
        commands: commands_with_world(context, commands),
        executable: Option::None,
        test_groups: groups,
    })
}

fn display_args(program: string, args: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(program);
    for argument in args {
        builder.write_char(' ');
        builder.write_string(util::shell_escape(argument))
    };
    builder.finish()
}

fn command_args(value: Command) -> (string, Vec[string]) {
    match value {
        Command::PrepareWorld { output } => (
            "gomlc",
            Vec::new()
                .pushed("prepare-world")
                .pushed("--output")
                .pushed(output),
        ),
        Command::Compile {
            subcommand,
            package_name,
            input_files,
            interface_files,
            output,
            world,
        } => {
            let args = Vec::new();
            args.push(subcommand);
            args.push("--package");
            args.push(package_name);
            for input in input_files {
                args.push("--input");
                args.push(input)
            };
            for interface in interface_files {
                args.push("--interface-path");
                args.push(interface)
            };
            args.push("--output");
            args.push(output);
            match world {
                Option::Some(value) => {
                    args.push("--world");
                    args.push(value)
                },
                Option::None => (),
            };
            ("gomlc", args)
        },
        Command::Link {
            input_cores,
            entry_package,
            output,
            world,
        } => {
            let args = Vec::new();
            args.push("link");
            args.push("--input");
            for input in input_cores {
                args.push(input)
            };
            args.push("--output");
            args.push(output);
            args.push("--entry");
            args.push(entry_package);
            match world {
                Option::Some(value) => {
                    args.push("--world");
                    args.push(value)
                },
                Option::None => (),
            };
            ("gomlc", args)
        },
        Command::TestLink {
            input_cores,
            packages,
            output,
            manifest,
            world,
        } => {
            let args = Vec::new();
            args.push("test-link");
            args.push("--input");
            for input in input_cores {
                args.push(input)
            };
            args.push("--output");
            args.push(output);
            args.push("--manifest");
            args.push(manifest);
            for package_name in packages {
                args.push("--package");
                args.push(package_name)
            };
            match world {
                Option::Some(value) => {
                    args.push("--world");
                    args.push(value)
                },
                Option::None => (),
            };
            ("gomlc", args)
        },
        Command::GoBuild { input, output } => (
            "go",
            Vec::new()
                .pushed("build")
                .pushed("-o")
                .pushed(output)
                .pushed(input),
        ),
    }
}

pub fn display_command(value: Command) -> string {
    let command = command_args(value);
    display_args(command.0, command.1)
}

fn progress_label(value: Command) -> string {
    match value {
        Command::PrepareWorld { .. } => "preparing compiler world",
        Command::Compile {
            subcommand,
            package_name,
            ..
        } => if subcommand == "check" {
            "checking " + package_name
        } else if subcommand == "build" {
            "compiling " + package_name
        } else if subcommand == "test-check" {
            "checking tests for " + package_name
        } else if subcommand == "test-build" {
            "compiling tests for " + package_name
        } else {
            subcommand + " " + package_name
        },
        Command::Link { entry_package, .. } => "linking " + entry_package,
        Command::TestLink { .. } => "linking test runner",
        Command::GoBuild { .. } => "building executable",
    }
}

fn progress_bar(completed: int, total: int) -> string {
    let width = 20;
    let filled = if total == 0 {
        width
    } else {
        completed * width / total
    };
    let builder = text::StringBuilder::with_capacity(width + 2);
    builder.write_char('[');
    for index in range(0, width) {
        builder.write_char(if index < filled { '#' } else { '-' })
    };
    builder.write_char(']');
    builder.finish()
}

fn display_progress(completed: int, total: int, label: string) -> unit {
    io::eprintln(
        progress_bar(completed, total)
            + " "
            + completed.to_string()
            + "/"
            + total.to_string()
            + " "
            + label,
    )
}

fn ensure_output_parent(value: Command, module_dir: string) -> Result[unit, string] {
    let output = match value {
        Command::PrepareWorld { output }
        | Command::Compile { output, .. }
        | Command::Link { output, .. }
        | Command::TestLink { output, .. }
        | Command::GoBuild { output, .. } => output,
    };
    let absolute = if path::is_absolute(output) {
        output
    } else {
        path::join(module_dir, output)
    };
    match path::parent(absolute) {
        Option::Some(parent) => fs::create_dir_all(parent),
        Option::None => Result::Ok(()),
    }
}

fn execute_command(
    context: Context,
    value: Command,
) -> Result[unit, string] {
    match ensure_output_parent(value, context.graph.module_dir) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    let command = command_args(value);
    let program = if command.0 == "gomlc" {
        context.compiler
    } else {
        command.0
    };
    let process = process::Command::new(program)
        .args(command.1)
        .current_dir(context.graph.module_dir);
    if command.0 == "go" {
        let _ = process.env("GOWORK", "off");
        let _ = process.env("GO111MODULE", "off");
    } else {
        ()
    };
    match process.status() {
        Result::Ok(status) => if process::ExitStatus::success(status) {
            Result::Ok(())
        } else {
            Result::Err(display_command(value) + " failed")
        },
        Result::Err(message) => Result::Err(message),
    }
}

struct PreparedCache {
    spec: CacheSpec,
    fingerprint: string,
}

enum CachePreparation {
    Fresh,
    Execute(Option[PreparedCache]),
}

fn prepare_cached_command(
    context: Context,
    command: Command,
    identity: string,
) -> Result[CachePreparation, string] {
    match cache_spec(command) {
        Option::Some(spec) => {
            let fingerprint = match command_fingerprint(
                context,
                identity,
                spec,
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            let fresh = match cache_is_fresh(
                context,
                spec,
                fingerprint,
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            if fresh {
                Result::Ok(CachePreparation::Fresh)
            } else {
                match prepare_cache_execution(context, spec) {
                    Result::Ok(()) => (),
                    Result::Err(message) => return Result::Err(message),
                };
                Result::Ok(CachePreparation::Execute(Option::Some(
                    PreparedCache {
                        spec,
                        fingerprint,
                    },
                )))
            }
        },
        Option::None => Result::Ok(CachePreparation::Execute(Option::None)),
    }
}

fn execute_prepared_command(
    context: Context,
    command: Command,
    cache: Option[PreparedCache],
) -> Result[unit, string] {
    match execute_command(context, command) {
        Result::Ok(()) => Result::Ok(()),
        Result::Err(message) => {
            match cache {
                Option::Some(value) => {
                    let _ = prepare_cache_execution(
                        context,
                        value.spec,
                    );
                },
                Option::None => (),
            };
            Result::Err(message)
        },
    }
}

fn finish_prepared_command(
    context: Context,
    identity: string,
    cache: Option[PreparedCache],
) -> Result[unit, string] {
    match cache {
        Option::Some(value) => store_cache(
                    context,
                    value.spec,
                    identity,
                    value.fingerprint,
                ),
        Option::None => Result::Ok(()),
    }
}

fn discard_prepared_command(
    context: Context,
    cache: Option[PreparedCache],
) -> unit {
    match cache {
        Option::Some(value) => {
            let _ = prepare_cache_execution(context, value.spec);
        },
        Option::None => (),
    }
}

fn build_graph(commands: Vec[Command]) -> Result[BuildGraph, string] {
    let producers: HashMap[string, Vec[int]] = HashMap::new();
    for index in range(0, commands.len()) {
        match cache_spec(commands.get(index)) {
            Option::Some(spec) => for output in spec.outputs {
                match producers.get(output) {
                    Option::Some(values) => values.push(index),
                    Option::None => producers.set(
                        output,
                        Vec::new().pushed(index),
                    ),
                }
            },
            Option::None => (),
        }
    };
    let result = Vec::new();
    for index in range(0, commands.len()) {
        let command = commands.get(index);
        let dependencies = Vec::new();
        match cache_spec(command) {
            Option::Some(spec) => for input in spec.inputs {
                let previous = Ref::new(-1);
                let following = Ref::new(-1);
                match producers.get(input) {
                    Option::Some(values) => for candidate in values {
                        if candidate < index && candidate > previous.get() {
                            previous.set(candidate)
                        } else if candidate > index && following.get() < 0 {
                            following.set(candidate)
                        } else {
                            ()
                        }
                    },
                    Option::None => (),
                };
                let producer = if previous.get() >= 0 {
                    previous.get()
                } else {
                    following.get()
                };
                if producer >= 0
                    && !util::int_vec_contains(dependencies, producer)
                {
                    dependencies.push(producer)
                } else {
                    ()
                }
            },
            Option::None => (),
        };
        match cache_spec(command) {
            Option::Some(spec) => for output in spec.outputs {
                let previous = Ref::new(-1);
                match producers.get(output) {
                    Option::Some(values) => for candidate in values {
                        if candidate < index && candidate > previous.get() {
                            previous.set(candidate)
                        } else {
                            ()
                        }
                    },
                    Option::None => (),
                };
                if previous.get() >= 0
                    && !util::int_vec_contains(dependencies, previous.get())
                {
                    dependencies.push(previous.get())
                } else {
                    ()
                }
            },
            Option::None => (),
        };
        result.push(BuildNode {
            index,
            command,
            dependencies,
        })
    };
    Result::Ok(BuildGraph { nodes: result })
}

fn build_node(nodes: Vec[BuildNode], index: int) -> Option[BuildNode] {
    for node in nodes {
        if node.index == index {
            return Option::Some(node)
        } else {
            ()
        }
    };
    Option::None
}

fn build_node_ready(node: BuildNode, completed: Vec[int]) -> bool {
    for dependency in node.dependencies {
        if !util::int_vec_contains(completed, dependency) {
            return false
        } else {
            ()
        }
    };
    true
}

struct BuildWork {
    index: int,
    command: Command,
    cache: Option[PreparedCache],
}

struct BuildWorkResult {
    index: int,
    cache: Option[PreparedCache],
    result: Result[unit, string],
}

fn execute_plan_worker(
    context: Context,
    work: Channel[BuildWork],
    results: Channel[BuildWorkResult],
) -> unit {
    while true {
        match work.recv() {
            Option::Some(value) => results.send(BuildWorkResult {
                index: value.index,
                cache: value.cache,
                result: execute_prepared_command(
                    context,
                    value.command,
                    value.cache,
                ),
            }),
            Option::None => break,
        }
    }
}

pub fn execute_plan(
    context: Context,
    plan: Plan,
    dry_run: bool,
    jobs: int,
) -> Result[unit, string] {
    if !dry_run && jobs < 1 {
        return Result::Err("build jobs must be greater than zero")
    } else {
        ()
    };
    let total = plan.commands.len();
    let completed = Ref::new(0);
    let identity = if dry_run {
        ""
    } else {
        match compiler_digest(context) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        }
    };
    if dry_run {
        for command in plan.commands {
            io::println(display_command(command))
        }
    } else {
        let graph = match build_graph(plan.commands) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        let initial = Vec::new();
        for node in graph.nodes {
            initial.push(node.index)
        };
        let pending = Ref::new(initial);
        let completed_nodes = Vec::new();
        let running = Ref::new(0);
        let worker_count = if jobs < total { jobs } else { total };
        let work: Channel[BuildWork] = Channel::new(total);
        let results: Channel[BuildWorkResult] = Channel::new(total);
        for _ in range(0, worker_count) {
            go || execute_plan_worker(
                context,
                work,
                results,
            )
        };
        while pending.get().len() > 0 || running.get() > 0 {
            let blocked = Vec::new();
            for index in pending.get() {
                let node = match build_node(graph.nodes, index) {
                    Option::Some(value) => value,
                    Option::None => return Result::Err(
                        "build graph omitted node " + index.to_string(),
                    ),
                };
                if running.get() < worker_count
                    && !build_node_ready(node, completed_nodes)
                {
                    blocked.push(index)
                } else if running.get() < worker_count {
                    display_progress(
                        completed.get(),
                        total,
                        progress_label(node.command),
                    );
                    match prepare_cached_command(
                        context,
                        node.command,
                        identity,
                    ) {
                        Result::Ok(CachePreparation::Fresh) => {
                            completed_nodes.push(node.index);
                            completed.set(completed.get() + 1)
                        },
                        Result::Ok(CachePreparation::Execute(cache)) => {
                            work.send(BuildWork {
                                index: node.index,
                                command: node.command,
                                cache,
                            });
                            running.set(running.get() + 1)
                        },
                        Result::Err(message) => {
                            work.close();
                            for _ in range(0, running.get()) {
                                match results.recv() {
                                    Option::Some(value) => discard_prepared_command(
                                        context,
                                        value.cache,
                                    ),
                                    Option::None => (),
                                }
                            };
                            results.close();
                            return Result::Err(message)
                        },
                    }
                } else {
                    blocked.push(index)
                }
            };
            pending.set(blocked);
            if running.get() == 0 && pending.get().len() > 0 {
                work.close();
                results.close();
                return Result::Err("build plan contains a dependency cycle")
            } else {
                ()
            };
            if running.get() > 0 {
                match results.recv() {
                    Option::Some(value) => match value.result {
                        Result::Ok(()) => match finish_prepared_command(
                            context,
                            identity,
                            value.cache,
                        ) {
                            Result::Ok(()) => {
                                completed_nodes.push(value.index);
                                completed.set(completed.get() + 1)
                            },
                            Result::Err(message) => {
                                completed.set(completed.get() + 1);
                                running.set(running.get() - 1);
                                work.close();
                                for _ in range(0, running.get()) {
                                    match results.recv() {
                                        Option::Some(other) => {
                                            discard_prepared_command(
                                                context,
                                                other.cache,
                                            )
                                        },
                                        Option::None => (),
                                    }
                                };
                                results.close();
                                return Result::Err(message)
                            },
                        },
                        Result::Err(message) => {
                            completed.set(completed.get() + 1);
                            running.set(running.get() - 1);
                            work.close();
                            for _ in range(0, running.get()) {
                                match results.recv() {
                                    Option::Some(_) => (),
                                    Option::None => (),
                                }
                            };
                            results.close();
                            return Result::Err(message)
                        },
                    },
                    Option::None => return Result::Err(
                        "build result channel closed early",
                    ),
                };
                running.set(running.get() - 1)
            } else {
                ()
            }
        };
        work.close();
        results.close()
    };
    if dry_run {
        ()
    } else {
        display_progress(completed.get(), total, "finished")
    };
    Result::Ok(())
}

pub fn run_executable(
    context: Context,
    executable: string,
    args: Vec[string],
    dry_run: bool,
) -> Result[unit, string] {
    let relative = module_relative(context.graph.module_dir, executable);
    if dry_run {
        io::println(display_args(relative, args));
        Result::Ok(())
    } else {
        match process::Command::new(executable)
            .args(args)
            .current_dir(context.graph.module_dir)
            .status()
        {
        Result::Ok(status) => if process::ExitStatus::success(status) {
                Result::Ok(())
            } else {
                match process::ExitStatus::code(status) {
                    Option::Some(code) => Result::Err(
                        "program exited with status " + code.to_string(),
                    ),
                    Option::None => Result::Err("program terminated by signal"),
                }
            },
            Result::Err(message) => Result::Err(message),
        }
    }
}
