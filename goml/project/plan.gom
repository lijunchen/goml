package project;

use gomlang::bootstrap_goml::util;
use std::collections;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::text;

struct BuildNode {
    index: int,
    command: Command,
    dependencies: Vec[int],
}

struct BuildGraph {
    nodes: Vec[BuildNode],
}

fn package_artifact_base(root: string, graph: Graph, package_name: string) -> string {
    let Some(package_value) = package_by_name(graph, package_name) else {
        return path::join(root, package_name)
    };
    let mut result = path::join(root, package_value.artifact_prefix);
    for segment in text::split(package_name, "::") {
        result = path::join(result, segment);
    };
    path::join(result, last_segment(package_name))
}

fn linked_go_output(root: string, graph: Graph, package_name: string) -> string {
    match path::parent(package_artifact_base(root, graph, package_name)) {
        Some(value) => path::join(value, "goml_generated.go"),
        None => path::join(root, "goml_generated.go"),
    }
}

fn extension(value: string, suffix: string) -> string {
    path::with_extension(value, suffix)
}

fn last_segment(value: string) -> string {
    let segments = text::split(value, "::");
    if segments.is_empty() {
        value
    } else {
        segments[segments.len() - 1]
    }
}

fn executable_path_for(context: Context, entry_package: string) -> string {
    let mut result = path::join(context.artifact_root, "bin");
    let module_segments = text::split(context.graph.module_path, "::");
    let entry_segments = text::split(entry_package, "::");
    for index in module_segments.len()..entry_segments.len() {
        result = path::join(result, entry_segments[index]);
    };
    path::join(result, last_segment(entry_package))
}

fn collect_dependencies(
    graph: Graph,
    package_name: string,
    seen: HashMap[string, bool],
    result: Vec[string],
) -> Result[unit, string] {
    let Some(package_value) = package_by_name(graph, package_name) else {
        return Result::Err(f"missing package {package_name}")
    };
    for dependency in package_value.imports {
        if seen.contains(dependency) {
            ()
        } else {
            seen[dependency] = true;
            result.push(dependency);
            collect_dependencies(graph, dependency, seen, result)?
        }
    };
    Result::Ok(())
}

fn mark_reachable(graph: Graph, package_name: string, seen: HashMap[string, bool]) -> Result[
    unit,
    string,
] {
    if seen.contains(package_name) {
        return Result::Ok(())
    } else {
        ()
    };
    let Some(package_value) = package_by_name(graph, package_name) else {
        return Result::Err(f"missing package {package_name}")
    };
    seen[package_name] = true;
    for dependency in package_value.imports {
        mark_reachable(graph, dependency, seen)?
    };
    Result::Ok(())
}

fn reachable_packages(graph: Graph, entries: Vec[string]) -> Result[Vec[string], string] {
    let seen: HashMap[string, bool] = HashMap::{};
    for entry in entries {
        mark_reachable(graph, entry, seen)?
    };
    let result: Vec[string] = Vec::[];
    for package_name in graph.order {
        if seen.contains(package_name) {
            result.push(package_name)
        } else {
            ()
        }
    };
    Result::Ok(result)
}

fn dependency_interfaces(graph: Graph, package_name: string, output_root: string) -> Result[
    Vec[string],
    string,
] {
    let names: Vec[string] = Vec::[];
    collect_dependencies(graph, package_name, HashMap::{}, names)?;
    let result: Vec[string] = Vec::[];
    for name in util::sorted_unique(names) {
        result.push(extension(package_artifact_base(output_root, graph, name), "interface"))
    };
    Result::Ok(result)
}

fn compile_commands(
    context: Context,
    output_root: string,
    entry_command: string,
    dependency_command: string,
    packages: Vec[string],
) -> Result[Vec[Command], string] {
    let result: Vec[Command] = Vec::[];
    for package_name in packages {
        let command = if package_name == context.graph.entry_package {
            entry_command
        } else {
            dependency_command
        };
        let compiled = compile_package_command(
            context.graph,
            context.graph.module_dir,
            package_name,
            output_root,
            output_root,
            command,
            compiler_world_path(context),
        )?;
        result.push(compiled)
    };
    Result::Ok(result)
}

fn compiler_world_path(context: Context) -> Option[string] {
    if context.compiler_world_artifact {
        Option::Some(
            module_relative(
                context.graph.module_dir,
                path::join(path::join(context.artifact_root, "compiler"), "world-v1.gaf"),
            ),
        )
    } else {
        Option::None
    }
}

fn commands_with_world(context: Context, commands: Vec[Command]) -> Vec[Command] {
    match compiler_world_path(context) {
        Some(output) => {
            let result = Vec::[Command::PrepareWorld { output }];
            for command in commands {
                result.push(command)
            };
            result
        },
        None => commands,
    }
}

fn compile_package_command(
    graph: Graph,
    module_dir: string,
    package_name: string,
    interface_root: string,
    output_root: string,
    command: string,
    world: Option[string],
) -> Result[Command, string] {
    let Some(package_value) = package_by_name(graph, package_name) else {
        return Result::Err(f"missing package {package_name}")
    };
    let inputs: Vec[string] = Vec::[];
    for file in package_value.files {
        inputs.push(module_relative(module_dir, file))
    };
    let interfaces = dependency_interfaces(graph, package_name, interface_root)?;
    let relative_interfaces: Vec[string] = Vec::[];
    for value in interfaces {
        relative_interfaces.push(module_relative(module_dir, value))
    };
    Result::Ok(
        Command::Compile {
            subcommand: command,
            package_name,
            input_files: util::sorted(inputs),
            interface_files: relative_interfaces,
            output: module_relative(
                module_dir,
                package_artifact_base(output_root, graph, package_name),
            ),
            world,
        },
    )
}

fn compile_test_package_command(
    graph: Graph,
    module_dir: string,
    package_name: string,
    dependency_root: string,
    output_root: string,
    production_interface: bool,
    world: Option[string],
) -> Result[Command, string] {
    let compiled = compile_package_command(
        graph,
        module_dir,
        package_name,
        dependency_root,
        output_root,
        "test-build",
        world,
    )?;
    match compiled {
        Compile { subcommand, package_name, input_files, interface_files, output, world } => {
            if production_interface {
                interface_files.push(
                    module_relative(
                        module_dir,
                        extension(
                            package_artifact_base(dependency_root, graph, package_name),
                            "interface",
                        ),
                    ),
                )
            } else {
                ()
            };
            Result::Ok(
                Command::Compile {
                    subcommand,
                    package_name,
                    input_files,
                    interface_files,
                    output,
                    world,
                },
            )
        },
        _ => Result::Err("test package did not produce a compile command"),
    }
}

fn core_outputs(context: Context, output_root: string, packages: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    for package_name in packages {
        result.push(
            module_relative(
                context.graph.module_dir,
                extension(package_artifact_base(output_root, context.graph, package_name), "core"),
            ),
        )
    };
    result
}

pub fn check_plan(context: Context, include_tests: bool) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, "check");
    let commands = compile_commands(context, output_root, "check", "check", context.graph.order)?;
    if include_tests {
        let internal = internal_test_graphs(context)?;
        for graph in internal {
            let target = Context {
                graph,
                compiler: context.compiler,
                compiler_world_artifact: context.compiler_world_artifact,
                artifact_root: context.artifact_root,
            };
            let values = compile_commands(
                target,
                output_root,
                "test-check",
                "check",
                target.graph.order,
            )?;
            for value in values {
                commands.push(value)
            }
        };
        let external = external_test_graphs(context)?;
        for test in external {
            let target = Context {
                graph: test.graph,
                compiler: context.compiler,
                compiler_world_artifact: context.compiler_world_artifact,
                artifact_root: context.artifact_root,
            };
            let values = compile_commands(
                target,
                output_root,
                "test-check",
                "check",
                target.graph.order,
            )?;
            for value in values {
                commands.push(value)
            }
        }
    } else {
        ()
    };
    Result::Ok(
        Plan {
            commands: commands_with_world(context, commands),
            executable: Option::None,
            test_groups: Vec::[],
        },
    )
}

pub fn build_plan(context: Context) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, "build");
    let entries: Vec[string] = Vec::[];
    for package_name in context.graph.order {
        let Some(package_value) = package_by_name(context.graph, package_name) else {
            return Result::Err(f"missing package {package_name}")
        };
        if package_value.declared_name == "main" {
            entries.push(package_name)
        } else {
            ()
        }
    };
    let packages = if entries.is_empty() {
        context.graph.order
    } else {
        reachable_packages(context.graph, entries)?
    };
    let commands = compile_commands(context, output_root, "build", "build", packages)?;
    for entry_package in util::sorted(entries) {
        let main_go = linked_go_output(output_root, context.graph, entry_package);
        let packages = reachable_packages(context.graph, Vec::[entry_package])?;
        commands.push(
            Command::Link {
                input_cores: core_outputs(context, output_root, packages),
                entry_package,
                output: module_relative(context.graph.module_dir, main_go),
                world: compiler_world_path(context),
            },
        );
        let executable = executable_path_for(context, entry_package);
        commands.push(
            Command::GoBuild {
                input: module_relative(context.graph.module_dir, main_go),
                output: module_relative(context.graph.module_dir, executable),
            },
        )
    };
    Result::Ok(
        Plan {
            commands: commands_with_world(context, commands),
            executable: Option::None,
            test_groups: Vec::[],
        },
    )
}

pub fn run_plan(context: Context) -> Result[Plan, string] {
    let output_root = path::join(context.artifact_root, "build");
    let packages = reachable_packages(context.graph, Vec::[context.graph.entry_package])?;
    let commands = compile_commands(context, output_root, "build", "build", packages)?;
    let main_go = linked_go_output(output_root, context.graph, context.graph.entry_package);
    let packages = reachable_packages(context.graph, Vec::[context.graph.entry_package])?;
    commands.push(
        Command::Link {
            input_cores: core_outputs(context, output_root, packages),
            entry_package: context.graph.entry_package,
            output: module_relative(context.graph.module_dir, main_go),
            world: compiler_world_path(context),
        },
    );
    let executable = executable_path_for(context, context.graph.entry_package);
    commands.push(
        Command::GoBuild {
            input: module_relative(context.graph.module_dir, main_go),
            output: module_relative(context.graph.module_dir, executable),
        },
    );
    Result::Ok(
        Plan {
            commands: commands_with_world(context, commands),
            executable: Option::Some(executable),
            test_groups: Vec::[],
        },
    )
}

fn append_test_package(
    context: Context,
    graph: Graph,
    dependency_root: string,
    output_root: string,
    compiled_dependencies: HashMap[string, bool],
    commands: Vec[Command],
) -> Result[unit, string] {
    for package_name in graph.order {
        if package_name == graph.entry_package || compiled_dependencies.contains(package_name) {
            ()
        } else {
            let compiled = compile_package_command(
                graph,
                context.graph.module_dir,
                package_name,
                dependency_root,
                dependency_root,
                "build",
                compiler_world_path(context),
            )?;
            commands.push(compiled);
            compiled_dependencies[package_name] = true;
        }
    };
    let compiled = compile_test_package_command(
        graph,
        context.graph.module_dir,
        graph.entry_package,
        dependency_root,
        output_root,
        compiled_dependencies.contains(graph.entry_package),
        compiler_world_path(context),
    )?;
    commands.push(compiled);
    Result::Ok(())
}

fn append_test_group(
    context: Context,
    graphs: Vec[Graph],
    dependency_root: string,
    output_root: string,
    kind: string,
    packages: Vec[string],
    commands: Vec[Command],
    groups: Vec[TestGroup],
) -> unit {
    let test_packages: HashMap[string, bool] = HashMap::{};
    for graph in graphs {
        test_packages[graph.entry_package] = true;
    };
    let input_cores: Vec[string] = Vec::[];
    let added: HashMap[string, bool] = HashMap::{};
    for package_name in context.graph.order {
        let root = if test_packages.contains(package_name) {
            output_root
        } else {
            dependency_root
        };
        input_cores.push(
            module_relative(
                context.graph.module_dir,
                extension(package_artifact_base(root, context.graph, package_name), "core"),
            ),
        );
        added[package_name] = true;
    };
    for graph in graphs {
        for package_name in graph.order {
            if added.contains(package_name) {
                ()
            } else {
                let root = if test_packages.contains(package_name) {
                    output_root
                } else {
                    dependency_root
                };
                input_cores.push(
                    module_relative(
                        context.graph.module_dir,
                        extension(package_artifact_base(root, graph, package_name), "core"),
                    ),
                );
                added[package_name] = true;
            }
        }
    };
    let main_go = path::join(output_root, "goml_generated.go");
    let manifest = path::join(output_root, "tests.json");
    commands.push(
        Command::TestLink {
            input_cores,
            packages,
            output: module_relative(context.graph.module_dir, main_go),
            manifest: module_relative(context.graph.module_dir, manifest),
            world: compiler_world_path(context),
        },
    );
    let runner = path::join(output_root, "runner");
    commands.push(
        Command::GoBuild {
            input: module_relative(context.graph.module_dir, main_go),
            output: module_relative(context.graph.module_dir, runner),
        },
    );
    groups.push(TestGroup { kind, manifest, runner });
}

pub fn test_plan(context: Context, kind: string) -> Result[Plan, string] {
    let dependency_root = path::join(path::join(context.artifact_root, "test"), "base");
    let commands = compile_commands(context, dependency_root, "build", "build", context.graph.order)?;
    let compiled_dependencies: HashMap[string, bool] = HashMap::{};
    for package_name in context.graph.order {
        compiled_dependencies[package_name] = true;
    };
    let groups: Vec[TestGroup] = Vec::[];
    let internal: Vec[Graph] = if kind == "internal" || kind == "all" {
        internal_test_graphs(context)?
    } else {
        Vec::[]
    };
    let internal_root = path::join(path::join(context.artifact_root, "test"), "internal");
    let internal_graphs: Vec[Graph] = Vec::[];
    let internal_packages: Vec[string] = Vec::[];
    for graph in internal {
        let package_name = graph.entry_package;
        match append_test_package(
            context,
            graph,
            dependency_root,
            internal_root,
            compiled_dependencies,
            commands,
        ) {
            Ok(()) => {
                internal_graphs.push(graph);
                internal_packages.push(package_name)
            },
            Err(message) => return Result::Err(message),
        }
    };
    if !internal_graphs.is_empty() {
        append_test_group(
            context,
            internal_graphs,
            dependency_root,
            internal_root,
            "internal",
            internal_packages,
            commands,
            groups,
        )
    } else {
        ()
    };
    let external: Vec[ExternalTest] = if kind == "external" || kind == "all" {
        external_test_graphs(context)?
    } else {
        Vec::[]
    };
    let external_root = path::join(path::join(context.artifact_root, "test"), "external");
    let external_graphs: Vec[Graph] = Vec::[];
    let external_packages: Vec[string] = Vec::[];
    for test in external {
        let package_name = test.graph.entry_package;
        match append_test_package(
            context,
            test.graph,
            dependency_root,
            external_root,
            compiled_dependencies,
            commands,
        ) {
            Ok(()) => {
                external_graphs.push(test.graph);
                external_packages.push(package_name);
                external_packages.push(test.target_package)
            },
            Err(message) => return Result::Err(message),
        }
    };
    if !external_graphs.is_empty() {
        append_test_group(
            context,
            external_graphs,
            dependency_root,
            external_root,
            "external",
            external_packages,
            commands,
            groups,
        )
    } else {
        ()
    };
    Result::Ok(
        Plan {
            commands: commands_with_world(context, commands),
            executable: Option::None,
            test_groups: groups,
        },
    )
}

fn display_args(program: string, args: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(program);
    for argument in args {
        builder.write_char(' ');
        builder.write_string(util::shell_escape(argument))
    };
    builder.finish()
}

fn command_args(value: Command) -> (string, Vec[string]) {
    match value {
        PrepareWorld { output } => ("gomlc", Vec::["prepare-world", "--output", output]),
        Compile { subcommand, package_name, input_files, interface_files, output, world } => {
            let args: Vec[string] = Vec::[];
            args.push(subcommand);
            args.push("--package");
            args.push(package_name);
            for input in input_files {
                args.push("--input");
                args.push(input)
            };
            for interface in interface_files {
                args.push("--interface-path");
                args.push(interface)
            };
            args.push("--output");
            args.push(output);
            match world {
                Some(value) => {
                    args.push("--world");
                    args.push(value)
                },
                None => (),
            };
            ("gomlc", args)
        },
        Link { input_cores, entry_package, output, world } => {
            let args: Vec[string] = Vec::[];
            args.push("link");
            args.push("--input");
            for input in input_cores {
                args.push(input)
            };
            args.push("--output");
            args.push(output);
            args.push("--entry");
            args.push(entry_package);
            match world {
                Some(value) => {
                    args.push("--world");
                    args.push(value)
                },
                None => (),
            };
            ("gomlc", args)
        },
        TestLink { input_cores, packages, output, manifest, world } => {
            let args: Vec[string] = Vec::[];
            args.push("test-link");
            args.push("--input");
            for input in input_cores {
                args.push(input)
            };
            args.push("--output");
            args.push(output);
            args.push("--manifest");
            args.push(manifest);
            for package_name in packages {
                args.push("--package");
                args.push(package_name)
            };
            match world {
                Some(value) => {
                    args.push("--world");
                    args.push(value)
                },
                None => (),
            };
            ("gomlc", args)
        },
        GoBuild { input, output } => ("go", Vec::["build", "-o", output, input]),
    }
}

pub fn display_command(value: Command) -> string {
    let command = command_args(value);
    display_args(command.0, command.1)
}

fn progress_label(value: Command) -> string {
    match value {
        PrepareWorld { .. } => "preparing compiler world",
        Compile { subcommand, package_name, .. } => if subcommand == "check" {
            f"checking {package_name}"
        } else if subcommand == "build" {
            f"compiling {package_name}"
        } else if subcommand == "test-check" {
            f"checking tests for {package_name}"
        } else if subcommand == "test-build" {
            f"compiling tests for {package_name}"
        } else {
            f"{subcommand} {package_name}"
        },
        Link { entry_package, .. } => f"linking {entry_package}",
        TestLink { .. } => "linking test runner",
        GoBuild { .. } => "building executable",
    }
}

fn ensure_output_parent(value: Command, module_dir: string) -> Result[unit, string] {
    let output = match value {
        PrepareWorld { output } | Compile { output, .. } | Link { output, .. } | TestLink {
            output,
            ..,
        } | GoBuild { output, .. } => output,
    };
    let absolute = if path::is_absolute(output) {
        output
    } else {
        path::join(module_dir, output)
    };
    match path::parent(absolute) {
        Some(parent) => fs::create_dir_all(parent),
        None => Result::Ok(()),
    }
}

fn execute_command(context: Context, value: Command) -> Result[unit, string] {
    ensure_output_parent(value, context.graph.module_dir)?;
    let command = command_args(value);
    let program = if command.0 == "gomlc" {
        context.compiler
    } else {
        command.0
    };
    let process = process::Command::new(program).args(command.1).current_dir(
        context.graph.module_dir,
    );
    if command.0 == "go" {
        let _ = process.env("GOWORK", "off");
        let _ = process.env("GO111MODULE", "off");
    } else {
        ()
    };
    match process.status() {
        Ok(status) => if process::ExitStatus::success(status) {
            Result::Ok(())
        } else {
            Result::Err(f"{display_command(value)} failed")
        },
        Err(message) => Result::Err(message),
    }
}

struct PreparedCache {
    spec: CacheSpec,
    fingerprint: string,
}

enum CachePreparation {
    Fresh,
    Execute(Option[PreparedCache]),
}

fn prepare_cached_command(
    digests: DigestCache,
    context: Context,
    command: Command,
    identity: string,
) -> Result[CachePreparation, string] {
    match cache_spec(command) {
        Some(spec) => {
            let fingerprint = command_fingerprint(digests, context, identity, spec)?;
            let fresh = cache_is_fresh(digests, context, spec, fingerprint)?;
            if fresh {
                Result::Ok(CachePreparation::Fresh)
            } else {
                invalidate_output_digests(digests, context.graph.module_dir, spec.outputs);
                prepare_cache_execution(context, spec)?;
                Result::Ok(
                    CachePreparation::Execute(Option::Some(PreparedCache { spec, fingerprint })),
                )
            }
        },
        None => Result::Ok(CachePreparation::Execute(Option::None)),
    }
}

fn execute_prepared_command(context: Context, command: Command, cache: Option[PreparedCache]) -> Result[
    unit,
    string,
] {
    match execute_command(context, command) {
        Ok(()) => Result::Ok(()),
        Err(message) => {
            match cache {
                Some(value) => {
                    let _ = prepare_cache_execution(context, value.spec);
                },
                None => (),
            };
            Result::Err(message)
        },
    }
}

fn finish_prepared_command(
    digests: DigestCache,
    context: Context,
    identity: string,
    cache: Option[PreparedCache],
) -> Result[unit, string] {
    match cache {
        Some(value) => store_cache(digests, context, value.spec, identity, value.fingerprint),
        None => Result::Ok(()),
    }
}

fn discard_prepared_command(digests: DigestCache, context: Context, cache: Option[PreparedCache]) -> unit {
    match cache {
        Some(value) => {
            invalidate_output_digests(digests, context.graph.module_dir, value.spec.outputs);
            let _ = prepare_cache_execution(context, value.spec);
        },
        None => (),
    }
}

fn build_graph(commands: Vec[Command]) -> Result[BuildGraph, string] {
    let producers: HashMap[string, Vec[int]] = HashMap::{};
    for index in 0..commands.len() {
        match cache_spec(commands[index]) {
            Some(spec) => for output in spec.outputs {
                match producers[output] {
                    Some(values) => values.push(index),
                    None => producers.set(output, Vec::[index]),
                }
            },
            None => (),
        }
    };
    let result: Vec[BuildNode] = Vec::[];
    for index in 0..commands.len() {
        let command = commands[index];
        let dependencies: Vec[int] = Vec::[];
        match cache_spec(command) {
            Some(spec) => {
                for input in spec.inputs {
                    let mut previous = -1;
                    let mut following = -1;
                    match producers[input] {
                        Some(values) => for candidate in values {
                            if candidate < index && candidate > previous {
                                previous = candidate;
                            } else if candidate > index && following < 0 {
                                following = candidate;
                            } else {
                                ()
                            }
                        },
                        None => (),
                    };
                    let producer = if previous >= 0 {
                        previous
                    } else {
                        following
                    };
                    if producer >= 0 && !collections::contains(dependencies, producer) {
                        dependencies.push(producer)
                    } else {
                        ()
                    }
                };
                for output in spec.outputs {
                    let mut previous = -1;
                    match producers[output] {
                        Some(values) => for candidate in values {
                            if candidate < index && candidate > previous {
                                previous = candidate;
                            } else {
                                ()
                            }
                        },
                        None => (),
                    };
                    if previous >= 0 && !collections::contains(dependencies, previous) {
                        dependencies.push(previous)
                    } else {
                        ()
                    }
                }
            },
            None => (),
        };
        result.push(BuildNode { index, command, dependencies })
    };
    Result::Ok(BuildGraph { nodes: result })
}

fn build_node(nodes: Vec[BuildNode], index: int) -> Option[BuildNode] {
    if index >= 0 && index < nodes.len() {
        Option::Some(nodes[index])
    } else {
        Option::None
    }
}

fn build_node_ready(node: BuildNode, completed: Vec[int]) -> bool {
    for dependency in node.dependencies {
        if !collections::contains(completed, dependency) {
            return false
        } else {
            ()
        }
    };
    true
}

struct BuildWork {
    index: int,
    command: Command,
    cache: Option[PreparedCache],
}

struct BuildWorkResult {
    index: int,
    cache: Option[PreparedCache],
    result: Result[unit, string],
}

fn execute_plan_worker(
    context: Context,
    work: Channel[BuildWork],
    results: Channel[BuildWorkResult],
) -> unit {
    loop {
        match work.recv() {
            Some(value) => results.send(
                BuildWorkResult {
                    index: value.index,
                    cache: value.cache,
                    result: execute_prepared_command(context, value.command, value.cache),
                },
            ),
            None => break,
        }
    }
}

pub fn execute_plan(context: Context, plan: Plan, dry_run: bool, jobs: int) -> Result[unit, string] {
    if !dry_run && jobs < 1 {
        return Result::Err("build jobs must be greater than zero")
    } else {
        ()
    };
    let total = plan.commands.len();
    let mut completed = 0;
    let identity = if dry_run {
        ""
    } else {
        compiler_digest(context)?
    };
    if dry_run {
        for command in plan.commands {
            io::println(display_command(command))
        }
    } else {
        let graph = build_graph(plan.commands)?;
        let digests = digest_cache();
        let initial: Vec[int] = Vec::[];
        for node in graph.nodes {
            initial.push(node.index)
        };
        let mut pending = initial;
        let completed_nodes: Vec[int] = Vec::[];
        let mut running = 0;
        let worker_count = if jobs < total {
            jobs
        } else {
            total
        };
        let work: Channel[BuildWork] = Channel::new(total);
        let results: Channel[BuildWorkResult] = Channel::new(total);
        for _ in 0..worker_count {
            go || execute_plan_worker(context, work, results)
        };
        while !pending.is_empty() || running > 0 {
            let blocked: Vec[int] = Vec::[];
            for index in pending {
                let Some(node) = build_node(graph.nodes, index) else {
                    return Result::Err(f"build graph omitted node {index}")
                };
                if running < worker_count && !build_node_ready(node, completed_nodes) {
                    blocked.push(index)
                } else if running < worker_count {
                    util::display_progress(completed, total, progress_label(node.command), false);
                    match prepare_cached_command(digests, context, node.command, identity) {
                        Ok(Fresh) => {
                            completed_nodes.push(node.index);
                            completed += 1;
                        },
                        Ok(Execute(cache)) => {
                            work.send(BuildWork { index: node.index, command: node.command, cache });
                            running += 1;
                        },
                        Err(message) => {
                            work.close();
                            for _ in 0..running {
                                match results.recv() {
                                    Some(value) => {
                                        discard_prepared_command(digests, context, value.cache)
                                    },
                                    None => (),
                                }
                            };
                            results.close();
                            return Result::Err(message)
                        },
                    }
                } else {
                    blocked.push(index)
                }
            };
            pending = blocked;
            if running == 0 && !pending.is_empty() {
                work.close();
                results.close();
                return Result::Err("build plan contains a dependency cycle")
            } else {
                ()
            };
            if running > 0 {
                match results.recv() {
                    Some(value) => match value.result {
                        Ok(()) => match finish_prepared_command(
                            digests,
                            context,
                            identity,
                            value.cache,
                        ) {
                            Ok(()) => {
                                completed_nodes.push(value.index);
                                completed += 1;
                            },
                            Err(message) => {
                                completed += 1;
                                running -= 1;
                                work.close();
                                for _ in 0..running {
                                    match results.recv() {
                                        Some(other) => {
                                            discard_prepared_command(digests, context, other.cache)
                                        },
                                        None => (),
                                    }
                                };
                                results.close();
                                return Result::Err(message)
                            },
                        },
                        Err(message) => {
                            completed += 1;
                            running -= 1;
                            work.close();
                            for _ in 0..running {
                                match results.recv() {
                                    Some(_) => (),
                                    None => (),
                                }
                            };
                            results.close();
                            return Result::Err(message)
                        },
                    },
                    None => return Result::Err("build result channel closed early"),
                };
                running -= 1;
            } else {
                ()
            }
        };
        work.close();
        results.close()
    };
    if dry_run {
        ()
    } else {
        util::display_progress(completed, total, "finished", true)
    };
    Result::Ok(())
}

pub fn run_executable(context: Context, executable: string, args: Vec[string], dry_run: bool) -> Result[
    unit,
    string,
] {
    let relative = module_relative(context.graph.module_dir, executable);
    if dry_run {
        io::println(display_args(relative, args));
        Result::Ok(())
    } else {
        match process::Command::new(executable).args(args).current_dir(context.graph.module_dir).status() {
            Ok(status) => if process::ExitStatus::success(status) {
                Result::Ok(())
            } else {
                match process::ExitStatus::code(status) {
                    Some(code) => Result::Err(f"program exited with status {code}"),
                    None => Result::Err("program terminated by signal"),
                }
            },
            Err(message) => Result::Err(message),
        }
    }
}
