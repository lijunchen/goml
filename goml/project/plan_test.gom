package project;

use std::testing;

fn compile_command(
    name: string,
    interface_files: Vec[string],
    output: string,
) -> Command {
    Command::Compile {
        subcommand: "build",
        package_name: name,
        input_files: Vec::new().pushed(name + ".gom"),
        interface_files,
        output,
    }
}

#[test]
fn build_graph_tracks_compile_link_and_go_dependencies() -> unit {
    let commands = Vec::new()
        .pushed(compile_command("a", Vec::new(), "out/a"))
        .pushed(compile_command(
            "b",
            Vec::new().pushed("out/a.interface"),
            "out/b",
        ))
        .pushed(Command::Link {
            input_cores: Vec::new()
                .pushed("out/a.core")
                .pushed("out/b.core"),
            output: "out/main.go",
            entry_package: "b",
        })
        .pushed(Command::GoBuild {
            input: "out/main.go",
            output: "out/main",
        });
    let graph = match build_graph(commands) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    testing::assert_eq(graph.nodes.len(), 4);
    testing::assert_eq(graph.nodes.get(0).dependencies.len(), 0);
    testing::assert_eq(graph.nodes.get(1).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(1).dependencies.get(0), 0);
    testing::assert_eq(graph.nodes.get(2).dependencies.len(), 2);
    testing::assert_eq(graph.nodes.get(2).dependencies.get(0), 0);
    testing::assert_eq(graph.nodes.get(2).dependencies.get(1), 1);
    testing::assert_eq(graph.nodes.get(3).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(3).dependencies.get(0), 2)
}

#[test]
fn build_graph_serializes_duplicate_outputs() -> unit {
    let graph = match build_graph(
        Vec::new()
            .pushed(compile_command("a", Vec::new(), "out/shared"))
            .pushed(compile_command("b", Vec::new(), "out/shared")),
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    testing::assert_eq(graph.nodes.get(0).dependencies.len(), 0);
    testing::assert_eq(graph.nodes.get(1).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(1).dependencies.get(0), 0)
}

#[test]
fn build_graph_exposes_dependency_cycles() -> unit {
    let graph = match build_graph(
        Vec::new()
            .pushed(compile_command(
                "a",
                Vec::new().pushed("out/b.interface"),
                "out/a",
            ))
            .pushed(compile_command(
                "b",
                Vec::new().pushed("out/a.interface"),
                "out/b",
            )),
    ) {
        Result::Ok(value) => value,
        Result::Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    let pending = Vec::new().pushed(0).pushed(1);
    testing::assert(!build_node_ready(graph.nodes.get(0), pending));
    testing::assert(!build_node_ready(graph.nodes.get(1), pending))
}
