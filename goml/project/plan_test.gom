package project;

use std::testing;

#[test]
fn derives_unicode_package_names_from_directories() -> unit {
    match package_name_for_directory("/tmp/项目", "alice::app", "/tmp/项目/工具/解析") {
        Ok(value) => testing::assert_eq(value, "alice::app::工具::解析"),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn displays_commands_with_unicode_and_quoted_arguments() -> unit {
    testing::assert_eq(
        display_command(Command::GoBuild { input: "源 code/main.go", output: "输出's app" }),
        "go build -o '输出'\\''s app' '源 code/main.go'",
    )
}

fn compile_command(name: string, interface_files: Vec[string], output: string) -> Command {
    Command::Compile {
        subcommand: "build",
        package_name: name,
        input_files: Vec::new().pushed(name + ".gom"),
        interface_files,
        output,
        world: Option::None,
    }
}

#[test]
fn build_graph_tracks_compile_link_and_go_dependencies() -> unit {
    let commands = Vec::new().pushed(compile_command("a", Vec::new(), "out/a")).pushed(
        compile_command("b", Vec::new().pushed("out/a.interface"), "out/b"),
    ).pushed(
        Command::Link {
            input_cores: Vec::new().pushed("out/a.core").pushed("out/b.core"),
            output: "out/main.go",
            entry_package: "b",
            world: Option::None,
        },
    ).pushed(Command::GoBuild { input: "out/main.go", output: "out/main" });
    let graph = match build_graph(commands) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    testing::assert_eq(graph.nodes.len(), 4);
    testing::assert_eq(graph.nodes.get(0).dependencies.len(), 0);
    testing::assert_eq(graph.nodes.get(1).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(1).dependencies.get(0), 0);
    testing::assert_eq(graph.nodes.get(2).dependencies.len(), 2);
    testing::assert_eq(graph.nodes.get(2).dependencies.get(0), 0);
    testing::assert_eq(graph.nodes.get(2).dependencies.get(1), 1);
    testing::assert_eq(graph.nodes.get(3).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(3).dependencies.get(0), 2)
}

#[test]
fn build_graph_tracks_compiler_world_dependencies() -> unit {
    let world = "out/compiler/world-v1.gaf";
    let command = Command::Compile {
        subcommand: "check",
        package_name: "a",
        input_files: Vec::new().pushed("a.gom"),
        interface_files: Vec::new(),
        output: "out/a",
        world: Option::Some(world),
    };
    let graph = match build_graph(
        Vec::new().pushed(Command::PrepareWorld { output: world }).pushed(command),
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    testing::assert_eq(graph.nodes.get(0).dependencies.len(), 0);
    testing::assert_eq(graph.nodes.get(1).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(1).dependencies.get(0), 0)
}

#[test]
fn build_graph_serializes_duplicate_outputs() -> unit {
    let graph = match build_graph(
        Vec::new().pushed(compile_command("a", Vec::new(), "out/shared")).pushed(
            compile_command("b", Vec::new(), "out/shared"),
        ),
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    testing::assert_eq(graph.nodes.get(0).dependencies.len(), 0);
    testing::assert_eq(graph.nodes.get(1).dependencies.len(), 1);
    testing::assert_eq(graph.nodes.get(1).dependencies.get(0), 0)
}

#[test]
fn build_graph_exposes_dependency_cycles() -> unit {
    let graph = match build_graph(
        Vec::new().pushed(compile_command("a", Vec::new().pushed("out/b.interface"), "out/a")).pushed(
            compile_command("b", Vec::new().pushed("out/a.interface"), "out/b"),
        ),
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            BuildGraph { nodes: Vec::new() }
        },
    };
    let completed = Vec::new();
    testing::assert(!build_node_ready(graph.nodes.get(0), completed));
    testing::assert(!build_node_ready(graph.nodes.get(1), completed))
}
