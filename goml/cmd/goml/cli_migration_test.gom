#[test]
fn project_check_checks_module_from_cwd() -> unit {
    let root = test_support::workspace("check_from_cwd");
    test_support::write_basic_project(root, "demo");
    test_support::write_file(
        path::join(root, "lib/lib.gom"),
        "package lib;\npub fn value() -> int32 { 1 }\n",
    );
    test_support::assert_success(
        test_support::project_command("check", "", Vec::new(), path::join(root, "lib")),
    );
    testing::assert(fs::is_file(path::join(root, "_artifact/check/pkg/demo/demo.interface")));
    testing::assert(fs::is_file(path::join(root, "_artifact/check/pkg/demo/lib/lib.interface")))
}

#[test]
fn project_check_resolves_compiler_from_path() -> unit {
    let root = test_support::workspace("compiler_from_path");
    test_support::write_basic_project(root, "demo");
    let compiler_dir = match path::parent(test_support::gomlc_binary()) {
        Some(value) => value,
        None => {
            testing::fail("compiler path has no parent");
            root
        },
    };
    let output = match process::Command::new(test_support::goml_binary()).arg("check").current_dir(
        root,
    ).env("PATH", compiler_dir).output() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            test_support::run(Vec::["version"], root)
        },
    };
    test_support::assert_success(output);
    testing::assert(fs::is_file(path::join(root, "_artifact/check/pkg/demo/demo.interface")))
}

