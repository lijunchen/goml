#[test]
fn home_creates_and_prints_the_layout() -> unit {
    let root = test_support::workspace("home_command");
    let home = path::join(root, "home");
    let output = match process::Command::new(test_support::goml_binary()).arg("home").env(
        "GOML_HOME",
        home,
    ).current_dir(root).output() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            process::Output {
                status_value: process::ExitStatus { code_value: -1 },
                stdout_value: bytes::Bytes::new(),
                stderr_value: bytes::Bytes::new(),
            }
        },
    };
    test_support::assert_success(output);
    test_support::assert_contains(test_support::stdout(output), "GOML_HOME=" + home);
    testing::assert(fs::is_dir(path::join(home, "bin")));
    testing::assert(fs::is_dir(path::join(home, "lib")));
    testing::assert(fs::is_dir(path::join(home, "cache")))
}

fn registry_command(program: string, arguments: Vec[string], directory: string) -> unit {
    let output = match process::Command::new(program).args(arguments).current_dir(directory).output() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return
        },
    };
    test_support::assert_success(output)
}

fn local_registry(root: string) -> string {
    let registry = path::join(root, "registry");
    test_support::write_file(
        path::join(registry, "index.toml"),
        "[modules.\"alice::http\"]\nlatest = \"1.2.0\"\nversions = [\"1.0.0\", \"1.2.0\"]\n\n[modules.\"alice::appdep\"]\nlatest = \"0.1.0\"\nversions = [\"0.1.0\"]\n",
    );
    test_support::write_file(
        path::join(registry, "alice/http/1.0.0/goml.toml"),
        "[module]\npath = \"alice::http\"\n",
    );
    test_support::write_file(
        path::join(registry, "alice/http/1.0.0/lib.gom"),
        "package http;\npub fn version() -> string { \"1.0.0\" }\n",
    );
    test_support::write_file(
        path::join(registry, "alice/http/1.2.0/goml.toml"),
        "[module]\npath = \"alice::http\"\n",
    );
    test_support::write_file(
        path::join(registry, "alice/http/1.2.0/lib.gom"),
        "package http;\npub fn version() -> string { \"1.2.0\" }\n",
    );
    test_support::write_file(
        path::join(registry, "alice/appdep/0.1.0/goml.toml"),
        "[module]\npath = \"alice::appdep\"\n\n[dependencies]\n\"alice::http\" = \"1.2.0\"\n",
    );
    test_support::write_file(
        path::join(registry, "alice/appdep/0.1.0/lib.gom"),
        "package appdep;\npub fn marker() -> string { \"appdep\" }\n",
    );
    registry_command("git", Vec::["init"], registry);
    registry_command(
        "git",
        Vec::["-c", "user.name=goml", "-c", "user.email=goml@example.invalid", "add", "."],
        registry,
    );
    registry_command(
        "git",
        Vec::[
            "-c",
            "user.name=goml",
            "-c",
            "user.email=goml@example.invalid",
            "commit",
            "--allow-empty",
            "-m",
            "registry",
        ],
        registry,
    );
    registry
}

fn run_with_home(arguments: Vec[string], directory: string, home: string) -> process::Output {
    match process::Command::new(test_support::goml_binary()).args(arguments).env("GOML_HOME", home).current_dir(
        directory,
    ).output() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            process::Output {
                status_value: process::ExitStatus { code_value: -1 },
                stdout_value: bytes::Bytes::new(),
                stderr_value: bytes::Bytes::new(),
            }
        },
    }
}

#[test]
fn registry_commands_update_add_and_remove() -> unit {
    let root = test_support::workspace("registry_commands");
    let registry = local_registry(root);
    let home = path::join(root, "home");
    let updated = run_with_home(Vec::["update", "--local-registry", registry], root, home);
    test_support::assert_success(updated);
    testing::assert(fs::is_file(path::join(home, "cache/registry/index.toml")));
    let project = path::join(root, "project");
    test_support::write_basic_project(project, "demo");
    let added = run_with_home(
        Vec::["add", "alice::http", "--local-registry", registry],
        project,
        home,
    );
    test_support::assert_success(added);
    test_support::assert_contains(
        test_support::read_file(path::join(project, "goml.toml")),
        "\"alice::http\" = \"1.2.0\"",
    );
    let removed = run_with_home(
        Vec::["remove", "alice::http", "--local-registry", registry],
        project,
        home,
    );
    test_support::assert_success(removed);
    test_support::assert_not_contains(
        test_support::read_file(path::join(project, "goml.toml")),
        "alice::http",
    )
}

#[test]
fn cached_registry_dependencies_build_with_mvs_layout() -> unit {
    let root = test_support::workspace("registry_dependency_build");
    let registry = local_registry(root);
    let home = path::join(root, "home");
    test_support::assert_success(
        run_with_home(Vec::["update", "--local-registry", registry], root, home),
    );
    let project = path::join(root, "project");
    test_support::write_file(
        path::join(project, "goml.toml"),
        "[module]\npath = \"demo\"\n\n[dependencies]\n\"alice::http\" = \"1.0.0\"\n\"alice::appdep\" = \"0.1.0\"\n",
    );
    test_support::write_file(
        path::join(project, "main.gom"),
        "package main;\nuse alice::http;\nuse alice::appdep;\nfn main() -> unit { println(http::version() + \":\" + appdep::marker()) }\n",
    );
    let built = run_with_home(
        Vec::["build", "--compiler", test_support::gomlc_binary()],
        project,
        home,
    );
    test_support::assert_success(built);
    testing::assert(
        fs::is_file(
            path::join(project, "_artifact/build/deps/alice/http/1.2.0/pkg/alice/http/http.core"),
        ),
    );
    let execution = match process::Command::new(path::join(project, "_artifact/bin/demo")).output() {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            built
        },
    };
    test_support::assert_success(execution);
    testing::assert_eq(test_support::stdout(execution), "1.2.0:appdep\n")
}
