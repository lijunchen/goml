#[test]
fn project_uses_manifest_and_cli_target_directories() -> unit {
    let root = test_support::workspace("target_directories");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n\n[build]\ntarget-dir = \"out/generated\"\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nfn main() -> unit { println(\"hello\") }\n",
    );
    test_support::assert_success(migration_build(root));
    testing::assert(fs::is_file(path::join(root, "out/generated/build/pkg/demo/goml_generated.go")));
    testing::assert(fs::is_file(path::join(root, "out/generated/bin/demo")));
    let override_output = test_support::project_command(
        "check",
        "",
        Vec::["--target-dir", "cli output"],
        root,
    );
    test_support::assert_success(override_output);
    testing::assert(fs::is_file(path::join(root, "cli output/check/pkg/demo/demo.interface")))
}

#[test]
fn project_clean_removes_only_module_artifacts() -> unit {
    let root = test_support::workspace("clean_artifacts");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n\n[build]\ntarget-dir = \"out/generated\"\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nfn main() -> unit {}\n",
    );
    let nested = path::join(root, "src");
    test_support::create_dir(nested);
    let artifact_root = path::join(root, "out/generated");
    test_support::write_file(path::join(artifact_root, "cache/entry"), "cached");
    let override_root = path::join(root, "alternate");
    test_support::write_file(path::join(override_root, "cache/entry"), "cached");
    let override_output = test_support::run(Vec::["clean", "--target-dir", "alternate"], nested);
    test_support::assert_success(override_output);
    testing::assert(!fs::exists(override_root));
    testing::assert(fs::exists(artifact_root));
    let output = test_support::run(Vec::["clean"], nested);
    test_support::assert_success(output);
    testing::assert(!fs::exists(artifact_root));
    testing::assert(fs::is_file(path::join(root, "main.gom")))
}

#[test]
fn project_clean_rejects_module_directory() -> unit {
    let root = test_support::workspace("clean_module_directory");
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"demo\"\n\n[build]\ntarget-dir = \".\"\n",
    );
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nfn main() -> unit {}\n",
    );
    let output = test_support::run(Vec::["clean"], root);
    test_support::assert_failure(output);
    test_support::assert_contains(
        test_support::stderr(output),
        "clean target must stay inside the module",
    );
    testing::assert(fs::is_file(path::join(root, "main.gom")))
}

