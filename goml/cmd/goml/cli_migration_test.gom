#[test]
fn project_build_links_every_main_package() -> unit {
    let root = test_support::workspace("multiple_main_packages");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"alice::app\"\n");
    test_support::write_file(
        path::join(root, "pkg/pkg.gom"),
        "package pkg;\npub fn value() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "cmd/server/main.gom"),
        "package main;\nuse alice::app::pkg;\nfn main() -> unit { println(pkg::value().to_string()) }\n",
    );
    test_support::write_file(
        path::join(root, "cmd/client/main.gom"),
        "package main;\nfn main() -> unit { println(\"client\") }\n",
    );
    test_support::assert_success(migration_build(root));
    testing::assert(fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/pkg/pkg.core")));
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/pkg/pkg.interface")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/server/server.core")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/server/server.interface")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/server/goml_generated.go")),
    );
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/alice/app/cmd/client/goml_generated.go")),
    );
    let dry_run = test_support::project_command("build", "", Vec::["--dry-run"], root);
    test_support::assert_success(dry_run);
    test_support::assert_contains(
        test_support::stdout(dry_run),
        "gomlc link --input _artifact/build/pkg/alice/app/cmd/client/client.core --output _artifact/build/pkg/alice/app/cmd/client/goml_generated.go --entry alice::app::cmd::client",
    );
    let rejected = test_support::run(
        Vec::["build", "cmd/server", "--compiler", test_support::gomlc_binary()],
        root,
    );
    test_support::assert_failure(rejected);
    test_support::assert_contains(test_support::stderr(rejected), "unexpected argument");
    let rejected = test_support::run(
        Vec::["check", "cmd/server", "--compiler", test_support::gomlc_binary()],
        root,
    );
    test_support::assert_failure(rejected);
    test_support::assert_contains(test_support::stderr(rejected), "unexpected argument")
}

#[test]
fn project_build_and_test_use_safe_generated_go_filename() -> unit {
    let root = test_support::workspace("safe_generated_go_filename");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "compiler_test/main.gom"),
        "package main;\nfn main() -> unit { println(\"ok\") }\n",
    );
    test_support::write_file(
        path::join(root, "compiler_test/main_test.gom"),
        "package main;\nuse std::testing;\n#[test]\nfn safe_name() -> unit { testing::assert(true) }\n",
    );
    test_support::assert_success(migration_build(root));
    testing::assert(
        fs::is_file(path::join(root, "_artifact/build/pkg/demo/compiler_test/goml_generated.go")),
