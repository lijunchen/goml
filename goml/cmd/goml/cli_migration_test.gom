#[test]
fn project_test_runs_private_tests_and_ignores_test_sources_in_check() -> unit {
    let root = test_support::workspace("internal_tests");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "math/math.gom"),
        "package math;\n\nfn double(value: int32) -> int32 { value * 2 }\n\npub fn add(left: int32, right: int32) -> int32 { left + right }\n",
    );
    test_support::write_file(
        path::join(root, "math/math_test.gom"),
        "package math;\n\nuse std::testing;\n\n#[test]\nfn add_works() -> unit { testing::assert_eq(add(2, 3), 5) }\n\n#[test]\nfn private_helper_works() -> unit { testing::assert_eq(double(4), 8) }\n\n#[test]\n#[ignore(\"later\")]\nfn ignored_case() -> unit { testing::assert(true) }\n",
    );
    let check = test_support::project_command("check", "", Vec::["--dry-run"], root);
    test_support::assert_success(check);
    test_support::assert_not_contains(test_support::stdout(check), "math_test.gom");
    let tested = test_support::project_command("test", "", Vec::["--jobs", "2"], root);
    test_support::assert_success(tested);
    let stdout = test_support::stdout(tested);
    test_support::assert_contains(stdout, "demo::math::add_works ... ok");
    test_support::assert_contains(stdout, "demo::math::private_helper_works ... ok");
    test_support::assert_contains(stdout, "2 passed; 0 failed; 1 ignored");
    let stderr = test_support::stderr(tested);
    test_support::assert_contains(stderr, "\r\u001b[2K[--------------------] 0/3 running tests");
    test_support::assert_not_contains(stderr, "0/3 running tests\n");
    test_support::assert_contains(stderr, "\r\u001b[2K[####################] 3/3 finished\n");
    let listed = test_support::project_command("test", "", Vec::["--list"], root);
    test_support::assert_success(listed);
    test_support::assert_contains(test_support::stdout(listed), "demo::math::ignored_case: ignored");
    let included = test_support::project_command("test", "", Vec::["--include-ignored"], root);
    test_support::assert_success(included);
    test_support::assert_contains(test_support::stdout(included), "3 passed; 0 failed; 0 ignored");
    let json = test_support::project_command(
        "test",
        "",
        Vec::["add_works", "--format", "json"],
        root,
    );
    test_support::assert_success(json);
    test_support::assert_contains(
        test_support::stdout(json),
        "{\"event\":\"ok\",\"name\":\"demo::math::add_works\",\"seed\":",
    )
}

#[test]
fn project_commands_validate_incremental_fingerprints_and_outputs() -> unit {
    let root = test_support::workspace("incremental_fingerprints");
    test_support::write_basic_project(root, "demo");
    test_support::assert_success(migration_check(root));
    let artifact = path::join(root, "_artifact/check/pkg/demo/demo.interface");
    let fingerprint = path::join(root, "_artifact/check/pkg/demo/demo.goml-check-fingerprint");
    testing::assert(fs::is_file(artifact));
    testing::assert(fs::is_file(fingerprint));
    let initial = test_support::read_file(fingerprint);
    test_support::assert_success(migration_check(root));
    testing::assert_eq(test_support::read_file(fingerprint), initial);
    match fs::write_bytes(artifact, bytes::Bytes::from_string("corrupt")) {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    };
    test_support::assert_success(migration_check(root));
    let restored = match fs::read_bytes(artifact) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            bytes::Bytes::new()
        },
    };
    testing::assert(restored.len() > 8);
    testing::assert_eq(test_support::read_file(fingerprint), initial);
    match fs::remove_file(artifact) {
        Ok(()) => (),
        Err(message) => testing::fail(message),
    };
    test_support::assert_success(migration_check(root));
    testing::assert(fs::is_file(artifact));
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nfn main() -> unit { println(\"changed\") }\n",
    );
    test_support::assert_success(migration_check(root));
    testing::assert(test_support::read_file(fingerprint) != initial)
}

#[test]
fn sha256_file_handles_streamed_content_and_missing_files() -> unit {
    let root = test_support::workspace("sha256_file");
    let file = path::join(root, "large.txt");
    let builder = text::StringBuilder::with_capacity(160000);
    for _ in 0..10000 {
        builder.write_string("0123456789abcdef")
    }
    test_support::write_file(file, builder.finish());
    match fs::sha256_file(file) {
        Ok(digest) => testing::assert_eq(
            digest,
            "48705161f98666a9d694f3b8e9d1bc5b842fa1ff0e85d710150616c433af9aae",
        ),
        Err(message) => testing::fail(message),
    };
    match fs::sha256_file(path::join(root, "missing.txt")) {
        Ok(_) => testing::fail("missing file produced a digest"),
        Err(_) => (),
    }
}

#[test]
fn project_build_graph_reuses_unaffected_local_cache_nodes() -> unit {
    let root = test_support::workspace("build_graph_local_cache");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nuse demo::left;\n\nfn main() -> unit { let _ = left::value(); () }\n",
    );
    test_support::write_file(
        path::join(root, "left/left.gom"),
        "package left;\n\npub fn value() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "right/right.gom"),
        "package right;\n\npub fn value() -> int32 { 2 }\n",
    );
    test_support::assert_success(migration_check(root));
    let main_fingerprint = path::join(root, "_artifact/check/pkg/demo/demo.goml-check-fingerprint");
    let left_fingerprint = path::join(
        root,
        "_artifact/check/pkg/demo/left/left.goml-check-fingerprint",
    );
    let right_fingerprint = path::join(
        root,
        "_artifact/check/pkg/demo/right/right.goml-check-fingerprint",
    );
    let initial_main = test_support::read_file(main_fingerprint);
    let initial_left = test_support::read_file(left_fingerprint);
    let initial_right = test_support::read_file(right_fingerprint);
    test_support::assert_success(migration_check(root));
    testing::assert_eq(test_support::read_file(main_fingerprint), initial_main);
    testing::assert_eq(test_support::read_file(left_fingerprint), initial_left);
    testing::assert_eq(test_support::read_file(right_fingerprint), initial_right);
    test_support::write_file(
        path::join(root, "left/left.gom"),
        "package left;\n\npub fn value() -> int32 { 3 }\n",
    );
    test_support::assert_success(migration_check(root));
    testing::assert_eq(test_support::read_file(main_fingerprint), initial_main);
    testing::assert(test_support::read_file(left_fingerprint) != initial_left);
    testing::assert_eq(test_support::read_file(right_fingerprint), initial_right)
}

#[test]
fn project_commands_report_build_progress_on_stderr() -> unit {
    let root = test_support::workspace("build_progress");
    test_support::write_basic_project(root, "demo");
    let checked = migration_check(root);
    test_support::assert_success(checked);
    test_support::assert_contains(
        test_support::stderr(checked),
        "\r\u001b[2K[--------------------] 0/2 preparing compiler world",
    );
    test_support::assert_not_contains(
        test_support::stderr(checked),
        "0/2 preparing compiler world\n",
    );
    test_support::assert_contains(
        test_support::stderr(checked),
        "\r\u001b[2K[####################] 2/2 finished\n",
    );
    let built = migration_build(root);
    test_support::assert_success(built);
    test_support::assert_contains(
        test_support::stderr(built),
        "\r\u001b[2K[--------------------] 0/4 preparing compiler world",
    );
    test_support::assert_not_contains(test_support::stderr(built), "0/4 preparing compiler world\n");
    test_support::assert_contains(
        test_support::stderr(built),
        "\r\u001b[2K[####################] 4/4 finished\n",
    );
    let cached = migration_build(root);
    test_support::assert_success(cached);
    test_support::assert_contains(
        test_support::stderr(cached),
        "\r\u001b[2K[####################] 4/4 finished\n",
    );
    let dry_run = test_support::project_command("build", "", Vec::["--dry-run"], root);
    test_support::assert_success(dry_run);
    testing::assert_eq(test_support::stderr(dry_run), "")
}

#[test]
fn project_test_supports_nocapture_and_timeouts() -> unit {
    let root = test_support::workspace("test_timeout");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "checks/checks.gom"),
        "package checks;\npub fn value() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "checks/checks_test.gom"),
        "package checks;\n\nuse std::io;\nuse std::testing;\n\n#[test]\nfn output() -> unit { io::println(\"uncaptured marker\") }\n\n#[test]\nfn seed() -> unit { testing::assert_eq(testing::seed(), 123) }\n\n#[test]\n#[ignore(\"timeout case\")]\nfn timeout() -> unit { while true { () } }\n",
    );
    let captured = test_support::project_command("test", "", Vec::["output"], root);
    test_support::assert_success(captured);
    test_support::assert_not_contains(test_support::stdout(captured), "uncaptured marker");
    let uncaptured = test_support::project_command("test", "", Vec::["output", "--nocapture"], root);
    test_support::assert_success(uncaptured);
    test_support::assert_contains(test_support::stdout(uncaptured), "uncaptured marker");
    let timed_out = test_support::project_command(
        "test",
        "",
        Vec::["timeout", "--ignored", "--timeout", "20ms"],
        root,
    );
    test_support::assert_failure(timed_out);
    test_support::assert_contains(test_support::stdout(timed_out), "FAILED (timed out)");
    let seeded = test_support::project_command(
        "test",
        "",
        Vec::["seed", "--seed", "123", "--format", "json"],
        root,
    );
    test_support::assert_success(seeded);
    test_support::assert_contains(test_support::stdout(seeded), "\"seed\":123");
    let invalid = test_support::project_command(
        "test",
        "",
        Vec::["--nocapture", "--format", "json"],
        root,
    );
    test_support::assert_failure(invalid);
    test_support::assert_contains(
        test_support::stderr(invalid),
        "--nocapture cannot be combined with --format json",
    )
}

#[test]
fn project_test_preserves_selection_order_when_workers_finish_out_of_order() -> unit {
    let root = test_support::workspace("test_output_order");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "checks/checks.gom"),
        "package checks;\npub fn value() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "checks/checks_test.gom"),
        "package checks;\n\nuse std::time;\n\n#[test]\nfn a_slow() -> unit { time::sleep(time::Duration::from_milliseconds(100)) }\n\n#[test]\nfn b_fast() -> unit {}\n",
    );
    let text_output = test_support::project_command("test", "", Vec::["--jobs", "2"], root);
    test_support::assert_success(text_output);
    let text_stdout = test_support::stdout(text_output);
    let Some(text_slow) = text::find(text_stdout, "demo::checks::a_slow ... ok") else {
        testing::fail("text output omitted slow test");
        return
    };
    let Some(text_fast) = text::find(text_stdout, "demo::checks::b_fast ... ok") else {
        testing::fail("text output omitted fast test");
        return
    };
    testing::assert(text_slow < text_fast);
    let json_output = test_support::project_command(
        "test",
        "",
        Vec::["--jobs", "2", "--format", "json"],
        root,
    );
    test_support::assert_success(json_output);
    let json_stdout = test_support::stdout(json_output);
    let Some(json_slow) = text::find(
        json_stdout,
        "{\"event\":\"ok\",\"name\":\"demo::checks::a_slow\",\"seed\":",
    ) else {
        testing::fail("json output omitted slow test");
        return
    };
    let Some(json_fast) = text::find(
        json_stdout,
        "{\"event\":\"ok\",\"name\":\"demo::checks::b_fast\",\"seed\":",
    ) else {
        testing::fail("json output omitted fast test");
        return
    };
    testing::assert(json_slow < json_fast)
}

#[test]
fn project_test_runs_and_aggregates_tests_from_all_packages() -> unit {
    let root = test_support::workspace("all_package_tests");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "a/a.gom"),
        "package a;\npub fn value() -> int32 { 1 }\n",
    );
    test_support::write_file(
        path::join(root, "a/a_test.gom"),
        "package a;\nuse std::testing;\n#[test]\nfn internal_a() -> unit { testing::assert_eq(value(), 1) }\n",
    );
    test_support::write_file(
        path::join(root, "b/b.gom"),
        "package b;\nuse demo::a;\npub fn value() -> int32 { a::value() + 1 }\n",
    );
    test_support::write_file(
        path::join(root, "b/b_test.gom"),
        "package b;\nuse std::testing;\n#[test]\nfn internal_b() -> unit { testing::assert_eq(value(), 2) }\n",
    );
    test_support::write_file(
        path::join(root, "b/tests/b_test.gom"),
        "package tests;\nuse demo::b;\nuse std::testing;\n#[test]\nfn external_b() -> unit { testing::assert_eq(b::value(), 2) }\n",
    );
    let planned = test_support::project_command("test", "", Vec::["--dry-run"], root);
    test_support::assert_success(planned);
    let plan = test_support::stdout(planned);
    test_support::assert_not_contains(plan, "_artifact/check/");
    test_support::assert_contains(
        plan,
        "gomlc build --package demo::a --input a/a.gom --output _artifact/test/base/pkg/demo/a/a",
    );
    test_support::assert_contains(
        plan,
        "gomlc build --package demo::b --input b/b.gom --interface-path _artifact/test/base/pkg/demo/a/a.interface --output _artifact/test/base/pkg/demo/b/b",
    );
    test_support::assert_contains(
        plan,
        "gomlc test-link --input _artifact/test/internal/pkg/demo/a/a.core _artifact/test/internal/pkg/demo/b/b.core",
    );
    test_support::assert_contains(
        plan,
        "go build -o _artifact/test/internal/runner _artifact/test/internal/goml_generated.go",
    );
    let tested = test_support::project_command("test", "", Vec::new(), root);
    test_support::assert_success(tested);
    let stdout = test_support::stdout(tested);
    test_support::assert_contains(stdout, "demo::a::internal_a ... ok");
    test_support::assert_contains(stdout, "demo::b::internal_b ... ok");
    test_support::assert_contains(stdout, "demo::b::tests::external_b ... ok");
    test_support::assert_contains(stdout, "3 passed; 0 failed; 0 ignored")
}

