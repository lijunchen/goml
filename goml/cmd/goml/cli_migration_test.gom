#[test]
fn project_check_and_build_work_for_complex_dependency_fixtures() -> unit {
    let projects = Vec::[
        "project001",
        "project002",
        "project003",
        "project004",
        "project005",
        "project006",
        "project007_trait_impl_orphan_ok",
        "project008_trait_bounds_across_packages",
        "project009_builtin_option_result",
    ];
    for project_name in projects {
        let root = path::join(
            path::join(test_support::repository_root(), "gomlc/testdata/module"),
            project_name,
        );
        let target = path::join(
            path::join(test_support::module_root(), "_artifact/complex-fixtures"),
            project_name,
        );
        let extra = Vec::["--target-dir", target];
        test_support::assert_success(
            test_support::project_command("check", root, extra, test_support::module_root()),
        );
        test_support::assert_success(
            test_support::project_command("build", root, extra, test_support::module_root()),
        )
    }
}

#[test]
fn project_build_stops_when_compiler_subcommand_fails() -> unit {
    let root = test_support::workspace("compiler_failure");
    test_support::write_file(path::join(root, "goml.toml"), "[module]\npath = \"demo\"\n");
    test_support::write_file(
        path::join(root, "main.gom"),
        "package main;\n\nuse demo::A;\n\nfn main() -> unit { println(A::msg()) }\n",
    );
    test_support::write_file(
        path::join(root, "A/A.gom"),
        "package A;\n\npub fn msg() -> string { \"bad\" }\n",
    );
    let output = migration_build(root);
    test_support::assert_failure(output);
    test_support::assert_contains(
        test_support::stderr(output),
        "package name must start with a lowercase letter or `_`",
    )
}

