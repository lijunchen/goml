package main;

use gomlang::bootstrap_goml::test_support;
use std::path;
use std::process;
use std::testing;

fn fmt_status_code(output: process::Output) -> int {
    match process::ExitStatus::code(process::Output::status(output)) {
        Some(value) => value,
        None => -1,
    }
}

fn write_fmt_project(root: string) -> unit {
    test_support::write_file(
        path::join(root, "goml.toml"),
        "[module]\npath = \"fmt_test\"\n\n[build]\ntarget-dir = \"build/output\"\n",
    );
    test_support::write_file(path::join(root, "main.gom"), "package main;\nfn main( )->unit{()}\n");
}

#[test]
fn fmt_formats_module_from_nested_directory() -> unit {
    let root = test_support::workspace("fmt_module");
    write_fmt_project(root);
    let source = path::join(path::join(root, "src"), "lib.gom");
    test_support::write_file(source, "package lib;\npub fn value( )->int{1}\n");
    let test_source = path::join(root, "main_test.gom");
    test_support::write_file(test_source, "package main;\nfn helper( )->unit{()}\n");
    let ignored = Vec::[
        path::join(path::join(root, "build/output"), "invalid.gom"),
        path::join(path::join(root, ".hidden"), "invalid.gom"),
        path::join(path::join(root, "testdata"), "invalid.gom"),
    ];
    for file in ignored {
        test_support::write_file(file, "invalid {")
    };
    let nested_module = path::join(root, "nested");
    test_support::write_file(
        path::join(nested_module, "goml.toml"),
        "[module]\npath = \"nested\"\n",
    );
    test_support::write_file(path::join(nested_module, "invalid.gom"), "invalid {");
    let external_test_source = path::join(path::join(root, "tests"), "main.gom");
    test_support::write_file(
        external_test_source,
        "package tests;\nfn external_helper( )->unit{()}\n",
    );
    let output = test_support::run(Vec::["fmt"], path::join(root, "src"));
    test_support::assert_success(output);
    testing::assert_eq(
        test_support::read_file(path::join(root, "main.gom")),
        "package main;\n\nfn main() -> unit {\n    ()\n}\n",
    );
    testing::assert_eq(
        test_support::read_file(source),
        "package lib;\n\npub fn value() -> int {\n    1\n}\n",
    );
    testing::assert_eq(
        test_support::read_file(test_source),
        "package main;\n\nfn helper() -> unit {\n    ()\n}\n",
    );
    testing::assert_eq(
        test_support::read_file(external_test_source),
        "package tests;\n\nfn external_helper() -> unit {\n    ()\n}\n",
    );
    for file in ignored {
        testing::assert_eq(test_support::read_file(file), "invalid {")
    };
    testing::assert_eq(
        test_support::read_file(path::join(nested_module, "invalid.gom")),
        "invalid {",
    )
}

#[test]
fn fmt_check_reports_differences_without_writing() -> unit {
    let root = test_support::workspace("fmt_check");
    write_fmt_project(root);
    let main = path::join(root, "main.gom");
    let original = test_support::read_file(main);
    let changed = test_support::run(Vec::["fmt", "--check"], root);
    testing::assert_eq(fmt_status_code(changed), 1);
    testing::assert_eq(test_support::read_file(main), original);
    test_support::assert_success(test_support::run(Vec::["fmt"], root));
    test_support::assert_success(test_support::run(Vec::["fmt", "--check"], root))
}

#[test]
fn fmt_does_not_write_when_any_file_is_invalid() -> unit {
    let root = test_support::workspace("fmt_atomic");
    write_fmt_project(root);
    let main = path::join(root, "main.gom");
    let original = test_support::read_file(main);
    test_support::write_file(path::join(root, "invalid.gom"), "package main;\nfn broken( {");
    let output = test_support::run(Vec::["fmt"], root);
    testing::assert_eq(fmt_status_code(output), 2);
    testing::assert_eq(test_support::read_file(main), original)
}

#[test]
fn fmt_reports_missing_formatter() -> unit {
    let root = test_support::workspace("fmt_missing_formatter");
    write_fmt_project(root);
    let missing = path::join(root, "missing-gomlfmt");
    let output = test_support::run(Vec::["fmt", "--formatter", missing], root);
    test_support::assert_failure(output);
    test_support::assert_contains(test_support::stderr(output), "failed to find gomlfmt")
}
