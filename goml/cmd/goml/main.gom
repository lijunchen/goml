package main;

use gomlang::bootstrap_goml::commands;
use gomlang::bootstrap_goml::project;
use gomlang::bootstrap_goml::runner;
use gomlang::bootstrap_goml::util;
use gomlang::bootstrap_goml::version;
use std::env;
use std::io;
use std::process;

struct CliArgs {
    command: string,
    target: string,
    target_dir: Option[string],
    compiler: Option[string],
    dry_run: bool,
    include_tests: bool,
    program_args: Vec[string],
    test_filter: Option[string],
    build_jobs: int,
    test_jobs: int,
    test_list: bool,
    test_ignored: bool,
    test_include_ignored: bool,
    test_json: bool,
    test_nocapture: bool,
    test_timeout_ms: int,
    test_kind: string,
}

struct FmtArgs {
    check: bool,
    formatter: Option[string],
}

fn fail(message: string) -> unit {
    io::eprintln(f"error: {message}");
    process::exit(1)
}

fn top_help() -> string {
    "Usage: goml <COMMAND>\n\nCommands:\n  new\n  check\n  build\n  run\n  test\n  fmt\n  clean\n  update\n  add\n  remove\n  home\n  version\n  help\n\nOptions:\n  -h, --help  Print help"
}

fn command_help(command: string) -> string {
    if command == "new" {
        "Usage: goml new [OPTIONS] <PROJECT_NAME>\n\nOptions:\n      --path <PATH>  [default: .]\n  -h, --help"
    } else if command == "check" {
        "Usage: goml check [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --jobs <JOBS>        [default: 16]\n      --tests\n  -h, --help"
    } else if command == "build" {
        "Usage: goml build [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --jobs <JOBS>        [default: 16]\n  -h, --help"
    } else if command == "run" {
        "Usage: goml run [OPTIONS] [TARGET] [-- <ARGS>...]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --jobs <JOBS>        [default: 16]\n  -h, --help"
    } else if command == "test" {
        "Usage: goml test [OPTIONS] [FILTER]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --list\n      --ignored\n      --include-ignored\n      --nocapture\n      --format <FORMAT>    [default: text] [possible values: text, json]\n      --timeout <TIMEOUT>  [default: 30s]\n      --jobs <JOBS>        [default: 1]\n      --kind <KIND>        [default: all] [possible values: internal, external, all]\n  -h, --help"
    } else if command == "fmt" {
        "Usage: goml fmt [OPTIONS]\n\nOptions:\n      --check                  exit 1 if formatting differs\n      --formatter <FORMATTER>  formatter executable\n  -h, --help"
    } else if command == "clean" {
        "Usage: goml clean [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n  -h, --help"
    } else if command == "update" {
        "Usage: goml update [OPTIONS]\n\nOptions:\n      --local-registry <PATH>\n  -h, --help"
    } else if command == "add" {
        "Usage: goml add [OPTIONS] <DEPENDENCY>\n\nOptions:\n      --local-registry <PATH>\n  -h, --help"
    } else if command == "remove" {
        "Usage: goml remove [OPTIONS] <DEPENDENCY>\n\nOptions:\n      --local-registry <PATH>\n  -h, --help"
    } else {
        top_help()
    }
}

fn inline_value(argument: string, name: string) -> Option[string] {
    let prefix = f"{name}=";
    if argument.starts_with(prefix) {
        Option::Some(argument.byte_slice(prefix.byte_len(), argument.byte_len()))
    } else {
        Option::None
    }
}

fn option_value(args: Vec[string], index: int, argument: string, name: string) -> Result[
    (Option[string], int),
    string,
] {
    if argument == name {
        if index + 1 >= args.len() {
            Result::Err(f"{name} requires a value")
        } else {
            let value = args[index + 1];
            Result::Ok((Option::Some(value), index + 2))
        }
    } else {
        match inline_value(argument, name) {
            Some(value) => {
                if value == "" {
                    Result::Err(f"{name} requires a value")
                } else {
                    Result::Ok((Option::Some(value), index + 1))
                }
            },
            None => Result::Ok((Option::None, index)),
        }
    }
}

fn parse_clean(args: Vec[string]) -> Result[Option[string], string] {
    let mut target_dir: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        let parsed = option_value(args, index, argument, "--target-dir")?;
        index = parsed.1;
        match parsed.0 {
            Some(value) => match target_dir {
                Some(_) => {
                    return Result::Err("--target-dir cannot be repeated")
                },
                None => {
                    target_dir = Option::Some(value);
                },
            },
            None => if argument.starts_with("-") {
                return Result::Err(f"unknown option {argument}")
            } else {
                return Result::Err(f"unexpected argument {argument}")
            },
        }
    };
    Result::Ok(target_dir)
}

fn parse_fmt(args: Vec[string]) -> Result[FmtArgs, string] {
    let mut check = false;
    let mut formatter: Option[string] = Option::None;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if argument == "-h" || argument == "--help" {
            return Result::Err("help")
        } else if argument == "--check" {
            if check {
                return Result::Err("--check cannot be repeated")
            } else {
                check = true;
                index += 1;
            }
        } else {
            let parsed = option_value(args, index, argument, "--formatter")?;
            index = parsed.1;
            match parsed.0 {
                Some(value) => match formatter {
                    Some(_) => {
                        return Result::Err("--formatter cannot be repeated")
                    },
                    None => {
                        formatter = Option::Some(value);
                    },
                },
                None => if argument.starts_with("-") {
                    return Result::Err(f"unknown option {argument}")
                } else {
                    return Result::Err(f"unexpected argument {argument}")
                },
            }
        }
    };
    Result::Ok(FmtArgs { check, formatter })
}

fn parse_duration(value: string) -> Result[int, string] {
    let parts = if value.ends_with("ms") {
        (value.byte_slice(0, value.byte_len() - 2), 1)
    } else if value.ends_with("s") {
        (value.byte_slice(0, value.byte_len() - 1), 1000)
    } else if value.ends_with("m") {
        (value.byte_slice(0, value.byte_len() - 1), 60000)
    } else {
        return Result::Err("duration must end in ms, s, or m")
    };
    let Ok(parsed) = util::parse_positive_int(parts.0) else {
        return Result::Err(f"invalid duration `{value}`")
    };
    let duration = parsed * parts.1;
    if duration / parts.1 != parsed {
        Result::Err("duration is too large")
    } else {
        Result::Ok(duration)
    }
}

fn parse_cli(args: Vec[string]) -> Result[CliArgs, string] {
    if args.len() < 2 {
        return Result::Err(top_help())
    } else {
        ()
    };
    let command = args[1];
    if command != "check" && command != "build" && command != "run" && command != "test" {
        return Result::Err(f"unknown command {command}")
    } else {
        ()
    };
    let targets: Vec[string] = Vec::[];
    let mut target_dir: Option[string] = Option::None;
    let mut compiler: Option[string] = Option::None;
    let flags: HashMap[string, unit] = HashMap::{};
    let program_args: Vec[string] = Vec::[];
    let mut test_filter: Option[string] = Option::None;
    let mut build_jobs = 16;
    let mut test_jobs = 1;
    let test_formats: Vec[string] = Vec::[];
    let mut test_timeout_ms = 30000;
    let mut test_kind = "all";
    let mut trailing = false;
    let mut index = 2;
    while index < args.len() {
        let argument = args[index];
        if trailing {
            if command == "run" {
                program_args.push(argument);
                index += 1;
            } else {
                return Result::Err(f"unexpected argument {argument}")
            }
        } else if argument == "--" {
            trailing = true;
            index += 1;
        } else if argument == "-h" || argument == "--help" {
            io::println(command_help(command));
            process::exit(0)
        } else if argument == "--dry-run" {
            flags[argument] = ();
            index += 1;
        } else if command == "check" && argument == "--tests" {
            flags[argument] = ();
            index += 1;
        } else if command == "test" && argument == "--list" {
            flags[argument] = ();
            index += 1;
        } else if command == "test" && argument == "--ignored" {
            flags[argument] = ();
            index += 1;
        } else if command == "test" && argument == "--include-ignored" {
            flags[argument] = ();
            index += 1;
        } else if command == "test" && argument == "--nocapture" {
            flags[argument] = ();
            index += 1;
        } else {
            let parsed_target_dir = option_value(args, index, argument, "--target-dir")?;
            index = parsed_target_dir.1;
            if parsed_target_dir.0.is_some() {
                if target_dir.is_some() {
                    return Result::Err("--target-dir cannot be repeated")
                } else {
                    target_dir = parsed_target_dir.0;
                }
            } else {
                let parsed_compiler = option_value(args, index, argument, "--compiler")?;
                index = parsed_compiler.1;
                if parsed_compiler.0.is_some() {
                    if compiler.is_some() {
                        return Result::Err("--compiler cannot be repeated")
                    } else {
                        compiler = parsed_compiler.0;
                    }
                } else if command == "test" {
                    let parsed_timeout = option_value(args, index, argument, "--timeout")?;
                    index = parsed_timeout.1;
                    if parsed_timeout.0.is_some() {
                        let value = match parsed_timeout.0 {
                            Some(value) => value,
                            None => "30s",
                        };
                        match parse_duration(value) {
                            Ok(value) => {
                                test_timeout_ms = value;
                            },
                            Err(message) => return Result::Err(message),
                        }
                    } else {
                        let parsed_jobs = option_value(args, index, argument, "--jobs")?;
                        index = parsed_jobs.1;
                        if parsed_jobs.0.is_some() {
                            let value = match parsed_jobs.0 {
                                Some(value) => value,
                                None => "1",
                            };
                            match util::parse_positive_int(value) {
                                Ok(value) => {
                                    test_jobs = value;
                                    build_jobs = value;
                                },
                                Err(message) => return Result::Err(message),
                            }
                        } else {
                            let parsed_kind = option_value(args, index, argument, "--kind")?;
                            index = parsed_kind.1;
                            if parsed_kind.0.is_some() {
                                let value = match parsed_kind.0 {
                                    Some(value) => value,
                                    None => "all",
                                };
                                if value == "internal" || value == "external" || value == "all" {
                                    test_kind = value;
                                } else {
                                    return Result::Err("--kind must be internal, external, or all")
                                }
                            } else {
                                let parsed_format = option_value(args, index, argument, "--format")?;
                                index = parsed_format.1;
                                match parsed_format.0 {
                                    Some(value) => if value == "json" {
                                        test_formats.push(value)
                                    } else if value == "text" {
                                        test_formats.push(value)
                                    } else {
                                        return Result::Err("--format must be text or json")
                                    },
                                    None => if argument.starts_with("-") {
                                        return Result::Err(f"unknown option {argument}")
                                    } else if test_filter.is_some() {
                                        return Result::Err(f"unexpected argument {argument}")
                                    } else {
                                        test_filter = Option::Some(argument);
                                        index += 1;
                                    },
                                }
                            }
                        }
                    }
                } else {
                    let parsed_jobs = option_value(args, index, argument, "--jobs")?;
                    index = parsed_jobs.1;
                    match parsed_jobs.0 {
                        Some(value) => match util::parse_positive_int(value) {
                            Ok(value) => {
                                build_jobs = value;
                            },
                            Err(message) => return Result::Err(message),
                        },
                        None => if argument.starts_with("-") {
                            return Result::Err(f"unknown option {argument}")
                        } else if command == "run" && targets.is_empty() {
                            targets.push(argument);
                            index += 1;
                        } else {
                            return Result::Err(f"unexpected argument {argument}")
                        },
                    }
                }
            }
        }
    };
    let test_json = !test_formats.is_empty() && test_formats[test_formats.len() - 1] == "json";
    if flags.contains("--ignored") && flags.contains("--include-ignored") {
        Result::Err("--ignored cannot be combined with --include-ignored")
    } else if test_json && flags.contains("--nocapture") {
        Result::Err("--nocapture cannot be combined with --format json")
    } else {
        Result::Ok(
            CliArgs {
                command,
                target: if !targets.is_empty() {
                    targets[0]
                } else {
                    "."
                },
                target_dir,
                compiler,
                dry_run: flags.contains("--dry-run"),
                include_tests: flags.contains("--tests"),
                program_args,
                test_filter,
                build_jobs,
                test_jobs,
                test_list: flags.contains("--list"),
                test_ignored: flags.contains("--ignored"),
                test_include_ignored: flags.contains("--include-ignored"),
                test_json,
                test_nocapture: flags.contains("--nocapture"),
                test_timeout_ms,
                test_kind,
            },
        )
    }
}

fn run_command(args: CliArgs) -> Result[unit, string] {
    let context_result = if args.command == "run" {
        project::load_target_context(args.target, args.target_dir, args.compiler)
    } else {
        project::load_context(args.target_dir, args.compiler)
    };
    let context = context_result?;
    let plan = if args.command == "check" {
        project::check_plan(context, args.include_tests)
    } else if args.command == "build" {
        project::build_plan(context)
    } else if args.command == "run" {
        project::run_plan(context)
    } else {
        project::test_plan(context, args.test_kind)
    };
    let plan = plan?;
    project::execute_plan(context, plan, args.dry_run, args.build_jobs)?;
    if args.command == "run" {
        match plan.executable {
            Some(executable) => project::run_executable(
                context,
                executable,
                args.program_args,
                args.dry_run,
            ),
            None => Result::Err("build plan omitted executable"),
        }
    } else if args.command == "test" && !args.dry_run {
        let groups: Vec[runner::Group] = Vec::[];
        for group in plan.test_groups {
            groups.push(
                runner::Group {
                    kind: group.kind,
                    executable: group.runner,
                    manifest_path: group.manifest,
                },
            )
        };
        runner::run(
            context.graph.module_dir,
            groups,
            runner::Options {
                filter: args.test_filter,
                jobs: args.test_jobs,
                list: args.test_list,
                ignored: args.test_ignored,
                include_ignored: args.test_include_ignored,
                json: args.test_json,
                nocapture: args.test_nocapture,
                timeout_ms: args.test_timeout_ms,
            },
        )
    } else {
        Result::Ok(())
    }
}

fn main() -> unit {
    let args = env::args();
    if args.len() == 1 {
        io::eprintln(top_help());
        process::exit(2)
    } else if args[1] == "-h" || args[1] == "--help" {
        io::println(top_help())
    } else if args[1] == "help" {
        if args.len() == 2 {
            io::println(top_help())
        } else {
            io::println(command_help(args[2]))
        }
    } else if args[1] == "version" {
        io::println(f"goml {version::current()}")
    } else if args[1] == "home" {
        if args.len() == 3 && (args[2] == "-h" || args[2] == "--help") {
            io::println("Usage: goml home\n\nOptions:\n  -h, --help")
        } else if args.len() != 2 {
            fail(f"unexpected argument {args[2]}")
        } else {
            match commands::print_home() {
                Ok(()) => (),
                Err(message) => fail(message),
            }
        }
    } else if args[1] == "new" {
        if args.len() >= 3 && (args[2] == "-h" || args[2] == "--help") {
            io::println(command_help("new"))
        } else {
            match commands::parse_new(args) {
                Ok(()) => (),
                Err(message) => fail(message),
            }
        }
    } else if args[1] == "clean" {
        if args.len() >= 3 && (args[2] == "-h" || args[2] == "--help") {
            io::println(command_help("clean"))
        } else {
            match parse_clean(args) {
                Ok(target_dir) => match project::clean(target_dir) {
                    Ok(()) => (),
                    Err(message) => fail(message),
                },
                Err(message) => fail(message),
            }
        }
    } else if args[1] == "fmt" {
        match parse_fmt(args) {
            Ok(options) => match commands::format_module(options.check, options.formatter) {
                Ok(code) => if code == 0 {
                    ()
                } else {
                    process::exit(code)
                },
                Err(message) => fail(message),
            },
            Err(message) => if message == "help" {
                io::println(command_help("fmt"))
            } else {
                fail(message)
            },
        }
    } else if args[1] == "update" || args[1] == "add" || args[1] == "remove" {
        if args.len() >= 3 && (args[2] == "-h" || args[2] == "--help") {
            io::println(command_help(args[1]))
        } else {
            let result = if args[1] == "update" {
                commands::update_registry(args)
            } else if args[1] == "add" {
                commands::add_dependency(args)
            } else {
                commands::remove_dependency(args)
            };
            match result {
                Ok(()) => (),
                Err(message) => fail(message),
            }
        }
    } else {
        match parse_cli(args) {
            Ok(value) => match run_command(value) {
                Ok(()) => (),
                Err(message) => fail(message),
            },
            Err(message) => fail(message),
        }
    }
}
