package main;

use gomlang::bootstrap_goml::commands;
use gomlang::bootstrap_goml::project;
use gomlang::bootstrap_goml::runner;
use gomlang::bootstrap_goml::util;
use gomlang::bootstrap_goml::version;
use std::env;
use std::io;
use std::process;

struct CliArgs {
    command: string,
    target: string,
    target_dir: Option[string],
    compiler: Option[string],
    dry_run: bool,
    include_tests: bool,
    program_args: Vec[string],
    test_filter: Option[string],
    build_jobs: int,
    test_jobs: int,
    test_list: bool,
    test_ignored: bool,
    test_include_ignored: bool,
    test_json: bool,
    test_nocapture: bool,
    test_timeout_ms: int,
    test_kind: string,
}

fn fail(message: string) -> unit {
    io::eprintln("error: " + message);
    process::exit(1)
}

fn top_help() -> string {
    "Usage: goml <COMMAND>\n\nCommands:\n  new\n  check\n  build\n  run\n  test\n  clean\n  update\n  add\n  remove\n  home\n  version\n  help\n\nOptions:\n  -h, --help  Print help"
}

fn command_help(command: string) -> string {
    if command == "new" {
        "Usage: goml new [OPTIONS] <PROJECT_NAME>\n\nOptions:\n      --path <PATH>  [default: .]\n  -h, --help"
    } else if command == "check" {
        "Usage: goml check [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --jobs <JOBS>        [default: 16]\n      --tests\n  -h, --help"
    } else if command == "build" {
        "Usage: goml build [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --jobs <JOBS>        [default: 16]\n  -h, --help"
    } else if command == "run" {
        "Usage: goml run [OPTIONS] [TARGET] [-- <ARGS>...]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --jobs <JOBS>        [default: 16]\n  -h, --help"
    } else if command == "test" {
        "Usage: goml test [OPTIONS] [FILTER]\n\nOptions:\n      --target-dir <TARGET_DIR>\n      --dry-run\n      --compiler <COMPILER>\n      --list\n      --ignored\n      --include-ignored\n      --nocapture\n      --format <FORMAT>    [default: text] [possible values: text, json]\n      --timeout <TIMEOUT>  [default: 30s]\n      --jobs <JOBS>        [default: 1]\n      --kind <KIND>        [default: all] [possible values: internal, external, all]\n  -h, --help"
    } else if command == "clean" {
        "Usage: goml clean [OPTIONS]\n\nOptions:\n      --target-dir <TARGET_DIR>\n  -h, --help"
    } else if command == "update" {
        "Usage: goml update [OPTIONS]\n\nOptions:\n      --local-registry <PATH>\n  -h, --help"
    } else if command == "add" {
        "Usage: goml add [OPTIONS] <DEPENDENCY>\n\nOptions:\n      --local-registry <PATH>\n  -h, --help"
    } else if command == "remove" {
        "Usage: goml remove [OPTIONS] <DEPENDENCY>\n\nOptions:\n      --local-registry <PATH>\n  -h, --help"
    } else {
        top_help()
    }
}

fn inline_value(argument: string, name: string) -> Option[string] {
    let prefix = name + "=";
    if util::starts_with(argument, prefix) {
        Option::Some(argument.byte_slice(
            prefix.byte_len(),
            argument.byte_len(),
        ))
    } else {
        Option::None
    }
}

fn option_value(
    args: Vec[string],
    index: Ref[int],
    argument: string,
    name: string,
) -> Result[Option[string], string] {
    if argument == name {
        if index.get() + 1 >= args.len() {
            Result::Err(name + " requires a value")
        } else {
            let value = args.get(index.get() + 1);
            index.set(index.get() + 2);
            Result::Ok(Option::Some(value))
        }
    } else {
        match inline_value(argument, name) {
            Option::Some(value) => {
                index.set(index.get() + 1);
                if value == "" {
                    Result::Err(name + " requires a value")
                } else {
                    Result::Ok(Option::Some(value))
                }
            },
            Option::None => Result::Ok(Option::None),
        }
    }
}

fn parse_clean(args: Vec[string]) -> Result[Option[string], string] {
    let target_dir: Ref[Option[string]] = Ref::new(Option::None);
    let index = Ref::new(2);
    while index.get() < args.len() {
        let argument = args.get(index.get());
        let parsed = match option_value(
            args,
            index,
            argument,
            "--target-dir",
        ) {
            Result::Ok(value) => value,
            Result::Err(message) => return Result::Err(message),
        };
        match parsed {
            Option::Some(value) => match target_dir.get() {
                Option::Some(_) => {
                    return Result::Err("--target-dir cannot be repeated")
                },
                Option::None => target_dir.set(Option::Some(value)),
            },
            Option::None => if util::starts_with(argument, "-") {
                return Result::Err("unknown option " + argument)
            } else {
                return Result::Err("unexpected argument " + argument)
            },
        }
    };
    Result::Ok(target_dir.get())
}

fn parse_duration(value: string) -> Result[int, string] {
    let number = Ref::new("");
    let multiplier = Ref::new(0);
    if util::ends_with(value, "ms") {
        number.set(value.byte_slice(0, value.byte_len() - 2));
        multiplier.set(1)
    } else if util::ends_with(value, "s") {
        number.set(value.byte_slice(0, value.byte_len() - 1));
        multiplier.set(1000)
    } else if util::ends_with(value, "m") {
        number.set(value.byte_slice(0, value.byte_len() - 1));
        multiplier.set(60000)
    } else {
        return Result::Err("duration must end in ms, s, or m")
    };
    let parsed = match util::parse_positive_int(number.get()) {
        Result::Ok(value) => value,
        Result::Err(_) => return Result::Err("invalid duration `" + value + "`"),
    };
    let duration = parsed * multiplier.get();
    if duration / multiplier.get() != parsed {
        Result::Err("duration is too large")
    } else {
        Result::Ok(duration)
    }
}

fn parse_cli(args: Vec[string]) -> Result[CliArgs, string] {
    if args.len() < 2 {
        return Result::Err(top_help())
    } else {
        ()
    };
    let command = args.get(1);
    if command != "check"
        && command != "build"
        && command != "run"
        && command != "test"
    {
        return Result::Err("unknown command " + command)
    } else {
        ()
    };
    let target = Ref::new(".");
    let target_set = Ref::new(false);
    let target_dir: Ref[Option[string]] = Ref::new(Option::None);
    let compiler: Ref[Option[string]] = Ref::new(Option::None);
    let dry_run = Ref::new(false);
    let include_tests = Ref::new(false);
    let program_args = Vec::new();
    let test_filter: Ref[Option[string]] = Ref::new(Option::None);
    let build_jobs = Ref::new(16);
    let test_jobs = Ref::new(1);
    let test_list = Ref::new(false);
    let test_ignored = Ref::new(false);
    let test_include_ignored = Ref::new(false);
    let test_json = Ref::new(false);
    let test_nocapture = Ref::new(false);
    let test_timeout_ms = Ref::new(30000);
    let test_kind = Ref::new("all");
    let trailing = Ref::new(false);
    let index = Ref::new(2);
    while index.get() < args.len() {
        let argument = args.get(index.get());
        if trailing.get() {
            if command == "run" {
                program_args.push(argument);
                index.set(index.get() + 1)
            } else {
                return Result::Err("unexpected argument " + argument)
            }
        } else if argument == "--" {
            trailing.set(true);
            index.set(index.get() + 1)
        } else if argument == "-h" || argument == "--help" {
            io::println(command_help(command));
            process::exit(0)
        } else if argument == "--dry-run" {
            dry_run.set(true);
            index.set(index.get() + 1)
        } else if command == "check" && argument == "--tests" {
            include_tests.set(true);
            index.set(index.get() + 1)
        } else if command == "test" && argument == "--list" {
            test_list.set(true);
            index.set(index.get() + 1)
        } else if command == "test" && argument == "--ignored" {
            test_ignored.set(true);
            index.set(index.get() + 1)
        } else if command == "test" && argument == "--include-ignored" {
            test_include_ignored.set(true);
            index.set(index.get() + 1)
        } else if command == "test" && argument == "--nocapture" {
            test_nocapture.set(true);
            index.set(index.get() + 1)
        } else {
            let parsed_target_dir = match option_value(
                args,
                index,
                argument,
                "--target-dir",
            ) {
                Result::Ok(value) => value,
                Result::Err(message) => return Result::Err(message),
            };
            if match parsed_target_dir {
                Option::Some(_) => true,
                Option::None => false,
            } {
                if match target_dir.get() {
                    Option::Some(_) => true,
                    Option::None => false,
                } {
                    return Result::Err("--target-dir cannot be repeated")
                } else {
                    target_dir.set(parsed_target_dir)
                }
            } else {
                let parsed_compiler = match option_value(
                    args,
                    index,
                    argument,
                    "--compiler",
                ) {
                    Result::Ok(value) => value,
                    Result::Err(message) => return Result::Err(message),
                };
                if match parsed_compiler {
                    Option::Some(_) => true,
                    Option::None => false,
                } {
                    if match compiler.get() {
                        Option::Some(_) => true,
                        Option::None => false,
                    } {
                        return Result::Err("--compiler cannot be repeated")
                    } else {
                        compiler.set(parsed_compiler)
                    }
                } else if command == "test" {
                    let parsed_timeout = match option_value(
                        args,
                        index,
                        argument,
                        "--timeout",
                    ) {
                        Result::Ok(value) => value,
                        Result::Err(message) => return Result::Err(message),
                    };
                    if match parsed_timeout {
                        Option::Some(_) => true,
                        Option::None => false,
                    } {
                        let value = match parsed_timeout {
                            Option::Some(value) => value,
                            Option::None => "30s",
                        };
                        match parse_duration(value) {
                            Result::Ok(value) => test_timeout_ms.set(value),
                            Result::Err(message) => return Result::Err(message),
                        }
                    } else {
                    let parsed_jobs = match option_value(
                        args,
                        index,
                        argument,
                        "--jobs",
                    ) {
                        Result::Ok(value) => value,
                        Result::Err(message) => return Result::Err(message),
                    };
                    if match parsed_jobs {
                        Option::Some(_) => true,
                        Option::None => false,
                    } {
                        let value = match parsed_jobs {
                            Option::Some(value) => value,
                            Option::None => "1",
                        };
                        match util::parse_positive_int(value) {
                            Result::Ok(value) => {
                                test_jobs.set(value);
                                build_jobs.set(value)
                            },
                            Result::Err(message) => return Result::Err(message),
                        }
                    } else {
                        let parsed_kind = match option_value(
                            args,
                            index,
                            argument,
                            "--kind",
                        ) {
                            Result::Ok(value) => value,
                            Result::Err(message) => return Result::Err(message),
                        };
                        if match parsed_kind {
                            Option::Some(_) => true,
                            Option::None => false,
                        } {
                            let value = match parsed_kind {
                                Option::Some(value) => value,
                                Option::None => "all",
                            };
                            if value == "internal"
                                || value == "external"
                                || value == "all"
                            {
                                test_kind.set(value)
                            } else {
                                return Result::Err(
                                    "--kind must be internal, external, or all",
                                )
                            }
                        } else {
                            let parsed_format = match option_value(
                            args,
                            index,
                            argument,
                            "--format",
                        ) {
                            Result::Ok(value) => value,
                            Result::Err(message) => return Result::Err(message),
                        };
                            match parsed_format {
                            Option::Some(value) => if value == "json" {
                                test_json.set(true)
                            } else if value == "text" {
                                test_json.set(false)
                            } else {
                                return Result::Err(
                                    "--format must be text or json",
                                )
                            },
                            Option::None => if util::starts_with(argument, "-") {
                                return Result::Err("unknown option " + argument)
                            } else if match test_filter.get() {
                                Option::Some(_) => true,
                                Option::None => false,
                            } {
                                return Result::Err("unexpected argument " + argument)
                            } else {
                                test_filter.set(Option::Some(argument));
                                index.set(index.get() + 1)
                            },
                            }
                        }
                    }
                    }
                } else {
                    let parsed_jobs = match option_value(
                        args,
                        index,
                        argument,
                        "--jobs",
                    ) {
                        Result::Ok(value) => value,
                        Result::Err(message) => return Result::Err(message),
                    };
                    match parsed_jobs {
                        Option::Some(value) => match util::parse_positive_int(value) {
                            Result::Ok(value) => build_jobs.set(value),
                            Result::Err(message) => return Result::Err(message),
                        },
                        Option::None => if util::starts_with(argument, "-") {
                            return Result::Err("unknown option " + argument)
                        } else if command == "run" && !(target_set.get()) {
                            target.set(argument);
                            target_set.set(true);
                            index.set(index.get() + 1)
                        } else {
                            return Result::Err("unexpected argument " + argument)
                        },
                    }
                }
            }
        }
    };
    if test_ignored.get() && test_include_ignored.get() {
        Result::Err("--ignored cannot be combined with --include-ignored")
    } else if test_json.get() && test_nocapture.get() {
        Result::Err("--nocapture cannot be combined with --format json")
    } else {
        Result::Ok(CliArgs {
            command,
            target: target.get(),
            target_dir: target_dir.get(),
            compiler: compiler.get(),
            dry_run: dry_run.get(),
            include_tests: include_tests.get(),
            program_args,
            test_filter: test_filter.get(),
            build_jobs: build_jobs.get(),
            test_jobs: test_jobs.get(),
            test_list: test_list.get(),
            test_ignored: test_ignored.get(),
            test_include_ignored: test_include_ignored.get(),
            test_json: test_json.get(),
            test_nocapture: test_nocapture.get(),
            test_timeout_ms: test_timeout_ms.get(),
            test_kind: test_kind.get(),
        })
    }
}

fn run_command(args: CliArgs) -> Result[unit, string] {
    let context_result = if args.command == "run" {
        project::load_target_context(
            args.target,
            args.target_dir,
            args.compiler,
        )
    } else {
        project::load_context(args.target_dir, args.compiler)
    };
    let context = match context_result {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    let plan = if args.command == "check" {
        project::check_plan(context, args.include_tests)
    } else if args.command == "build" {
        project::build_plan(context)
    } else if args.command == "run" {
        project::run_plan(context)
    } else {
        project::test_plan(context, args.test_kind)
    };
    let plan = match plan {
        Result::Ok(value) => value,
        Result::Err(message) => return Result::Err(message),
    };
    match project::execute_plan(
        context,
        plan,
        args.dry_run,
        args.build_jobs,
    ) {
        Result::Ok(()) => (),
        Result::Err(message) => return Result::Err(message),
    };
    if args.command == "run" {
        match plan.executable {
            Option::Some(executable) => project::run_executable(
                context,
                executable,
                args.program_args,
                args.dry_run,
            ),
            Option::None => Result::Err("build plan omitted executable"),
        }
    } else if args.command == "test" && !args.dry_run {
        let groups = Vec::new();
        for group in plan.test_groups {
            groups.push(runner::Group {
                kind: group.kind,
                executable: group.runner,
                manifest_path: group.manifest,
            })
        };
        runner::run(
            context.graph.module_dir,
            groups,
            runner::Options {
                filter: args.test_filter,
                jobs: args.test_jobs,
                list: args.test_list,
                ignored: args.test_ignored,
                include_ignored: args.test_include_ignored,
                json: args.test_json,
                nocapture: args.test_nocapture,
                timeout_ms: args.test_timeout_ms,
            },
        )
    } else {
        Result::Ok(())
    }
}

fn main() -> unit {
    let args = env::args();
    if args.len() == 1 {
        io::eprintln(top_help());
        process::exit(2)
    } else if args.get(1) == "-h" || args.get(1) == "--help" {
        io::println(top_help())
    } else if args.get(1) == "help" {
        if args.len() == 2 {
            io::println(top_help())
        } else {
            io::println(command_help(args.get(2)))
        }
    } else if args.get(1) == "version" {
        io::println("goml " + version::current())
    } else if args.get(1) == "home" {
        if args.len() == 3
            && (args.get(2) == "-h" || args.get(2) == "--help")
        {
            io::println("Usage: goml home\n\nOptions:\n  -h, --help")
        } else if args.len() != 2 {
            fail("unexpected argument " + args.get(2))
        } else {
            match commands::print_home() {
                Result::Ok(()) => (),
                Result::Err(message) => fail(message),
            }
        }
    } else if args.get(1) == "new" {
        if args.len() >= 3
            && (args.get(2) == "-h" || args.get(2) == "--help")
        {
            io::println(command_help("new"))
        } else {
            match commands::parse_new(args) {
                Result::Ok(()) => (),
                Result::Err(message) => fail(message),
            }
        }
    } else if args.get(1) == "clean" {
        if args.len() >= 3
            && (args.get(2) == "-h" || args.get(2) == "--help")
        {
            io::println(command_help("clean"))
        } else {
            match parse_clean(args) {
                Result::Ok(target_dir) => match project::clean(target_dir) {
                    Result::Ok(()) => (),
                    Result::Err(message) => fail(message),
                },
                Result::Err(message) => fail(message),
            }
        }
    } else if args.get(1) == "update"
        || args.get(1) == "add"
        || args.get(1) == "remove"
    {
        if args.len() >= 3
            && (args.get(2) == "-h" || args.get(2) == "--help")
        {
            io::println(command_help(args.get(1)))
        } else {
            let result = if args.get(1) == "update" {
                commands::update_registry(args)
            } else if args.get(1) == "add" {
                commands::add_dependency(args)
            } else {
                commands::remove_dependency(args)
            };
            match result {
                Result::Ok(()) => (),
                Result::Err(message) => fail(message),
            }
        }
    } else {
        match parse_cli(args) {
            Result::Ok(value) => match run_command(value) {
                Result::Ok(()) => (),
                Result::Err(message) => fail(message),
            },
            Result::Err(message) => fail(message),
        }
    }
}
