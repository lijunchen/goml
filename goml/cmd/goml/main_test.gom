package main;

use gomlang::bootstrap_goml::manifest;
use gomlang::bootstrap_goml::project;
use gomlang::bootstrap_goml::util;
use std::json;
use std::path;
use std::testing;

fn project_context(entry_package: string) -> project::Context {
    project::Context {
        graph: project::Graph {
            module_dir: ".",
            module_path: "alice::demo",
            entry_package,
            packages: Vec::new().pushed(project::Package {
                name: entry_package,
                declared_name: "main",
                module_name: "alice::demo",
                directory: ".",
                artifact_prefix: "pkg",
                files: Vec::new(),
                imports: Vec::new(),
            }),
            sources: Vec::new().pushed(project::ModuleSource {
                name: "alice::demo",
                directory: ".",
                artifact_prefix: "pkg",
                dependencies: Vec::new(),
            }),
            order: Vec::new().pushed(entry_package),
        },
        compiler: "gomlc",
        compiler_world_artifact: false,
        artifact_root: "_artifact",
    }
}

#[test]
fn utility_text_operations_are_deterministic() -> unit {
    testing::assert_eq(util::trim(" \tvalue\r\n"), "value");
    testing::assert(util::starts_with("abc", "ab"));
    testing::assert(util::ends_with("abc", "bc"));
    testing::assert(util::contains("abcdef", "cde"));
    testing::assert(util::string_vec_contains(
        Vec::new().pushed("goml").pushed("gomlc"),
        "gomlc",
    ));
    testing::assert(util::int_vec_contains(Vec::new().pushed(1).pushed(2), 2));
    testing::assert_eq(
        util::join(
            util::sorted_unique(
                Vec::new().pushed("b").pushed("a").pushed("b"),
            ),
            ",",
        ),
        "a,b",
    )
}

#[test]
fn json_parser_reads_package_info_shape() -> unit {
    let value = match json::parse(
        "{\"files\":[{\"package\":\"main\",\"uses\":[]}],\"protocol_version\":1}",
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            json::Value::Null
        },
    };
    match json::field(value, "protocol_version") {
        Some(Number(value)) => {
            testing::assert_eq(value, "1")
        },
        _ => testing::fail("missing protocol version"),
    };
    match json::field(value, "files") {
        Some(value) => match json::as_array(value) {
            Some(values) => testing::assert_eq(values.len(), 1),
            None => testing::fail("files was not an array"),
        },
        None => testing::fail("missing files"),
    }
}

#[test]
fn manifest_parser_reads_project_manifest() -> unit {
    match manifest::load("goml.toml") {
        Ok(value) => {
            testing::assert_eq(
                value.module_path,
                "gomlang::bootstrap_goml",
            );
            testing::assert_eq(value.target_dir, "_artifact")
        },
        Err(message) => testing::fail(message),
    }
}

#[test]
fn run_plan_places_executables_under_package_paths() -> unit {
    let root = match project::run_plan(project_context("alice::demo")) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return ()
        },
    };
    match root.executable {
        Some(value) => testing::assert_eq(
            value,
            path::join(path::join("_artifact", "bin"), "demo"),
        ),
        None => testing::fail("missing root executable"),
    };

    let nested = match project::run_plan(
        project_context("alice::demo::cmd::server"),
    ) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(message);
            return ()
        },
    };
    match nested.executable {
        Some(value) => testing::assert_eq(
            value,
            path::join(
                path::join(
                    path::join(
                        path::join("_artifact", "bin"),
                        "cmd",
                    ),
                    "server",
                ),
                "server",
            ),
        ),
        None => testing::fail("missing nested executable"),
    }
}

#[test]
fn shell_escape_quotes_unsafe_arguments() -> unit {
    testing::assert_eq(util::shell_escape("plain/path"), "plain/path");
    testing::assert_eq(util::shell_escape("two words"), "'two words'");
    testing::assert_eq(util::shell_escape("你好's goml"), "'你好'\\''s goml'")
}
