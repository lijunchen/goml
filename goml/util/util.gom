package util;

use std::collections;
use std::text;

pub fn starts_with(value: string, prefix: string) -> bool {
    let prefix_len = prefix.byte_len();
    value.byte_len() >= prefix_len && value.byte_slice(0, prefix_len) == prefix
}

pub fn ends_with(value: string, suffix: string) -> bool {
    let value_len = value.byte_len();
    let suffix_len = suffix.byte_len();
    value_len >= suffix_len && value.byte_slice(value_len - suffix_len, value_len) == suffix
}

fn whitespace(value: uint8) -> bool {
    value == 32 || value == 9 || value == 10 || value == 13
}

pub fn trim(value: string) -> string {
    let length = value.byte_len();
    let mut start = 0;
    while start < length && whitespace(value.byte_get(start)) {
        start += 1;
    };
    let mut end = length;
    while end > start && whitespace(value.byte_get(end - 1)) {
        end -= 1;
    };
    value.byte_slice(start, end)
}

pub fn contains(value: string, needle: string) -> bool {
    text::find(value, needle).is_some()
}

pub fn string_vec_contains(values: Vec[string], expected: string) -> bool {
    for value in values {
        if value == expected {
            return true
        } else {
            ()
        }
    };
    false
}

pub fn int_vec_contains(values: Vec[int], expected: int) -> bool {
    for value in values {
        if value == expected {
            return true
        } else {
            ()
        }
    };
    false
}

pub fn split_lines(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    let length = value.byte_len();
    let mut start = 0;
    for index in 0..length {
        if value.byte_get(index) == b'\n' {
            let end = if index > start && value.byte_get(index - 1) == b'\r' {
                index - 1
            } else {
                index
            };
            result.push(value.byte_slice(start, end));
            start = index + 1;
        } else {
            ()
        }
    };
    if start <= length {
        result.push(value.byte_slice(start, length))
    } else {
        ()
    };
    result
}

pub fn split(value: string, separator: string) -> Vec[string] {
    let result: Vec[string] = Vec::[];
    let separator_len = separator.byte_len();
    let value_len = value.byte_len();
    if separator_len == 0 {
        result.push(value);
        return result
    } else {
        ()
    };
    let mut start = 0;
    let mut index = 0;
    while index + separator_len <= value_len {
        if value.byte_slice(index, index + separator_len) == separator {
            result.push(value.byte_slice(start, index));
            index += separator_len;
            start = index;
        } else {
            index += 1;
        }
    };
    result.push(value.byte_slice(start, value_len));
    result
}

pub fn join(values: Vec[string], separator: string) -> string {
    text::join(values, separator)
}

fn compare_strings(left: string, right: string) -> int {
    if left < right {
        -1
    } else if left > right {
        1
    } else {
        0
    }
}

pub fn sorted(values: Vec[string]) -> Vec[string] {
    collections::sort_by(values, compare_strings);
    values
}

pub fn sorted_unique(values: Vec[string]) -> Vec[string] {
    let sorted_values = sorted(values);
    let result = Vec::with_capacity(sorted_values.len());
    for value in sorted_values {
        if result.is_empty() || result[result.len() - 1] != value {
            result.push(value)
        } else {
            ()
        }
    };
    result
}

pub fn progress_bar(completed: int, total: int) -> string {
    let width = 20;
    let filled = if total == 0 {
        width
    } else {
        completed * width / total
    };
    let builder = text::StringBuilder::with_capacity(width + 2);
    builder.write_char('[');
    for index in 0..width {
        builder.write_char(
            if index < filled {
                '#'
            } else {
                '-'
            },
        )
    };
    builder.write_char(']');
    builder.finish()
}

pub fn parse_positive_int(value: string) -> Result[int, string] {
    let length = value.byte_len();
    if length == 0 {
        return Result::Err("expected a positive integer")
    } else {
        ()
    };
    let mut result = 0;
    for index in 0..length {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Result::Err("expected a positive integer")
        } else {
            result = result * 10 + (byte - b'0') as int;
        }
    };
    if result > 0 {
        Result::Ok(result)
    } else {
        Result::Err("expected a positive integer")
    }
}

fn shell_plain(value: string) -> bool {
    if value.byte_len() == 0 {
        false
    } else {
        for index in 0..value.byte_len() {
            let byte = value.byte_get(index);
            if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
                || (byte >= b'a' && byte <= b'z')
                || byte == b'-'
                || byte == b'.'
                || byte == b'/'
                || byte == b':'
                || byte == b'_' {
                ()
            } else {
                return false
            }
        };
        true
    }
}

pub fn shell_escape(value: string) -> string {
    if shell_plain(value) {
        return value
    } else {
        ()
    };
    let builder = text::StringBuilder::with_capacity(value.byte_len() + 2);
    builder.write_char('\'');
    for character in value.chars() {
        if character == '\'' {
            builder.write_string("'\\''")
        } else {
            builder.write_char(character)
        }
    };
    builder.write_char('\'');
    builder.finish()
}
