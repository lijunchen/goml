package registry;

use module::manifest;
use std::cmp;
use std::env;
use std::fs;
use std::path;
use std::text;

pub struct SemVersion {
    pub major: isize,
    pub minor: isize,
    pub patch: isize,
}

struct RegistryEntry {
    name: string,
    latest: string,
    versions: Vec[string],
}

pub struct ResolvedModule {
    pub name: string,
    pub version: string,
    pub root: string,
    pub dependencies: Vec[manifest::Dependency],
}

fn decimal_number(value: string) -> Option[isize] {
    let length = value.byte_len();
    if length == 0 {
        return Option::None
    } else {};
    let mut result = 0;
    for index in 0..length {
        let byte = value.byte_get(index);
        if byte < b'0' || byte > b'9' {
            return Option::None
        } else {
            result = result * 10 + (byte - b'0').to_isize();
        }
    }
    Option::Some(result)
}

pub fn parse_sem_version(value: string) -> Result[SemVersion, string] {
    let parts = text::split(value, ".");
    if parts.len() != 3 {
        return Result::Err("invalid semver `" + value + "`")
    } else {};
    let Some(major) = decimal_number(parts[0]) else {
        return Result::Err("invalid semver `" + value + "`")
    };
    let Some(minor) = decimal_number(parts[1]) else {
        return Result::Err("invalid semver `" + value + "`")
    };
    let Some(patch) = decimal_number(parts[2]) else {
        return Result::Err("invalid semver `" + value + "`")
    };
    Result::Ok(SemVersion { major, minor, patch })
}

fn version_compare(left: SemVersion, right: SemVersion) -> cmp::Ordering {
    cmp::compare(left.major, right.major).then(cmp::compare(left.minor, right.minor)).then(
        cmp::compare(left.patch, right.patch),
    )
}

fn version_less(left: SemVersion, right: SemVersion) -> bool {
    version_compare(left, right).is_lt()
}

fn version_equal(left: SemVersion, right: SemVersion) -> bool {
    version_compare(left, right).is_eq()
}

fn quoted_values(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::from_array([]);
    let mut start: Option[isize] = Option::None;
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'"' {
            match start {
                Some(offset) => {
                    result.push(value.byte_slice(offset, index));
                    start = Option::None;
                },
                None => {
                    start = Option::Some(index + 1);
                },
            }
        } else {}
    }
    result
}

fn load_index(root: string) -> Result[Vec[RegistryEntry], string] {
    let source = fs::read_file(path::join(root, "index.toml"))?;
    let entries: Vec[RegistryEntry] = Vec::from_array([]);
    let mut current: Option[string] = Option::None;
    for original in text::lines(source) {
        let line = text::trim(original);
        if line.starts_with("[modules.") {
            let values = quoted_values(line);
            if values.len() != 1 {
                return Result::Err("invalid registry module table " + line)
            } else {
                current = Option::Some(values[0]);
                entries.push(
                    RegistryEntry { name: values[0], latest: "", versions: Vec::from_array([]) },
                )
            }
        } else {
            match current {
                Some(_) => if line.starts_with("latest") {
                    let values = quoted_values(line);
                    if values.len() != 1 {
                        return Result::Err("invalid registry latest value")
                    } else {
                        let index = entries.len() - 1;
                        let entry = entries[index];
                        entries.set(
                            index,
                            RegistryEntry {
                                name: entry.name,
                                latest: values[0],
                                versions: entry.versions,
                            },
                        )
                    }
                } else if line.starts_with("versions") {
                    let index = entries.len() - 1;
                    let entry = entries[index];
                    entries.set(
                        index,
                        RegistryEntry {
                            name: entry.name,
                            latest: entry.latest,
                            versions: quoted_values(line),
                        },
                    )
                } else {},
                None => (),
            }
        }
    }
    Result::Ok(entries)
}

fn valid_identifier(value: string) -> bool {
    if value.byte_len() == 0 {
        return false
    } else {};
    let first = value.byte_get(0);
    if !((first >= b'A' && first <= b'Z') || (first >= b'a' && first <= b'z') || first == b'_') {
        return false
    } else {};
    for index in 1..value.byte_len() {
        let byte = value.byte_get(index);
        if (byte >= b'0' && byte <= b'9') || (byte >= b'A' && byte <= b'Z')
            || (byte >= b'a' && byte <= b'z')
            || byte == b'_' {} else {
            return false
        }
    }
    true
}

pub fn validate_coordinate(value: string) -> Result[unit, string] {
    let parts = text::split(value, "::");
    if parts.len() != 2 || !valid_identifier(parts[0]) || !valid_identifier(parts[1]) {
        Result::Err("invalid module coordinate `" + value + "`: expected owner::module")
    } else if parts[0] == "std" {
        Result::Err("invalid module coordinate `" + value + "`: owner std is reserved")
    } else {
        Result::Ok(())
    }
}

fn find_entry(entries: Vec[RegistryEntry], name: string) -> Option[RegistryEntry] {
    for entry in entries {
        if entry.name == name {
            return Option::Some(entry)
        } else {}
    }
    Option::None
}

fn module_directory_unchecked(root: string, name: string, version: string) -> string {
    let parts = text::split(name, "::");
    path::join(path::join(path::join(root, parts[0]), parts[1]), version)
}

pub fn module_directory(root: string, name: string, version: string) -> Result[string, string] {
    match validate_coordinate(name) {
        Ok(()) => Result::Ok(module_directory_unchecked(root, name, version)),
        Err(message) => Result::Err(message),
    }
}

pub fn validate(root: string) -> Result[unit, string] {
    let entries = load_index(root)?;
    for entry in entries {
        validate_coordinate(entry.name)?;
        let latest = parse_sem_version(entry.latest)?;
        let mut latest_matches = false;
        for version in entry.versions {
            let parsed = parse_sem_version(version)?;
            if version_equal(parsed, latest) {
                latest_matches = true;
            } else {};
            let directory = module_directory_unchecked(root, entry.name, version);
            if !fs::is_dir(directory) {
                return Result::Err(
                    "registry index references missing module directory: " + entry.name + "@"
                        + version,
                )
            } else {}
        }
        if !latest_matches {
            return Result::Err(
                "registry index latest version " + entry.latest + " for " + entry.name
                    + " is not listed in versions",
            )
        } else {}
    }
    Result::Ok(())
}

pub fn latest_version(root: string, name: string) -> Result[string, string] {
    validate_coordinate(name)?;
    let entries = load_index(root)?;
    match find_entry(entries, name) {
        Some(entry) => match parse_sem_version(entry.latest) {
            Ok(_) => Result::Ok(entry.latest),
            Err(message) => Result::Err(message),
        },
        None => Result::Err("module " + name + " not found in registry index"),
    }
}

pub fn select_version(root: string, name: string, minimum: string) -> Result[string, string] {
    validate_coordinate(name)?;
    let minimum_value = parse_sem_version(minimum)?;
    let entries = load_index(root)?;
    let Some(entry) = find_entry(entries, name) else {
        return Result::Err("module " + name + " not found in registry index")
    };
    let mut selected: Option[string] = Option::None;
    let mut selected_value: Option[SemVersion] = Option::None;
    for version in entry.versions {
        let parsed = parse_sem_version(version)?;
        if !version_less(parsed, minimum_value)
            && match selected_value {
                Some(current) => version_less(parsed, current),
                None => true,
            } {
            selected = Option::Some(version);
            selected_value = Option::Some(parsed);
        } else {}
    }
    match selected {
        Some(value) => Result::Ok(value),
        None => Result::Err("registry has no version for " + name + " satisfying >= " + minimum),
    }
}

pub fn cached_root() -> Result[string, string] {
    let home = match env::var("GOML_HOME") {
        Some(value) => if value != "" {
            Option::Some(value)
        } else {
            Option::None
        },
        None => Option::None,
    };
    let home = match home {
        Some(value) => value,
        None => match env::var("HOME") {
            Some(value) => if value != "" {
                path::join(value, ".goml")
            } else {
                return Result::Err("failed to determine home directory")
            },
            None => match env::var("USERPROFILE") {
                Some(value) => if value != "" {
                    path::join(value, ".goml")
                } else {
                    return Result::Err("failed to determine home directory")
                },
                None => return Result::Err("failed to determine home directory"),
            },
        },
    };
    Result::Ok(path::join(path::join(home, "cache"), "registry"))
}

fn selected_index(values: Vec[ResolvedModule], name: string) -> Option[isize] {
    for index in 0..values.len() {
        if values[index].name == name {
            return Option::Some(index)
        } else {}
    }
    Option::None
}

pub fn resolve_at(module_root: string, root: string) -> Result[Vec[ResolvedModule], string] {
    let root_manifest = manifest::load(path::join(module_root, manifest::FILENAME))?;
    let queue = root_manifest.dependencies;
    let selected: Vec[ResolvedModule] = Vec::from_array([]);
    let mut cursor = 0;
    while cursor < queue.len() {
        let requirement = queue[cursor];
        cursor += 1;
        let version = select_version(root, requirement.name, requirement.version)?;
        let parsed = parse_sem_version(version)?;
        let selected_position = selected_index(selected, requirement.name);
        let update = match selected_position {
            Some(index) => {
                let current = parse_sem_version(selected[index].version)?;
                version_less(current, parsed)
            },
            None => true,
        };
        if update {
            let directory = module_directory_unchecked(root, requirement.name, version);
            let module_manifest = manifest::load(path::join(directory, manifest::FILENAME))?;
            if module_manifest.module_path != requirement.name {
                return Result::Err(
                    "registry module " + requirement.name + " declares module path "
                        + module_manifest.module_path,
                )
            } else {};
            let resolved = ResolvedModule {
                name: requirement.name,
                version,
                root: directory,
                dependencies: module_manifest.dependencies,
            };
            match selected_position {
                Some(index) => selected.set(index, resolved),
                None => selected.push(resolved),
            };
            for dependency in module_manifest.dependencies {
                queue.push(dependency)
            }
        } else {}
    }
    Result::Ok(selected)
}

pub fn resolve(module_root: string) -> Result[Vec[ResolvedModule], string] {
    let root = cached_root()?;
    if !fs::is_dir(root) {
        return Result::Err("registry cache not found at " + root + "; run `goml update` first")
    } else {};
    resolve_at(module_root, root)
}

pub fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}

pub fn package_directory(module: ResolvedModule, package_name: string) -> Option[string] {
    if package_name == module.name {
        Option::Some(module.root)
    } else if module_matches_package(module.name, package_name) {
        let mut result = module.root;
        let suffix = package_name.byte_slice(module.name.byte_len() + 2, package_name.byte_len());
        for segment in text::split(suffix, "::") {
            result = path::join(result, segment);
        }
        Option::Some(result)
    } else {
        Option::None
    }
}

pub fn artifact_prefix(module: ResolvedModule) -> string {
    let parts = text::split(module.name, "::");
    path::join(
        path::join(path::join(path::join("deps", parts[0]), parts[1]), module.version),
        "pkg",
    )
}
