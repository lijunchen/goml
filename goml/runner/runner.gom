package runner;

use gomlang::bootstrap_goml::util;
use std::bytes;
use std::fs;
use std::io;
use std::json;
use std::process;
use std::text;

pub struct Options {
    pub filter: Option[string],
    pub jobs: int,
    pub list: bool,
    pub ignored: bool,
    pub include_ignored: bool,
    pub json: bool,
    pub nocapture: bool,
    pub timeout_ms: int,
}

pub struct Group {
    pub kind: string,
    pub executable: string,
    pub manifest_path: string,
}

struct Test {
    id: string,
    display_name: string,
    ignored: bool,
    ignore_reason: Option[string],
    kind: string,
    executable: string,
}

enum Status {
    Passed,
    Failed(int),
    TimedOut,
    Ignored,
}

struct Execution {
    index: int,
    test: Test,
    status: Status,
    stdout: string,
    stderr: string,
}

fn bytes_text(value: bytes::Bytes) -> string {
    match value.to_string() {
        Ok(value) => value,
        Err(_) => "<non-UTF-8 output>",
    }
}

fn required_string(value: json::Value, name: string) -> Result[string, string] {
    match json::field(value, name) {
        Some(value) => match json::as_string(value) {
            Some(value) => Result::Ok(value),
            None => Result::Err(name + " must be a string"),
        },
        None => Result::Err("test manifest omitted " + name),
    }
}

fn required_bool(value: json::Value, name: string) -> Result[bool, string] {
    match json::field(value, name) {
        Some(value) => match json::as_bool(value) {
            Some(value) => Result::Ok(value),
            None => Result::Err(name + " must be boolean"),
        },
        None => Result::Err("test manifest omitted " + name),
    }
}

fn load_tests(group: Group) -> Result[Vec[Test], string] {
    let source = match fs::read_file(group.manifest_path) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let root = match json::parse(source) {
        Ok(value) => value,
        Err(message) => return Result::Err(message),
    };
    let values = match json::as_array(root) {
        Some(value) => value,
        None => return Result::Err("test manifest must be an array"),
    };
    let result = Vec::new();
    for value in values {
        let id = match required_string(value, "id") {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        let display_name = match required_string(value, "display_name") {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        let ignored = match required_bool(value, "ignored") {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        let ignore_reason = match json::field(value, "ignore_reason") {
            Some(value) => json::as_string(value),
            None => Option::None,
        };
        result.push(Test {
            id,
            display_name,
            ignored,
            ignore_reason,
            kind: group.kind,
            executable: group.executable,
        })
    };
    Result::Ok(result)
}

fn selected(test: Test, options: Options) -> bool {
    let filter_matches = match options.filter {
        Some(value) => util::contains(test.display_name, value),
        None => true,
    };
    filter_matches && (!options.ignored || test.ignored)
}

fn test_insert_index(values: Vec[Test], value: Test) -> int {
    for index in range(0, values.len()) {
        if value.display_name < values[index].display_name {
            return index
        } else {
            ()
        }
    };
    values.len()
}

fn sorted_tests(values: Vec[Test]) -> Vec[Test] {
    let result = Vec::new();
    for value in values {
        let index = test_insert_index(result, value);
        if index == result.len() {
            result.push(value)
        } else {
            result.insert(index, value)
        }
    };
    result
}

fn escape_json(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '"' {
            builder.write_string("\\\"")
        } else if character == '\\' {
            builder.write_string("\\\\")
        } else if character == '\n' {
            builder.write_string("\\n")
        } else if character == '\r' {
            builder.write_string("\\r")
        } else if character == '\t' {
            builder.write_string("\\t")
        } else {
            builder.write_char(character)
        }
    };
    builder.finish()
}

fn print_list(tests: Vec[Test], options: Options) -> unit {
    for test in tests {
        if options.json {
            let reason = match test.ignore_reason {
                Some(value) => "\"" + escape_json(value) + "\"",
                None => "null",
            };
            io::println(
                "{\"event\":\"test\",\"ignored\":"
                    + test.ignored.to_string()
                    + ",\"kind\":\""
                    + escape_json(test.kind)
                    + "\",\"name\":\""
                    + escape_json(test.display_name)
                    + "\",\"reason\":"
                    + reason
                    + "}",
            )
        } else if test.ignored {
            io::println(test.display_name + ": ignored")
        } else {
            io::println(test.display_name)
        }
    }
}

fn run_one(
    module_dir: string,
    index: int,
    test: Test,
    options: Options,
) -> Execution {
    if test.ignored && !options.ignored && !options.include_ignored {
        Execution {
            index,
            test,
            status: Status::Ignored,
            stdout: "",
            stderr: "",
        }
    } else {
        let command = process::Command::new(test.executable)
            .arg(test.id)
            .current_dir(module_dir)
            .env("TZ", "UTC");
        if options.nocapture {
            match command.status_timeout(options.timeout_ms) {
                Ok(result) => Execution {
                    index,
                    test,
                    status: if result.1 {
                        Status::TimedOut
                    } else if process::ExitStatus::success(result.0) {
                        Status::Passed
                    } else {
                        Status::Failed(match process::ExitStatus::code(result.0) {
                            Some(value) => value,
                            None => -1,
                        })
                    },
                    stdout: "",
                    stderr: "",
                },
                Err(message) => Execution {
                    index,
                    test,
                    status: Status::Failed(-1),
                    stdout: "",
                    stderr: message,
                },
            }
        } else {
            match command.output_timeout(options.timeout_ms) {
                Ok(result) => {
                    let output = result.0;
                    Execution {
                        index,
                        test,
                        status: if result.1 {
                            Status::TimedOut
                        } else if process::ExitStatus::success(
                            process::Output::status(output),
                        ) {
                            Status::Passed
                        } else {
                            Status::Failed(match process::ExitStatus::code(
                                process::Output::status(output),
                            ) {
                                Some(value) => value,
                                None => -1,
                            })
                        },
                        stdout: bytes_text(process::Output::stdout(output)),
                        stderr: bytes_text(process::Output::stderr(output)),
                    }
                },
                Err(message) => Execution {
                    index,
                    test,
                    status: Status::Failed(-1),
                    stdout: "",
                    stderr: message,
                },
            }
        }
    }
}

fn worker(
    module_dir: string,
    options: Options,
    work: Channel[(int, Test)],
    results: Channel[Execution],
) -> unit {
    while true {
        match work.recv() {
            Some(item) => results.send(run_one(
                module_dir,
                item.0,
                item.1,
                options,
            )),
            None => break,
        }
    }
}

fn execution_insert_index(
    values: Vec[Execution],
    value: Execution,
) -> int {
    for index in range(0, values.len()) {
        if value.index < values[index].index {
            return index
        } else {
            ()
        }
    };
    values.len()
}

fn ordered_executions(values: Vec[Execution]) -> Vec[Execution] {
    let result = Vec::new();
    for value in values {
        let index = execution_insert_index(result, value);
        if index == result.len() {
            result.push(value)
        } else {
            result.insert(index, value)
        }
    };
    result
}

fn report_text(values: Vec[Execution]) -> int {
    let passed = Ref::new(0);
    let failed = Ref::new(0);
    let ignored = Ref::new(0);
    for value in values {
        match value.status {
            Passed => {
                passed.set(passed.get() + 1);
                io::println("test " + value.test.display_name + " ... ok")
            },
            Ignored => {
                ignored.set(ignored.get() + 1);
                io::println(
                    "test "
                        + value.test.display_name
                        + " ... "
                        + match value.test.ignore_reason {
                            Some(reason) => "ignored: " + reason,
                            None => "ignored",
                        },
                )
            },
            TimedOut | Failed(_) => {
                failed.set(failed.get() + 1);
                let status = match value.status {
                    TimedOut => "FAILED (timed out)",
                    Failed(code) => if code < 0 {
                        "FAILED (terminated by signal)"
                    } else {
                        "FAILED (exit code " + code.to_string() + ")"
                    },
                    _ => "FAILED",
                };
                io::println(
                    "test " + value.test.display_name + " ... " + status,
                );
                if value.stdout != "" {
                    io::println("---- stdout ----");
                    io::print(value.stdout)
                } else {
                    ()
                };
                if value.stderr != "" {
                    io::println("---- stderr ----");
                    io::print(value.stderr)
                } else {
                    ()
                }
            },
        }
    };
    io::println(
        "\ntest result: "
            + if failed.get() == 0 { "ok" } else { "FAILED" }
            + ". "
            + passed.get().to_string()
            + " passed; "
            + failed.get().to_string()
            + " failed; "
            + ignored.get().to_string()
            + " ignored",
    );
    failed.get()
}

fn report_json(values: Vec[Execution]) -> int {
    let failed = Ref::new(0);
    for value in values {
        let event = match value.status {
            Passed => "ok",
            Ignored => "ignored",
            Failed(_) => {
                failed.set(failed.get() + 1);
                "failed"
            },
            TimedOut => {
                failed.set(failed.get() + 1);
                "timed_out"
            },
        };
        io::println(
            "{\"event\":\""
                + event
                + "\",\"name\":\""
                + escape_json(value.test.display_name)
                + "\"}",
        )
    };
    failed.get()
}

pub fn run(
    module_dir: string,
    groups: Vec[Group],
    options: Options,
) -> Result[unit, string] {
    let loaded = Vec::new();
    for group in groups {
        let values = match load_tests(group) {
            Ok(value) => value,
            Err(message) => return Result::Err(message),
        };
        for value in values {
            loaded.push(value)
        }
    };
    let selected_tests = Vec::new();
    for test in sorted_tests(loaded) {
        if selected(test, options) {
            selected_tests.push(test)
        } else {
            ()
        }
    };
    if options.list {
        print_list(selected_tests, options);
        return Result::Ok(())
    } else if !options.json {
        io::println(
            "running " + selected_tests.len().to_string() + " tests\n",
        )
    } else {
        ()
    };
    if selected_tests.len() == 0 {
        if !options.json {
            io::println("test result: ok. 0 passed; 0 failed; 0 ignored")
        } else {
            ()
        };
        return Result::Ok(())
    } else {
        ()
    };
    let work = Channel::new(selected_tests.len());
    let results = Channel::new(selected_tests.len());
    for index in range(0, selected_tests.len()) {
        work.send((index, selected_tests[index]))
    };
    work.close();
    let worker_count = if options.jobs < selected_tests.len() {
        options.jobs
    } else {
        selected_tests.len()
    };
    for _ in range(0, worker_count) {
        go || worker(module_dir, options, work, results)
    };
    let executions = Vec::new();
    for _ in range(0, selected_tests.len()) {
        match results.recv() {
            Some(value) => executions.push(value),
            None => return Result::Err("test result channel closed early"),
        }
    };
    results.close();
    let failures = if options.json {
        report_json(ordered_executions(executions))
    } else {
        report_text(ordered_executions(executions))
    };
    if failures == 0 {
        Result::Ok(())
    } else {
        Result::Err(failures.to_string() + " test(s) failed")
    }
}
