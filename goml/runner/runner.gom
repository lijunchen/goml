package runner;

use gomlang::bootstrap_goml::util;
use std::bytes;
use std::cmp;
use std::collections;
use std::fs;
use std::io;
use std::json;
use std::process;
use std::task;
use std::text;

pub struct Options {
    pub filter: Option[string],
    pub jobs: int,
    pub list: bool,
    pub ignored: bool,
    pub include_ignored: bool,
    pub json: bool,
    pub nocapture: bool,
    pub timeout_ms: int,
}

pub struct Group {
    pub kind: string,
    pub executable: string,
    pub manifest_path: string,
}

struct Test {
    id: string,
    display_name: string,
    ignored: bool,
    ignore_reason: Option[string],
    kind: string,
    executable: string,
}

enum Status {
    Passed,
    Failed(int),
    TimedOut,
    Ignored,
}

struct Execution {
    index: int,
    test: Test,
    status: Status,
    stdout: string,
    stderr: string,
}

fn bytes_text(value: bytes::Bytes) -> string {
    match value.to_string() {
        Ok(value) => value,
        Err(_) => "<non-UTF-8 output>",
    }
}

fn required_string(value: json::Value, name: string) -> Result[string, string] {
    match json::field(value, name) {
        Some(value) => match json::as_string(value) {
            Some(value) => Result::Ok(value),
            None => Result::Err(f"{name} must be a string"),
        },
        None => Result::Err(f"test manifest omitted {name}"),
    }
}

fn required_bool(value: json::Value, name: string) -> Result[bool, string] {
    match json::field(value, name) {
        Some(value) => match json::as_bool(value) {
            Some(value) => Result::Ok(value),
            None => Result::Err(f"{name} must be boolean"),
        },
        None => Result::Err(f"test manifest omitted {name}"),
    }
}

fn load_tests(group: Group) -> Result[Vec[Test], string] {
    let source = fs::read_file(group.manifest_path)?;
    let root = json::parse(source)?;
    let Some(values) = json::as_array(root) else {
        return Result::Err("test manifest must be an array")
    };
    let result: Vec[Test] = Vec::[];
    for value in values {
        let id = required_string(value, "id")?;
        let display_name = required_string(value, "display_name")?;
        let ignored = required_bool(value, "ignored")?;
        let ignore_reason = match json::field(value, "ignore_reason") {
            Some(value) => json::as_string(value),
            None => Option::None,
        };
        result.push(
            Test {
                id,
                display_name,
                ignored,
                ignore_reason,
                kind: group.kind,
                executable: group.executable,
            },
        )
    };
    Result::Ok(result)
}

fn selected(test: Test, options: Options) -> bool {
    let filter_matches = match options.filter {
        Some(value) => test.display_name.contains(value),
        None => true,
    };
    filter_matches && (!options.ignored || test.ignored)
}

fn compare_tests(left: Test, right: Test) -> cmp::Ordering {
    cmp::compare(left.display_name, right.display_name)
}

fn sorted_tests(values: Vec[Test]) -> Vec[Test] {
    collections::sort_by_ordering(values, compare_tests);
    values
}

fn escape_json(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '"' {
            builder.write_string("\\\"")
        } else if character == '\\' {
            builder.write_string("\\\\")
        } else if character == '\n' {
            builder.write_string("\\n")
        } else if character == '\r' {
            builder.write_string("\\r")
        } else if character == '\t' {
            builder.write_string("\\t")
        } else {
            builder.write_char(character)
        }
    };
    builder.finish()
}

fn print_list(tests: Vec[Test], options: Options) -> unit {
    for test in tests {
        if options.json {
            let reason = match test.ignore_reason {
                Some(value) => "\"" + escape_json(value) + "\"",
                None => "null",
            };
            io::println(
                "{\"event\":\"test\",\"ignored\":" + test.ignored.to_string() + ",\"kind\":\""
                    + escape_json(test.kind)
                    + "\",\"name\":\""
                    + escape_json(test.display_name)
                    + "\",\"reason\":"
                    + reason
                    + "}",
            )
        } else if test.ignored {
            io::println(f"{test.display_name}: ignored")
        } else {
            io::println(test.display_name)
        }
    }
}

fn run_one(module_dir: string, index: int, test: Test, options: Options) -> Execution {
    if test.ignored && !options.ignored && !options.include_ignored {
        Execution { index, test, status: Status::Ignored, stdout: "", stderr: "" }
    } else {
        let command = process::Command::new(test.executable).arg(test.id).current_dir(module_dir).env(
            "TZ",
            "UTC",
        );
        if options.nocapture {
            match command.status_timeout(options.timeout_ms) {
                Ok(result) => Execution {
                    index,
                    test,
                    status: if result.1 {
                        Status::TimedOut
                    } else if process::ExitStatus::success(result.0) {
                        Status::Passed
                    } else {
                        Status::Failed(
                            match process::ExitStatus::code(result.0) {
                                Some(value) => value,
                                None => -1,
                            },
                        )
                    },
                    stdout: "",
                    stderr: "",
                },
                Err(message) => Execution {
                    index,
                    test,
                    status: Status::Failed(-1),
                    stdout: "",
                    stderr: message,
                },
            }
        } else {
            match command.output_timeout(options.timeout_ms) {
                Ok(result) => {
                    let output = result.0;
                    Execution {
                        index,
                        test,
                        status: if result.1 {
                            Status::TimedOut
                        } else if process::ExitStatus::success(process::Output::status(output)) {
                            Status::Passed
                        } else {
                            Status::Failed(
                                match process::ExitStatus::code(process::Output::status(output)) {
                                    Some(value) => value,
                                    None => -1,
                                },
                            )
                        },
                        stdout: bytes_text(process::Output::stdout(output)),
                        stderr: bytes_text(process::Output::stderr(output)),
                    }
                },
                Err(message) => Execution {
                    index,
                    test,
                    status: Status::Failed(-1),
                    stdout: "",
                    stderr: message,
                },
            }
        }
    }
}

fn worker(
    cancel: task::CancelToken,
    module_dir: string,
    options: Options,
    work: Channel[(int, Test)],
    results: Channel[Execution],
) -> unit {
    loop {
        match task::recv_with(cancel, work) {
            task::WaitResult::Completed(Some(item)) => match task::send_with(
                cancel,
                results,
                run_one(module_dir, item.0, item.1, options),
            ) {
                task::WaitResult::Completed(()) => (),
                task::WaitResult::Cancelled => break,
            },
            task::WaitResult::Completed(None) | task::WaitResult::Cancelled => break,
        }
    }
}

fn compare_executions(left: Execution, right: Execution) -> cmp::Ordering {
    cmp::compare(left.index, right.index)
}

fn ordered_executions(values: Vec[Execution]) -> Vec[Execution] {
    collections::sort_by_ordering(values, compare_executions);
    values
}

fn report_text(values: Vec[Execution]) -> int {
    let mut passed = 0;
    let mut failed = 0;
    let mut ignored = 0;
    for value in values {
        match value.status {
            Passed => {
                passed += 1;
                io::println(f"test {value.test.display_name} ... ok")
            },
            Ignored => {
                ignored += 1;
                let status = match value.test.ignore_reason {
                    Some(reason) => f"ignored: {reason}",
                    None => "ignored",
                };
                io::println(f"test {value.test.display_name} ... {status}")
            },
            TimedOut | Failed(_) => {
                failed += 1;
                let status = match value.status {
                    TimedOut => "FAILED (timed out)",
                    Failed(code) => if code < 0 {
                        "FAILED (terminated by signal)"
                    } else {
                        f"FAILED (exit code {code})"
                    },
                    _ => "FAILED",
                };
                io::println(f"test {value.test.display_name} ... {status}");
                if value.stdout != "" {
                    io::println("---- stdout ----");
                    io::print(value.stdout)
                } else {
                    ()
                };
                if value.stderr != "" {
                    io::println("---- stderr ----");
                    io::print(value.stderr)
                } else {
                    ()
                }
            },
        }
    };
    let result = if failed == 0 {
        "ok"
    } else {
        "FAILED"
    };
    io::println(f"\ntest result: {result}. {passed} passed; {failed} failed; {ignored} ignored");
    failed
}

fn report_json(values: Vec[Execution]) -> int {
    let mut failed = 0;
    for value in values {
        let event = match value.status {
            Passed => "ok",
            Ignored => "ignored",
            Failed(_) => {
                failed += 1;
                "failed"
            },
            TimedOut => {
                failed += 1;
                "timed_out"
            },
        };
        io::println(
            "{\"event\":\"" + event + "\",\"name\":\"" + escape_json(value.test.display_name)
                + "\"}",
        )
    };
    failed
}

pub fn run(module_dir: string, groups: Vec[Group], options: Options) -> Result[unit, string] {
    let loaded: Vec[Test] = Vec::[];
    for group in groups {
        let values = load_tests(group)?;
        for value in values {
            loaded.push(value)
        }
    };
    let selected_tests: Vec[Test] = Vec::[];
    for test in sorted_tests(loaded) {
        if selected(test, options) {
            selected_tests.push(test)
        } else {
            ()
        }
    };
    if options.list {
        print_list(selected_tests, options);
        return Result::Ok(())
    } else if !options.json {
        io::println(f"running {selected_tests.len()} tests\n")
    } else {
        ()
    };
    if selected_tests.is_empty() {
        if !options.json {
            io::println("test result: ok. 0 passed; 0 failed; 0 ignored")
        } else {
            ()
        };
        return Result::Ok(())
    } else {
        ()
    };
    let executions = task::try_scope(
        |scope: task::Scope| {
            let work = Channel::new(selected_tests.len());
            let results = Channel::new(selected_tests.len());
            for index in 0..selected_tests.len() {
                work.send((index, selected_tests[index]))
            };
            work.close();
            let worker_count = if options.jobs < selected_tests.len() {
                options.jobs
            } else {
                selected_tests.len()
            };
            for _ in 0..worker_count {
                let _ = scope.spawn(
                    |cancel: task::CancelToken| worker(cancel, module_dir, options, work, results),
                );
            };
            let executions: Vec[Execution] = Vec::[];
            let total = selected_tests.len();
            let mut completed = 0;
            util::display_progress(completed, total, "running tests", false);
            for _ in 0..total {
                match results.recv() {
                    Some(value) => {
                        executions.push(value);
                        completed += 1;
                        util::display_progress(
                            completed,
                            total,
                            if completed == total {
                                "finished"
                            } else {
                                "running tests"
                            },
                            completed == total,
                        )
                    },
                    None => return Result::Err("test result channel closed early"),
                }
            };
            results.close();
            Result::Ok(executions)
        },
    )?;
    let failures = if options.json {
        report_json(ordered_executions(executions))
    } else {
        report_text(ordered_executions(executions))
    };
    if failures == 0 {
        Result::Ok(())
    } else {
        Result::Err(f"{failures} test(s) failed")
    }
}
